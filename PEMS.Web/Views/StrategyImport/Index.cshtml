@model PEMS.Web.ViewModels.StrategyImportViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0"><pems-icon name="bi-file-earmark-excel" /> @Localizer["Rcm_Import"]</h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="MaintenanceStrategy" asp-action="Index">@Localizer["Rcm_Back"]</pems-button>
</pems-flex>
<p class="text-muted small">@Localizer["Rcm_ImportHint"]</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card>
            <h6 class="small fw-bold">@Localizer["Rcm_ImportStrategies"]</h6>
            <pems-form asp-action="Preview" method="post" enctype="multipart/form-data"><pems-flex gap="2">
                <input type="hidden" name="kind" value="strategies" />
                <pems-input scale="small" type="file" name="file" accept=".xlsx" required />
                <pems-button tone="primary" size="small">@Localizer["Rcm_Validate"]</pems-button>
            </pems-flex></pems-form>
            <a asp-action="Template" asp-route-kind="strategies" class="small">@Localizer["Rcm_DownloadTemplate"]</a>
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card>
            <h6 class="small fw-bold">@Localizer["Rcm_ImportAssignments"]</h6>
            <pems-form asp-action="Preview" method="post" enctype="multipart/form-data"><pems-flex gap="2">
                <input type="hidden" name="kind" value="assignments" />
                <pems-input scale="small" type="file" name="file" accept=".xlsx" required />
                <pems-button tone="primary" size="small">@Localizer["Rcm_Validate"]</pems-button>
            </pems-flex></pems-form>
            <a asp-action="Template" asp-route-kind="assignments" class="small">@Localizer["Rcm_DownloadTemplate"]</a>
        </pems-content-card>
    </pems-col>
</pems-row>

@if (Model.Result != null)
{
    var r = Model.Result;
    <pems-content-card>
        <pems-flex justify="between" align="center" css="mb-2">
            <h6 class="small fw-bold mb-0">
                @(r.Committed ? Localizer["Rcm_ImportCommitted"] : Localizer["Rcm_ImportPreview"]):
                @Localizer["Rcm_RowsRead"] @r.RowsRead · @Localizer["Rcm_RowsAccepted"] @r.RowsAccepted · @Localizer["Rcm_RowsRejected"] @r.RowsRejected
            </h6>
            <pems-flex gap="2">
                @if (!r.Committed && !string.IsNullOrEmpty(Model.Token) && r.RowsAccepted > 0)
                {
                    <pems-form asp-action="Commit" method="post" data-pems-confirm="@Localizer["Rcm_ConfirmImport"]">
                        <input type="hidden" name="token" value="@Model.Token" /><input type="hidden" name="kind" value="@Model.Kind" />
                        <pems-button tone="success" size="small"><pems-icon name="bi-check2-all" /> @Localizer["Rcm_CommitValidRows"]</pems-button>
                    </pems-form>
                }
                @if (r.RowsRejected > 0 && !string.IsNullOrEmpty(Model.Token))
                {
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Errors" asp-route-token="@Model.Token" asp-route-kind="@Model.Kind"><pems-icon name="bi-download" /> @Localizer["Rcm_ErrorReport"]</pems-button>
                }
            </pems-flex>
        </pems-flex>
        <div class="pems-s-9687cbac">
        <pems-table scale="small" css="table-enterprise">
            <pems-table-head><pems-table-row><pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Rcm_Reference"]</pems-table-header><pems-table-header>@Localizer["Rcm_Status"]</pems-table-header><pems-table-header>@Localizer["Rcm_Messages"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
            @foreach (var row in r.Rows)
            {
                <pems-table-row class="@(row.Accepted ? "" : "table-danger")">
                    <pems-table-cell>@row.RowNumber</pems-table-cell><pems-table-cell class="small">@row.Reference</pems-table-cell>
                    <pems-table-cell>@(row.Accepted ? Localizer["Rcm_RowAccepted"].Value : Localizer["Rcm_RowRejected"].Value)</pems-table-cell>
                    <pems-table-cell class="small">@string.Join(" | ", Model.Messages.TryGetValue(row.RowNumber, out var m) ? m : new List<string>())</pems-table-cell>
                </pems-table-row>
            }
            </pems-table-body>
        </pems-table>
        </div>
    </pems-content-card>
}
