@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;
    var helpKey = ViewData["HelpKey"] as string;
}

@* ==============================================================================
   طبق «PEMS Bilingual Help & Knowledge System» بخش ۶.۲: دکمه‌ی راهنمای زمینه‌ای + پنل کناری
   (Offcanvas Bootstrap موجود - کتابخانه‌ی جدیدی اضافه نشد). این دکمه فقط وقتی صفحه صریحاً
   ViewData["HelpKey"] را ست کرده باشد رندر می‌شود - طبق بخش ۱۸ (Performance): محتوا فقط با
   درخواست واقعی کاربر (کلیک) از /Help/Context بارگذاری می‌شود، نه در هر بار رندر صفحه.
   ============================================================================== *@
@* دکمه‌ی فراخوان در _ContextualHelpButton است؛ این Partial باید «بیرون از <header>» (مثلاً بعد از آن) رندر شود تا z-index پنل (1045) در Stacking Context هدر (1030) گیر نکند. *@

<pems-offcanvas side="@(isRtl ? "start" : "end")" tabindex="-1" id="pemsHelpDrawer" aria-labelledby="pemsHelpDrawerLabel" data-context-url="@Url.Action("Context", "Help", new { area = "" })" data-help-index-url="@Url.Action("Index", "Help", new { area = "" })" data-text-no-content="@L("No Help content yet for this page.", "هنوز محتوای راهنمایی برای این صفحه ثبت نشده.")" data-text-browse="@L("Browse Help Center", "مرور مرکز راهنما")" data-text-diagram="@L("View diagram in full article", "مشاهده‌ی نمودار در مقاله‌ی کامل")" data-text-related="@L("Related", "مرتبط")" data-text-open="@L("Open full article", "باز کردن مقاله‌ی کامل")" data-text-error="@L("Could not load Help content.", "بارگذاری محتوای راهنما ممکن نشد.")">
    <div class="offcanvas-header border-bottom">
        <h6 class="offcanvas-title" id="pemsHelpDrawerLabel"><pems-icon name="bi-life-preserver" /> @L("Help", "راهنما")</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body" id="pemsHelpDrawerBody">
        <pems-skeleton kind="card" label="@L("Loading...", "در حال بارگذاری...")" />
    </div>
</pems-offcanvas>

<pems-script-templates set="help-drawer"></pems-script-templates>
<script src="~/js/views/shared-contextualhelpdrawer.js" asp-append-version="true"></script>
