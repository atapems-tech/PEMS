@using System.Globalization
@{
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;
    var helpKey = ViewData["HelpKey"] as string;
}

@* ==============================================================================
   طبق «PEMS Bilingual Help & Knowledge System» بخش ۶.۲: دکمه‌ی راهنمای زمینه‌ای + پنل کناری
   (Offcanvas Bootstrap موجود - کتابخانه‌ی جدیدی اضافه نشد). این دکمه فقط وقتی صفحه صریحاً
   ViewData["HelpKey"] را ست کرده باشد رندر می‌شود - طبق بخش ۱۸ (Performance): محتوا فقط با
   درخواست واقعی کاربر (کلیک) از /Help/Context بارگذاری می‌شود، نه در هر بار رندر صفحه.
   ============================================================================== *@
@if (!string.IsNullOrEmpty(helpKey))
{
    <button type="button" class="btn btn-sm btn-outline-secondary pems-contextual-help-btn" data-bs-toggle="offcanvas" data-bs-target="#pemsHelpDrawer"
            data-help-key="@helpKey" title="@L("Help for this page", "راهنمای این صفحه")">
        <i class="bi bi-question-circle"></i> @L("Help", "راهنما")
    </button>
}

<div class="offcanvas @(isRtl ? "offcanvas-start" : "offcanvas-end")" tabindex="-1" id="pemsHelpDrawer" aria-labelledby="pemsHelpDrawerLabel">
    <div class="offcanvas-header border-bottom">
        <h6 class="offcanvas-title" id="pemsHelpDrawerLabel"><i class="bi bi-life-preserver"></i> @L("Help", "راهنما")</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body" id="pemsHelpDrawerBody">
        <p class="text-muted small text-center py-4">@L("Loading...", "در حال بارگذاری...")</p>
    </div>
</div>

<script>
    (function () {
        var drawer = document.getElementById('pemsHelpDrawer');
        if (!drawer) return;

        var loadedForKey = null;

        drawer.addEventListener('show.bs.offcanvas', function (evt) {
            var trigger = evt.relatedTarget;
            var helpKey = trigger ? trigger.getAttribute('data-help-key') : null;
            if (!helpKey || helpKey === loadedForKey) return;

            var body = document.getElementById('pemsHelpDrawerBody');
            body.innerHTML = '<p class="text-muted small text-center py-4">@L("Loading...", "در حال بارگذاری...")</p>';

            fetch('@Url.Action("Context", "Help")?key=' + encodeURIComponent(helpKey))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    loadedForKey = helpKey;
                    if (!data.found) {
                        body.innerHTML = '<p class="text-muted small text-center py-4">@L("No Help content yet for this page.", "هنوز محتوای راهنمایی برای این صفحه ثبت نشده.")</p>'
                            + '<a class="btn btn-sm btn-outline-secondary w-100" href="@Url.Action("Index", "Help")">@L("Browse Help Center", "مرور مرکز راهنما")</a>';
                        return;
                    }
                    var related = (data.relatedArticles || []).map(function (r) {
                        return '<a class="btn btn-sm btn-outline-secondary me-1 mb-1" href="/Help/Article/' + r.code + '">' + r.title + '</a>';
                    }).join('');

                    var visualHint = data.hasVisual
                        ? '<a class="btn btn-sm btn-outline-primary w-100 mb-2" href="' + data.articleUrl + '"><i class="bi bi-diagram-3"></i> @L("View diagram in full article", "مشاهده‌ی نمودار در مقاله‌ی کامل")</a>'
                        : '';

                    body.innerHTML =
                        '<h6>' + data.title + '</h6>' +
                        '<p class="text-muted small">' + data.summary + '</p>' +
                        visualHint +
                        '<div class="pems-help-article-body small">' + data.content + '</div>' +
                        (related ? '<hr/><p class="small text-muted mb-1">@L("Related", "مرتبط")</p><div>' + related + '</div>' : '') +
                        '<hr/><a class="btn btn-sm btn-pems-solid w-100" href="' + data.articleUrl + '"><i class="bi bi-box-arrow-up-right"></i> @L("Open full article", "باز کردن مقاله‌ی کامل")</a>';
                })
                .catch(function () {
                    body.innerHTML = '<p class="text-danger small text-center py-4">@L("Could not load Help content.", "بارگذاری محتوای راهنما ممکن نشد.")</p>';
                });
        });
    })();
</script>
