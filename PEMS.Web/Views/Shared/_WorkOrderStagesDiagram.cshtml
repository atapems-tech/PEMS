@* ==============================================================================
   نمودار گرافیکی چرخه‌ی WorkOrder. Model: (وضعیت فعلی، آیا بازبینی چند-دیسیپلینه فعاله)
   ============================================================================== *@
@model (string Status, bool HasPendingReview)

@{
    var status = Model.Status ?? "Open";
    var hasPendingReview = Model.HasPendingReview;

    // طبق درخواست: مرحله‌ی بازبینی چند-دیسیپلینه فقط وقتی نشون داده می‌شه که واقعاً فعال باشه
    var stageOrder = hasPendingReview
        ? new[] { "Open", "Assigned", "InProgress", "DisciplineReview", "Completed", "Closed" }
        : new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" };

    var stageLabels = new Dictionary<string, string>
    {
        ["Open"] = "ثبت شده",
        ["Assigned"] = "تخصیص‌یافته",
        ["InProgress"] = "در حال انجام",
        ["DisciplineReview"] = "بازبینی چند-دیسیپلینه",
        ["Completed"] = "تکمیل‌شده",
        ["Closed"] = "بسته‌شده"
    };

    var stageIcons = new Dictionary<string, string>
    {
        ["Open"] = "bi-plus-circle",
        ["Assigned"] = "bi-person-check",
        ["InProgress"] = "bi-tools",
        ["DisciplineReview"] = "bi-people",
        ["Completed"] = "bi-check2-circle",
        ["Closed"] = "bi-archive"
    };

    var currentIndex = Array.IndexOf(stageOrder, status);
    if (currentIndex < 0) currentIndex = 0;

    // اگه بازبینی فعاله، یعنی الان دقیقاً همون مرحله‌ایم (بین InProgress و Completed)، حتی
    // اگه Status هنوز روی InProgress ثبت شده باشه - چون این یک زیرمرحله‌ی مجزاست
    if (hasPendingReview && status == "InProgress")
        currentIndex = Array.IndexOf(stageOrder, "DisciplineReview");
}

<style>
    .pems-wo-diagram { display: flex; align-items: flex-start; justify-content: space-between; padding: 1.2rem 0.5rem; overflow-x: auto; }
    .pems-wo-step { display: flex; flex-direction: column; align-items: center; min-width: 84px; text-align: center; position: relative; z-index: 1; }
    .pems-wo-circle { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; border: 2px solid #dee2e6; background: #fff; color: #adb5bd; }
    .pems-wo-step.done .pems-wo-circle { background: #198754; border-color: #198754; color: #fff; }
    .pems-wo-step.current .pems-wo-circle { background: #0d6efd; border-color: #0d6efd; color: #fff; box-shadow: 0 0 0 4px rgba(13,110,253,.2); animation: pems-wo-pulse 1.6s infinite; }
    .pems-wo-label { font-size: .74rem; font-weight: 600; margin-top: .35rem; color: #495057; }
    .pems-wo-step.current .pems-wo-label { color: #0d6efd; }
    .pems-wo-connector { flex: 1; height: 2px; background: #dee2e6; margin-top: 20px; min-width: 16px; }
    .pems-wo-connector.done { background: #198754; }
    @@keyframes pems-wo-pulse { 0% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } 50% { box-shadow: 0 0 0 8px rgba(13,110,253,.08); } 100% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } }
</style>

<div class="pems-wo-diagram">
    @for (var i = 0; i < stageOrder.Length; i++)
    {
        var key = stageOrder[i];
        var cssClass = i < currentIndex ? "done" : i == currentIndex ? "current" : "";

        <div class="pems-wo-step @cssClass">
            <div class="pems-wo-circle">
                @if (cssClass == "done")
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <i class="bi @stageIcons[key]"></i>
                }
            </div>
            <div class="pems-wo-label">@stageLabels[key]</div>
        </div>

        if (i < stageOrder.Length - 1)
        {
            var connClass = i < currentIndex ? "done" : "";
            <div class="pems-wo-connector @connClass"></div>
        }
    }
</div>
