@model PEMS.Web.Models.BarcodePanelViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* طبق «PEMS — Enterprise Barcode System» بند «UI»: یک پارتیال مشترک برای تب Barcode - روی هر
   صفحه‌ی Details موجودی که ازش استفاده کند (Equipment/MaterialItem/...) بدون تکرار کد. *@

<pems-content-card>
    @if (Model.ActiveBarcode == null)
    {
        <p class="text-muted small">No active barcode for this record yet.</p>
        @if (Model.CanManage)
        {
            <pems-form asp-controller="Barcode" asp-action="Generate" asp-area="" method="post"><pems-flex gap="2" align="end">
                <input type="hidden" name="targetType" value="@Model.TargetType" />
                <input type="hidden" name="targetId" value="@Model.TargetId" />
                <div>
                    <pems-label css="small mb-0">@Localizer["Symbology"]</pems-label>
                    <pems-select scale="small" name="symbology">
                        <option value="Code128">@Localizer["Code128"]</option>
                        <option value="QR">QR</option>
                    </pems-select>
                </div>
                <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-upc-scan" /> Generate Barcode</pems-button>
            </pems-flex></pems-form>
        }
    }
    else
    {
        var b = Model.ActiveBarcode;
        <pems-row gap="3" css="align-items-center">
            <pems-col md="3" css="text-center">
                <img class="pems-maxw-100pct" src="@Url.Action("Svg", "Barcode", new { area = "", id = b.BarcodeIdentityId })" alt="barcode" />
                <div class="small mt-1" dir="ltr"><code>@b.Code</code></div>
            </pems-col>
            <pems-col md="9">
                <pems-row gap="2" css="small mb-2">
                    <pems-col md="3"><strong>@Localizer["Symbology"]</strong><div>@b.Symbology</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Status"]</strong><div><pems-badge tone="@(b.Status == "Active" ? "success" : "neutral")">@b.Status</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Prints"]</strong><div>@b.PrintCount</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Created"]</strong><div>@b.CreatedDate.ToString("yyyy-MM-dd")</div></pems-col>
                </pems-row>

                @if (Model.CanManage)
                {
                    <pems-flex wrap="true" gap="2">
                        <pems-form asp-controller="Barcode" asp-action="Print" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-printer" /> Print Label</pems-button>
                        </pems-form>
                        <pems-form asp-controller="Barcode" asp-action="Disable" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="Disable this barcode?">Disable</pems-button>
                        </pems-form>
                        <pems-form asp-controller="Barcode" asp-action="Revoke" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="Revoke this barcode? It can never be reactivated.">@Localizer["Revoke"]</pems-button>
                        </pems-form>
                        <pems-form asp-controller="Barcode" asp-action="Replace" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="warning" size="small" outline="true" type="submit" data-pems-confirm="Revoke this barcode and generate a new one for the same record?">Replace</pems-button>
                        </pems-form>
                    </pems-flex>
                }
            </pems-col>
        </pems-row>
    }
</pems-content-card>
