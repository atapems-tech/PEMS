@model PEMS.Web.Models.BarcodePanelViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* طبق «PEMS — Enterprise Barcode System» بند «UI»: یک پارتیال مشترک برای تب Barcode - روی هر
   صفحه‌ی Details موجودی که ازش استفاده کند (Equipment/MaterialItem/...) بدون تکرار کد. *@

<div class="content-card">
    @if (Model.ActiveBarcode == null)
    {
        <p class="text-muted small">No active barcode for this record yet.</p>
        @if (Model.CanManage)
        {
            <form asp-controller="Barcode" asp-action="Generate" asp-area="" method="post" class="d-flex gap-2 align-items-end">
                <input type="hidden" name="targetType" value="@Model.TargetType" />
                <input type="hidden" name="targetId" value="@Model.TargetId" />
                <div>
                    <label class="form-label small mb-0">@Localizer["Symbology"]</label>
                    <select name="symbology" class="form-select form-select-sm">
                        <option value="Code128">@Localizer["Code128"]</option>
                        <option value="QR">QR</option>
                    </select>
                </div>
                <pems-button tone="primary" size="small" type="submit"><i class="bi bi-upc-scan"></i> Generate Barcode</pems-button>
            </form>
        }
    }
    else
    {
        var b = Model.ActiveBarcode;
        <div class="row g-3 align-items-center">
            <div class="col-md-3 text-center">
                <img src="@Url.Action("Svg", "Barcode", new { area = "", id = b.BarcodeIdentityId })" alt="barcode" style="max-width:100%;" />
                <div class="small mt-1" dir="ltr"><code>@b.Code</code></div>
            </div>
            <div class="col-md-9">
                <div class="row g-2 small mb-2">
                    <div class="col-md-3"><strong>@Localizer["Symbology"]</strong><div>@b.Symbology</div></div>
                    <div class="col-md-3"><strong>@Localizer["Status"]</strong><div><pems-badge tone="@(b.Status == "Active" ? "success" : "neutral")">@b.Status</pems-badge></div></div>
                    <div class="col-md-3"><strong>@Localizer["Prints"]</strong><div>@b.PrintCount</div></div>
                    <div class="col-md-3"><strong>@Localizer["Created"]</strong><div>@b.CreatedDate.ToString("yyyy-MM-dd")</div></div>
                </div>

                @if (Model.CanManage)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <form asp-controller="Barcode" asp-action="Print" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-printer"></i> Print Label</pems-button>
                        </form>
                        <form asp-controller="Barcode" asp-action="Disable" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="neutral" size="small" outline="true" type="submit" onclick="return confirm('Disable this barcode?')">Disable</pems-button>
                        </form>
                        <form asp-controller="Barcode" asp-action="Revoke" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="danger" size="small" outline="true" type="submit" onclick="return confirm('Revoke this barcode? It can never be reactivated.')">@Localizer["Revoke"]</pems-button>
                        </form>
                        <form asp-controller="Barcode" asp-action="Replace" asp-area="" asp-route-id="@b.BarcodeIdentityId" method="post">
                            <input type="hidden" name="targetType" value="@Model.TargetType" />
                            <input type="hidden" name="targetId" value="@Model.TargetId" />
                            <pems-button tone="warning" size="small" outline="true" type="submit" onclick="return confirm('Revoke this barcode and generate a new one for the same record?')">Replace</pems-button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>
