@* ==============================================================================
   نمودار گرافیکی چرخه‌ی گردش‌کار مدرک مهندسی. Model یک رشته است: وضعیت فعلی مدرک
   (Draft/Submitted/Checked/Approved/Issued/Rejected/Client Approved).

   طبق داده‌ی واقعی Seed شده در EngineeringDocumentWorkflowSeeder (نه فرضی) - اگه اون
   Seeder تغییر کنه، این نمودار هم باید دستی به‌روز بشه؛ نسخه‌ی کاملاً پویا (خواندن مستقیم
   از WorkflowStage) به فاز Designer موکول شده.
   ============================================================================== *@
@model string

@{
    var currentStatus = Model ?? "Draft";

    var stageOrder = new[] { "Draft", "Submitted", "IDC Review", "Checked", "Approved", "Issued", "ClientReview" };

    var stageLabels = new Dictionary<string, string>
    {
        ["Draft"] = "Draft",
        ["Submitted"] = "Check",
        ["IDC Review"] = "IDC",
        ["Checked"] = "Approval",
        ["Approved"] = "Issue",
        ["Issued"] = "Issued",
        ["ClientReview"] = "Client Review"
    };

    var stageIcons = new Dictionary<string, string>
    {
        ["Draft"] = "bi-pencil-square",
        ["Submitted"] = "bi-clipboard-check",
        ["IDC Review"] = "bi-diagram-3",
        ["Checked"] = "bi-patch-check",
        ["Approved"] = "bi-send-check",
        ["Issued"] = "bi-check2-circle",
        ["ClientReview"] = "bi-building"
    };

    var stageRoles = new Dictionary<string, string>
    {
        ["Draft"] = "Engineer",
        ["Submitted"] = "Eng. Supervisor / Manager",
        ["IDC Review"] = "دیسیپلین‌های ارجاع‌شده",
        ["Checked"] = "Eng. Manager",
        ["Approved"] = "Document Controller",
        ["Issued"] = "—",
        ["ClientReview"] = "Document Controller"
    };

    // طبق کشف این بازبینی UX: "Revise & Resubmit" هم مثل "Rejected" یک انشعاب برگشتی است
    // (DocumentWorkflowService.ReviseAndResubmitAsync آن را جدا از "Rejected" نگه می‌دارد)،
    // نه یک مرحله‌ی مستقل در stageOrder - قبلاً چون در آرایه پیدا نمی‌شد، currentIndex به
    // آخرین مرحله (Issued) سقوط می‌کرد و نمودار اشتباهاً نشون می‌داد سند تمام‌شده است.
    var isRejected = currentStatus == "Rejected" || currentStatus == "Revise & Resubmit";

    // اندیس مرحله‌ی جاری در توالی بالا (برای حالت برگشتی، آخرین مرحله‌ی طی‌شده رو نشون می‌دیم،
    // چون خودِ Reject/Revise یک "مرحله" مستقل نیست، یک انشعاب برگشتی از Check یا Approval است)
    var currentIndex = Array.IndexOf(stageOrder, currentStatus);
    if (currentIndex < 0) currentIndex = isRejected ? 0 : stageOrder.Length - 1;
}

<style>
    .pems-wf-diagram { display: flex; align-items: flex-start; justify-content: space-between; padding: 1.5rem 0.5rem; overflow-x: auto; }
    .pems-wf-step { display: flex; flex-direction: column; align-items: center; min-width: 92px; text-align: center; position: relative; z-index: 1; }
    .pems-wf-circle { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; border: 2px solid #dee2e6; background: #fff; color: #adb5bd; transition: all .2s; }
    .pems-wf-step.done .pems-wf-circle { background: #198754; border-color: #198754; color: #fff; }
    .pems-wf-step.current .pems-wf-circle { background: #0d6efd; border-color: #0d6efd; color: #fff; box-shadow: 0 0 0 4px rgba(13,110,253,.2); animation: pems-wf-pulse 1.6s infinite; }
    .pems-wf-step.rejected .pems-wf-circle { background: #dc3545; border-color: #dc3545; color: #fff; }
    .pems-wf-label { font-size: .78rem; font-weight: 600; margin-top: .4rem; color: #495057; }
    .pems-wf-step.current .pems-wf-label { color: #0d6efd; }
    .pems-wf-step.rejected .pems-wf-label { color: #dc3545; }
    .pems-wf-role { font-size: .68rem; color: #adb5bd; margin-top: .1rem; }
    .pems-wf-connector { flex: 1; height: 2px; background: #dee2e6; margin-top: 22px; min-width: 20px; }
    .pems-wf-connector.done { background: #198754; }
    @@keyframes pems-wf-pulse { 0% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } 50% { box-shadow: 0 0 0 8px rgba(13,110,253,.08); } 100% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } }
</style>

@if (currentStatus == "Rejected")
{
    <div class="alert alert-danger py-2 px-3 mb-3 small">
        <i class="bi bi-x-circle"></i> این مدرک <strong>رد شده</strong> و باید دوباره Submit بشه تا یک چرخه‌ی جدید گردش‌کار شروع بشه.
    </div>
}
else if (currentStatus == "Revise & Resubmit")
{
    <div class="alert alert-warning py-2 px-3 mb-3 small">
        <i class="bi bi-arrow-repeat"></i> این مدرک برای <strong>اصلاح</strong> برگشته - رد نهایی نشده. بعد از اصلاح، دوباره Submit کن.
    </div>
}

<div class="pems-wf-diagram">
    @for (var i = 0; i < stageOrder.Length; i++)
    {
        var stageKey = stageOrder[i];
        var cssClass = isRejected && i > currentIndex ? "rejected"
            : i < currentIndex ? "done"
            : i == currentIndex ? "current"
            : "";

        <div class="pems-wf-step @cssClass">
            <div class="pems-wf-circle">
                @if (cssClass == "done")
                {
                    <i class="bi bi-check-lg"></i>
                }
                else if (cssClass == "rejected")
                {
                    <i class="bi bi-x-lg"></i>
                }
                else
                {
                    <i class="bi @stageIcons[stageKey]"></i>
                }
            </div>
            <div class="pems-wf-label">@stageLabels[stageKey]</div>
            <div class="pems-wf-role">@stageRoles[stageKey]</div>
        </div>

        if (i < stageOrder.Length - 1)
        {
            var connClass = i < currentIndex ? "done" : "";
            <div class="pems-wf-connector @connClass"></div>
        }
    }
</div>
