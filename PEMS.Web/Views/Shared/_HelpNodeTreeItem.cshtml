@model PEMS.Web.Models.HelpNodeTreeItem

@* طبق «PEMS Help System — Phase 3»: Recursion استانداردِ Razor - این Partial خودش را برای هر
   فرزند دوباره فراخوانی می‌کند. بدون جاوااسکریپت، بدون ساخت دستیِ رشته‌ی HTML. *@
<li>
    @if (!string.IsNullOrWhiteSpace(Model.IncomingEdgeLabel))
    {
        <div class="pems-help-tree-edge-label"><i class="bi bi-arrow-return-right"></i> @Model.IncomingEdgeLabel</div>
    }
    <div class="pems-help-tree-label">
        <i class="bi @Model.IconCssClass"></i>
        <span>@Model.Label</span>
    </div>
    @if (Model.Children.Any())
    {
        <ul>
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_HelpNodeTreeItem", child)
            }
        </ul>
    }
</li>
