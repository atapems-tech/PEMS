@using PEMS.Web.Security
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Application.Interfaces
@inject IStringLocalizer<SharedResource> Localizer
@inject IPermissionService PermissionService
@inject ICurrentUserService CurrentUserService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    // طبق «PEMS — Quick Setup & Domain Import Architecture Refactoring» بند ۱۰: Quick Setup یک
    // قابلیت مجوزمحور است (Setup/View)، نه یک آیتم منوی نقش-محور مثل بقیه‌ی سایدبار - به همین
    // دلیل، برخلاف بقیه‌ی این فایل، مستقیماً از IPermissionService استفاده می‌کند.
    var canSeeQuickSetup = await PermissionService.HasPermissionAsync(CurrentUserService.Roles, "Setup", "View");

    bool IsActive(string controller, string area = "") =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
        currentArea.Equals(area, StringComparison.OrdinalIgnoreCase);

    bool InArea(string area) =>
        currentArea.Equals(area, StringComparison.OrdinalIgnoreCase);

    string ComingSoon(string title, string section) =>
        Url.Action("Index", "ComingSoon", new { title, section }) ?? "#";

    // بخش‌های سایدبار حالا کشویی (Accordion) هستند تا اسکرول طولانی نداشته باشیم -
    // فقط بخشی که صفحه‌ی جاری در آن است باز باز می‌شود، بقیه بسته‌اند.
    string SectionClass(bool containsActive) => "collapse" + (containsActive ? " show" : "");
    string ChevronClass(bool containsActive) => "bi bi-chevron-down nav-section-chevron" + (containsActive ? " rotated" : "");

    // طبق «PEMS — Quick Setup & Domain Import Architecture Refactoring» بند ۷/۲۸: Import ها
    // قابلیت دامنه‌ای هستند، نه قابلیت Administration - MDRImport/VDRImport به Engineering،
    // EquipmentImport به CMMS، MrsImport به Inventory برگشتند (هرکدام هنوز با نقش‌های
    // MenuAccess.ImportCenter گیت می‌شوند، نه با نقش‌های گسترده‌ی خودِ بخش - طبق ممیزی قبلی، تا
    // کسی که مجوز Backend این Pipeline را ندارد لینکش را هم نبیند).
    var engineeringControllers = new[] { "EngineeringDashboard", "Projects", "EngineeringDocuments", "DocumentRegister", "DocumentRevisions", "DocumentWorkflow", "VDR", "VDRImport", "MDRImport", "Transmittal", "MDB", "ProcurementPackage", "MaterialRequisition", "Discipline" };
    var aiControllers = new[] { "DocumentUpload", "EngineeringDocumentIntelligence", "KnowledgeBase", "AISearch", "ChatAssistant", "AIInsights" };
    var correspondenceControllers = new[] { "Letter", "DCC", "TechnicalQuery" };
    var qualityControllers = new[] { "QC", "MOC" };
    var contractControllers = new[] { "Contract", "Vendor" };
    var projectControlControllers = new[] { "Task", "Tag", "Report", "Meeting" };
    var cmmsControllers = new[] { "Equipment", "EquipmentImport", "Instrument", "Asset", "MaintenanceStrategy", "MaintenancePlan", "JobPlan", "WorkRequest", "WorkOrder", "SparePart", "Team", "Crew", "ShiftHandover", "MaintenanceMasterData", "EquipmentClassification", "RcmFmea", "EquipmentCriticality", "CriticalityAssessment", "FunctionalLocation", "FunctionalLocationImport", "Reliability", "Inspection", "Kpi", "Permit", "CmmsReadiness", "CmmsOperations" };
    var inventoryControllers = new[] { "Inventory", "MaterialItem", "InventoryMasterData", "InventoryTransaction", "StoreRequisition", "MrsImport" };
    var aiAdminControllers = new[] { "Intake", "OCRProcessing", "AIExtraction", "TableExtraction", "Relationship" };
    var adminControllers = new[] { "Settings", "Users", "Roles", "PermissionMatrix", "AuditLog", "RoutingRules", "Department", "Employee" };

    bool ContainsActive(string[] controllers) => controllers.Any(c => currentController.Equals(c, StringComparison.OrdinalIgnoreCase));
}

