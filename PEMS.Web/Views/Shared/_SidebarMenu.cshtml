            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("DocumentRevisions"))" asp-controller="DocumentRevisions" asp-action="Index" asp-area="">
                <pems-icon name="bi-clock-history" /> @Localizer["Document Revision"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("DocumentWorkflow"))" asp-controller="DocumentWorkflow" asp-action="Index" asp-area="">
                <pems-icon name="bi-diagram-2" /> @Localizer["Document Workflow"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("VDR"))" asp-controller="VDR" asp-action="Index" asp-area="">
                <pems-icon name="bi-journal-check" /> @Localizer["VDR"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("Transmittal"))" asp-controller="Transmittal" asp-action="Index" asp-area="">
                <pems-icon name="bi-send" /> @Localizer["Transmittal"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("MDB"))" asp-controller="MDB" asp-action="Index" asp-area="">
                <pems-icon name="bi-collection" /> @Localizer["MDB"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("Discipline"))" asp-controller="Discipline" asp-action="Index" asp-area="">
                <pems-icon name="bi-diagram-3" /> @Localizer["Disciplines"]
            </pems-nav-link>
        </div>
    }


    @if (navVisibility.IsModuleVisible("AIIntelligence"))
    {
        var active = ContainsActive(aiControllers);
        <div class="nav-section-title" data-bs-toggle="collapse" data-bs-target="#sec-ai" role="button" tabindex="0" aria-expanded="@active.ToString().ToLower()">
            <pems-icon name="bi-robot" css="nav-section-icon" />
            <span>@Localizer["AI & Knowledge"]</span>
            <i class="@ChevronClass(active)"></i>
        </div>
        <div class="@SectionClass(active)" id="sec-ai">

            <pems-nav-link item="false" active="@(IsActive("EngineeringDocumentIntelligence"))" asp-controller="EngineeringDocumentIntelligence" asp-action="Index" asp-area="">
                <pems-icon name="bi-diagram-3-fill" /> @Localizer["DocumentIntelligence"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("KnowledgeBase"))" asp-controller="KnowledgeBase" asp-action="Index" asp-area="">
                <pems-icon name="bi-stars" /> @Localizer["KnowledgeBaseSearch"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("AISearch"))" asp-controller="AISearch" asp-action="Index" asp-area="">
                <pems-icon name="bi-search-heart" /> @Localizer["AI Search"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("ChatAssistant"))" asp-controller="ChatAssistant" asp-action="Index" asp-area="">
