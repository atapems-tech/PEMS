    @{
        // طبق «PEMS — Quick Setup & Domain Import Architecture Refactoring» بند ۹/۲۸: Import
        // Center به‌عنوان زیربخش سایدباری حذف شد - Administration دیگر محل اصلی Importهای
        // عملیاتی نیست (آن‌ها به Engineering/CMMS/Inventory برگشتند، بالاتر در همین فایل).
        // Administration دوباره فقط برای SystemAdmin است - هر زیربخش (User & Access/
        // Organization/AI Administration/System Monitoring) دسترسی خودش را کنترل می‌کند.
        var canSeeAdminCore = MenuAccess.CanSee(User, MenuAccess.Administration);
