@using PEMS.Web.Security
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Application.Interfaces
@inject IStringLocalizer<SharedResource> Localizer
@inject IPermissionService PermissionService
@inject IRoleModuleActionService RoleActions
@inject ICurrentUserService CurrentUserService
@inject IReplenishmentAvailability ReplenishmentAvailability
@inject PEMS.Web.Security.NavigationVisibilityResolver NavigationVisibilityResolver
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    // طبق «PEMS — Quick Setup & Domain Import Architecture Refactoring» بند ۱۰: Quick Setup یک
    // قابلیت مجوزمحور است (Setup/View)، نه یک آیتم منوی نقش-محور مثل بقیه‌ی سایدبار - به همین
    // دلیل، برخلاف بقیه‌ی این فایل، مستقیماً از IPermissionService استفاده می‌کند.
    // کاتالوگ قطعه: درخواست‌دهنده‌ها نقش‌های Inventory/CMMS ندارند؛ دیدن بخش Warehouse برای آن‌ها مجوزمحور است.
    var pcActions = new Dictionary<string, bool>();
    foreach (var a in new[] { "Create", "Review", "Approve", "Admin" })
        pcActions[a] = await RoleActions.HasActionAsync(CurrentUserService.Roles, "PartCatalogue", a);
    var canSeePartCatalogue = pcActions.Values.Any(v => v);
    var canAdminPartCatalogue = pcActions["Admin"];
    // SCRUM-478: the reports are for everyone who may view the Part Catalogue (View, Review, Approve or Admin)
    var canSeePartCatalogueReports = pcActions["Review"] || pcActions["Approve"] || pcActions["Admin"]
        || await RoleActions.HasActionAsync(CurrentUserService.Roles, "PartCatalogue", "View");

    var canSeeQuickSetup = await PermissionService.HasPermissionAsync(CurrentUserService.Roles, "Setup", "View");
    // Phase 2 / P5: توصیه‌های تأمین مجوزمحور است (ماژول ReplenishmentRecommendation)؛ بدون مجوز، لینک دیده نمی‌شود (Sidebar visible + denied = BAD)
    // دروازه‌ی موقت P5: وقتی غیرفعال است (پیش‌فرض) هیچ بررسی مجوزی برای P5 انجام نمی‌شود (&& کوتاه‌شونده) و لینک نمایش داده نمی‌شود
    var canSeeReplenishment = ReplenishmentAvailability.IsEnabled && await PermissionService.HasPermissionAsync(CurrentUserService.Roles, "ReplenishmentRecommendation", "View");
    // Discipline Master Data: مجوزمحور (ماژول DisciplineMaster)، نه نقش-محور؛ بدون دادن بخش Administration کامل به نقش‌های غیرادمین
    var canSeeDisciplineMaster = await PermissionService.HasPermissionAsync(CurrentUserService.Roles, "DisciplineMaster", "View");
    var canSeePreProcurement = await PermissionService.HasPermissionAsync(CurrentUserService.Roles, "PreProcurement", "View");   // SCRUM-471

    // مرکز Import: ورودی واحد سایدبار برای همه‌ی Importها (ImportCatalog). فقط نقش را (بدون DB) می‌سنجد؛ کاربری که
    // قبلاً حداقل یک لینک Import پراکنده می‌دید، این ورودی را می‌بیند و برعکس. مجوز دقیق هر Import در خودِ صفحه‌ی مرکز
    // Import و - مرجع نهایی - در Controller همان Import اعمال می‌شود.
    var canSeeImportCenter = ImportCatalog.VisibleByRole(User).Any();

    // طبق سند «PEMS Phase 6 — User Module & Navigation Visibility Architecture»: تنها نقطه‌ی
    // محاسبه‌ی Visibility این صفحه - یک‌بار در بالا، بقیه‌ی فایل فقط navVisibility.IsModuleVisible/
    // IsCmmsItemVisible را می‌خواند. تمام Override_های دستی مدیر همین‌جا روی پیش‌فرض‌های موجود
    // (MenuAccess/canSeeQuickSetup/canSeeImportCenter) اعمال می‌شوند - هیچ‌کدام از این پیش‌فرض‌ها
    // حذف نشدند، فقط قابل‌بازنویسی شدند.
    var navVisibility = await NavigationVisibilityResolver.ResolveAsync(CurrentUserService.Roles, new Dictionary<string, bool>
    {
        ["QuickSetup"] = canSeeQuickSetup,
        ["ImportCenter"] = canSeeImportCenter
    });
    canSeeQuickSetup = navVisibility.IsModuleVisible("QuickSetup");
    canSeeImportCenter = navVisibility.IsModuleVisible("ImportCenter");

    bool IsActive(string controller, string area = "") =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
        currentArea.Equals(area, StringComparison.OrdinalIgnoreCase);

    bool InArea(string area) =>
        currentArea.Equals(area, StringComparison.OrdinalIgnoreCase);

    string ComingSoon(string title, string section) =>
        Url.Action("Index", "ComingSoon", new { area = "", title, section }) ?? "#";

    // بخش‌های سایدبار حالا کشویی (Accordion) هستند تا اسکرول طولانی نداشته باشیم -
    // فقط بخشی که صفحه‌ی جاری در آن است باز باز می‌شود، بقیه بسته‌اند.
    string SectionClass(bool containsActive) => "collapse" + (containsActive ? " show" : "");
    string ChevronClass(bool containsActive) => "bi bi-chevron-down nav-section-chevron" + (containsActive ? " rotated" : "");

    // طبق «PEMS — Centralized Import Center»: لینک‌های پراکنده‌ی Import (MDR/VDR/Equipment/FL/Equipment↔FL/
    // Maintenance History/MRS/Document Upload) از بخش‌های دامنه حذف و زیر ورودی واحد «Import Center» جمع شدند
    // (ImportCatalog). Import همچنان قابلیتِ متعلق به ماژول خودش است: Controller/Action/مسیر/مجوز/گردش‌کار
    // هیچ‌کدام تغییر نکرد - فقط ناوبری متمرکز شد. شرط دیدن هر Import همان شرط قبلی لینک پراکنده‌ی آن است.
    var engineeringControllers = new[] { "EngineeringDashboard", "Projects", "EngineeringDocuments", "DocumentRegister", "DocumentRevisions", "DocumentWorkflow", "VDR", "Transmittal", "MDB", "Discipline" };
    var aiControllers = new[] { "EngineeringDocumentIntelligence", "KnowledgeBase", "AISearch", "ChatAssistant", "AIInsights" };
    var correspondenceControllers = new[] { "Letter", "DCC", "TechnicalQuery" };
    var qualityControllers = new[] { "QC", "MOC" };
    // SCRUM-423: خرید (از مدیریت مهندسی)، قرارداد و فروشنده (از مدیریت قرارداد) و انبار در یک بخش «تدارکات و زنجیره‌ی تأمین»
    var procurementControllers = new[] { "ProcurementPackage", "Tender", "MaterialRequisition", "Contract", "Vendor", "PurchaseOrder", "PreProcurement" };
    var projectControlControllers = new[] { "Task", "TaskManager", "Tag", "Report", "Meeting" };
    var cmmsControllers = new[] { "Equipment", "Instrument", "Asset", "MaintenanceStrategy", "FailureModeCatalog", "StrategyImport", "MaintenancePlan", "MaintenanceCalendar", "JobPlan", "WorkRequest", "WorkOrder", "SparePart", "Team", "Crew", "ShiftHandover", "MaintenanceMasterData", "EquipmentClassification", "RcmFmea", "EquipmentCriticality", "CriticalityAssessment", "FunctionalLocation", "Barcode", "Reliability", "Inspection", "Kpi", "Permit", "CmmsReadiness", "CmmsOperations" };
    var inventoryControllers = new[] { "Inventory", "MaterialItem", "IrnReceipt", "InventoryMasterData", "InventoryTransaction", "StoreRequisition", "Replenishment" };
    // طبق «PEMS Operations CMMS Boundary Correction»: Operations دیگر زیرمجموعه‌ی CMMS Integration
    // نیست - بخش سایدباری کاملاً مستقل خودش را دارد (دقیقاً هم‌الگو با جدایی Inventory & Materials
    // از CMMS Integration که از قبل در همین فایل وجود داشت).
    var operationsControllers = new[] { "Production", "ProductionOrder", "ProductionRun" };
    var aiAdminControllers = new[] { "Intake", "OCRProcessing", "AIExtraction", "TableExtraction", "Relationship" };
    var adminControllers = new[] { "Settings", "Users", "Roles", "PermissionMatrix", "AuditLog", "RoutingRules", "ContractApprovalAuthority", "PurchaseOrderAuthority", "Department", "Employee", "Authorization", "SoDPolicy", "AuthorizationAudit", "NavigationVisibility", "Organization", "OrganizationImport", "DatabaseUpdate", "Numbering" };

    bool ContainsActive(string[] controllers) => controllers.Any(c => currentController.Equals(c, StringComparison.OrdinalIgnoreCase));
    // Warehouse یک Area مستقل است؛ کنترلرهای هم‌نام در Areaهای دیگر نباید بخش را فعال کنند
    bool ContainsActiveInArea(string area, string[] controllers) => InArea(area) && ContainsActive(controllers);
}

