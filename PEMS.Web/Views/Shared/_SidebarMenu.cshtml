            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("Projects"))" asp-controller="Projects" asp-action="Index" asp-area="">
                <pems-icon name="bi-kanban" /> @Localizer["Projects"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("EngineeringDocuments"))"
               asp-controller="EngineeringDocuments" asp-action="Index" asp-area="">
                <pems-icon name="bi-file-earmark-text" /> @Localizer["EngineeringDocuments"]
