        <div class="nav-section-title" data-bs-toggle="collapse" data-bs-target="#sec-correspondence" role="button" tabindex="0" aria-expanded="@active.ToString().ToLower()">
            <pems-icon name="bi-envelope-paper" css="nav-section-icon" />
            <span>@Localizer["CorrespondenceDocControl"]</span>
            <i class="@ChevronClass(active)"></i>
        </div>
        <div class="@SectionClass(active)" id="sec-correspondence">

            <pems-nav-link item="false" active="@(IsActive("Letter") && ViewContext.RouteData.Values["action"]!.ToString() != "MyReferrals")"
               asp-controller="Letter" asp-action="Index" asp-area="">
                <pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("Letter") && ViewContext.RouteData.Values["action"]!.ToString() == "MyReferrals")"
               asp-controller="Letter" asp-action="MyReferrals" asp-area="">
                <pems-icon name="bi-person-check" /> @Localizer["MyReferrals"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("DCC"))" asp-controller="DCC" asp-action="Index" asp-area="">
                <pems-icon name="bi-building-gear" /> @Localizer["DCC"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("TechnicalQuery"))" asp-controller="TechnicalQuery" asp-action="Index" asp-area="">
                <pems-icon name="bi-question-circle" /> @Localizer["TQ / TSR / RFI"]
            </pems-nav-link>
        </div>
