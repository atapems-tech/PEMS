    @if (navVisibility.IsModuleVisible("QualityControl"))
    {
        var active = ContainsActive(qualityControllers);
        <div class="nav-section-title" data-bs-toggle="collapse" data-bs-target="#sec-quality" role="button" tabindex="0" aria-expanded="@active.ToString().ToLower()">
            <pems-icon name="bi-patch-check" css="nav-section-icon" />
            <span>@Localizer["QualityControl"]</span>
            <i class="@ChevronClass(active)"></i>
        </div>
        <div class="@SectionClass(active)" id="sec-quality">

            <pems-nav-link item="false" active="@(IsActive("QC"))" asp-controller="QC" asp-action="Index" asp-area="">
                <pems-icon name="bi-patch-check" /> @Localizer["QC / QA"]
            </pems-nav-link>

            <pems-nav-link item="false" active="@(IsActive("MOC"))" asp-controller="MOC" asp-action="Index" asp-area="">
                <pems-icon name="bi-arrow-repeat" /> @Localizer["MOC"]
            </pems-nav-link>
        </div>
    }


    @* SCRUM-423: تدارکات و زنجیره‌ی تأمین، مثل CMMS یک بخش با زیرعنوان. هر پیوند همان شرط قبلی‌اش را دارد (ماژول بخش قبلی:
       مهندسی برای MR/بسته/مناقصه، قرارداد برای قرارداد/فروشنده/PO، انبار و کاتالوگ قطعه برای انبار)؛ زیرعنوانِ بی‌پیوند رندر نمی‌شود. *@
    @{
        var engProcurementVisible = navVisibility.IsModuleVisible("EngineeringManagement");
        var contractVisible = navVisibility.IsModuleVisible("ContractManagement");
        var inventoryVisible = navVisibility.IsModuleVisible("Inventory");
        var warehouseControllers = inventoryControllers.Concat(new[] { "PartCatalogueRequest", "PartCatalogueAdmin" }).ToArray();
    }
    @if (engProcurementVisible || contractVisible || inventoryVisible || canSeePartCatalogue || canSeePreProcurement)
    {
        var active = ContainsActive(procurementControllers) || ContainsActiveInArea("Warehouse", warehouseControllers);
        <div class="nav-section-title" data-bs-toggle="collapse" data-bs-target="#sec-procurement" role="button" tabindex="0" aria-expanded="@active.ToString().ToLower()">
            <pems-icon name="bi-cart3" css="nav-section-icon" />
            <span>@Localizer["Nav_ProcurementSupplyChain"]</span>
            <i class="@ChevronClass(active)"></i>
        </div>
        <div class="@SectionClass(active)" id="sec-procurement">

            @if (contractVisible)
            {
                <pems-nav-link item="false" active="@(IsActive("Vendor"))" asp-controller="Vendor" asp-action="Index" asp-area="">
                    <pems-icon name="bi-building" /> @Localizer["Vendors"]
                </pems-nav-link>
            }

            @if (engProcurementVisible || contractVisible || canSeePreProcurement)
            {
                <div class="nav-subheading">@Localizer["Nav_Proc_Purchasing"]</div>
            }
            @if (canSeePreProcurement)
            {
                <pems-nav-link item="false" active="@(IsActive("PreProcurement"))" asp-controller="PreProcurement" asp-action="Index" asp-area="">
                    <pems-icon name="bi-inbox" /> @Localizer["Ppr_Title"]
                </pems-nav-link>
            }
            @if (engProcurementVisible)
            {
                <pems-nav-link item="false" active="@(IsActive("MaterialRequisition"))" asp-controller="MaterialRequisition" asp-action="Index" asp-area="">
                    <pems-icon name="bi-cart-check" /> @Localizer["Material Requisition"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("ProcurementPackage"))" asp-controller="ProcurementPackage" asp-action="Index" asp-area="">
                    <pems-icon name="bi-folder2-open" /> @Localizer["ProcurementPackage"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("Tender"))" asp-controller="Tender" asp-action="Index" asp-area="">
                    <pems-icon name="bi-clipboard-check" /> @Localizer["Tender"]
                </pems-nav-link>
            }
            @if (contractVisible)
            {
                <pems-nav-link item="false" active="@(IsActive("PurchaseOrder"))" asp-controller="PurchaseOrder" asp-action="Index" asp-area="">
                    <pems-icon name="bi-receipt" /> @Localizer["Purchase Orders"]
                </pems-nav-link>

                <div class="nav-subheading">@Localizer["Contracts"]</div>

                <pems-nav-link item="false" active="@(IsActive("Contract"))" asp-controller="Contract" asp-action="Index" asp-area="">
                    <pems-icon name="bi-file-earmark-ruled" /> @Localizer["Contracts"]
                </pems-nav-link>

                <pems-nav-link item="false" href="@ComingSoon("Contract Milestones", "Contract Management")">
                    <pems-icon name="bi-flag" /> @Localizer["Contract Milestones"]
                </pems-nav-link>

                <pems-nav-link item="false" href="@ComingSoon("Claims", "Contract Management")">
                    <pems-icon name="bi-exclamation-diamond" /> @Localizer["Claims"]
                </pems-nav-link>
            }

            @if (inventoryVisible || canSeePartCatalogue)
            {
                <div class="nav-subheading">@Localizer["Warehouse"]</div>
            }
            @if (inventoryVisible)
            {
                <pems-nav-link item="false" active="@(IsActive("Inventory", "Warehouse"))" asp-controller="Inventory" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-speedometer2" /> @Localizer["Dashboard"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("MaterialItem", "Warehouse"))" asp-controller="MaterialItem" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-box-seam" /> @Localizer["Material Master"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("IrnReceipt", "Warehouse"))" asp-controller="IrnReceipt" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-truck" /> @Localizer["Incoming Receipts (IRN)"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("InventoryTransaction", "Warehouse"))" asp-controller="InventoryTransaction" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-list-ul" /> @Localizer["Transaction Ledger"]
                </pems-nav-link>

                <pems-nav-link item="false" active="@(IsActive("StoreRequisition", "Warehouse"))" asp-controller="StoreRequisition" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-clipboard-check" /> @Localizer["Store Requisitions"]
                </pems-nav-link>

                @if (canSeeReplenishment)
                {
                    <pems-nav-link item="false" active="@(IsActive("Replenishment", "Warehouse"))" asp-controller="Replenishment" asp-action="Index" asp-area="Warehouse">
                        <pems-icon name="bi-cart-plus" /> @Localizer["Repl_Menu"]
                    </pems-nav-link>
                }

                <pems-nav-link item="false" active="@(IsActive("InventoryMasterData", "Warehouse"))" asp-controller="InventoryMasterData" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-collection" /> @Localizer["Master Data"]
                </pems-nav-link>
            }
            @if (canSeePartCatalogue)
            {
                <pems-nav-link item="false" active="@(IsActive("PartCatalogueRequest", "Warehouse"))" asp-controller="PartCatalogueRequest" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]
                </pems-nav-link>
            }
            @if (canSeePartCatalogueReports)
            {
                <pems-nav-link item="false" active="@(IsActive("PartCatalogueReport", "Warehouse"))" asp-controller="PartCatalogueReport" asp-action="Index" asp-area="Warehouse">
                    <pems-icon name="bi-bar-chart-line" /> @Localizer["PcRpt_Menu"]
                </pems-nav-link>
