@* Adapter of the shared pagination footer. The markup lives in PEMS.UI (_PemsPagination.cshtml); this file only fills the
   texts from the resource files, so the 54 list pages keep calling _Pagination with a PaginationViewModel.
   Model: PEMS.Web.ViewModels.PaginationViewModel *@
@model PEMS.Web.ViewModels.PaginationViewModel
@using Microsoft.Extensions.Localization
@using PEMS.UI.Abstractions
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@await Html.PartialAsync("_PemsPagination", new PaginationView(Model, new PaginationTexts
{
    ShowingRecords = TranslatableText.Literal(Localizer["ShowingRecords"].Value),
    NoResults = TranslatableText.Literal(Localizer["NoResultsFound"].Value),
    RowsPerPage = TranslatableText.Literal(Localizer["RowsPerPage"].Value),
    FirstPage = TranslatableText.Literal(Localizer["FirstPage"].Value),
    PreviousPage = TranslatableText.Literal(Localizer["PreviousPage"].Value),
    NextPage = TranslatableText.Literal(Localizer["NextPage"].Value),
    LastPage = TranslatableText.Literal(Localizer["LastPage"].Value)
}))