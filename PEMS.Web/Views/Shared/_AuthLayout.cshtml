@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using System.Globalization
@{
    // SCRUM-477: the sign-in pages follow the current language like the main layout (Persian = right to left).
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    // طبق «PEMS Global Three-Theme Design System» (بند ۲۹): صفحه‌ی Login هم باید در هر سه تم
    // بررسی شود. قبلاً این Layout اصلاً data-theme تنظیم نمی‌کرد - auth.css فقط یک قاب برند
    // ثابت (گرادیان navy) داشت. همان Cookie/منطق ThemeController موجود این‌جا هم خوانده می‌شود -
    // بدون مکانیزم موازی تازه.
    var currentTheme = PEMS.Web.Controllers.ThemeController.Normalize(Context.Request.Cookies[PEMS.Web.Controllers.ThemeController.CookieName]);
    var isLoginPage = ViewData["AuthPage"] as string == "login";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@currentTheme" data-bs-theme="@(currentTheme is "turquoise" or "dark" ? "dark" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/pems-icon-32.png" />
    <link rel="apple-touch-icon" href="~/images/pems-icon-180.png" />
    @* SCRUM-540: the title is a resource key like in _Layout (a title without a key is shown as written) *@
    <title>@(string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString()) ? "" : Localizer[ViewData["Title"]!.ToString()!].Value) - PEMS</title>
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    @* طبق «PEMS Premium Three-Theme UI/UX Redesign» (بند ۲۸): صفحه‌ی ورود باید ویترین کامل
       هویت Persian Turquoise باشد - برای این کار به همون توکن‌های --pems-*/Glass/Persian
       Geometry سراسری (site.css + pems-glass.css) نیاز دارد، نه یک نسخه‌ی موازی. auth.css بعد
       از این‌ها بارگذاری می‌شود تا سبک‌های اختصاصی خودش (قاب برند) برنده بمانند. *@
    <link rel="stylesheet" href="~/_content/PEMS.UI/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-inline-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body @(isLoginPage ? "auth-body-login" : "")">

    <div class="auth-wrapper @(isLoginPage ? "auth-wrapper-login" : "")">

        <div class="auth-brand @(isLoginPage ? "auth-brand-login" : "")">
            @if (isLoginPage)
            {
                <div class="auth-hero-header">
                    <div class="auth-brand-logo-wrap">
                        <img src="~/images/pems-logo-transparent.png" alt="PEMS" class="auth-hero-logo" />
                        <div class="auth-brand-title-group">
                            <div class="auth-brand-pems">PEMS</div>
                            <div class="auth-brand-full">Parmis Enterprise Management System</div>
                            <div class="auth-brand-glow-bar"></div>
                        </div>
                    </div>
                </div>

                <div class="auth-hero-banner">
                    <h2 class="auth-story-title">
                        <span class="title-fa">@Localizer["Auth_HeroTitle"]</span>
                        <span class="title-sep">|</span>
                        <span class="title-en">@Localizer["Auth_HeroTitleEn"]</span>
                    </h2>
                    <p class="auth-story-description">@Localizer["Auth_HeroDescription"]</p>
                </div>

                <div class="auth-features-row">
                    <div class="auth-feature-card">
                        <div class="feature-icon"><i class="bi bi-gear-fill"></i></div>
                        <div class="feature-name">@Localizer["Auth_FeatureOperations"]</div>
                        <div class="feature-sub">Operations</div>
                    </div>
                    <div class="auth-feature-card">
                        <div class="feature-icon"><i class="bi bi-boxes"></i></div>
                        <div class="feature-name">@Localizer["Auth_FeatureResources"]</div>
                        <div class="feature-sub">Resources</div>
                    </div>
                    <div class="auth-feature-card">
                        <div class="feature-icon"><i class="bi bi-people-fill"></i></div>
                        <div class="feature-name">@Localizer["Auth_FeaturePeople"]</div>
                        <div class="feature-sub">HR Management</div>
                    </div>
                    <div class="auth-feature-card">
                        <div class="feature-icon"><i class="bi bi-database-fill"></i></div>
                        <div class="feature-name">@Localizer["Auth_FeatureFinance"]</div>
                        <div class="feature-sub">Finance</div>
                    </div>
                    <div class="auth-feature-card">
                        <div class="feature-icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <div class="feature-name">@Localizer["Auth_FeatureReports"]</div>
                        <div class="feature-sub">Reports &amp; Analytics</div>
                    </div>
                </div>

                <div class="auth-hero-graphic-wrap">
                    <img src="~/images/pems-refinery-hud-hd.png" alt="PEMS Industrial HUD" class="auth-refinery-hud-img" />
                </div>
            }
            else
            {
                <div class="auth-brand-icon" aria-hidden="true">
                    <pems-icon name="bi-diagram-3-fill" aria-hidden="true" />
                </div>
                <div class="auth-brand-text">
                    <pems-heading level="1">@Localizer["PEMS"]</pems-heading>
                    <span>@Localizer["Auth_BrandName"]</span>
                </div>
            }
        </div>

        <div class="auth-card @(isLoginPage ? "auth-card-login" : "")">
            @RenderBody()
        </div>

        <div class="auth-footer @(isLoginPage ? "auth-footer-login" : "")">
            &copy; @DateTime.Now.Year PEMS &mdash; @Localizer["Auth_Footer"]
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/PEMS.UI/pems-form.js" asp-append-version="true"></script>
    <script src="~/js/pems-actions.js" asp-append-version="true"></script>
    <script src="~/js/pems-template.js" asp-append-version="true"></script>   @* SCRUM-536: account-login.js clones the login-busy template *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
