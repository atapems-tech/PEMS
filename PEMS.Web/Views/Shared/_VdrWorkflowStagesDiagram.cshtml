@* ==============================================================================
   نمودار گرافیکی چرخه‌ی گردش‌کار VDR. Model یک رشته است: وضعیت فعلی
   (Planned/Submitted/UnderReview/PendingResubmission/Closed) + مرحله‌ی جاری از موتور.
   ============================================================================== *@
@model (string WorkflowStatus, string? CurrentStageName)

@{
    var status = Model.WorkflowStatus ?? "Planned";
    var stageName = Model.CurrentStageName;

    var stageOrder = new[] { "Planned", "Check", "DisciplineReview", "LeadReview", "ReturnToVendor", "Closed" };

    var stageLabels = new Dictionary<string, string>
    {
        ["Planned"] = "Planned",
        ["Check"] = "Submitted",
        ["DisciplineReview"] = "بازبینی موازی",
        ["LeadReview"] = "تصمیم نهایی",
        ["ReturnToVendor"] = "بازگشت به وندور",
        ["Closed"] = "Closed"
    };

    var stageIcons = new Dictionary<string, string>
    {
        ["Planned"] = "bi-hourglass",
        ["Check"] = "bi-send",
        ["DisciplineReview"] = "bi-diagram-3",
        ["LeadReview"] = "bi-clipboard-check",
        ["ReturnToVendor"] = "bi-reply",
        ["Closed"] = "bi-check2-circle"
    };

    var stageRoles = new Dictionary<string, string>
    {
        ["Planned"] = "Vendor",
        ["Check"] = "Vendor",
        ["DisciplineReview"] = "دیسیپلین‌های ارجاع‌شده",
        ["LeadReview"] = "Eng. Supervisor / Manager",
        ["ReturnToVendor"] = "Document Controller",
        ["Closed"] = "—"
    };

    var isPendingResubmission = status == "PendingResubmission";

    // اندیس مرحله‌ی جاری: اگر گردش‌کار در حال اجراست از نام مرحله‌ی موتور استفاده می‌شود،
    // وگرنه از روی وضعیت خلاصه (WorkflowStatus) تخمین زده می‌شود
    int currentIndex;
    if (!string.IsNullOrEmpty(stageName) && Array.IndexOf(stageOrder, stageName) >= 0)
    {
        currentIndex = Array.IndexOf(stageOrder, stageName);
    }
    else if (status == "Closed")
    {
        currentIndex = stageOrder.Length - 1;
    }
    else if (isPendingResubmission)
    {
        currentIndex = Array.IndexOf(stageOrder, "LeadReview");
    }
    else
    {
        currentIndex = 0;
    }
}

<style>
    .pems-wf-diagram { display: flex; align-items: flex-start; justify-content: space-between; padding: 1.5rem 0.5rem; overflow-x: auto; }
    .pems-wf-step { display: flex; flex-direction: column; align-items: center; min-width: 92px; text-align: center; position: relative; z-index: 1; }
    .pems-wf-circle { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; border: 2px solid #dee2e6; background: #fff; color: #adb5bd; transition: all .2s; }
    .pems-wf-step.done .pems-wf-circle { background: #198754; border-color: #198754; color: #fff; }
    .pems-wf-step.current .pems-wf-circle { background: #0d6efd; border-color: #0d6efd; color: #fff; box-shadow: 0 0 0 4px rgba(13,110,253,.2); animation: pems-wf-pulse-vdr 1.6s infinite; }
    .pems-wf-step.rejected .pems-wf-circle { background: #dc3545; border-color: #dc3545; color: #fff; }
    .pems-wf-label { font-size: .78rem; font-weight: 600; margin-top: .4rem; color: #495057; }
    .pems-wf-step.current .pems-wf-label { color: #0d6efd; }
    .pems-wf-step.rejected .pems-wf-label { color: #dc3545; }
    .pems-wf-role { font-size: .68rem; color: #adb5bd; margin-top: .1rem; }
    .pems-wf-connector { flex: 1; height: 2px; background: #dee2e6; margin-top: 22px; min-width: 20px; }
    .pems-wf-connector.done { background: #198754; }
    @@keyframes pems-wf-pulse-vdr { 0% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } 50% { box-shadow: 0 0 0 8px rgba(13,110,253,.08); } 100% { box-shadow: 0 0 0 4px rgba(13,110,253,.2); } }
</style>

@if (isPendingResubmission)
{
    <div class="alert alert-warning py-2 px-3 mb-3 small">
        <i class="bi bi-arrow-repeat"></i> این مدرک نیاز به <strong>ارسال مجدد</strong> از سمت وندور دارد (Comment/Reject در تصمیم نهایی).
    </div>
}

<div class="pems-wf-diagram">
    @for (var i = 0; i < stageOrder.Length; i++)
    {
        var key = stageOrder[i];
        var cssClass = isPendingResubmission && i >= currentIndex && key != "Planned" && key != "Check" ? (i == currentIndex ? "rejected" : "")
            : i < currentIndex ? "done"
            : i == currentIndex ? "current"
            : "";

        <div class="pems-wf-step @cssClass">
            <div class="pems-wf-circle">
                @if (cssClass == "done")
                {
                    <i class="bi bi-check-lg"></i>
                }
                else if (cssClass == "rejected")
                {
                    <i class="bi bi-x-lg"></i>
                }
                else
                {
                    <i class="bi @stageIcons[key]"></i>
                }
            </div>
            <div class="pems-wf-label">@stageLabels[key]</div>
            <div class="pems-wf-role">@stageRoles[key]</div>
        </div>

        if (i < stageOrder.Length - 1)
        {
            var connClass = i < currentIndex ? "done" : "";
            <div class="pems-wf-connector @connClass"></div>
        }
    }
</div>
