@using Microsoft.Extensions.Localization
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* Letter pages: rich-text editor ("a small Word" for letters) on the textarea whose id is the model (without #).
   SCRUM-59: an adapter over the one PEMS editor (PEMS.UI/wwwroot/pems-rte.js, Quill vendored): no editor code here.
   The marker below names the textarea, the image upload URL of Letters and the editor's accessible name; pems-rte.js puts the editor
   directly under the textarea (inside the field's column, not detached below the card), names every toolbar control (aria-label) and
   raises 'rte-change' on the textarea. It also brings the toolbar texts and the script, because Letter Details can run in _LayoutEmbed.
   The server sanitizes the posted HTML (IRichTextSanitizerService). *@
@model string

<span hidden data-pems-rte-for="@Model" data-pems-rte-upload="@Url.Content("~/Letter/UploadEditorImage")" data-pems-rte-label="@Localizer["Rte_Editor"]"
      data-pems-rte-texts="@RichTextEditorTexts.Json(Localizer)" data-pems-rte-lib="@Url.Content("~/lib/quill/")"></span>
<link rel="stylesheet" href="~/_content/PEMS.UI/pems-rte.css" asp-append-version="true" />
<script src="~/_content/PEMS.UI/pems-rte.js" asp-append-version="true"></script>
