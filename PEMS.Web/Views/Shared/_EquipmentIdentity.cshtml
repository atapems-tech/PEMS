@model PEMS.Application.DTOs.EquipmentIdentityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var areaUnit = string.Join(" / ", new[] { Model.Area, Model.Unit }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
@* هویت تجهیز فقط‌خواندنی - همه‌جا (فرم استراتژی، Plan، Tag، WO) یکسان: تگ، نام، کلاس، ناحیه/واحد، بحرانی‌بودن.
   تگ هرگز فیلد متنی آزاد نیست؛ از ثبت تجهیز خوانده می‌شود. *@
<div class="border rounded p-2 mb-3 small bg-light" data-equipment-identity>
    <pems-row gap="2">
        <pems-col md="3">
            <div class="text-muted">@Localizer["Rcm_Tag"]</div>
            <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId" class="fw-bold">@Model.Tag</a>
        </pems-col>
        <pems-col md="3">
            <div class="text-muted">@Localizer["Rcm_EquipmentName"]</div>
            <div>@Model.Name</div>
        </pems-col>
        <pems-col md="3">
            <div class="text-muted">@Localizer["Rcm_EquipmentClass"]</div>
            <div>@(string.IsNullOrEmpty(Model.EquipmentClassName) ? Localizer["Rcm_Unclassified"].Value : Model.EquipmentClassName)</div>
        </pems-col>
        <pems-col md="2">
            <div class="text-muted">@Localizer["Rcm_AreaUnit"]</div>
            <div>@(areaUnit.Length > 0 ? areaUnit : "-")</div>
        </pems-col>
        <pems-col md="1">
            <div class="text-muted">@Localizer["Rcm_Criticality"]</div>
            <pems-badge tone="@RcmDisplay.CriticalityBadge(Model.CriticalityClass)">@Localizer.Label("Criticality", Model.CriticalityClass ?? "Unrated")</pems-badge>
        </pems-col>
    </pems-row>
</div>
