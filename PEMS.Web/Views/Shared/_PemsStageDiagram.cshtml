@* ==============================================================================
   طبق «PEMS Phase 2C-3 — Safe Extraction of Shared Stage Diagram»: جایگزین دو پیاده‌سازی
   مستقل ولی از نظر CSS تقریباً یکسان (_WorkflowStagesDiagram برای EDMS و
   _VdrWorkflowStagesDiagram برای VDR). این Partial کاملاً Stateless و بدون منطق
   کسب‌وکار/گردش‌کار/مجوز است - فقط یک لیست از پیش‌محاسبه‌شده‌ی (Label, Icon, Role?, State)
   را رندر می‌کند. تصمیم این‌که کدام مرحله Done/Current/Pending/Rejected است، همچنان کاملاً
   در همان View مصرف‌کننده (بر اساس Status/CurrentStageName دامنه‌محور خودش) محاسبه می‌شود -
   دقیقاً همان مسئولیتی که هرکدام از دو پیاده‌سازی قبلی از قبل داشتند؛ هیچ منطق تصمیم‌گیری
   جدیدی این‌جا اضافه نشده.

   طبق ممیزی فاز ۲C-۳: _WorkOrderStagesDiagram (سومین پیاده‌سازی موجود) عمداً در این فاز به
   این Partial مهاجرت نکرد - CSS آن کاملاً مستقل و با اندازه/تایپوگرافی متفاوت است (بدون خط
   نقش، دایره‌ی کوچک‌تر) و بدون امکان تأیید بصری واقعی (بدون مرورگر در این محیط)، مهاجرت آن
   یک تغییر بصری غیرقابل‌اثبات به WorkOrder تحمیل می‌کرد. جزئیات کامل در گزارش ممیزی همان
   فاز.
   ============================================================================== *@
@model PEMS.Web.Models.StageDiagramViewModel

@{
    string StepCssClass(PEMS.Web.Models.StageItemState state) => state switch
    {
        PEMS.Web.Models.StageItemState.Done => "done",
        PEMS.Web.Models.StageItemState.Current => "current",
        PEMS.Web.Models.StageItemState.Rejected => "rejected",
        _ => ""
    };
}

<div class="pems-wf-diagram">
    @for (var i = 0; i < Model.Stages.Count; i++)
    {
        var item = Model.Stages[i];
        var cssClass = StepCssClass(item.State);

        <div class="pems-wf-step @cssClass">
            <div class="pems-wf-circle">
                @if (item.State == PEMS.Web.Models.StageItemState.Done)
                {
                    <pems-icon name="bi-check-lg" />
                }
                else if (item.State == PEMS.Web.Models.StageItemState.Rejected)
                {
                    <pems-icon name="bi-x-lg" />
                }
                else
                {
                    <pems-icon css="@item.IconCssClass" />
                }
            </div>
            <div class="pems-wf-label">@item.Label</div>
            @if (!string.IsNullOrEmpty(item.RoleLabel))
            {
                <div class="pems-wf-role">@item.RoleLabel</div>
            }
        </div>

        if (i < Model.Stages.Count - 1)
        {
            var connClass = item.State == PEMS.Web.Models.StageItemState.Done ? "done" : "";
            <div class="pems-wf-connector @connClass"></div>
        }
    }
</div>
