@using System.Globalization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@using PEMS.Application.Interfaces
@using PEMS.Web.Resources
@using PEMS.Web.Security
@inject IStringLocalizer<SharedResource> Localizer
@inject INotificationService NotificationService
@inject ICurrentUserService CurrentUser
@inject PEMS.Web.Navigation.IDynamicSidebarAvailability DynamicSidebar
@{
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string LocalizedPageTitle(string? s) { if (string.IsNullOrWhiteSpace(s)) return s ?? ""; var l = Localizer[s]; return l.ResourceNotFound ? s : l.Value; }
    var currentTheme = PEMS.Web.Controllers.ThemeController.Normalize(Context.Request.Cookies[PEMS.Web.Controllers.ThemeController.CookieName]);
    var currentUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var isAdminArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);

    // طبق PEMS-UI-01 (UI01-007): بج اعلان قبلاً فقط با رویدادهای زنده‌ی SignalR افزایش می‌یافت،
    // هرگز با تعداد واقعی خوانده‌نشده در بارگذاری اولیه‌ی صفحه مقداردهی نمی‌شد.
    var unreadCount = CurrentUser.IsAuthenticated && CurrentUser.UserId.HasValue
        ? await NotificationService.GetUnreadCountAsync(CurrentUser.UserId.Value)
        : 0;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@currentTheme" data-bs-theme="@(currentTheme is "turquoise" or "dark" ? "dark" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@(LocalizedPageTitle(ViewData["Title"]?.ToString())) - PEMS</title>
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0d6efd" />
    <script type="importmap"></script>

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-errors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jalalidatepicker/jalalidatepicker.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-date.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-global-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-data-grid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    @* طبق «PEMS Premium Three-Theme UI/UX Redesign»: لایه‌ی Glass/Persian Geometry/Loading -
       بعد از همه‌ی فایل‌های دیگر بارگذاری می‌شود تا بتواند override های محدود و هدفمند خودش
       را (فقط روی Turquoise + کلاس‌های Loading/Skeleton سراسری) اعمال کند. *@
    <link rel="stylesheet" href="~/css/pems-glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-inline-styles.css" asp-append-version="true" />

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/admin.rtl.css" asp-append-version="true" />
    }

    @if (isAdminArea)
    {
        <link rel="stylesheet" href="~/css/admin-enterprise.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/administration-design-system.css" asp-append-version="true" />
    }

    <link rel="stylesheet" href="~/PEMS.Web.styles.css" asp-append-version="true" />
    @* SCRUM-57: searchable selects on every page (Tom Select, vendored) *@
    <link rel="stylesheet" href="~/lib/tom-select/tom-select.bootstrap5.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-select.css" asp-append-version="true" />
    @* SCRUM-64: command palette (Ctrl+K) *@
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-command-palette.css" asp-append-version="true" />
    @* SCRUM-59: the one rich-text editor (Quill, vendored, loaded by pems-rte.js only on pages with a rich-text field) *@
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-rte.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAdminArea ? "admin-area" : "")" data-user-id="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value"
      data-pems-date-invalid="@Localizer["Date_Invalid"]" data-pems-error-generic="@Localizer["Err_Generic"]" data-pems-error-offline="@Localizer["Err_Offline"]" data-pems-error-timeout="@Localizer["Err_Timeout"]" data-pems-error-signin="@Localizer["Err_SignIn"]" data-pems-error-forbidden="@Localizer["Err_Forbidden"]" data-pems-error-notfound="@Localizer["Err_NotFound"]" data-pems-error-conflict="@Localizer["Err_Conflict"]" data-pems-error-invalid="@Localizer["Err_Invalid"]" data-pems-error-toomany="@Localizer["Err_TooMany"]" data-pems-error-unavailable="@Localizer["Err_Unavailable"]" data-pems-error-server="@Localizer["Err_Server"]" data-pems-error-reference="@Localizer["Err_Reference"]" data-pems-error-copy="@Localizer["Err_Copy"]" data-pems-error-copied="@Localizer["Err_Copied"]" data-pems-error-close="@Localizer["Err_Close"]"
      data-pems-confirm-title="@Localizer["Confirm_Title"]" data-pems-confirm-ok="@Localizer["Confirm_Ok"]" data-pems-confirm-cancel="@Localizer["Confirm_Cancel"]"
      data-pems-select-no-results="@Localizer["Sel_NoResults"]" data-pems-select-loading="@Localizer["Sel_Loading"]" data-pems-select-placeholder="@Localizer["Sel_Placeholder"]" data-pems-skeleton-label="@Localizer["Loading"]"
      data-pems-rte-texts="@PEMS.Web.Helpers.RichTextEditorTexts.Json(Localizer)" data-pems-rte-lib="@Url.Content("~/lib/quill/")">
    <a class="pems-skip-link" href="#pemsMainContent">@Localizer["Shell_SkipToContent"]</a>
    <header class="pems-topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="sidebar-toggle-btn" id="sidebarToggleBtn" type="button" aria-label="@Localizer["Shell_ToggleMenu"]">
                <pems-icon name="bi-list" />
            </button>
            <a class="brand text-decoration-none" asp-controller="Home" asp-action="Index" asp-area="">
                <span class="brand-icon"><pems-icon name="bi-diagram-3-fill" /></span>
                <span class="d-none d-sm-inline">@Localizer["PEMS"]</span>
            </a>
        </div>

        <div class="pems-search d-none d-md-block">
            <form class="d-flex" role="search" asp-controller="GlobalSearch" asp-action="Index" asp-area="" method="get">
                <pems-input type="search" name="q" placeholder="@Localizer["Palette_OpenHint"]" aria-label="@Localizer["Palette_OpenHint"]" aria-keyshortcuts="Control+K" data-pems-command-palette-trigger />
            </form>
        </div>
        <pems-button tone="none" css="btn-link text-secondary d-md-none px-2" type="button" data-pems-command-palette-open title="@Localizer["Palette_OpenHint"]" aria-label="@Localizer["Palette_OpenHint"]" aria-keyshortcuts="Control+K">
            <pems-icon name="bi-search" aria-hidden="true" />
        </pems-button>

        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <a href="#" class="text-secondary dropdown-toggle" data-bs-toggle="dropdown" title="@Localizer["Shell_ChangeTheme"]">
                    <pems-icon name="bi-palette-fill" css="fs-5" />
                </a>
                <pems-dropdown-menu end="true">
                    @* طبق «PEMS Global Three-Theme Design System»: محصول دقیقاً سه تم قابل‌انتخاب دارد -
                       ocean/warm/midnight از این منو حذف شدند (نه از CSS - همان‌جا دست‌نخورده مانده تا
                       چیزی نشکند)؛ turquoise (فیروزه‌ای ایرانی) امضای بصری اختصاصی PEMS است. *@
                    @foreach (var (themeValue, icon, label) in new[] {
                        ("light", "bi-sun", Localizer["Theme_Light"].Value), ("dark", "bi-moon-stars", Localizer["Theme_Dark"].Value),
                        ("turquoise", "bi-gem", Localizer["Theme_Turquoise"].Value)
                    })
                    {
                        <li>
                            <a class="dropdown-item theme-switch @(currentTheme == themeValue ? "active" : "")"
                               href="@Url.Action("SetTheme", "Theme", new { area = "", theme = themeValue, returnUrl = currentUrl })">
                                <pems-icon css="@icon me-2" /> @label
                            </a>
                        </li>
                    }
                </pems-dropdown-menu>
            </div>

            <div class="dropdown">
                <a href="#" class="text-secondary dropdown-toggle" data-bs-toggle="dropdown" title="@Localizer["Shell_Language"]">
                    <pems-icon name="bi-translate" css="fs-5" />
                </a>
                <pems-dropdown-menu end="true">
                    <li>
                        <a class="dropdown-item @(!isRtl ? "active" : "") culture-switch" href="@Url.Action("SetCulture", "Culture", new { area = "", culture = "en", returnUrl = currentUrl })">English</a>
                    </li>
                    <li>
                        <a class="dropdown-item @(isRtl ? "active" : "") culture-switch" href="@Url.Action("SetCulture", "Culture", new { area = "", culture = "fa", returnUrl = currentUrl })">فارسی</a>
                    </li>
                </pems-dropdown-menu>
            </div>

            @await Html.PartialAsync("_ContextualHelpButton")

            <a asp-controller="Help" asp-action="Index" asp-area="" class="text-secondary" title="@(isRtl ? "مرکز راهنما" : "Help Center")">
                <pems-icon name="bi-question-circle" css="fs-5" />
            </a>

            <div class="dropdown">
                <a href="#" class="text-secondary position-relative dropdown-toggle" data-bs-toggle="dropdown" id="notifBell" title="@Localizer["Notifications"]" onclick="loadNotifDropdown()">
                    <pems-icon name="bi-bell" css="fs-5" />
                    <pems-badge tone="danger" css="rounded-pill position-absolute top-0 start-100 translate-middle @(unreadCount > 0 ? "" : "d-none")" id="notifBadge">@(unreadCount > 0 ? unreadCount.ToString() : "")</pems-badge>
                </a>
                <pems-dropdown-menu as="div" end="true" css="p-0" style="min-width:320px;max-height:400px;overflow-y:auto;" id="notifDropdownBody">
                    <span class="dropdown-item small text-muted">@Localizer["Loading"]</span>
                </pems-dropdown-menu>
            </div>

            <div class="dropdown pems-user-menu">
                <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="pems-user-avatar">@(string.IsNullOrEmpty(User.Identity?.Name) ? "?" : User.Identity!.Name!.Substring(0, 1).ToUpper())</span>
                    <span class="d-none d-md-flex flex-column text-start">
                        <span class="fw-semibold">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</span>
                        <span class="text-muted pems-s-11a50812">@(User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value)</span>
                    </span>
                </button>
                <pems-dropdown-menu end="true">
                    <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                    <li><a class="dropdown-item" asp-controller="MyProfile" asp-action="Index" asp-area=""><pems-icon name="bi-person-badge" /> @Localizer["Shell_MyProfile"]</a></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ManagePasskeys" asp-area=""><pems-icon name="bi-key" /> @Localizer["Shell_Passkeys"]</a></li>
                    @if (User.IsInRole(PEMS.Persistence.Identity.SystemRoles.SystemAdmin))
                    {
                        <li><a class="dropdown-item" asp-controller="RecoveryCodes" asp-action="Index" asp-area=""><pems-icon name="bi-shield-lock" /> @Localizer["Recovery codes"]</a></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                            <button type="submit" class="dropdown-item"><pems-icon name="bi-box-arrow-right" /> @Localizer["Logout"]</button>
                        </form>
                    </li>
                </pems-dropdown-menu>
            </div>
        </div>
    </header>

    @* پنل راهنما باید بیرون از <header> باشد (Stacking Context هدر z-index:1030 است؛ در RTL پنل زیر نوار کناری می‌رفت) *@
    @await Html.PartialAsync("_ContextualHelpDrawer")

    <div class="pems-shell">
        @* سایدبار داده‌محور پشت پرچم Features:DynamicSidebar:Enabled (پیش‌فرض: سایدبار قدیمی) *@
        <partial name="@(DynamicSidebar.IsEnabled ? "_DynamicSidebarMenu" : "_SidebarMenu")" />
        <main class="pems-content" id="pemsMainContent" tabindex="-1">
            @* هدر عمومی صفحه (عنوان + برچسب ماژول) حذف شده است: عنوان صفحه در تب مرورگر و منوی کناری می‌آید و صفحه‌ها فضای بیشتری برای کار دارند. *@
            @if (isAdminArea)
            {
                <div class="admin-ui-surface">
                    @RenderBody()
                </div>
            }
            else
            {
                @RenderBody()
            }
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3 pems-s-fe1fc042" aria-live="polite" aria-atomic="false">
        @if (TempData["Message"] != null)
        {
            <pems-toast tone="success" role="alert" data-bs-delay="5000" data-bs-autohide="true">
                <div class="d-flex">
                    <div class="toast-body"><pems-icon name="bi-check-circle-fill" css="me-1" /> @TempData["Message"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </pems-toast>
        }
        @if (TempData["Error"] != null)
        {
            <pems-toast tone="danger" role="alert" data-bs-delay="7000" data-bs-autohide="true">
                <div class="d-flex">
                    <div class="toast-body"><pems-icon name="bi-exclamation-triangle-fill" css="me-1" /> @TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </pems-toast>
        }
        <div id="liveToastArea"></div>
    </div>

    <partial name="_PemsLoadingOverlay" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/PEMS.UI/pems-overlay.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-modal-fill.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-confirm.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-errors.js" asp-append-version="true"></script>
    <script src="~/lib/jalalidatepicker/jalalidatepicker.min.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-date.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-skeleton.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-tree.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-form.js" asp-append-version="true"></script>
    <script src="~/lib/tom-select/tom-select.complete.min.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-select.js" asp-append-version="true"></script>
    <script src="~/_content/PEMS.UI/pems-rte.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <pems-script-templates set="global-search"></pems-script-templates>
    <script src="~/js/pems-template.js" asp-append-version="true"></script>
    <script src="~/js/pems-global-search.js" asp-append-version="true"></script>
    <script src="~/js/pems-data-grid.js" asp-append-version="true"></script>
    <script src="~/js/pems-ui.js" asp-append-version="true"></script>
    <script src="~/js/pems-sidebar-search.js" asp-append-version="true"
            data-placeholder="@Localizer["Shell_SidebarSearch"]" data-results="@Localizer["Shell_SidebarSearchResults"]" data-empty="@Localizer["Shell_SidebarSearchEmpty"]"></script>
    <script src="~/_content/PEMS.UI/pems-command-palette.js" asp-append-version="true"
            data-search-url="@Url.Action("Palette", "SearchApi", new { area = "" })" data-actions-url="@Url.Action("PaletteActions", "SearchApi", new { area = "" })"
            data-all-url="@Url.Action("Index", "GlobalSearch", new { area = "" })" data-title="@Localizer["Palette_Title"]"
            data-placeholder="@Localizer["Palette_Placeholder"]" data-menus="@Localizer["Palette_Menus"]" data-actions="@Localizer["Palette_Actions"]"
            data-empty="@Localizer["Palette_Empty"]" data-loading="@Localizer["Palette_Loading"]" data-error="@Localizer["Palette_Error"]"
            data-keys="@Localizer["Palette_Keys"]" data-min-chars="@Localizer["Palette_MinChars"]" data-show-all="@Localizer["Palette_ShowAll"]"
            data-count="@Localizer["Palette_Count"]"></script>
    <script src="~/js/pems-loading.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr-8.0.7.min.js"></script>
    <script src="~/js/notifications-hub.js" asp-append-version="true"></script>

    <pems-script-templates set="layout"></pems-script-templates>
    <script src="~/js/views/shared-layout-1.js" asp-append-version="true"></script>

    <script src="~/js/views/shared-layout-2.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
