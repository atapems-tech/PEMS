@model List<PEMS.Application.DTOs.MDRImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>Discipline not showing after import?</strong>
            <p class="text-muted small mb-0">
                Older imports may have failed to match discipline codes (e.g. "ME" vs "MECH"). This
                re-checks previously imported documents with the improved matching and fills in the
                discipline where it can now be recognized - no need to re-import anything.
            </p>
        </div>
        <form asp-action="RematchDisciplines" method="post">
            <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-arrow-repeat"></i> Fix Discipline Matching</pems-button>
        </form>
    </div>
</div>

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>Dashboard counts not matching the register?</strong>
            <p class="text-muted small mb-0">
                Older imports could set a status like "Under Review" or "Revise &amp; Resubmit" that the
                dashboard and workflow don't recognize. This corrects those to the real workflow statuses
                (Submitted / Rejected) so counts line up everywhere.
            </p>
        </div>
        <form asp-action="FixLegacyStatuses" method="post">
            <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-speedometer2"></i> Fix Status Values</pems-button>
        </form>
    </div>
</div>

<div class="content-card mb-3" style="max-width:700px;">
    <p class="text-muted">
        فایل اکسل MDR (Master/Engineering Document Register) سازمان را آپلود کنید. سیستم همه‌ی
        شیت‌های داده‌ای (رجیستر اصلی، Freezed Docs، Not Issued Docs) را می‌خواند و شیت‌های خلاصه/گزارش
        را نادیده می‌گیرد. هیچ داده‌ای تا تایید شما در صفحه‌ی بعد وارد جداول اصلی نمی‌شود.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">@Localizer["Project"]</label>
            <select name="projectId" class="form-select" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small">MDR Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" css="w-100" type="submit"><i class="bi bi-cloud-upload"></i> @Localizer["Upload"]</pems-button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["File"]</th><th>@Localizer["Project"]</th><th>@Localizer["Date"]</th><th>@Localizer["Total"]</th><th>@Localizer["Valid"]</th><th>@Localizer["Warning"]</th><th>Error</th><th>@Localizer["Duplicate"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ProjectName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@b.RowsTotal</td>
                    <td><pems-badge tone="success">@b.RowsValid</pems-badge></td>
                    <td><pems-badge tone="warning">@b.RowsWarning</pems-badge></td>
                    <td><pems-badge tone="danger">@b.RowsError</pems-badge></td>
                    <td><pems-badge tone="neutral">@b.RowsDuplicate</pems-badge></td>
                    <td><pems-badge tone="@(b.Status == "Committed" ? "success" : "neutral")">@b.Status</pems-badge></td>
                    <td>
                        @if (b.Status == "Staged")
                        {
                            <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Review" asp-route-batchId="@b.MDRImportBatchId">Review</pems-button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No MDR imports yet.</p> }
</div>
