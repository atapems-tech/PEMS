@model PEMS.Application.DTOs.MDRImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>@Localizer["File:"]</strong> @Model.FileName</div>
        <div class="col-md-3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-2"><strong>@Localizer["Total:"]</strong> @Model.RowsTotal</div>
        <div class="col-md-2"><strong>@Localizer["Duplicates:"]</strong> @Model.RowsDuplicate</div>
        <div class="col-md-2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></div>
    </div>

    @if (Model.HeaderWarnings.Any())
    {
        <pems-alert tone="warning" css="mt-3 mb-0 small">
            <strong><i class="bi bi-exclamation-triangle"></i> ستون‌های شناسایی‌نشده در فایل اکسل:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var w in Model.HeaderWarnings)
                {
                    <li>@w</li>
                }
            </ul>
        </pems-alert>
    }

    @if (Model.Status == "Staged")
    {
        <div class="d-flex gap-2 mt-3">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                <pems-button tone="primary" type="submit" onclick="return confirm('Commit the selected rows into the live Engineering Documents register?')">
                    <i class="bi bi-check-circle"></i> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" onclick="return confirm('Discard this entire import batch?')">
                    <i class="bi bi-trash"></i> Discard Batch
                </pems-button>
            </form>
        </div>
    }
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Include"]</th><th>#</th><th>@Localizer["Sheet"]</th><th>@Localizer["Document No"]</th><th>@Localizer["Title"]</th>
                    <th>@Localizer["Scope"]</th><th>@Localizer["Area"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Rev"]</th><th>@Localizer["Comment Status"]</th><th>Final Status</th><th>Remark</th><th>Frozen</th>
                    <th>@Localizer["Validation"]</th><th>@Localizer["Message"]</th><th>@Localizer["Duplicate"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.ValidationStatus == "Error" ? "table-danger" : r.ValidationStatus == "Warning" ? "table-warning" : "")">
                        <td>
                            @if (Model.Status == "Staged")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.MDRImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <button type="submit" class="btn btn-sm @(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" style="width:36px;">
                                        <i class="bi @(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </td>
                        <td>@r.RowNumber</td>
                        <td class="small text-muted">@r.SheetName</td>
                        <td>@r.DocumentNumber</td>
                        <td class="small">@r.Payload?.Title</td>
                        <td class="small text-muted">@r.Payload?.Scope</td>
                        <td>@r.Payload?.Area</td>
                        <td>@r.Payload?.DisciplineCodeRaw</td>
                        <td>@r.Payload?.Revisions.LastOrDefault()?.RevisionNo</td>
                        <td>@r.Payload?.Revisions.LastOrDefault()?.CommentStatus</td>
                        <td class="small text-muted">@r.Payload?.FinalStatusRaw</td>
                        <td class="small text-muted" style="max-width:220px;">@r.Payload?.Remark</td>
                        <td>@(r.Payload?.IsFrozen == true ? "❄" : "")</td>
                        <td>
                            @{
                                var vb = r.ValidationStatus switch { "Error" => "bg-danger", "Warning" => "bg-warning text-dark", _ => "bg-success" };
                            }
                            <pems-badge tone="none" css="@vb">@r.ValidationStatus</pems-badge>
                        </td>
                        <td class="small text-muted">@r.ValidationMessage</td>
                        <td>@(r.IsDuplicate ? "Update existing" : "New")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>