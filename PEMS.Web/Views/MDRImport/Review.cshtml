@model PEMS.Application.DTOs.MDRImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3"><strong>@Localizer["File:"]</strong> @Model.FileName</pems-col>
        <pems-col md="3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</pems-col>
        <pems-col md="2"><strong>@Localizer["Total:"]</strong> @Model.RowsTotal</pems-col>
        <pems-col md="2"><strong>@Localizer["Duplicates:"]</strong> @Model.RowsDuplicate</pems-col>
        <pems-col md="2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></pems-col>
    </pems-row>

    @if (Model.HeaderWarnings.Any())
    {
        <pems-alert tone="warning" css="mt-3 mb-0 small">
            <strong><pems-icon name="bi-exclamation-triangle" /> ستون‌های شناسایی‌نشده در فایل اکسل:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var w in Model.HeaderWarnings)
                {
                    <li>@w</li>
                }
            </ul>
        </pems-alert>
    }

    @if (Model.Status == "Staged")
    {
        <pems-flex gap="2" css="mt-3">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                <pems-button tone="primary" type="submit" data-pems-confirm="Commit the selected rows into the live Engineering Documents register?">
                    <pems-icon name="bi-check-circle" /> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" data-pems-confirm="Discard this entire import batch?">
                    <pems-icon name="bi-trash" /> Discard Batch
                </pems-button>
            </form>
        </pems-flex>
    }
</pems-content-card>

<pems-content-card>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["Include"]</pems-table-header><pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Sheet"]</pems-table-header><pems-table-header>@Localizer["Document No"]</pems-table-header><pems-table-header>@Localizer["Title"]</pems-table-header>
                    <pems-table-header>@Localizer["Scope"]</pems-table-header><pems-table-header>@Localizer["Area"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Rev"]</pems-table-header><pems-table-header>@Localizer["Comment Status"]</pems-table-header><pems-table-header>Final Status</pems-table-header><pems-table-header>Remark</pems-table-header><pems-table-header>Frozen</pems-table-header>
                    <pems-table-header>@Localizer["Validation"]</pems-table-header><pems-table-header>@Localizer["Message"]</pems-table-header><pems-table-header>@Localizer["Duplicate"]</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var r in Model.Rows)
                {
                    <pems-table-row class="@(r.ValidationStatus == "Error" ? "table-danger" : r.ValidationStatus == "Warning" ? "table-warning" : "")">
                        <pems-table-cell>
                            @if (Model.Status == "Staged")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.MDRImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.MDRImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <pems-button class="pems-w-36" tone="none" size="small" css="@(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" type="submit">
                                        <pems-icon css="@(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")" />
                                    </pems-button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </pems-table-cell>
                        <pems-table-cell>@r.RowNumber</pems-table-cell>
                        <pems-table-cell class="small text-muted">@r.SheetName</pems-table-cell>
                        <pems-table-cell>@r.DocumentNumber</pems-table-cell>
                        <pems-table-cell class="small">@r.Payload?.Title</pems-table-cell>
                        <pems-table-cell class="small text-muted">@r.Payload?.Scope</pems-table-cell>
                        <pems-table-cell>@r.Payload?.Area</pems-table-cell>
                        <pems-table-cell>@r.Payload?.DisciplineCodeRaw</pems-table-cell>
                        <pems-table-cell>@r.Payload?.Revisions.LastOrDefault()?.RevisionNo</pems-table-cell>
                        <pems-table-cell>@r.Payload?.Revisions.LastOrDefault()?.CommentStatus</pems-table-cell>
                        <pems-table-cell class="small text-muted">@r.Payload?.FinalStatusRaw</pems-table-cell>
                        <pems-table-cell class="small text-muted pems-s-27af8985">@r.Payload?.Remark</pems-table-cell>
                        <pems-table-cell>@(r.Payload?.IsFrozen == true ? "❄" : "")</pems-table-cell>
                        <pems-table-cell>
                            @{
                                var vb = r.ValidationStatus switch { "Error" => "danger", "Warning" => "warning", _ => "success" };
                            }
                            <pems-badge tone="@vb">@r.ValidationStatus</pems-badge>
                        </pems-table-cell>
                        <pems-table-cell class="small text-muted">@r.ValidationMessage</pems-table-cell>
                        <pems-table-cell>@(r.IsDuplicate ? "Update existing" : "New")</pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    </pems-table-scroll>
</pems-content-card>