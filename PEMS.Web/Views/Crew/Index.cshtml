@model List<PEMS.Domain.Entities.Crew>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-people-fill"></i> Crews</h5>
    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createCrewModal">
        <i class="bi bi-plus-lg"></i> Crew جدید
    </button>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="row g-3">
    @foreach (var crew in Model)
    {
        <div class="col-md-6">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-0">@crew.Code — @crew.Name</h6>
                        @if (crew.WorkOrder != null)
                        {
                            <span class="badge bg-info text-dark">
                                <i class="bi bi-clipboard-check"></i> اختصاصی <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@crew.WorkOrder.WorkOrderId" class="text-dark">@crew.WorkOrder.WorkOrderNumber</a>
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">مستقل / پایدار</span>
                        }
                    </div>
                </div>

                <hr class="my-2" />

                <h6 class="small fw-bold mb-2">اعضا (@crew.Members.Count(m => m.IsActive))</h6>
                <ul class="list-unstyled mb-2">
                    @foreach (var m in crew.Members.Where(m => m.IsActive))
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                            <span class="small">@m.Employee?.FirstName @m.Employee?.LastName</span>
                            <span class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">@m.Role?.Name</span>
                                <form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="crewMemberId" value="@m.CrewMemberId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="return confirm('این عضو از Crew خارج بشه؟')"><i class="bi bi-x"></i></button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>

                <form asp-action="AddMember" method="post" class="d-flex gap-1">
                    <input type="hidden" name="crewId" value="@crew.CrewId" />
                    <select name="employeeId" class="form-select form-select-sm" required>
                        <option value="">کارمند...</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                    <select name="roleId" class="form-select form-select-sm" required>
                        <option value="">نقش...</option>
                        @foreach (var r in (IEnumerable<dynamic>)ViewBag.MaintenanceRoles) { <option value="@r.MaintenanceRoleId">@r.Name</option> }
                    </select>
                    <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap"><i class="bi bi-plus-lg"></i></button>
                </form>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <div class="content-card"><p class="text-muted text-center py-4 mb-0">هنوز Crew ای ساخته نشده.</p></div>
}

<div class="modal fade" id="createCrewModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateCrew" method="post">
            <div class="modal-header"><h6 class="modal-title">Crew جدید</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">کد</label>
                    <input name="code" class="form-control form-control-sm" required placeholder="مثلاً PUMP-CREW-1" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">نام</label>
                    <input name="name" class="form-control form-control-sm" required placeholder="مثلاً Pump Maintenance Crew" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Work Order اختصاصی (اختیاری)</label>
                    <select name="workOrderId" class="form-select form-select-sm">
                        <option value="">-- مستقل / پایدار --</option>
                        @foreach (var w in (IEnumerable<dynamic>)ViewBag.WorkOrders) { <option value="@w.WorkOrderId">@w.WorkOrderNumber</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
            </div>
        </form>
    </div></div>
</div>
