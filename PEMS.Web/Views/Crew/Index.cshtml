@model List<PEMS.Domain.Entities.Crew>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#createCrewModal">
        <pems-icon name="bi-plus-lg" /> @Localizer["Crew جدید"]
    </pems-button>
</pems-flex>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-row gap="3">
    @foreach (var crew in Model)
    {
        <pems-col md="6">
            <pems-content-card css="h-100">
                <pems-flex justify="between" align="start">
                    <div>
                        <h6 class="mb-0">@crew.Code — @crew.Name</h6>
                        @if (crew.WorkOrder != null)
                        {
                            <pems-badge tone="info">
                                <pems-icon name="bi-clipboard-check" /> اختصاصی <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@crew.WorkOrder.WorkOrderId" class="text-dark">@crew.WorkOrder.WorkOrderNumber</a>
                            </pems-badge>
                        }
                        else
                        {
                            <pems-badge tone="neutral">@Localizer["مستقل / پایدار"]</pems-badge>
                        }
                    </div>
                </pems-flex>

                <hr class="my-2" />

                <h6 class="small fw-bold mb-2">اعضا (@crew.Members.Count(m => m.IsActive))</h6>
                <ul class="list-unstyled mb-2">
                    @foreach (var m in crew.Members.Where(m => m.IsActive))
                    {
                        <pems-flex as="li" justify="between" align="center" css="border-bottom py-1">
                            <span class="small">@m.Employee?.FirstName @m.Employee?.LastName</span>
                            <pems-flex as="span" align="center" gap="2">
                                <pems-badge tone="neutral">@m.Role?.Name</pems-badge>
                                <form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="crewMemberId" value="@m.CrewMemberId" />
                                    <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" data-pems-confirm="این عضو از Crew خارج بشه؟"><pems-icon name="bi-x" /></pems-button>
                                </form>
                            </pems-flex>
                        </pems-flex>
                    }
                </ul>

                <form asp-action="AddMember" method="post"><pems-flex gap="1">
                    <input type="hidden" name="crewId" value="@crew.CrewId" />
                    <pems-select scale="small" name="employeeId" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </pems-select>
                    <pems-select scale="small" name="roleId" required>
                        <option value="">@Localizer["نقش..."]</option>
                        @foreach (var r in (IEnumerable<dynamic>)ViewBag.MaintenanceRoles) { <option value="@r.MaintenanceRoleId">@r.Name</option> }
                    </pems-select>
                    <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><pems-icon name="bi-plus-lg" /></pems-button>
                </pems-flex></form>
            </pems-content-card>
        </pems-col>
    }
</pems-row>
@if (!Model.Any())
{
    <pems-content-card><p class="text-muted text-center py-4 mb-0">@Localizer["هنوز Crew ای ساخته نشده."]</p></pems-content-card>
}

<pems-modal id="createCrewModal" tabindex="-1">
        <form asp-action="CreateCrew" method="post">
            <pems-modal-header>@Localizer["Crew جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["کد"]</pems-label>
                    <pems-input scale="small" name="code" required placeholder="@Localizer["مثلاً PUMP-CREW-1"]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["نام"]</pems-label>
                    <pems-input scale="small" name="name" required placeholder="@Localizer["مثلاً Pump Maintenance Crew"]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Work Order اختصاصی (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="workOrderId">
                        <option value="">@Localizer["-- مستقل / پایدار --"]</option>
                        @foreach (var w in (IEnumerable<dynamic>)ViewBag.WorkOrders) { <option value="@w.WorkOrderId">@w.WorkOrderNumber</option> }
                    </pems-select>
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>
