@model List<PEMS.Domain.Entities.Crew>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#createCrewModal">
        <i class="bi bi-plus-lg"></i> @Localizer["Crew جدید"]
    </pems-button>
</div>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<div class="row g-3">
    @foreach (var crew in Model)
    {
        <div class="col-md-6">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-0">@crew.Code — @crew.Name</h6>
                        @if (crew.WorkOrder != null)
                        {
                            <pems-badge tone="info">
                                <i class="bi bi-clipboard-check"></i> اختصاصی <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@crew.WorkOrder.WorkOrderId" class="text-dark">@crew.WorkOrder.WorkOrderNumber</a>
                            </pems-badge>
                        }
                        else
                        {
                            <pems-badge tone="neutral">@Localizer["مستقل / پایدار"]</pems-badge>
                        }
                    </div>
                </div>

                <hr class="my-2" />

                <h6 class="small fw-bold mb-2">اعضا (@crew.Members.Count(m => m.IsActive))</h6>
                <ul class="list-unstyled mb-2">
                    @foreach (var m in crew.Members.Where(m => m.IsActive))
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                            <span class="small">@m.Employee?.FirstName @m.Employee?.LastName</span>
                            <span class="d-flex align-items-center gap-2">
                                <pems-badge tone="neutral">@m.Role?.Name</pems-badge>
                                <form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="crewMemberId" value="@m.CrewMemberId" />
                                    <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" onclick="return confirm('این عضو از Crew خارج بشه؟')"><i class="bi bi-x"></i></pems-button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>

                <form asp-action="AddMember" method="post" class="d-flex gap-1">
                    <input type="hidden" name="crewId" value="@crew.CrewId" />
                    <select name="employeeId" class="form-select form-select-sm" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                    <select name="roleId" class="form-select form-select-sm" required>
                        <option value="">@Localizer["نقش..."]</option>
                        @foreach (var r in (IEnumerable<dynamic>)ViewBag.MaintenanceRoles) { <option value="@r.MaintenanceRoleId">@r.Name</option> }
                    </select>
                    <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><i class="bi bi-plus-lg"></i></pems-button>
                </form>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <div class="content-card"><p class="text-muted text-center py-4 mb-0">@Localizer["هنوز Crew ای ساخته نشده."]</p></div>
}

<div class="modal fade" id="createCrewModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateCrew" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["Crew جدید"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">@Localizer["کد"]</label>
                    <input name="code" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً PUMP-CREW-1"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["نام"]</label>
                    <input name="name" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً Pump Maintenance Crew"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Work Order اختصاصی (اختیاری)"]</label>
                    <select name="workOrderId" class="form-select form-select-sm">
                        <option value="">@Localizer["-- مستقل / پایدار --"]</option>
                        @foreach (var w in (IEnumerable<dynamic>)ViewBag.WorkOrders) { <option value="@w.WorkOrderId">@w.WorkOrderNumber</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </div>
        </form>
    </div></div>
</div>
