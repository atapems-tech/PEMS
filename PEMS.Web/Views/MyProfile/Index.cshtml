@model PEMS.Domain.Entities.Employee?
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (Model == null)
{
    <div class="content-card">
        <p class="text-muted">کارمندی برای این حساب کاربری پیدا نشد.</p>
    </div>
}
else
{
    <pems-row gap="3">
        <pems-col md="4">
            <div class="content-card text-center">
                <h6 class="mb-3"><pems-icon name="bi-person-circle" /> @Localizer["عکس پروفایل"]</h6>

                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="Profile Photo" class="rounded-circle mb-3 pems-photo-150" />
                }
                else
                {
                    <div class="rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center bg-light pems-s-9bcde244">
                        <pems-icon name="bi-person" css="text-muted pems-s-2fe17263" />
                    </div>
                }

                <h6 class="mb-0">@Model.FirstName @Model.LastName</h6>
                <p class="text-muted small">@Model.Position &middot; @Model.PersonnelCode</p>

                <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="mt-3">
                    <pems-input scale="small" css="mb-2" type="file" name="file" accept=".jpg,.jpeg,.png,.webp" required />
                    <pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-upload" /> @Localizer["ذخیره عکس"]</pems-button>
                </form>
            </div>
        </pems-col>

        <pems-col md="8">
            <div class="content-card">
                <h6 class="mb-3"><pems-icon name="bi-pen" /> @Localizer["امضای دیجیتال (ترسیمی)"]</h6>
                <p class="text-muted small">
                    با موس یا انگشت روی کادر زیر امضا کن. این امضا در جاهایی از سیستم که نیاز به
                    نمایش امضای تاییدکننده دارند (مثلاً تاییدهای گردش‌کار) استفاده می‌شه.
                </p>

                @if (!string.IsNullOrEmpty(Model.SignaturePath))
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-1">امضای فعلی:</div>
                        <img class="pems-signature-view" src="@Model.SignaturePath" alt="Signature" />
                    </div>
                }

                <div class="pems-s-39cdd266">
                    <canvas class="pems-signature-pad" id="signaturePad" width="600" height="200"></canvas>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <pems-button tone="neutral" size="small" outline="true" type="button" id="clearSignatureBtn"><pems-icon name="bi-eraser" /> @Localizer["پاک کردن"]</pems-button>
                    <pems-button tone="primary" size="small" type="button" id="saveSignatureBtn"><pems-icon name="bi-check-lg" /> @Localizer["ذخیره امضا"]</pems-button>
                </div>

                <form asp-action="SaveSignature" method="post" id="signatureForm" class="d-none">
                    <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" />
                </form>
            </div>
        </pems-col>
    </pems-row>

    <script src="~/js/views/myprofile-index.js" asp-append-version="true"></script>
}
