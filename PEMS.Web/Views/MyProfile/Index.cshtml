@model PEMS.Domain.Entities.Employee?
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (Model == null)
{
    <div class="content-card">
        <p class="text-muted">کارمندی برای این حساب کاربری پیدا نشد.</p>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="content-card text-center">
                <h6 class="mb-3"><i class="bi bi-person-circle"></i> @Localizer["عکس پروفایل"]</h6>

                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="Profile Photo" class="rounded-circle mb-3" style="width:150px;height:150px;object-fit:cover;border:2px solid #dee2e6;" />
                }
                else
                {
                    <div class="rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center bg-light" style="width:150px;height:150px;border:2px dashed #ced4da;">
                        <i class="bi bi-person text-muted" style="font-size:3rem;"></i>
                    </div>
                }

                <h6 class="mb-0">@Model.FirstName @Model.LastName</h6>
                <p class="text-muted small">@Model.Position &middot; @Model.PersonnelCode</p>

                <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="mt-3">
                    <input type="file" name="file" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png,.webp" required />
                    <button type="submit" class="btn btn-pems-solid btn-sm w-100"><i class="bi bi-upload"></i> @Localizer["ذخیره عکس"]</button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="content-card">
                <h6 class="mb-3"><i class="bi bi-pen"></i> @Localizer["امضای دیجیتال (ترسیمی)"]</h6>
                <p class="text-muted small">
                    با موس یا انگشت روی کادر زیر امضا کن. این امضا در جاهایی از سیستم که نیاز به
                    نمایش امضای تاییدکننده دارند (مثلاً تاییدهای گردش‌کار) استفاده می‌شه.
                </p>

                @if (!string.IsNullOrEmpty(Model.SignaturePath))
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-1">امضای فعلی:</div>
                        <img src="@Model.SignaturePath" alt="Signature" style="max-height:100px; border:1px solid #dee2e6; background:#fff; padding:4px; border-radius:4px;" />
                    </div>
                }

                <div style="border:2px dashed #ced4da; border-radius:8px; background:#fff; touch-action:none;">
                    <canvas id="signaturePad" width="600" height="200" style="width:100%; height:200px; cursor:crosshair;"></canvas>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="button" id="clearSignatureBtn" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eraser"></i> @Localizer["پاک کردن"]</button>
                    <button type="button" id="saveSignatureBtn" class="btn btn-pems-solid btn-sm"><i class="bi bi-check-lg"></i> @Localizer["ذخیره امضا"]</button>
                </div>

                <form asp-action="SaveSignature" method="post" id="signatureForm" class="d-none">
                    <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" />
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var canvas = document.getElementById('signaturePad');
            var ctx = canvas.getContext('2d');

            // چون CSS عرض کانواس رو به‌صورت درصدی تنظیم کرده، باید رزولوشن واقعی پیکسلی رو
            // با اندازه‌ی نمایشی هماهنگ کنیم تا امضا واضح و بدون کش‌ورفتگی ذخیره بشه
            function resizeCanvas() {
                var rect = canvas.getBoundingClientRect();
                canvas.width = rect.width;
                canvas.height = rect.height;
                ctx.fillStyle = '#fff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.lineWidth = 2;
                ctx.lineCap = 'round';
                ctx.strokeStyle = '#1a1a1a';
            }
            resizeCanvas();

            var drawing = false;
            var lastX = 0, lastY = 0;

            function getPos(e) {
                var rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length > 0) {
                    return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
                }
                return { x: e.clientX - rect.left, y: e.clientY - rect.top };
            }

            function start(e) {
                drawing = true;
                var pos = getPos(e);
                lastX = pos.x; lastY = pos.y;
                e.preventDefault();
            }

            function move(e) {
                if (!drawing) return;
                var pos = getPos(e);
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                lastX = pos.x; lastY = pos.y;
                e.preventDefault();
            }

            function end() { drawing = false; }

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            window.addEventListener('mouseup', end);

            canvas.addEventListener('touchstart', start);
            canvas.addEventListener('touchmove', move);
            canvas.addEventListener('touchend', end);

            document.getElementById('clearSignatureBtn').addEventListener('click', function () {
                ctx.fillStyle = '#fff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
            });

            document.getElementById('saveSignatureBtn').addEventListener('click', function () {
                document.getElementById('signatureDataUrl').value = canvas.toDataURL('image/png');
                document.getElementById('signatureForm').submit();
            });
        })();
    </script>
}
