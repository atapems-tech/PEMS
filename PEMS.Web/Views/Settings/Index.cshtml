@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-3"><pems-icon name="bi-person-gear" /> My Preferences</pems-heading>
    <pems-row gap="3">
        <pems-col md="4">
            <div class="border rounded p-3 h-100">
                <pems-icon name="bi-grid-1x2" css="fs-4 text-muted" />
                <pems-heading level="6" class="mt-2 mb-1">Dashboard Widgets</pems-heading>
                <pems-text class="text-muted small">Choose which widgets appear on your home dashboard.</pems-text>
                <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="DashboardSettings" asp-action="Index">@Localizer["Customize"]</pems-button>
            </div>
        </pems-col>
        <pems-col md="4">
            <div class="border rounded p-3 h-100">
                <pems-icon name="bi-translate" css="fs-4 text-muted" />
                <pems-heading level="6" class="mt-2 mb-1">Language</pems-heading>
                <pems-text class="text-muted small">Switch the interface between English and Persian (فارسی).</pems-text>
                <pems-flex gap="2">
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Culture" asp-action="SetCulture" asp-route-culture="en" asp-route-returnUrl="/Settings">@Localizer["English"]</pems-button>
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Culture" asp-action="SetCulture" asp-route-culture="fa" asp-route-returnUrl="/Settings">@Localizer["فارسی"]</pems-button>
                </pems-flex>
            </div>
        </pems-col>
        <pems-col md="4">
            <div class="border rounded p-3 h-100">
                <pems-icon name="bi-moon-stars" css="fs-4 text-muted" />
                <pems-heading level="6" class="mt-2 mb-1">Theme</pems-heading>
                <pems-text class="text-muted small">Toggle Dark / Light mode using the moon icon in the top bar.</pems-text>
                <pems-badge tone="neutral">Top bar shortcut</pems-badge>
            </div>
        </pems-col>
    </pems-row>
</pems-content-card>

@if (ViewBag.CanManageUsers)
{
    <pems-content-card>
        <pems-heading level="6" class="mb-3"><pems-icon name="bi-building-gear" /> System Administration</pems-heading>
        <pems-row gap="3">
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-people" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">@Localizer["Users"]</pems-heading>
                    <pems-text class="text-muted small">Create logins and assign roles.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-area="Admin" asp-controller="Users" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-person-badge" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">@Localizer["Employees"]</pems-heading>
                    <pems-text class="text-muted small">Manage employee records, department &amp; discipline.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Employee" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-building" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">@Localizer["Departments"]</pems-heading>
                    <pems-text class="text-muted small">Organizational departments.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Department" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-diagram-3" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">@Localizer["Disciplines"]</pems-heading>
                    <pems-text class="text-muted small">Engineering discipline list &amp; import aliases.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Discipline" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-sliders" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">Permission Matrix</pems-heading>
                    <pems-text class="text-muted small">What each role can create, edit, and approve.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-area="Admin" asp-controller="PermissionMatrix" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-shield-check" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">@Localizer["Roles"]</pems-heading>
                    <pems-text class="text-muted small">System roles list.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" href="/p/roles">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-signpost-split" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">Routing Rules</pems-heading>
                    <pems-text class="text-muted small">AI Intake auto-routing configuration.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-area="Admin" asp-controller="RoutingRules" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-clock-history" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">Audit Log</pems-heading>
                    <pems-text class="text-muted small">Full history of who changed what.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-hdd-network" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">Storage Providers</pems-heading>
                    <pems-text class="text-muted small">Local, Network Share, FTP &amp; SFTP storage destinations.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" href="/p/storage-providers">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
            <pems-col md="3" sm="6">
                <div class="border rounded p-3 h-100">
                    <pems-icon name="bi-signpost-2" css="fs-4 text-muted" />
                    <pems-heading level="6" class="mt-2 mb-1">Storage Routing</pems-heading>
                    <pems-text class="text-muted small">Which module/document type saves to which provider.</pems-text>
                    <pems-button tone="primary" size="small" outline="true" as="a" href="/p/storage-routing">@Localizer["Open"]</pems-button>
                </div>
            </pems-col>
        </pems-row>
    </pems-content-card>
}
