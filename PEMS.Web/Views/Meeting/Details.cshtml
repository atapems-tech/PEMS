@model PEMS.Application.DTOs.MeetingDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var m = Model.Meeting;
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
}


<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start">
        <div>
            <h5 class="mb-1">@m.Title</h5>
            <pems-badge tone="@(m.Status == "Completed" ? "success" : m.Status == "Cancelled" ? "dark" : "warning")">@m.Status</pems-badge>
            <span class="text-muted small ms-2">@m.MeetingDate.ToString("yyyy-MM-dd HH:mm") &middot; @m.Location</span>
        </div>
    </pems-flex>
    <pems-row gap="3" css="mt-2">
        <pems-col md="4"><strong>Organizer:</strong> @m.OrganizerName</pems-col>
        <pems-col md="4"><strong>@Localizer["Project:"]</strong> @m.ProjectName</pems-col>
    </pems-row>
    @if (!string.IsNullOrEmpty(Model.Agenda))
    {
        <div class="mt-2"><strong>Agenda:</strong><p class="mb-0">@Model.Agenda</p></div>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">Minutes / Notes</h6>
    <pems-form asp-action="UpdateMinutes" method="post">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <pems-textarea name="minutesNotes" rows="5">@Model.MinutesNotes</pems-textarea>
        <pems-flex gap="2" css="mt-2">
            <pems-select class="pems-w-160" name="status">
                @foreach (var s in new[] { "Scheduled", "Completed", "Cancelled" })
                { <option value="@s" selected="@(s == m.Status)">@s</option> }
            </pems-select>
            <pems-button tone="primary" size="small" type="submit">Save Minutes</pems-button>
        </pems-flex>
    </pems-form>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Attendees"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>Required</pems-table-header><pems-table-header>Attended</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var a in Model.Attendees)
            {
                <pems-table-row>
                    <pems-table-cell>@a.DisplayName</pems-table-cell>
                    <pems-table-cell>@(a.IsRequired ? "Yes" : "Optional")</pems-table-cell>
                    <pems-table-cell>
                        <pems-form asp-action="MarkAttended" method="post">
                            <input type="hidden" name="meetingAttendeeId" value="@a.MeetingAttendeeId" />
                            <input type="hidden" name="meetingId" value="@m.MeetingId" />
                            <input type="hidden" name="attended" value="@(!a.Attended)" />
                            <pems-button tone="none" size="small" css="@(a.Attended ? "btn-success" : "btn-outline-secondary")" type="submit">
                                <pems-icon css="@(a.Attended ? "bi-check-lg" : "bi-x")" />
                            </pems-button>
                        </pems-form>
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
    @if (!Model.Attendees.Any()) { <p class="text-muted small">No attendees added yet.</p> }

    <pems-form asp-action="AddAttendee" method="post"><pems-row gap="2" css="mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <pems-col md="5">
            <pems-select scale="small" name="employeeId">
                <option value="">@Localizer["-- Employee --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="4"><pems-input scale="small" name="externalName" placeholder="or external name" /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Action Items"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model.ActionItems, c_ => c_.Add(((Localizer["Title"])?.ToString() ?? ""), t => (object?)(t.Title)).Add(((Localizer["Assigned To"])?.ToString() ?? ""), t => (object?)(t.AssignedToEmployeeName), css: "small").Add(((Localizer["Due"])?.ToString() ?? ""), t => (object?)(t.DueDate?.ToString("yyyy-MM-dd")), css: "small").Add(((Localizer["Status"])?.ToString() ?? ""), t => (object?)(t.Status), kind: DataCellKind.Badge, tone: t => "neutral")))" />
    </pems-table-scroll>
    @if (!Model.ActionItems.Any()) { <p class="text-muted small">No action items yet.</p> }

    <pems-form asp-action="AddActionItem" method="post"><pems-row gap="2" css="mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <pems-col md="5"><pems-input scale="small" name="title" placeholder="Action item" required /></pems-col>
        <pems-col md="4">
            <pems-select scale="small" name="assignedToEmployeeId">
                <option value="">@Localizer["-- Assign to --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="dueDate" scale="small" /></pems-col>
        <pems-col md="1"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /></pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>
