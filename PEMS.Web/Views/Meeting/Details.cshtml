@model PEMS.Application.DTOs.MeetingDetailDto
@{
    var m = Model.Meeting;
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-1">@m.Title</h5>
            <span class="badge @(m.Status == "Completed" ? "bg-success" : m.Status == "Cancelled" ? "bg-dark" : "bg-warning text-dark")">@m.Status</span>
            <span class="text-muted small ms-2">@m.MeetingDate.ToString("yyyy-MM-dd HH:mm") &middot; @m.Location</span>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-4"><strong>Organizer:</strong> @m.OrganizerName</div>
        <div class="col-md-4"><strong>Project:</strong> @m.ProjectName</div>
    </div>
    @if (!string.IsNullOrEmpty(Model.Agenda))
    {
        <div class="mt-2"><strong>Agenda:</strong><p class="mb-0">@Model.Agenda</p></div>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Minutes / Notes</h6>
    <form asp-action="UpdateMinutes" method="post">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <textarea name="minutesNotes" class="form-control" rows="5">@Model.MinutesNotes</textarea>
        <div class="d-flex gap-2 mt-2">
            <select name="status" class="form-select" style="width:160px;">
                @foreach (var s in new[] { "Scheduled", "Completed", "Cancelled" })
                { <option value="@s" selected="@(s == m.Status)">@s</option> }
            </select>
            <button type="submit" class="btn btn-pems-solid btn-sm">Save Minutes</button>
        </div>
    </form>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Attendees</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Name</th><th>Required</th><th>Attended</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Attendees)
            {
                <tr>
                    <td>@a.DisplayName</td>
                    <td>@(a.IsRequired ? "Yes" : "Optional")</td>
                    <td>
                        <form asp-action="MarkAttended" method="post">
                            <input type="hidden" name="meetingAttendeeId" value="@a.MeetingAttendeeId" />
                            <input type="hidden" name="meetingId" value="@m.MeetingId" />
                            <input type="hidden" name="attended" value="@(!a.Attended)" />
                            <button type="submit" class="btn btn-sm @(a.Attended ? "btn-success" : "btn-outline-secondary")">
                                <i class="bi @(a.Attended ? "bi-check-lg" : "bi-x")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Attendees.Any()) { <p class="text-muted small">No attendees added yet.</p> }

    <form asp-action="AddAttendee" method="post" class="row g-2 mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <div class="col-md-5">
            <select name="employeeId" class="form-select form-select-sm">
                <option value="">-- Employee --</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </select>
        </div>
        <div class="col-md-4"><input name="externalName" class="form-control form-control-sm" placeholder="or external name" /></div>
        <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> Add</button></div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">Action Items</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Title</th><th>Assigned To</th><th>Due</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var t in Model.ActionItems)
            {
                <tr>
                    <td>@t.Title</td>
                    <td class="small">@t.AssignedToEmployeeName</td>
                    <td class="small">@(t.DueDate?.ToString("yyyy-MM-dd"))</td>
                    <td><span class="badge bg-secondary">@t.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.ActionItems.Any()) { <p class="text-muted small">No action items yet.</p> }

    <form asp-action="AddActionItem" method="post" class="row g-2 mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <div class="col-md-5"><input name="title" class="form-control form-control-sm" placeholder="Action item" required /></div>
        <div class="col-md-4">
            <select name="assignedToEmployeeId" class="form-select form-select-sm">
                <option value="">-- Assign to --</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
        <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i></button></div>
    </form>
</div>
