@model PEMS.Application.DTOs.MeetingDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var m = Model.Meeting;
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-1">@m.Title</h5>
            <pems-badge tone="@(m.Status == "Completed" ? "success" : m.Status == "Cancelled" ? "dark" : "warning")">@m.Status</pems-badge>
            <span class="text-muted small ms-2">@m.MeetingDate.ToString("yyyy-MM-dd HH:mm") &middot; @m.Location</span>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-4"><strong>Organizer:</strong> @m.OrganizerName</div>
        <div class="col-md-4"><strong>@Localizer["Project:"]</strong> @m.ProjectName</div>
    </div>
    @if (!string.IsNullOrEmpty(Model.Agenda))
    {
        <div class="mt-2"><strong>Agenda:</strong><p class="mb-0">@Model.Agenda</p></div>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Minutes / Notes</h6>
    <form asp-action="UpdateMinutes" method="post">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <pems-textarea name="minutesNotes" rows="5">@Model.MinutesNotes</pems-textarea>
        <div class="d-flex gap-2 mt-2">
            <pems-select name="status" style="width:160px;">
                @foreach (var s in new[] { "Scheduled", "Completed", "Cancelled" })
                { <option value="@s" selected="@(s == m.Status)">@s</option> }
            </pems-select>
            <pems-button tone="primary" size="small" type="submit">Save Minutes</pems-button>
        </div>
    </form>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">@Localizer["Attendees"]</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead><tr><th>@Localizer["Name"]</th><th>Required</th><th>Attended</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Attendees)
            {
                <tr>
                    <td>@a.DisplayName</td>
                    <td>@(a.IsRequired ? "Yes" : "Optional")</td>
                    <td>
                        <form asp-action="MarkAttended" method="post">
                            <input type="hidden" name="meetingAttendeeId" value="@a.MeetingAttendeeId" />
                            <input type="hidden" name="meetingId" value="@m.MeetingId" />
                            <input type="hidden" name="attended" value="@(!a.Attended)" />
                            <pems-button tone="none" size="small" css="@(a.Attended ? "btn-success" : "btn-outline-secondary")" type="submit">
                                <pems-icon css="@(a.Attended ? "bi-check-lg" : "bi-x")" />
                            </pems-button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.Attendees.Any()) { <p class="text-muted small">No attendees added yet.</p> }

    <form asp-action="AddAttendee" method="post" class="row g-2 mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <div class="col-md-5">
            <pems-select scale="small" name="employeeId">
                <option value="">@Localizer["-- Employee --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </pems-select>
        </div>
        <div class="col-md-4"><pems-input scale="small" name="externalName" placeholder="or external name" /></div>
        <div class="col-md-3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Action Items"]</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead><tr><th>@Localizer["Title"]</th><th>@Localizer["Assigned To"]</th><th>@Localizer["Due"]</th><th>@Localizer["Status"]</th></tr></thead>
        <tbody>
            @foreach (var t in Model.ActionItems)
            {
                <tr>
                    <td>@t.Title</td>
                    <td class="small">@t.AssignedToEmployeeName</td>
                    <td class="small">@(t.DueDate?.ToString("yyyy-MM-dd"))</td>
                    <td><pems-badge tone="neutral">@t.Status</pems-badge></td>
                </tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.ActionItems.Any()) { <p class="text-muted small">No action items yet.</p> }

    <form asp-action="AddActionItem" method="post" class="row g-2 mt-2">
        <input type="hidden" name="meetingId" value="@m.MeetingId" />
        <div class="col-md-5"><pems-input scale="small" name="title" placeholder="Action item" required /></div>
        <div class="col-md-4">
            <pems-select scale="small" name="assignedToEmployeeId">
                <option value="">@Localizer["-- Assign to --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </pems-select>
        </div>
        <div class="col-md-2"><pems-date name="dueDate" scale="small" /></div>
        <div class="col-md-1"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /></pems-button></div>
    </form>
</div>
