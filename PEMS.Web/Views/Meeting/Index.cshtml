@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MeetingDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; "Schedule Meeting" opens the page's own modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Meetings"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Meeting" />
                <pems-list-new modal="createMeetingModal" text="@Localizer["Schedule Meeting"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Meeting" empty="@(!Model.Items.Any())" empty-text="No meetings scheduled yet."
                             filtered="@false" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-200" data-col-key="title" data-resizable="true" data-min-width="120" data-max-width="320">@Localizer["Title"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="date" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Date"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="location" data-resizable="true" data-min-width="80" data-max-width="200">@Localizer["Location"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="organizer" data-resizable="true" data-min-width="80" data-max-width="200">@Localizer["Organizer"]</pems-table-header>
                        <pems-table-header class="pems-w-140" data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Project"]</pems-table-header>
                        <pems-table-header class="pems-w-90" data-col-key="attendees" data-resizable="true" data-min-width="70" data-max-width="120">@Localizer["Attendees"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="actionItems" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Action Items"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Status"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var m in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@m.MeetingId" class="lp-subject">@m.Title</a></pems-table-cell>
                            <pems-table-cell class="small">@m.MeetingDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                            <pems-table-cell class="small">@m.Location</pems-table-cell>
                            <pems-table-cell class="small">@m.OrganizerName</pems-table-cell>
                            <pems-table-cell class="small">@m.ProjectName</pems-table-cell>
                            <pems-table-cell><pems-badge tone="neutral">@m.AttendeeCount</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="info">@m.ActionItemCount</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(m.Status == "Completed" ? "success" : m.Status == "Cancelled" ? "dark" : "warning")">@m.Status</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@m.MeetingId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Meeting",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }

<pems-modal size="large" id="createMeetingModal" tabindex="-1">
            <pems-form asp-controller="Meeting" asp-action="Create" method="post">
                <pems-modal-header>@Localizer["Schedule Meeting"]</pems-modal-header>
                <pems-modal-body>
                    <pems-row gap="3">
                        <pems-col md="6"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Date & Time"]</pems-label><pems-date time="true" name="meetingDate" required /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Location"]</pems-label><pems-input name="location" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Organizer"]</pems-label><pems-input name="organizerName" /></pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Related Project"]</pems-label>
                            <pems-select name="projectId">
                                <option value="">@Localizer["-- None --"]</option>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col span="12"><pems-label>@Localizer["Agenda"]</pems-label><pems-textarea name="agenda" rows="4"></pems-textarea></pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>
