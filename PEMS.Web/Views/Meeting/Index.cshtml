@model List<PEMS.Application.DTOs.MeetingDto>


<div class="content-card">
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createMeetingModal">
            <i class="bi bi-plus-lg"></i> Schedule Meeting
        </button>
    </div>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Title</th><th>Date</th><th>Location</th><th>Organizer</th><th>Project</th><th>Attendees</th><th>Action Items</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Title</td>
                    <td class="small">@m.MeetingDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@m.Location</td>
                    <td class="small">@m.OrganizerName</td>
                    <td class="small">@m.ProjectName</td>
                    <td><span class="badge bg-secondary">@m.AttendeeCount</span></td>
                    <td><span class="badge bg-info text-dark">@m.ActionItemCount</span></td>
                    <td><span class="badge @(m.Status == "Completed" ? "bg-success" : m.Status == "Cancelled" ? "bg-dark" : "bg-warning text-dark")">@m.Status</span></td>
                    <td><a asp-action="Details" asp-route-id="@m.MeetingId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No meetings scheduled yet.</p> }
</div>

<div class="modal fade" id="createMeetingModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Meeting" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">Schedule Meeting</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Title</label><input name="title" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Date &amp; Time</label><input name="meetingDate" type="datetime-local" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Location</label><input name="location" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Organizer</label><input name="organizerName" class="form-control" /></div>
                        <div class="col-md-6">
                            <label class="form-label">Related Project</label>
                            <select name="projectId" class="form-select">
                                <option value="">-- none --</option>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-12"><label class="form-label">Agenda</label><textarea name="agenda" class="form-control" rows="4"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
