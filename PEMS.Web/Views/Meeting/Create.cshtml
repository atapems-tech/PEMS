@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">@Localizer["Title"]</label><pems-input name="title" required /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Date & Time"]</label><input name="meetingDate" type="datetime-local" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Location"]</label><pems-input name="location" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Organizer"]</label><pems-input name="organizerName" /></div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Related Project"]</label>
                <pems-select name="projectId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-12"><label class="form-label">@Localizer["Agenda"]</label><pems-textarea name="agenda" rows="4"></pems-textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
