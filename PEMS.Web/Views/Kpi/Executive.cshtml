@model PEMS.Web.Models.ExecutiveKpiPageViewModel
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PEMS.Application.Common
@using PEMS.Application.DTOs
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Dashboard;
    var inv = CultureInfo.InvariantCulture;

    string Number(decimal v, int decimals) => v.ToString("N" + decimals, inv);

    string UnitSuffix(string unit) => unit switch { "%" => "%", "h" => " h", "d" => " d", _ => "" };

    string Format(KpiTileDto t) => t.Value is null ? "—" : Number(t.Value.Value, t.Decimals) + UnitSuffix(t.Unit);

    string TargetText(KpiTileDto t) => t.Target is null ? "" :
        (t.Direction == KpiDirections.LowerIsBetter ? "≤ " : "≥ ") + Number(t.Target.Value, t.Decimals) + UnitSuffix(t.Unit);

    (string Css, string Icon) StatusLook(string status) => status switch
    {
        KpiStatuses.Met => ("met", "bi-check-circle"),
        KpiStatuses.Near => ("near", "bi-exclamation-circle"),
        KpiStatuses.Missed => ("missed", "bi-x-circle"),
        KpiStatuses.NoTarget => ("notarget", "bi-dash-circle"),
        _ => ("nodata", "bi-question-circle")
    };

    var withTarget = d.Tiles.Where(t => t.Status is KpiStatuses.Met or KpiStatuses.Near or KpiStatuses.Missed).ToList();
    var message = TempData["KpiMessage"] as string;
    var error = TempData["KpiError"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-kpi-dashboard.css" asp-append-version="true" />
}

<div class="pems-kpi-page">
    <pems-flex justify="between" align="center" wrap="true" gap="2" css="mb-2">
        <h5 class="mb-0"><pems-icon name="bi-bar-chart-line" /> @Localizer["Kpi_Exec_Title"]</h5>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-speedometer2" /> @Localizer["Kpi_Exec_ClassicLink"]</pems-button>
    </pems-flex>
    <p class="text-muted small mb-3">@Localizer["Kpi_Exec_Intro"]</p>

    @if (!string.IsNullOrEmpty(message)) { <pems-alert tone="success" css="py-2 small">@Localizer[message]</pems-alert> }
    @if (!string.IsNullOrEmpty(error)) { <pems-alert tone="danger" css="py-2 small">@Localizer[error]</pems-alert> }

    <pems-form class="mb-3" method="get"><pems-flex gap="2" align="end" wrap="true">
        <div>
            <pems-label css="small mb-0" for="kpiFrom">@Localizer["From"]</pems-label>
            <pems-date id="kpiFrom" name="fromDate" scale="small" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <pems-label css="small mb-0" for="kpiTo">@Localizer["To"]</pems-label>
            <pems-date id="kpiTo" name="toDate" scale="small" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <pems-button tone="primary" size="small" type="submit">@Localizer["Filter"]</pems-button>
        <span class="small text-muted ms-auto">@Localizer["Kpi_Exec_Generated"]: @d.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</span>
    </pems-flex></pems-form>

    @* خلاصه‌ی وضعیت نسبت به هدف: فقط شمارش شاخص‌هایی که هدف و مقدار دارند؛ «امتیاز کلی سلامت» جعلی ساخته نمی‌شود *@
    <div class="pems-kpi-overview" aria-label="@Localizer["Kpi_Exec_Overview"]">
        <span class="pems-kpi-overview-title">@Localizer["Kpi_Exec_Overview"]</span>
        <span class="pems-kpi-chip pems-kpi-status-met"><pems-icon name="bi-check-circle" /> @Localizer["Kpi_Status_Met"]: @withTarget.Count(t => t.Status == KpiStatuses.Met)</span>
        <span class="pems-kpi-chip pems-kpi-status-near"><pems-icon name="bi-exclamation-circle" /> @Localizer["Kpi_Status_Near"]: @withTarget.Count(t => t.Status == KpiStatuses.Near)</span>
        <span class="pems-kpi-chip pems-kpi-status-missed"><pems-icon name="bi-x-circle" /> @Localizer["Kpi_Status_Missed"]: @withTarget.Count(t => t.Status == KpiStatuses.Missed)</span>
        <span class="pems-kpi-chip pems-kpi-status-nodata"><pems-icon name="bi-question-circle" /> @Localizer["Kpi_Status_NoData"]: @d.Tiles.Count(t => t.Status == KpiStatuses.NoData)</span>
    </div>

    @foreach (var sec in KpiSections.Ordered)
    {
        var tiles = d.Tiles.Where(t => t.Section == sec).ToList();
        if (tiles.Count == 0) { continue; }
        <section class="pems-kpi-section" id="kpi-@sec.ToLowerInvariant()">
            <h6 class="pems-kpi-section-title">@Localizer["Kpi_Section_" + sec]</h6>
            <div class="pems-kpi-grid">
                @foreach (var t in tiles)
                {
                    var look = StatusLook(t.Status);
                    <div class="pems-kpi-tile pems-kpi-status-@look.Css" data-kpi="@t.Key" data-status="@t.Status">
                        <div class="pems-kpi-name">@Localizer["Kpi_Name_" + t.Key]</div>
                        <div class="pems-kpi-value">@Format(t)</div>
                        <div class="pems-kpi-meta">
                            <span class="pems-kpi-chip pems-kpi-status-@look.Css"><pems-icon css="@look.Icon" /> @Localizer["Kpi_Status_" + t.Status]</span>
                            @if (t.Target is not null) { <span class="pems-kpi-target" title="@Localizer["Kpi_Exec_Target"]">@Localizer["Kpi_Exec_Target"] @TargetText(t)</span> }
                        </div>
                        @if (t.Status == KpiStatuses.NoData) { <div class="pems-kpi-detail">@Localizer["Kpi_Exec_NoDataHint"]</div> }
                        else if (!string.IsNullOrEmpty(t.Detail)) { <div class="pems-kpi-detail">@t.Detail</div> }
                    </div>
                }
            </div>

            @if (sec == KpiSections.Equipment && d.EquipmentByStatus.Count > 0)
            {
                <pems-data-table data="@(DataRows.Of(d.EquipmentByStatus, c_ => c_.Add(((Localizer["Kpi_Exec_Status"])?.ToString() ?? ""), s => (object?)(s.Name)).Add(((Localizer["Kpi_Exec_Count"])?.ToString() ?? ""), s => (object?)(s.Count.ToString("N0", inv)), css: "text-end", headerCss: "text-end")))" enterprise="false" dense="true" css="table-enterprise pems-kpi-table" />
            }

            @if (sec == KpiSections.Cost && d.TopEquipmentByCost.Count > 0)
            {
                <pems-data-table data="@(DataRows.Of(d.TopEquipmentByCost, c_ => c_.Add(((Localizer["Kpi_Exec_TopCost"])?.ToString() ?? ""), e => (object?)(e.TagNumber)).Add(((Localizer["Kpi_Name_cost_total"])?.ToString() ?? ""), e => (object?)(e.Cost.ToString("N0", inv)), css: "text-end", headerCss: "text-end")))" enterprise="false" dense="true" css="table-enterprise pems-kpi-table" />
            }
        </section>
    }

    @* بخش‌هایی از سند KPI که در PEMS داده‌ی منبع ندارند؛ عمداً بدون عدد *@
    <section class="pems-kpi-section pems-kpi-nottracked" id="kpi-nottracked">
        <h6 class="pems-kpi-section-title"><pems-icon name="bi-hourglass-split" /> @Localizer["Kpi_Exec_NotTracked"]</h6>
        <p class="small text-muted">@Localizer["Kpi_Exec_NotTrackedHint"]</p>
        <ul class="pems-kpi-nt-list">
            @foreach (var key in KpiCatalog.NotTracked)
            {
                <li><strong>@Localizer["Kpi_NT_" + key]</strong> <span class="text-muted">- @Localizer["Kpi_NTD_" + key]</span></li>
            }
        </ul>
    </section>

    @if (Model.CanEditTargets)
    {
        <details class="pems-kpi-section pems-kpi-targets" id="kpi-targets">
            <summary class="pems-kpi-section-title">@Localizer["Kpi_Exec_EditTargets"]</summary>
            <p class="small text-muted mt-2">@Localizer["Kpi_Exec_EditTargetsHint"]</p>
            <pems-table-scroll>
                <pems-table scale="small" css="table-enterprise">
                    <pems-table-head>
                        <pems-table-row>
                            <pems-table-header>@Localizer["Kpi_Exec_Kpi"]</pems-table-header><pems-table-header>@Localizer["Kpi_Exec_Direction"]</pems-table-header>
                            <pems-table-header>@Localizer["Kpi_Exec_Target"]</pems-table-header><pems-table-header>@Localizer["Kpi_Exec_Warn"]</pems-table-header><pems-table-header>@Localizer["Kpi_Exec_Source"]</pems-table-header><pems-table-header></pems-table-header>
                        </pems-table-row>
                    </pems-table-head>
                    <pems-table-body>
                    @foreach (var tg in Model.Targets)
                    {
                        var formId = "kpiTargetForm_" + tg.Key;
                        <pems-table-row data-kpi-target="@tg.Key">
                            <pems-table-cell>@Localizer["Kpi_Name_" + tg.Key] <span class="text-muted small">(@Localizer["Kpi_Section_" + tg.Section])</span></pems-table-cell>
                            <pems-table-cell>@(tg.Direction == KpiDirections.LowerIsBetter ? "≤" : "≥") <span class="text-muted small">@(tg.Unit == "currency" ? "" : tg.Unit)</span></pems-table-cell>
                            <pems-table-cell><pems-input scale="small" css="pems-kpi-input" form="@formId" type="number" step="any" min="0" name="target" value="@(tg.Target?.ToString("0.####", inv))" aria-label="@Localizer["Kpi_Exec_Target"]: @Localizer["Kpi_Name_" + tg.Key]" /></pems-table-cell>
                            <pems-table-cell><pems-input scale="small" css="pems-kpi-input" form="@formId" type="number" step="any" min="0" name="warn" value="@(tg.Warn?.ToString("0.####", inv))" aria-label="@Localizer["Kpi_Exec_Warn"]: @Localizer["Kpi_Name_" + tg.Key]" /></pems-table-cell>
                            <pems-table-cell><span class="small text-muted">@(tg.IsCustom ? Localizer["Kpi_Exec_Custom"] : Localizer["Kpi_Exec_Default"])</span></pems-table-cell>
                            <pems-table-cell>
                                <pems-form id="@formId" method="post" asp-action="SaveTarget" class="d-inline">
                                    <input type="hidden" name="key" value="@tg.Key" />
                                    <input type="hidden" name="fromDate" value="@Model.From.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="toDate" value="@Model.To.ToString("yyyy-MM-dd")" />
                                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                                </pems-form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                    </pems-table-body>
                </pems-table>
            </pems-table-scroll>
        </details>
    }
</div>
