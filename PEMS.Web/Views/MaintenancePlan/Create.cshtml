@model PEMS.Web.ViewModels.PlanFormViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Domain.Common
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var ctx = Model.Context;
    var i = Model.Input;
}

<pems-content-card css="pems-s-09a5de31">
    @await Html.PartialAsync("_RcmErrors", Model.Errors)

    @if (ctx == null)
    {
        @* انتخاب تخصیص (تگ + نسخه‌ی استراتژی) - برچسب‌ها متمایزند: تگ · نوع · حالت خرابی · نسخه *@
        <h6 class="mb-3">@Localizer["Rcm_PickAssignment"]</h6>
        @if (!Model.Choices.Any())
        {
            <p class="text-muted">@Localizer["Rcm_NoEligibleAssignments"] <a asp-controller="MaintenanceStrategy" asp-action="Index">@Localizer["Rcm_Strategies"]</a></p>
        }
        else
        {
            <pems-list-group>
                @foreach (var c in Model.Choices)
                {
                    <pems-list-group-item action="true" asp-action="Create" asp-route-assignmentId="@c.AssignmentId">
                        <strong>@c.Tag</strong> · @Localizer.Label("StrategyType", c.StrategyType) · @RcmDisplay.Name(c.FailureModeName, c.FailureModeNameFa) · v@(c.StrategyVersion)
                        <span class="text-muted small">@c.EquipmentClassName</span>
                    </pems-list-group-item>
                }
            </pems-list-group>
        }
    }
    else
    {
        <p class="text-muted small">@Localizer["Rcm_PlanHint"]</p>
        @await Html.PartialAsync("_EquipmentIdentity", ctx.Equipment)
        <div class="small mb-3">
            <span class="text-muted">@Localizer["Rcm_Strategy"]:</span>
            <a asp-controller="MaintenanceStrategy" asp-action="Details" asp-route-id="@ctx.StrategyId">#@ctx.StrategyId · v@(ctx.StrategyVersion)</a>
            · <pems-badge tone="neutral">@Localizer.Label("StrategyType", ctx.StrategyType)</pems-badge>
            · @RcmDisplay.Name(ctx.FailureModeName, ctx.FailureModeNameFa)
            · <pems-badge tone="@RcmDisplay.ConsequenceBadge(ctx.ConsequenceCategory)">@Localizer.Label("Consequence", ctx.ConsequenceCategory)</pems-badge>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" name="MaintenanceStrategyAssignmentId" value="@ctx.AssignmentId" />
            <pems-row gap="3">
                <pems-col span="12">
                    <pems-label>@Localizer["Title"] <span class="text-danger">*</span></pems-label>
                    <pems-input name="Title" value="@i.Title" minlength="5" required />
                    <span class="text-danger small">@Html.ValidationMessage("title")</span>
                </pems-col>

                <pems-col md="4">
                    <pems-label>@Localizer["Rcm_TriggerType"]</pems-label>
                    <pems-select name="TriggerType" id="triggerTypeSelect">
                        @foreach (var t in RcmCodes.Trigger.All) { <option value="@t" selected="@(i.TriggerType == t)">@Localizer.Label("Trigger", t)</option> }
                    </pems-select>
                    <span class="text-danger small">@Html.ValidationMessage("triggerType")</span>
                </pems-col>
                <pems-col md="4" id="intervalDaysWrap">
                    <pems-label>@Localizer["Rcm_IntervalDays"]</pems-label>
                    <pems-input name="IntervalDays" type="number" min="1" value="@i.IntervalDays" />
                    @if (ctx.SuggestedIntervalDays.HasValue) { <pems-help-text>@Localizer["Rcm_SuggestedInterval", ctx.SuggestedIntervalDays.Value, ctx.Equipment.CriticalityClass ?? "-"]</pems-help-text> }
                    <span class="text-danger small">@Html.ValidationMessage("intervalDays")</span>
                </pems-col>
                <pems-col md="4" id="nextDueDateWrap">
                    <pems-label>@Localizer["Rcm_NextDueDate"]</pems-label>
                    <pems-date name="NextDueDate" value="@i.NextDueDate?.ToString("yyyy-MM-dd")" />
                    <span class="text-danger small">@Html.ValidationMessage("nextDueDate")</span>
                    <pems-check-row css="mt-1 small">
                        <pems-input kind="check" type="checkbox" name="AllowPastDueDate" value="true" id="allowPast" />
                        <label class="form-check-label" for="allowPast">@Localizer["Rcm_AllowPastDue"]</label>
                        <input type="hidden" name="AllowPastDueDate" value="false" />
                    </pems-check-row>
                </pems-col>
                <pems-col md="4" id="meterTypeWrap" hidden>
                    <pems-label>@Localizer["Rcm_MeterType"]</pems-label>
                    <pems-select name="MeterType">
                        @foreach (var m in RcmCodes.MeterType.All) { <option value="@m" selected="@(i.MeterType == m)">@Localizer.Label("MeterType", m)</option> }
                    </pems-select>
                    <span class="text-danger small">@Html.ValidationMessage("meterType")</span>
                </pems-col>
                <pems-col md="4" id="meterIntervalWrap" hidden>
                    <pems-label>@Localizer["Rcm_MeterInterval"]</pems-label>
                    <pems-input name="MeterInterval" type="number" step="0.01" min="0.01" value="@i.MeterInterval" />
                    <span class="text-danger small">@Html.ValidationMessage("meterInterval")</span>
                </pems-col>
                <pems-col md="4">
                    <pems-label>@Localizer["Rcm_ScheduleMode"]</pems-label>
                    <pems-select name="ScheduleMode">
                        <option value="Fixed" selected="@(i.ScheduleMode != "Floating")">@Localizer.Label("ScheduleMode", "Fixed")</option>
                        <option value="Floating" selected="@(i.ScheduleMode == "Floating")">@Localizer.Label("ScheduleMode", "Floating")</option>
                    </pems-select>
                    <pems-help-text>@Localizer["Rcm_ScheduleModeHint"]</pems-help-text>
                </pems-col>

                <pems-col span="12">
                    <pems-label>@Localizer["Job Plan"] <span class="text-danger">*</span></pems-label>
                    <pems-select name="JobPlanId" required>
                        <option value="">@Localizer["Rcm_SelectPlaceholder"]</option>
                        @foreach (var jp in Model.JobPlans) { <option value="@jp.Id" selected="@(i.JobPlanId == jp.Id)">@jp.Code &mdash; @jp.Text</option> }
                    </pems-select>
                    <pems-help-text>@Localizer["Rcm_JobPlanHint"] <a asp-controller="JobPlan" asp-action="Index" target="_blank">@Localizer["Rcm_ManageJobPlans"]</a></pems-help-text>
                    <span class="text-danger small">@Html.ValidationMessage("jobPlanId")</span>
                </pems-col>

                <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="Description" rows="2">@i.Description</pems-textarea></pems-col>
            </pems-row>
            <div class="mt-4">
                <pems-button tone="primary" type="submit">@Localizer["Rcm_CreatePlan"]</pems-button>
                <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
            </div>
        </form>

        <script src="~/js/views/maintenanceplan-create.js" asp-append-version="true"></script>
    }
</pems-content-card>
