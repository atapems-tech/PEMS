@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaintenancePlanListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its columns, the meter-reading form in the
   trigger column and the generate / deactivate actions. "Generate due PMs" is a tool of the toolbar. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Mp_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <form asp-action="GenerateDueWorkOrders" method="post" class="d-inline" data-confirm="@Localizer["Mp_GenerateDueConfirm"]" onsubmit="return confirm(this.dataset.confirm)">
                    <button type="submit" class="lp-icon-btn" title="@Localizer["Mp_GenerateDue"]"><i class="bi bi-lightning-charge" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Mp_GenerateDue"]</span></button>
                </form>
                <pems-list-reset-columns grid-key="MaintenancePlan" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Rcm_NewPlan"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="MaintenancePlan" empty="@(!Model.Items.Any())" empty-text="@Localizer["Mp_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="planNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Mp_PlanNo"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220" style="width:160px">@Localizer["Equipment"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">@Localizer["Cm_Title"]</th>
                        <th data-col-key="strategy" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Cm_Strategy"]</th>
                        <th data-col-key="trigger" data-resizable="true" data-min-width="140" data-max-width="320" style="width:220px">@Localizer["Cm_Trigger"]</th>
                        <th data-col-key="lastDone" data-resizable="true" data-min-width="100" data-max-width="180" style="width:120px" class="vs-hide-md">@Localizer["Cm_LastDone"]</th>
                        <th data-col-key="nextDue" data-resizable="true" data-min-width="100" data-max-width="200" style="width:150px">@Localizer["Cm_NextDue"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:170px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@p.PlanNumber</span></td>
                            <td class="small">
                                <a asp-controller="MaintenanceStrategy" asp-action="Tag" asp-route-equipmentId="@p.EquipmentId" class="lp-subject">@p.EquipmentTagNumber</a>
                                <div class="text-muted">@p.EquipmentName</div>
                                <div class="text-muted">@(p.EquipmentClassName ?? Localizer["Rcm_Unclassified"].Value)
                                    <pems-badge tone="none" css="@RcmDisplay.CriticalityBadge(p.CriticalityClass ?? "Unrated")">@Localizer.Label("Criticality", p.CriticalityClass ?? "Unrated")</pems-badge></div>
                            </td>
                            <td><span class="vs-title-cell" title="@p.Title">@p.Title</span></td>
                            <td class="small">
                                <span class="vs-pill vs-pill--neutral">@Localizer.Label("StrategyType", p.StrategyType)</span>
                                @if (p.StrategyId.HasValue) { <a asp-controller="MaintenanceStrategy" asp-action="Details" asp-route-id="@p.StrategyId">v@(p.StrategyVersion)</a> }
                                <div class="text-muted">@RcmDisplay.Name(p.FailureModeName, p.FailureModeNameFa)</div>
                                <div class="text-muted">@Localizer.Label("ScheduleMode", p.ScheduleMode)</div>
                                @if (!p.HasAssignment) { <span class="vs-pill vs-pill--warning" title="@Localizer["Rcm_PlanNoAssignment"]">@Localizer["Rcm_NoAssignmentBadge"]</span> }
                            </td>
                            <td class="small">
                                @if (p.TriggerType is "Calendar" or "Both")
                                {
                                    <div>@(p.IntervalDays.HasValue ? string.Format(Localizer["Mp_EveryDays"].Value, p.IntervalDays) : "-")</div>
                                }
                                @if (p.TriggerType is "Meter" or "Both")
                                {
                                    <div>
                                        <span class="vs-pill vs-pill--info">@string.Format(Localizer["Mp_MeterEvery"].Value, p.MeterType, p.MeterInterval)</span>
                                        @if (p.NextDueMeterReading.HasValue) { <span class="text-muted">@string.Format(Localizer["Mp_DueAtReading"].Value, p.NextDueMeterReading)</span> }
                                    </div>
                                    <form asp-action="RecordMeterReading" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                        <input type="number" step="0.01" name="currentReading" class="form-control form-control-sm" style="width:90px;"
                                               placeholder="@Localizer["Mp_CurrentReading"]" aria-label="@Localizer["Mp_CurrentReading"]" required />
                                        <pems-button tone="info" size="small" outline="true" type="submit">@Localizer["Mp_Record"]</pems-button>
                                    </form>
                                }
                            </td>
                            <td class="small vs-hide-md"><span class="vs-num">@(p.LastExecutionDate?.ToString("yyyy-MM-dd"))</span></td>
                            <td class="small">
                                <span class="vs-num">@(p.NextDueDate?.ToString("yyyy-MM-dd"))</span>
                                @if (p.IsOverdue) { <div><span class="vs-pill vs-pill--icon vs-pill--danger"><i class="bi bi-clock-history" aria-hidden="true"></i> @Localizer["Overdue"]</span></div> }
                            </td>
                            <td class="text-nowrap text-end">
                                <form asp-action="GenerateWorkOrder" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                    <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-clipboard-plus" aria-hidden="true"></i> @Localizer["Mp_GenerateWo"]</pems-button>
                                </form>
                                <form asp-action="Deactivate" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                    <button type="submit" class="lp-act lp-act--always" title="@Localizer["Mp_Deactivate"]" aria-label="@Localizer["Mp_Deactivate"]"><i class="bi bi-slash-circle" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "MaintenancePlan",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
