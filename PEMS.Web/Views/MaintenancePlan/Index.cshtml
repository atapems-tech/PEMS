@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaintenancePlanListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its columns, the meter-reading form in the
   trigger column and the generate / deactivate actions. "Generate due PMs" is a tool of the toolbar. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Mp_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-form asp-action="GenerateDueWorkOrders" method="post" class="d-inline" data-pems-confirm="@Localizer["Mp_GenerateDueConfirm"]">
                    <pems-button plain="true" type="submit" css="lp-icon-btn" title="@Localizer["Mp_GenerateDue"]"><pems-icon name="bi-lightning-charge" aria-hidden="true" /><span class="visually-hidden">@Localizer["Mp_GenerateDue"]</span></pems-button>
                </pems-form>
                <pems-list-reset-columns grid-key="MaintenancePlan" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Rcm_NewPlan"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="MaintenancePlan" empty="@(!Model.Items.Any())" empty-text="@Localizer["Mp_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="planNo" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Mp_PlanNo"]</pems-table-header>
                        <pems-table-header class="pems-w-160" data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Equipment"]</pems-table-header>
                        <pems-table-header class="pems-w-200" data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["Cm_Title"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="strategy" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Cm_Strategy"]</pems-table-header>
                        <pems-table-header class="pems-w-220" data-col-key="trigger" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["Cm_Trigger"]</pems-table-header>
                        <pems-table-header data-col-key="lastDone" data-resizable="true" data-min-width="100" data-max-width="180" class="vs-hide-md pems-w-120">@Localizer["Cm_LastDone"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="nextDue" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Cm_NextDue"]</pems-table-header>
                        <pems-table-header class="pems-w-170" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var p in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><span class="vs-num">@p.PlanNumber</span></pems-table-cell>
                            <pems-table-cell class="small">
                                <a asp-controller="MaintenanceStrategy" asp-action="Tag" asp-route-equipmentId="@p.EquipmentId" class="lp-subject">@p.EquipmentTagNumber</a>
                                <div class="text-muted">@p.EquipmentName</div>
                                <div class="text-muted">@(p.EquipmentClassName ?? Localizer["Rcm_Unclassified"].Value)
                                    <pems-badge tone="@RcmDisplay.CriticalityBadge(p.CriticalityClass ?? "Unrated")">@Localizer.Label("Criticality", p.CriticalityClass ?? "Unrated")</pems-badge></div>
                            </pems-table-cell>
                            <pems-table-cell><span class="vs-title-cell" title="@p.Title">@p.Title</span></pems-table-cell>
                            <pems-table-cell class="small">
                                <span class="vs-pill vs-pill--neutral">@Localizer.Label("StrategyType", p.StrategyType)</span>
                                @if (p.StrategyId.HasValue) { <a asp-controller="MaintenanceStrategy" asp-action="Details" asp-route-id="@p.StrategyId">v@(p.StrategyVersion)</a> }
                                <div class="text-muted">@RcmDisplay.Name(p.FailureModeName, p.FailureModeNameFa)</div>
                                <div class="text-muted">@Localizer.Label("ScheduleMode", p.ScheduleMode)</div>
                                @if (!p.HasAssignment) { <span class="vs-pill vs-pill--warning" title="@Localizer["Rcm_PlanNoAssignment"]">@Localizer["Rcm_NoAssignmentBadge"]</span> }
                            </pems-table-cell>
                            <pems-table-cell class="small">
                                @if (p.TriggerType is "Calendar" or "Both")
                                {
                                    <div>@(p.IntervalDays.HasValue ? string.Format(Localizer["Mp_EveryDays"].Value, p.IntervalDays) : "-")</div>
                                }
                                @if (p.TriggerType is "Meter" or "Both")
                                {
                                    <div>
                                        <span class="vs-pill vs-pill--info">@string.Format(Localizer["Mp_MeterEvery"].Value, p.MeterType, p.MeterInterval)</span>
                                        @if (p.NextDueMeterReading.HasValue) { <span class="text-muted">@string.Format(Localizer["Mp_DueAtReading"].Value, p.NextDueMeterReading)</span> }
                                    </div>
                                    <pems-form class="mt-1" asp-action="RecordMeterReading" method="post"><pems-flex gap="1">
                                        <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                        <pems-input class="pems-w-90" scale="small" type="number" step="0.01" name="currentReading" placeholder="@Localizer["Mp_CurrentReading"]" aria-label="@Localizer["Mp_CurrentReading"]" required />
                                        <pems-button tone="info" size="small" outline="true" type="submit">@Localizer["Mp_Record"]</pems-button>
                                    </pems-flex></pems-form>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@(p.LastExecutionDate?.ToString("yyyy-MM-dd"))</span></pems-table-cell>
                            <pems-table-cell class="small">
                                <span class="vs-num">@(p.NextDueDate?.ToString("yyyy-MM-dd"))</span>
                                @if (p.IsOverdue) { <div><span class="vs-pill vs-pill--icon vs-pill--danger"><pems-icon name="bi-clock-history" aria-hidden="true" /> @Localizer["Overdue"]</span></div> }
                            </pems-table-cell>
                            <pems-table-cell class="text-nowrap text-end">
                                <pems-form asp-action="GenerateWorkOrder" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                    <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-clipboard-plus" aria-hidden="true" /> @Localizer["Mp_GenerateWo"]</pems-button>
                                </pems-form>
                                <pems-form asp-action="Deactivate" method="post" class="d-inline">
                                    <input type="hidden" name="planId" value="@p.MaintenancePlanId" />
                                    <pems-button plain="true" type="submit" css="lp-act lp-act--always" title="@Localizer["Mp_Deactivate"]" aria-label="@Localizer["Mp_Deactivate"]"><pems-icon name="bi-slash-circle" aria-hidden="true" /></pems-button>
                                </pems-form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "MaintenancePlan",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
