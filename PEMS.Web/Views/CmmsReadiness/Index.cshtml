@model List<PEMS.Application.DTOs.ClassActivationBacklogItemDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var summary = (CmmsOperationalReadinessDto)ViewBag.Summary;
}

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EquipmentClassification" asp-action="Coverage"><pems-icon name="bi-diagram-3" /> @Localizer["Master Data Coverage"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Reliability" asp-action="Intelligence"><pems-icon name="bi-clipboard-data-fill" /> @Localizer["Maintenance Intelligence"]</pems-button>
    </div>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 7.5»: این صفحه هیچ رکوردی نمی‌سازد - فقط نشان می‌دهد کدام تجهیز/کلاس با
    داده‌ی مرجع موجود واقعاً «آماده‌ی اجرا» است. فعال‌سازی واقعی (ساخت Strategy/Plan/JobPlan)
    از طریق صفحات موجود و با مجوز انسانی انجام می‌شود - هرگز خودکار (بند ۴۳).
</p>

@* ===================== Executive Summary ===================== *@
<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@summary.TotalActiveEquipment.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Total Active Equipment"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@summary.ClassifiedEquipment.ToString("N0")</pems-metric>
            <div class="text-muted small">Classified (@summary.UnclassifiedEquipment.ToString("N0") unclassified)</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@summary.CriticalityReadyEquipment.ToString("N0")</pems-metric>
            <div class="text-muted small">Criticality Assessed</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100 text-center">
            <pems-metric css="text-success">@summary.ExecutionReadyEquipment.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Execution Ready"]</div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mb-3">
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-body>
            <pems-table-row><pems-table-cell>Strategy Ready</pems-table-cell><pems-table-cell class="text-end">@summary.StrategyReadyEquipment.ToString("N0")</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>PM Plan Ready</pems-table-cell><pems-table-cell class="text-end">@summary.PmPlanReadyEquipment.ToString("N0")</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Job Plan Ready</pems-table-cell><pems-table-cell class="text-end">@summary.JobPlanReadyEquipment.ToString("N0")</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Safety Ready</pems-table-cell><pems-table-cell class="text-end">@summary.SafetyReadyEquipment.ToString("N0")</pems-table-cell></pems-table-row>
        </pems-table-body>
    </pems-table>
</pems-content-card>

@* ===================== Class Activation Backlog ===================== *@
<pems-content-card>
    <h6 class="mb-2">@Localizer["Class Activation Backlog"]</h6>
    <p class="text-muted small">
        رتبه‌بندی با عوامل صریح (بند ۸/۲۶): اول کلاس‌هایی که مبنای مدافعه‌پذیر (PM Template یا
        Failure Mode) دارند، بعد بر اساس جمعیت تجهیز - نه یک امتیاز مبهم.
    </p>
    <div class="table-scroll-area pems-s-0ddf068b">
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["Class"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["Equipment"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["Criticality"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["Strategy"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["PM Plan"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["Execution Ready"]</pems-table-header>
                <pems-table-header>@Localizer["Basis"]</pems-table-header>
                <pems-table-header>@Localizer["Missing"]</pems-table-header>
                <pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var c in Model)
            {
                <pems-table-row>
                    <pems-table-cell class="fw-bold">@c.Name <code class="small">@c.Code</code></pems-table-cell>
                    <pems-table-cell class="text-end">@c.EquipmentCount</pems-table-cell>
                    <pems-table-cell class="text-end">@c.CriticalityReadyCount</pems-table-cell>
                    <pems-table-cell class="text-end">@c.StrategyReadyCount</pems-table-cell>
                    <pems-table-cell class="text-end">@c.PmPlanReadyCount</pems-table-cell>
                    <pems-table-cell class="text-end">
                        <pems-badge tone="@(c.ExecutionReadyCount > 0 ? "success" : "neutral")">@c.ExecutionReadyCount</pems-badge>
                    </pems-table-cell>
                    <pems-table-cell class="small">
                        @if (c.HasDefensibleBasis)
                        {
                            <pems-badge tone="success">Defensible</pems-badge>
                        }
                        else
                        {
                            <pems-badge tone="neutral">None yet</pems-badge>
                        }
                    </pems-table-cell>
                    <pems-table-cell class="small text-muted">
                        @foreach (var m in c.MissingRequirements) { <div>@m</div> }
                    </pems-table-cell>
                    <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ClassDetail" asp-route-id="@c.EquipmentClassId">Open</pems-button></pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هیچ کلاسی با تجهیز واقعی موجود نیست."]</p> }
</pems-content-card>
