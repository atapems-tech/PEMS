@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentReadinessRowDto>
@using PEMS.Domain.Entities
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentClass = (EquipmentClass)ViewBag.EquipmentClass;

    string StateBadge(string state) => state switch
    {
        "READY" => "success",
        "NOT_APPLICABLE" => "light",
        "MISSING_MASTER_DATA" => "warning",
        "BLOCKED_BY_SAFETY" => "danger",
        "REQUIRES_REVIEW" => "warning",
        _ => "neutral"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><pems-icon name="bi-clipboard-check" /> Readiness — @equipmentClass.Name <code class="small">@equipmentClass.Code</code></h5>
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Backlog"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="MaintenanceStrategy" asp-action="BulkCreate"><pems-icon name="bi-diagram-3" /> @Localizer["Define Strategy"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="JobPlan" asp-action="Index"><pems-icon name="bi-list-check" /> @Localizer["Job Plans"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="EquipmentCriticality" asp-action="Index"><pems-icon name="bi-shield-exclamation" /> @Localizer["Criticality"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="CriticalityAssessment" asp-action="Index" asp-route-equipmentClassId="@equipmentClass.EquipmentClassId"><pems-icon name="bi-clipboard2-check" /> @Localizer["Assessments"]</pems-button>
    </div>
</div>

<div class="content-card">
    <div class="table-scroll-area pems-s-0ddf068b">
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <thead>
            <tr>
                <th>@Localizer["Tag"]</th>
                <th>@Localizer["Classification"]</th>
                <th>@Localizer["Criticality"]</th>
                <th>@Localizer["Strategy"]</th>
                <th>@Localizer["PM Plan"]</th>
                <th>@Localizer["Job Plan"]</th>
                <th>@Localizer["Safety"]</th>
                <th>@Localizer["Execution"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                <tr class="@(r.ExecutionReady ? "table-success" : "")">
                    <td class="fw-bold small">@r.TagNumber</td>
                    <td><pems-badge tone="@StateBadge(r.Classification)">@r.Classification</pems-badge></td>
                    <td>
                        <pems-badge tone="@StateBadge(r.Criticality)">@r.Criticality</pems-badge>
                        @if (r.Criticality == "NOT_READY")
                        {
                            <a asp-controller="CriticalityAssessment" asp-action="Create" asp-route-equipmentId="@r.EquipmentId" class="small d-block">Assess →</a>
                        }
                    </td>
                    <td><pems-badge tone="@StateBadge(r.Strategy)">@r.Strategy</pems-badge></td>
                    <td><pems-badge tone="@StateBadge(r.PmPlan)">@r.PmPlan</pems-badge></td>
                    <td><pems-badge tone="@StateBadge(r.JobPlan)">@r.JobPlan</pems-badge></td>
                    <td><pems-badge tone="@StateBadge(r.Safety)">@r.Safety</pems-badge></td>
                    <td>
                        @if (r.ExecutionReady)
                        {
                            <pems-badge tone="success"><pems-icon name="bi-check-lg" /> @Localizer["Ready"]</pems-badge>
                        }
                        else
                        {
                            <span class="text-muted small">Not Ready</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هیچ تجهیزی در این کلاس نیست."]</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "CmmsReadinessClassDetail",
        BaseUrl = Url.Action("ClassDetail", new { id = equipmentClass.EquipmentClassId }) ?? "",
        ExistingQueryString = ""
    })
</div>
