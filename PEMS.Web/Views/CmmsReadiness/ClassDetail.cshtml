@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentReadinessRowDto>
@using PEMS.Domain.Entities
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentClass = (EquipmentClass)ViewBag.EquipmentClass;

    string StateBadge(string state) => state switch
    {
        "READY" => "success",
        "NOT_APPLICABLE" => "light",
        "MISSING_MASTER_DATA" => "warning",
        "BLOCKED_BY_SAFETY" => "danger",
        "REQUIRES_REVIEW" => "warning",
        _ => "neutral"
    };
}

<pems-flex justify="between" align="center" css="mb-3">
    <pems-heading level="5" class="mb-0"><pems-icon name="bi-clipboard-check" /> Readiness — @equipmentClass.Name <code class="small">@equipmentClass.Code</code></pems-heading>
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Backlog"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="MaintenanceStrategy" asp-action="BulkCreate"><pems-icon name="bi-diagram-3" /> @Localizer["Define Strategy"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="JobPlan" asp-action="Index"><pems-icon name="bi-list-check" /> @Localizer["Job Plans"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="EquipmentCriticality" asp-action="Index"><pems-icon name="bi-shield-exclamation" /> @Localizer["Criticality"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="CriticalityAssessment" asp-action="Index" asp-route-equipmentClassId="@equipmentClass.EquipmentClassId"><pems-icon name="bi-clipboard2-check" /> @Localizer["Assessments"]</pems-button>
    </div>
</pems-flex>

<pems-content-card>
    <div class="table-scroll-area pems-s-0ddf068b">
    <pems-data-table data="@(DataRows.Of(Model.Items, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), r => (object?)(r.TagNumber), css: "fw-bold small").Add(((Localizer["Classification"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(StateBadge(r.Classification), r.Classification))).Add(((Localizer["Criticality"])?.ToString() ?? ""), r => (object?)(DataCell.Group(DataCell.Badge(StateBadge(r.Criticality), r.Criticality), " ", (r.Criticality == "NOT_READY" ? (object?)DataCell.LinkClass(Url.Action("Create", "CriticalityAssessment", new { equipmentId = r.EquipmentId }), "small d-block", "Assess →") : null)))).Add(((Localizer["Strategy"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(StateBadge(r.Strategy), r.Strategy))).Add(((Localizer["PM Plan"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(StateBadge(r.PmPlan), r.PmPlan))).Add(((Localizer["Job Plan"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(StateBadge(r.JobPlan), r.JobPlan))).Add(((Localizer["Safety"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(StateBadge(r.Safety), r.Safety))).Add(((Localizer["Execution"])?.ToString() ?? ""), r => (object?)((r.ExecutionReady ? (object?)DataCell.Badge("success", DataCell.Group(DataCell.Icon("bi-check-lg"), " ", Localizer["Ready"])) : DataCell.Span("text-muted small", "Not Ready")))), rowClass: r => (r.ExecutionReady ? "table-success" : "")))" dense="true" css="mb-0" />
    </div>
    @if (!Model.Items.Any()) { <pems-text class="text-muted text-center py-4 mb-0">@Localizer["هیچ تجهیزی در این کلاس نیست."]</pems-text> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "CmmsReadinessClassDetail",
        BaseUrl = Url.Action("ClassDetail", new { id = equipmentClass.EquipmentClassId }) ?? "",
        ExistingQueryString = ""
    })
</pems-content-card>
