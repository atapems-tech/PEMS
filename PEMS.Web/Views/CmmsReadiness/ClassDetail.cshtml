@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentReadinessRowDto>
@using PEMS.Domain.Entities
@{
    var equipmentClass = (EquipmentClass)ViewBag.EquipmentClass;

    string StateBadge(string state) => state switch
    {
        "READY" => "text-bg-success",
        "NOT_APPLICABLE" => "text-bg-light border",
        "MISSING_MASTER_DATA" => "text-bg-warning",
        "BLOCKED_BY_SAFETY" => "text-bg-danger",
        "REQUIRES_REVIEW" => "text-bg-warning",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard-check"></i> Readiness — @equipmentClass.Name <code class="small">@equipmentClass.Code</code></h5>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Backlog</a>
        <a asp-controller="MaintenanceStrategy" asp-action="BulkCreate" class="btn btn-outline-primary btn-sm"><i class="bi bi-diagram-3"></i> Define Strategy</a>
        <a asp-controller="JobPlan" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-list-check"></i> Job Plans</a>
        <a asp-controller="EquipmentCriticality" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-shield-exclamation"></i> Criticality</a>
        <a asp-controller="CriticalityAssessment" asp-action="Index" asp-route-equipmentClassId="@equipmentClass.EquipmentClassId" class="btn btn-outline-primary btn-sm"><i class="bi bi-clipboard2-check"></i> Assessments</a>
    </div>
</div>

<div class="content-card">
    <div class="table-scroll-area" style="overflow-x:auto;">
    <table class="table table-enterprise table-sm mb-0">
        <thead>
            <tr>
                <th>Tag</th>
                <th>Classification</th>
                <th>Criticality</th>
                <th>Strategy</th>
                <th>PM Plan</th>
                <th>Job Plan</th>
                <th>Safety</th>
                <th>Execution</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                <tr class="@(r.ExecutionReady ? "table-success" : "")">
                    <td class="fw-bold small">@r.TagNumber</td>
                    <td><span class="badge @StateBadge(r.Classification)">@r.Classification</span></td>
                    <td>
                        <span class="badge @StateBadge(r.Criticality)">@r.Criticality</span>
                        @if (r.Criticality == "NOT_READY")
                        {
                            <a asp-controller="CriticalityAssessment" asp-action="Create" asp-route-equipmentId="@r.EquipmentId" class="small d-block">Assess →</a>
                        }
                    </td>
                    <td><span class="badge @StateBadge(r.Strategy)">@r.Strategy</span></td>
                    <td><span class="badge @StateBadge(r.PmPlan)">@r.PmPlan</span></td>
                    <td><span class="badge @StateBadge(r.JobPlan)">@r.JobPlan</span></td>
                    <td><span class="badge @StateBadge(r.Safety)">@r.Safety</span></td>
                    <td>
                        @if (r.ExecutionReady)
                        {
                            <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> Ready</span>
                        }
                        else
                        {
                            <span class="text-muted small">Not Ready</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">هیچ تجهیزی در این کلاس نیست.</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "CmmsReadinessClassDetail",
        BaseUrl = Url.Action("ClassDetail", new { id = equipmentClass.EquipmentClassId }) ?? "",
        ExistingQueryString = ""
    })
</div>
