@model PEMS.Application.DTOs.PurchaseOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-470: lines and approval by the PO authority table
    var a = ViewBag.Approval as PEMS.Application.Interfaces.PoApprovalView;
    var canEdit = ViewBag.CanEdit is true;
    var roles = (ViewBag.UserRoles as IReadOnlyList<string>) ?? Array.Empty<string>();
    var userName = ViewBag.UserName as string;
    var requisitions = ViewBag.Requisitions as IReadOnlyList<(int Id, string Number, string Description, int ProjectId)>;
    var groups = ViewBag.CommodityGroups as IReadOnlyList<(int Id, string Code, string Description)>;
    var isDraft = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Draft;
    var isSubmitted = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Submitted;
    var holdsRole = a?.ApproverRole != null && roles.Contains(a.ApproverRole, StringComparer.OrdinalIgnoreCase);
    var isOwnPo = !string.IsNullOrEmpty(userName) && (string.Equals(userName, a?.CreatedBy, StringComparison.OrdinalIgnoreCase)
                                                      || string.Equals(userName, a?.SubmittedBy, StringComparison.OrdinalIgnoreCase));
    // SCRUM-473: delivery warehouse, receiving and inspection release
    var receivingLines = ViewBag.Receiving as IReadOnlyList<PEMS.Application.Interfaces.PoLineReceivingView>;
    var warehouses = (IEnumerable<dynamic>)(ViewBag.Warehouses ?? Array.Empty<object>());
    var plans = (IEnumerable<dynamic>)(ViewBag.InspectionPlans ?? Array.Empty<object>());
    var canRelease = ViewBag.CanReleaseInspection == true;
    var isIssued = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Issued || Model.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Issued;
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<div class="content-card">
    <div class="row g-3">
        <div class="col-md-4"><strong>@Localizer["PO Number"]:</strong> @Model.PoNumber</div>
        <div class="col-md-4"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-4"><strong>@Localizer["Vendor"]:</strong> @Model.VendorName</div>
        <div class="col-md-4"><strong>@Localizer["Contract No"]:</strong> @(Model.ContractNo ?? "-")</div>
        <div class="col-md-4"><strong>@Localizer["Value"]:</strong> @Model.Value?.ToString("N0") @a?.Currency</div>
        <div class="col-md-4"><strong>@Localizer["Status"]:</strong> <pems-badge tone="info">@Localizer["Po_Status_" + Model.Status]</pems-badge></div>
        <div class="col-12"><strong>@Localizer["Description"]:</strong> @Model.Description</div>
        @if (a?.MaterialRequisitionId != null)
        {
            <div class="col-md-4"><strong>MR:</strong> <a href="/MaterialRequisition/Details/@a.MaterialRequisitionId" dir="ltr">@a.MaterialRequisitionNumber</a></div>
        }
    </div>
    @if (ViewBag.CanIssue == true)
    {
        <form asp-action="Issue" asp-route-id="@Model.PoId" method="post" class="mt-3">
            <pems-button tone="primary" size="small" type="submit"><i class="bi bi-send-check"></i> @Localizer["Issue Purchase Order"]</pems-button>
        </form>
    }
</div>

@if (a != null)
{
    <div class="content-card mt-3">
        <h6 class="mb-2"><i class="bi bi-list-ol" aria-hidden="true"></i> @Localizer["Po_Lines"]</h6>
        @if (!string.IsNullOrEmpty(a.RejectionReason) && isDraft)
        {
            <pems-alert tone="warning" css="py-2 px-3 small"><strong>@Localizer["Po_RejectedBecause"]:</strong> @a.RejectionReason</pems-alert>
        }
        @if (a.Lines.Count == 0)
        {
            <p class="small text-muted">@Localizer["Po_NoLines"]</p>
        }
        else
        {
        <div class="table-responsive">
            <table class="table table-enterprise table-sm align-middle">
                <thead>
                    <tr>
                        <th>#</th><th>@Localizer["Po_Item"]</th><th class="text-end">@Localizer["Po_Quantity"]</th><th class="text-end">@Localizer["Po_UnitPrice"]</th>
                        <th class="text-end">@Localizer["Po_Amount"]</th><th>@Localizer["Po_Supply"]</th>@if (isDraft && canEdit) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in a.Lines)
                {
                    <tr>
                        <td dir="ltr">@l.LineNo</td>
                        <td class="small">
                            @if (l.PartNumber != null) { <span dir="ltr">@l.PartNumber</span><text> - </text> }@l.Description
                            <span class="vs-pill @(l.IsCatalogued ? "vs-pill--success" : "vs-pill--warning") ms-1">@Localizer[l.IsCatalogued ? "Mr_PartCatalogued" : "Mr_PartNotCatalogued"]</span>
                            @if (l.TenderId.HasValue) { <a class="ms-1 small" href="/Tender/Details/@l.TenderId">@Localizer["Po_FromAward"]</a> }
                            @if (!l.IsCatalogued && l.CommodityGroup != null) { <div class="text-muted">@l.CommodityGroup — @l.FreeTextReason</div> }
                        </td>
                        <td class="text-end" dir="ltr">@l.Quantity.ToString("0.###") @l.Unit</td>
                        <td class="text-end" dir="ltr">@l.UnitPrice.ToString("N2")</td>
                        <td class="text-end" dir="ltr">@l.LineAmount.ToString("N2")</td>
                        <td class="small">@Localizer[l.IsStockLine ? "Po_StockLine" : "Po_DirectLine"]@if (l.WarehouseCode != null) { <div class="text-muted" dir="ltr">@l.WarehouseCode</div> }</td>
                        @if (isDraft && canEdit)
                        {
                            <td class="text-end text-nowrap">
                                <form asp-action="RemoveLine" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@l.PurchaseOrderLineId" />
                                    <pems-button tone="danger" size="small" outline="true" type="submit" title="@Localizer["Po_RemoveLine"]"><i class="bi bi-x" aria-hidden="true"></i></pems-button>
                                </form>
                            </td>
                        }
                    </tr>
                    @if (isDraft && canEdit)
                    {
                        <tr>
                            <td></td>
                            <td colspan="6">
                                <form asp-action="UpdateLine" method="post" class="row g-2 align-items-end small">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@l.PurchaseOrderLineId" />
                                    <div class="col-md-2"><label class="form-label">@Localizer["Po_Quantity"]</label><input name="quantity" type="number" step="any" min="0" class="form-control form-control-sm" dir="ltr" value="@l.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div>
                                    <div class="col-md-2"><label class="form-label">@Localizer["Po_UnitPrice"]</label><input name="unitPrice" type="number" step="any" min="0" class="form-control form-control-sm" dir="ltr" value="@l.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div>
                                    <div class="col-md-2"><label class="form-label">@Localizer["Po_RequiredDate"]</label><input name="requiredDate" type="date" class="form-control form-control-sm" dir="ltr" value="@l.RequiredDate?.ToString("yyyy-MM-dd")" /></div>
                                    <div class="col-md-2"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="isStockLine" value="true" id="stock_@l.PurchaseOrderLineId" checked="@l.IsStockLine" /><label class="form-check-label" for="stock_@l.PurchaseOrderLineId">@Localizer["Po_StockLine"]</label></div></div>
                                    <div class="col-md-2"><label class="form-label">@Localizer["Rcv_DeliveryWarehouse"]</label>
                                        <select name="warehouseId" class="form-select form-select-sm"><option value="">—</option>@foreach (var w in warehouses) { <option value="@w.WarehouseId" selected="@(w.WarehouseId == l.WarehouseId)">@w.Code</option> }</select></div>
                                    @if (!l.IsCatalogued)
                                    {
                                        <div class="col-md-2"><label class="form-label">@Localizer["Po_CommodityGroup"]</label>
                                            <select name="commodityGroupId" class="form-select form-select-sm"><option value="">—</option>@foreach (var g in groups ?? Array.Empty<(int, string, string)>()) { <option value="@g.Id" selected="@(g.Id == l.CommodityGroupId)">@g.Code - @g.Description</option> }</select></div>
                                        <div class="col-md-2"><label class="form-label">@Localizer["Po_FreeTextReason"]</label><input name="freeTextReason" class="form-control form-control-sm" value="@l.FreeTextReason" /></div>
                                    }
                                    <div class="col-md-auto"><pems-button tone="neutral" size="small" outline="true" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> @Localizer["Po_SaveLine"]</pems-button></div>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
                <tfoot><tr><th colspan="4" class="text-end">@Localizer["Po_Total"]</th><th class="text-end" dir="ltr">@a.Total.ToString("N2") @a.Currency</th><th colspan="2"></th></tr></tfoot>
            </table>
        </div>
        }

        @if (isDraft && canEdit && requisitions?.Count > 0)
        {
            <form asp-action="AddLinesFromRequisition" method="post" class="d-flex flex-wrap gap-2 align-items-end small mt-2">
                <input type="hidden" name="id" value="@Model.PoId" />
                <div><label class="form-label" for="poAddMr">@Localizer["Po_AddFromMr"]</label>
                    <select id="poAddMr" name="mrId" class="form-select form-select-sm">@foreach (var m in requisitions.Where(m => m.ProjectId == Model.ProjectId)) { <option value="@m.Id">@m.Number - @m.Description</option> }</select></div>
                <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-plus" aria-hidden="true"></i> @Localizer["Po_AddLines"]</pems-button>
            </form>
        }
    </div>

    <div class="content-card mt-3">
        <h6 class="mb-2"><i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["Po_Approval"]</h6>
        <pems-info-grid layout="rows" class="small mb-2">
            @if (a.SubmittedAt.HasValue) { <pems-info-item label="@Localizer["Po_Submitted"]"><span dir="ltr">@a.SubmittedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> @a.SubmittedBy</pems-info-item> }
            @if (a.ApproverRole != null) { <pems-info-item label="@Localizer["Po_ApproverRole"]"><span dir="ltr">@a.ApproverRole</span> (@Localizer["Po_Level"] @a.AuthorityRuleLevel)</pems-info-item> }
            @if (a.ApprovedAt.HasValue) { <pems-info-item label="@Localizer["Po_ApprovedBy"]"><span dir="ltr">@a.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> @a.ApprovedBy</pems-info-item> }
        </pems-info-grid>
        @if (a.ResponsibleNotSet)
        {
            <pems-alert tone="warning" css="py-2 px-3 small mb-2"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Po_ResponsibleNotSet"]</pems-alert>
            @if (canEdit)
            {
                <form asp-action="RouteAgain" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                    <pems-button tone="primary" size="small" outline="true" type="submit"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @Localizer["Po_RouteAgain"]</pems-button></form>
            }
        }
        @if (isDraft && canEdit && a.Lines.Count > 0)
        {
            <form asp-action="Submit" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                <pems-button tone="none" size="small" css="btn-primary" type="submit"><i class="bi bi-send" aria-hidden="true"></i> @Localizer["Po_Submit"]</pems-button></form>
            <span class="small text-muted ms-2">@Localizer["Po_SubmitHint"]</span>
        }
        @if (isSubmitted && holdsRole)
        {
            @if (isOwnPo)
            {
                <p class="small text-muted mb-0"><i class="bi bi-lock" aria-hidden="true"></i> @Localizer["Po_Err_SoD"]</p>
            }
            else
            {
                <form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                    <pems-button tone="none" size="small" css="btn-primary" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> @Localizer["Po_Approve"]</pems-button></form>
            }
        }
        @if (isSubmitted && (holdsRole || (a.ResponsibleNotSet && canEdit)))
        {
            <form asp-action="Reject" method="post" class="mt-2 d-flex flex-wrap gap-2 align-items-end"><input type="hidden" name="id" value="@Model.PoId" />
                <div class="flex-grow-1"><label class="form-label small" for="poReject">@Localizer["Po_RejectReason"]</label><input id="poReject" name="reason" class="form-control form-control-sm" required /></div>
                <pems-button tone="danger" size="small" outline="true" type="submit"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @Localizer["Po_Reject"]</pems-button></form>
        }
    </div>
}

@if (receivingLines?.Count > 0 && isIssued)
{
    <div class="content-card mt-3">
        <h6 class="mb-2"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> @Localizer["Rcv_Receiving"]</h6>
        <p class="small text-muted">@Localizer["Rcv_ReceivingHelp"]</p>
        <div class="table-responsive">
            <table class="table table-enterprise table-sm align-middle">
                <thead>
                    <tr>
                        <th>#</th><th>@Localizer["Po_Item"]</th><th class="text-end">@Localizer["Rcv_Ordered"]</th><th class="text-end">@Localizer["Rcv_InQc"]</th>
                        <th class="text-end">@Localizer["Accepted"]</th><th class="text-end">@Localizer["Hold"]</th><th class="text-end">@Localizer["Rejected"]</th>
                        <th class="text-end">@Localizer["Rcv_Open"]</th><th>@Localizer["Rcv_Inspection"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in receivingLines)
                {
                    <tr>
                        <td dir="ltr">@r.LineNo</td>
                        <td class="small">@(r.MaterialCode ?? "-") - @r.Description @if (r.WarehouseCode != null) { <span class="text-muted" dir="ltr">(@r.WarehouseCode)</span> }</td>
                        <td class="text-end" dir="ltr">@r.Ordered.ToString("0.###") @r.Unit</td>
                        <td class="text-end" dir="ltr">@r.InQc.ToString("0.###")</td>
                        <td class="text-end" dir="ltr">@r.Accepted.ToString("0.###")</td>
                        <td class="text-end" dir="ltr">@r.OnHold.ToString("0.###")</td>
                        <td class="text-end" dir="ltr">@((r.RejectedReplaced + r.RejectedClosedShort).ToString("0.###"))@if (r.RejectedClosedShort > 0) { <div class="small text-muted">@Localizer["Rcv_Action_CloseShort"]: @r.RejectedClosedShort.ToString("0.###")</div> }</td>
                        <td class="text-end" dir="ltr">@r.Outstanding.ToString("0.###")@if (r.OverReceived > 0) { <div class="small text-danger">@Localizer["Rcv_Over"]: @r.OverReceived.ToString("0.###")</div> }</td>
                        <td class="small">
                            @if (r.InspectionReleasedAt != null)
                            {
                                <span class="text-success">@Localizer["Rcv_Released"]</span> <span class="text-muted">@r.InspectionReleasedBy @r.InspectionReleasedAt?.ToString("yyyy-MM-dd") @r.InspectionTestPlanNumber</span>
                            }
                            else if (canRelease)
                            {
                                <form asp-action="ReleaseInspection" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@r.PurchaseOrderLineId" />
                                    <select name="inspectionTestPlanId" class="form-select form-select-sm"><option value="">@Localizer["Rcv_NoItp"]</option>@foreach (var p in plans) { <option value="@p.InspectionTestPlanId">@p.ITPNumber</option> }</select>
                                    <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Rcv_Release"]</pems-button>
                                </form>
                                @if (r.InspectionRequired) { <div class="text-warning">@Localizer["Rcv_NotReleased"]</div> }
                            }
                            else
                            {
                                <span class="@(r.InspectionRequired ? "text-warning" : "text-muted")">@(r.InspectionRequired ? Localizer["Rcv_NotReleased"].Value : "-")</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
