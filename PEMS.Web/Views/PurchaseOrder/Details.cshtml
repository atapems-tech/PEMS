@model PEMS.Application.DTOs.PurchaseOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-470: lines and approval by the PO authority table
    var a = ViewBag.Approval as PEMS.Application.Interfaces.PoApprovalView;
    var canEdit = ViewBag.CanEdit is true;
    var roles = (ViewBag.UserRoles as IReadOnlyList<string>) ?? Array.Empty<string>();
    var userName = ViewBag.UserName as string;
    var requisitions = ViewBag.Requisitions as IReadOnlyList<(int Id, string Number, string Description, int ProjectId)>;
    var groups = ViewBag.CommodityGroups as IReadOnlyList<(int Id, string Code, string Description)>;
    var isDraft = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Draft;
    var isSubmitted = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Submitted;
    var holdsRole = a?.ApproverRole != null && roles.Contains(a.ApproverRole, StringComparer.OrdinalIgnoreCase);
    var isOwnPo = !string.IsNullOrEmpty(userName) && (string.Equals(userName, a?.CreatedBy, StringComparison.OrdinalIgnoreCase)
                                                      || string.Equals(userName, a?.SubmittedBy, StringComparison.OrdinalIgnoreCase));
    // SCRUM-473: delivery warehouse, receiving and inspection release
    var receivingLines = ViewBag.Receiving as IReadOnlyList<PEMS.Application.Interfaces.PoLineReceivingView>;
    var warehouses = (IEnumerable<dynamic>)(ViewBag.Warehouses ?? Array.Empty<object>());
    var plans = (IEnumerable<dynamic>)(ViewBag.InspectionPlans ?? Array.Empty<object>());
    var canRelease = ViewBag.CanReleaseInspection == true;
    var isIssued = a?.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Issued || Model.Status == PEMS.Domain.Entities.PurchaseOrderStatuses.Issued;
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<pems-content-card>
    <pems-info-grid>
        <pems-info-item label="@Localizer["PO Number"]" num>@Model.PoNumber</pems-info-item>
        <pems-info-item label="@Localizer["Project"]">@Model.ProjectName</pems-info-item>
        <pems-info-item label="@Localizer["Vendor"]">@Model.VendorName</pems-info-item>
        <pems-info-item label="@Localizer["Contract No"]" num>@Model.ContractNo</pems-info-item>
        <pems-info-item label="@Localizer["Value"]" num>@Model.Value?.ToString("N0") @a?.Currency</pems-info-item>
        <pems-info-item label="@Localizer["Status"]"><pems-badge tone="info">@Localizer["Po_Status_" + Model.Status]</pems-badge></pems-info-item>
        @if (a?.MaterialRequisitionId != null)
        {
            <pems-info-item label="MR" num><a href="/MaterialRequisition/Details/@a.MaterialRequisitionId">@a.MaterialRequisitionNumber</a></pems-info-item>
        }
        <pems-info-item label="@Localizer["Description"]" wide>@Model.Description</pems-info-item>
    </pems-info-grid>
    @if (ViewBag.CanIssue == true)
    {
        <pems-form asp-action="Issue" asp-route-id="@Model.PoId" method="post" class="mt-3">
            <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-send-check" /> @Localizer["Issue Purchase Order"]</pems-button>
        </pems-form>
    }
</pems-content-card>

@if (a != null)
{
    <pems-content-card css="mt-3">
        <h6 class="mb-2"><pems-icon name="bi-list-ol" aria-hidden="true" /> @Localizer["Po_Lines"]</h6>
        @if (!string.IsNullOrEmpty(a.RejectionReason) && isDraft)
        {
            <pems-alert tone="warning" css="py-2 px-3 small"><strong>@Localizer["Po_RejectedBecause"]:</strong> @a.RejectionReason</pems-alert>
        }
        @if (a.Lines.Count == 0)
        {
            <p class="small text-muted">@Localizer["Po_NoLines"]</p>
        }
        else
        {
        <pems-table-scroll>
            <pems-table kind="enterprise" scale="small" css="align-middle">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Po_Item"]</pems-table-header><pems-table-header class="text-end">@Localizer["Po_Quantity"]</pems-table-header><pems-table-header class="text-end">@Localizer["Po_UnitPrice"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Po_Amount"]</pems-table-header><pems-table-header>@Localizer["Po_Supply"]</pems-table-header>@if (isDraft && canEdit) { <pems-table-header></pems-table-header> }
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var l in a.Lines)
                {
                    <pems-table-row>
                        <pems-table-cell dir="ltr">@l.LineNo</pems-table-cell>
                        <pems-table-cell class="small">
                            @if (l.PartNumber != null) { <span dir="ltr">@l.PartNumber</span><text> - </text> }@l.Description
                            <span class="vs-pill @(l.IsCatalogued ? "vs-pill--success" : "vs-pill--warning") ms-1">@Localizer[l.IsCatalogued ? "Mr_PartCatalogued" : "Mr_PartNotCatalogued"]</span>
                            @if (l.TenderId.HasValue) { <a class="ms-1 small" href="/Tender/Details/@l.TenderId">@Localizer["Po_FromAward"]</a> }
                            @if (!l.IsCatalogued && l.CommodityGroup != null) { <div class="text-muted">@l.CommodityGroup — @l.FreeTextReason</div> }
                        </pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@l.Quantity.ToString("0.###") @l.Unit</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@l.UnitPrice.ToString("N2")</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@l.LineAmount.ToString("N2")</pems-table-cell>
                        <pems-table-cell class="small">@Localizer[l.IsStockLine ? "Po_StockLine" : "Po_DirectLine"]@if (l.WarehouseCode != null) { <div class="text-muted" dir="ltr">@l.WarehouseCode</div> }</pems-table-cell>
                        @if (isDraft && canEdit)
                        {
                            <pems-table-cell class="text-end text-nowrap">
                                <pems-form asp-action="RemoveLine" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@l.PurchaseOrderLineId" />
                                    <pems-button tone="danger" size="small" outline="true" type="submit" title="@Localizer["Po_RemoveLine"]"><pems-icon name="bi-x" aria-hidden="true" /></pems-button>
                                </pems-form>
                            </pems-table-cell>
                        }
                    </pems-table-row>
                    @if (isDraft && canEdit)
                    {
                        <pems-table-row>
                            <pems-table-cell></pems-table-cell>
                            <pems-table-cell colspan="6">
                                <pems-form asp-action="UpdateLine" method="post"><pems-row gap="2" css="align-items-end small">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@l.PurchaseOrderLineId" />
                                    <pems-col md="2"><pems-label>@Localizer["Po_Quantity"]</pems-label><pems-input scale="small" name="quantity" type="number" step="any" min="0" dir="ltr" value="@l.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></pems-col>
                                    <pems-col md="2"><pems-label>@Localizer["Po_UnitPrice"]</pems-label><pems-input scale="small" name="unitPrice" type="number" step="any" min="0" dir="ltr" value="@l.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></pems-col>
                                    <pems-col md="2"><pems-label>@Localizer["Po_RequiredDate"]</pems-label><pems-date name="requiredDate" dir="ltr" value="@l.RequiredDate?.ToString("yyyy-MM-dd")" scale="small" /></pems-col>
                                    <pems-col md="2"><pems-check-row css="mt-4"><pems-input type="checkbox" name="isStockLine" value="true" id="stock_@l.PurchaseOrderLineId" checked="@l.IsStockLine" kind="check" /><label class="form-check-label" for="stock_@l.PurchaseOrderLineId">@Localizer["Po_StockLine"]</label></pems-check-row></pems-col>
                                    <pems-col md="2"><pems-label>@Localizer["Rcv_DeliveryWarehouse"]</pems-label>
                                        <pems-select scale="small" name="warehouseId"><option value="">—</option>@foreach (var w in warehouses) { <option value="@w.WarehouseId" selected="@(w.WarehouseId == l.WarehouseId)">@w.Code</option> }</pems-select></pems-col>
                                    @if (!l.IsCatalogued)
                                    {
                                        <pems-col md="2"><pems-label>@Localizer["Po_CommodityGroup"]</pems-label>
                                            <pems-select scale="small" name="commodityGroupId"><option value="">—</option>@foreach (var g in groups ?? Array.Empty<(int, string, string)>()) { <option value="@g.Id" selected="@(g.Id == l.CommodityGroupId)">@g.Code - @g.Description</option> }</pems-select></pems-col>
                                        <pems-col md="2"><pems-label>@Localizer["Po_FreeTextReason"]</pems-label><pems-input scale="small" name="freeTextReason" value="@l.FreeTextReason" /></pems-col>
                                    }
                                    <pems-col md="auto"><pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-check2" aria-hidden="true" /> @Localizer["Po_SaveLine"]</pems-button></pems-col>
                                </pems-row></pems-form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                }
                </pems-table-body>
                <pems-table-foot><pems-table-row><pems-table-header colspan="4" class="text-end">@Localizer["Po_Total"]</pems-table-header><pems-table-header class="text-end" dir="ltr">@a.Total.ToString("N2") @a.Currency</pems-table-header><pems-table-header colspan="2"></pems-table-header></pems-table-row></pems-table-foot>
            </pems-table>
        </pems-table-scroll>
        }

        @if (isDraft && canEdit && requisitions?.Count > 0)
        {
            <pems-form class="small mt-2" asp-action="AddLinesFromRequisition" method="post"><pems-flex wrap="true" gap="2" align="end">
                <input type="hidden" name="id" value="@Model.PoId" />
                <div><pems-label for="poAddMr">@Localizer["Po_AddFromMr"]</pems-label>
                    <pems-select scale="small" id="poAddMr" name="mrId">@foreach (var m in requisitions.Where(m => m.ProjectId == Model.ProjectId)) { <option value="@m.Id">@m.Number - @m.Description</option> }</pems-select></div>
                <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-plus" aria-hidden="true" /> @Localizer["Po_AddLines"]</pems-button>
            </pems-flex></pems-form>
        }
    </pems-content-card>

    <pems-content-card css="mt-3">
        <h6 class="mb-2"><pems-icon name="bi-shield-check" aria-hidden="true" /> @Localizer["Po_Approval"]</h6>
        <pems-info-grid layout="rows" class="small mb-2">
            @if (a.SubmittedAt.HasValue) { <pems-info-item label="@Localizer["Po_Submitted"]"><span dir="ltr">@a.SubmittedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> @a.SubmittedBy</pems-info-item> }
            @if (a.ApproverRole != null) { <pems-info-item label="@Localizer["Po_ApproverRole"]"><span dir="ltr">@a.ApproverRole</span> (@Localizer["Po_Level"] @a.AuthorityRuleLevel)</pems-info-item> }
            @if (a.ApprovedAt.HasValue) { <pems-info-item label="@Localizer["Po_ApprovedBy"]"><span dir="ltr">@a.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> @a.ApprovedBy</pems-info-item> }
        </pems-info-grid>
        @if (a.ResponsibleNotSet)
        {
            <pems-alert tone="warning" css="py-2 px-3 small mb-2"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Po_ResponsibleNotSet"]</pems-alert>
            @if (canEdit)
            {
                <pems-form asp-action="RouteAgain" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                    <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-arrow-repeat" aria-hidden="true" /> @Localizer["Po_RouteAgain"]</pems-button></pems-form>
            }
        }
        @if (isDraft && canEdit && a.Lines.Count > 0)
        {
            <pems-form asp-action="Submit" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                <pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-send" aria-hidden="true" /> @Localizer["Po_Submit"]</pems-button></pems-form>
            <span class="small text-muted ms-2">@Localizer["Po_SubmitHint"]</span>
        }
        @if (isSubmitted && holdsRole)
        {
            @if (isOwnPo)
            {
                <p class="small text-muted mb-0"><pems-icon name="bi-lock" aria-hidden="true" /> @Localizer["Po_Err_SoD"]</p>
            }
            else
            {
                <pems-form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.PoId" />
                    <pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-check2-circle" aria-hidden="true" /> @Localizer["Po_Approve"]</pems-button></pems-form>
            }
        }
        @if (isSubmitted && (holdsRole || (a.ResponsibleNotSet && canEdit)))
        {
            <pems-form class="mt-2" asp-action="Reject" method="post"><pems-flex wrap="true" gap="2" align="end"><input type="hidden" name="id" value="@Model.PoId" />
                <div class="flex-grow-1"><pems-label css="small" for="poReject">@Localizer["Po_RejectReason"]</pems-label><pems-input scale="small" id="poReject" name="reason" required /></div>
                <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-arrow-counterclockwise" aria-hidden="true" /> @Localizer["Po_Reject"]</pems-button></pems-flex></pems-form>
        }
    </pems-content-card>
}

@if (receivingLines?.Count > 0 && isIssued)
{
    <pems-content-card css="mt-3">
        <h6 class="mb-2"><pems-icon name="bi-box-arrow-in-down" aria-hidden="true" /> @Localizer["Rcv_Receiving"]</h6>
        <p class="small text-muted">@Localizer["Rcv_ReceivingHelp"]</p>
        <pems-table-scroll>
            <pems-table kind="enterprise" scale="small" css="align-middle">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Po_Item"]</pems-table-header><pems-table-header class="text-end">@Localizer["Rcv_Ordered"]</pems-table-header><pems-table-header class="text-end">@Localizer["Rcv_InQc"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Accepted"]</pems-table-header><pems-table-header class="text-end">@Localizer["Hold"]</pems-table-header><pems-table-header class="text-end">@Localizer["Rejected"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Rcv_Open"]</pems-table-header><pems-table-header>@Localizer["Rcv_Inspection"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var r in receivingLines)
                {
                    <pems-table-row>
                        <pems-table-cell dir="ltr">@r.LineNo</pems-table-cell>
                        <pems-table-cell class="small">@(r.MaterialCode ?? "-") - @r.Description @if (r.WarehouseCode != null) { <span class="text-muted" dir="ltr">(@r.WarehouseCode)</span> }</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@r.Ordered.ToString("0.###") @r.Unit</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@r.InQc.ToString("0.###")</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@r.Accepted.ToString("0.###")</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@r.OnHold.ToString("0.###")</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@((r.RejectedReplaced + r.RejectedClosedShort).ToString("0.###"))@if (r.RejectedClosedShort > 0) { <div class="small text-muted">@Localizer["Rcv_Action_CloseShort"]: @r.RejectedClosedShort.ToString("0.###")</div> }</pems-table-cell>
                        <pems-table-cell class="text-end" dir="ltr">@r.Outstanding.ToString("0.###")@if (r.OverReceived > 0) { <div class="small text-danger">@Localizer["Rcv_Over"]: @r.OverReceived.ToString("0.###")</div> }</pems-table-cell>
                        <pems-table-cell class="small">
                            @if (r.InspectionReleasedAt != null)
                            {
                                <span class="text-success">@Localizer["Rcv_Released"]</span> <span class="text-muted">@r.InspectionReleasedBy @r.InspectionReleasedAt?.ToString("yyyy-MM-dd") @r.InspectionTestPlanNumber</span>
                            }
                            else if (canRelease)
                            {
                                <pems-form asp-action="ReleaseInspection" method="post"><pems-flex gap="1">
                                    <input type="hidden" name="id" value="@Model.PoId" /><input type="hidden" name="lineId" value="@r.PurchaseOrderLineId" />
                                    <pems-select scale="small" name="inspectionTestPlanId"><option value="">@Localizer["Rcv_NoItp"]</option>@foreach (var p in plans) { <option value="@p.InspectionTestPlanId">@p.ITPNumber</option> }</pems-select>
                                    <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Rcv_Release"]</pems-button>
                                </pems-flex></pems-form>
                                @if (r.InspectionRequired) { <div class="text-warning">@Localizer["Rcv_NotReleased"]</div> }
                            }
                            else
                            {
                                <span class="@(r.InspectionRequired ? "text-warning" : "text-muted")">@(r.InspectionRequired ? Localizer["Rcv_NotReleased"].Value : "-")</span>
                            }
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    </pems-content-card>
}
