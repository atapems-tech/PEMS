@model PEMS.Application.DTOs.PurchaseOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="row g-3">
        <div class="col-md-4"><strong>@Localizer["PO Number"]:</strong> @Model.PoNumber</div>
        <div class="col-md-4"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-4"><strong>@Localizer["Vendor"]:</strong> @Model.VendorName</div>
        <div class="col-md-4"><strong>@Localizer["Contract No"]:</strong> @(Model.ContractNo ?? "-")</div>
        <div class="col-md-4"><strong>@Localizer["Value"]:</strong> @Model.Value?.ToString("N0")</div>
        <div class="col-md-4"><strong>@Localizer["Status"]:</strong> <span class="badge bg-info text-dark">@Model.Status</span></div>
        <div class="col-12"><strong>@Localizer["Description"]:</strong> @Model.Description</div>
    </div>
    @if (ViewBag.CanIssue == true)
    {
        <form asp-action="Issue" asp-route-id="@Model.PoId" method="post" class="mt-3">
            <button type="submit" class="btn btn-sm btn-pems-solid"><i class="bi bi-send-check"></i> @Localizer["Issue Purchase Order"]</button>
        </form>
    }
</div>
