@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var contracts = (IEnumerable<dynamic>)ViewBag.Contracts;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "PurchaseOrder", name = "poNumber", label = Localizer["PO Number"].Value })</div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project"]</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Vendor"]</label>
                <select name="vendorId" class="form-select" required>
                    @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Contract No"]</label>
                <select name="contractId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var c in contracts) { <option value="@c.ContractId">@c.ContractNo</option> }
                </select>
            </div>
            <div class="col-md-6"><label class="form-label">@Localizer["Value"]</label><input type="number" step="0.01" name="value" class="form-control" /></div>
            <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
