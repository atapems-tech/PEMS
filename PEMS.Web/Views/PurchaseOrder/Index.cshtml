@model IEnumerable<PEMS.Application.DTOs.PurchaseOrderDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var rows = Model.ToList();
    string StatusText(string? s) => VdrUi.Loc(Localizer, "Po_Status_", s);
    string StatusTone(string? s) => s switch
    {
        "Issued" or "Approved" => "vs-pill--success",
        "Submitted" => "vs-pill--warning",
        "Closed" => "vs-pill--info",
        "Cancelled" => "vs-pill--danger",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns and the New action. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["PoL_Title"]" heading-title="@Localizer["PoL_Hint"]" total="@rows.Count">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="PurchaseOrder" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["PoL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="PurchaseOrder" empty="@(!rows.Any())" empty-text="@Localizer["PoL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="no" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["PoL_No"]</pems-table-header>
                        <pems-table-header data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="300" class="vs-hide-md">@Localizer["PoL_Project"]</pems-table-header>
                        <pems-table-header data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="300">@Localizer["PoL_Vendor"]</pems-table-header>
                        <pems-table-header data-col-key="contract" data-resizable="true" data-min-width="90" data-max-width="200" class="vs-hide-md pems-w-140">@Localizer["PoL_Contract"]</pems-table-header>
                        <pems-table-header data-col-key="value" data-resizable="true" data-min-width="90" data-max-width="180" class="text-end pems-w-130">@Localizer["PoL_Value"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var po in rows)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@po.PoId" class="lp-subject" title="@po.PoNumber">@po.PoNumber</a></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@po.ProjectName</pems-table-cell>
                            <pems-table-cell class="small">@po.VendorName</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@po.ContractNo</span></pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@po.Value?.ToString("N0")</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(po.Status)">@StatusText(po.Status)</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <a asp-action="Details" asp-route-id="@po.PoId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><pems-icon name="bi-eye" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
