@model IEnumerable<PEMS.Application.DTOs.PurchaseOrderDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <a asp-action="Create" class="btn btn-pems-solid btn-sm">@Localizer["New Purchase Order"]</a>
    </div>
    <div class="table-scroll-area">
        <table class="table table-enterprise pems-grid-table">
            <thead>
                <tr>
                    <th>@Localizer["PO Number"]</th>
                    <th>@Localizer["Project"]</th>
                    <th>@Localizer["Vendor"]</th>
                    <th>@Localizer["Contract No"]</th>
                    <th>@Localizer["Value"]</th>
                    <th>@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td>@po.PoNumber</td>
                        <td>@po.ProjectName</td>
                        <td>@po.VendorName</td>
                        <td>@po.ContractNo</td>
                        <td>@po.Value?.ToString("N0")</td>
                        <td><pems-badge tone="info">@po.Status</pems-badge></td>
                        <td><a asp-action="Details" asp-route-id="@po.PoId" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
