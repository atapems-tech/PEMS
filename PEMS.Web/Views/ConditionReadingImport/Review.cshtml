@model PEMS.Application.DTOs.ConditionReadingImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusBadge(string status) => status switch
    {
        "New" => "bg-success",
        "Duplicate" => "bg-warning text-dark",
        "UnresolvedPoint" => "bg-danger",
        "ConflictPoint" => "bg-danger",
        "ValidationError" => "bg-danger",
        _ => "bg-light text-dark"
    };

    string StatusLabel(string status) => status switch
    {
        "New" => Localizer["New record"],
        "Duplicate" => Localizer["Duplicate (already exists)"],
        "UnresolvedPoint" => Localizer["Monitoring point not found"],
        "ConflictPoint" => Localizer["Duplicate point match"],
        "ValidationError" => Localizer["Validation error"],
        _ => status
    };

    var statusFilter = (string?)ViewBag.StatusFilter;
    var filterOptions = new[] { "New", "Duplicate", "UnresolvedPoint", "ConflictPoint", "ValidationError" };
}

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>@Localizer["File:"]</strong> @Model.FileName</div>
        <div class="col-md-2"><strong>@Localizer["Total Rows:"]</strong> @Model.TotalRows</div>
        <div class="col-md-2"><strong>@Localizer["New"]:</strong> @Model.NewCount</div>
        <div class="col-md-2"><strong>@Localizer["Duplicate"]:</strong> @Model.DuplicateCount</div>
        <div class="col-md-1"><strong>@Localizer["Unresolved:"]</strong> @Model.UnresolvedCount</div>
        <div class="col-md-2"><strong>@Localizer["Status:"]</strong> <span class="badge @(Model.Status == "Committed" ? "bg-success" : "bg-secondary")">@Model.Status</span></div>
    </div>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.ConditionReadingImportBatchId" />
                <pems-button tone="primary" type="submit" onclick="return confirm('Commit the approved rows? New Condition Reading records will be created.')">
                    <i class="bi bi-check-circle"></i> @Localizer["Commit Approved Rows"]
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.ConditionReadingImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" onclick="return confirm('Discard this entire import batch?')">
                    <i class="bi bi-trash"></i> @Localizer["Discard Batch"]
                </pems-button>
            </form>
        </div>
    }
</div>

<div class="pems-filter-bar mb-3">
    <span class="pems-filter-label">@Localizer["Filter"]</span>
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-filter-active-count">1</span>
    }
    <a asp-action="Review" asp-route-batchId="@Model.ConditionReadingImportBatchId"
       class="btn btn-sm @(statusFilter == null ? "btn-pems-solid" : "btn-outline-secondary")">@Localizer["All"]</a>
    @foreach (var s in filterOptions)
    {
        <a asp-action="Review" asp-route-batchId="@Model.ConditionReadingImportBatchId" asp-route-status="@s"
           class="btn btn-sm @(statusFilter == s ? "btn-pems-solid" : "btn-outline-secondary")">@StatusLabel(s)</a>
    }
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-command-bar-spacer"></span>
        <a asp-action="Review" asp-route-batchId="@Model.ConditionReadingImportBatchId" class="pems-filter-clear-all">@Localizer["Clear All"]</a>
    }
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Approve"]</th><th>@Localizer["Src Row"]</th><th>@Localizer["Equipment Tag"]</th><th>@Localizer["Point Tag"]</th>
                    <th>@Localizer["Variable"]</th><th>@Localizer["Reading Date"]</th><th>@Localizer["Value"]</th><th>@Localizer["Match Result"]</th><th>@Localizer["Note"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows.Items)
                {
                    <tr>
                        <td>
                            @if (Model.Status == "Staging")
                            {
                                var canToggle = r.Status is "New" or "Duplicate";
                                if (canToggle)
                                {
                                    <form asp-action="ToggleRow" method="post">
                                        <input type="hidden" name="rowId" value="@r.ConditionReadingImportRowId" />
                                        <input type="hidden" name="batchId" value="@Model.ConditionReadingImportBatchId" />
                                        <input type="hidden" name="page" value="@Model.Rows.Page" />
                                        <input type="hidden" name="status" value="@statusFilter" />
                                        <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                        <button type="submit" class="btn btn-sm @(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" style="width:36px;"
                                                title="@(r.IncludeInCommit ? Localizer["Approved - click to exclude"] : Localizer["Excluded - click to approve"])">
                                            <i class="bi @(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">@Localizer["N/A"]</span>
                                }
                            }
                            else
                            {
                                @(r.CommittedConditionReadingId.HasValue ? Localizer["Reading Created"] : (r.IncludeInCommit ? Localizer["Approved"] : Localizer["No"]))
                            }
                        </td>
                        <td>@r.SourceRowNumber</td>
                        <td><strong dir="ltr">@r.EquipmentTag</strong></td>
                        <td class="small" dir="ltr">@r.PointTag</td>
                        <td class="small">@(r.VariableType ?? "-")</td>
                        <td class="small" dir="ltr">@(r.ReadingDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td class="small text-end" dir="ltr">@(r.Value?.ToString() ?? "-")</td>
                        <td><span class="badge @StatusBadge(r.Status)">@StatusLabel(r.Status)</span></td>
                        <td class="small">
                            @if (r.ValidationMessage != null)
                            {
                                <span class="text-muted" style="white-space:normal;">@r.ValidationMessage</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Rows.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["No rows match this filter."]</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty(statusFilter)) qsParts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        qsParts.Add($"batchId={Model.ConditionReadingImportBatchId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Rows.Page,
        TotalPages = Model.Rows.TotalPages,
        TotalCount = Model.Rows.TotalCount,
        PageSize = Model.Rows.PageSize,
        GridKey = "ConditionReadingImport",
        BaseUrl = Url.Action("Review") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>
