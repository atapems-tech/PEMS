@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InspectionListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The page note (what these inspections are, Alert/Overdue first,
   where to record a new one) became the tool tip of the title. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Ins_Title"]" heading-title="@Localizer["Ins_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Inspection" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Inspection" empty="@(!Model.Items.Any())" empty-text="@Localizer["Ins_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Ins_Tag"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Cm_Type"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Cm_Date"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="measurement" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Cm_Measurement"]</pems-table-header>
                        <pems-table-header data-col-key="limits" data-resizable="true" data-min-width="100" data-max-width="200" class="vs-hide-md pems-w-130">@Localizer["Ins_Limits"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="condition" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Cm_Condition"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="nextDue" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Cm_NextDue"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="dueStatus" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Cm_DueStatus"]</pems-table-header>
                        <pems-table-header class="pems-w-190" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var i in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-controller="Equipment" asp-action="Details" asp-route-id="@i.EquipmentId" class="lp-subject" title="@i.TagNumber">@i.TagNumber</a></pems-table-cell>
                            <pems-table-cell class="small">@i.InspectionType</pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@i.InspectionDate.ToString("yyyy-MM-dd")</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@(i.MeasurementValue.HasValue ? $"{i.MeasurementValue.Value:N2} {i.MeasurementUnit}" : "-")</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@(i.LowerLimit.HasValue || i.UpperLimit.HasValue ? $"{i.LowerLimit:N2} - {i.UpperLimit:N2}" : "-")</span></pems-table-cell>
                            <pems-table-cell>
                                @switch (i.ConditionStatus)
                                {
                                    case "Alert": <span class="vs-pill vs-pill--icon vs-pill--danger"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Ins_Alert"]</span> break;
                                    case "Normal": <span class="vs-pill vs-pill--success">@Localizer["Ins_Normal"]</span> break;
                                    default: <span class="text-muted small">@Localizer["Ins_NotApplicable"]</span> break;
                                }
                            </pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@(i.NextInspectionDate?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell>
                                @switch (i.DueStatus)
                                {
                                    case "Overdue": <span class="vs-pill vs-pill--icon vs-pill--danger"><pems-icon name="bi-clock-history" aria-hidden="true" /> @Localizer["Overdue"]</span> break;
                                    case "DueSoon": <span class="vs-pill vs-pill--warning">@Localizer["Ins_DueSoon"]</span> break;
                                    case "OK": <span class="vs-pill vs-pill--success">@Localizer["Ins_Ok"]</span> break;
                                    default: <span class="text-muted small">@Localizer["Ins_NotApplicable"]</span> break;
                                }
                            </pems-table-cell>
                            <pems-table-cell class="text-nowrap text-end">
                                @if (i.ConditionStatus == "Alert")
                                {
                                    <pems-form asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                        <input type="hidden" name="inspectionRecordId" value="@i.InspectionRecordId" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Cm_RaiseWr"]</pems-button>
                                    </pems-form>
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Inspection",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
