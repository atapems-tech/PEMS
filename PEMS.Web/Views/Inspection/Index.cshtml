@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InspectionListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 - CMMS-07: بازرسی‌های دوره‌ای/کمی تجهیزات (Condition Monitoring) -
    جدا از بازرسی‌های پذیرش ITP پیش از راه‌اندازی. موارد Alert/Overdue بالای لیست‌اند.
    برای ثبت بازرسی جدید، از تب «Inspections» در صفحه‌ی هر تجهیز استفاده کنید.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Inspection')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="Inspection">
        <thead>
            <tr>
                <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Tag Number"]</th>
                <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Type"]</th>
                <th data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Date"]</th>
                <th data-col-key="measurement" data-resizable="true" data-min-width="100" data-max-width="200">Measurement</th>
                <th data-col-key="limits" data-resizable="true" data-min-width="100" data-max-width="200">Limits</th>
                <th data-col-key="condition" data-resizable="true" data-min-width="80" data-max-width="140">Condition</th>
                <th data-col-key="nextDue" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Next Due"]</th>
                <th data-col-key="dueStatus" data-resizable="true" data-min-width="90" data-max-width="160">Due Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td class="small fw-bold"><a asp-controller="Equipment" asp-action="Details" asp-route-id="@i.EquipmentId">@i.TagNumber</a></td>
                    <td class="small">@i.InspectionType</td>
                    <td class="small">@i.InspectionDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@(i.MeasurementValue.HasValue ? $"{i.MeasurementValue.Value:N2} {i.MeasurementUnit}" : "-")</td>
                    <td class="small">@(i.LowerLimit.HasValue || i.UpperLimit.HasValue ? $"{i.LowerLimit:N2} - {i.UpperLimit:N2}" : "-")</td>
                    <td class="small">
                        @switch (i.ConditionStatus)
                        {
                            case "Alert": <span class="badge bg-danger">@Localizer["Alert"]</span> break;
                            case "Normal": <span class="badge bg-success">@Localizer["Normal"]</span> break;
                            default: <span class="text-muted">N/A</span> break;
                        }
                    </td>
                    <td class="small">@(i.NextInspectionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td class="small">
                        @switch (i.DueStatus)
                        {
                            case "Overdue": <span class="badge bg-danger">@Localizer["Overdue"]</span> break;
                            case "DueSoon": <span class="badge bg-warning text-dark">@Localizer["Due Soon"]</span> break;
                            case "OK": <span class="badge bg-success">OK</span> break;
                            default: <span class="text-muted">N/A</span> break;
                        }
                    </td>
                    <td>
                        @if (i.ConditionStatus == "Alert")
                        {
                            <form asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                <input type="hidden" name="inspectionRecordId" value="@i.InspectionRecordId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-exclamation-triangle"></i> Raise Work Request</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هنوز هیچ بازرسی‌ای ثبت نشده."]</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Inspection",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Inspection');
        });
    </script>
}
