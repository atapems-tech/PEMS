@model PEMS.Application.DTOs.MyApprovalsPageDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var summary = Model.Summary;
    int unread = ViewBag.UnreadNotifications is int u ? u : 0;
    int openItems = ViewBag.OpenActionItems is int o ? o : 0;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string StageLabel(PEMS.Application.DTOs.MyApprovalItemDto t)
    {
        if (!isFa) return t.StageName;
        if (!string.IsNullOrWhiteSpace(t.StageNameFa)) return t.StageNameFa!;
        var l = Localizer[WorkflowStageLabels.ResourceKey(t.StageName)];
        return l.ResourceNotFound ? t.StageName : l.Value;
    }
    string ModuleLabel(string m) { var l = Localizer["MyWork_Module_" + m]; return l.ResourceNotFound ? m : l.Value; }

    var personalValue = Model.PersonalOnly ? "true" : null;
    var overdueValue = Model.OverdueOnly ? "true" : null;
    var filterCount = (Model.Module == null ? 0 : 1) + (Model.PersonalOnly ? 1 : 0) + (Model.OverdueOnly ? 1 : 0);
    var pages = Model.Page.PageSize == 0 ? 1 : (int)Math.Ceiling(Model.Page.TotalCount / (double)Model.Page.PageSize);
    var qsParts = new List<string>();
    if (Model.Module != null) qsParts.Add($"module={Uri.EscapeDataString(Model.Module)}");
    if (Model.OverdueOnly) qsParts.Add("overdueOnly=true");
    if (Model.PersonalOnly) qsParts.Add("personalOnly=true");
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the chip row became the module / personal / overdue filters (the counts stay as KPI chips), the hint the heading tooltip, the page-number row the shared pager. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (summary.Total > 0 && summary.WithSla == 0)
    {
        <pems-alert tone="info" css="py-2 px-3 small"><pems-icon name="bi-info-circle" aria-hidden="true" /> @Localizer["MyWork_NoSla"]</pems-alert>
    }

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["MyWork_Approvals"]" heading-title="@Localizer["MyWork_Hint"]" total="@Model.Page.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="mwFilter" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="mwModule" name="module" label="@Localizer["MyWork_Module"]" value="@Model.Module"
                                             all-text="@Localizer["MyWork_All"]" items="@summary.ByModule.Select(kv => new SelectListItem(ModuleLabel(kv.Key), kv.Key))" />
                    <pems-list-filter-select id="mwPersonal" name="personalOnly" label="@Localizer["MyWork_Personal"]" value="@personalValue"
                                             all-text="@Localizer["MyWork_All"]" items="@(new[] { new SelectListItem(Localizer["MyWork_Personal"].Value, "true") })" />
                    <pems-list-filter-select id="mwOverdue" name="overdueOnly" label="@Localizer["MyWork_Overdue"]" value="@overdueValue"
                                             all-text="@Localizer["MyWork_All"]" items="@(new[] { new SelectListItem(Localizer["MyWork_Overdue"].Value, "true") })" />
                </pems-list-filters>
                <pems-list-kpi-toggle target="mwKpis" storage-key="pems.mywork.kpis" />
                <pems-list-reset-columns grid-key="MyWork" />
                <pems-list-menu id="mwMoreBtn" icon="bi-three-dots" label="@Localizer["Lp_More"]">
                    <li><a class="dropdown-item" asp-controller="Notification" asp-action="Index"><pems-icon name="bi-bell" aria-hidden="true" /> @Localizer["MyWork_Notifications"] (@unread)</a></li>
                    <li><a class="dropdown-item" asp-controller="Task" asp-action="Index"><pems-icon name="bi-check2-square" aria-hidden="true" /> @Localizer["MyWork_ActionItems"] (@openItems)</a></li>
                </pems-list-menu>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="mwKpis">
            <span class="vs-chip">@Localizer["MyWork_All"] <strong>@summary.Total</strong></span>
            <span class="vs-chip">@Localizer["MyWork_Personal"] <strong>@summary.Personal</strong></span>
            @if (summary.WithSla > 0 || Model.OverdueOnly)
            {
                <span class="vs-chip @(summary.Overdue > 0 ? "vs-chip--danger" : "")">@Localizer["MyWork_Overdue"] <strong>@summary.Overdue</strong></span>
            }
            @foreach (var kv in summary.ByModule)
            {
                <span class="vs-chip">@ModuleLabel(kv.Key) <strong>@kv.Value</strong></span>
            }
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (Model.Module != null) { <pems-list-chip label="@Localizer["MyWork_Module"]" value="@ModuleLabel(Model.Module)" remove-href="@Url.Action("Index", new { personalOnly = personalValue, overdueOnly = overdueValue })" /> }
            @if (Model.PersonalOnly) { <pems-list-chip label="@Localizer["MyWork_Personal"]" value="@Localizer["MyWork_Personal"]" remove-href="@Url.Action("Index", new { module = Model.Module, overdueOnly = overdueValue })" /> }
            @if (Model.OverdueOnly) { <pems-list-chip label="@Localizer["MyWork_Overdue"]" value="@Localizer["MyWork_Overdue"]" remove-href="@Url.Action("Index", new { module = Model.Module, personalOnly = personalValue })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="MyWork" empty="@(!Model.Page.Items.Any())" empty-text="@Localizer["MyWork_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["MyWork_Module"]</pems-table-header>
                        <pems-table-header>@Localizer["MyWork_Stage"]</pems-table-header>
                        <pems-table-header>@Localizer["MyWork_Record"]</pems-table-header>
                        <pems-table-header>@Localizer["MyWork_Assigned"]</pems-table-header>
                        <pems-table-header>@Localizer["MyWork_Due"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var t in Model.Page.Items)
                {
                    var path = WorkflowTaskLinks.TryGetPath(t.Module, t.BusinessObjectType, t.BusinessObjectId);
                    <pems-table-row class="lp-row">
                        <pems-table-cell>@ModuleLabel(t.Module)</pems-table-cell>
                        <pems-table-cell>@StageLabel(t)
                            @if (t.IsPersonal) { <span class="vs-pill vs-pill--warning ms-1">@Localizer["MyWork_Personal"]</span> }
                            else { <span class="vs-pill vs-pill--neutral ms-1">@Localizer["MyWork_Queue"]</span> }
                        </pems-table-cell>
                        <pems-table-cell>
                            @if (path != null) { <a href="@path">#@t.BusinessObjectId <pems-icon name="bi-box-arrow-up-right" css="small" aria-hidden="true" /><span class="visually-hidden">@Localizer["MyWork_Open"]</span></a> }
                            else { <span>#@t.BusinessObjectId</span> }
                        </pems-table-cell>
                        <pems-table-cell dir="ltr" class="text-nowrap">@t.AssignedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        <pems-table-cell dir="ltr" class="text-nowrap">
                            @if (t.DueDate.HasValue)
                            {
                                <span class="@(t.IsOverdue ? "text-danger fw-semibold" : "")">@t.DueDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                @if (t.IsOverdue) { <span class="vs-pill vs-pill--danger ms-1">@Localizer["MyWork_Overdue"]</span> }
                            }
                            else { <span class="text-muted">—</span> }
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page.Page,
                    TotalPages = pages,
                    TotalCount = Model.Page.TotalCount,
                    PageSize = Model.Page.PageSize,
                    GridKey = "MyWork",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
