@model PEMS.Application.DTOs.MyApprovalsPageDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var summary = Model.Summary;
    int unread = ViewBag.UnreadNotifications is int u ? u : 0;
    int openItems = ViewBag.OpenActionItems is int o ? o : 0;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string StageLabel(PEMS.Application.DTOs.MyApprovalItemDto t)
    {
        if (!isFa) return t.StageName;
        if (!string.IsNullOrWhiteSpace(t.StageNameFa)) return t.StageNameFa!;
        var l = Localizer[WorkflowStageLabels.ResourceKey(t.StageName)];
        return l.ResourceNotFound ? t.StageName : l.Value;
    }
    string ModuleLabel(string m) { var l = Localizer["MyWork_Module_" + m]; return l.ResourceNotFound ? m : l.Value; }
}

<section class="vs-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0"><i class="bi bi-list-check" aria-hidden="true"></i> @Localizer["MyWork_Approvals"]</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="vs-chip text-decoration-none" asp-controller="Notification" asp-action="Index"><i class="bi bi-bell" aria-hidden="true"></i> @Localizer["MyWork_Notifications"] <strong>@unread</strong></a>
            <a class="vs-chip text-decoration-none" asp-controller="Task" asp-action="Index"><i class="bi bi-check2-square" aria-hidden="true"></i> @Localizer["MyWork_ActionItems"] <strong>@openItems</strong></a>
        </div>
    </div>
    <p class="small text-muted mb-3">@Localizer["MyWork_Hint"]</p>

    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@Localizer["MyWork_Module"]">
        <a class="vs-chip text-decoration-none @(Model.Module == null && !Model.OverdueOnly && !Model.PersonalOnly ? "vs-chip--active" : "")" asp-action="Index">@Localizer["MyWork_All"] <strong>@summary.Total</strong></a>
        <a class="vs-chip text-decoration-none @(Model.PersonalOnly ? "vs-chip--active" : "")" asp-action="Index" asp-route-personalOnly="true">@Localizer["MyWork_Personal"] <strong>@summary.Personal</strong></a>
        @if (summary.WithSla > 0 || Model.OverdueOnly)
        {
            <a class="vs-chip text-decoration-none @(Model.OverdueOnly ? "vs-chip--active" : "") @(summary.Overdue > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-overdueOnly="true">@Localizer["MyWork_Overdue"] <strong>@summary.Overdue</strong></a>
        }
        @foreach (var kv in summary.ByModule)
        {
            <a class="vs-chip text-decoration-none @(string.Equals(Model.Module, kv.Key, StringComparison.OrdinalIgnoreCase) ? "vs-chip--active" : "")" asp-action="Index" asp-route-module="@kv.Key">@ModuleLabel(kv.Key) <strong>@kv.Value</strong></a>
        }
    </div>

    @if (summary.Total > 0 && summary.WithSla == 0)
    {
        <p class="small text-muted mb-2"><i class="bi bi-info-circle" aria-hidden="true"></i> @Localizer["MyWork_NoSla"]</p>
    }

    @if (!Model.Page.Items.Any())
    {
        <div class="vs-empty py-3"><i class="bi bi-inbox" aria-hidden="true"></i> @Localizer["MyWork_Empty"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-enterprise vs-dense mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["MyWork_Module"]</th>
                        <th>@Localizer["MyWork_Stage"]</th>
                        <th>@Localizer["MyWork_Record"]</th>
                        <th>@Localizer["MyWork_Assigned"]</th>
                        <th>@Localizer["MyWork_Due"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Page.Items)
                {
                    var path = WorkflowTaskLinks.TryGetPath(t.Module, t.BusinessObjectType, t.BusinessObjectId);
                    <tr>
                        <td>@ModuleLabel(t.Module)</td>
                        <td>@StageLabel(t)
                            @if (t.IsPersonal) { <span class="vs-pill vs-pill--warning ms-1">@Localizer["MyWork_Personal"]</span> }
                            else { <span class="vs-pill vs-pill--neutral ms-1">@Localizer["MyWork_Queue"]</span> }
                        </td>
                        <td>
                            @if (path != null) { <a href="@path">#@t.BusinessObjectId <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i><span class="visually-hidden">@Localizer["MyWork_Open"]</span></a> }
                            else { <span>#@t.BusinessObjectId</span> }
                        </td>
                        <td dir="ltr" class="text-nowrap">@t.AssignedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td dir="ltr" class="text-nowrap">
                            @if (t.DueDate.HasValue)
                            {
                                <span class="@(t.IsOverdue ? "text-danger fw-semibold" : "")">@t.DueDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                @if (t.IsOverdue) { <span class="vs-pill vs-pill--danger ms-1">@Localizer["MyWork_Overdue"]</span> }
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        var pages = (int)Math.Ceiling(Model.Page.TotalCount / (double)Model.Page.PageSize);
        if (pages > 1)
        {
            <nav class="mt-3" aria-label="pagination">
                <ul class="pagination pagination-sm mb-0">
                    @for (var p = Math.Max(1, Model.Page.Page - 3); p <= Math.Min(pages, Model.Page.Page + 3); p++)
                    {
                        <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.Page.PageSize" asp-route-module="@Model.Module" asp-route-overdueOnly="@Model.OverdueOnly" asp-route-personalOnly="@Model.PersonalOnly">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</section>
