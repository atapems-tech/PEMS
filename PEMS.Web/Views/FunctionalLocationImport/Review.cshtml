@model PEMS.Application.DTOs.FunctionalLocationImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusBadge(string status) => status switch
    {
        "New" => "bg-success",
        "Existing" => "bg-secondary",
        "Conflict" => "bg-warning text-dark",
        "Invalid" => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3"><strong>@Localizer["File:"]</strong> @Model.FileName</pems-col>
        <pems-col md="2"><strong>Source Rows:</strong> @Model.SourceRowCount</pems-col>
        <pems-col md="2"><strong>Expanded:</strong> @Model.ExpandedLocationCount</pems-col>
        <pems-col md="2"><strong>New / Existing:</strong> @Model.NewCount / @Model.ExistingCount</pems-col>
        <pems-col md="1"><strong>Conflicts:</strong> @Model.ConflictCount</pems-col>
        <pems-col md="2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></pems-col>
    </pems-row>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.FunctionalLocationImportBatchId" />
                <pems-button tone="primary" type="submit" data-pems-confirm="Commit the selected rows into the live Functional Locations register?">
                    <pems-icon name="bi-check-circle" /> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.FunctionalLocationImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" data-pems-confirm="Discard this entire import batch?">
                    <pems-icon name="bi-trash" /> Discard Batch
                </pems-button>
            </form>
        </div>
    }
</pems-content-card>

<pems-content-card>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["Include"]</pems-table-header><pems-table-header>@Localizer["Src Row"]</pems-table-header><pems-table-header>@Localizer["Code"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>Parent / Area</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header><pems-table-header>@Localizer["Note"]</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var r in Model.Rows)
                {
                    <pems-table-row>
                        <pems-table-cell>
                            @if (Model.Status == "Staging")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.FunctionalLocationImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.FunctionalLocationImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <pems-button class="pems-w-36" tone="none" size="small" css="@(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" type="submit">
                                        <pems-icon css="@(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")" />
                                    </pems-button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </pems-table-cell>
                        <pems-table-cell>@r.SourceRowNumber</pems-table-cell>
                        <pems-table-cell><strong>@r.Code</strong>@if (r.Payload?.IsAreaParentRow == true) { <pems-badge tone="light" css="ms-1">Area parent</pems-badge> }</pems-table-cell>
                        <pems-table-cell class="small">@r.Name</pems-table-cell>
                        <pems-table-cell class="small">@(r.ParentAreaName ?? r.Name)</pems-table-cell>
                        <pems-table-cell><pems-badge tone="none" css="@StatusBadge(r.Status)">@r.Status</pems-badge></pems-table-cell>
                        <pems-table-cell class="small">@r.Action</pems-table-cell>
                        <pems-table-cell class="small">
                            @if (r.ValidationMessage != null)
                            {
                                <span class="text-muted pems-s-f8f979be">@r.ValidationMessage</span>
                            }
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    </pems-table-scroll>
    @if (!Model.Rows.Any()) { <p class="text-muted text-center py-4">No Functional Location rows recognized in this file.</p> }
</pems-content-card>
