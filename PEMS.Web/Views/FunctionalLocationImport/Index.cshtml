@model List<PEMS.Application.DTOs.FunctionalLocationImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-controller="FunctionalLocation" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Functional Locations</a>
</div>

<div class="content-card mb-3">
    <p class="text-muted small">
        Upload an Excel file with <strong>AREA NAME</strong> / <strong>AREA CODE</strong> columns.
        A cell with multiple comma-separated codes (e.g. "85A07, 85A08, 85A10, 85A12") is
        automatically expanded into separate Functional Location records, grouped under an
        Area-level parent node. Nothing is written to the live Functional Locations table until
        you review the parsed rows and click Commit.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small">Functional Location Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-pems-solid w-100"><i class="bi bi-cloud-upload"></i> @Localizer["Upload"]</button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["File"]</th><th>@Localizer["Date"]</th><th>@Localizer["Imported By"]</th><th class="text-end">Source Rows</th><th class="text-end">Expanded</th><th class="text-end">@Localizer["New"]</th><th class="text-end">Existing</th><th class="text-end">@Localizer["Conflicts"]</th><th class="text-end">@Localizer["Invalid"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@b.ImportedByName</td>
                    <td class="text-end">@b.SourceRowCount</td>
                    <td class="text-end">@b.ExpandedLocationCount</td>
                    <td class="text-end"><pems-badge tone="success">@b.NewCount</pems-badge></td>
                    <td class="text-end"><pems-badge tone="neutral">@b.ExistingCount</pems-badge></td>
                    <td class="text-end">@if (b.ConflictCount > 0) { <pems-badge tone="warning">@b.ConflictCount</pems-badge> } else { @b.ConflictCount }</td>
                    <td class="text-end">@if (b.InvalidCount > 0) { <pems-badge tone="danger">@b.InvalidCount</pems-badge> } else { @b.InvalidCount }</td>
                    <td><span class="badge @(b.Status == "Committed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                    <td>
                        <a asp-action="Review" asp-route-batchId="@b.FunctionalLocationImportBatchId" class="btn btn-sm btn-outline-primary">Review</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No Functional Location imports yet.</p> }
</div>
