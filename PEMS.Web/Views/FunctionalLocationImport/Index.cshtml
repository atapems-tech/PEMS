@model List<PEMS.Application.DTOs.FunctionalLocationImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="FunctionalLocation" asp-action="Index">← Functional Locations</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <p class="text-muted small">
        Upload an Excel file with <strong>AREA NAME</strong> / <strong>AREA CODE</strong> columns.
        A cell with multiple comma-separated codes (e.g. "85A07, 85A08, 85A10, 85A12") is
        automatically expanded into separate Functional Location records, grouped under an
        Area-level parent node. Nothing is written to the live Functional Locations table until
        you review the parsed rows and click Commit.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="8">
            <pems-label css="small">Functional Location Excel File</pems-label>
            <pems-input type="file" name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="4">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["File"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Imported By"]</pems-table-header><pems-table-header class="text-end">Source Rows</pems-table-header><pems-table-header class="text-end">Expanded</pems-table-header><pems-table-header class="text-end">@Localizer["New"]</pems-table-header><pems-table-header class="text-end">Existing</pems-table-header><pems-table-header class="text-end">@Localizer["Conflicts"]</pems-table-header><pems-table-header class="text-end">@Localizer["Invalid"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var b in Model)
            {
                <pems-table-row>
                    <pems-table-cell>@b.FileName</pems-table-cell>
                    <pems-table-cell>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell class="small">@b.ImportedByName</pems-table-cell>
                    <pems-table-cell class="text-end">@b.SourceRowCount</pems-table-cell>
                    <pems-table-cell class="text-end">@b.ExpandedLocationCount</pems-table-cell>
                    <pems-table-cell class="text-end"><pems-badge tone="success">@b.NewCount</pems-badge></pems-table-cell>
                    <pems-table-cell class="text-end"><pems-badge tone="neutral">@b.ExistingCount</pems-badge></pems-table-cell>
                    <pems-table-cell class="text-end">@if (b.ConflictCount > 0) { <pems-badge tone="warning">@b.ConflictCount</pems-badge> } else { @b.ConflictCount }</pems-table-cell>
                    <pems-table-cell class="text-end">@if (b.InvalidCount > 0) { <pems-badge tone="danger">@b.InvalidCount</pems-badge> } else { @b.InvalidCount }</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(b.Status == "Committed" ? "success" : "neutral")">@b.Status</pems-badge></pems-table-cell>
                    <pems-table-cell>
                        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Review" asp-route-batchId="@b.FunctionalLocationImportBatchId">Review</pems-button>
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No Functional Location imports yet.</p> }
</pems-content-card>
