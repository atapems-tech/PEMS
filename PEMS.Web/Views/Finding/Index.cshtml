@model List<PEMS.Domain.Entities.Finding>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Fn_Title"].Value;
    var equipmentId = (int?)ViewBag.SelectedEquipmentId;
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Open", "Linked", "Closed" };
    var filterCount = (equipmentId.HasValue ? 1 : 0) + (string.IsNullOrEmpty(status) ? 0 : 1);

    string StatusText(string? s) => VdrUi.Loc(Localizer, "Fn_St_", s);
    string StatusTone(string? s) => s == "Open" ? "vs-pill--warning" : s == "Closed" ? "vs-pill--neutral" : "vs-pill--success";
    string ConditionTone(string? c) => c switch
    {
        "Critical" or "Alarm" or "Reject" => "vs-pill--danger",
        "Warning" or "Poor" => "vs-pill--warning",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its filters (equipment id, status) and its
   raise-work-request / close actions. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Fn_Title"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-filters form-id="fnFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="fnFilterEquipment">@Localizer["Fn_EquipmentId"]</label>
                        <input type="number" id="fnFilterEquipment" name="equipmentId" value="@equipmentId" class="form-control form-control-sm" />
                    </div>
                    <div>
                        <label class="lp-lbl" for="fnFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="fnFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                </pems-list-filters>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (equipmentId.HasValue)
            { <pems-list-chip label="@Localizer["Fn_EquipmentId"]" value="@equipmentId.ToString()" remove-href="@Url.Action("Index", new { status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { equipmentId })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table empty="@(!Model.Any())" empty-text="@Localizer["Fn_Empty"]" filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th>@Localizer["Equipment"]</th>
                        <th>@Localizer["Fn_Source"]</th>
                        <th>@Localizer["Cm_Condition"]</th>
                        <th>@Localizer["Cm_Description"]</th>
                        <th class="vs-hide-md">@Localizer["Fn_FailureModeCause"]</th>
                        <th>@Localizer["Ed_Status"]</th>
                        <th>@Localizer["Fn_Observed"]</th>
                        <th><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@(f.Equipment?.TagNumber ?? f.EquipmentId.ToString())</span></td>
                            <td class="small">
                                @if (f.ConditionReadingId.HasValue) { <span class="vs-pill vs-pill--neutral">@Localizer["Fn_CmReading"]</span> }
                                else if (f.InspectionRecordId.HasValue) { <span class="vs-pill vs-pill--neutral">@Localizer["Fn_Inspection"]</span> }
                            </td>
                            <td><span class="vs-pill @ConditionTone(f.Condition)">@f.Condition</span></td>
                            <td><span class="vs-title-cell" title="@f.Description">@f.Description</span></td>
                            <td class="small text-muted vs-hide-md">@(f.FailureMode?.Name) @(f.FailureCause != null ? $"/ {f.FailureCause.Name}" : "")</td>
                            <td>
                                <span class="vs-pill @StatusTone(f.Status)">@StatusText(f.Status)</span>
                                @if (f.WorkRequest != null)
                                { <div class="small text-muted">@Localizer["Fn_WorkRequest"]: <span class="vs-num">@f.WorkRequest.RequestNumber</span></div> }
                            </td>
                            <td class="small"><span class="vs-num">@f.ObservedAt.ToString("yyyy-MM-dd")</span></td>
                            <td class="lp-actions text-nowrap">
                                @if (f.Status == "Open")
                                {
                                    <form asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                        <input type="hidden" name="findingId" value="@f.FindingId" />
                                        <button type="submit" class="lp-act lp-act--always" title="@Localizer["Cm_RaiseWr"]" aria-label="@Localizer["Cm_RaiseWr"]"><i class="bi bi-clipboard-plus" aria-hidden="true"></i></button>
                                    </form>
                                }
                                @if (f.Status != "Closed")
                                {
                                    <form asp-action="Close" method="post" class="d-inline" data-confirm="@Localizer["Fn_CloseConfirm"]" onsubmit="return confirm(this.dataset.confirm)">
                                        <input type="hidden" name="id" value="@f.FindingId" />
                                        <button type="submit" class="lp-act lp-act--always" title="@Localizer["Fn_Close"]" aria-label="@Localizer["Fn_Close"]"><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
