@model List<PEMS.Domain.Entities.Finding>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Findings";
    var failureModes = (List<PEMS.Domain.Entities.FailureMode>)ViewBag.FailureModes;
    var failureCauses = (List<PEMS.Domain.Entities.FailureCause>)ViewBag.FailureCauses;

    string ConditionBadge(string c) => c switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Reject" => "bg-danger",
        "Poor" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

@await Html.PartialAsync("_PageHeader")

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        <input type="number" name="equipmentId" value="@ViewBag.SelectedEquipmentId" class="form-control form-control-sm" style="max-width:160px;" placeholder="@Localizer["Equipment ID"]" />
        <select name="status" class="form-select form-select-sm" style="max-width:160px;">
            <option value="">@Localizer["All statuses"]</option>
            @foreach (var s in new[] { "Open", "Linked", "Closed" })
            {
                <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> @Localizer["Filter"]</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["Reset"]</a>
    </form>

    <table class="table table-enterprise table-sm">
        <thead>
            <tr>
                <th>@Localizer["Equipment"]</th><th>@Localizer["Source"]</th><th>@Localizer["Condition"]</th><th>@Localizer["Description"]</th>
                <th>@Localizer["Failure Mode / Cause"]</th><th>@Localizer["Status"]</th><th>@Localizer["Observed"]</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td class="small">@(f.Equipment?.TagNumber ?? f.EquipmentId.ToString())</td>
                    <td class="small">
                        @if (f.ConditionReadingId.HasValue) { <span class="badge text-bg-light border">@Localizer["CM Reading"]</span> }
                        else if (f.InspectionRecordId.HasValue) { <span class="badge text-bg-light border">@Localizer["Inspection"]</span> }
                    </td>
                    <td><span class="badge @ConditionBadge(f.Condition)">@f.Condition</span></td>
                    <td class="small">@f.Description</td>
                    <td class="small text-muted">@(f.FailureMode?.Name) @(f.FailureCause != null ? $"/ {f.FailureCause.Name}" : "")</td>
                    <td>
                        <span class="badge @(f.Status == "Open" ? "text-bg-warning" : f.Status == "Closed" ? "text-bg-secondary" : "text-bg-success")">@f.Status</span>
                        @if (f.WorkRequest != null)
                        {
                            <div class="small text-muted">WR: @f.WorkRequest.RequestNumber</div>
                        }
                    </td>
                    <td class="small">@f.ObservedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-end text-nowrap">
                        @if (f.Status == "Open")
                        {
                            <form asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                <input type="hidden" name="findingId" value="@f.FindingId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Raise Work Request"]"><i class="bi bi-clipboard-plus"></i></button>
                            </form>
                        }
                        @if (f.Status != "Closed")
                        {
                            <form asp-action="Close" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@f.FindingId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این یافته بسته بشه؟')" title="@Localizer["Close"]"><i class="bi bi-check-circle"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">@Localizer["هیچ یافته‌ای ثبت نشده."]</p> }
</div>
