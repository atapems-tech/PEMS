@model PEMS.Application.DTOs.ProductionDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var kpis = new List<PEMS.Web.Models.KpiCardViewModel>
    {
        new() { Title = "Active Orders", Count = Model.ActiveOrderCount, IconClass = "bi-clipboard-data", ColorClass = "bg-icon-blue", Url = Url.Action("Index", "ProductionOrder") },
        new() { Title = "Released Orders", Count = Model.ReleasedOrderCount, IconClass = "bi-send-check", ColorClass = "bg-icon-green", Url = Url.Action("Index", "ProductionOrder", new { status = "Released" }) },
        new() { Title = "Active Runs", Count = Model.ActiveRunCount, IconClass = "bi-play-circle", ColorClass = "bg-icon-blue" },
        new() { Title = "Held Runs", Count = Model.HeldRunCount, IconClass = "bi-pause-circle", ColorClass = "bg-icon-orange" }
    };
}
<pems-row gap="3" css="row-cols-2 row-cols-md-4 mb-3">
    @foreach (var kpi in kpis)
    {
        <pems-col span=""><pems-kpi-tile model="kpi" /></pems-col>
    }
</pems-row>

<pems-row gap="3" css="row-cols-1 row-cols-md-2 mb-3">
    <pems-col span="">
        <pems-content-card css="h-100">
            <div class="text-muted small">Today's Output Quantity</div>
            <div class="fs-3 fw-semibold">@Model.TodaysOutputQuantity.ToString("N3")</div>
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card css="h-100">
            <div class="text-muted small">Today's Loss Quantity</div>
            <div class="fs-3 fw-semibold text-danger">@Model.TodaysLossQuantity.ToString("N3")</div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3" css="row-cols-1 row-cols-lg-2">
    <pems-col span="">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-2">
                <pems-heading level="6" class="mb-0">Active Production Orders</pems-heading>
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="ProductionOrder" asp-action="Index">View all</pems-button>
            </pems-flex>
            <div class="table-scroll-area pems-s-7bf38d03">
                <pems-data-table data="@(DataRows.Of(Model.ActiveOrders, c_ => c_.Add(((Localizer["Order"])?.ToString() ?? ""), o => (object?)(DataCell.Link(Url.Action("Details", "ProductionOrder", new { id = o.ProductionOrderId }), o.OrderNumber))).Add(((Localizer["Material"])?.ToString() ?? ""), o => (object?)(o.MaterialCode)).Add(((Localizer["Qty"])?.ToString() ?? ""), o => (object?)(DataCell.Group((o.PlannedQuantity.ToString("N3")), " ", o.UomCode))).Add(((Localizer["Status"])?.ToString() ?? ""), o => (object?)(DataCell.Badge("neutral", o.Status))).Add(((Localizer["Work Center"])?.ToString() ?? ""), o => (object?)(o.WorkCenterCode))))" />
                @if (!Model.ActiveOrders.Any()) { <pems-text class="text-muted text-center py-3">No active production orders.</pems-text> }
            </div>
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card>
            <pems-heading level="6" class="mb-2">Recent Batches</pems-heading>
            <div class="table-scroll-area pems-s-7bf38d03">
                <pems-data-table data="@(DataRows.Of(Model.RecentBatches, c_ => c_.Add(((Localizer["Batch"])?.ToString() ?? ""), b => (object?)(DataCell.Link(Url.Action("BatchDetails", "ProductionRun", new { id = b.ProductionBatchId }), b.BatchNumber))).Add(((Localizer["Material"])?.ToString() ?? ""), b => (object?)(b.MaterialCode)).Add(((Localizer["Qty"])?.ToString() ?? ""), b => (object?)(DataCell.Group((b.Quantity.ToString("N3")), " ", b.UomCode))).Add("Quality Status", b => (object?)(DataCell.Badge("info", b.QualityStatus)))))" />
                @if (!Model.RecentBatches.Any()) { <pems-text class="text-muted text-center py-3">No batches recorded yet.</pems-text> }
            </div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <pems-heading level="6" class="mb-2">Recent Production Losses</pems-heading>
    <div class="table-scroll-area pems-s-f7dce87f">
        <pems-data-table data="@(DataRows.Of(Model.RecentLosses, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), l => (object?)(PemsDates.DateTime(l.TransactionDate)), css: "small").Add(((Localizer["Qty"])?.ToString() ?? ""), l => DataCell.Join((l.Quantity.ToString("N3")), " ", (l.UomCode))).Add(((Localizer["Category"])?.ToString() ?? ""), l => (object?)(l.LossCategory), kind: DataCellKind.Badge, tone: l => "warning").Add(((Localizer["Employee"])?.ToString() ?? ""), l => (object?)(l.EmployeeName)).Add(((Localizer["Notes"])?.ToString() ?? ""), l => (object?)(l.Notes), css: "small text-muted")))" />
        @if (!Model.RecentLosses.Any()) { <pems-text class="text-muted text-center py-3">No losses recorded yet.</pems-text> }
    </div>
</pems-content-card>
