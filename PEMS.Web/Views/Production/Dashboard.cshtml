@model PEMS.Application.DTOs.ProductionDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
    <div class="col">
        @await Html.PartialAsync("_KpiCard", new PEMS.Web.Models.KpiCardViewModel { Title = "Active Orders", Count = Model.ActiveOrderCount, IconClass = "bi-clipboard-data", ColorClass = "bg-icon-blue", Url = Url.Action("Index", "ProductionOrder") })
    </div>
    <div class="col">
        @await Html.PartialAsync("_KpiCard", new PEMS.Web.Models.KpiCardViewModel { Title = "Released Orders", Count = Model.ReleasedOrderCount, IconClass = "bi-send-check", ColorClass = "bg-icon-green", Url = Url.Action("Index", "ProductionOrder", new { status = "Released" }) })
    </div>
    <div class="col">
        @await Html.PartialAsync("_KpiCard", new PEMS.Web.Models.KpiCardViewModel { Title = "Active Runs", Count = Model.ActiveRunCount, IconClass = "bi-play-circle", ColorClass = "bg-icon-blue" })
    </div>
    <div class="col">
        @await Html.PartialAsync("_KpiCard", new PEMS.Web.Models.KpiCardViewModel { Title = "Held Runs", Count = Model.HeldRunCount, IconClass = "bi-pause-circle", ColorClass = "bg-icon-orange" })
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
    <div class="col">
        <div class="content-card h-100">
            <div class="text-muted small">Today's Output Quantity</div>
            <div class="fs-3 fw-semibold">@Model.TodaysOutputQuantity.ToString("N3")</div>
        </div>
    </div>
    <div class="col">
        <div class="content-card h-100">
            <div class="text-muted small">Today's Loss Quantity</div>
            <div class="fs-3 fw-semibold text-danger">@Model.TodaysLossQuantity.ToString("N3")</div>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-lg-2 g-3">
    <div class="col">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Active Production Orders</h6>
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="ProductionOrder" asp-action="Index">View all</pems-button>
            </div>
            <div class="table-scroll-area" style="max-height:50vh; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Order"]</th><th>@Localizer["Material"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Status"]</th><th>@Localizer["Work Center"]</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.ActiveOrders)
                        {
                            <tr>
                                <td><a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@o.ProductionOrderId">@o.OrderNumber</a></td>
                                <td>@o.MaterialCode</td>
                                <td>@o.PlannedQuantity.ToString("N3") @o.UomCode</td>
                                <td><pems-badge tone="neutral">@o.Status</pems-badge></td>
                                <td>@o.WorkCenterCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.ActiveOrders.Any()) { <p class="text-muted text-center py-3">No active production orders.</p> }
            </div>
        </div>
    </div>
    <div class="col">
        <div class="content-card">
            <h6 class="mb-2">Recent Batches</h6>
            <div class="table-scroll-area" style="max-height:50vh; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Batch"]</th><th>@Localizer["Material"]</th><th>@Localizer["Qty"]</th><th>Quality Status</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentBatches)
                        {
                            <tr>
                                <td><a asp-controller="ProductionRun" asp-action="BatchDetails" asp-route-id="@b.ProductionBatchId">@b.BatchNumber</a></td>
                                <td>@b.MaterialCode</td>
                                <td>@b.Quantity.ToString("N3") @b.UomCode</td>
                                <td><pems-badge tone="info">@b.QualityStatus</pems-badge></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.RecentBatches.Any()) { <p class="text-muted text-center py-3">No batches recorded yet.</p> }
            </div>
        </div>
    </div>
</div>

<div class="content-card mt-3">
    <h6 class="mb-2">Recent Production Losses</h6>
    <div class="table-scroll-area" style="max-height:40vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Category"]</th><th>@Localizer["Employee"]</th><th>@Localizer["Notes"]</th></tr></thead>
            <tbody>
                @foreach (var l in Model.RecentLosses)
                {
                    <tr>
                        <td class="small">@l.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@l.Quantity.ToString("N3") @l.UomCode</td>
                        <td><pems-badge tone="warning">@l.LossCategory</pems-badge></td>
                        <td>@l.EmployeeName</td>
                        <td class="small text-muted">@l.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.RecentLosses.Any()) { <p class="text-muted text-center py-3">No losses recorded yet.</p> }
    </div>
</div>
