@model PEMS.Application.DTOs.ProductionDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var kpis = new List<PEMS.Web.Models.KpiCardViewModel>
    {
        new() { Title = "Active Orders", Count = Model.ActiveOrderCount, IconClass = "bi-clipboard-data", ColorClass = "bg-icon-blue", Url = Url.Action("Index", "ProductionOrder") },
        new() { Title = "Released Orders", Count = Model.ReleasedOrderCount, IconClass = "bi-send-check", ColorClass = "bg-icon-green", Url = Url.Action("Index", "ProductionOrder", new { status = "Released" }) },
        new() { Title = "Active Runs", Count = Model.ActiveRunCount, IconClass = "bi-play-circle", ColorClass = "bg-icon-blue" },
        new() { Title = "Held Runs", Count = Model.HeldRunCount, IconClass = "bi-pause-circle", ColorClass = "bg-icon-orange" }
    };
}
<pems-row gap="3" css="row-cols-2 row-cols-md-4 mb-3">
    @foreach (var kpi in kpis)
    {
        <pems-col span=""><pems-kpi-tile model="kpi" /></pems-col>
    }
</pems-row>

<pems-row gap="3" css="row-cols-1 row-cols-md-2 mb-3">
    <pems-col span="">
        <pems-content-card css="h-100">
            <div class="text-muted small">Today's Output Quantity</div>
            <div class="fs-3 fw-semibold">@Model.TodaysOutputQuantity.ToString("N3")</div>
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card css="h-100">
            <div class="text-muted small">Today's Loss Quantity</div>
            <div class="fs-3 fw-semibold text-danger">@Model.TodaysLossQuantity.ToString("N3")</div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3" css="row-cols-1 row-cols-lg-2">
    <pems-col span="">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-2">
                <h6 class="mb-0">Active Production Orders</h6>
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="ProductionOrder" asp-action="Index">View all</pems-button>
            </pems-flex>
            <div class="table-scroll-area pems-s-7bf38d03">
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Order"]</pems-table-header><pems-table-header>@Localizer["Material"]</pems-table-header><pems-table-header>@Localizer["Qty"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Work Center"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var o in Model.ActiveOrders)
                        {
                            <pems-table-row>
                                <pems-table-cell><a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@o.ProductionOrderId">@o.OrderNumber</a></pems-table-cell>
                                <pems-table-cell>@o.MaterialCode</pems-table-cell>
                                <pems-table-cell>@o.PlannedQuantity.ToString("N3") @o.UomCode</pems-table-cell>
                                <pems-table-cell><pems-badge tone="neutral">@o.Status</pems-badge></pems-table-cell>
                                <pems-table-cell>@o.WorkCenterCode</pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
                @if (!Model.ActiveOrders.Any()) { <p class="text-muted text-center py-3">No active production orders.</p> }
            </div>
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card>
            <h6 class="mb-2">Recent Batches</h6>
            <div class="table-scroll-area pems-s-7bf38d03">
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Batch"]</pems-table-header><pems-table-header>@Localizer["Material"]</pems-table-header><pems-table-header>@Localizer["Qty"]</pems-table-header><pems-table-header>Quality Status</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var b in Model.RecentBatches)
                        {
                            <pems-table-row>
                                <pems-table-cell><a asp-controller="ProductionRun" asp-action="BatchDetails" asp-route-id="@b.ProductionBatchId">@b.BatchNumber</a></pems-table-cell>
                                <pems-table-cell>@b.MaterialCode</pems-table-cell>
                                <pems-table-cell>@b.Quantity.ToString("N3") @b.UomCode</pems-table-cell>
                                <pems-table-cell><pems-badge tone="info">@b.QualityStatus</pems-badge></pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
                @if (!Model.RecentBatches.Any()) { <p class="text-muted text-center py-3">No batches recorded yet.</p> }
            </div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <h6 class="mb-2">Recent Production Losses</h6>
    <div class="table-scroll-area pems-s-f7dce87f">
        <pems-data-table data="@(DataRows.Of(Model.RecentLosses, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), l => (object?)(l.TransactionDate.ToString("yyyy-MM-dd HH:mm")), css: "small").Add(((Localizer["Qty"])?.ToString() ?? ""), l => DataCell.Join((l.Quantity.ToString("N3")), " ", (l.UomCode))).Add(((Localizer["Category"])?.ToString() ?? ""), l => (object?)(l.LossCategory), kind: DataCellKind.Badge, tone: l => "warning").Add(((Localizer["Employee"])?.ToString() ?? ""), l => (object?)(l.EmployeeName)).Add(((Localizer["Notes"])?.ToString() ?? ""), l => (object?)(l.Notes), css: "small text-muted")))" />
        @if (!Model.RecentLosses.Any()) { <p class="text-muted text-center py-3">No losses recorded yet.</p> }
    </div>
</pems-content-card>
