@model PEMS.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = null;
}

@if (ViewBag.DashboardWarning != null)
{
    <div class="alert alert-warning d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div class="small">@ViewBag.DashboardWarning</div>
    </div>
}

@{
    var setupStatus = (PEMS.Application.DTOs.SetupStatusDto?)ViewBag.SetupStatus;
}
@if (setupStatus != null && !setupStatus.IsFullyComplete)
{
    <div class="content-card mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h6 class="mb-0"><i class="bi bi-rocket-takeoff"></i> System Setup</h6>
            <span class="text-muted small">@setupStatus.CompletedCount of @setupStatus.TotalCount setup areas ready</span>
        </div>
        <div class="progress mb-3" style="height: 18px;" role="progressbar"
             aria-valuenow="@setupStatus.PercentComplete" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: @setupStatus.PercentComplete%">@setupStatus.PercentComplete%</div>
        </div>
        <a asp-controller="QuickSetup" asp-action="Index" class="btn btn-sm btn-primary">Continue Setup</a>
    </div>
}

@{
    var myWork = (PEMS.Web.Models.MyWorkSummary?)ViewBag.MyWork;
}
@if (myWork != null && myWork.HasAnyCategory)
{
    <div class="content-card mb-4">
        <h6 class="mb-1"><i class="bi bi-check2-square"></i> My Work</h6>
        <p class="text-muted small mb-3">What requires your attention</p>

        @if (!myWork.HasAnyActionable)
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-emoji-smile" style="font-size:32px;"></i>
                <p class="mb-0 mt-2">You're all caught up. No items currently require your attention.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @if (myWork.ShowPermitApprovals)
                {
                    <div class="col-md-4">
                        <a asp-controller="Permit" asp-action="Index" asp-route-pendingMyApproval="true"
                           class="d-flex align-items-center gap-3 p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingPermitApprovals Permit Approvals waiting for your approval">
                            <div class="kpi-icon @(myWork.PendingPermitApprovals > 0 ? "bg-icon-red" : "bg-icon-slate")"><i class="bi bi-shield-check"></i></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingPermitApprovals</div>
                                <div class="small text-muted">Permit Approvals waiting for you</div>
                            </div>
                        </a>
                    </div>
                }
                @if (myWork.ShowWorkOrders)
                {
                    <div class="col-md-4">
                        <a asp-controller="WorkOrder" asp-action="Index" asp-route-assignedToMe="true"
                           class="d-flex align-items-center gap-3 p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyWorkOrdersCount Work Orders assigned to you">
                            <div class="kpi-icon @(myWork.MyWorkOrdersCount > 0 ? "bg-icon-orange" : "bg-icon-slate")"><i class="bi bi-clipboard-check"></i></div>
                            <div>
                                <div class="kpi-value">@myWork.MyWorkOrdersCount</div>
                                <div class="small text-muted">Work Orders assigned to you</div>
                            </div>
                        </a>
                    </div>
                }
                @if (myWork.ShowReferrals)
                {
                    <div class="col-md-4">
                        <a asp-controller="Letter" asp-action="MyReferrals"
                           class="d-flex align-items-center gap-3 p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyReferralsCount Correspondence Referrals requiring your action">
                            <div class="kpi-icon @(myWork.MyReferralsCount > 0 ? "bg-icon-blue" : "bg-icon-slate")"><i class="bi bi-envelope-paper"></i></div>
                            <div>
                                <div class="kpi-value">@myWork.MyReferralsCount</div>
                                <div class="small text-muted">Referrals requiring your action</div>
                            </div>
                        </a>
                    </div>
                }
                @if (myWork.ShowDocumentReviews)
                {
                    <div class="col-md-4">
                        <a asp-controller="EngineeringDocuments" asp-action="Index"
                           class="d-flex align-items-center gap-3 p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingDocumentReviewsCount Engineering Documents awaiting your review or approval">
                            <div class="kpi-icon @(myWork.PendingDocumentReviewsCount > 0 ? "bg-icon-purple" : "bg-icon-slate")"><i class="bi bi-file-earmark-check"></i></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingDocumentReviewsCount</div>
                                <div class="small text-muted">Documents awaiting your review</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
}


<!-- بخش کارت‌های KPI (بهینه‌سازی شده با Partial View) -->
<div class="row g-3 mb-4">
    @foreach (var kpi in Model.KpiCards)
    {
        <div class="col-md-3 col-sm-6">
            <partial name="_KpiCard" model="kpi" />
        </div>
    }
</div>


<div class="row g-3">

    <div class="col-lg-6">
        <div class="content-card">
            <h6 class="mb-3">Documents by Status</h6>
            <canvas id="docsStatusChart" height="220"></canvas>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="content-card h-100">
            <h6 class="mb-3">Discipline Performance</h6>
            <p class="text-muted small">
                این بخش پس از تکمیل ماژول‌های مهندسی (فاز بعدی) با KPI واقعی هر دیسیپلین پر می‌شود.
            </p>
            <div class="text-center text-muted py-5">
                <i class="bi bi-bar-chart-line" style="font-size:38px;"></i>
                <div class="small mt-2">Coming soon</div>
            </div>
        </div>
    </div>

</div>

@{
    var widgetLayout = (List<PEMS.Application.DTOs.UserDashboardWidgetDto>)ViewBag.WidgetLayout;
    var widgetData = (Dictionary<string, object>)ViewBag.WidgetData;
}

@if (widgetLayout != null && widgetLayout.Any())
{
    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
        <h6 class="mb-0">My Dashboard</h6>
        <a asp-controller="DashboardSettings" asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-sliders"></i> Customize
        </a>
    </div>

    <div class="row g-3">
        @foreach (var w in widgetLayout)
        {
            var colClass = w.Size switch { "Small" => "col-md-3", "Large" => "col-md-8", _ => "col-md-4" };
            var value = widgetData.TryGetValue(w.WidgetKey, out var v) ? v : null;

            <div class="@colClass">
                <div class="content-card h-100">
                    <h6 class="mb-3">@w.DisplayName</h6>
                    @if (value is List<string> list)
                    {
                        <ul class="list-unstyled small mb-0">
                            @foreach (var item in list) { <li class="border-bottom py-1">@item</li> }
                            @if (!list.Any()) { <li class="text-muted">Nothing to show</li> }
                        </ul>
                    }
                    else
                    {
                        <div class="kpi-value">@value</div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center mt-3">
        <a asp-controller="DashboardSettings" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-sliders"></i> Customize your dashboard
        </a>
    </div>
}


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
    <script>
        const statusLabels = @Html.Raw(Json.Serialize(Model.DocumentsByStatus.Keys));
        const statusValues = @Html.Raw(Json.Serialize(Model.DocumentsByStatus.Values));

        const ctx = document.getElementById('docsStatusChart');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: ['#94a3b8', '#f59e0b', '#22c55e', '#ef4444', '#3b82f6']
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}