@model PEMS.Web.Models.DashboardViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = null;
}

@if (ViewBag.DashboardWarning != null)
{
    <pems-alert tone="warning" css="d-flex align-items-start gap-2">
        <pems-icon name="bi-exclamation-triangle-fill" css="mt-1" />
        <div class="small">@Localizer["Dashboard_SchemaWarning", (string)ViewBag.DashboardWarning]</div>
    </pems-alert>
}

@{
    var setupStatus = (PEMS.Application.DTOs.SetupStatusDto?)ViewBag.SetupStatus;
}
@if (setupStatus != null && !setupStatus.IsFullyComplete)
{
    <pems-content-card css="mb-4">
        <pems-flex justify="between" align="center" wrap="true" gap="2" css="mb-2">
            <pems-heading level="6" class="mb-0"><pems-icon name="bi-rocket-takeoff" /> @Localizer["System Setup"]</pems-heading>
            <span class="text-muted small">@Localizer["Dashboard_SetupProgress", setupStatus.CompletedCount, setupStatus.TotalCount]</span>
        </pems-flex>
        <pems-progress value="@setupStatus.PercentComplete" height="18px" css="mb-3">@setupStatus.PercentComplete%</pems-progress>
        <pems-button as="a" tone="none" size="small" css="btn-primary" asp-controller="QuickSetup" asp-action="Index">@Localizer["Continue Setup"]</pems-button>
    </pems-content-card>
}

@{
    var myWork = (PEMS.Web.Models.MyWorkSummary?)ViewBag.MyWork;
}
@if (myWork != null && myWork.HasAnyCategory)
{
    <pems-content-card css="mb-4">
        <pems-heading level="6" class="mb-1"><pems-icon name="bi-check2-square" /> @Localizer["My Work"]</pems-heading>
        <pems-text class="text-muted small mb-3">@Localizer["What requires your attention"]</pems-text>

        @if (!myWork.HasAnyActionable)
        {
            <div class="text-center text-muted py-4">
                <pems-icon name="bi-emoji-smile" css="pems-s-4361a2ff" />
                <pems-text class="mb-0 mt-2">@Localizer["Dashboard_AllCaughtUp"]</pems-text>
            </div>
        }
        else
        {
            <pems-row gap="3">
                @if (myWork.ShowPermitApprovals)
                {
                    <pems-col md="4">
                        <pems-link asp-controller="Permit" asp-action="Index" asp-route-pendingMyApproval="true"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingPermitApprovals @Localizer["Dashboard_PermitApprovals"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.PendingPermitApprovals > 0 ? "bg-icon-red" : "bg-icon-slate")"><pems-icon name="bi-shield-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingPermitApprovals</div>
                                <div class="small text-muted">@Localizer["Dashboard_PermitApprovals"]</div>
                            </div>
                        </pems-flex></pems-link>
                    </pems-col>
                }
                @if (myWork.ShowWorkOrders)
                {
                    <pems-col md="4">
                        <pems-link asp-controller="WorkOrder" asp-action="Index" asp-route-assignedToMe="true"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyWorkOrdersCount @Localizer["Dashboard_AssignedWorkOrders"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.MyWorkOrdersCount > 0 ? "bg-icon-orange" : "bg-icon-slate")"><pems-icon name="bi-clipboard-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.MyWorkOrdersCount</div>
                                <div class="small text-muted">@Localizer["Dashboard_AssignedWorkOrders"]</div>
                            </div>
                        </pems-flex></pems-link>
                    </pems-col>
                }
                @if (myWork.ShowReferrals)
                {
                    <pems-col md="4">
                        <pems-link asp-controller="Letter" asp-action="MyReferrals"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyReferralsCount @Localizer["Dashboard_Referrals"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.MyReferralsCount > 0 ? "bg-icon-blue" : "bg-icon-slate")"><pems-icon name="bi-envelope-paper" /></div>
                            <div>
                                <div class="kpi-value">@myWork.MyReferralsCount</div>
                                <div class="small text-muted">@Localizer["Dashboard_Referrals"]</div>
                            </div>
                        </pems-flex></pems-link>
                    </pems-col>
                }
                @if (myWork.ShowOtherApprovals)
                {
                    <pems-col md="4">
                        <pems-link href="/p/my-work"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.OtherApprovalsCount @Localizer["MyWork_Card_Other"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon bg-icon-teal"><pems-icon name="bi-list-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.OtherApprovalsCount</div>
                                <div class="small text-muted">@Localizer["MyWork_Card_Other"]</div>
                            </div>
                        </pems-flex></pems-link>
                    </pems-col>
                }
                @if (myWork.ShowDocumentReviews)
                {
                    <pems-col md="4">
                        <pems-link asp-controller="EngineeringDocuments" asp-action="Index"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingDocumentReviewsCount @Localizer["Dashboard_DocumentReviews"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.PendingDocumentReviewsCount > 0 ? "bg-icon-purple" : "bg-icon-slate")"><pems-icon name="bi-file-earmark-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingDocumentReviewsCount</div>
                                <div class="small text-muted">@Localizer["Dashboard_DocumentReviews"]</div>
                            </div>
                        </pems-flex></pems-link>
                    </pems-col>
                }
            </pems-row>
        }
    </pems-content-card>
}


<!-- بخش کارت‌های KPI (بهینه‌سازی شده با Partial View) -->
<pems-row gap="3" css="mb-4">
    @foreach (var kpi in Model.KpiCards)
    {
        var localizedKpi = new PEMS.Web.Models.KpiCardViewModel
        {
            Title = Localizer[kpi.Title].Value,
            Hint = string.IsNullOrEmpty(kpi.Hint) ? null : Localizer[kpi.Hint].Value,
            Count = kpi.Count, IconClass = kpi.IconClass, ColorClass = kpi.ColorClass, Url = kpi.Url
        };
        <pems-col md="3" sm="6">
            <pems-kpi-tile model="localizedKpi" />
        </pems-col>
    }
</pems-row>


<pems-row gap="3">

    <pems-col lg="6">
        <pems-content-card>
            <pems-heading level="6" class="mb-3">@Localizer["Documents by Status"]</pems-heading>
            @* SCRUM-337 C3: the shared chart host (Bklit donut with its hover-linked legend) *@
            @{ var docsDonut = PEMS.Web.Models.BkChartSpec.Donut(Localizer["Documents by Status"].Value, Localizer["No documents to chart yet."].Value,
                   Localizer["Documents"].Value, Model.DocumentsByStatus.Select(kv => (Localizer[kv.Key].Value, (double)kv.Value))); }
            <pems-chart spec="@docsDonut" />
        </pems-content-card>
    </pems-col>

    <pems-col lg="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">@Localizer["Discipline Performance"]</pems-heading>
            @{ var disciplineRows = (List<PEMS.Web.Models.DisciplinePerformanceRow>)(ViewBag.DisciplinePerformance ?? new List<PEMS.Web.Models.DisciplinePerformanceRow>()); }
            @if (disciplineRows.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <pems-icon name="bi-bar-chart-line" css="pems-s-e0132535" />
                    <div class="small mt-2">@Localizer["No engineering documents with a discipline yet. Register documents (or import the MDR) to see per-discipline progress here."]</div>
                </div>
            }
            else
            {
                <pems-table-scroll>
                    @{
                        var rows_41 = disciplineRows;
                        var cell_41_4 = DataCell.Template(rows_41, @<text>@{ var row = item; }<pems-progress value="@row.ApprovedPercent" tone="success" height="8px" title="@row.ApprovedPercent%"></pems-progress></text>);
                    }
                    <pems-data-table data="@(DataRows.Of(rows_41, c_ => c_.Add(((Localizer["Discipline"])?.ToString() ?? ""), row => (object?)(row.Discipline)).Add(((Localizer["Documents"])?.ToString() ?? ""), row => (object?)(row.Total), css: "text-end", headerCss: "text-end").Add(((Localizer["Approved"])?.ToString() ?? ""), row => (object?)(row.Approved), css: "text-end", headerCss: "text-end").Add(((Localizer["Pending Approval"])?.ToString() ?? ""), row => (object?)(row.PendingApproval), css: "text-end", headerCss: "text-end").Add("%", row => (object?)cell_41_4(row), headerCss: "pems-w-30pct")))" dense="true" css="mb-0" />
                </pems-table-scroll>
            }
        </pems-content-card>
    </pems-col>

</pems-row>

@{
    var widgetLayout = (List<PEMS.Application.DTOs.UserDashboardWidgetDto>)ViewBag.WidgetLayout;
    var widgetData = (Dictionary<string, object>)ViewBag.WidgetData;
}

@if (widgetLayout != null && widgetLayout.Any())
{
    <pems-flex justify="between" align="center" css="mt-4 mb-2">
        <pems-heading level="6" class="mb-0">@Localizer["My Dashboard"]</pems-heading>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="DashboardSettings" asp-action="Index">
            <pems-icon name="bi-sliders" /> @Localizer["Customize"]
        </pems-button>
    </pems-flex>

    <pems-row gap="3">
        @foreach (var w in widgetLayout)
        {
            var colClass = w.Size switch { "Small" => "col-md-3", "Large" => "col-md-8", _ => "col-md-4" };
            var value = widgetData.TryGetValue(w.WidgetKey, out var v) ? v : null;

            <div class="@colClass">
                <pems-content-card css="h-100">
                    <pems-heading level="6" class="mb-3">@Localizer[w.DisplayName]</pems-heading>
                    @if (value is List<string> list)
                    {
                        <pems-bullet-list class="list-unstyled small mb-0">
                            @foreach (var item in list) { <pems-bullet class="border-bottom py-1">@item</pems-bullet> }
                            @if (!list.Any()) { <pems-bullet class="text-muted">@Localizer["Dashboard_NothingToShow"]</pems-bullet> }
                        </pems-bullet-list>
                    }
                    else
                    {
                        <div class="kpi-value">@value</div>
                    }
                </pems-content-card>
            </div>
        }
    </pems-row>
}
else
{
    <div class="text-center mt-3">
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="DashboardSettings" asp-action="Index">
            <pems-icon name="bi-sliders" /> @Localizer["Dashboard_Customize"]
        </pems-button>
    </div>
}


@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
