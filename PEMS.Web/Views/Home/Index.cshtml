@model PEMS.Web.Models.DashboardViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = null;
}

@if (ViewBag.DashboardWarning != null)
{
    <pems-alert tone="warning" css="d-flex align-items-start gap-2">
        <pems-icon name="bi-exclamation-triangle-fill" css="mt-1" />
        <div class="small">@ViewBag.DashboardWarning</div>
    </pems-alert>
}

@{
    var setupStatus = (PEMS.Application.DTOs.SetupStatusDto?)ViewBag.SetupStatus;
}
@if (setupStatus != null && !setupStatus.IsFullyComplete)
{
    <pems-content-card css="mb-4">
        <pems-flex justify="between" align="center" wrap="true" gap="2" css="mb-2">
            <h6 class="mb-0"><pems-icon name="bi-rocket-takeoff" /> @Localizer["System Setup"]</h6>
            <span class="text-muted small">@setupStatus.CompletedCount of @setupStatus.TotalCount setup areas ready</span>
        </pems-flex>
        <pems-progress value="@setupStatus.PercentComplete" height="18px" css="mb-3">@setupStatus.PercentComplete%</pems-progress>
        <pems-button as="a" tone="none" size="small" css="btn-primary" asp-controller="QuickSetup" asp-action="Index">@Localizer["Continue Setup"]</pems-button>
    </pems-content-card>
}

@{
    var myWork = (PEMS.Web.Models.MyWorkSummary?)ViewBag.MyWork;
}
@if (myWork != null && myWork.HasAnyCategory)
{
    <pems-content-card css="mb-4">
        <h6 class="mb-1"><pems-icon name="bi-check2-square" /> @Localizer["My Work"]</h6>
        <p class="text-muted small mb-3">@Localizer["What requires your attention"]</p>

        @if (!myWork.HasAnyActionable)
        {
            <div class="text-center text-muted py-4">
                <pems-icon name="bi-emoji-smile" css="pems-s-4361a2ff" />
                <p class="mb-0 mt-2">You're all caught up. No items currently require your attention.</p>
            </div>
        }
        else
        {
            <pems-row gap="3">
                @if (myWork.ShowPermitApprovals)
                {
                    <pems-col md="4">
                        <a asp-controller="Permit" asp-action="Index" asp-route-pendingMyApproval="true"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingPermitApprovals Permit Approvals waiting for your approval"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.PendingPermitApprovals > 0 ? "bg-icon-red" : "bg-icon-slate")"><pems-icon name="bi-shield-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingPermitApprovals</div>
                                <div class="small text-muted">Permit Approvals waiting for you</div>
                            </div>
                        </pems-flex></a>
                    </pems-col>
                }
                @if (myWork.ShowWorkOrders)
                {
                    <pems-col md="4">
                        <a asp-controller="WorkOrder" asp-action="Index" asp-route-assignedToMe="true"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyWorkOrdersCount Work Orders assigned to you"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.MyWorkOrdersCount > 0 ? "bg-icon-orange" : "bg-icon-slate")"><pems-icon name="bi-clipboard-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.MyWorkOrdersCount</div>
                                <div class="small text-muted">Work Orders assigned to you</div>
                            </div>
                        </pems-flex></a>
                    </pems-col>
                }
                @if (myWork.ShowReferrals)
                {
                    <pems-col md="4">
                        <a asp-controller="Letter" asp-action="MyReferrals"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.MyReferralsCount Correspondence Referrals requiring your action"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.MyReferralsCount > 0 ? "bg-icon-blue" : "bg-icon-slate")"><pems-icon name="bi-envelope-paper" /></div>
                            <div>
                                <div class="kpi-value">@myWork.MyReferralsCount</div>
                                <div class="small text-muted">Referrals requiring your action</div>
                            </div>
                        </pems-flex></a>
                    </pems-col>
                }
                @if (myWork.ShowOtherApprovals)
                {
                    <pems-col md="4">
                        <a asp-controller="MyWork" asp-action="Index"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.OtherApprovalsCount @Localizer["MyWork_Card_Other"]"><pems-flex align="center" gap="3">
                            <div class="kpi-icon bg-icon-teal"><pems-icon name="bi-list-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.OtherApprovalsCount</div>
                                <div class="small text-muted">@Localizer["MyWork_Card_Other"]</div>
                            </div>
                        </pems-flex></a>
                    </pems-col>
                }
                @if (myWork.ShowDocumentReviews)
                {
                    <pems-col md="4">
                        <a asp-controller="EngineeringDocuments" asp-action="Index"
                           class="d-block p-2 rounded text-decoration-none"
                           aria-label="@myWork.PendingDocumentReviewsCount Engineering Documents awaiting your review or approval"><pems-flex align="center" gap="3">
                            <div class="kpi-icon @(myWork.PendingDocumentReviewsCount > 0 ? "bg-icon-purple" : "bg-icon-slate")"><pems-icon name="bi-file-earmark-check" /></div>
                            <div>
                                <div class="kpi-value">@myWork.PendingDocumentReviewsCount</div>
                                <div class="small text-muted">Documents awaiting your review</div>
                            </div>
                        </pems-flex></a>
                    </pems-col>
                }
            </pems-row>
        }
    </pems-content-card>
}


<!-- بخش کارت‌های KPI (بهینه‌سازی شده با Partial View) -->
<pems-row gap="3" css="mb-4">
    @foreach (var kpi in Model.KpiCards)
    {
        <pems-col md="3" sm="6">
            <pems-kpi-tile model="kpi" />
        </pems-col>
    }
</pems-row>


<pems-row gap="3">

    <pems-col lg="6">
        <pems-content-card>
            <h6 class="mb-3">@Localizer["Documents by Status"]</h6>
            @* SCRUM-337 C3: the shared chart host (Bklit donut with its hover-linked legend) *@
            @{ var docsDonut = PEMS.Web.Models.BkChartSpec.Donut(Localizer["Documents by Status"].Value, Localizer["No documents to chart yet."].Value,
                   Localizer["Documents"].Value, Model.DocumentsByStatus.Select(kv => (kv.Key, (double)kv.Value))); }
            <pems-chart spec="@docsDonut" />
        </pems-content-card>
    </pems-col>

    <pems-col lg="6">
        <pems-content-card css="h-100">
            <h6 class="mb-3">@Localizer["Discipline Performance"]</h6>
            @{ var disciplineRows = (List<PEMS.Web.Models.DisciplinePerformanceRow>)(ViewBag.DisciplinePerformance ?? new List<PEMS.Web.Models.DisciplinePerformanceRow>()); }
            @if (disciplineRows.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <pems-icon name="bi-bar-chart-line" css="pems-s-e0132535" />
                    <div class="small mt-2">@Localizer["No engineering documents with a discipline yet. Register documents (or import the MDR) to see per-discipline progress here."]</div>
                </div>
            }
            else
            {
                <pems-table-scroll>
                    <pems-table kind="enterprise" scale="small" css="mb-0">
                        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header class="text-end">@Localizer["Documents"]</pems-table-header><pems-table-header class="text-end">@Localizer["Approved"]</pems-table-header><pems-table-header class="text-end">@Localizer["Pending Approval"]</pems-table-header><pems-table-header class="pems-w-30pct">%</pems-table-header></pems-table-row></pems-table-head>
                        <pems-table-body>
                            @foreach (var row in disciplineRows)
                            {
                                <pems-table-row>
                                    <pems-table-cell>@row.Discipline</pems-table-cell><pems-table-cell class="text-end">@row.Total</pems-table-cell><pems-table-cell class="text-end">@row.Approved</pems-table-cell><pems-table-cell class="text-end">@row.PendingApproval</pems-table-cell>
                                    <pems-table-cell><pems-progress value="@row.ApprovedPercent" tone="success" height="8px" title="@row.ApprovedPercent%"></pems-progress></pems-table-cell>
                                </pems-table-row>
                            }
                        </pems-table-body>
                    </pems-table>
                </pems-table-scroll>
            }
        </pems-content-card>
    </pems-col>

</pems-row>

@{
    var widgetLayout = (List<PEMS.Application.DTOs.UserDashboardWidgetDto>)ViewBag.WidgetLayout;
    var widgetData = (Dictionary<string, object>)ViewBag.WidgetData;
}

@if (widgetLayout != null && widgetLayout.Any())
{
    <pems-flex justify="between" align="center" css="mt-4 mb-2">
        <h6 class="mb-0">@Localizer["My Dashboard"]</h6>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="DashboardSettings" asp-action="Index">
            <pems-icon name="bi-sliders" /> @Localizer["Customize"]
        </pems-button>
    </pems-flex>

    <pems-row gap="3">
        @foreach (var w in widgetLayout)
        {
            var colClass = w.Size switch { "Small" => "col-md-3", "Large" => "col-md-8", _ => "col-md-4" };
            var value = widgetData.TryGetValue(w.WidgetKey, out var v) ? v : null;

            <div class="@colClass">
                <pems-content-card css="h-100">
                    <h6 class="mb-3">@w.DisplayName</h6>
                    @if (value is List<string> list)
                    {
                        <ul class="list-unstyled small mb-0">
                            @foreach (var item in list) { <li class="border-bottom py-1">@item</li> }
                            @if (!list.Any()) { <li class="text-muted">Nothing to show</li> }
                        </ul>
                    }
                    else
                    {
                        <div class="kpi-value">@value</div>
                    }
                </pems-content-card>
            </div>
        }
    </pems-row>
}
else
{
    <div class="text-center mt-3">
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="DashboardSettings" asp-action="Index">
            <pems-icon name="bi-sliders" /> Customize your dashboard
        </pems-button>
    </div>
}


@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
