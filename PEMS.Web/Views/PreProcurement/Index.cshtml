@model IReadOnlyList<PEMS.Application.Interfaces.ProcurementDemandRow>
@using Microsoft.Extensions.Localization
@using PEMS.Domain.Entities
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-471: the procurement cartable (pre-procurement queue)
    var status = ViewBag.Status as string;
    var source = ViewBag.Source as string;
    var statuses = new[] { ProcurementDemandStatuses.Open, ProcurementDemandStatuses.Converted, ProcurementDemandStatuses.Accepted, ProcurementDemandStatuses.Dismissed };
    var sources = new[] { ProcurementDemandSources.Replenishment, ProcurementDemandSources.WorkOrderDirectPurchase, ProcurementDemandSources.MaterialRequisition };
    var filterCount = (string.IsNullOrEmpty(status) ? 0 : 1) + (string.IsNullOrEmpty(source) ? 0 : 1);
    string Pill(string s) => s switch
    {
        ProcurementDemandStatuses.Open => "vs-pill--warning",
        ProcurementDemandStatuses.Dismissed => "vs-pill--neutral",
        _ => "vs-pill--success"
    };
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the two selects became the status and source filters, the hint the heading tooltip. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Ppr_Title"]" heading-title="@Localizer["Ppr_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-filters form-id="pprFilter" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="pprStatus" name="status" label="@Localizer["Ppr_Status"]" value="@status"
                                             all-text="@Localizer["Ppr_AllStatuses"]" items="@statuses.Select(s => new SelectListItem(Localizer["Ppr_Status_" + s].Value, s))" />
                    <pems-list-filter-select id="pprSource" name="source" label="@Localizer["Ppr_Source"]" value="@source"
                                             all-text="@Localizer["Ppr_AllSources"]" items="@sources.Select(s => new SelectListItem(Localizer["Ppr_Source_" + s].Value, s))" />
                </pems-list-filters>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(status)) { <pems-list-chip label="@Localizer["Ppr_Status"]" value="@Localizer["Ppr_Status_" + status]" remove-href="@Url.Action("Index", new { source })" /> }
            @if (!string.IsNullOrEmpty(source)) { <pems-list-chip label="@Localizer["Ppr_Source"]" value="@Localizer["Ppr_Source_" + source]" remove-href="@Url.Action("Index", new { status })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["Ppr_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>#</pems-table-header>
                        <pems-table-header>@Localizer["Ppr_Source"]</pems-table-header>
                        <pems-table-header>@Localizer["Ppr_Item"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Ppr_Quantity"]</pems-table-header>
                        <pems-table-header>@Localizer["Ppr_Warehouse"]</pems-table-header>
                        <pems-table-header>@Localizer["Ppr_Status"]</pems-table-header>
                        <pems-table-header>@Localizer["Ppr_Raised"]</pems-table-header>
                        <pems-table-header>MR</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
            @foreach (var d in Model)
            {
                <pems-table-row class="lp-row">
                    <pems-table-cell><a href="/PreProcurement/Details/@d.ProcurementDemandId" dir="ltr">#@d.ProcurementDemandId</a></pems-table-cell>
                    <pems-table-cell class="small">@Localizer["Ppr_Source_" + d.SourceType] <span dir="ltr" class="text-muted">@d.SourceNumber</span></pems-table-cell>
                    <pems-table-cell class="small">@if (d.MaterialCode != null) { <span dir="ltr">@d.MaterialCode</span><text> - </text> }@d.Description</pems-table-cell>
                    <pems-table-cell class="text-end" dir="ltr">@(d.SourceType == ProcurementDemandSources.MaterialRequisition ? "—" : d.Quantity.ToString("0.###") + " " + d.UnitName)</pems-table-cell>
                    <pems-table-cell dir="ltr">@(d.WarehouseCode ?? "—")</pems-table-cell>
                    <pems-table-cell><span class="vs-pill @Pill(d.Status)">@Localizer["Ppr_Status_" + d.Status]</span></pems-table-cell>
                    <pems-table-cell class="small text-nowrap" dir="ltr">@d.RaisedAt.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell>@if (d.MaterialRequisitionId.HasValue) { <a href="/MaterialRequisition/Details/@d.MaterialRequisitionId" dir="ltr">@d.MaterialRequisitionNumber</a> } else { <span class="text-muted">—</span> }</pems-table-cell>
                </pems-table-row>
            }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
