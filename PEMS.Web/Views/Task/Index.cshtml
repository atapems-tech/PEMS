@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TaskItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
    var tab = (string)ViewBag.Tab;
}


<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" asp-route-tab="action" class="btn btn-sm @(tab != "followup" ? "btn-pems-solid" : "btn-outline-secondary")">
        <i class="bi bi-check2-square"></i> Action Items (assigned to me)
    </a>
    <a asp-action="Index" asp-route-tab="followup" class="btn btn-sm @(tab == "followup" ? "btn-pems-solid" : "btn-outline-secondary")">
        <i class="bi bi-eye"></i> Follow-up (assigned by me)
    </a>
</div>

<div class="content-card mb-3">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Task')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="Task">
        <thead>
            <tr>
                <th data-col-key="title" data-resizable="true" data-min-width="160" data-max-width="400">@Localizer["Title"]</th>
                <th data-col-key="assignedTo" data-resizable="true" data-min-width="120" data-max-width="240">@Localizer["Assigned To"]</th>
                <th data-col-key="due" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Due"]</th>
                <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Priority"]</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Status"]</th>
                <th data-col-key="related" data-resizable="true" data-min-width="100" data-max-width="200">Related</th>
                <th></th>
            </tr>
        </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr class="@(t.IsOverdue ? "table-danger" : "")">
                        <td>
                            @t.Title
                            @if (!string.IsNullOrEmpty(t.Description)) { <div class="small text-muted">@t.Description</div> }
                        </td>
                        <td class="small">@t.AssignedToEmployeeName</td>
                        <td class="small">@(t.DueDate?.ToString("yyyy-MM-dd"))</td>
                        <td>
                            @{
                                var pb = t.Priority switch { "Urgent" => "bg-danger", "High" => "bg-warning text-dark", _ => "bg-secondary" };
                            }
                            <span class="badge @pb">@t.Priority</span>
                        </td>
                        <td>
                            @{
                                var sb = t.Status switch { "Completed" => "bg-success", "InProgress" => "bg-info text-dark", "Cancelled" => "bg-dark", _ => "bg-secondary" };
                            }
                            <span class="badge @sb">@t.Status</span>
                            @if (t.IsOverdue) { <span class="badge bg-danger">@Localizer["Overdue"]</span> }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(t.RelatedType))
                            {
                                @if (t.RelatedType == "Letter")
                                { <a asp-controller="Letter" asp-action="Details" asp-route-id="@t.RelatedId">Letter #@t.RelatedId</a> }
                                else
                                { @($"{t.RelatedType} #{t.RelatedId}") }
                            }
                        </td>
                        <td>
                            @if (t.Status != "Completed" && t.Status != "Cancelled")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="taskItemId" value="@t.TaskItemId" />
                                    <input type="hidden" name="tab" value="@tab" />
                                    <select name="status" class="form-select form-select-sm" style="width:110px;" onchange="this.form.submit()">
                                        @foreach (var s in new[] { "Open", "InProgress", "Completed", "Cancelled" })
                                        { <option value="@s" selected="@(s == t.Status)">@s</option> }
                                    </select>
                                </form>
                            }
                            else
                            {
                                @t.CompletionNote
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">No tasks here.</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Task",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = $"tab={Uri.EscapeDataString(tab)}"
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Task');
        });
    </script>
}

@if (tab != "followup")
{
    <div class="content-card">
        <h6 class="mb-3">New Task</h6>
        <form asp-action="Create" method="post" class="row g-2">
            <div class="col-md-4"><input name="title" class="form-control form-control-sm" placeholder="@Localizer["Title"]" required /></div>
            <div class="col-md-3">
                <select name="assignedToEmployeeId" class="form-select form-select-sm">
                    <option value="">@Localizer["-- Assign to --"]</option>
                    @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
                </select>
            </div>
            <div class="col-md-2"><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
            <div class="col-md-2">
                <select name="priority" class="form-select form-select-sm">
                    <option>@Localizer["Normal"]</option><option>@Localizer["Low"]</option><option>@Localizer["High"]</option><option>@Localizer["Urgent"]</option>
                </select>
            </div>
            <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i></button></div>
            <div class="col-12"><input name="description" class="form-control form-control-sm" placeholder="@Localizer["Description (optional)"]" /></div>
        </form>
    </div>
}
