@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TaskItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using PEMS.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var employees = (IEnumerable<PEMS.Application.DTOs.EligibleAssigneeDto>)ViewBag.Employees;
    var tab = (string)ViewBag.Tab;
    var canEdit = ViewBag.CanEdit is true;
    var canCreate = ViewBag.CanCreate is true;
    var followup = tab == "followup";
    var tabs = new[] { new SelectListItem(Localizer["Tm_Tab_Action"].Value, "action"), new SelectListItem(Localizer["Tm_Tab_Followup"].Value, "followup") };
}

@section Styles
{
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-task-manager.css" asp-append-version="true" />
}

@* SCRUM-337: built from the PEMS.UI list-page component; the two tab buttons became the tab filter, "new personal task" opens from the toolbar (popover), the task manager link is in the page menu. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer[followup ? "Tm_Tab_Followup" : "Tm_Tab_Action"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="taskFilter" action="@Url.Action("Index")" count="0" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="taskTab" name="tab" label="@Localizer["Tm_Tab_Action"]" value="@tab" items="@tabs" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="Task" />
                <pems-list-menu id="taskMoreBtn" icon="bi-three-dots" label="@Localizer["Lp_More"]">
                    <li><a class="dropdown-item" asp-controller="TaskManager" asp-action="Index"><pems-icon name="bi-kanban" aria-hidden="true" /> @Localizer["Tm_Title"]</a></li>
                </pems-list-menu>
                @if (!followup && canCreate)
                {
                    <pems-list-popover id="taskNew" icon="bi-plus-lg" label="@Localizer["Tm_NewPersonalTask"]" primary="true">
                        <form asp-action="Create" method="post">
                            <label class="lp-lbl" for="nt-title">@Localizer["Title"]</label>
                            <pems-input scale="small" id="nt-title" name="title" placeholder="@Localizer["Title"]" required maxlength="300" />
                            <label class="lp-lbl mt-2" for="nt-assignee">@Localizer["Assigned To"]</label>
                            <pems-select scale="small" id="nt-assignee" name="assignedToEmployeeId">
                                <option value="">@Localizer["-- Assign to --"]</option>
                                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
                            </pems-select>
                            <label class="lp-lbl mt-2" for="nt-due">@Localizer["Due"]</label>
                            <pems-date id="nt-due" name="dueDate" scale="small" />
                            <label class="lp-lbl mt-2" for="nt-priority">@Localizer["Priority"]</label>
                            <pems-select scale="small" id="nt-priority" name="priority">
                                @foreach (var p in TaskItemPriorities.All) { <option value="@p" selected="@(p == "Normal")">@TaskManagerUi.Priority(Localizer, p)</option> }
                            </pems-select>
                            <label class="lp-lbl mt-2" for="nt-desc">@Localizer["Description (optional)"]</label>
                            <pems-input scale="small" id="nt-desc" name="description" placeholder="@Localizer["Description (optional)"]" maxlength="8000" />
                            <div class="lp-fp-foot px-0 pb-0">
                                <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-plus-lg" aria-hidden="true" /> @Localizer["Tm_Create"]</pems-button>
                            </div>
                        </form>
                    </pems-list-popover>
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Task" empty="@(!Model.Items.Any())" empty-text="@Localizer["Tm_EmptyList"]">
                <thead>
                    <tr>
                        <th data-col-key="title">@Localizer["Title"]</th>
                        <th data-col-key="assignedTo">@Localizer["Assigned To"]</th>
                        <th data-col-key="due">@Localizer["Due"]</th>
                        <th data-col-key="priority">@Localizer["Priority"]</th>
                        <th data-col-key="status">@Localizer["Status"]</th>
                        <th data-col-key="related">@Localizer["Tm_Related"]</th>
                        <th><span class="visually-hidden">@Localizer["Tm_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        var closed = TaskItemStatuses.IsClosed(t.Status);
                        <tr class="@(t.IsOverdue ? "lp-row table-danger" : "lp-row")">
                            <td>
                                @if (t.ItemKey != null) { <span class="tm-key me-1">@t.ItemKey</span> }
                                <a asp-action="Details" asp-route-id="@t.TaskItemId" class="lp-subject">@t.Title</a>
                                @if (!string.IsNullOrEmpty(t.Description)) { <div class="small text-muted text-truncate pems-s-b4a851bd">@t.Description</div> }
                            </td>
                            <td class="small">@t.AssignedToEmployeeName</td>
                            <td class="small">@(t.DueDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))</td>
                            <td>
                                @{
                                    var pb = TaskManagerUi.PriorityBadge(t.Priority);
                                }
                                <pems-badge tone="@pb">@TaskManagerUi.Priority(Localizer, t.Priority)</pems-badge>
                            </td>
                            <td>
                                @{
                                    var sb = t.Status switch { "Completed" => "success", "InProgress" => "info", "Cancelled" => "dark", _ => "neutral" };
                                }
                                <pems-badge tone="@sb">@(t.WorkSpaceId != null ? TaskManagerUi.Name(t.StatusName, t.StatusNameFa) : TaskManagerUi.LegacyStatus(Localizer, t.Status))</pems-badge>
                                @if (t.IsOverdue) { <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge> }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(t.RelatedType))
                                {
                                    @if (t.RelatedType == "Letter")
                                    { <a asp-controller="Letter" asp-action="Details" asp-route-id="@t.RelatedId">@Localizer["Tm_Related_Letter"] #@t.RelatedId</a> }
                                    else if (t.RelatedType == "Meeting")
                                    { <a asp-controller="Meeting" asp-action="Details" asp-route-id="@t.RelatedId">@Localizer["Tm_Related_Meeting"] #@t.RelatedId</a> }
                                    else
                                    { @($"{t.RelatedType} #{t.RelatedId}") }
                                }
                            </td>
                            <td>
                                @if (t.WorkSpaceId != null)
                                {
                                    @* وضعیت وظیفه‌ی فضا از طرح وضعیت همان فضا تغییر می‌کند *@
                                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@t.TaskItemId">@Localizer["Tm_Open"]</pems-button>
                                }
                                else if (canEdit && TaskItemStatuses.Transitions.TryGetValue(t.Status, out var targets) && targets.Length > 0)
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="taskItemId" value="@t.TaskItemId" />
                                        <input type="hidden" name="tab" value="@tab" />
                                        <label class="visually-hidden" for="st-@t.TaskItemId">@Localizer["Tm_MoveTo"]</label>
                                        <pems-select class="pems-w-130" scale="small" id="st-@t.TaskItemId" name="status">
                                            @foreach (var s in targets) { <option value="@s">@TaskManagerUi.LegacyStatus(Localizer, s)</option> }
                                        </pems-select>
                                        <pems-button tone="neutral" size="small" outline="true" aria-label="@Localizer["Tm_ChangeStatus"]"><pems-icon name="bi-check2" aria-hidden="true" /></pems-button>
                                    </form>
                                    @if (closed && !string.IsNullOrEmpty(t.CompletionNote)) { <div class="small text-muted">@t.CompletionNote</div> }
                                }
                                else
                                {
                                    @t.CompletionNote
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Task",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = $"tab={Uri.EscapeDataString(tab)}"
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
