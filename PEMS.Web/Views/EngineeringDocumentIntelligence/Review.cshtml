@model PEMS.Application.DTOs.DocumentIntelligenceDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.DocumentNo &mdash; @Model.Title</h5>
            <pems-badge tone="info" css="mt-1">Stage: @Model.AIWorkflowStage</pems-badge>
            <pems-badge tone="neutral" css="mt-1">Status: @Model.Status</pems-badge>
            @if (!string.IsNullOrWhiteSpace(Model.AIProcessingStatus))
            {
                @* طبق بخش ۴ سند: جدا از Stage/Status - آیا خودِ پردازش AI موفق بود یا نه *@
                var aiBadge = Model.AIProcessingStatus switch
                {
                    "Completed" => "success",
                    "Failed" => "danger",
                    "Processing" => "warning",
                    _ => "neutral"
                };
                <pems-badge tone="@aiBadge" css="mt-1">AI: @Model.AIProcessingStatus</pems-badge>
            }
        </div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.DocumentId">
            <pems-icon name="bi-file-earmark-text" /> Open Document
        </pems-button>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @{
            var stages = new[] { "UnderReview", "CommentOpen", "Revision", "Approved", "KnowledgeBase" };
        }
        @foreach (var s in stages)
        {
            <form asp-action="AdvanceStage" method="post" class="d-inline">
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="newStage" value="@s" />
                <pems-button tone="none" size="small" css="@(s == Model.AIWorkflowStage ? "btn-pems-solid" : "btn-outline-secondary")" type="submit">@s</pems-button>
            </form>
        }
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-robot" /> AI Classification Suggestions</h6>

    @foreach (var c in Model.Classifications)
    {
        <div class="border rounded p-3 mb-2">
            <div class="d-flex justify-content-between">
                <strong>Confidence: @((c.ConfidenceScore).ToString("P0"))</strong>
                @{
                    var cb = c.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                }
                <pems-badge tone="@cb">@c.ReviewStatus</pems-badge>
            </div>

            @if (c.ReviewStatus == "Draft")
            {
                <form asp-action="ApproveClassification" method="post" class="row g-2 mt-2">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="classificationId" value="@c.AIDocumentClassificationId" />

                    <pems-col md="6" css="form-check">
                        <pems-input kind="check" type="checkbox" name="applyDiscipline" value="true" checked id="d_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="d_@c.AIDocumentClassificationId">Discipline: <strong>@c.PredictedDisciplineCode</strong></label>
                    </pems-col>
                    <pems-col md="6" css="form-check">
                        <pems-input type="checkbox" name="applyVendor" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedVendorName))" id="v_@c.AIDocumentClassificationId" kind="check" />
                        <label class="form-check-label" for="v_@c.AIDocumentClassificationId">Vendor: <strong>@(c.PredictedVendorName ?? "-")</strong></label>
                    </pems-col>
                    <pems-col md="6" css="form-check">
                        <pems-input type="checkbox" name="applyMR" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedMRNumber))" id="mr_@c.AIDocumentClassificationId" kind="check" />
                        <label class="form-check-label" for="mr_@c.AIDocumentClassificationId">Related MR: <strong>@(c.PredictedMRNumber ?? "-")</strong></label>
                    </pems-col>
                    <pems-col md="6" css="form-check">
                        <pems-input type="checkbox" name="applyRevision" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedRevisionNo))" id="r_@c.AIDocumentClassificationId" kind="check" />
                        <label class="form-check-label" for="r_@c.AIDocumentClassificationId">Revision: <strong>@(c.PredictedRevisionNo ?? "-")</strong></label>
                    </pems-col>
                    <pems-col md="6" css="form-check">
                        <pems-input type="checkbox" name="applyIssuePurpose" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedIssuePurpose))" id="ip_@c.AIDocumentClassificationId" kind="check" />
                        <label class="form-check-label" for="ip_@c.AIDocumentClassificationId">Issue Purpose: <strong>@(c.PredictedIssuePurpose ?? "-")</strong></label>
                    </pems-col>
                    <pems-col md="6"><span class="text-muted small">Document Type: <strong>@c.PredictedDocumentType</strong> (always applied)</span></pems-col>

                    <pems-col span="12" css="mt-2">
                        <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> Approve &amp; Apply</pems-button>
                    </pems-col>
                </form>

                <form asp-action="RejectClassification" method="post" class="mt-1">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="classificationId" value="@c.AIDocumentClassificationId" />
                    <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                </form>
            }
        </div>
    }
    @if (!Model.Classifications.Any()) { <p class="text-muted">No AI classification suggestions yet.</p> }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-tags" /> Related Equipment Tags (AVEVA-style multi-tag linking)</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead><tr><th>@Localizer["Tag Number"]</th><th>@Localizer["Source"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model.TagLinks)
            {
                <tr>
                    <td>@t.TagNumber</td>
                    <td>@(t.IsAIProposed ? "AI Proposed" : "Manual")</td>
                    <td>
                        @{
                            var tb = t.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                        }
                        <pems-badge tone="@tb">@t.ReviewStatus</pems-badge>
                    </td>
                    <td>
                        @if (t.IsAIProposed && t.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveTagLink" method="post" class="d-inline">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="tagLinkId" value="@t.EngineeringDocumentTagLinkId" />
                                <pems-button tone="success" size="small">@Localizer["Approve"]</pems-button>
                            </form>
                            <form asp-action="RejectTagLink" method="post" class="d-inline">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="tagLinkId" value="@t.EngineeringDocumentTagLinkId" />
                                <pems-button tone="danger" size="small" outline="true">@Localizer["Reject"]</pems-button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.TagLinks.Any()) { <p class="text-muted">No equipment tags detected or linked yet.</p> }
</div>

<div class="content-card">
    <h6 class="mb-3"><pems-icon name="bi-chat-dots" /> Comment Management</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead><tr><th>@Localizer["Comment"]</th><th>@Localizer["Raised By"]</th><th>@Localizer["Date"]</th><th>@Localizer["Action Status"]</th><th>@Localizer["Response"]</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Comments)
            {
                <tr>
                    <td>@c.CommentText</td>
                    <td>@c.RaisedByName</td>
                    <td>@c.RaisedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var ab = c.ActionStatus switch { "Closed" => "success", "Verified" => "info", "ResponsePending" => "warning", "NoActionRequired" => "neutral", _ => "danger" };
                        }
                        <pems-badge tone="@ab">@c.ActionStatus</pems-badge>
                        <form asp-action="SetCommentAction" method="post" class="d-inline">
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="commentId" value="@c.EngineeringDocumentCommentId" />
                            <pems-select class="pems-w-160" scale="small" css="mt-1" name="actionStatus" onchange="this.form.submit()">
                                @foreach (var s in new[] { "OpenComment", "ResponsePending", "Verified", "Closed", "NoActionRequired" })
                                { <option value="@s" selected="@(s == c.ActionStatus)">@s</option> }
                            </pems-select>
                        </form>
                    </td>
                    <td class="small">
                        @c.ResponseText
                        @if (string.IsNullOrEmpty(c.ResponseText))
                        {
                            <form asp-action="RecordCommentResponse" method="post" class="d-flex gap-1 mt-1">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="commentId" value="@c.EngineeringDocumentCommentId" />
                                <pems-input scale="small" name="responseText" placeholder="@Localizer["Response..."]" />
                                <pems-button tone="primary" size="small" outline="true">@Localizer["Save"]</pems-button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.Comments.Any()) { <p class="text-muted">No comments yet.</p> }

    <form asp-action="AddComment" method="post" class="row g-2 mt-2">
        <input type="hidden" name="documentId" value="@Model.DocumentId" />
        <pems-col md="9"><pems-input scale="small" name="commentText" placeholder="New comment..." required /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100">@Localizer["Add Comment"]</pems-button></pems-col>
    </form>
</div>
