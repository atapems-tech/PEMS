@model PEMS.Application.DTOs.DocumentIntelligenceDetailDto


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.DocumentNo &mdash; @Model.Title</h5>
            <span class="badge bg-info text-dark mt-1">Stage: @Model.AIWorkflowStage</span>
            <span class="badge bg-secondary mt-1">Status: @Model.Status</span>
            @if (!string.IsNullOrWhiteSpace(Model.AIProcessingStatus))
            {
                @* طبق بخش ۴ سند: جدا از Stage/Status - آیا خودِ پردازش AI موفق بود یا نه *@
                var aiBadge = Model.AIProcessingStatus switch
                {
                    "Completed" => "bg-success",
                    "Failed" => "bg-danger",
                    "Processing" => "bg-warning text-dark",
                    _ => "bg-secondary"
                };
                <span class="badge @aiBadge mt-1">AI: @Model.AIProcessingStatus</span>
            }
        </div>
        <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-text"></i> Open Document
        </a>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @{
            var stages = new[] { "UnderReview", "CommentOpen", "Revision", "Approved", "KnowledgeBase" };
        }
        @foreach (var s in stages)
        {
            <form asp-action="AdvanceStage" method="post" class="d-inline">
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="newStage" value="@s" />
                <button type="submit" class="btn btn-sm @(s == Model.AIWorkflowStage ? "btn-pems-solid" : "btn-outline-secondary")">@s</button>
            </form>
        }
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-robot"></i> AI Classification Suggestions</h6>

    @foreach (var c in Model.Classifications)
    {
        <div class="border rounded p-3 mb-2">
            <div class="d-flex justify-content-between">
                <strong>Confidence: @((c.ConfidenceScore).ToString("P0"))</strong>
                @{
                    var cb = c.ReviewStatus switch { "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
                }
                <span class="badge @cb">@c.ReviewStatus</span>
            </div>

            @if (c.ReviewStatus == "Draft")
            {
                <form asp-action="ApproveClassification" method="post" class="row g-2 mt-2">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="classificationId" value="@c.AIDocumentClassificationId" />

                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="applyDiscipline" value="true" checked id="d_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="d_@c.AIDocumentClassificationId">Discipline: <strong>@c.PredictedDisciplineCode</strong></label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="applyVendor" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedVendorName))" id="v_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="v_@c.AIDocumentClassificationId">Vendor: <strong>@(c.PredictedVendorName ?? "-")</strong></label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="applyMR" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedMRNumber))" id="mr_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="mr_@c.AIDocumentClassificationId">Related MR: <strong>@(c.PredictedMRNumber ?? "-")</strong></label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="applyRevision" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedRevisionNo))" id="r_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="r_@c.AIDocumentClassificationId">Revision: <strong>@(c.PredictedRevisionNo ?? "-")</strong></label>
                    </div>
                    <div class="col-md-6 form-check">
                        <input class="form-check-input" type="checkbox" name="applyIssuePurpose" value="true" checked="@(!string.IsNullOrEmpty(c.PredictedIssuePurpose))" id="ip_@c.AIDocumentClassificationId" />
                        <label class="form-check-label" for="ip_@c.AIDocumentClassificationId">Issue Purpose: <strong>@(c.PredictedIssuePurpose ?? "-")</strong></label>
                    </div>
                    <div class="col-md-6"><span class="text-muted small">Document Type: <strong>@c.PredictedDocumentType</strong> (always applied)</span></div>

                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve &amp; Apply</button>
                    </div>
                </form>

                <form asp-action="RejectClassification" method="post" class="mt-1">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="classificationId" value="@c.AIDocumentClassificationId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                </form>
            }
        </div>
    }
    @if (!Model.Classifications.Any()) { <p class="text-muted">No AI classification suggestions yet.</p> }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-tags"></i> Related Equipment Tags (AVEVA-style multi-tag linking)</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Tag Number</th><th>Source</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model.TagLinks)
            {
                <tr>
                    <td>@t.TagNumber</td>
                    <td>@(t.IsAIProposed ? "AI Proposed" : "Manual")</td>
                    <td>
                        @{
                            var tb = t.ReviewStatus switch { "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
                        }
                        <span class="badge @tb">@t.ReviewStatus</span>
                    </td>
                    <td>
                        @if (t.IsAIProposed && t.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveTagLink" method="post" class="d-inline">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="tagLinkId" value="@t.EngineeringDocumentTagLinkId" />
                                <button class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form asp-action="RejectTagLink" method="post" class="d-inline">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="tagLinkId" value="@t.EngineeringDocumentTagLinkId" />
                                <button class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.TagLinks.Any()) { <p class="text-muted">No equipment tags detected or linked yet.</p> }
</div>

<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-chat-dots"></i> Comment Management</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Comment</th><th>Raised By</th><th>Date</th><th>Action Status</th><th>Response</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Comments)
            {
                <tr>
                    <td>@c.CommentText</td>
                    <td>@c.RaisedByName</td>
                    <td>@c.RaisedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var ab = c.ActionStatus switch { "Closed" => "bg-success", "Verified" => "bg-info text-dark", "ResponsePending" => "bg-warning text-dark", "NoActionRequired" => "bg-secondary", _ => "bg-danger" };
                        }
                        <span class="badge @ab">@c.ActionStatus</span>
                        <form asp-action="SetCommentAction" method="post" class="d-inline">
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="commentId" value="@c.EngineeringDocumentCommentId" />
                            <select name="actionStatus" class="form-select form-select-sm mt-1" style="width:160px;" onchange="this.form.submit()">
                                @foreach (var s in new[] { "OpenComment", "ResponsePending", "Verified", "Closed", "NoActionRequired" })
                                { <option value="@s" selected="@(s == c.ActionStatus)">@s</option> }
                            </select>
                        </form>
                    </td>
                    <td class="small">
                        @c.ResponseText
                        @if (string.IsNullOrEmpty(c.ResponseText))
                        {
                            <form asp-action="RecordCommentResponse" method="post" class="d-flex gap-1 mt-1">
                                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                                <input type="hidden" name="commentId" value="@c.EngineeringDocumentCommentId" />
                                <input name="responseText" class="form-control form-control-sm" placeholder="Response..." />
                                <button class="btn btn-sm btn-outline-primary">Save</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Comments.Any()) { <p class="text-muted">No comments yet.</p> }

    <form asp-action="AddComment" method="post" class="row g-2 mt-2">
        <input type="hidden" name="documentId" value="@Model.DocumentId" />
        <div class="col-md-9"><input name="commentText" class="form-control form-control-sm" placeholder="New comment..." required /></div>
        <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100">Add Comment</button></div>
    </form>
</div>
