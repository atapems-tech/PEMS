@model List<PEMS.Application.DTOs.DocumentIntelligenceDetailDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.DTOs.DocumentIntelligenceDashboardDto)ViewBag.Dashboard;
}


<div class="row g-3 mb-3">
    <div class="col-md-3 col-sm-6">
        <pems-kpi-tile icon="bi-file-earmark-text" color="slate" label="Total Documents">@dash.TotalDocuments</pems-kpi-tile>
    </div>
    <div class="col-md-3 col-sm-6">
        <pems-kpi-tile icon="bi-robot" color="amber" label="Pending AI Classification Review">@dash.PendingClassificationReview</pems-kpi-tile>
    </div>
    <div class="col-md-3 col-sm-6">
        <pems-kpi-tile icon="bi-tags" color="purple" label="Pending Tag Links">@dash.PendingTagLinkReview</pems-kpi-tile>
    </div>
    <div class="col-md-3 col-sm-6">
        <pems-kpi-tile icon="bi-chat-dots" color="red" label="Open Comments">@dash.OpenComments</pems-kpi-tile>
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Documents by Workflow Stage</h6>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var s in new[] { "Uploaded", "AIProcessing", "Classified", "DisciplineAssigned", "UnderReview", "CommentOpen", "Revision", "Approved", "KnowledgeBase" })
        {
            var count = dash.ByStage.TryGetValue(s, out var c) ? c : 0;
            <pems-badge tone="neutral" css="p-2">@s: @count</pems-badge>
        }
    </div>
</div>

<div class="content-card">
    <p class="text-muted">
        مدارکی که تحلیل AI روی آن‌ها کامل شده و منتظر بازبینی مهندسی هستند (Discipline, Vendor, MR,
        Revision, Tag های پیشنهادی).
    </p>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Doc No"]</th><th>@Localizer["Title"]</th><th>@Localizer["Stage"]</th><th>Pending Classifications</th><th>@Localizer["Pending Tags"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.DocumentNo</td>
                        <td>@d.Title</td>
                        <td><pems-badge tone="info">@d.AIWorkflowStage</pems-badge></td>
                        <td><pems-badge tone="warning">@d.Classifications.Count(c => c.ReviewStatus == "Draft")</pems-badge></td>
                        <td><pems-badge tone="warning">@d.TagLinks.Count(t => t.IsAIProposed && t.ReviewStatus == "Draft")</pems-badge></td>
                        <td><pems-button tone="primary" size="small" as="a" asp-action="Review" asp-route-id="@d.DocumentId">Review</pems-button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted text-center py-4">No documents pending AI classification review.</p> }
    </div>
</div>
