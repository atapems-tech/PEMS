@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value })</div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project"]</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Vendor"]</label>
                <input type="text" class="form-control" placeholder="@Localizer["جستجوی نام وندور..."]"
                       data-pems-search data-search-type="Vendor" data-search-hidden="#contractVendorIdHidden" autocomplete="off" required />
                <input type="hidden" name="vendorId" id="contractVendorIdHidden" />
            </div>
            <div class="col-md-6"><label class="form-label">@Localizer["Value"]</label><input name="value" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="startDate" type="date" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["End Date"]</label><input name="endDate" type="date" class="form-control" /></div>
            <div class="col-12"><label class="form-label">@Localizer["Scope of Work"]</label><textarea name="scope" class="form-control" rows="3"></textarea></div>
            <div class="col-12 form-check">
                <input type="checkbox" name="requiresInspection" value="true" class="form-check-input" id="reqInspection" />
                <label class="form-check-label" for="reqInspection">@Localizer["Requires Inspection"]</label>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
