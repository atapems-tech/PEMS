@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
}

<div class="content-card pems-s-bcaa1805">
    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value })</pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Vendor"]</pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی نام وندور..."]" data-pems-search data-search-type="Vendor" data-search-hidden="#contractVendorIdHidden" autocomplete="off" required />
                <input type="hidden" name="vendorId" id="contractVendorIdHidden" />
            </pems-col>
            <pems-col md="6"><pems-label>@Localizer["Value"]</pems-label><pems-input name="value" type="number" step="0.01" /></pems-col>
            <pems-col md="6"><pems-label>@Localizer["Start Date"]</pems-label><pems-date name="startDate" /></pems-col>
            <pems-col md="6"><pems-label>@Localizer["End Date"]</pems-label><pems-date name="endDate" /></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Scope of Work"]</pems-label><pems-textarea name="scope" rows="3"></pems-textarea></pems-col>
            <pems-col span="12" css="form-check">
                <pems-input kind="check" type="checkbox" name="requiresInspection" value="true" id="reqInspection" />
                <label class="form-check-label" for="reqInspection">@Localizer["Requires Inspection"]</label>
            </pems-col>
        </pems-row>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
