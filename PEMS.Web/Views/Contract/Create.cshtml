@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value })</div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project"]</label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Vendor"]</label>
                <pems-input type="text" placeholder="@Localizer["جستجوی نام وندور..."]" data-pems-search data-search-type="Vendor" data-search-hidden="#contractVendorIdHidden" autocomplete="off" required />
                <input type="hidden" name="vendorId" id="contractVendorIdHidden" />
            </div>
            <div class="col-md-6"><label class="form-label">@Localizer["Value"]</label><pems-input name="value" type="number" step="0.01" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="startDate" type="date" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["End Date"]</label><input name="endDate" type="date" class="form-control" /></div>
            <div class="col-12"><label class="form-label">@Localizer["Scope of Work"]</label><pems-textarea name="scope" rows="3"></pems-textarea></div>
            <div class="col-12 form-check">
                <pems-input kind="check" type="checkbox" name="requiresInspection" value="true" id="reqInspection" />
                <label class="form-check-label" for="reqInspection">@Localizer["Requires Inspection"]</label>
            </div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
