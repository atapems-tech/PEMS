@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ContractDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<div class="content-card">
    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Contract')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createContractModal">
            <i class="bi bi-plus-lg"></i> @Localizer["New Contract"]
        </button>
    </div>
    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Contract">
            <thead>
                <tr>
                    <th data-col-key="contractNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Contract No"]</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Project"]</th>
                    <th data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Vendor"]</th>
                    <th data-col-key="value" data-resizable="true" data-min-width="90" data-max-width="180" style="width:130px">@Localizer["Value"]</th>
                    <th data-col-key="start" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Start"]</th>
                    <th data-col-key="end" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["End"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180" style="width:110px">@Localizer["Status"]</th>
                    <th data-col-key="actions" data-resizable="false" style="width:60px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.ContractNo</td>
                        <td>@c.ProjectName</td>
                        <td>@c.VendorName</td>
                        <td>@(c.ContractValue.HasValue ? $"{c.ContractValue:N0} {c.Currency}" : "-")</td>
                        <td>@(c.StartDate?.ToString("yyyy-MM-dd"))</td>
                        <td>@(c.EndDate?.ToString("yyyy-MM-dd"))</td>
                        <td><span class="badge bg-secondary">@c.Status</span></td>
                        <td><a asp-action="Details" asp-route-id="@c.ContractId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["No contracts yet."]</p> }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Contract",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Contract');
        });
    </script>
}

<div class="modal fade" id="createContractModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Contract" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Contract"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">@Localizer["Contract No"]</label><input name="contractNo" class="form-control" required /></div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="projectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Vendor"]</label>
                            <input type="text" class="form-control" placeholder="@Localizer["جستجوی نام وندور..."]"
                                   data-pems-search data-search-type="Vendor" data-search-hidden="#contractIdxVendorIdHidden" autocomplete="off" required />
                            <input type="hidden" name="vendorId" id="contractIdxVendorIdHidden" />
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Value"]</label><input name="value" type="number" step="0.01" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="startDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["End Date"]</label><input name="endDate" type="date" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Scope of Work"]</label><textarea name="scope" class="form-control" rows="3"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
