@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ContractDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusText(string? s) => VdrUi.Loc(Localizer, "CtL_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Signed" or "Effective" => "vs-pill--success",
        "Completed" or "Closed" => "vs-pill--info",
        "UnderReview" => "vs-pill--warning",
        "Terminated" or "Cancelled" => "vs-pill--danger",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns, paging and the create modal
   (opened by New; it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["CtL_Title"]" heading-title="@Localizer["CtL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Contract" />
                <pems-list-new modal="createContractModal" text="@Localizer["CtL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Contract" empty="@(!Model.Items.Any())" empty-text="@Localizer["CtL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="contractNo" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["CtL_No"]</pems-table-header>
                        <pems-table-header data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="260" class="vs-hide-md">@Localizer["Ed_Project"]</pems-table-header>
                        <pems-table-header data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="260">@Localizer["CtL_Vendor"]</pems-table-header>
                        <pems-table-header data-col-key="value" data-resizable="true" data-min-width="90" data-max-width="180" class="text-end pems-w-140">@Localizer["CtL_Value"]</pems-table-header>
                        <pems-table-header data-col-key="start" data-resizable="true" data-min-width="90" data-max-width="160" class="vs-hide-md pems-w-110">@Localizer["CtL_Start"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="end" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["CtL_End"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var c in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@c.ContractId" class="lp-subject" title="@c.ContractNo">@c.ContractNo</a></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@c.ProjectName</pems-table-cell>
                            <pems-table-cell class="small">@c.VendorName</pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@(c.ContractValue.HasValue ? $"{c.ContractValue:N0} {c.Currency}" : "-")</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@(c.StartDate?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@(c.EndDate?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(c.Status)">@StatusText(c.Status)</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <a asp-action="Details" asp-route-id="@c.ContractId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><pems-icon name="bi-eye" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Contract",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal size="large" id="createContractModal" tabindex="-1">
            <form asp-controller="Contract" asp-action="Create" method="post">
                <pems-modal-header>@Localizer["New Contract"]</pems-modal-header>
                <pems-modal-body>
                    <pems-row gap="3">
                        <pems-col md="6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value })</pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Project"]</pems-label>
                            <pems-select name="projectId" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Vendor"]</pems-label>
                            <pems-input type="text" placeholder="@Localizer["جستجوی نام وندور..."]" data-pems-search data-search-type="Vendor" data-search-hidden="#contractIdxVendorIdHidden" autocomplete="off" required />
                            <input type="hidden" name="vendorId" id="contractIdxVendorIdHidden" />
                        </pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Value"]</pems-label><pems-input name="value" type="number" step="0.01" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Start Date"]</pems-label><pems-date name="startDate" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["End Date"]</pems-label><pems-date name="endDate" /></pems-col>
                        <pems-col span="12"><pems-label>@Localizer["Scope of Work"]</pems-label><pems-textarea name="scope" rows="3"></pems-textarea></pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
