@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ContractDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusText(string? s) => VdrUi.Loc(Localizer, "CtL_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Signed" or "Effective" => "vs-pill--success",
        "Completed" or "Closed" => "vs-pill--info",
        "UnderReview" => "vs-pill--warning",
        "Terminated" or "Cancelled" => "vs-pill--danger",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns, paging and the create modal
   (opened by New; it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["CtL_Title"]" heading-title="@Localizer["CtL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Contract" />
                <pems-list-new modal="createContractModal" text="@Localizer["CtL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Contract" empty="@(!Model.Items.Any())" empty-text="@Localizer["CtL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="contractNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["CtL_No"]</th>
                        <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="260" class="vs-hide-md">@Localizer["Ed_Project"]</th>
                        <th data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="260">@Localizer["CtL_Vendor"]</th>
                        <th data-col-key="value" data-resizable="true" data-min-width="90" data-max-width="180" style="width:140px" class="text-end">@Localizer["CtL_Value"]</th>
                        <th data-col-key="start" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px" class="vs-hide-md">@Localizer["CtL_Start"]</th>
                        <th data-col-key="end" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["CtL_End"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@c.ContractId" class="lp-subject" title="@c.ContractNo">@c.ContractNo</a></td>
                            <td class="small vs-hide-md">@c.ProjectName</td>
                            <td class="small">@c.VendorName</td>
                            <td class="text-end"><span class="vs-num">@(c.ContractValue.HasValue ? $"{c.ContractValue:N0} {c.Currency}" : "-")</span></td>
                            <td class="small vs-hide-md"><span class="vs-num">@(c.StartDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td class="small"><span class="vs-num">@(c.EndDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td><span class="vs-pill @StatusTone(c.Status)">@StatusText(c.Status)</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@c.ContractId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Contract",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createContractModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Contract" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Contract"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value })</div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="projectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Vendor"]</label>
                            <input type="text" class="form-control" placeholder="@Localizer["جستجوی نام وندور..."]"
                                   data-pems-search data-search-type="Vendor" data-search-hidden="#contractIdxVendorIdHidden" autocomplete="off" required />
                            <input type="hidden" name="vendorId" id="contractIdxVendorIdHidden" />
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Value"]</label><input name="value" type="number" step="0.01" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="startDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["End Date"]</label><input name="endDate" type="date" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Scope of Work"]</label><textarea name="scope" class="form-control" rows="3"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
