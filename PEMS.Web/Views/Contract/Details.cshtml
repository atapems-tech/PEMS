@model PEMS.Application.DTOs.ContractDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var disciplineReviews = (IEnumerable<PEMS.Domain.Entities.ContractDisciplineReview>)(ViewBag.DisciplineReviews ?? Array.Empty<PEMS.Domain.Entities.ContractDisciplineReview>());
    var revisions = (IEnumerable<PEMS.Domain.Entities.ContractRevision>)(ViewBag.Revisions ?? Array.Empty<PEMS.Domain.Entities.ContractRevision>());
    var contractDocuments = (IEnumerable<PEMS.Domain.Entities.ContractDocument>)(ViewBag.ContractDocuments ?? Array.Empty<PEMS.Domain.Entities.ContractDocument>());
    var ntps = (IEnumerable<PEMS.Domain.Entities.ContractNTP>)(ViewBag.ContractNTPs ?? Array.Empty<PEMS.Domain.Entities.ContractNTP>());
    var kickoffs = (IEnumerable<PEMS.Domain.Entities.Meeting>)(ViewBag.KickoffMeetings ?? Array.Empty<PEMS.Domain.Entities.Meeting>());
    var linkedItps = (IEnumerable<PEMS.Domain.Entities.InspectionTestPlan>)(ViewBag.LinkedItps ?? Array.Empty<PEMS.Domain.Entities.InspectionTestPlan>());
    var originatingTender = (PEMS.Domain.Entities.Tender?)ViewBag.OriginatingTender;

    var statusBadge = Model.Status switch
    {
        "Draft" => "bg-secondary",
        "UnderReview" => "bg-info text-dark",
        "Approved" => "bg-primary",
        "Signed" => "bg-warning text-dark",
        "Effective" => "bg-success",
        "Completed" => "bg-dark",
        "Terminated" => "bg-danger",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger">@TempData["Error"]</pems-alert>
}

@* ================= PROCUREMENT ORIGIN ================= *@
@* طبق ممیزی نهایی Ownership (§2/§6): Contract هیچ FK مستقیمی به ProcurementPackage ندارد -
   Tender.ContractId تنها منبع حقیقت این رابطه است (Phase 3). این بخش همان رابطه‌ی موجود را
   از جهت معکوس نشان می‌دهد - نه یک FK تازه. *@
@if (originatingTender != null)
{
    <div class="content-card mb-3">
        <h6 class="text-muted small mb-2">@Localizer["Procurement Origin"]</h6>
        <div class="row g-2">
            <div class="col-md-3">
                <div class="small text-muted">@Localizer["Package"]</div>
                <a asp-controller="ProcurementPackage" asp-action="Details" asp-route-id="@originatingTender.ProcurementPackageId">@originatingTender.ProcurementPackage?.PackageNumber</a>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">@Localizer["Tender"]</div>
                <a asp-controller="Tender" asp-action="Details" asp-route-id="@originatingTender.TenderId">@originatingTender.TenderNumber</a>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">@Localizer["Awarded Bid"]</div>
                <span>@originatingTender.AwardedBid?.BidNumber</span>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">@Localizer["Awarded"]</div>
                <span>@originatingTender.AwardedDate?.ToString("yyyy-MM-dd")</span>
            </div>
        </div>
    </div>
}

@* ================= CONTRACT INFORMATION ================= *@
<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Relationship" asp-action="Contract" asp-route-id="@Model.ContractId"><i class="bi bi-diagram-3"></i> @Localizer["Cm_Relationships"]</pems-button>
    </div>
    <div class="row g-3">
        <div class="col-md-4"><strong>Contract No:</strong> @Model.ContractNo</div>
        <div class="col-md-4"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-4"><strong>Vendor:</strong> @Model.VendorName</div>
        <div class="col-md-4"><strong>Value:</strong> @(Model.ContractValue.HasValue ? $"{Model.ContractValue:N0} {Model.Currency}" : "-")</div>
        <div class="col-md-4"><strong>Start / End:</strong> @Model.StartDate?.ToString("yyyy-MM-dd") &rarr; @Model.EndDate?.ToString("yyyy-MM-dd")</div>
        <div class="col-md-4">
            <strong>@Localizer["Status:"]</strong>
            <pems-badge tone="none" css="@statusBadge">@Model.Status</pems-badge>
            @if (Model.RequiresInspection)
            {
                <pems-badge tone="warning">@Localizer["Requires Inspection"]</pems-badge>
            }
        </div>
        <div class="col-12"><strong>@Localizer["Scope:"]</strong> @Model.ScopeOfWork</div>
    </div>

    <hr />

    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status == "Draft" || Model.Status == "Rejected")
        {
            <form asp-action="SubmitForReview" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Submit for Multi-Discipline Review"]</pems-button>
            </form>
        }
        @if (Model.Status == "UnderReview")
        {
            <form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="success" size="small" type="submit">@Localizer["Final Approve"]</pems-button>
            </form>
            <form asp-action="Reject" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject (back to Draft)"]</pems-button>
            </form>
        }
        @if (Model.Status == "Approved")
        {
            <form asp-action="Sign" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="warning" size="small" type="submit">@Localizer["Sign Contract"]</pems-button>
            </form>
        }
        @if (Model.Status == "Signed")
        {
            <form asp-action="MarkEffective" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="success" size="small" type="submit">@Localizer["Mark Effective"]</pems-button>
            </form>
        }
        @if (Model.Status == "Effective")
        {
            <form asp-action="Complete" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="dark" size="small" type="submit">@Localizer["Complete Contract"]</pems-button>
            </form>
        }
        @if (Model.Status != "Completed" && Model.Status != "Terminated")
        {
            <form asp-action="Terminate" method="post" class="d-flex gap-1 align-items-center">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <input type="text" name="reason" class="form-control form-control-sm" placeholder="@Localizer["Reason"]" style="width:160px" />
                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Terminate Contract"]</pems-button>
            </form>
        }
    </div>
</div>

@* ================= DISCIPLINE REVIEWS & APPROVAL ================= *@
@if (Model.Status == "UnderReview" && disciplineReviews.Any())
{
    <div class="content-card mt-3">
        <h6>@Localizer["Multi-Discipline Review"]</h6>
        <table class="table table-sm">
            <thead><tr><th>@Localizer["Discipline"]</th><th>@Localizer["Reviewer"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Comment"]</th><th>@Localizer["Date"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in disciplineReviews)
                {
                    <tr>
                        <td>@r.DisciplineRole</td>
                        <td>@(r.Reviewer != null ? r.Reviewer.FirstName + " " + r.Reviewer.LastName : "-")</td>
                        <td><pems-badge tone="@(r.Decision == "Approved" ? "success" : r.Decision == "Rejected" ? "danger" : "neutral")">@r.Decision</pems-badge></td>
                        <td>@r.Comment</td>
                        <td>@r.ReviewDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (r.Decision == "Pending")
                            {
                                <form asp-action="RecordDisciplineReview" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                                    <input type="hidden" name="disciplineRole" value="@r.DisciplineRole" />
                                    <pems-button tone="success" size="small" type="submit" name="decision" value="Approve">@Localizer["Approve"]</pems-button>
                                    <pems-button tone="danger" size="small" type="submit" name="decision" value="Reject">@Localizer["Reject"]</pems-button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ================= DOCUMENTS & REVISIONS (Change Orders) ================= *@
<div class="content-card mt-3">
    <h6>@Localizer["Contract Documents"]</h6>
    @if (contractDocuments.Any())
    {
        <table class="table table-sm">
            <thead><tr><th>@Localizer["Doc No"]</th><th>@Localizer["Title"]</th><th>@Localizer["Type"]</th><th>@Localizer["Clause Reference"]</th><th>@Localizer["Status"]</th></tr></thead>
            <tbody>
                @foreach (var d in contractDocuments)
                {
                    <tr>
                        <td>@d.DocumentNo</td>
                        <td>@d.Title</td>
                        <td>@d.DocumentType</td>
                        <td>@d.ClauseReference</td>
                        <td>@d.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <form asp-action="AddDocument" method="post" class="row g-2">
        <input type="hidden" name="contractId" value="@Model.ContractId" />
        <div class="col-md-2"><input type="text" name="documentNo" class="form-control form-control-sm" placeholder="@Localizer["Doc No"]" required /></div>
        <div class="col-md-3"><input type="text" name="title" class="form-control form-control-sm" placeholder="@Localizer["Title"]" required /></div>
        <div class="col-md-2"><input type="text" name="documentType" class="form-control form-control-sm" placeholder="@Localizer["Type"]" required /></div>
        <div class="col-md-3"><input type="text" name="clauseReference" class="form-control form-control-sm" placeholder="@Localizer["Clause Reference"]" /></div>
        <div class="col-md-2"><pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Add Document"]</pems-button></div>
    </form>
</div>

@if (Model.Status == "Signed" || Model.Status == "Effective")
{
    <div class="content-card mt-3">
        <h6>@Localizer["Request Value Change (Variation / Change Order)"]</h6>
        <form asp-action="RequestRevision" method="post" class="row g-2">
            <input type="hidden" name="contractId" value="@Model.ContractId" />
            <div class="col-md-3">
                <select name="changeType" class="form-select form-select-sm">
                    <option value="Variation">@Localizer["Variation"]</option>
                    <option value="ChangeOrder">@Localizer["Change Order"]</option>
                    <option value="Amendment">@Localizer["Amendment"]</option>
                </select>
            </div>
            <div class="col-md-2"><input type="number" step="0.01" name="newValue" class="form-control form-control-sm" placeholder="@Localizer["New value"]" /></div>
            <div class="col-md-3"><input type="text" name="reason" class="form-control form-control-sm" placeholder="@Localizer["Reason"]" /></div>
            <div class="col-md-3"><input type="text" name="changeDescription" class="form-control form-control-sm" placeholder="@Localizer["Description"]" /></div>
            <div class="col-md-1"><pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Request"]</pems-button></div>
        </form>
    </div>
}

@if (revisions.Any())
{
    <div class="content-card mt-3">
        <h6>@Localizer["Revision History (Original value never overwritten)"]</h6>
        <table class="table table-sm">
            <thead><tr><th>#</th><th>@Localizer["Type"]</th><th>@Localizer["Previous"]</th><th>@Localizer["New"]</th><th>@Localizer["Reason"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in revisions)
                {
                    <tr>
                        <td>@r.RevisionNo</td>
                        <td>@r.ChangeType</td>
                        <td>@r.PreviousValue?.ToString("N0")</td>
                        <td>@r.NewValue?.ToString("N0")</td>
                        <td>@r.Reason</td>
                        <td><pems-badge tone="@(r.Status == "Approved" ? "success" : "neutral")">@r.Status</pems-badge></td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <form asp-action="ApproveRevision" method="post" class="d-inline">
                                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                                    <input type="hidden" name="contractRevisionId" value="@r.ContractRevisionId" />
                                    <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ================= EXECUTION: NTP / KICK-OFF / ITP ================= *@
<div class="content-card mt-3">
    <h6>@Localizer["Execution"]</h6>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="small text-muted mb-1">@Localizer["Notice to Proceed (NTP)"]</div>
            @if (ntps.Any())
            {
                <ul class="list-unstyled mb-2">
                    @foreach (var n in ntps)
                    {
                        <li>@n.NTPNumber — <pems-badge tone="neutral">@n.Status</pems-badge> (@n.IssuedDate.ToString("yyyy-MM-dd"))</li>
                    }
                </ul>
            }
            @if (Model.Status == "Signed" || Model.Status == "Effective")
            {
                <form asp-action="IssueNtp" method="post" class="d-flex gap-1">
                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                    <input type="text" name="reference" class="form-control form-control-sm" placeholder="@Localizer["Reference"]" />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Issue NTP"]</pems-button>
                </form>
            }
        </div>
        <div class="col-md-6">
            <div class="small text-muted mb-1">@Localizer["Kick-off Meeting"]</div>
            @if (kickoffs.Any())
            {
                <ul class="list-unstyled mb-2">
                    @foreach (var m in kickoffs)
                    {
                        <li><a asp-controller="Meeting" asp-action="Details" asp-route-id="@m.MeetingId">@m.Title</a> — <pems-badge tone="neutral">@m.Status</pems-badge> (@m.MeetingDate.ToString("yyyy-MM-dd"))</li>
                    }
                </ul>
            }
            @if (Model.Status == "Signed" || Model.Status == "Effective")
            {
                <form asp-action="ScheduleKickoff" method="post" class="d-flex gap-1">
                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                    <input type="date" name="meetingDate" class="form-control form-control-sm" required />
                    <input type="text" name="location" class="form-control form-control-sm" placeholder="@Localizer["Location"]" />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Schedule"]</pems-button>
                </form>
            }
        </div>
        <div class="col-12">
            <div class="small text-muted mb-1">@Localizer["Inspection / ITP"]</div>
            @if (linkedItps.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var itp in linkedItps)
                    {
                        <li><a asp-controller="QC" asp-action="ItpDetails" asp-route-id="@itp.InspectionTestPlanId">@itp.ITPNumber</a> — <pems-badge tone="neutral">@itp.Status</pems-badge></li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">@Localizer["No data."]</p>
            }
            @if (Model.RequiresInspection)
            {
                <pems-button tone="primary" size="small" outline="true" css="mt-1" as="a" asp-controller="QC" asp-action="ItpCreate" asp-route-contractId="@Model.ContractId">@Localizer["New ITP"]</pems-button>
            }
        </div>
    </div>
</div>
