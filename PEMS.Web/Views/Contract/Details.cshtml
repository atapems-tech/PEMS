@model PEMS.Application.DTOs.ContractDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var disciplineReviews = (IEnumerable<PEMS.Domain.Entities.ContractDisciplineReview>)(ViewBag.DisciplineReviews ?? Array.Empty<PEMS.Domain.Entities.ContractDisciplineReview>());
    var revisions = (IEnumerable<PEMS.Domain.Entities.ContractRevision>)(ViewBag.Revisions ?? Array.Empty<PEMS.Domain.Entities.ContractRevision>());
    var contractDocuments = (IEnumerable<PEMS.Domain.Entities.ContractDocument>)(ViewBag.ContractDocuments ?? Array.Empty<PEMS.Domain.Entities.ContractDocument>());
    var ntps = (IEnumerable<PEMS.Domain.Entities.ContractNTP>)(ViewBag.ContractNTPs ?? Array.Empty<PEMS.Domain.Entities.ContractNTP>());
    var kickoffs = (IEnumerable<PEMS.Domain.Entities.Meeting>)(ViewBag.KickoffMeetings ?? Array.Empty<PEMS.Domain.Entities.Meeting>());
    var linkedItps = (IEnumerable<PEMS.Domain.Entities.InspectionTestPlan>)(ViewBag.LinkedItps ?? Array.Empty<PEMS.Domain.Entities.InspectionTestPlan>());
    var originatingTender = (PEMS.Domain.Entities.Tender?)ViewBag.OriginatingTender;

    var statusBadge = Model.Status switch
    {
        "Draft" => "neutral",
        "UnderReview" => "info",
        "Approved" => "primary",
        "Signed" => "warning",
        "Effective" => "success",
        "Completed" => "dark",
        "Terminated" => "danger",
        "Rejected" => "danger",
        _ => "neutral"
    };
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success">@Localizer[TempData["Message"]?.ToString() ?? ""]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger">@Localizer[TempData["Error"]?.ToString() ?? ""]</pems-alert>
}

@* ================= PROCUREMENT ORIGIN ================= *@
@* طبق ممیزی نهایی Ownership (§2/§6): Contract هیچ FK مستقیمی به ProcurementPackage ندارد -
   Tender.ContractId تنها منبع حقیقت این رابطه است (Phase 3). این بخش همان رابطه‌ی موجود را
   از جهت معکوس نشان می‌دهد - نه یک FK تازه. *@
@if (originatingTender != null)
{
    <pems-content-card css="mb-3">
        <pems-heading level="6" class="text-muted small mb-2">@Localizer["Procurement Origin"]</pems-heading>
        <pems-info-grid>
            <pems-info-item label="@Localizer["Package"]" num><pems-link href="/p/procurement-package-details?id=@originatingTender.ProcurementPackageId">@originatingTender.ProcurementPackage?.PackageNumber</pems-link></pems-info-item>
            <pems-info-item label="@Localizer["Tender"]" num><pems-link asp-controller="Tender" asp-action="Details" asp-route-id="@originatingTender.TenderId">@originatingTender.TenderNumber</pems-link></pems-info-item>
            <pems-info-item label="@Localizer["Awarded Bid"]" num>@originatingTender.AwardedBid?.BidNumber</pems-info-item>
            <pems-info-item label="@Localizer["Awarded"]" num>@PemsDates.Date(originatingTender.AwardedDate)</pems-info-item>
        </pems-info-grid>
    </pems-content-card>
}

@* ================= CONTRACT INFORMATION ================= *@
<pems-content-card>
    <pems-flex justify="end" css="mb-2">
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Relationship" asp-action="Contract" asp-route-id="@Model.ContractId"><pems-icon name="bi-diagram-3" /> @Localizer["Cm_Relationships"]</pems-button>
    </pems-flex>
    <pems-info-grid>
        <pems-info-item label="@Localizer["Contract No"]" num>@Model.ContractNo</pems-info-item>
        <pems-info-item label="@Localizer["Project"]">@Model.ProjectName</pems-info-item>
        <pems-info-item label="@Localizer["Vendor"]">@Model.VendorName</pems-info-item>
        <pems-info-item label="@Localizer["Value"]" num>@(Model.ContractValue.HasValue ? $"{Model.ContractValue:N0} {Model.Currency}" : "")</pems-info-item>
        <pems-info-item label="@Localizer["Start Date"]" num>@PemsDates.Date(Model.StartDate)</pems-info-item>
        <pems-info-item label="@Localizer["End Date"]" num>@PemsDates.Date(Model.EndDate)</pems-info-item>
        <pems-info-item label="@Localizer["Status"]">
            <pems-badge tone="@statusBadge">@Model.Status</pems-badge>
            @if (Model.RequiresInspection)
            {
                <pems-badge tone="warning">@Localizer["Requires Inspection"]</pems-badge>
            }
        </pems-info-item>
        <pems-info-item label="@Localizer["Scope of Work"]" wide>@Model.ScopeOfWork</pems-info-item>
    </pems-info-grid>

    <pems-divider />

    <pems-flex gap="2" wrap="true">
        @if (Model.Status == "Draft" || Model.Status == "Rejected")
        {
            <pems-form action="/a/contract-submit-for-review" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Submit for Multi-Discipline Review"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "UnderReview")
        {
            <pems-form action="/a/contract-approve" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="success" size="small" type="submit">@Localizer["Final Approve"]</pems-button>
            </pems-form>
            <pems-form action="/a/contract-reject" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject (back to Draft)"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Approved")
        {
            <pems-form action="/a/contract-sign" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="warning" size="small" type="submit">@Localizer["Sign Contract"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Signed")
        {
            <pems-form action="/a/contract-mark-effective" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="success" size="small" type="submit">@Localizer["Mark Effective"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Effective")
        {
            <pems-form action="/a/contract-complete" method="post" class="d-inline">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-button tone="dark" size="small" type="submit">@Localizer["Complete Contract"]</pems-button>
            </pems-form>
        }
        @if (Model.Status != "Completed" && Model.Status != "Terminated")
        {
            <pems-form action="/a/contract-terminate" method="post"><pems-flex gap="1" align="center">
                <input type="hidden" name="contractId" value="@Model.ContractId" />
                <pems-input class="pems-w-160" scale="small" type="text" name="reason" placeholder="@Localizer["Reason"]" />
                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Terminate Contract"]</pems-button>
            </pems-flex></pems-form>
        }
    </pems-flex>
</pems-content-card>

@* ================= DISCIPLINE REVIEWS & APPROVAL ================= *@
@if (Model.Status == "UnderReview" && disciplineReviews.Any())
{
    <pems-content-card css="mt-3">
        <pems-heading level="6">@Localizer["Multi-Discipline Review"]</pems-heading>
        @{
            var rows_22 = disciplineReviews;
            var cell_22_5 = DataCell.Template(rows_22, @<text>@{ var r = item; }
                            @if (r.Decision == "Pending")
                            {
                                <pems-form action="/a/contract-record-discipline-review" method="post"><pems-flex gap="1">
                                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                                    <input type="hidden" name="disciplineRole" value="@r.DisciplineRole" />
                                    <pems-button tone="success" size="small" type="submit" name="decision" value="Approve">@Localizer["Approve"]</pems-button>
                                    <pems-button tone="danger" size="small" type="submit" name="decision" value="Reject">@Localizer["Reject"]</pems-button>
                                </pems-flex></pems-form>
                            }
                        </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_22, c_ => c_.Add(((Localizer["Discipline"])?.ToString() ?? ""), r => (object?)(r.DisciplineRole)).Add(((Localizer["Reviewer"])?.ToString() ?? ""), r => (object?)((r.Reviewer != null ? r.Reviewer.FirstName + " " + r.Reviewer.LastName : "-"))).Add(((Localizer["Decision"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(r.Decision == "Approved" ? "success" : r.Decision == "Rejected" ? "danger" : "neutral", r.Decision))).Add(((Localizer["Comment"])?.ToString() ?? ""), r => (object?)(r.Comment)).Add(((Localizer["Date"])?.ToString() ?? ""), r => (object?)((PemsDates.Date(r.ReviewDate)))).Add("", r => (object?)cell_22_5(r))))" dense="true" enterprise="false" />
    </pems-content-card>
}

@* ================= DOCUMENTS & REVISIONS (Change Orders) ================= *@
<pems-content-card css="mt-3">
    <pems-heading level="6">@Localizer["Contract Documents"]</pems-heading>
    @if (contractDocuments.Any())
    {
        <pems-data-table data="@(DataRows.Of(contractDocuments, c_ => c_.Add(((Localizer["Doc No"])?.ToString() ?? ""), d => (object?)(d.DocumentNo)).Add(((Localizer["Title"])?.ToString() ?? ""), d => (object?)(d.Title)).Add(((Localizer["Type"])?.ToString() ?? ""), d => (object?)(d.DocumentType)).Add(((Localizer["Clause Reference"])?.ToString() ?? ""), d => (object?)(d.ClauseReference)).Add(((Localizer["Status"])?.ToString() ?? ""), d => (object?)(d.Status))))" enterprise="false" dense="true" />
    }
    <pems-form asp-action="AddDocument" method="post"><pems-row gap="2">
        <input type="hidden" name="contractId" value="@Model.ContractId" />
        <pems-col md="2"><pems-input scale="small" type="text" name="documentNo" placeholder="@Localizer["Doc No"]" required /></pems-col>
        <pems-col md="3"><pems-input scale="small" type="text" name="title" placeholder="@Localizer["Title"]" required /></pems-col>
        <pems-col md="2"><pems-input scale="small" type="text" name="documentType" placeholder="@Localizer["Type"]" required /></pems-col>
        <pems-col md="3"><pems-input scale="small" type="text" name="clauseReference" placeholder="@Localizer["Clause Reference"]" /></pems-col>
        <pems-col md="2"><pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Add Document"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>

@if (Model.Status == "Signed" || Model.Status == "Effective")
{
    <pems-content-card css="mt-3">
        <pems-heading level="6">@Localizer["Request Value Change (Variation / Change Order)"]</pems-heading>
        <pems-form action="/a/contract-request-revision" method="post"><pems-row gap="2">
            <input type="hidden" name="contractId" value="@Model.ContractId" />
            <pems-col md="3">
                <pems-select scale="small" name="changeType">
                    <option value="Variation">@Localizer["Variation"]</option>
                    <option value="ChangeOrder">@Localizer["Change Order"]</option>
                    <option value="Amendment">@Localizer["Amendment"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="2"><pems-input scale="small" type="number" step="0.01" name="newValue" placeholder="@Localizer["New value"]" /></pems-col>
            <pems-col md="3"><pems-input scale="small" type="text" name="reason" placeholder="@Localizer["Reason"]" /></pems-col>
            <pems-col md="3"><pems-input scale="small" type="text" name="changeDescription" placeholder="@Localizer["Description"]" /></pems-col>
            <pems-col md="1"><pems-button tone="none" size="small" css="btn-primary" type="submit">@Localizer["Request"]</pems-button></pems-col>
        </pems-row></pems-form>
    </pems-content-card>
}

@if (revisions.Any())
{
    <pems-content-card css="mt-3">
        <pems-heading level="6">@Localizer["Revision History (Original value never overwritten)"]</pems-heading>
        @{
            var rows_23 = revisions;
            var cell_23_6 = DataCell.Template(rows_23, @<text>@{ var r = item; }
                            @if (r.Status == "Pending")
                            {
                                <pems-form action="/a/contract-approve-revision" method="post" class="d-inline">
                                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                                    <input type="hidden" name="contractRevisionId" value="@r.ContractRevisionId" />
                                    <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                                </pems-form>
                            }
                        </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_23, c_ => c_.Add("#", r => (object?)(r.RevisionNo)).Add(((Localizer["Type"])?.ToString() ?? ""), r => (object?)(r.ChangeType)).Add(((Localizer["Previous"])?.ToString() ?? ""), r => (object?)((r.PreviousValue?.ToString("N0")))).Add(((Localizer["New"])?.ToString() ?? ""), r => (object?)((r.NewValue?.ToString("N0")))).Add(((Localizer["Reason"])?.ToString() ?? ""), r => (object?)(r.Reason)).Add(((Localizer["Status"])?.ToString() ?? ""), r => (object?)(DataCell.Badge(r.Status == "Approved" ? "success" : "neutral", r.Status))).Add("", r => (object?)cell_23_6(r))))" dense="true" enterprise="false" />
    </pems-content-card>
}

@* ================= EXECUTION: NTP / KICK-OFF / ITP ================= *@
<pems-content-card css="mt-3">
    <pems-heading level="6">@Localizer["Execution"]</pems-heading>
    <pems-row gap="3">
        <pems-col md="6">
            <div class="small text-muted mb-1">@Localizer["Notice to Proceed (NTP)"]</div>
            @if (ntps.Any())
            {
                <pems-bullet-list class="list-unstyled mb-2">
                    @foreach (var n in ntps)
                    {
                        <pems-bullet>@n.NTPNumber — <pems-badge tone="neutral">@n.Status</pems-badge> (@PemsDates.Date(n.IssuedDate))</pems-bullet>
                    }
                </pems-bullet-list>
            }
            @if (Model.Status == "Signed" || Model.Status == "Effective")
            {
                <pems-form asp-action="IssueNtp" method="post"><pems-flex gap="1">
                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                    <pems-input scale="small" type="text" name="reference" placeholder="@Localizer["Reference"]" />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Issue NTP"]</pems-button>
                </pems-flex></pems-form>
            }
        </pems-col>
        <pems-col md="6">
            <div class="small text-muted mb-1">@Localizer["Kick-off Meeting"]</div>
            @if (kickoffs.Any())
            {
                <pems-bullet-list class="list-unstyled mb-2">
                    @foreach (var m in kickoffs)
                    {
                        <pems-bullet><a href="/p/meeting-details?id=@m.MeetingId">@m.Title</a> — <pems-badge tone="neutral">@m.Status</pems-badge> (@PemsDates.Date(m.MeetingDate))</pems-bullet>
                    }
                </pems-bullet-list>
            }
            @if (Model.Status == "Signed" || Model.Status == "Effective")
            {
                <pems-form asp-action="ScheduleKickoff" method="post"><pems-flex gap="1">
                    <input type="hidden" name="contractId" value="@Model.ContractId" />
                    <pems-date name="meetingDate" scale="small" required />
                    <pems-input scale="small" type="text" name="location" placeholder="@Localizer["Location"]" />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Schedule"]</pems-button>
                </pems-flex></pems-form>
            }
        </pems-col>
        <pems-col span="12">
            <div class="small text-muted mb-1">@Localizer["Inspection / ITP"]</div>
            @if (linkedItps.Any())
            {
                <pems-bullet-list class="list-unstyled mb-0">
                    @foreach (var itp in linkedItps)
                    {
                        <pems-bullet><pems-link asp-controller="QC" asp-action="ItpDetails" asp-route-id="@itp.InspectionTestPlanId">@itp.ITPNumber</pems-link> — <pems-badge tone="neutral">@itp.Status</pems-badge></pems-bullet>
                    }
                </pems-bullet-list>
            }
            else
            {
                <pems-text class="text-muted small mb-0">@Localizer["No data."]</pems-text>
            }
            @if (Model.RequiresInspection)
            {
                <pems-button tone="primary" size="small" outline="true" css="mt-1" as="a" asp-controller="QC" asp-action="ItpCreate" asp-route-contractId="@Model.ContractId">@Localizer["New ITP"]</pems-button>
            }
        </pems-col>
    </pems-row>
</pems-content-card>
