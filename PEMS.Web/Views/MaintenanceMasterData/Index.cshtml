                    <pems-label css="small">@Localizer["Variable Type"]</pems-label>
                    <pems-select scale="small" name="variableType" required>
                        @foreach (var vt in new[] { "Vibration", "Temperature", "Pressure", "Flow", "Current", "Voltage", "Lubrication", "OilAnalysis", "Thermography", "Acoustic", "ProcessDeviation" })
                        {
                            <option value="@vt">@vt</option>
