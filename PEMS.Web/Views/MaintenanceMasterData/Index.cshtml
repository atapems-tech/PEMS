@model List<PEMS.Domain.Entities.MaintenanceGroup>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var skills = (List<PEMS.Domain.Entities.Skill>)ViewBag.Skills;
    var qualifications = (List<PEMS.Domain.Entities.Qualification>)ViewBag.Qualifications;
    var certifications = (List<PEMS.Domain.Entities.Certification>)ViewBag.Certifications;

    // طبق «PEMS — Enterprise Maintenance Master Data & Standards Implementation» بند ۱۶
    var maintenanceTypes = (List<PEMS.Domain.Entities.MaintenanceType>)ViewBag.MaintenanceTypes;
    var strategyTypes = (List<PEMS.Domain.Entities.MaintenanceStrategyType>)ViewBag.MaintenanceStrategyTypes;
    var equipmentClasses = (List<PEMS.Domain.Entities.EquipmentClass>)ViewBag.EquipmentClasses;
    var standardReferences = (List<PEMS.Domain.Entities.StandardReference>)ViewBag.StandardReferences;
    var maintenanceActivities = (List<PEMS.Domain.Entities.MaintenanceActivity>)ViewBag.MaintenanceActivities;

    // طبق «PEMS Phase 2 — Equipment Classification + ISO 14224 Failure Taxonomy + PM/Job Plan Intelligence»
    var failureModes = (List<PEMS.Domain.Entities.FailureMode>)ViewBag.FailureModes;
    var pmTemplates = (List<PEMS.Domain.Entities.PMTemplate>)ViewBag.PMTemplates;

    // طبق «PEMS — Standards-Based Mechanical Equipment Passport & Condition Monitoring» فاز ۲
    var evaluationProfiles = (List<PEMS.Domain.Entities.EvaluationProfile>)ViewBag.EvaluationProfiles;

    // طبق «PEMS — Equipment Passport Audit & CBM» فاز ۱ ممیزی §3.7
    var conditionPriorityMappings = (List<PEMS.Domain.Entities.ConditionPriorityMapping>)ViewBag.ConditionPriorityMappings;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-nav css="mb-3" id="mmdTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-groups" type="button">
            <pems-icon name="bi-diagram-3" /> Maintenance Groups <pems-badge tone="neutral">@Model.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-skills" type="button">
            <pems-icon name="bi-mortarboard" /> Skills <pems-badge tone="neutral">@skills.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-qualifications" type="button">
            <pems-icon name="bi-patch-check" /> Qualifications <pems-badge tone="neutral">@qualifications.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-certifications" type="button">
            <pems-icon name="bi-award" /> Certifications <pems-badge tone="neutral">@certifications.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance-types" type="button">
            <pems-icon name="bi-tags" /> Maintenance Types <pems-badge tone="neutral">@maintenanceTypes.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-strategy-types" type="button">
            <pems-icon name="bi-diagram-2" /> Strategy Types <pems-badge tone="neutral">@strategyTypes.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-equipment-classes" type="button">
            <pems-icon name="bi-gear" /> Equipment Classes <pems-badge tone="neutral">@equipmentClasses.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-standards" type="button">
            <pems-icon name="bi-journal-check" /> Standard References <pems-badge tone="neutral">@standardReferences.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-activities" type="button">
            <pems-icon name="bi-list-task" /> Activities <pems-badge tone="neutral">@maintenanceActivities.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-failure-modes" type="button">
            <pems-icon name="bi-exclamation-triangle" /> Failure Modes <pems-badge tone="neutral">@failureModes.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pm-templates" type="button">
            <pems-icon name="bi-calendar-check" /> PM Templates <pems-badge tone="neutral">@pmTemplates.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-evaluation-profiles" type="button">
            <pems-icon name="bi-sliders" /> Evaluation Profiles <pems-badge tone="neutral">@evaluationProfiles.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-priority-mappings" type="button">
            <pems-icon name="bi-flag" /> @Localizer["Priority Mapping"] <pems-badge tone="neutral">@conditionPriorityMappings.Count</pems-badge>
        </button>
    </li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-groups" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    گروه‌بندی تعمیراتی دقیق‌تر از Discipline (مثلاً «Rotating Equipment» زیر «Mechanical») -
                    Team ها زیر همین گروه‌ها تعریف می‌شوند.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["گروه جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["کد"]</pems-table-header><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["دیسیپلین"]</pems-table-header><pems-table-header>@Localizer["توضیحات"]</pems-table-header><pems-table-header>@Localizer["System Default"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var g in Model)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@g.Code</code></pems-table-cell>
                            <pems-table-cell>@g.Name</pems-table-cell>
                            <pems-table-cell>@g.Discipline?.Name</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(g.Description ?? "-")</pems-table-cell>
                            <pems-table-cell>@if (g.IsSystemDefault) { <pems-badge tone="info">@Localizer["System"]</pems-badge> }</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleGroupActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@g.MaintenanceGroupId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این گروه غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!Model.Any()) { <p class="text-muted text-center py-4">هنوز گروه تعمیراتی‌ای ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-skills" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک مهارت‌ها - از صفحه‌ی هر کارمند به او تخصیص داده می‌شود، یا به‌عنوان
                    پیش‌نیاز روی یک Work Order ثبت می‌شود.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createSkillModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["مهارت جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["دیسیپلین"]</pems-table-header><pems-table-header>@Localizer["توضیحات"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var s in skills)
                    {
                        <pems-table-row>
                            <pems-table-cell>@s.Name</pems-table-cell>
                            <pems-table-cell>@(s.Discipline?.Name ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(s.Description ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleSkillActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.SkillId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این مهارت غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!skills.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز مهارتی ساخته نشده."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-qualifications" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک انواع صلاحیت - نمونه‌ی هر کارمند از صفحه‌ی جزئیات همان کارمند ثبت می‌شود.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createQualificationModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["صلاحیت جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["دیسیپلین"]</pems-table-header><pems-table-header>@Localizer["توضیحات"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var q in qualifications)
                    {
                        <pems-table-row>
                            <pems-table-cell>@q.Name</pems-table-cell>
                            <pems-table-cell>@(q.Discipline?.Name ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(q.Description ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleQualificationActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@q.QualificationId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این صلاحیت غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!qualifications.Any()) { <p class="text-muted text-center py-4">هنوز صلاحیتی ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-certifications" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک انواع گواهینامه - شماره‌ی گواهی و تاریخ انقضای هر کارمند از صفحه‌ی جزئیات همان کارمند ثبت می‌شود.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createCertificationModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["گواهینامه جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["دیسیپلین"]</pems-table-header><pems-table-header>@Localizer["توضیحات"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var c in certifications)
                    {
                        <pems-table-row>
                            <pems-table-cell>@c.Name</pems-table-cell>
                            <pems-table-cell>@(c.Discipline?.Name ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(c.Description ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleCertificationActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.CertificationId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این گواهینامه غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!certifications.Any()) { <p class="text-muted text-center py-4">هنوز گواهینامه‌ای ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-maintenance-types" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    طبقه‌بندی استاندارد «نوع کار» (Corrective/Preventive/Predictive/...) - مرجع
                    داده‌محور برای Work Order و کاتالوگ Activity، طبق ISO 14224/SMRP.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createMaintenanceTypeModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["Maintenance Type جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Code"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["نام فارسی"]</pems-table-header><pems-table-header>@Localizer["System Default"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var t in maintenanceTypes)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@t.Code</code></pems-table-cell>
                            <pems-table-cell>@t.Name</pems-table-cell>
                            <pems-table-cell>@(t.NameFa ?? "-")</pems-table-cell>
                            <pems-table-cell>@if (t.IsSystemDefault) { <pems-badge tone="info">@Localizer["System"]</pems-badge> }</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleMaintenanceTypeActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.MaintenanceTypeId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این Maintenance Type غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!maintenanceTypes.Any()) { <p class="text-muted text-center py-4">هنوز Maintenance Type ای ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-strategy-types" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    سیاست RCM («چرا این استراتژی انتخاب شد» - PM/PDM/CBM/CM/EM/RTF/RCM/...) - جدا از
                    Maintenance Type بالا (که «نوع کار» را طبقه‌بندی می‌کند).
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createStrategyTypeModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["Strategy Type جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Code"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["نام فارسی"]</pems-table-header><pems-table-header>@Localizer["System Default"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var t in strategyTypes)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@t.Code</code></pems-table-cell>
                            <pems-table-cell>@t.Name</pems-table-cell>
                            <pems-table-cell>@(t.NameFa ?? "-")</pems-table-cell>
                            <pems-table-cell>@if (t.IsSystemDefault) { <pems-badge tone="info">@Localizer["System"]</pems-badge> }</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleMaintenanceStrategyTypeActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.MaintenanceStrategyTypeId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این Strategy Type غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!strategyTypes.Any()) { <p class="text-muted text-center py-4">هنوز Strategy Type ای ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-equipment-classes" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    طبقه‌بندی تجهیزات (مثلاً «Centrifugal Pump») - جدا از EquipmentType متنی روی
                    خودِ Equipment؛ برای پیوند Activity ↔ تجهیز به‌صورت داده‌محور استفاده می‌شود.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createEquipmentClassModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["Equipment Class جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Code"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["نام فارسی"]</pems-table-header><pems-table-header>@Localizer["System Default"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var t in equipmentClasses)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@t.Code</code></pems-table-cell>
                            <pems-table-cell>@t.Name</pems-table-cell>
                            <pems-table-cell>@(t.NameFa ?? "-")</pems-table-cell>
                            <pems-table-cell>@if (t.IsSystemDefault) { <pems-badge tone="info">@Localizer["System"]</pems-badge> }</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleEquipmentClassActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.EquipmentClassId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این Equipment Class غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!equipmentClasses.Any()) { <p class="text-muted text-center py-4">هنوز Equipment Class ای ساخته نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-standards" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    فقط ابرداده‌ی استانداردهای صنعتی (سازمان/شماره/عنوان/دسته) - هیچ متن دارای
