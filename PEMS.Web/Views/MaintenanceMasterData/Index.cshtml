@model List<PEMS.Domain.Entities.MaintenanceGroup>
@{
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var skills = (List<PEMS.Domain.Entities.Skill>)ViewBag.Skills;
    var qualifications = (List<PEMS.Domain.Entities.Qualification>)ViewBag.Qualifications;
    var certifications = (List<PEMS.Domain.Entities.Certification>)ViewBag.Certifications;

    // طبق «PEMS — Enterprise Maintenance Master Data & Standards Implementation» بند ۱۶
    var maintenanceTypes = (List<PEMS.Domain.Entities.MaintenanceType>)ViewBag.MaintenanceTypes;
    var strategyTypes = (List<PEMS.Domain.Entities.MaintenanceStrategyType>)ViewBag.MaintenanceStrategyTypes;
    var equipmentClasses = (List<PEMS.Domain.Entities.EquipmentClass>)ViewBag.EquipmentClasses;
    var standardReferences = (List<PEMS.Domain.Entities.StandardReference>)ViewBag.StandardReferences;
    var maintenanceActivities = (List<PEMS.Domain.Entities.MaintenanceActivity>)ViewBag.MaintenanceActivities;

    // طبق «PEMS Phase 2 — Equipment Classification + ISO 14224 Failure Taxonomy + PM/Job Plan Intelligence»
    var failureModes = (List<PEMS.Domain.Entities.FailureMode>)ViewBag.FailureModes;
    var pmTemplates = (List<PEMS.Domain.Entities.PMTemplate>)ViewBag.PMTemplates;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<ul class="nav nav-tabs mb-3" id="mmdTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-groups" type="button">
            <i class="bi bi-diagram-3"></i> Maintenance Groups <span class="badge bg-secondary">@Model.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-skills" type="button">
            <i class="bi bi-mortarboard"></i> Skills <span class="badge bg-secondary">@skills.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-qualifications" type="button">
            <i class="bi bi-patch-check"></i> Qualifications <span class="badge bg-secondary">@qualifications.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-certifications" type="button">
            <i class="bi bi-award"></i> Certifications <span class="badge bg-secondary">@certifications.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance-types" type="button">
            <i class="bi bi-tags"></i> Maintenance Types <span class="badge bg-secondary">@maintenanceTypes.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-strategy-types" type="button">
            <i class="bi bi-diagram-2"></i> Strategy Types <span class="badge bg-secondary">@strategyTypes.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-equipment-classes" type="button">
            <i class="bi bi-gear"></i> Equipment Classes <span class="badge bg-secondary">@equipmentClasses.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-standards" type="button">
            <i class="bi bi-journal-check"></i> Standard References <span class="badge bg-secondary">@standardReferences.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-activities" type="button">
            <i class="bi bi-list-task"></i> Activities <span class="badge bg-secondary">@maintenanceActivities.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-failure-modes" type="button">
            <i class="bi bi-exclamation-triangle"></i> Failure Modes <span class="badge bg-secondary">@failureModes.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pm-templates" type="button">
            <i class="bi bi-calendar-check"></i> PM Templates <span class="badge bg-secondary">@pmTemplates.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-groups" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    گروه‌بندی تعمیراتی دقیق‌تر از Discipline (مثلاً «Rotating Equipment» زیر «Mechanical») -
                    Team ها زیر همین گروه‌ها تعریف می‌شوند.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                    <i class="bi bi-plus-lg"></i> گروه جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>کد</th><th>نام</th><th>دیسیپلین</th><th>توضیحات</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td><code>@g.Code</code></td>
                            <td>@g.Name</td>
                            <td>@g.Discipline?.Name</td>
                            <td class="small text-muted">@(g.Description ?? "-")</td>
                            <td>@if (g.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleGroupActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@g.MaintenanceGroupId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این گروه غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any()) { <p class="text-muted text-center py-4">هنوز گروه تعمیراتی‌ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-skills" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک مهارت‌ها - از صفحه‌ی هر کارمند به او تخصیص داده می‌شود، یا به‌عنوان
                    پیش‌نیاز روی یک Work Order ثبت می‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createSkillModal">
                    <i class="bi bi-plus-lg"></i> مهارت جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>نام</th><th>دیسیپلین</th><th>توضیحات</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in skills)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td>@(s.Discipline?.Name ?? "-")</td>
                            <td class="small text-muted">@(s.Description ?? "-")</td>
                            <td class="text-end">
                                <form asp-action="ToggleSkillActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.SkillId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این مهارت غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!skills.Any()) { <p class="text-muted text-center py-4">هنوز مهارتی ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-qualifications" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک انواع صلاحیت - نمونه‌ی هر کارمند از صفحه‌ی جزئیات همان کارمند ثبت می‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createQualificationModal">
                    <i class="bi bi-plus-lg"></i> صلاحیت جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>نام</th><th>دیسیپلین</th><th>توضیحات</th><th></th></tr></thead>
                <tbody>
                    @foreach (var q in qualifications)
                    {
                        <tr>
                            <td>@q.Name</td>
                            <td>@(q.Discipline?.Name ?? "-")</td>
                            <td class="small text-muted">@(q.Description ?? "-")</td>
                            <td class="text-end">
                                <form asp-action="ToggleQualificationActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@q.QualificationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این صلاحیت غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!qualifications.Any()) { <p class="text-muted text-center py-4">هنوز صلاحیتی ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-certifications" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    فهرست مشترک انواع گواهینامه - شماره‌ی گواهی و تاریخ انقضای هر کارمند از صفحه‌ی جزئیات همان کارمند ثبت می‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createCertificationModal">
                    <i class="bi bi-plus-lg"></i> گواهینامه جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>نام</th><th>دیسیپلین</th><th>توضیحات</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in certifications)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@(c.Discipline?.Name ?? "-")</td>
                            <td class="small text-muted">@(c.Description ?? "-")</td>
                            <td class="text-end">
                                <form asp-action="ToggleCertificationActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.CertificationId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این گواهینامه غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!certifications.Any()) { <p class="text-muted text-center py-4">هنوز گواهینامه‌ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-maintenance-types" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    طبقه‌بندی استاندارد «نوع کار» (Corrective/Preventive/Predictive/...) - مرجع
                    داده‌محور برای Work Order و کاتالوگ Activity، طبق ISO 14224/SMRP.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createMaintenanceTypeModal">
                    <i class="bi bi-plus-lg"></i> Maintenance Type جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>نام فارسی</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in maintenanceTypes)
                    {
                        <tr>
                            <td><code>@t.Code</code></td>
                            <td>@t.Name</td>
                            <td>@(t.NameFa ?? "-")</td>
                            <td>@if (t.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleMaintenanceTypeActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.MaintenanceTypeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Maintenance Type غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!maintenanceTypes.Any()) { <p class="text-muted text-center py-4">هنوز Maintenance Type ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-strategy-types" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    سیاست RCM («چرا این استراتژی انتخاب شد» - PM/PDM/CBM/CM/EM/RTF/RCM/...) - جدا از
                    Maintenance Type بالا (که «نوع کار» را طبقه‌بندی می‌کند).
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createStrategyTypeModal">
                    <i class="bi bi-plus-lg"></i> Strategy Type جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>نام فارسی</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in strategyTypes)
                    {
                        <tr>
                            <td><code>@t.Code</code></td>
                            <td>@t.Name</td>
                            <td>@(t.NameFa ?? "-")</td>
                            <td>@if (t.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleMaintenanceStrategyTypeActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.MaintenanceStrategyTypeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Strategy Type غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!strategyTypes.Any()) { <p class="text-muted text-center py-4">هنوز Strategy Type ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-equipment-classes" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    طبقه‌بندی تجهیزات (مثلاً «Centrifugal Pump») - جدا از EquipmentType متنی روی
                    خودِ Equipment؛ برای پیوند Activity ↔ تجهیز به‌صورت داده‌محور استفاده می‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createEquipmentClassModal">
                    <i class="bi bi-plus-lg"></i> Equipment Class جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>نام فارسی</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in equipmentClasses)
                    {
                        <tr>
                            <td><code>@t.Code</code></td>
                            <td>@t.Name</td>
                            <td>@(t.NameFa ?? "-")</td>
                            <td>@if (t.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleEquipmentClassActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.EquipmentClassId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Equipment Class غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!equipmentClasses.Any()) { <p class="text-muted text-center py-4">هنوز Equipment Class ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-standards" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    فقط ابرداده‌ی استانداردهای صنعتی (سازمان/شماره/عنوان/دسته) - هیچ متن دارای
                    Copyright خودِ استاندارد این‌جا ذخیره نمی‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createStandardModal">
                    <i class="bi bi-plus-lg"></i> Standard Reference جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Organization</th><th>Number</th><th>Title</th><th>Category</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in standardReferences)
                    {
                        <tr>
                            <td><code>@s.Code</code></td>
                            <td>@s.Organization</td>
                            <td>@s.StandardNumber</td>
                            <td class="small">@s.Title</td>
                            <td class="small text-muted">@(s.Category ?? "-")</td>
                            <td>@if (s.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleStandardReferenceActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.StandardReferenceId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Standard Reference غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!standardReferences.Any()) { <p class="text-muted text-center py-4">هنوز Standard Reference ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-activities" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">
                    کاتالوگ فعالیت‌های استاندارد تعمیراتی (مثلاً «Vibration Measurement») - زیر یک
                    Maintenance Group و Maintenance Type دسته‌بندی می‌شود.
                </p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createActivityModal">
                    <i class="bi bi-plus-lg"></i> Activity جدید
                </button>
            </div>

            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>Group</th><th>Type</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in maintenanceActivities)
                    {
                        <tr>
                            <td><code>@a.Code</code></td>
                            <td>@a.Name</td>
                            <td class="small">@a.MaintenanceGroup?.Name</td>
                            <td class="small text-muted">@(a.MaintenanceType?.Name ?? "-")</td>
                            <td>@if (a.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleMaintenanceActivityActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@a.MaintenanceActivityId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Activity غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!maintenanceActivities.Any()) { <p class="text-muted text-center py-4">هنوز Activity ای ساخته نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-failure-modes" role="tabpanel">
        <div class="content-card">
            <p class="text-muted small mb-3">
                طبق ISO 14224 - خط‌مبنای Failure Mode به‌ازای خانواده‌ی تجهیز (Equipment Class)؛
                این تب فقط از طریق Seed سیستمی ساخته می‌شود (نه فرم دستی) چون هر Mode به چند
                Cause/Effect/Consequence مرتبط است.
            </p>
            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>Equipment Class</th><th>Effect</th><th>Consequence</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var fm in failureModes)
                    {
                        <tr>
                            <td><code>@fm.Code</code></td>
                            <td>@fm.Name</td>
                            <td class="small">@(fm.EquipmentClass?.Name ?? "-")</td>
                            <td class="small text-muted">@(fm.FailureEffect?.Name ?? "-")</td>
                            <td class="small text-muted">@(fm.FailureConsequence?.Name ?? "-")</td>
                            <td>@if (fm.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="ToggleFailureModeActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@fm.FailureModeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این Failure Mode غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!failureModes.Any()) { <p class="text-muted text-center py-4">هنوز Failure Mode ای Seed نشده.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-pm-templates" role="tabpanel">
        <div class="content-card">
            <p class="text-muted small mb-3">
                قالب‌های نگهداری پیشگیرانه‌ی قابل‌استفاده‌ی مجدد، مقیاس‌بندی‌شده روی Equipment
                Class (نه یک تجهیز خاص) - تبدیل به یک MaintenancePlan واقعی هنوز نیازمند تأیید
                انسانی/تخصیص JobPlan است.
            </p>
            <table class="table table-enterprise">
                <thead><tr><th>Code</th><th>Name</th><th>Equipment Class</th><th>Trigger</th><th>Interval</th><th>System Default</th><th></th></tr></thead>
                <tbody>
                    @foreach (var pt in pmTemplates)
                    {
                        <tr>
                            <td><code>@pt.Code</code></td>
                            <td>@pt.Name</td>
                            <td class="small">@(pt.EquipmentClass?.Name ?? "-")</td>
                            <td class="small text-muted">@pt.TriggerType</td>
                            <td class="small text-muted">@(pt.IntervalDays.HasValue ? $"{pt.IntervalDays} روز" : (pt.MeterInterval.HasValue ? $"{pt.MeterInterval} {pt.MeterType}" : "-"))</td>
                            <td>@if (pt.IsSystemDefault) { <span class="badge text-bg-info">System</span> }</td>
                            <td class="text-end">
                                <form asp-action="TogglePMTemplateActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@pt.PMTemplateId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="غیرفعال کردن" onclick="return confirm('این PM Template غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!pmTemplates.Any()) { <p class="text-muted text-center py-4">هنوز PM Template ای Seed نشده.</p> }
        </div>
    </div>
</div>

