                <p class="text-muted small mb-0">
                    @Localizer["این نگاشت تعیین می‌کند که یافتن یک وضعیت (Condition) چه اولویتی (Priority) برای Work Request نتیجه‌شده دارد - قبلاً این نگاشت مستقیم در کد برنامه نوشته شده بود؛ حالا اینجا قابل‌مشاهده و قابل‌ویرایش است."]
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createPriorityMappingModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["نگاشت جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Condition"]</pems-table-header><pems-table-header>@Localizer["Priority"]</pems-table-header><pems-table-header>@Localizer["System Default"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var m in conditionPriorityMappings)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@m.Condition</code></pems-table-cell>
                            <pems-table-cell>
                                <form asp-action="UpdateConditionPriorityMapping" method="post"><pems-flex gap="1" align="center">
                                    <input type="hidden" name="id" value="@m.ConditionPriorityMappingId" />
                                    <pems-select class="pems-maxw-140" scale="small" name="priority" onchange="this.form.submit()">
                                        @foreach (var p in new[] { "Low", "Medium", "High", "Critical" })
                                        {
                                            <option value="@p" selected="@(p == m.Priority)">@p</option>
                                        }
                                    </pems-select>
                                </pems-flex></form>
                            </pems-table-cell>
                            <pems-table-cell>@if (m.IsSystemDefault) { <pems-badge tone="info">@Localizer["System"]</pems-badge> }</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleConditionPriorityMappingActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@m.ConditionPriorityMappingId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این نگاشت غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!conditionPriorityMappings.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز نگاشتی ساخته نشده."]</p> }
        </pems-content-card>
    </pems-tab-pane>
