                        @foreach (var ec in equipmentClasses) { <option value="@ec.EquipmentClassId">@ec.Name</option> }
                    </pems-select>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Standard Reference (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="standardReferenceId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var sr in standardReferences) { <option value="@sr.StandardReferenceId">@sr.Code — @sr.Title</option> }
                    </pems-select>
