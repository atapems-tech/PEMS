            <pems-flex justify="between" align="center" css="mb-3">
                <pems-text class="text-muted small mb-0">
                    گروه‌بندی تعمیراتی دقیق‌تر از Discipline (مثلاً «Rotating Equipment» زیر «Mechanical») -
                    Team ها زیر همین گروه‌ها تعریف می‌شوند.
                </pems-text>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["گروه جدید"]
                </pems-button>
            </pems-flex>

            @{
                var rows_50 = Model;
                var cell_50_5 = DataCell.Template(rows_50, @<text>@{ var g = item; }
                                <pems-form asp-action="ToggleGroupActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@g.MaintenanceGroupId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این گروه غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </pems-form>
                            </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_50, c_ => c_.Add(((Localizer["کد"])?.ToString() ?? ""), g => (object?)(DataCell.Code(g.Code))).Add(((Localizer["نام"])?.ToString() ?? ""), g => (object?)(g.Name)).Add(((Localizer["دیسیپلین"])?.ToString() ?? ""), g => (object?)(g.Discipline?.Name)).Add(((Localizer["توضیحات"])?.ToString() ?? ""), g => (object?)((g.Description ?? "-")), css: "small text-muted").Add(((Localizer["System Default"])?.ToString() ?? ""), g => (object?)((g.IsSystemDefault ? (object?)DataCell.Badge("info", Localizer["System"]) : null))).Add("", g => (object?)cell_50_5(g), css: "text-end")))" />
            @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">هنوز گروه تعمیراتی‌ای ساخته نشده.</pems-text> }
        </pems-content-card>
    </pems-tab-pane>

