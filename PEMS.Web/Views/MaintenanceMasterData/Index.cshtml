<pems-modal id="addLimitModal" tabindex="-1">
        <form asp-action="AddEvaluationLimit" method="post">
            <pems-modal-header>@Localizer["Add Limit"] — <span id="addLimitProfileLabel"></span></pems-modal-header>
            <pems-modal-body>
                <p class="small text-muted">@Localizer["فقط مقدار واقعی مهندسی وارد کنید - هیچ مقداری حدس زده نمی‌شود؛ خالی گذاشتن هر دو فیلد رد می‌شود."]</p>
                <input type="hidden" name="evaluationProfileId" id="addLimitProfileId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Status"]</pems-label>
                    <pems-select scale="small" name="status" required>
                        @foreach (var st in new[] { "Normal", "Warning", "Alarm", "Critical" })
                        {
                            <option value="@st">@st</option>
                        }
                    </pems-select>
                </div>
                <pems-row>
                    <pems-col span="6" css="mb-2">
                        <pems-label css="small">@Localizer["Low Value (اختیاری)"]</pems-label>
                        <pems-input scale="small" type="number" step="any" name="lowValue" />
                    </pems-col>
                    <pems-col span="6" css="mb-2">
                        <pems-label css="small">@Localizer["High Value (اختیاری)"]</pems-label>
                        <pems-input scale="small" type="number" step="any" name="highValue" />
                    </pems-col>
                </pems-row>
                <pems-row>
                    <pems-col span="6" css="mb-2 form-check ms-1">
                        <pems-input kind="check" type="checkbox" name="lowInclusive" value="true" id="lowInclusiveCheck" checked />
                        <label class="form-check-label small" for="lowInclusiveCheck">@Localizer["Low Inclusive"]</label>
                    </pems-col>
                    <pems-col span="6" css="mb-2 form-check ms-1">
                        <pems-input kind="check" type="checkbox" name="highInclusive" value="true" id="highInclusiveCheck" checked />
                        <label class="form-check-label small" for="highInclusiveCheck">@Localizer["High Inclusive"]</label>
                    </pems-col>
                </pems-row>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

