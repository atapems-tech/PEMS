<pems-modal id="createEvaluationProfileModal" tabindex="-1">
        <pems-form asp-action="CreateEvaluationProfile" method="post">
            <pems-modal-header>@Localizer["Evaluation Profile جدید"]</pems-modal-header>
            <pems-modal-body>
                <pems-text class="small text-muted">@Localizer["فقط تعریف پروفایل - آستانه‌های واقعی را بعداً از دکمه‌ی «Add Limit» هر ردیف وارد کنید."]</pems-text>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Code"]</pems-label>
                    <pems-input scale="small" name="code" required placeholder="@Localizer["مثلاً VIB-PUMP-ISO20816"]" />
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Name"]</pems-label>
                    <pems-input scale="small" name="name" required />
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["نام فارسی (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="nameFa" />
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Variable Type"]</pems-label>
                    <pems-select scale="small" name="variableType" required>
                        @foreach (var vt in new[] { "Vibration", "Temperature", "Pressure", "Flow", "Current", "Voltage", "Lubrication", "OilAnalysis", "Thermography", "Acoustic", "ProcessDeviation" })
                        {
                            <option value="@vt">@vt</option>
                        }
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Equipment Class (اختیاری - خالی یعنی عمومی)"]</pems-label>
                    <pems-select scale="small" name="equipmentClassId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var ec in equipmentClasses) { <option value="@ec.EquipmentClassId">@ec.Name</option> }
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Standard Reference (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="standardReferenceId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var sr in standardReferences) { <option value="@sr.StandardReferenceId">@sr.Code — @sr.Title</option> }
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Operating Condition (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="operatingCondition" placeholder="@Localizer["مثلاً Normal Load"]" />
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Effective From"]</pems-label>
                    <pems-date name="effectiveFrom" scale="small" value="@PemsDates.Date(DateTime.Now)" />
                </pems-form-group>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="addLimitModal" tabindex="-1">
        <pems-form asp-action="AddEvaluationLimit" method="post">
            <pems-modal-header>@Localizer["Add Limit"] — <span id="addLimitProfileLabel"></span></pems-modal-header>
            <pems-modal-body>
                <pems-text class="small text-muted">@Localizer["فقط مقدار واقعی مهندسی وارد کنید - هیچ مقداری حدس زده نمی‌شود؛ خالی گذاشتن هر دو فیلد رد می‌شود."]</pems-text>
                <input type="hidden" name="evaluationProfileId" id="addLimitProfileId" />
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["Status"]</pems-label>
                    <pems-select scale="small" name="status" required>
                        @foreach (var st in new[] { "Normal", "Warning", "Alarm", "Critical" })
                        {
                            <option value="@st">@st</option>
                        }
                    </pems-select>
                </pems-form-group>
                <pems-row>
                    <pems-col span="6" css="mb-2">
                        <pems-label css="small">@Localizer["Low Value (اختیاری)"]</pems-label>
                        <pems-input scale="small" type="number" step="any" name="lowValue" />
                    </pems-col>
                    <pems-col span="6" css="mb-2">
                        <pems-label css="small">@Localizer["High Value (اختیاری)"]</pems-label>
                        <pems-input scale="small" type="number" step="any" name="highValue" />
                    </pems-col>
                </pems-row>
                <pems-row>
                    <pems-col span="6" css="mb-2 form-check ms-1">
                        <pems-input kind="check" type="checkbox" name="lowInclusive" value="true" id="lowInclusiveCheck" checked />
                        <label class="form-check-label small" for="lowInclusiveCheck">@Localizer["Low Inclusive"]</label>
                    </pems-col>
                    <pems-col span="6" css="mb-2 form-check ms-1">
                        <pems-input kind="check" type="checkbox" name="highInclusive" value="true" id="highInclusiveCheck" checked />
                        <label class="form-check-label small" for="highInclusiveCheck">@Localizer["High Inclusive"]</label>
                    </pems-col>
                </pems-row>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

