    <pems-tab-pane fade="true" id="tab-evaluation-profiles" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">
                    پروفایل ارزیابی نسخه‌دار برای نقاط پایش وضعیت (Condition Monitoring) - آستانه‌ها
                    (Normal/Warning/Alarm/Critical) جداگانه و فقط با مقدار واقعی مهندسی ثبت می‌شوند؛
                    نبودِ یک ردیف Limit یعنی «هنوز پیکربندی نشده»، نه صفر/عادی فرضی.
                </p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createEvaluationProfileModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["Evaluation Profile جدید"]
                </pems-button>
            </pems-flex>

            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Code"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["Variable Type"]</pems-table-header><pems-table-header>@Localizer["Equipment Class"]</pems-table-header><pems-table-header>@Localizer["Standard"]</pems-table-header><pems-table-header>@Localizer["Version"]</pems-table-header><pems-table-header>@Localizer["Limits"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var p in evaluationProfiles)
                    {
                        <pems-table-row>
                            <pems-table-cell><code>@p.Code</code></pems-table-cell>
                            <pems-table-cell>@p.Name</pems-table-cell>
                            <pems-table-cell><pems-badge tone="neutral">@p.VariableType</pems-badge></pems-table-cell>
                            <pems-table-cell class="small text-muted">@(p.EquipmentClass?.Name ?? "عمومی")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(p.StandardReference?.Code ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">v@(p.Version)</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (p.Limits.Any(l => l.IsActive))
                                {
                                    foreach (var l in p.Limits.Where(l => l.IsActive))
                                    {
                                        <pems-badge tone="light" css="me-1" title="@l.Status">
                                            @l.Status: @(l.LowValue?.ToString() ?? "−") … @(l.HighValue?.ToString() ?? "−")
                                        </pems-badge>
                                    }
                                }
                                else
                                {
                                    <pems-badge tone="none" css="text-warning-emphasis">@Localizer["پیکربندی نشده"]</pems-badge>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="text-end text-nowrap">
                                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addLimitModal" data-profile-id="@p.EvaluationProfileId" data-profile-code="@p.Code" title="@Localizer["Add Limit"]">
                                    <pems-icon name="bi-plus-circle" />
                                </pems-button>
                                <form asp-action="ToggleEvaluationProfileActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.EvaluationProfileId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["غیرفعال کردن"]" data-pems-confirm="این Evaluation Profile غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!evaluationProfiles.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز Evaluation Profile ای ساخته نشده."]</p> }
        </pems-content-card>
