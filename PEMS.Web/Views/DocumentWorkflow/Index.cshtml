@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.DocumentWorkflowPendingItemDto>
@{
    var history = (List<PEMS.Domain.Entities.DocumentWorkflow>)ViewBag.History;
    string? selectedStatus = ViewBag.SelectedStatus;
    var existingQueryString = string.IsNullOrWhiteSpace(selectedStatus) ? "" : $"status={selectedStatus}";
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Pending Approval Queue</h6>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('DocumentWorkflow')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>

    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="DocumentWorkflow">
            <thead>
                <tr>
                    <th data-col-key="docNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">Document No</th>
                    <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">Title</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Project</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px">Discipline</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180" style="width:110px">Status</th>
                    <th data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="100" style="width:70px">Rev</th>
                    <th data-col-key="actions" data-resizable="false" style="width:170px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Items)
                {
                    <tr>
                        <td>@d.DocumentNo</td>
                        <td>@d.Title</td>
                        <td>@d.ProjectName</td>
                        <td>@d.DisciplineName</td>
                        <td><span class="badge badge-status-@d.Status">@d.Status</span></td>
                        <td>@d.RevisionNo</td>
                        <td class="text-end">
                            @if (d.Status == "Submitted")
                            {
                                <form asp-action="Check" method="post" class="d-inline">
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button class="btn btn-sm btn-info"><i class="bi bi-clipboard-check"></i> Check</button>
                                </form>
                                <form asp-action="Reject" method="post" class="d-inline">
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Reject</button>
                                </form>
                            }
                            else if (d.Status == "Checked")
                            {
                                <form asp-action="Approve" method="post" class="d-inline">
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve</button>
                                </form>
                                <form asp-action="Reject" method="post" class="d-inline">
                                    <input type="hidden" name="documentId" value="@d.DocumentId" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Reject</button>
                                </form>
                            }
                            <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId"
                               class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Items.Any())
        {
            <p class="text-muted text-center py-4">No documents are currently waiting for approval.</p>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "DocumentWorkflow",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = existingQueryString
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('DocumentWorkflow');
        });
    </script>
}

<div class="content-card">
    <h6 class="mb-3">Recent Workflow History</h6>

    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>Document</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Action</th>
                    <th>By</th>
                    <th>Comment</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in history)
                {
                    <tr>
                        <td>@h.Document?.DocumentNo</td>
                        <td>@h.FromStatus</td>
                        <td>@h.ToStatus</td>
                        <td>@h.ActionType</td>
                        <td>@(h.ActionBy != null ? h.ActionBy.FirstName + " " + h.ActionBy.LastName : "-")</td>
                        <td>@h.Comment</td>
                        <td>@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
