@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.DocumentWorkflowPendingItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var history = (List<PEMS.Domain.Entities.DocumentWorkflow>)ViewBag.History;
    string? selectedStatus = ViewBag.SelectedStatus;
    var existingQueryString = string.IsNullOrWhiteSpace(selectedStatus) ? "" : $"status={Uri.EscapeDataString(selectedStatus)}";

    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component. Two panels share the page: the approval queue (with its
   check / approve / reject actions, unchanged) and the recent workflow history. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Dw_Queue"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="DocumentWorkflow" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (!string.IsNullOrWhiteSpace(selectedStatus))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(selectedStatus)" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="DocumentWorkflow" empty="@(!Model.Items.Any())" empty-text="@Localizer["Dw_Empty"]"
                             filtered="@(!string.IsNullOrWhiteSpace(selectedStatus))" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="docNo" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_DocNo"]</pems-table-header>
                        <pems-table-header class="pems-w-240" data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="400">@Localizer["Ed_Title"]</pems-table-header>
                        <pems-table-header data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" class="vs-hide-md pems-w-140">@Localizer["Project"]</pems-table-header>
                        <pems-table-header data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" class="vs-hide-md pems-w-120">@Localizer["Ed_Discipline"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-70" data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="100">@Localizer["Ed_Rev"]</pems-table-header>
                        <pems-table-header class="pems-w-220" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var d in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId" class="lp-subject" title="@d.DocumentNo">@d.DocumentNo</a></pems-table-cell>
                            <pems-table-cell><span class="vs-title-cell" title="@d.Title">@d.Title</span></pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@d.ProjectName</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@d.DisciplineName</pems-table-cell>
                            <pems-table-cell><span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(d.Status)"><pems-icon css="@DocumentStatusBadge.Icon(d.Status)" aria-hidden="true" /> @StatusText(d.Status)</span></pems-table-cell>
                            <pems-table-cell><span class="vs-num">@d.RevisionNo</span></pems-table-cell>
                            <pems-table-cell class="text-nowrap text-end">
                                @if (d.Status == "Submitted")
                                {
                                    <pems-form asp-action="Check" method="post" class="d-inline">
                                        <input type="hidden" name="documentId" value="@d.DocumentId" />
                                        <pems-button tone="info" size="small" outline="true" type="submit"><pems-icon name="bi-clipboard-check" aria-hidden="true" /> @Localizer["Dw_Check"]</pems-button>
                                    </pems-form>
                                    <pems-form asp-action="Reject" method="post" class="d-inline">
                                        <input type="hidden" name="documentId" value="@d.DocumentId" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-x-lg" aria-hidden="true" /> @Localizer["Reject"]</pems-button>
                                    </pems-form>
                                }
                                else if (d.Status == "Checked")
                                {
                                    <pems-form asp-action="Approve" method="post" class="d-inline">
                                        <input type="hidden" name="documentId" value="@d.DocumentId" />
                                        <pems-button tone="success" size="small" outline="true" type="submit"><pems-icon name="bi-check-lg" aria-hidden="true" /> @Localizer["Approve"]</pems-button>
                                    </pems-form>
                                    <pems-form asp-action="Reject" method="post" class="d-inline">
                                        <input type="hidden" name="documentId" value="@d.DocumentId" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-x-lg" aria-hidden="true" /> @Localizer["Reject"]</pems-button>
                                    </pems-form>
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "DocumentWorkflow",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = existingQueryString
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Dw_History"]" />
        <pems-list-grid>
            <pems-list-table empty="@(!history.Any())" empty-text="@Localizer["Dw_HistoryEmpty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["Rv_Document"]</pems-table-header>
                        <pems-table-header>@Localizer["Dw_From"]</pems-table-header>
                        <pems-table-header>@Localizer["Dw_To"]</pems-table-header>
                        <pems-table-header>@Localizer["Dw_Action"]</pems-table-header>
                        <pems-table-header>@Localizer["Dw_By"]</pems-table-header>
                        <pems-table-header>@Localizer["Dw_Comment"]</pems-table-header>
                        <pems-table-header>@Localizer["Rv_Date"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var h in history)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no">@h.Document?.DocumentNo</pems-table-cell>
                            <pems-table-cell class="small">@StatusText(h.FromStatus)</pems-table-cell>
                            <pems-table-cell class="small">@StatusText(h.ToStatus)</pems-table-cell>
                            <pems-table-cell class="small">@h.ActionType</pems-table-cell>
                            <pems-table-cell class="small">@(h.ActionBy != null ? h.ActionBy.FirstName + " " + h.ActionBy.LastName : "—")</pems-table-cell>
                            <pems-table-cell class="small">@h.Comment</pems-table-cell>
                            <pems-table-cell class="small text-muted">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
