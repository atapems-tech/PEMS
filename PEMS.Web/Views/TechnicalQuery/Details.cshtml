@model PEMS.Domain.Entities.TechnicalQuery
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var sb = Model.Status switch { "Closed" => "success", "PendingConfirmation" => "info", "Reopened" => "danger", _ => "warning" };
    var workflowRunning = (bool)(ViewBag.WorkflowRunning ?? false);
    var currentStageName = (string?)ViewBag.CurrentStageName;
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Model.QueryNumber <pems-badge tone="neutral">@Model.QueryType</pems-badge></h5>
            <span class="text-muted small">@Model.Project?.ProjectName &middot; @Model.Discipline?.Name</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <pems-badge tone="@sb" css="fs-6">@Model.Status</pems-badge>
            @if (Model.IsOverdue) { <pems-badge tone="danger" css="fs-6"><pems-icon name="bi-clock-history" /> @Localizer["Overdue"]</pems-badge> }
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <pems-row gap="3">
        <pems-col md="4"><strong>@Localizer["Priority:"]</strong> @Model.Priority</pems-col>
        <pems-col md="4"><strong>@Localizer["Raised:"]</strong> @Model.RaisedDate.ToString("yyyy-MM-dd")</pems-col>
        <pems-col md="4"><strong>Due:</strong> @(Model.RequiredResponseDate?.ToString("yyyy-MM-dd") ?? "-")</pems-col>
        @if (Model.RelatedDocument != null)
        {
            <pems-col md="6">
                <strong>@Localizer["Related Document:"]</strong>
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.RelatedDocumentId">@Model.RelatedDocument.DocumentNo</a>
            </pems-col>
        }
        @if (Model.RelatedEquipment != null)
        {
            <pems-col md="6">
                <strong>@Localizer["Related Equipment:"]</strong>
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.RelatedEquipmentId">@Model.RelatedEquipment.TagNumber</a>
            </pems-col>
        }
        <pems-col span="12"><strong>Subject:</strong> @Model.Subject</pems-col>
        <pems-col span="12"><strong>@Localizer["Description:"]</strong> @Model.Description</pems-col>
    </pems-row>
</div>

@if (!string.IsNullOrEmpty(Model.ResponseText))
{
    <div class="content-card mb-3 border-info">
        <h6 class="mb-2"><pems-icon name="bi-reply" /> @Localizer["Response"]</h6>
        <p class="mb-1">@Model.ResponseText</p>
        <p class="text-muted small mb-0">@(Model.RespondedDate?.ToString("yyyy-MM-dd HH:mm"))</p>
    </div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-paperclip" /> Attachments <pems-badge tone="neutral">@Model.Attachments.Count</pems-badge></h6>
    @if (Model.Attachments.Any())
    {
        <ul class="list-unstyled mb-3">
            @foreach (var a in Model.Attachments.Where(x => x.IsActive))
            {
                <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                    <a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><pems-icon name="bi-file-earmark" /> @a.FileName</a>
                    <span class="text-muted small">@a.UploadDate.ToString("yyyy-MM-dd")</span>
                </li>
            }
        </ul>
    }
    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-2">
        <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
        <pems-input scale="small" type="file" name="file" required />
        <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><pems-icon name="bi-upload" /> افزودن</pems-button>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3"><pems-icon name="bi-signpost-split" /> Workflow</h6>

    @if (!workflowRunning)
    {
        <p class="text-muted small mb-0">این مورد گردش‌کار فعالی ندارد (بسته شده یا هنوز شروع نشده).</p>
    }
    else if (currentStageName == "PendingResponse")
    {
        <p class="text-muted small">در انتظار پاسخ دیسیپلین <strong>@Model.Discipline?.Name</strong></p>
        @if (myDisciplineId == Model.DisciplineId)
        {
            <form asp-action="Respond" method="post">
                <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                <pems-textarea css="mb-2" name="responseText" rows="3" placeholder="@Localizer["متن پاسخ..."]" required></pems-textarea>
                <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-reply" /> ثبت پاسخ</pems-button>
            </form>
        }
    }
    else if (currentStageName == "PendingConfirmation")
    {
        <p class="text-muted small">پاسخ ثبت شده - در انتظار تایید ثبت‌کننده.</p>
        <div class="d-flex gap-2">
            <form asp-action="Confirm" method="post">
                <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> پاسخ کافیه - ببند</pems-button>
            </form>
            <pems-button tone="danger" size="small" type="button" data-bs-toggle="modal" data-bs-target="#reopenModal">
                <pems-icon name="bi-arrow-repeat" /> پاسخ کافی نیست
            </pems-button>
        </div>

        <pems-modal id="reopenModal" tabindex="-1">
                <form asp-action="Reopen" method="post">
                    <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["دلیل بازگشت"]</h6></div>
                    <div class="modal-body"><pems-textarea name="reason" rows="3" required></pems-textarea></div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                        <pems-button tone="danger" size="small" type="submit">@Localizer["بازگشت به دیسیپلین"]</pems-button>
                    </div>
                </form>
            </pems-modal>
    }
</div>
