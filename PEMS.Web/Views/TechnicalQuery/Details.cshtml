@model PEMS.Domain.Entities.TechnicalQuery
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var sb = Model.Status switch { "Closed" => "bg-success", "PendingConfirmation" => "bg-info text-dark", "Reopened" => "bg-danger", _ => "bg-warning text-dark" };
    var workflowRunning = (bool)(ViewBag.WorkflowRunning ?? false);
    var currentStageName = (string?)ViewBag.CurrentStageName;
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Model.QueryNumber <span class="badge bg-secondary">@Model.QueryType</span></h5>
            <span class="text-muted small">@Model.Project?.ProjectName &middot; @Model.Discipline?.Name</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @sb fs-6">@Model.Status</span>
            @if (Model.IsOverdue) { <span class="badge bg-danger fs-6"><i class="bi bi-clock-history"></i> @Localizer["Overdue"]</span> }
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-4"><strong>@Localizer["Priority:"]</strong> @Model.Priority</div>
        <div class="col-md-4"><strong>@Localizer["Raised:"]</strong> @Model.RaisedDate.ToString("yyyy-MM-dd")</div>
        <div class="col-md-4"><strong>Due:</strong> @(Model.RequiredResponseDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        @if (Model.RelatedDocument != null)
        {
            <div class="col-md-6">
                <strong>@Localizer["Related Document:"]</strong>
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.RelatedDocumentId">@Model.RelatedDocument.DocumentNo</a>
            </div>
        }
        @if (Model.RelatedEquipment != null)
        {
            <div class="col-md-6">
                <strong>@Localizer["Related Equipment:"]</strong>
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.RelatedEquipmentId">@Model.RelatedEquipment.TagNumber</a>
            </div>
        }
        <div class="col-12"><strong>Subject:</strong> @Model.Subject</div>
        <div class="col-12"><strong>@Localizer["Description:"]</strong> @Model.Description</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ResponseText))
{
    <div class="content-card mb-3 border-info">
        <h6 class="mb-2"><i class="bi bi-reply"></i> @Localizer["Response"]</h6>
        <p class="mb-1">@Model.ResponseText</p>
        <p class="text-muted small mb-0">@(Model.RespondedDate?.ToString("yyyy-MM-dd HH:mm"))</p>
    </div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-paperclip"></i> Attachments <span class="badge bg-secondary">@Model.Attachments.Count</span></h6>
    @if (Model.Attachments.Any())
    {
        <ul class="list-unstyled mb-3">
            @foreach (var a in Model.Attachments.Where(x => x.IsActive))
            {
                <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                    <a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><i class="bi bi-file-earmark"></i> @a.FileName</a>
                    <span class="text-muted small">@a.UploadDate.ToString("yyyy-MM-dd")</span>
                </li>
            }
        </ul>
    }
    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-2">
        <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
        <input type="file" name="file" class="form-control form-control-sm" required />
        <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap"><i class="bi bi-upload"></i> افزودن</button>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-signpost-split"></i> Workflow</h6>

    @if (!workflowRunning)
    {
        <p class="text-muted small mb-0">این مورد گردش‌کار فعالی ندارد (بسته شده یا هنوز شروع نشده).</p>
    }
    else if (currentStageName == "PendingResponse")
    {
        <p class="text-muted small">در انتظار پاسخ دیسیپلین <strong>@Model.Discipline?.Name</strong></p>
        @if (myDisciplineId == Model.DisciplineId)
        {
            <form asp-action="Respond" method="post">
                <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                <textarea name="responseText" class="form-control mb-2" rows="3" placeholder="@Localizer["متن پاسخ..."]" required></textarea>
                <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-reply"></i> ثبت پاسخ</button>
            </form>
        }
    }
    else if (currentStageName == "PendingConfirmation")
    {
        <p class="text-muted small">پاسخ ثبت شده - در انتظار تایید ثبت‌کننده.</p>
        <div class="d-flex gap-2">
            <form asp-action="Confirm" method="post">
                <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> پاسخ کافیه - ببند</button>
            </form>
            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reopenModal">
                <i class="bi bi-arrow-repeat"></i> پاسخ کافی نیست
            </button>
        </div>

        <div class="modal fade" id="reopenModal" tabindex="-1">
            <div class="modal-dialog"><div class="modal-content">
                <form asp-action="Reopen" method="post">
                    <input type="hidden" name="technicalQueryId" value="@Model.TechnicalQueryId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["دلیل بازگشت"]</h6></div>
                    <div class="modal-body"><textarea name="reason" class="form-control" rows="3" required></textarea></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                        <button type="submit" class="btn btn-danger btn-sm">@Localizer["بازگشت به دیسیپلین"]</button>
                    </div>
                </form>
            </div></div>
        </div>
    }
</div>
