@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-content-card css="pems-s-3f7efa5f">

    <form asp-action="Raise" method="post">
        <pems-row gap="3">
            <pems-col md="4">
                <pems-label>@Localizer["Type"]</pems-label>
                <pems-select name="queryType" required>
                    <option value="TQ">TQ - Technical Query</option>
                    <option value="TSR">TSR - Technical Study Request</option>
                    <option value="RFI">RFI - Request For Information</option>
                </pems-select>
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </pems-col>
            <pems-col md="4">
                <pems-label>Responsible Discipline</pems-label>
                <pems-select name="disciplineId" required>
                    @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </pems-col>

            <pems-col span="12"><pems-label>@Localizer["Subject"]</pems-label><pems-input name="subject" required /></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="4"></pems-textarea></pems-col>

            <pems-col md="6">
                <pems-label><pems-icon name="bi-file-earmark-text" /> مدرک مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی شماره مدرک، عنوان..."]" data-pems-search data-search-type="EngineeringDocument" data-search-hidden="#relatedDocumentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedDocumentId" id="relatedDocumentIdHidden" />
            </pems-col>
            <pems-col md="6">
                <pems-label><pems-icon name="bi-gear" /> تجهیز مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی تگ، نام..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#relatedEquipmentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedEquipmentId" id="relatedEquipmentIdHidden" />
            </pems-col>

            <pems-col md="6">
                <pems-label>مهلت پاسخ (SLA) <span class="text-muted small">@Localizer["(اختیاری)"]</span></pems-label>
                <pems-date name="requiredResponseDate" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Priority"]</pems-label>
                <pems-select name="priority">
                    <option>@Localizer["Normal"]</option><option>@Localizer["Low"]</option><option>@Localizer["High"]</option><option>@Localizer["Urgent"]</option>
                </pems-select>
            </pems-col>
        </pems-row>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Submit"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</pems-content-card>
