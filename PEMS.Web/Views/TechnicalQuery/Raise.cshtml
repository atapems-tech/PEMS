@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="content-card" style="max-width:800px;">

    <form asp-action="Raise" method="post">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">@Localizer["Type"]</label>
                <select name="queryType" class="form-select" required>
                    <option value="TQ">TQ - Technical Query</option>
                    <option value="TSR">TSR - Technical Study Request</option>
                    <option value="RFI">RFI - Request For Information</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Project"]</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Responsible Discipline</label>
                <select name="disciplineId" class="form-select" required>
                    @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </select>
            </div>

            <div class="col-12"><label class="form-label">@Localizer["Subject"]</label><input name="subject" class="form-control" required /></div>
            <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="4"></textarea></div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-file-earmark-text"></i> مدرک مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></label>
                <input type="text" class="form-control" placeholder="@Localizer["جستجوی شماره مدرک، عنوان..."]"
                       data-pems-search data-search-type="EngineeringDocument" data-search-hidden="#relatedDocumentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedDocumentId" id="relatedDocumentIdHidden" />
            </div>
            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-gear"></i> تجهیز مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></label>
                <input type="text" class="form-control" placeholder="@Localizer["جستجوی تگ، نام..."]"
                       data-pems-search data-search-type="Equipment" data-search-hidden="#relatedEquipmentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedEquipmentId" id="relatedEquipmentIdHidden" />
            </div>

            <div class="col-md-6">
                <label class="form-label">مهلت پاسخ (SLA) <span class="text-muted small">@Localizer["(اختیاری)"]</span></label>
                <input name="requiredResponseDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Priority"]</label>
                <select name="priority" class="form-select">
                    <option>@Localizer["Normal"]</option><option>@Localizer["Low"]</option><option>@Localizer["High"]</option><option>@Localizer["Urgent"]</option>
                </select>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Submit"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
