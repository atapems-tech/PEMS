@model List<(PEMS.Domain.Entities.DocumentAttachment Attachment, int PendingTags, int PendingSpecs)>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <p class="text-muted">
        فایل‌هایی که تحلیل هوش مصنوعی روی آن‌ها کامل شده‌اند. برای هرکدام تگ‌های تجهیز و مشخصات فنی
        استخراج‌شده را بازبینی و تایید/رد کنید.
    </p>

    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["File"]</th><th>@Localizer["Document"]</th><th>@Localizer["Summary"]</th>
                    <th>@Localizer["Confidence"]</th><th>@Localizer["Pending Tags"]</th><th>@Localizer["Pending Specs"]</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Attachment.FileName</td>
                        <td>@item.Attachment.Document?.DocumentNo</td>
                        <td class="small text-muted" style="max-width:300px;">@item.Attachment.AISummary</td>
                        <td>@(item.Attachment.AIConfidence.HasValue ? $"{item.Attachment.AIConfidence:P0}" : "-")</td>
                        <td>
                            @if (item.PendingTags > 0)
                            { <pems-badge tone="warning">@item.PendingTags</pems-badge> }
                            else
                            { <pems-badge tone="success">0</pems-badge> }
                        </td>
                        <td>
                            @if (item.PendingSpecs > 0)
                            { <pems-badge tone="warning">@item.PendingSpecs</pems-badge> }
                            else
                            { <pems-badge tone="success">0</pems-badge> }
                        </td>
                        <td>
                            <a asp-action="Review" asp-route-attachmentId="@item.Attachment.AttachmentId"
                               class="btn btn-sm btn-pems-solid">Review</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No AI-analyzed documents yet. Try Document Upload or OCR Processing.</p>
        }
    </div>
</div>
