@model List<(PEMS.Domain.Entities.DocumentAttachment Attachment, int PendingTags, int PendingSpecs)>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the intro is the heading tooltip. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["AI Extraction"]" total="@Model.Count"
                           heading-title="فایل‌هایی که تحلیل هوش مصنوعی روی آن‌ها کامل شده‌اند. برای هرکدام تگ‌های تجهیز و مشخصات فنی استخراج‌شده را بازبینی و تایید/رد کنید." />
        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="No AI-analyzed documents yet. Try Document Upload or OCR Processing.">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["File"]</pems-table-header><pems-table-header>@Localizer["Document"]</pems-table-header><pems-table-header>@Localizer["Summary"]</pems-table-header>
                        <pems-table-header>@Localizer["Confidence"]</pems-table-header><pems-table-header>@Localizer["Pending Tags"]</pems-table-header><pems-table-header>@Localizer["Pending Specs"]</pems-table-header><pems-table-header></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var item in Model)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell>@item.Attachment.FileName</pems-table-cell>
                            <pems-table-cell>@item.Attachment.Document?.DocumentNo</pems-table-cell>
                            <pems-table-cell class="small text-muted pems-s-aef3df2a">@item.Attachment.AISummary</pems-table-cell>
                            <pems-table-cell>@(item.Attachment.AIConfidence.HasValue ? $"{item.Attachment.AIConfidence:P0}" : "-")</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(item.PendingTags > 0 ? "warning" : "success")">@item.PendingTags</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(item.PendingSpecs > 0 ? "warning" : "success")">@item.PendingSpecs</pems-badge></pems-table-cell>
                            <pems-table-cell>
                                <pems-button tone="primary" size="small" as="a" asp-action="Review" asp-route-attachmentId="@item.Attachment.AttachmentId">Review</pems-button>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
