@model PEMS.Domain.Entities.DocumentAttachment
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<p class="text-muted">
    File: <strong>@Model.FileName</strong> &nbsp;|&nbsp;
    Confidence: <strong>@(Model.AIConfidence.HasValue ? $"{Model.AIConfidence:P0}" : "-")</strong>
</p>

@if (!string.IsNullOrEmpty(Model.AISummary))
{
    <pems-alert tone="secondary">@Model.AISummary</pems-alert>
}


<pems-button tone="neutral" outline="true" css="mb-3" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.DocumentId"
  >&larr; Back to Document</pems-button>

<pems-content-card css="mb-3">
    <h5 class="mb-3">Extracted Equipment Tags</h5>

    @if (!Model.ExtractedTags.Any())
    {
        <p class="text-muted">No equipment tags were extracted from this document.</p>
    }
    else
    {
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-row><pems-table-header>@Localizer["Tag Number"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Area"]</pems-table-header><pems-table-header>Service</pems-table-header><pems-table-header>@Localizer["Description"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header></pems-table-row>
            @foreach (var tag in Model.ExtractedTags)
            {
                <pems-table-row>
                    <pems-table-cell>@tag.TagNumber</pems-table-cell><pems-table-cell>@tag.TagType</pems-table-cell><pems-table-cell>@tag.Area</pems-table-cell>
                    <pems-table-cell>@tag.Service</pems-table-cell><pems-table-cell>@tag.Description</pems-table-cell>
                    <pems-table-cell>
                        @{
                            var tagBadge = tag.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                        }
                        <pems-badge tone="@tagBadge">@tag.ReviewStatus</pems-badge>
                    </pems-table-cell>
                    <pems-table-cell>
                        @if (tag.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveExtractedTag" method="post"><pems-flex gap="1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-input class="pems-w-160" scale="small" type="text" placeholder="@Localizer["جستجوی تجهیز..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#extTagEq_@tag.ExtractedTagId" autocomplete="off" />
                                <input type="hidden" name="equipmentId" id="extTagEq_@tag.ExtractedTagId" />
                                <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                            </pems-flex></form>
                            <form asp-action="RejectExtractedTag" method="post" class="d-inline mt-1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                            </form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table>
        </pems-table-scroll>
    }
</pems-content-card>

<pems-content-card>
    <h5 class="mb-3">Extracted Specifications</h5>

    @if (!Model.ExtractedSpecifications.Any())
    {
        <p class="text-muted">No technical specifications were extracted from this document.</p>
    }
    else
    {
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-row><pems-table-header>Related Tag</pems-table-header><pems-table-header>Field</pems-table-header><pems-table-header>@Localizer["Value"]</pems-table-header><pems-table-header>@Localizer["Unit"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header></pems-table-row>
            @foreach (var spec in Model.ExtractedSpecifications)
            {
                <pems-table-row>
                    <pems-table-cell>@spec.RelatedTagNumber</pems-table-cell><pems-table-cell>@spec.FieldName</pems-table-cell><pems-table-cell>@spec.FieldValue</pems-table-cell><pems-table-cell>@spec.Unit</pems-table-cell>
                    <pems-table-cell>
                        @{
                            var specBadge = spec.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                        }
                        <pems-badge tone="@specBadge">@spec.ReviewStatus</pems-badge>
                    </pems-table-cell>
                    <pems-table-cell>
                        @if (spec.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                            </form>
                            <form asp-action="RejectExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                            </form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table>
        </pems-table-scroll>
    }
</pems-content-card>
