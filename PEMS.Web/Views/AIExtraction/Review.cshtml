@model PEMS.Domain.Entities.DocumentAttachment
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<p class="text-muted">
    File: <strong>@Model.FileName</strong> &nbsp;|&nbsp;
    Confidence: <strong>@(Model.AIConfidence.HasValue ? $"{Model.AIConfidence:P0}" : "-")</strong>
</p>

@if (!string.IsNullOrEmpty(Model.AISummary))
{
    <div class="alert alert-secondary">@Model.AISummary</div>
}


<a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.DocumentId"
   class="btn btn-outline-secondary mb-3">&larr; Back to Document</a>

<div class="content-card mb-3">
    <h5 class="mb-3">Extracted Equipment Tags</h5>

    @if (!Model.ExtractedTags.Any())
    {
        <p class="text-muted">No equipment tags were extracted from this document.</p>
    }
    else
    {
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <tr><th>@Localizer["Tag Number"]</th><th>@Localizer["Type"]</th><th>@Localizer["Area"]</th><th>Service</th><th>@Localizer["Description"]</th><th>@Localizer["Status"]</th><th>@Localizer["Action"]</th></tr>
            @foreach (var tag in Model.ExtractedTags)
            {
                <tr>
                    <td>@tag.TagNumber</td><td>@tag.TagType</td><td>@tag.Area</td>
                    <td>@tag.Service</td><td>@tag.Description</td>
                    <td>
                        @{
                            var tagBadge = tag.ReviewStatus switch { "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
                        }
                        <span class="badge @tagBadge">@tag.ReviewStatus</span>
                    </td>
                    <td>
                        @if (tag.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveExtractedTag" method="post" class="d-flex gap-1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <input type="text" class="form-control form-control-sm" style="width:160px;"
                                       placeholder="@Localizer["جستجوی تجهیز..."]" data-pems-search data-search-type="Equipment"
                                       data-search-hidden="#extTagEq_@tag.ExtractedTagId" autocomplete="off" />
                                <input type="hidden" name="equipmentId" id="extTagEq_@tag.ExtractedTagId" />
                                <button type="submit" class="btn btn-sm btn-success">@Localizer["Approve"]</button>
                            </form>
                            <form asp-action="RejectExtractedTag" method="post" class="d-inline mt-1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Reject"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </table>
        </div>
    }
</div>

<div class="content-card">
    <h5 class="mb-3">Extracted Specifications</h5>

    @if (!Model.ExtractedSpecifications.Any())
    {
        <p class="text-muted">No technical specifications were extracted from this document.</p>
    }
    else
    {
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <tr><th>Related Tag</th><th>Field</th><th>@Localizer["Value"]</th><th>@Localizer["Unit"]</th><th>@Localizer["Status"]</th><th>@Localizer["Action"]</th></tr>
            @foreach (var spec in Model.ExtractedSpecifications)
            {
                <tr>
                    <td>@spec.RelatedTagNumber</td><td>@spec.FieldName</td><td>@spec.FieldValue</td><td>@spec.Unit</td>
                    <td>
                        @{
                            var specBadge = spec.ReviewStatus switch { "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
                        }
                        <span class="badge @specBadge">@spec.ReviewStatus</span>
                    </td>
                    <td>
                        @if (spec.ReviewStatus == "Draft")
                        {
                            <form asp-action="ApproveExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <button type="submit" class="btn btn-sm btn-success">@Localizer["Approve"]</button>
                            </form>
                            <form asp-action="RejectExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Reject"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </table>
        </div>
    }
</div>
