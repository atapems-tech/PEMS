@model PEMS.Domain.Entities.DocumentAttachment
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-text class="text-muted">
    File: <strong>@Model.FileName</strong> &nbsp;|&nbsp;
    Confidence: <strong>@(Model.AIConfidence.HasValue ? $"{Model.AIConfidence:P0}" : "-")</strong>
</pems-text>

@if (!string.IsNullOrEmpty(Model.AISummary))
{
    <pems-alert tone="secondary">@Model.AISummary</pems-alert>
}


<pems-button tone="neutral" outline="true" css="mb-3" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.DocumentId"
  >&larr; Back to Document</pems-button>

<pems-content-card css="mb-3">
    <pems-heading level="5" class="mb-3">Extracted Equipment Tags</pems-heading>

    @if (!Model.ExtractedTags.Any())
    {
        <pems-text class="text-muted">No equipment tags were extracted from this document.</pems-text>
    }
    else
    {
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        @{
            var rows_17 = Model.ExtractedTags;
            var cell_17_5 = DataCell.Template(rows_17, @<text>@{ var tag = item; }
                        @{
                            var tagBadge = tag.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                        }
                        <pems-badge tone="@tagBadge">@tag.ReviewStatus</pems-badge>
                    </text>);
            var cell_17_6 = DataCell.Template(rows_17, @<text>@{ var tag = item; }
                        @if (tag.ReviewStatus == "Draft")
                        {
                            <pems-form asp-action="ApproveExtractedTag" method="post"><pems-flex gap="1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-input class="pems-w-160" scale="small" type="text" placeholder="@Localizer["جستجوی تجهیز..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#extTagEq_@tag.ExtractedTagId" autocomplete="off" />
                                <input type="hidden" name="equipmentId" id="extTagEq_@tag.ExtractedTagId" />
                                <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                            </pems-flex></pems-form>
                            <pems-form asp-action="RejectExtractedTag" method="post" class="d-inline mt-1">
                                <input type="hidden" name="extractedTagId" value="@tag.ExtractedTagId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                            </pems-form>
                        }
                    </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_17, c_ => c_.Add(((Localizer["Tag Number"])?.ToString() ?? ""), tag => (object?)(tag.TagNumber)).Add(((Localizer["Type"])?.ToString() ?? ""), tag => (object?)(tag.TagType)).Add(((Localizer["Area"])?.ToString() ?? ""), tag => (object?)(tag.Area)).Add("Service", tag => (object?)(tag.Service)).Add(((Localizer["Description"])?.ToString() ?? ""), tag => (object?)(tag.Description)).Add(((Localizer["Status"])?.ToString() ?? ""), tag => (object?)cell_17_5(tag)).Add(((Localizer["Action"])?.ToString() ?? ""), tag => (object?)cell_17_6(tag))))" />
        </pems-table-scroll>
    }
</pems-content-card>

<pems-content-card>
    <pems-heading level="5" class="mb-3">Extracted Specifications</pems-heading>

    @if (!Model.ExtractedSpecifications.Any())
    {
        <pems-text class="text-muted">No technical specifications were extracted from this document.</pems-text>
    }
    else
    {
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        @{
            var rows_18 = Model.ExtractedSpecifications;
            var cell_18_4 = DataCell.Template(rows_18, @<text>@{ var spec = item; }
                        @{
                            var specBadge = spec.ReviewStatus switch { "Approved" => "success", "Rejected" => "danger", _ => "neutral" };
                        }
                        <pems-badge tone="@specBadge">@spec.ReviewStatus</pems-badge>
                    </text>);
            var cell_18_5 = DataCell.Template(rows_18, @<text>@{ var spec = item; }
                        @if (spec.ReviewStatus == "Draft")
                        {
                            <pems-form asp-action="ApproveExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="success" size="small" type="submit">@Localizer["Approve"]</pems-button>
                            </pems-form>
                            <pems-form asp-action="RejectExtractedSpecification" method="post" class="d-inline">
                                <input type="hidden" name="extractedSpecificationId" value="@spec.ExtractedSpecificationId" />
                                <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                            </pems-form>
                        }
                    </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_18, c_ => c_.Add("Related Tag", spec => (object?)(spec.RelatedTagNumber)).Add("Field", spec => (object?)(spec.FieldName)).Add(((Localizer["Value"])?.ToString() ?? ""), spec => (object?)(spec.FieldValue)).Add(((Localizer["Unit"])?.ToString() ?? ""), spec => (object?)(spec.Unit)).Add(((Localizer["Status"])?.ToString() ?? ""), spec => (object?)cell_18_4(spec)).Add(((Localizer["Action"])?.ToString() ?? ""), spec => (object?)cell_18_5(spec))))" />
        </pems-table-scroll>
    }
</pems-content-card>
