@model List<PEMS.Application.DTOs.ChatMessageDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="pems-maxw-820">

    <pems-flex justify="between" align="center" css="mb-3">
        <p class="text-muted mb-0">
            بر اساس داده‌ی واقعی سیستم (تعداد مدارک، وضعیت‌ها، پروژه‌ها، MR ها و ...) پاسخ می‌دهد.
            مثال: «چند مدرک در انتظار تایید داریم؟» یا «آخرین مدارک ثبت‌شده کدامند؟»
        </p>
        <pems-form asp-action="Clear" method="post">
            <pems-button tone="neutral" size="small" outline="true"><pems-icon name="bi-trash" /> @Localizer["Clear"]</pems-button>
        </pems-form>
    </pems-flex>

    <div id="chatWindow" class="border rounded p-3 mb-3 pems-s-732b5bfd">
        @foreach (var m in Model)
        {
            <pems-flex css="mb-3 @(m.Role == "User" ? "justify-content-end" : "justify-content-start")">
                <div class="p-2 rounded @(m.Role == "User" ? "bg-primary text-white" : "bg-white border") pems-maxw-75pct">
                    @m.Content
                </div>
            </pems-flex>
        }
    </div>

    <pems-form id="chatForm" data-ask-url="@Url.Action("Ask", "ChatAssistant")"><pems-flex gap="2">
        @Html.AntiForgeryToken()
        <pems-input type="text" id="messageInput" placeholder="Ask a question about the system..." autocomplete="off" />
        <pems-button tone="primary" type="submit"><pems-icon name="bi-send" /></pems-button>
    </pems-flex></pems-form>
</pems-content-card>

@section Scripts {
    <script src="~/js/views/chatassistant-index.js" asp-append-version="true"></script>
}
