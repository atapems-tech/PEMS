@model List<PEMS.Application.DTOs.ChatMessageDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card" style="max-width:820px;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">
            بر اساس داده‌ی واقعی سیستم (تعداد مدارک، وضعیت‌ها، پروژه‌ها، MR ها و ...) پاسخ می‌دهد.
            مثال: «چند مدرک در انتظار تایید داریم؟» یا «آخرین مدارک ثبت‌شده کدامند؟»
        </p>
        <form asp-action="Clear" method="post">
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-trash"></i> @Localizer["Clear"]</button>
        </form>
    </div>

    <div id="chatWindow" class="border rounded p-3 mb-3" style="height:420px; overflow-y:auto; background:#fafbfc;">
        @foreach (var m in Model)
        {
            <div class="mb-3 d-flex @(m.Role == "User" ? "justify-content-end" : "justify-content-start")">
                <div class="p-2 rounded @(m.Role == "User" ? "bg-primary text-white" : "bg-white border")" style="max-width:75%;">
                    @m.Content
                </div>
            </div>
        }
    </div>

    <form id="chatForm" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input type="text" id="messageInput" class="form-control" placeholder="Ask a question about the system..." autocomplete="off" />
        <button type="submit" class="btn btn-pems-solid"><i class="bi bi-send"></i></button>
    </form>
</div>

@section Scripts {
    <script>
        const chatWindow = document.getElementById('chatWindow');
        const form = document.getElementById('chatForm');
        const input = document.getElementById('messageInput');

        function addBubble(text, isUser) {
            const wrap = document.createElement('div');
            wrap.className = 'mb-3 d-flex ' + (isUser ? 'justify-content-end' : 'justify-content-start');
            const bubble = document.createElement('div');
            bubble.className = 'p-2 rounded ' + (isUser ? 'bg-primary text-white' : 'bg-white border');
            bubble.style.maxWidth = '75%';
            bubble.innerText = text;
            wrap.appendChild(bubble);
            chatWindow.appendChild(wrap);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const message = input.value.trim();
            if (!message) return;

            addBubble(message, true);
            input.value = '';
            addBubble('در حال فکر کردن... (روی سخت‌افزار ضعیف‌تر ممکن است تا یک دقیقه طول بکشد)', false);

            // طبق گزارش واقعی سخت‌افزار ضعیف: پیام انتظار را هر ۱۵ ثانیه به‌روزرسانی می‌کند تا
            // کاربر مطمئن شود سیستم گیر نکرده، فقط کند است
            let waitedSeconds = 0;
            const waitTimer = setInterval(function () {
                waitedSeconds += 15;
                const lastBubble = chatWindow.lastChild;
                if (lastBubble) {
                    lastBubble.querySelector('div').innerText = 'همچنان در حال پردازش... (' + waitedSeconds + ' ثانیه گذشته)';
                }
            }, 15000);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const body = new URLSearchParams();
            body.append('message', message);
            body.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('@Url.Action("Ask", "ChatAssistant")', {
                    method: 'POST',
                    body: body
                });
                clearInterval(waitTimer);
                const data = await res.json();
                chatWindow.lastChild.remove();
                addBubble(data.answer, false);
            } catch (err) {
                clearInterval(waitTimer);
                chatWindow.lastChild.remove();
                addBubble('Error contacting the assistant. Please try again.', false);
            }
        });
    </script>
}
