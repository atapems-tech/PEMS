@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TransmittalDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_TransmittalRegistry"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component. The registry has no filters; it keeps its columns, the
   overdue-response flag and paging. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">

    <nav class="vs-subnav" aria-label="@Localizer["Ed_Documents"]">
        <a asp-controller="EngineeringDocuments" asp-action="Index">@Localizer["Ed_Documents"]</a>
        <a asp-controller="DocumentRegister" asp-action="Index">@Localizer["Ed_Register"]</a>
        <a asp-controller="VDR" asp-action="Index">@Localizer["Ed_VendorDocs"]</a>
        <a asp-controller="Transmittal" asp-action="Index" class="active" aria-current="page">@Localizer["Ed_Transmittals"]</a>
    </nav>

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Vs_TransmittalRegistry"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Transmittal" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Vs_NewTransmittal"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Transmittal" empty="@(!Model.Items.Any())" empty-text="@Localizer["Vs_NoTransmittals"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="no" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Vs_TransmittalNo"]</pems-table-header>
                        <pems-table-header class="pems-w-140" data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Vs_Project"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="from" data-resizable="true" data-min-width="80" data-max-width="180">@Localizer["Vs_From"]</pems-table-header>
                        <pems-table-header class="pems-w-140" data-col-key="to" data-resizable="true" data-min-width="80" data-max-width="220">@Localizer["Vs_To"]</pems-table-header>
                        <pems-table-header data-col-key="purpose" data-resizable="true" data-min-width="100" data-max-width="220" class="vs-hide-md pems-w-140">@Localizer["Vs_Purpose"]</pems-table-header>
                        <pems-table-header class="pems-w-80" data-col-key="items" data-resizable="true" data-min-width="60" data-max-width="120">@Localizer["Vs_Items"]</pems-table-header>
                        <pems-table-header class="pems-w-170" data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="240">@Localizer["Status"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="date" data-resizable="true" data-min-width="100" data-max-width="160">@Localizer["Vs_Date"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var t in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@t.TransmittalId" class="lp-subject" title="@t.TransmittalNo">@t.TransmittalNo</a></pems-table-cell>
                            <pems-table-cell class="small">@t.ProjectName</pems-table-cell>
                            <pems-table-cell class="small">@t.From</pems-table-cell>
                            <pems-table-cell class="small">@t.To</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@t.Purpose</pems-table-cell>
                            <pems-table-cell><span class="vs-pill vs-pill--neutral vs-num">@t.ItemsCount</span></pems-table-cell>
                            <pems-table-cell>
                                <span class="vs-pill @VdrUi.TransmittalTone(t.Status)">@VdrUi.Loc(Localizer, "St_", t.Status)</span>
                                @if (t.IsResponseOverdue)
                                {
                                    <span class="vs-pill vs-pill--icon vs-pill--danger"><pems-icon name="bi-clock-history" aria-hidden="true" /> @Localizer["Vs_ResponseOverdue"]</span>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="small text-muted">@t.TransmittalDate.ToString("yyyy-MM-dd")</pems-table-cell>
                            <pems-table-cell class="text-nowrap lp-actions">
                                <a asp-action="Details" asp-route-id="@t.TransmittalId" class="lp-act lp-act--always" title="@Localizer["Vs_View"]"><pems-icon name="bi-eye" aria-hidden="true" /><span class="visually-hidden">@Localizer["Vs_View"]: @t.TransmittalNo</span></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Transmittal",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
