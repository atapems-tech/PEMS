@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TransmittalDto>

<div class="content-card">
    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Transmittal')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
        <a asp-action="Create" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New Transmittal</a>
    </div>

    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Transmittal">
            <thead>
                <tr>
                    <th data-col-key="no" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Transmittal No</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Project</th>
                    <th data-col-key="from" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">From</th>
                    <th data-col-key="to" data-resizable="true" data-min-width="80" data-max-width="220" style="width:140px">To</th>
                    <th data-col-key="purpose" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Purpose</th>
                    <th data-col-key="items" data-resizable="true" data-min-width="60" data-max-width="120" style="width:80px">Items</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">Status</th>
                    <th data-col-key="date" data-resizable="true" data-min-width="100" data-max-width="160" style="width:120px">Date</th>
                    <th data-col-key="actions" data-resizable="false" style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td>@t.TransmittalNo</td>
                        <td>@t.ProjectName</td>
                        <td>@t.From</td>
                        <td>@t.To</td>
                        <td>@t.Purpose</td>
                        <td><span class="badge bg-secondary">@t.ItemsCount</span></td>
                        <td>
                            <span class="badge @(t.Status == "Sent" ? "bg-success" : t.Status == "Acknowledged" ? "bg-primary" : t.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">@t.Status</span>
                            @if (t.IsResponseOverdue)
                            {
                                <span class="badge bg-danger">response overdue</span>
                            }
                        </td>
                        <td>@t.TransmittalDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@t.TransmittalId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Items.Any())
        {
            <p class="text-muted text-center py-4">No transmittals have been created yet.</p>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Transmittal",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Transmittal');
        });
    </script>
}
