@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var documents = (IEnumerable<dynamic>)ViewBag.Documents;
}

<pems-page-shell kind="workspace">


<pems-content-card css="pems-s-1d34c094">
    <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-alert>

    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="6">
                <pems-label>Transmittal No</pems-label>
                <pems-input name="transmittalNo" placeholder="e.g. TR-2026-001" required />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects)
                    {
                        <option value="@p.ProjectId">@p.ProjectName</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["From"]</pems-label>
                <pems-input name="from" placeholder="e.g. Engineering Department" required />
            </pems-col>
            <pems-col md="6">
                <pems-label>To <span class="text-muted small">(free-text summary - optional if recipients added below)</span></pems-label>
                <pems-input name="to" placeholder="e.g. Contractor XYZ" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Purpose"]</pems-label>
                <pems-select name="purpose">
                    <option value="IFA">@Localizer["IFA - Issued for Approval"]</option>
                    <option value="IFR">@Localizer["IFR - Issue for Review and Comments"]</option>
                    <option value="IFI">IFI - Issue for Information</option>
                    <option value="FI">@Localizer["FI - Final Issue (without comments)"]</option>
                    <option value="For Approval">@Localizer["For Approval (legacy)"]</option>
                    <option value="For Construction">@Localizer["For Construction (legacy)"]</option>
                    <option value="For Information" selected>@Localizer["For Information (legacy)"]</option>
                    <option value="For Review">For Review (legacy)</option>
                </pems-select>
            </pems-col>
            <pems-col md="6" css="d-flex align-items-end">
                <div class="form-check">
                    <pems-input kind="check" type="checkbox" name="responseRequired" value="true" id="responseRequired" />
                    <label class="form-check-label" for="responseRequired">Response Required</label>
                    <input type="hidden" name="responseRequired" value="false" />
                </div>
            </pems-col>
            <pems-col span="12">
                <pems-label>@Localizer["Description"]</pems-label>
                <pems-textarea name="description" rows="2"></pems-textarea>
            </pems-col>

            <pems-col span="12">
                <pems-label css="d-block">Recipients <span class="text-muted small">(structured - required)</span></pems-label>
                <div id="recipientRows"></div>
                <pems-button tone="neutral" size="small" outline="true" css="mt-1" type="button" id="addRecipientBtn"><pems-icon name="bi-plus-lg" /> Add Recipient</pems-button>
            </pems-col>

            <pems-col span="12">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <pems-label css="d-block mb-0">Documents to include</pems-label>
                    <span class="small text-muted" id="docPickerCounter"></span>
                </div>
                <p class="text-muted small mb-1">
                    Only showing documents from the selected project. Documents on Hold cannot be transmitted. Type to search by number or title.
                </p>
                <pems-input scale="small" css="mb-2" type="text" id="docPickerSearch" placeholder="Search by document number or title..." />
                <div class="border rounded p-2 pems-scroll-320" id="docPickerList">
                    @foreach (var d in documents)
                    {
                        <div class="form-check doc-picker-row" data-project-id="@d.ProjectId" data-search="@($"{d.DocumentNo} {d.Title}".ToLower())">
                            <pems-input type="checkbox" name="documentIds" value="@d.DocumentId" id="doc_@d.DocumentId" disabled="@((bool)d.IsOnHold)" kind="check" css="doc-picker-checkbox" />
                            <label class="form-check-label" for="doc_@d.DocumentId">
                                @d.DocumentNo - @d.Title
                                <span class="text-muted small">(Rev @d.RevisionNo &middot; @d.DisciplineName &middot; @d.Status)</span>
                                @if ((bool)d.IsOnHold)
                                {
                                    <pems-badge tone="warning">@Localizer["On Hold"]</pems-badge>
                                }
                            </label>
                        </div>
                    }
                </div>
                @if (!documents.Any())
                {
                    <p class="text-muted small mb-0">No documents available.</p>
                }
            </pems-col>
        </pems-row>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">Create Transmittal</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</pems-content-card>

<template id="recipientRowTemplate">
    <pems-row gap="2" css="mb-2 recipient-row align-items-center">
        <pems-col md="3"><pems-input scale="small" name="recipientName" placeholder="@Localizer["Name"]" /></pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="recipientType">
                <option value="External">External</option>
                <option value="Internal">@Localizer["Internal"]</option>
                <option value="Vendor">@Localizer["Vendor"]</option>
                <option value="Client">@Localizer["Client"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="3"><pems-input scale="small" name="recipientOrganization" placeholder="@Localizer["Organization"]" /></pems-col>
        <pems-col md="2" css="form-check">
            <pems-input kind="check" type="checkbox" name="recipientResponseRequired" value="true" />
            <label class="form-check-label small">Response req.</label>
        </pems-col>
        <pems-col md="1"><pems-button tone="danger" size="small" outline="true" css="remove-recipient-btn" type="button"><pems-icon name="bi-x-lg" /></pems-button></pems-col>
    </pems-row>
</template>

@section Scripts {
    <script src="~/js/views/transmittal-create.js" asp-append-version="true"></script>
}

</pems-page-shell>

@{ ViewData["Title"] = Localizer["Vs_NewTransmittal"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
