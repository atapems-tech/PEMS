@model PEMS.Application.DTOs.TransmittalDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Web.Helpers
@{ ViewData["Title"] = Model.TransmittalNo; }

<pems-page-shell kind="workspace">

<div class="vs-header">
    <span class="vs-pill @VdrUi.TransmittalTone(Model.Status)">@VdrUi.Loc(Localizer, "St_", Model.Status)</span>
    <a asp-action="Index" class="vs-btn vs-btn--sm"><pems-icon name="bi-arrow-left" /> @Localizer["Vs_Back"]</a>
</div>

<pems-content-card css="mb-3">
    <pems-info-grid>
        <pems-info-item label="@Localizer["Vs_Project"]">@Model.ProjectName</pems-info-item>
        <pems-info-item label="@Localizer["Vs_From"]">@Model.From</pems-info-item>
        <pems-info-item label="@Localizer["Vs_To"]">@Model.To</pems-info-item>
        <pems-info-item label="@Localizer["Vs_Purpose"]">@Model.Purpose</pems-info-item>
        <pems-info-item label="@Localizer["Td_Created"]" num>@Model.TransmittalDate.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Td_Sent"]" num>@Model.SentDate?.ToString("yyyy-MM-dd")</pems-info-item>
    </pems-info-grid>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="mt-3 text-muted">@Model.Description</p>
    }

    @if (Model.SupersedesTransmittalId.HasValue)
    {
        <p class="small text-muted">
            <pems-icon name="bi-arrow-return-right" /> @Localizer["Td_ReissuedFrom"]
            <a asp-action="Details" asp-route-id="@Model.SupersedesTransmittalId">@Model.SupersedesTransmittalNo</a>
        </p>
    }
    @if (Model.SupersededByTransmittalId.HasValue)
    {
        <p class="small text-muted">
            <pems-icon name="bi-arrow-return-right" /> @Localizer["Td_SupersededBy"]
            <a asp-action="Details" asp-route-id="@Model.SupersededByTransmittalId">@Model.SupersededByTransmittalNo</a>
        </p>
    }

    @if (Model.Status == "Cancelled")
    {
        <pems-alert tone="danger" css="py-2 px-3 small mb-2">
            @Localizer["Td_Cancelled"] @Model.CancelledDate?.ToString("yyyy-MM-dd") - @Model.CancelledReason
        </pems-alert>
    }

    @if (Model.Status == "Draft")
    {
        <pems-form class="mt-2" asp-action="MarkSent" asp-route-id="@Model.TransmittalId" method="post"><pems-flex gap="2" align="end">
            @if (Model.ResponseRequired)
            {
                <div>
                    <pems-label css="small mb-0">@Localizer["Td_ResponseDueDays"]</pems-label>
                    <pems-input class="pems-w-100" scale="small" name="responseDueWorkingDays" type="number" value="10" min="1" />
                </div>
            }
            @if ((bool)(ViewBag.CanIssue ?? false))
            {
                <pems-button tone="primary" size="small"><pems-icon name="bi-send" /> @Localizer["Td_MarkSent"]</pems-button>
            }
            else
            {
                <span class="text-muted small">@Localizer["Td_NoIssuePerm"]</span>
            }
        </pems-flex></pems-form>
    }

    @if (Model.Status == "Sent" || Model.Status == "Acknowledged")
    {
        <pems-alert tone="secondary" css="py-2 px-3 small mt-2 mb-2">
            <pems-icon name="bi-lock" /> @Localizer["Td_Locked"]
        </pems-alert>

        @if ((bool)(ViewBag.CanCancel ?? false))
        {
            <pems-form class="mt-2" asp-action="Cancel" asp-route-id="@Model.TransmittalId" method="post"><pems-flex gap="2" align="end">
                <div class="flex-grow-1">
                    <pems-label css="small mb-0">@Localizer["Td_CancelReason"]</pems-label>
                    <pems-input scale="small" name="reason" required />
                </div>
                <pems-button tone="danger" size="small" outline="true"><pems-icon name="bi-x-circle" /> @Localizer["Td_CancelBtn"]</pems-button>
            </pems-flex></pems-form>
        }

        @if (Model.ResponseRequired)
        {
            <div class="mt-3">
                <strong>@Localizer["Td_ResponseDue"]</strong> @(Model.ResponseDueDate?.ToString("yyyy-MM-dd") ?? "-")
                @if (Model.IsResponseOverdue)
                {
                    <pems-badge tone="danger">@Localizer["Td_Overdue"]</pems-badge>
                }
                @if (Model.ResponseReceivedDate.HasValue)
                {
                    <pems-badge tone="success">@Localizer["Td_Received"] @Model.ResponseReceivedDate.Value.ToString("yyyy-MM-dd")</pems-badge>
                    <div class="small text-muted">@Model.ResponseNote</div>
                }
                else if ((bool)(ViewBag.CanRecordResponse ?? false))
                {
                    <pems-form class="mt-1" asp-action="RecordResponse" asp-route-id="@Model.TransmittalId" method="post"><pems-flex gap="2" align="end">
                        <div class="flex-grow-1">
                            <pems-input scale="small" name="responseNote" placeholder="@Localizer["Td_ResponseNotePh"]" />
                        </div>
                        <pems-button tone="primary" size="small" outline="true">@Localizer["Td_RecordResponse"]</pems-button>
                    </pems-flex></pems-form>
                }
            </div>
        }
    }

    @if (Model.Status == "Cancelled" && (bool)(ViewBag.CanReissue ?? false))
    {
        <pems-form asp-action="Reissue" asp-route-id="@Model.TransmittalId" method="post" class="mt-2">
            <pems-button tone="primary" size="small" outline="true"><pems-icon name="bi-arrow-repeat" /> @Localizer["Td_Reissue"]</pems-button>
        </pems-form>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Td_Recipients"]</h6>
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Td_Name"]</pems-table-header><pems-table-header>@Localizer["Td_Type"]</pems-table-header><pems-table-header>@Localizer["Td_Organization"]</pems-table-header><pems-table-header>@Localizer["Td_ResponseRequired"]</pems-table-header><pems-table-header>@Localizer["Td_Acknowledgement"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var r in Model.Recipients)
            {
                <pems-table-row>
                    <pems-table-cell>@r.Name</pems-table-cell>
                    <pems-table-cell>@r.RecipientType</pems-table-cell>
                    <pems-table-cell>@r.Organization</pems-table-cell>
                    <pems-table-cell>@(r.ResponseRequired ? Localizer["Td_Yes"].Value : "")</pems-table-cell>
                    <pems-table-cell>
                        @if (r.AcknowledgedAt.HasValue)
                        {
                            <pems-badge tone="success">@Localizer["Td_Acknowledged"] @r.AcknowledgedAt.Value.ToString("yyyy-MM-dd")</pems-badge>
                            @if (!string.IsNullOrEmpty(r.AcknowledgedByName)) { <div class="small text-muted">@Localizer["Td_By"] @r.AcknowledgedByName</div> }
                            @if (!string.IsNullOrEmpty(r.AcknowledgementNote)) { <div class="small text-muted">@r.AcknowledgementNote</div> }
                        }
                        else if (Model.IsIssued && (bool)(ViewBag.CanRecordResponse ?? false))
                        {
                            <pems-form asp-action="Acknowledge" asp-route-id="@Model.TransmittalId" method="post"><pems-flex gap="1" align="center">
                                <input type="hidden" name="recipientId" value="@r.TransmittalRecipientId" />
                                <pems-input class="pems-minw-140" scale="small" name="note" placeholder="@Localizer["Td_NotePh"]" />
                                <pems-button tone="success" size="small" outline="true" title="@Localizer["Td_RecordAck"]"><pems-icon name="bi-check2" /></pems-button>
                            </pems-flex></pems-form>
                        }
                        else
                        {
                            <span class="text-muted small">@Localizer["Td_Pending"]</span>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (!Model.Recipients.Any())
    {
        <p class="text-muted small mb-0">@Localizer["Td_NoRecipients"]</p>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Td_IncludedDocs"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head>
            <pems-table-row><pems-table-header>@Localizer["Td_DocNo"]</pems-table-header><pems-table-header>@Localizer["Td_Title"]</pems-table-header><pems-table-header>@Localizer["Td_RevAtSend"]</pems-table-header><pems-table-header>@Localizer["Td_FileAtSend"]</pems-table-header><pems-table-header>@Localizer["Td_Remarks"]</pems-table-header></pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var item in Model.Items)
            {
                <pems-table-row>
                    <pems-table-cell>@item.DocumentNo</pems-table-cell>
                    <pems-table-cell>@item.DocumentTitle</pems-table-cell>
                    <pems-table-cell><pems-badge tone="neutral">@item.RevisionNo</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">
                        @if (!string.IsNullOrEmpty(item.SnapshotFileName))
                        {
                            <pems-icon name="bi-file-earmark-lock" css="text-muted" title="@Localizer["Td_Snapshot"]" />
                            @item.SnapshotFileName
                            @if (!string.IsNullOrEmpty(item.SnapshotFileHash))
                            {
                                <span class="text-muted" title="SHA-256: @item.SnapshotFileHash">(@item.SnapshotFileHash.Substring(0, 8)&hellip;)</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["Td_NoFile"]</span>
                        }
                    </pems-table-cell>
                    <pems-table-cell>@item.Remarks</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
</pems-content-card>

</pems-page-shell>

@{ ViewData["Title"] = Localizer["Vs_TransmittalRegistry"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
