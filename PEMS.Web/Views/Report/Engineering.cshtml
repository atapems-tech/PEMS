@model PEMS.Application.DTOs.EngineeringReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Document volume by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Created", Model.VolumeByMonth.Select(x => x.Created), BkChartSpec.Primary),
        BkSeries.Of("Issued", Model.VolumeByMonth.Select(x => x.Issued), BkChartSpec.Positive));
    var statusChart = BkChartSpec.Donut("Documents by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Documents by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Documents", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<pems-flex wrap="true" gap="2" css="mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Engineering"><pems-icon name="bi-file-earmark-text" /> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><pems-icon name="bi-journal-check" /> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><pems-icon name="bi-cart-check" /> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><pems-icon name="bi-tools" /> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><pems-icon name="bi-clipboard-data" /> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2">
        <pems-col md="3">
            <pems-select scale="small" name="projectId">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="disciplineId">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="fromDate" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-date name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-funnel" /> @Localizer["Apply"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-file-earmark-text" color="slate" label="@Localizer["Total"]">@Model.TotalDocuments</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-check-circle" color="green" label="Approved/Issued">@Model.ApprovedCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="@Localizer["Pending"]">@Model.PendingCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-x-circle" color="red" label="@Localizer["Rejected"]">@Model.RejectedCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-exclamation-triangle" color="purple" label="@Localizer["Overdue"]">@Model.OverdueCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-stopwatch" color="teal" label="Avg. Approval Time">@(Model.AvgDaysToApprove.HasValue ? Model.AvgDaysToApprove.Value.ToString("0.0") + "d" : "-")</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col lg="8">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Document Volume (last 12 months)</h6>
            <pems-chart spec="@volumeChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <pems-chart spec="@statusChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <pems-chart spec="@disciplineChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Top Projects</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var p in Model.ByProject)
                {
                    <pems-flex as="li" justify="between" css="border-bottom py-1"><span>@p.ProjectName</span><span class="text-muted small">@p.Count</span></pems-flex>
                }
            </ul>
            @if (!Model.ByProject.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
