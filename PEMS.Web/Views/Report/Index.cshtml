@model PEMS.Application.DTOs.CorrespondenceReportDto
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-pems-solid"><i class="bi bi-envelope-paper"></i> Correspondence</a>
    <a asp-action="Engineering" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-text"></i> Engineering Documents</a>
    <a asp-action="Vdr" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> VDR</a>
    <a asp-action="Procurement" class="btn btn-sm btn-outline-secondary"><i class="bi bi-cart-check"></i> Procurement</a>
    <a asp-action="Cmms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tools"></i> CMMS</a>
</div>
<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">All Disciplines</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">All Projects</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> Apply</button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-envelope"></i></div><div><div class="kpi-value">@Model.TotalLetters</div><div class="kpi-label">Total</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-envelope-arrow-down"></i></div><div><div class="kpi-value">@Model.TotalIncoming</div><div class="kpi-label">Incoming</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-envelope-arrow-up"></i></div><div><div class="kpi-value">@Model.TotalOutgoing</div><div class="kpi-label">Outgoing</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-envelope"></i></div><div><div class="kpi-value">@Model.TotalInternal</div><div class="kpi-label">Internal</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-red"><i class="bi bi-exclamation-triangle"></i></div><div><div class="kpi-value">@Model.OverdueReferrals</div><div class="kpi-label">Overdue Referrals</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-stopwatch"></i></div><div><div class="kpi-value">@(Model.AvgReferralCompletionDays.HasValue ? Model.AvgReferralCompletionDays.Value.ToString("0.0") + "d" : "-")</div><div class="kpi-label">Avg. Referral Time</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Correspondence Volume (last 12 months)</h6>
            <canvas id="volumeChart" height="90"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Status</h6>
            <canvas id="statusChart" height="200"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Discipline</h6>
            <canvas id="disciplineChart" height="180"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Tags</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var t in Model.TopTags)
                {
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <span class="badge bg-@t.Color">@t.TagName</span>
                        <span class="text-muted small">@t.Count</span>
                    </li>
                }
            </ul>
            @if (!Model.TopTags.Any()) { <p class="text-muted small">No tags used yet.</p> }
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-3">Top Senders</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Sender</th><th>Count</th></tr></thead>
        <tbody>
            @foreach (var s in Model.TopSenders)
            {
                <tr><td>@s.Sender</td><td>@s.Count</td></tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.TopSenders.Any()) { <p class="text-muted text-center py-3">No data.</p> }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const volumeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByMonth.Select(x => x.Month)));
        const incomingData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByMonth.Select(x => x.Incoming)));
        const outgoingData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByMonth.Select(x => x.Outgoing)));

        new Chart(document.getElementById('volumeChart'), {
            type: 'bar',
            data: {
                labels: volumeLabels,
                datasets: [
                    { label: 'Incoming', data: incomingData, backgroundColor: '#22c55e' },
                    { label: 'Outgoing', data: outgoingData, backgroundColor: '#3b82f6' }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });

        const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByStatus.Select(x => x.Status)));
        const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByStatus.Select(x => x.Count)));

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{ data: statusData, backgroundColor: ['#94a3b8', '#f59e0b', '#22c55e', '#ef4444', '#3b82f6', '#a855f7', '#14b8a6'] }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        const disciplineLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDiscipline.Select(x => x.Discipline)));
        const disciplineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDiscipline.Select(x => x.Count)));

        new Chart(document.getElementById('disciplineChart'), {
            type: 'bar',
            data: {
                labels: disciplineLabels,
                datasets: [{ label: 'Letters', data: disciplineData, backgroundColor: '#d98c2b' }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    </script>
}
