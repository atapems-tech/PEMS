@model PEMS.Application.DTOs.CorrespondenceReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Letters by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Incoming", Model.VolumeByMonth.Select(x => x.Incoming), BkChartSpec.Positive),
        BkSeries.Of("Outgoing", Model.VolumeByMonth.Select(x => x.Outgoing), BkChartSpec.Primary));
    var statusChart = BkChartSpec.Donut("Letters by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Letters by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Letters", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="primary" size="small" as="a" asp-action="Index"><pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><pems-icon name="bi-file-earmark-text" /> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><pems-icon name="bi-journal-check" /> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><pems-icon name="bi-cart-check" /> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><pems-icon name="bi-tools" /> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><pems-icon name="bi-clipboard-data" /> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]</pems-button>
</div>
<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <pems-col md="3">
            <pems-select scale="small" name="disciplineId">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="projectId">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="fromDate" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-date name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-funnel" /> @Localizer["Apply"]</pems-button></pems-col>
    </form>
</div>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-envelope" color="slate" label="@Localizer["Total"]">@Model.TotalLetters</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-envelope-arrow-down" color="green" label="@Localizer["Incoming"]">@Model.TotalIncoming</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-envelope-arrow-up" color="blue" label="@Localizer["Outgoing"]">@Model.TotalOutgoing</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-envelope" color="purple" label="@Localizer["Internal"]">@Model.TotalInternal</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-exclamation-triangle" color="red" label="Overdue Referrals">@Model.OverdueReferrals</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-stopwatch" color="amber" label="Avg. Referral Time">@(Model.AvgReferralCompletionDays.HasValue ? Model.AvgReferralCompletionDays.Value.ToString("0.0") + "d" : "-")</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col lg="8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Correspondence Volume (last 12 months)</h6>
            <pems-chart spec="@volumeChart" />
        </div>
    </pems-col>
    <pems-col lg="4">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <pems-chart spec="@statusChart" />
        </div>
    </pems-col>
    <pems-col lg="6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <pems-chart spec="@disciplineChart" />
        </div>
    </pems-col>
    <pems-col lg="6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Tags</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var t in Model.TopTags)
                {
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <pems-badge tone="none" css="bg-@t.Color">@t.TagName</pems-badge>
                        <span class="text-muted small">@t.Count</span>
                    </li>
                }
            </ul>
            @if (!Model.TopTags.Any()) { <p class="text-muted small">No tags used yet.</p> }
        </div>
    </pems-col>
</pems-row>

<div class="content-card">
    <h6 class="mb-3">Top Senders</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead><tr><th>Sender</th><th>@Localizer["Count"]</th></tr></thead>
        <tbody>
            @foreach (var s in Model.TopSenders)
            {
                <tr><td>@s.Sender</td><td>@s.Count</td></tr>
            }
        </tbody>
    </pems-table>
    </div>
    @if (!Model.TopSenders.Any()) { <p class="text-muted text-center py-3">@Localizer["No data."]</p> }
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
