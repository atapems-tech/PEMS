@model PEMS.Application.DTOs.CmmsReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var noData = Localizer["Chart_NoData"].Value;
    // priority colours follow urgency, whatever order the rows arrive in
    string PriorityColor(string p) => p switch { "Low" => BkChartSpec.Neutral, "Medium" => BkChartSpec.Primary, "High" => BkChartSpec.Warning, "Critical" => BkChartSpec.Negative, _ => BkChartSpec.Tertiary };
    var volumeChart = BkChartSpec.MonthlyBars("Work orders by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Work Orders", Model.VolumeByMonth.Select(x => x.Count), BkChartSpec.Primary));
    var priorityChart = BkChartSpec.Donut("Work orders by priority", noData, Localizer["Total"].Value, Model.ByPriority.Select(x => (x.Priority, (double)x.Count)),
        Model.ByPriority.Select(x => PriorityColor(x.Priority)));
    var typeChartRows = BkChartSpec.TopWithOthers(Model.ByType.Select(x => (x.Type, x.Count)), 10, Localizer["Chart_Other"].Value);
    var typeChart = BkChartSpec.HBars("Work orders by type", noData, typeChartRows.Select(x => x.Label), false,
        new BkSeries("Work Orders", typeChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><pems-icon name="bi-file-earmark-text" /> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><pems-icon name="bi-journal-check" /> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><pems-icon name="bi-cart-check" /> @Localizer["Procurement"]</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Cmms"><pems-icon name="bi-tools" /> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><pems-icon name="bi-clipboard-data" /> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]</pems-button>
</div>

<pems-content-card css="mb-3">
    <form method="get"><pems-row gap="2">
        <pems-col md="3">
            <pems-select scale="small" name="status">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" })
                { <option value="@s" selected="@(s == (string)ViewBag.SelectedStatus)">@s</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="priority">
                <option value="">All Priorities</option>
                @foreach (var p in new[] { "Low", "Medium", "High", "Critical" })
                { <option value="@p" selected="@(p == (string)ViewBag.SelectedPriority)">@p</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="fromDate" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-date name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-funnel" /> @Localizer["Apply"]</pems-button></pems-col>
    </pems-row></form>
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-clipboard-check" color="slate" label="@Localizer["Total"]">@Model.TotalWorkOrders</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-exclamation-circle" color="red" label="@Localizer["Open"]">@Model.OpenCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="@Localizer["In Progress"]">@Model.InProgressCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-check-circle" color="green" label="@Localizer["Completed"]">@Model.CompletedCount</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-stopwatch" color="purple" label="Avg. Completion">@(Model.AvgCompletionDays.HasValue ? Model.AvgCompletionDays.Value.ToString("0.0") + "d" : "-")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-currency-dollar" color="teal" label="Spare Parts Cost">@Model.TotalSpareCost.ToString("0")</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col lg="8">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Work Orders (last 12 months)</h6>
            <pems-chart spec="@volumeChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">By Priority</h6>
            <pems-chart spec="@priorityChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">By Type</h6>
            <pems-chart spec="@typeChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Top Equipment (by Work Order count)</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var e in Model.TopEquipment)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@e.Equipment</span><span class="text-muted small">@e.Count</span></li>
                }
            </ul>
            @if (!Model.TopEquipment.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
