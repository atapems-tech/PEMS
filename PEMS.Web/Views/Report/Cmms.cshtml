@model PEMS.Application.DTOs.CmmsReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var noData = Localizer["Chart_NoData"].Value;
    // priority colours follow urgency, whatever order the rows arrive in
    string PriorityColor(string p) => p switch { "Low" => BkChartSpec.Neutral, "Medium" => BkChartSpec.Primary, "High" => BkChartSpec.Warning, "Critical" => BkChartSpec.Negative, _ => BkChartSpec.Tertiary };
    var volumeChart = BkChartSpec.MonthlyBars("Work orders by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Work Orders", Model.VolumeByMonth.Select(x => x.Count), BkChartSpec.Primary));
    var priorityChart = BkChartSpec.Donut("Work orders by priority", noData, Localizer["Total"].Value, Model.ByPriority.Select(x => (x.Priority, (double)x.Count)),
        Model.ByPriority.Select(x => PriorityColor(x.Priority)));
    var typeChartRows = BkChartSpec.TopWithOthers(Model.ByType.Select(x => (x.Type, x.Count)), 10, Localizer["Chart_Other"].Value);
    var typeChart = BkChartSpec.HBars("Work orders by type", noData, typeChartRows.Select(x => x.Label), false,
        new BkSeries("Work Orders", typeChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Cmms"><i class="bi bi-tools"></i> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><i class="bi bi-journal-plus"></i> @Localizer["Pc_Menu"]</pems-button>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" })
                { <option value="@s" selected="@(s == (string)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="priority" class="form-select form-select-sm">
                <option value="">All Priorities</option>
                @foreach (var p in new[] { "Low", "Medium", "High", "Critical" })
                { <option value="@p" selected="@(p == (string)ViewBag.SelectedPriority)">@p</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><pems-button tone="primary" size="small" css="w-100"><i class="bi bi-funnel"></i> @Localizer["Apply"]</pems-button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-clipboard-check" color="slate" label="@Localizer["Total"]">@Model.TotalWorkOrders</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-exclamation-circle" color="red" label="@Localizer["Open"]">@Model.OpenCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="@Localizer["In Progress"]">@Model.InProgressCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-check-circle" color="green" label="@Localizer["Completed"]">@Model.CompletedCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-stopwatch" color="purple" label="Avg. Completion">@(Model.AvgCompletionDays.HasValue ? Model.AvgCompletionDays.Value.ToString("0.0") + "d" : "-")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-currency-dollar" color="teal" label="Spare Parts Cost">@Model.TotalSpareCost.ToString("0")</pems-kpi-tile></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Work Orders (last 12 months)</h6>
            <partial name="_BkChart" model="@volumeChart" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Priority</h6>
            <partial name="_BkChart" model="@priorityChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Type</h6>
            <partial name="_BkChart" model="@typeChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Equipment (by Work Order count)</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var e in Model.TopEquipment)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@e.Equipment</span><span class="text-muted small">@e.Count</span></li>
                }
            </ul>
            @if (!Model.TopEquipment.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </div>
    </div>
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
