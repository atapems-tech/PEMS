@model PEMS.Application.DTOs.OperationsReportSummaryDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><i class="bi bi-tools"></i> CMMS</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Operations"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><i class="bi bi-journal-plus"></i> @Localizer["Pc_Menu"]</pems-button>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-2">
            <select name="periodType" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var p in new[] { "Day", "Month", "CustomRange" })
                {
                    <option value="@p" selected="@(p == (string)ViewBag.PeriodType)">@p</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input name="anchorOrFrom" type="date" value="@(((DateTime?)ViewBag.AnchorOrFrom)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm"
                   placeholder="@(((string)ViewBag.PeriodType) == "CustomRange" ? "From date" : "Any date in period")" />
        </div>
        @if (((string)ViewBag.PeriodType) == "CustomRange")
        {
            <div class="col-md-3"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" placeholder="To date" /></div>
        }
        <div class="col-md-2">
            <select name="productionWorkCenterId" class="form-select form-select-sm">
                <option value="">All Work Centers</option>
                @foreach (var w in ViewBag.WorkCenters)
                {
                    <option value="@w.ProductionWorkCenterId" selected="@(w.ProductionWorkCenterId == (int?)ViewBag.SelectedWorkCenterId)">@w.Code</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="materialItemId" class="form-select form-select-sm">
                <option value="">All Materials</option>
                @foreach (var m in ViewBag.MaterialItems)
                {
                    <option value="@m.MaterialItemId" selected="@(m.MaterialItemId == (int?)ViewBag.SelectedMaterialItemId)">@m.MaterialCode</option>
                }
            </select>
        </div>
        <div class="col-12"><pems-button tone="primary" size="small"><i class="bi bi-funnel"></i> @Localizer["Apply"]</pems-button></div>
    </form>
</div>

<div class="text-muted small mb-2">
    Period: @Model.PeriodStart.ToString("yyyy-MM-dd") &rarr; @Model.PeriodEnd.AddDays(-1).ToString("yyyy-MM-dd")
    (server-local calendar day boundaries; not yet business-confirmed as the operational-day
    boundary - see docs/audits/PEMS_OPERATIONS_PHASE_2A_FOUNDATIONAL_HARDENING_REPORT.md)
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-box-seam" color="slate" label="@Localizer["Total Output"]">@Model.TotalOutputQuantity.ToString("N3")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-check-circle" color="green" label="Accepted">@Model.AcceptedQuantity.ToString("N3")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-x-circle" color="red" label="@Localizer["Rejected"]">@Model.RejectedQuantity.ToString("N3")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="Awaiting QC">@Model.PendingQcQuantity.ToString("N3")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-slash-circle" color="purple" label="Blocked">@Model.BlockedQuantity.ToString("N3")</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-dash-circle" color="teal" label="@Localizer["Loss"]">@Model.TotalLossQuantity.ToString("N3")</pems-kpi-tile></div>
</div>

<div class="content-card">
    <h6 class="mb-2">Target vs. Actual</h6>
    @if (Model.TotalTargetQuantity == 0)
    {
        <p class="text-muted small mb-0">No production target recorded for this period/scope - variance not shown (never shown as zero to avoid a misleading number).</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-2">
            <div class="col"><div class="text-muted small">@Localizer["Target"]</div><div class="fw-semibold">@Model.TotalTargetQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">Actual</div><div class="fw-semibold">@Model.TotalOutputQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">Variance</div><div class="fw-semibold @(Model.VarianceQuantity < 0 ? "text-danger" : "text-success")">@Model.VarianceQuantity?.ToString("N3")</div></div>
        </div>
    }
</div>
