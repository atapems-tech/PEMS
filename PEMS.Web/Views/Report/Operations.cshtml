@model PEMS.Application.DTOs.OperationsReportSummaryDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><pems-icon name="bi-file-earmark-text" /> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><pems-icon name="bi-journal-check" /> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><pems-icon name="bi-cart-check" /> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><pems-icon name="bi-tools" /> CMMS</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Operations"><pems-icon name="bi-clipboard-data" /> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]</pems-button>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <pems-col md="2">
            <pems-select scale="small" name="periodType" onchange="this.form.submit()">
                @foreach (var p in new[] { "Day", "Month", "CustomRange" })
                {
                    <option value="@p" selected="@(p == (string)ViewBag.PeriodType)">@p</option>
                }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-date name="anchorOrFrom" value="@(((DateTime?)ViewBag.AnchorOrFrom)?.ToString("yyyy-MM-dd"))" scale="small"
                   placeholder="@(((string)ViewBag.PeriodType) == "CustomRange" ? "From date" : "Any date in period")" />
        </pems-col>
        @if (((string)ViewBag.PeriodType) == "CustomRange")
        {
            <pems-col md="3"><pems-date name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" scale="small" placeholder="To date" /></pems-col>
        }
        <pems-col md="2">
            <pems-select scale="small" name="productionWorkCenterId">
                <option value="">All Work Centers</option>
                @foreach (var w in ViewBag.WorkCenters)
                {
                    <option value="@w.ProductionWorkCenterId" selected="@(w.ProductionWorkCenterId == (int?)ViewBag.SelectedWorkCenterId)">@w.Code</option>
                }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-select scale="small" name="materialItemId">
                <option value="">All Materials</option>
                @foreach (var m in ViewBag.MaterialItems)
                {
                    <option value="@m.MaterialItemId" selected="@(m.MaterialItemId == (int?)ViewBag.SelectedMaterialItemId)">@m.MaterialCode</option>
                }
            </pems-select>
        </pems-col>
        <pems-col span="12"><pems-button tone="primary" size="small"><pems-icon name="bi-funnel" /> @Localizer["Apply"]</pems-button></pems-col>
    </form>
</div>

<div class="text-muted small mb-2">
    Period: @Model.PeriodStart.ToString("yyyy-MM-dd") &rarr; @Model.PeriodEnd.AddDays(-1).ToString("yyyy-MM-dd")
    (server-local calendar day boundaries; not yet business-confirmed as the operational-day
    boundary - see docs/audits/PEMS_OPERATIONS_PHASE_2A_FOUNDATIONAL_HARDENING_REPORT.md)
</div>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-box-seam" color="slate" label="@Localizer["Total Output"]">@Model.TotalOutputQuantity.ToString("N3")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-check-circle" color="green" label="Accepted">@Model.AcceptedQuantity.ToString("N3")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-x-circle" color="red" label="@Localizer["Rejected"]">@Model.RejectedQuantity.ToString("N3")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="Awaiting QC">@Model.PendingQcQuantity.ToString("N3")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-slash-circle" color="purple" label="Blocked">@Model.BlockedQuantity.ToString("N3")</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-dash-circle" color="teal" label="@Localizer["Loss"]">@Model.TotalLossQuantity.ToString("N3")</pems-kpi-tile></pems-col>
</pems-row>

<div class="content-card">
    <h6 class="mb-2">Target vs. Actual</h6>
    @if (Model.TotalTargetQuantity == 0)
    {
        <p class="text-muted small mb-0">No production target recorded for this period/scope - variance not shown (never shown as zero to avoid a misleading number).</p>
    }
    else
    {
        <pems-row gap="2" css="row-cols-1 row-cols-md-3">
            <pems-col span=""><div class="text-muted small">@Localizer["Target"]</div><div class="fw-semibold">@Model.TotalTargetQuantity.ToString("N3")</div></pems-col>
            <pems-col span=""><div class="text-muted small">Actual</div><div class="fw-semibold">@Model.TotalOutputQuantity.ToString("N3")</div></pems-col>
            <pems-col span=""><div class="text-muted small">Variance</div><div class="fw-semibold @(Model.VarianceQuantity < 0 ? "text-danger" : "text-success")">@Model.VarianceQuantity?.ToString("N3")</div></pems-col>
        </pems-row>
    }
</div>
