@model PEMS.Application.DTOs.ProcurementReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var pipeline = (PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProcurementPipelineRowDto>)ViewBag.Pipeline;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Procurement packages by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Packages", Model.VolumeByMonth.Select(x => x.Count), BkChartSpec.Primary));
    var statusChart = BkChartSpec.Donut("Packages by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Packages by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Packages", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<pems-flex wrap="true" gap="2" css="mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-envelope-paper" /> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><pems-icon name="bi-file-earmark-text" /> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Vdr"><pems-icon name="bi-journal-check" /> @Localizer["VDR"]</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Procurement"><pems-icon name="bi-cart-check" /> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><pems-icon name="bi-tools" /> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><pems-icon name="bi-clipboard-data" /> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><pems-icon name="bi-journal-plus" /> @Localizer["Pc_Menu"]</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <form method="get"><pems-row gap="2">
        <pems-col md="3">
            <pems-select scale="small" name="projectId">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="disciplineId">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="fromDate" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-date name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" scale="small" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-funnel" /> @Localizer["Apply"]</pems-button></pems-col>
    </pems-row></form>
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-folder2-open" color="slate" label="Packages">@Model.TotalPackages</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-cart-check" color="blue" label="@Localizer["MRs"]">@Model.TotalMRs</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-file-earmark-spreadsheet" color="purple" label="@Localizer["MRQs"]">@Model.TotalMRQs</pems-kpi-tile></pems-col>
    <pems-col md="3" sm="6"><pems-kpi-tile icon="bi-hourglass-split" color="amber" label="@Localizer["Open"]">@Model.OpenCount</pems-kpi-tile></pems-col>
    <pems-col md="3" sm="6"><pems-kpi-tile icon="bi-check-circle" color="green" label="@Localizer["Closed"]">@Model.ClosedCount</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3" css="mb-3">
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-clipboard-check" color="blue" label="@Localizer["Tenders"]">@Model.TotalTenders</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-cash-coin" color="purple" label="@Localizer["Bids"]">@Model.TotalBids</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-file-earmark-ruled" color="slate" label="Contracts">@Model.TotalContracts</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-receipt" color="amber" label="@Localizer["Purchase Orders"]">@Model.TotalPurchaseOrders</pems-kpi-tile></pems-col>
    <pems-col md="2" sm="6"><pems-kpi-tile icon="bi-flag" color="green" label="@Localizer["Notice to Proceed (NTP)"]">@Model.TotalNTPsIssued</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col lg="8">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Packages (last 12 months)</h6>
            <pems-chart spec="@volumeChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <pems-chart spec="@statusChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <pems-chart spec="@disciplineChart" />
        </pems-content-card>
    </pems-col>
    <pems-col lg="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Top Vendors (by MRQ count)</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var v in Model.ByVendor)
                {
                    <pems-flex as="li" justify="between" css="border-bottom py-1"><span>@v.Vendor</span><span class="text-muted small">@v.Count</span></pems-flex>
                }
            </ul>
            @if (!Model.ByVendor.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <h6 class="mb-3">@Localizer["Tender-to-Contract Pipeline"]</h6>
    <pems-table-scroll>
        <pems-data-table data="@(DataRows.Of(pipeline.Items, c_ => c_.Add(((Localizer["Package"])?.ToString() ?? ""), row => (object?)(row.PackageNumber)).Add(((Localizer["Tender No"])?.ToString() ?? ""), row => (object?)(row.TenderNumber)).Add(((Localizer["Status"])?.ToString() ?? ""), row => (object?)(row.TenderStatus), kind: DataCellKind.Badge, tone: row => "neutral").Add(((Localizer["Vendor"])?.ToString() ?? ""), row => (object?)(row.WinnerVendorName)).Add(((Localizer["Technical"])?.ToString() ?? ""), row => (object?)(row.TechnicalEvaluationStatus)).Add(((Localizer["Commercial"])?.ToString() ?? ""), row => (object?)(row.CommercialEvaluationStatus)).Add(((Localizer["Contract No"])?.ToString() ?? ""), row => (object?)(row.ContractNo)).Add(((Localizer["Status"])?.ToString() ?? ""), row => (object?)(row.ContractStatus)).Add(((Localizer["Value"])?.ToString() ?? ""), row => (object?)(row.ContractValue?.ToString("N0"))).Add("PO", row => (object?)(row.PoNumber)).Add("NTP", row => (object?)(row.NtpStatus)).Add(((Localizer["Kick-off"])?.ToString() ?? ""), row => (object?)(row.KickoffStatus))))" dense="true" />
    </pems-table-scroll>
    @if (pipeline.Items.Count == 0)
    {
        <p class="text-muted small">@Localizer["No data."]</p>
    }
    @if (pipeline.TotalCount > pipeline.PageSize)
    {
        var totalPages = (int)Math.Ceiling(pipeline.TotalCount / (double)pipeline.PageSize);
        <pems-pager class="mt-2" scale="small" css="mb-0" current="@pipeline.Page" total="@totalPages" href="@(Url.Action("Procurement", new { projectId = ViewBag.SelectedProjectId, disciplineId = ViewBag.SelectedDisciplineId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = "__page__" })!.Replace("__page__", "{page}"))" />
    }
</pems-content-card>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
