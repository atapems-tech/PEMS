@model PEMS.Application.DTOs.ProcurementReportDto
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope-paper"></i> Correspondence</a>
    <a asp-action="Engineering" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-text"></i> Engineering Documents</a>
    <a asp-action="Vdr" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> VDR</a>
    <a asp-action="Procurement" class="btn btn-sm btn-pems-solid"><i class="bi bi-cart-check"></i> Procurement</a>
    <a asp-action="Cmms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tools"></i> CMMS</a>
    <a asp-action="Operations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard-data"></i> Operations</a>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">All Projects</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">All Disciplines</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> Apply</button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-folder2-open"></i></div><div><div class="kpi-value">@Model.TotalPackages</div><div class="kpi-label">Packages</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-cart-check"></i></div><div><div class="kpi-value">@Model.TotalMRs</div><div class="kpi-label">MRs</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-file-earmark-spreadsheet"></i></div><div><div class="kpi-value">@Model.TotalMRQs</div><div class="kpi-label">MRQs</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-hourglass-split"></i></div><div><div class="kpi-value">@Model.OpenCount</div><div class="kpi-label">Open</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-check-circle"></i></div><div><div class="kpi-value">@Model.ClosedCount</div><div class="kpi-label">Closed</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Packages (last 12 months)</h6>
            <canvas id="volumeChart" height="90"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Status</h6>
            <canvas id="statusChart" height="200"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Discipline</h6>
            <canvas id="disciplineChart" height="180"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Vendors (by MRQ count)</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var v in Model.ByVendor)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@v.Vendor</span><span class="text-muted small">@v.Count</span></li>
                }
            </ul>
            @if (!Model.ByVendor.Any()) { <p class="text-muted small">No data.</p> }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const volumeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByMonth.Select(x => x.Month)));
        const volumeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VolumeByMonth.Select(x => x.Count)));

        new Chart(document.getElementById('volumeChart'), {
            type: 'bar',
            data: { labels: volumeLabels, datasets: [{ label: 'Packages', data: volumeData, backgroundColor: '#3b82f6' }] },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByStatus.Select(x => x.Status)));
        const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByStatus.Select(x => x.Count)));

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: { labels: statusLabels, datasets: [{ data: statusData, backgroundColor: ['#94a3b8','#f59e0b','#22c55e','#ef4444'] }] },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        const discLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDiscipline.Select(x => x.Discipline)));
        const discData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ByDiscipline.Select(x => x.Count)));

        new Chart(document.getElementById('disciplineChart'), {
            type: 'bar',
            data: { labels: discLabels, datasets: [{ label: 'Packages', data: discData, backgroundColor: '#d98c2b' }] },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    </script>
}
