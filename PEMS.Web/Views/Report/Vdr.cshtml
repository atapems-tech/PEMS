@model PEMS.Application.DTOs.VDRReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Vendor submissions by month", noData, Model.SubmissionsByMonth.Select(x => x.Month),
        BkSeries.Of("Submissions", Model.SubmissionsByMonth.Select(x => x.Count), BkChartSpec.Primary));
    var statusChart = BkChartSpec.Donut("Vendor documents by workflow status", noData, Localizer["Total"].Value, Model.ByWorkflowStatus.Select(x => (x.Status, (double)x.Count)));
    var categoryChartRows = BkChartSpec.TopWithOthers(Model.ByReviewCategory.Select(x => (x.Category, x.Count)), 10, Localizer["Chart_Other"].Value);
    var categoryChart = BkChartSpec.HBars("Submissions by review category", noData, categoryChartRows.Select(x => x.Label), false,
        new BkSeries("Submissions", categoryChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Engineering"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</pems-button>
    <pems-button tone="primary" size="small" as="a" asp-action="Vdr"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Procurement"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Cmms"><i class="bi bi-tools"></i> CMMS</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Operations"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Warehouse" asp-controller="PartCatalogueReport" asp-action="Index"><i class="bi bi-journal-plus"></i> @Localizer["Pc_Menu"]</pems-button>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><pems-button tone="primary" size="small" css="w-100"><i class="bi bi-funnel"></i> @Localizer["Apply"]</pems-button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-journal-check" color="slate" label="Total Items">@Model.TotalItems</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-check-circle" color="green" label="@Localizer["Closed"]">@Model.ClosedCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-eye" color="blue" label="@Localizer["Under Review"]">@Model.UnderReviewCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-arrow-repeat" color="amber" label="Pending Resubmission">@Model.PendingResubmissionCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-exclamation-triangle" color="red" label="@Localizer["Overdue"]">@Model.OverdueCount</pems-kpi-tile></div>
    <div class="col-md-2 col-sm-6"><pems-kpi-tile icon="bi-send" color="purple" label="Total Submissions">@Model.TotalSubmissions</pems-kpi-tile></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Submissions (last 12 months)</h6>
            <partial name="_BkChart" model="@volumeChart" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Workflow Status</h6>
            <partial name="_BkChart" model="@statusChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Vendors</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var v in Model.ByVendor)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@v.Vendor</span><span class="text-muted small">@v.Count</span></li>
                }
            </ul>
            @if (!Model.ByVendor.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">By Review Category</h6>
            <partial name="_BkChart" model="@categoryChart" />
        </div>
    </div>
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
