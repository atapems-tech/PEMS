@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.StoreRequisitionListDto>
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
    var statuses = new[] { "Draft", "Submitted", "Approved", "Reserved", "Issued", "Closed", "Rejected", "Cancelled" };
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" style="max-width:180px;" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (var s in statuses) { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </form>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createRequisitionModal">
            <i class="bi bi-plus-lg"></i> New Store Requisition
        </button>
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('StoreRequisition')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="StoreRequisition">
        <thead>
            <tr>
                <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200">No.</th>
                <th data-col-key="warehouse" data-resizable="true" data-min-width="90" data-max-width="160">Warehouse</th>
                <th data-col-key="requestedBy" data-resizable="true" data-min-width="120" data-max-width="240">Requested By</th>
                <th data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">Date</th>
                <th data-col-key="purpose" data-resizable="true" data-min-width="140" data-max-width="360">Purpose</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                var badgeClass = r.Status switch
                {
                    "Closed" or "Issued" => "bg-success",
                    "Rejected" or "Cancelled" => "bg-secondary",
                    "Draft" => "bg-light text-dark border",
                    _ => "bg-warning text-dark"
                };
                <tr>
                    <td class="small fw-bold"><a asp-action="Details" asp-route-id="@r.StoreRequisitionId">@r.RequisitionNumber</a></td>
                    <td class="small">@r.WarehouseCode</td>
                    <td class="small">@r.RequestedByName</td>
                    <td class="small">@r.RequestedDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@(r.Purpose ?? "-")</td>
                    <td><span class="badge @badgeClass">@r.Status</span></td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@r.StoreRequisitionId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-card-text"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">No store requisitions found.</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "StoreRequisition",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

<div class="modal fade" id="createRequisitionModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">Store Requisition جدید</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">انبار</label>
                    <select name="warehouseId" class="form-select form-select-sm" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </select>
                </div>
                <div class="mb-2"><label class="form-label small">هدف / دلیل (اختیاری)</label><textarea name="purpose" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('StoreRequisition');
        });
    </script>
}
