@model List<PEMS.Application.DTOs.ShiftHandoverListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Draft", "Prepared", "Acknowledged", "Completed" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;

    string StatusText(string? s) => VdrUi.Loc(Localizer, "Sh_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Completed" => "vs-pill--success",
        "Acknowledged" => "vs-pill--info",
        "Prepared" => "vs-pill--warning",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2b: built from the PEMS.UI list-page component; the status button row became the status filter, the
   process note is the heading tooltip. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Sh_Title"]" heading-title="@Localizer["Sh_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-filters form-id="shFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="shFilterStatus" name="status" label="@Localizer["Ed_Status"]" value="@status"
                                             all-text="@Localizer["Eq_AllStatuses"]" items="@statuses.Select(s => new SelectListItem(StatusText(s), s))" />
                </pems-list-filters>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Sh_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table empty="@(!Model.Any())" empty-text="@Localizer["Sh_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-90">#</pems-table-header>
                        <pems-table-header>@Localizer["Sh_Outgoing"]</pems-table-header>
                        <pems-table-header>@Localizer["Sh_Incoming"]</pems-table-header>
                        <pems-table-header class="vs-hide-md">@Localizer["Sh_Shift"]</pems-table-header>
                        <pems-table-header class="pems-w-150">@Localizer["Sh_Date"]</pems-table-header>
                        <pems-table-header class="pems-w-130">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-90">@Localizer["Sh_Items"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var h in Model)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@h.ShiftHandoverId" class="lp-subject"><span class="vs-num">#@h.ShiftHandoverId</span></a></pems-table-cell>
                            <pems-table-cell class="small">@(h.OutgoingName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(h.IncomingName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@(h.ShiftLabel ?? "-")</pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@h.HandoverDate.ToString("yyyy-MM-dd HH:mm")</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(h.Status)">@StatusText(h.Status)</span></pems-table-cell>
                            <pems-table-cell><span class="vs-num">@h.ItemCount</span></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
