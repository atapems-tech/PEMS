@model List<PEMS.Application.DTOs.ShiftHandoverListDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-arrow-left-right"></i> Shift Handovers</h5>
    <a asp-action="Create" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New Handover</a>
</div>
<p class="text-muted small">
    طبق CMMS-10e: Draft → Prepared → Acknowledged → Completed. یک رویداد تحویل شیفت بین یک
    کارمند خروجی و یک کارمند ورودی مشخص، به‌همراه Snapshot اطلاعات عملیاتی لحظه‌ی Prepare.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="btn-group btn-group-sm flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == null ? "active" : "")">All</a>
        @foreach (var s in new[] { "Draft", "Prepared", "Acknowledged", "Completed" })
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == s ? "active" : "")">@s</a>
        }
    </div>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead><tr><th>#</th><th>Outgoing</th><th>Incoming</th><th>Shift</th><th>Handover Date</th><th>Status</th><th>Items</th></tr></thead>
        <tbody>
            @foreach (var h in Model)
            {
                var badgeClass = h.Status switch
                {
                    "Completed" => "bg-success",
                    "Acknowledged" => "bg-info text-dark",
                    "Prepared" => "bg-warning text-dark",
                    _ => "bg-secondary"
                };
                <tr>
                    <td class="small fw-bold"><a asp-action="Details" asp-route-id="@h.ShiftHandoverId">#@h.ShiftHandoverId</a></td>
                    <td class="small">@(h.OutgoingName ?? "-")</td>
                    <td class="small">@(h.IncomingName ?? "-")</td>
                    <td class="small">@(h.ShiftLabel ?? "-")</td>
                    <td class="small">@h.HandoverDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="badge @badgeClass">@h.Status</span></td>
                    <td class="small">@h.ItemCount</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز تحویل شیفتی ثبت نشده.</p> }
</div>
