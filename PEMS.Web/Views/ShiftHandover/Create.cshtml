@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "New Shift Handover";
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
}


@await Html.PartialAsync("_PageHeader")

@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<div class="content-card">
    <form asp-action="Create" method="post" class="row g-3">
        <pems-col md="4">
            <pems-label css="small">Outgoing Employee</pems-label>
            <pems-select name="outgoingEmployeeId" required>
                <option value="">@Localizer["-- select --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Label</option> }
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label css="small">Incoming Employee</pems-label>
            <pems-select name="incomingEmployeeId" required>
                <option value="">@Localizer["-- select --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Label</option> }
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label css="small">@Localizer["Handover Date"]</pems-label>
            <pems-input type="datetime-local" name="handoverDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
        </pems-col>
        <pems-col md="6">
            <pems-label css="small">Shift Label</pems-label>
            <pems-input type="text" name="shiftLabel" placeholder="e.g. Day Shift 06:00-18:00" />
        </pems-col>
        <pems-col span="12">
            <pems-label css="small">Notes (one outstanding action per line)</pems-label>
            <pems-textarea name="notes" rows="4"></pems-textarea>
        </pems-col>
        <pems-col span="12">
            <pems-button tone="primary" type="submit">@Localizer["Create"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </pems-col>
    </form>
</div>
