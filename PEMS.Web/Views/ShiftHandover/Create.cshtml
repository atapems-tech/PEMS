@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "New Shift Handover";
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
}


@await Html.PartialAsync("_PageHeader")

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <form asp-action="Create" method="post" class="row g-3">
        <div class="col-md-4">
            <label class="form-label small">Outgoing Employee</label>
            <select name="outgoingEmployeeId" class="form-select" required>
                <option value="">@Localizer["-- select --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Label</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">Incoming Employee</label>
            <select name="incomingEmployeeId" class="form-select" required>
                <option value="">@Localizer["-- select --"]</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Label</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small">@Localizer["Handover Date"]</label>
            <input type="datetime-local" name="handoverDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
        </div>
        <div class="col-md-6">
            <label class="form-label small">Shift Label</label>
            <input type="text" name="shiftLabel" class="form-control" placeholder="e.g. Day Shift 06:00-18:00" />
        </div>
        <div class="col-12">
            <label class="form-label small">Notes (one outstanding action per line)</label>
            <textarea name="notes" class="form-control" rows="4"></textarea>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Create"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
