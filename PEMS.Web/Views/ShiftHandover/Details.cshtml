@model PEMS.Application.DTOs.ShiftHandoverDetailDto
@{
    ViewData["Title"] = "Shift Handover Details";
    var badgeClass = Model.Status switch
    {
        "Completed" => "bg-success",
        "Acknowledged" => "bg-info text-dark",
        "Prepared" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    bool isOutgoing = ViewBag.IsOutgoing;
    bool isIncoming = ViewBag.IsIncoming;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
        <div class="kpi-icon bg-icon-blue" style="width:56px;height:56px;font-size:26px;"><i class="bi bi-arrow-left-right"></i></div>
        <div>
            <h5 class="mb-0">Handover #@Model.ShiftHandoverId <span class="badge @badgeClass">@Model.Status</span></h5>
            <span class="text-muted small">@Model.OutgoingName → @Model.IncomingName @(Model.ShiftLabel != null ? $"- {Model.ShiftLabel}" : "") - @Model.HandoverDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p class="small mb-2"><strong>Notes:</strong> @Model.Notes</p>
    }

    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status == "Draft" && isOutgoing)
        {
            <form asp-action="Prepare" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <button type="submit" class="btn btn-sm btn-outline-warning">Prepare (snapshot current operational status)</button>
            </form>
        }
        @if (Model.Status == "Prepared" && isIncoming)
        {
            <form asp-action="Acknowledge" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <button type="submit" class="btn btn-sm btn-outline-info">Acknowledge</button>
            </form>
        }
        @if (Model.Status == "Acknowledged" && isOutgoing)
        {
            <form asp-action="Complete" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <button type="submit" class="btn btn-sm btn-outline-success">Complete</button>
            </form>
        }
        @if (Model.Status == "Prepared" && !isIncoming)
        {
            <span class="small text-muted">در انتظار تایید کارمند ورودی (@Model.IncomingName)</span>
        }
        @if (Model.Status == "Acknowledged" && !isOutgoing)
        {
            <span class="small text-muted">در انتظار نهایی‌سازی توسط کارمند خروجی (@Model.OutgoingName)</span>
        }
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Snapshot Items</h6>
    @if (Model.Items.Any())
    {
        foreach (var group in Model.Items.GroupBy(x => x.ItemType))
        {
            <p class="small fw-bold mb-1">@group.Key (@group.Count())</p>
            <ul class="small mb-3">
                @foreach (var item in group)
                {
                    <li>@item.Description</li>
                }
            </ul>
        }
    }
    else
    {
        <p class="text-muted small mb-0">هنوز آماده‌سازی (Prepare) انجام نشده - Snapshot موجود نیست.</p>
    }
</div>

<div class="content-card">
    <h6 class="mb-3">Status History</h6>
    <table class="table table-enterprise table-sm mb-0">
        <thead><tr><th>From</th><th>To</th><th>By</th><th>Date</th><th>Reason</th></tr></thead>
        <tbody>
            @foreach (var h in Model.StatusHistory)
            {
                <tr>
                    <td class="small">@h.FromStatus</td>
                    <td class="small">@h.ToStatus</td>
                    <td class="small">@(h.ChangedByName ?? "-")</td>
                    <td class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small text-muted">@h.Reason</td>
                </tr>
            }
        </tbody>
    </table>
</div>
