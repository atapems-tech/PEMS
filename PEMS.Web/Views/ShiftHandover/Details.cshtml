@model PEMS.Application.DTOs.ShiftHandoverDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Shift Handover Details";
    var badgeClass = Model.Status switch
    {
        "Completed" => "success",
        "Acknowledged" => "info",
        "Prepared" => "warning",
        _ => "neutral"
    };
    bool isOutgoing = ViewBag.IsOutgoing;
    bool isIncoming = ViewBag.IsIncoming;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="3" wrap="true" css="mb-2">
        <div class="kpi-icon bg-icon-blue pems-s-792bd2d6"><pems-icon name="bi-arrow-left-right" /></div>
        <div>
            <pems-heading level="5" class="mb-0">Handover #@Model.ShiftHandoverId <pems-badge tone="@badgeClass">@Model.Status</pems-badge></pems-heading>
            <span class="text-muted small">@Model.OutgoingName → @Model.IncomingName @(Model.ShiftLabel != null ? $"- {Model.ShiftLabel}" : "") - @PemsDates.DateTime(Model.HandoverDate)</span>
        </div>
    </pems-flex>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <pems-text class="small mb-2"><strong>Notes:</strong> @Model.Notes</pems-text>
    }

    <pems-flex gap="2" wrap="true">
        @if (Model.Status == "Draft" && isOutgoing)
        {
            <pems-form asp-action="Prepare" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <pems-button tone="warning" size="small" outline="true" type="submit">Prepare (snapshot current operational status)</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Prepared" && isIncoming)
        {
            <pems-form asp-action="Acknowledge" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <pems-button tone="info" size="small" outline="true" type="submit">Acknowledge</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Acknowledged" && isOutgoing)
        {
            <pems-form asp-action="Complete" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.ShiftHandoverId" />
                <pems-button tone="success" size="small" outline="true" type="submit">Complete</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Prepared" && !isIncoming)
        {
            <span class="small text-muted">در انتظار تایید کارمند ورودی (@Model.IncomingName)</span>
        }
        @if (Model.Status == "Acknowledged" && !isOutgoing)
        {
            <span class="small text-muted">در انتظار نهایی‌سازی توسط کارمند خروجی (@Model.OutgoingName)</span>
        }
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-3">Snapshot Items</pems-heading>
    @if (Model.Items.Any())
    {
        foreach (var group in Model.Items.GroupBy(x => x.ItemType))
        {
            <pems-text class="small fw-bold mb-1">@group.Key (@group.Count())</pems-text>
            <pems-bullet-list class="small mb-3">
                @foreach (var item in group)
                {
                    <pems-bullet>@item.Description</pems-bullet>
                }
            </pems-bullet-list>
        }
    }
    else
    {
        <pems-text class="text-muted small mb-0">هنوز آماده‌سازی (Prepare) انجام نشده - Snapshot موجود نیست.</pems-text>
    }
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Status History"]</pems-heading>
    <pems-data-table data="@(DataRows.Of(Model.StatusHistory, c_ => c_.Add(((Localizer["From"])?.ToString() ?? ""), h => (object?)(h.FromStatus), css: "small").Add("To", h => (object?)(h.ToStatus), css: "small").Add("By", h => (object?)(h.ChangedByName ?? "-"), css: "small").Add(((Localizer["Date"])?.ToString() ?? ""), h => (object?)(PemsDates.DateTime(h.ChangedDate)), css: "small").Add(((Localizer["Reason"])?.ToString() ?? ""), h => (object?)(h.Reason), css: "small text-muted")))" dense="true" css="mb-0" />
</pems-content-card>
