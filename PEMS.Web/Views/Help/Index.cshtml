@using System.Globalization
@{
    ViewData["HidePageTitle"] = true;
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;

    var categories = (IReadOnlyList<PEMS.Application.DTOs.HelpCategoryDto>)(ViewBag.Categories ?? new List<PEMS.Application.DTOs.HelpCategoryDto>());
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var articles = ViewBag.Articles as IReadOnlyList<PEMS.Application.DTOs.HelpArticleSummaryDto>;
}

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="2" css="mb-1">
        <pems-icon name="bi-life-preserver" css="fs-4 text-warning" />
        <h4 class="mb-0">@L("Help Center", "مرکز راهنما")</h4>
    </pems-flex>
    <p class="text-muted mb-3">@L("Browse Help by module, or search across all articles in English and Persian.", "راهنما را بر اساس ماژول مرور کنید، یا در همه‌ی مقالات به انگلیسی و فارسی جستجو کنید.")</p>
    <pems-form class="pems-s-04391f08" asp-action="Search" method="get"><pems-flex gap="2">
        <pems-input type="search" name="q" placeholder="@L("Search Help... (e.g. \"work order\", \"IDC\", \"مجوز کار\")", "جستجو در راهنما... (مثلاً «دستور کار»، «IDC»، work order)")" />
        <pems-button tone="primary" type="submit"><pems-icon name="bi-search" /> @L("Search", "جستجو")</pems-button>
    </pems-flex></pems-form>
</pems-content-card>

<pems-row gap="3">
    <pems-col md="3">
        <pems-content-card>
            <h6 class="mb-3">@L("Categories", "دسته‌ها")</h6>
            <pems-list-group flush="true">
                <pems-list-group-item action="true" active="@(selectedCategoryId == null)" asp-action="Index">
                    <pems-icon name="bi-grid" /> @L("All", "همه")
                </pems-list-group-item>
                @foreach (var c in categories)
                {
                    <pems-list-group-item action="true" css="d-flex justify-content-between align-items-center" active="@(selectedCategoryId == c.HelpCategoryId)" asp-action="Category" asp-route-id="@c.HelpCategoryId">
                        <span><pems-icon css="@(c.IconCssClass ?? "bi-folder")" /> @c.Name</span>
                        <pems-badge tone="neutral" css="rounded-pill">@c.ArticleCount</pems-badge>
                    </pems-list-group-item>
                }
            </pems-list-group>
        </pems-content-card>
    </pems-col>

    <pems-col md="9">
        @if (selectedCategoryId == null)
        {
            <pems-row gap="3">
                @foreach (var c in categories)
                {
                    <pems-col md="4">
                        <a asp-action="Category" asp-route-id="@c.HelpCategoryId" class="text-decoration-none">
                            <pems-content-card css="h-100">
                                <pems-icon css="@(c.IconCssClass ?? "bi-folder") fs-3 text-warning" />
                                <h6 class="mt-2 mb-1 text-body">@c.Name</h6>
                                <p class="text-muted small mb-0">@c.ArticleCount @L("articles", "مقاله")</p>
                            </pems-content-card>
                        </a>
                    </pems-col>
                }
            </pems-row>
        }
        else if (articles != null)
        {
            <pems-content-card>
                <h6 class="mb-3">@categories.FirstOrDefault(c => c.HelpCategoryId == selectedCategoryId)?.Name</h6>
                @if (!articles.Any())
                {
                    <p class="text-muted text-center py-4">@L("No articles in this category yet.", "هنوز مقاله‌ای در این دسته وجود ندارد.")</p>
                }
                else
                {
                    <pems-list-group flush="true">
                        @foreach (var a in articles.OrderBy(a => a.DisplayOrder))
                        {
                            <pems-list-group-item action="true" asp-action="Article" asp-route-code="@a.Code">
                                <pems-flex justify="between" align="start">
                                    <div>
                                        <span class="fw-semibold">@a.Title</span>
                                        <pems-badge tone="light" css="ms-1">@a.ArticleType</pems-badge>
                                    </div>
                                </pems-flex>
                                <p class="text-muted small mb-0 mt-1">@a.Summary</p>
                            </pems-list-group-item>
                        }
                    </pems-list-group>
                }
            </pems-content-card>
        }
    </pems-col>
</pems-row>
