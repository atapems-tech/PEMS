@using System.Globalization
@{
    ViewData["HidePageTitle"] = true;
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;

    var categories = (IReadOnlyList<PEMS.Application.DTOs.HelpCategoryDto>)(ViewBag.Categories ?? new List<PEMS.Application.DTOs.HelpCategoryDto>());
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var articles = ViewBag.Articles as IReadOnlyList<PEMS.Application.DTOs.HelpArticleSummaryDto>;
}

<div class="content-card mb-3">
    <div class="d-flex align-items-center gap-2 mb-1">
        <i class="bi bi-life-preserver fs-4 text-warning"></i>
        <h4 class="mb-0">@L("Help Center", "مرکز راهنما")</h4>
    </div>
    <p class="text-muted mb-3">@L("Browse Help by module, or search across all articles in English and Persian.", "راهنما را بر اساس ماژول مرور کنید، یا در همه‌ی مقالات به انگلیسی و فارسی جستجو کنید.")</p>
    <form asp-action="Search" method="get" class="d-flex gap-2" style="max-width:520px;">
        <input type="search" name="q" class="form-control" placeholder="@L("Search Help... (e.g. \"work order\", \"IDC\", \"مجوز کار\")", "جستجو در راهنما... (مثلاً «دستور کار»، «IDC»، work order)")" />
        <button type="submit" class="btn btn-pems-solid"><i class="bi bi-search"></i> @L("Search", "جستجو")</button>
    </form>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="content-card">
            <h6 class="mb-3">@L("Categories", "دسته‌ها")</h6>
            <div class="list-group list-group-flush">
                <a asp-action="Index" class="list-group-item list-group-item-action @(selectedCategoryId == null ? "active" : "")">
                    <i class="bi bi-grid"></i> @L("All", "همه")
                </a>
                @foreach (var c in categories)
                {
                    <a asp-action="Category" asp-route-id="@c.HelpCategoryId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedCategoryId == c.HelpCategoryId ? "active" : "")">
                        <span><i class="bi @(c.IconCssClass ?? "bi-folder")"></i> @c.Name</span>
                        <pems-badge tone="neutral" css="rounded-pill">@c.ArticleCount</pems-badge>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-9">
        @if (selectedCategoryId == null)
        {
            <div class="row g-3">
                @foreach (var c in categories)
                {
                    <div class="col-md-4">
                        <a asp-action="Category" asp-route-id="@c.HelpCategoryId" class="text-decoration-none">
                            <div class="content-card h-100">
                                <i class="bi @(c.IconCssClass ?? "bi-folder") fs-3 text-warning"></i>
                                <h6 class="mt-2 mb-1 text-body">@c.Name</h6>
                                <p class="text-muted small mb-0">@c.ArticleCount @L("articles", "مقاله")</p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else if (articles != null)
        {
            <div class="content-card">
                <h6 class="mb-3">@categories.FirstOrDefault(c => c.HelpCategoryId == selectedCategoryId)?.Name</h6>
                @if (!articles.Any())
                {
                    <p class="text-muted text-center py-4">@L("No articles in this category yet.", "هنوز مقاله‌ای در این دسته وجود ندارد.")</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in articles.OrderBy(a => a.DisplayOrder))
                        {
                            <a asp-action="Article" asp-route-code="@a.Code" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="fw-semibold">@a.Title</span>
                                        <pems-badge tone="light" css="ms-1">@a.ArticleType</pems-badge>
                                    </div>
                                </div>
                                <p class="text-muted small mb-0 mt-1">@a.Summary</p>
                            </a>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
