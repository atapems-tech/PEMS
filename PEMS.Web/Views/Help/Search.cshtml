@using System.Globalization
@{
    ViewData["HidePageTitle"] = true;
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;

    var query = (string)(ViewBag.Query ?? "");
    var results = (IReadOnlyList<PEMS.Application.DTOs.HelpArticleSummaryDto>)ViewBag.Results;
}

<div class="content-card mb-3">
    <form asp-action="Search" method="get" class="d-flex gap-2" style="max-width:520px;">
        <input type="search" name="q" value="@query" class="form-control" placeholder="@L("Search Help...", "جستجو در راهنما...")" />
        <button type="submit" class="btn btn-pems-solid"><i class="bi bi-search"></i> @L("Search", "جستجو")</button>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">
        @L("Search results for", "نتایج جستجو برای") "@query" (@results.Count)
    </h6>

    @if (!results.Any())
    {
        <p class="text-muted text-center py-4">
            @L("No Help articles matched your search.", "هیچ مقاله‌ی راهنمایی با جستجوی شما مطابقت نداشت.")
        </p>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var a in results)
            {
                <a asp-action="Article" asp-route-code="@a.Code" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-semibold">@a.Title</span>
                        <span class="badge bg-light text-dark border">@a.CategoryName</span>
                    </div>
                    <p class="text-muted small mb-0 mt-1">@a.Summary</p>
                </a>
            }
        </div>
    }
</div>
