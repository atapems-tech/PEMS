@using System.Globalization
@{
    ViewData["HidePageTitle"] = true;
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;

    var query = (string)(ViewBag.Query ?? "");
    var results = (IReadOnlyList<PEMS.Application.DTOs.HelpArticleSummaryDto>)ViewBag.Results;
}

<pems-content-card css="mb-3">
    <form class="pems-s-04391f08" asp-action="Search" method="get"><pems-flex gap="2">
        <pems-input type="search" name="q" value="@query" placeholder="@L("Search Help...", "جستجو در راهنما...")" />
        <pems-button tone="primary" type="submit"><pems-icon name="bi-search" /> @L("Search", "جستجو")</pems-button>
    </pems-flex></form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">
        @L("Search results for", "نتایج جستجو برای") "@query" (@results.Count)
    </h6>

    @if (!results.Any())
    {
        <p class="text-muted text-center py-4">
            @L("No Help articles matched your search.", "هیچ مقاله‌ی راهنمایی با جستجوی شما مطابقت نداشت.")
        </p>
    }
    else
    {
        <pems-list-group flush="true">
            @foreach (var a in results)
            {
                <pems-list-group-item action="true" asp-action="Article" asp-route-code="@a.Code">
                    <pems-flex justify="between" align="start">
                        <span class="fw-semibold">@a.Title</span>
                        <pems-badge tone="light">@a.CategoryName</pems-badge>
                    </pems-flex>
                    <p class="text-muted small mb-0 mt-1">@a.Summary</p>
                </pems-list-group-item>
            }
        </pems-list-group>
    }
</pems-content-card>
