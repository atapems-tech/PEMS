@model PEMS.Application.DTOs.HelpArticleDetailDto
@using System.Globalization
@{
    ViewData["HidePageTitle"] = true;
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;
    var visuals = (IReadOnlyList<PEMS.Application.DTOs.HelpVisualRenderDto>)(ViewBag.Visuals ?? new List<PEMS.Application.DTOs.HelpVisualRenderDto>());
    var standardReference = ViewBag.StandardReference as PEMS.Application.DTOs.HelpStandardReferenceMatrixRowDto;
}

<nav aria-label="breadcrumb" class="mb-2">
    <pems-crumb-trail css="mb-0 small">
        <li class="breadcrumb-item"><a asp-action="Index">@L("Help Center", "مرکز راهنما")</a></li>
        <li class="breadcrumb-item"><a asp-action="Category" asp-route-id="@Model.HelpCategoryId">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </pems-crumb-trail>
</nav>

<pems-row gap="3">
    <pems-col lg="9">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <h4 class="mb-0">@Model.Title</h4>
                <pems-badge tone="light">@Model.ArticleType</pems-badge>
            </div>
            <p class="text-muted">@Model.Summary</p>

            @if (standardReference != null)
            {
                @await Html.PartialAsync("_HelpStandardBadges", standardReference)
            }

            @* طبق «PEMS Help System — Phase 3» بخش ۱۰: ترتیب توصیه‌شده - عنوان/خلاصه، سپس
               نمودار (اگر باشد)، سپس متن نوشتاری. هر مقاله‌ای بدون نمودار عیناً مثل قبل
               رندر می‌شود - این بخش هیچ‌وقت خالی/شکسته نمایش داده نمی‌شود. *@
            @if (visuals.Any())
            {
                <hr />
                @foreach (var visual in visuals)
                {
                    @await Html.PartialAsync("_HelpVisual", visual)
                }
            }

            <hr />
            <div class="pems-help-article-body">
                @Html.Raw(Model.Content)
            </div>
            <p class="text-muted small mt-3 mb-0">
                <pems-icon name="bi-clock-history" /> @L("Last updated", "آخرین به‌روزرسانی"): @Model.ModifiedDate.ToString("yyyy-MM-dd")
            </p>
        </div>

        @if (Model.RelatedArticles.Any())
        {
            <div class="content-card mt-3">
                <h6 class="mb-3">@L("Related Help", "راهنمای مرتبط")</h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var r in Model.RelatedArticles)
                    {
                        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Article" asp-route-code="@r.Code">@r.Title</pems-button>
                    }
                </div>
            </div>
        }
    </pems-col>

    <pems-col lg="3">
        <div class="content-card">
            <h6 class="mb-3"><pems-icon name="bi-robot" /> @L("Ask PEMS AI", "پرسش از هوش مصنوعی PEMS")</h6>
            <p class="text-muted small">@L("Ask a question about this article - the answer is based only on its content.", "درباره‌ی همین مقاله سوال بپرسید - پاسخ فقط بر اساس محتوای همین مقاله است.")</p>
            <pems-textarea scale="small" css="mb-2" id="helpAiQuestion" rows="3" placeholder="@L("e.g. What happens if I don't respond to IDC?", "مثلاً اگر به IDC پاسخ ندهم چه می‌شود؟")"></pems-textarea>
            <pems-button tone="primary" size="small" css="w-100" type="button" id="helpAiAskBtn" data-code="@Model.Code" data-url="@Url.Action("AskAi", "Help")" data-thinking="@L("Thinking...", "در حال فکر کردن...")" data-error="@L("Could not reach the AI assistant.", "ارتباط با دستیار هوش مصنوعی برقرار نشد.")">
                <pems-icon name="bi-send" /> @L("Ask", "پرسیدن")
            </pems-button>
            <div id="helpAiAnswer" class="small mt-2" hidden></div>
        </div>
    </pems-col>
</pems-row>

@* توکن ضد جعل برای درخواست fetch به AskAi - فرم واقعی وجود ندارد، فقط برای گرفتن توکن *@
<form id="helpAiTokenForm" style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <pems-script-templates set="help-article"></pems-script-templates>
    <script src="~/js/views/help-article.js" asp-append-version="true"></script>
}
