@model List<PEMS.Application.DTOs.UserDashboardWidgetDto>

<div class="content-card">
    <p class="text-muted">
        Choose which widgets appear on your dashboard, their order, and their size. Uncheck a widget
        to hide it, or drag the order number to change its position.
    </p>

    <form asp-action="Save" method="post">
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>Show</th><th>Widget</th><th>Order</th><th>Size</th></tr></thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="widgets[@i].WidgetKey" value="@Model[i].WidgetKey" />
                            <input type="hidden" name="widgets[@i].IsVisible" value="false" />
                            <input type="checkbox" name="widgets[@i].IsVisible" value="true" checked="@Model[i].IsVisible" />
                        </td>
                        <td>@Model[i].DisplayName</td>
                        <td><input type="number" name="widgets[@i].DisplayOrder" value="@Model[i].DisplayOrder" class="form-control form-control-sm" style="width:80px;" /></td>
                        <td>
                            <select name="widgets[@i].Size" class="form-select form-select-sm" style="width:120px;">
                                @foreach (var s in new[] { "Small", "Medium", "Large" })
                                { <option value="@s" selected="@(s == Model[i].Size)">@s</option> }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check-lg"></i> Save Layout</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>
    </form>

    <form asp-action="Reset" method="post" class="mt-2">
        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reset to default dashboard layout?')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset to Default
        </button>
    </form>
</div>
