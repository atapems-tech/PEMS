@model List<PEMS.Application.DTOs.UserDashboardWidgetDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card>
    <p class="text-muted">
        Choose which widgets appear on your dashboard, their order, and their size. Uncheck a widget
        to hide it, or drag the order number to change its position.
    </p>

    <form asp-action="Save" method="post">
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-head><pems-table-row><pems-table-header>Show</pems-table-header><pems-table-header>Widget</pems-table-header><pems-table-header>@Localizer["Order"]</pems-table-header><pems-table-header>@Localizer["Size"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <pems-table-row>
                        <pems-table-cell>
                            <input type="hidden" name="widgets[@i].WidgetKey" value="@Model[i].WidgetKey" />
                            <input type="hidden" name="widgets[@i].IsVisible" value="false" />
                            <input type="checkbox" name="widgets[@i].IsVisible" value="true" checked="@Model[i].IsVisible" />
                        </pems-table-cell>
                        <pems-table-cell>@Model[i].DisplayName</pems-table-cell>
                        <pems-table-cell><pems-input class="pems-w-80" scale="small" type="number" name="widgets[@i].DisplayOrder" value="@Model[i].DisplayOrder" /></pems-table-cell>
                        <pems-table-cell>
                            <pems-select class="pems-w-120" scale="small" name="widgets[@i].Size">
                                @foreach (var s in new[] { "Small", "Medium", "Large" })
                                { <option value="@s" selected="@(s == Model[i].Size)">@s</option> }
                            </pems-select>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
        </pems-table-scroll>

        <pems-flex gap="2" css="mt-3">
            <pems-button tone="primary" type="submit"><pems-icon name="bi-check-lg" /> Save Layout</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-controller="Home" asp-action="Index">@Localizer["Back to Dashboard"]</pems-button>
        </pems-flex>
    </form>

    <form asp-action="Reset" method="post" class="mt-2">
        <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="Reset to default dashboard layout?">
            <pems-icon name="bi-arrow-counterclockwise" /> Reset to Default
        </pems-button>
    </form>
</pems-content-card>
