@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Application.DTOs
@using PEMS.Domain.Entities
@{
    var equipmentClass = (EquipmentClass)ViewBag.EquipmentClass;
    var readiness = ViewBag.Readiness as EquipmentClassRcmFmeaReadinessDto;
    var fmeaAnalyses = (List<FMEAAnalysisDto>)ViewBag.FmeaAnalyses;
    var rcmAnalyses = (List<RCMAnalysisDto>)ViewBag.RcmAnalyses;
    var canApprove = (bool)ViewBag.CanApprove;
    var canEdit = (bool)ViewBag.CanEdit;
    var failureModes = (List<FailureMode>)ViewBag.FailureModes;
    var functionalRequirements = (List<FunctionalRequirement>)ViewBag.FunctionalRequirements;
    var functionalFailures = (List<FunctionalFailure>)ViewBag.FunctionalFailures;
    var strategyTypes = (List<MaintenanceStrategyType>)ViewBag.MaintenanceStrategyTypes;
    var pmTemplates = (List<PMTemplate>)ViewBag.PMTemplates;
    // طبق «PEMS Phase 6.1» بند ۹: از همان لیست از-قبل-محاسبه‌شده در Controller استفاده می‌شود
    // (فقط تجهیزات همین EquipmentClass) - هیچ Query جدیدی این‌جا زده نمی‌شود.
    IEnumerable<dynamic> equipmentInClass = ViewBag.EquipmentInClass ?? Array.Empty<dynamic>();

    string StatusBadge(string status) => status switch
    {
        "APPROVED" => "success",
        "UNDER_REVIEW" => "warning",
        "SUPERSEDED" => "neutral",
        "ARCHIVED" => "neutral",
        _ => "light"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h6 class="mb-0">@equipmentClass.Name <code class="small">@equipmentClass.Code</code></h6>
        <a asp-action="Index" class="small">← Coverage Matrix</a>
    </div>
    @if (readiness != null)
    {
        <pems-row gap="2" css="small mt-2">
            <pems-col md="3"><strong>@Localizer["Equipment"]</strong><div>@readiness.EquipmentCount.ToString("N0")</div></pems-col>
            <pems-col md="3"><strong>FMEA Readiness</strong><div><pems-badge tone="@(readiness.FMEAReadiness == "READY" ? "success" : readiness.FMEAReadiness == "PARTIALLY_READY" ? "warning" : "neutral")">@readiness.FMEAReadiness</pems-badge></div></pems-col>
            <pems-col md="3"><strong>RCM Readiness</strong><div><pems-badge tone="@(readiness.RCMReadiness == "READY" ? "success" : readiness.RCMReadiness == "PARTIALLY_READY" ? "warning" : "neutral")">@readiness.RCMReadiness</pems-badge></div></pems-col>
            <pems-col md="3"><strong>Strategy Types Available</strong><div>@readiness.StrategyTypeCount</div></pems-col>
        </pems-row>
        @if (readiness.MissingDimensions.Any())
        {
            <pems-alert tone="light" css="border small mt-2 mb-0">
                <strong>Missing:</strong> @string.Join(" · ", readiness.MissingDimensions)
            </pems-alert>
        }
    }
</div>

<pems-nav css="mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-functional">@Localizer["Functional Requirements"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fmea">@Localizer["FMEA"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-rcm">@Localizer["RCM"]</button></li>
</pems-nav>

<div class="tab-content">
    @* ===================== Functional Requirements ===================== *@
    <div class="tab-pane fade show active" id="tab-functional">
        <div class="content-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">@Localizer["Functional Requirements"]</h6>
                @if (canEdit)
                {
                    <pems-button tone="primary" size="small" data-bs-toggle="modal" data-bs-target="#createFrModal"><pems-icon name="bi-plus-lg" /> @Localizer["New"]</pems-button>
                }
            </div>
            @foreach (var fr in functionalRequirements)
            {
                <div class="small text-muted">@fr.Code — @fr.Title</div>
            }
            <pems-related-table>
                <thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Title"]</th><th>@Localizer["Required Function"]</th></tr></thead>
                <tbody>
                    @foreach (var ff in functionalFailures)
                    {
                        <tr>
                            <td><code>@ff.Code</code></td>
                            <td>@ff.Title <span class="text-muted small">(@ff.FunctionalRequirementId)</span></td>
                            <td class="small text-muted">@ff.FailureDefinition</td>
                        </tr>
                    }
                </tbody>
            </pems-related-table>
            @if (canEdit)
            {
                <pems-button tone="neutral" size="small" outline="true" data-bs-toggle="modal" data-bs-target="#createFfModal"><pems-icon name="bi-plus-lg" /> New Functional Failure</pems-button>
            }
        </div>
    </div>

    @* ===================== FMEA ===================== *@
    <div class="tab-pane fade" id="tab-fmea">
        @if (canEdit)
        {
            <div class="content-card mb-3">
                <form asp-action="CreateFmeaDraft" method="post"><pems-row gap="2">
                    <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                    <pems-col md="4"><pems-input scale="small" name="title" placeholder="Analysis title" required /></pems-col>
                    <pems-col md="6"><pems-input scale="small" name="description" placeholder="@Localizer["Description"]" /></pems-col>
                    <pems-col md="2"><pems-button tone="primary" size="small" css="w-100" type="submit">New FMEA Draft</pems-button></pems-col>
                </pems-row></form>
            </div>
        }

        @foreach (var fmea in fmeaAnalyses)
        {
            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">@fmea.Title <span class="text-muted small">Rev. @fmea.Revision</span> <pems-badge tone="@StatusBadge(fmea.Status)">@fmea.Status</pems-badge></h6>
                    <div>
                        @if (fmea.Status == "DRAFT" && canEdit)
                        {
                            <form asp-action="SubmitFmea" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="fmeaAnalysisId" value="@fmea.FMEAAnalysisId" />
                                <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Submit for Review"]</pems-button>
                            </form>
                        }
                        @if (fmea.Status == "UNDER_REVIEW" && canApprove)
                        {
                            <form asp-action="ApproveFmea" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="fmeaAnalysisId" value="@fmea.FMEAAnalysisId" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["Approve"]</pems-button>
                            </form>
                            <form asp-action="RejectFmea" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="fmeaAnalysisId" value="@fmea.FMEAAnalysisId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject → Draft"]</pems-button>
                            </form>
                        }
                    </div>
                </div>
                <div class="small text-muted">Prepared by @fmea.PreparedBy @(fmea.ApprovedBy != null ? $"· Approved by {fmea.ApprovedBy} on {fmea.ApprovedAt:yyyy-MM-dd}" : "")</div>

                <pems-related-table>
                    <thead><tr><th>@Localizer["Failure Mode"]</th><th>@Localizer["Cause"]</th><th>@Localizer["Effect"]</th><th>@Localizer["Consequence"]</th><th>S/O/D</th><th>RPN</th><th>@Localizer["Strategy"]</th></tr></thead>
                    <tbody>
                        @foreach (var item in fmea.Items)
                        {
                            <tr>
                                <td>@item.FailureModeName</td>
                                <td class="small text-muted">@(item.FailureCauseName ?? "-")</td>
                                <td class="small text-muted">@(item.FailureEffectName ?? "-")</td>
                                <td class="small text-muted">@(item.FailureConsequenceName ?? "-")</td>
                                <td class="small">@(item.Severity?.ToString() ?? "-")/@(item.Occurrence?.ToString() ?? "-")/@(item.Detectability?.ToString() ?? "-")</td>
                                <td>@(item.RiskPriorityNumber?.ToString() ?? "-")</td>
                                <td class="small text-muted">@(item.MaintenanceStrategyTypeName ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </pems-related-table>

                @if (fmea.Status == "DRAFT" && canEdit)
                {
                    <form asp-action="AddFmeaItem" method="post"><pems-row gap="2" css="mt-1">
                        <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                        <input type="hidden" name="fmeaAnalysisId" value="@fmea.FMEAAnalysisId" />
                        <pems-col md="3">
                            <pems-select scale="small" name="failureModeId" required>
                                <option value="">Failure Mode...</option>
                                @foreach (var fm in failureModes) { <option value="@fm.FailureModeId">@fm.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="functionalFailureId">
                                <option value="">Functional Failure (optional)...</option>
                                @foreach (var ff in functionalFailures) { <option value="@ff.FunctionalFailureId">@ff.Title</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="2"><pems-input scale="small" name="detectionMethod" placeholder="Detection method" /></pems-col>
                        <pems-col md="1"><pems-input scale="small" name="severity" type="number" min="1" max="10" placeholder="S" /></pems-col>
                        <pems-col md="1"><pems-input scale="small" name="occurrence" type="number" min="1" max="10" placeholder="O" /></pems-col>
                        <pems-col md="1"><pems-input scale="small" name="detectability" type="number" min="1" max="10" placeholder="D" /></pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="maintenanceStrategyTypeId">
                                <option value="">@Localizer["Strategy Type..."]</option>
                                @foreach (var st in strategyTypes) { <option value="@st.MaintenanceStrategyTypeId">@st.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col span="12"><pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-plus-lg" /> Add Item</pems-button></pems-col>
                    </pems-row></form>
                }
            </div>
        }
        @if (!fmeaAnalyses.Any()) { <p class="text-muted small">@Localizer["هنوز هیچ تحلیل FMEA ای برای این کلاس ساخته نشده."]</p> }
    </div>

    @* ===================== RCM ===================== *@
    <div class="tab-pane fade" id="tab-rcm">
        @if (canEdit && fmeaAnalyses.Any(x => x.Status == "APPROVED"))
        {
            <div class="content-card mb-3">
                <form asp-action="CreateRcmDraft" method="post"><pems-row gap="2">
                    <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                    <pems-col md="8">
                        <pems-select scale="small" name="fmeaAnalysisId" required>
                            <option value="">Based on approved FMEA...</option>
                            @foreach (var fmea in fmeaAnalyses.Where(x => x.Status == "APPROVED")) { <option value="@fmea.FMEAAnalysisId">@fmea.Title (Rev. @fmea.Revision)</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="4"><pems-button tone="primary" size="small" css="w-100" type="submit">New RCM Draft</pems-button></pems-col>
                </pems-row></form>
            </div>
        }
        else if (canEdit)
        {
            <p class="text-muted small">@Localizer["برای شروع RCM، ابتدا یک FMEA تاییدشده لازم است."]</p>
        }

        @foreach (var rcm in rcmAnalyses)
        {
            var sourceFmea = fmeaAnalyses.FirstOrDefault(x => x.FMEAAnalysisId == rcm.FMEAAnalysisId);

            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">RCM Rev. @rcm.Revision <pems-badge tone="@StatusBadge(rcm.Status)">@rcm.Status</pems-badge></h6>
                    <div>
                        @if (rcm.Status == "DRAFT" && canEdit)
                        {
                            <form asp-action="SubmitRcm" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="rcmAnalysisId" value="@rcm.RCMAnalysisId" />
                                <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Submit for Review"]</pems-button>
                            </form>
                        }
                        @if (rcm.Status == "UNDER_REVIEW" && canApprove)
                        {
                            <form asp-action="ApproveRcm" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="rcmAnalysisId" value="@rcm.RCMAnalysisId" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["Approve"]</pems-button>
                            </form>
                            <form asp-action="RejectRcm" method="post" class="d-inline">
                                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                <input type="hidden" name="rcmAnalysisId" value="@rcm.RCMAnalysisId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject → Draft"]</pems-button>
                            </form>
                        }
                    </div>
                </div>

                <pems-related-table>
                    <thead><tr><th>@Localizer["Failure Mode"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Strategy Type"]</th><th>PM Template</th><th>@Localizer["Consequence"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in rcm.Decisions)
                        {
                            <tr>
                                <td>@d.FailureModeName</td>
                                <td>@d.DecisionType</td>
                                <td class="small text-muted">@(d.MaintenanceStrategyTypeName ?? "-")</td>
                                <td class="small text-muted">@(d.RecommendedPMTemplateName ?? "-")</td>
                                <td class="small text-muted">@d.ConsequenceCategory</td>
                                <td><pems-badge tone="@StatusBadge(d.Status)">@d.Status</pems-badge></td>
                                <td>
                                    @if (d.Status == "DRAFT" && canApprove)
                                    {
                                        <form asp-action="ApproveRcmDecision" method="post" class="d-inline">
                                            <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                            <input type="hidden" name="rcmDecisionId" value="@d.RCMDecisionId" />
                                            <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["Approve"]</pems-button>
                                        </form>
                                    }
                                    @* طبق «PEMS Phase 6.1»: تنها مسیر UI به پل عملیاتی - فقط برای تصمیم APPROVED و کاربر دارای Approve *@
                                    @if (d.Status == "APPROVED" && canApprove)
                                    {
                                        <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#applyRcmModal" data-fill-rcmdecisionid="@d.RCMDecisionId" data-fill-failuremodename="@d.FailureModeName" data-fill-status="@d.Status" data-fill-decisiontype="@d.DecisionType" data-fill-strategy="@(d.MaintenanceStrategyTypeName ?? "-")" data-fill-pmtemplate="@(d.RecommendedPMTemplateName ?? "-")">
                                            <pems-icon name="bi-gear-fill" /> @Localizer["Apply"]
                                        </pems-button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-related-table>

                @* ==================== Apply RCM Decision → Operational Bridge ====================
                   طبق «PEMS Phase 6.1»: هیچ منطق کسب‌وکاری جدیدی این‌جا نیست - این Modal فقط
                   EquipmentId و RCMDecisionId موجود را به RcmFmeaController.ApplyRcmDecision
                   (که خودش IRcmOperationalBridgeService موجود از فاز ۶ را صدا می‌زند) می‌فرستد.
                   لیست تجهیزات از همان ViewBag.EquipmentInClass از قبل محاسبه‌شده در Controller
                   می‌آید - هیچ Query تازه‌ای این‌جا زده نمی‌شود. *@
                @if (canApprove)
                {
                    @if (rcm.Decisions.Any(x => x.Status == "APPROVED"))
{
    <pems-modal id="applyRcmModal" tabindex="-1">
                                <form asp-action="ApplyRcmDecision" method="post">
                                    <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                                    <input type="hidden" name="rcmDecisionId" value="" />
                                    <div class="modal-header">
                                        <h6 class="modal-title">Apply RCM Decision — <span data-fill-text="failuremodename"></span></h6>
                                    </div>
                                    <div class="modal-body">
                                        <pems-row gap="2" css="small mb-2">
                                            <pems-col span="6"><strong>@Localizer["Status"]</strong><div data-fill-text="status"></div></pems-col>
                                            <pems-col span="6"><strong>Decision Type</strong><div data-fill-text="decisiontype"></div></pems-col>
                                            <pems-col span="6"><strong>Recommended Strategy</strong><div data-fill-text="strategy"></div></pems-col>
                                            <pems-col span="6"><strong>Recommended PM Template</strong><div data-fill-text="pmtemplate"></div></pems-col>
                                        </pems-row>
                                        <pems-alert tone="warning" css="small py-2 px-3">
                                            Applying this approved RCM decision will <strong>create or update the operational Maintenance Strategy</strong> for the equipment selected below
                                            (and its Maintenance Plan, if a PM Template was recommended). This is not a preview — it changes real operational configuration.
                                            Re-applying to the same equipment will safely reuse the existing Maintenance Strategy/Plan, never duplicate it.
                                        </pems-alert>
                                        @if (equipmentInClass.Any())
                                        {
                                            <pems-label css="small">@Localizer["Equipment"]</pems-label>
                                            <pems-select scale="small" name="equipmentId" required>
                                                <option value="">Select equipment...</option>
                                                @foreach (var eq in equipmentInClass)
                                                {
                                                    <option value="@eq.EquipmentId">@eq.TagNumber — @eq.Name</option>
                                                }
                                            </pems-select>
                                        }
                                        else
                                        {
                                            <pems-alert tone="light" css="border small mb-0">این کلاس هنوز تجهیز فعالی ندارد - چیزی برای انتخاب نیست.</pems-alert>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                                        @if (equipmentInClass.Any())
                                        {
                                            <pems-button tone="primary" size="small" type="submit">Apply RCM Decision</pems-button>
                                        }
                                    </div>
                                </form>
                            </pems-modal>
}
                }

                @if (rcm.Status == "DRAFT" && canEdit && sourceFmea != null)
                {
                    <form asp-action="AddRcmDecision" method="post"><pems-row gap="2" css="mt-1">
                        <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                        <input type="hidden" name="rcmAnalysisId" value="@rcm.RCMAnalysisId" />
                        <pems-col md="3">
                            <pems-select scale="small" name="fmeaItemId" required>
                                <option value="">FMEA Item (Failure Mode)...</option>
                                @foreach (var item in sourceFmea.Items) { <option value="@item.FMEAItemId">@item.FailureModeName</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="decisionType" required>
                                <option value="">Decision Type...</option>
                                <option value="CONDITION_BASED">Condition Based</option>
                                <option value="PREDICTIVE">@Localizer["Predictive"]</option>
                                <option value="TIME_BASED">Time Based</option>
                                <option value="USAGE_BASED">Usage Based</option>
                                <option value="FAILURE_FINDING">Failure Finding</option>
                                <option value="RUN_TO_FAILURE">Run to Failure</option>
                                <option value="REDESIGN">Redesign</option>
                                <option value="NO_SCHEDULED_MAINTENANCE">No Scheduled Maintenance</option>
                                <option value="OTHER">@Localizer["Other"]</option>
                            </pems-select>
                        </pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="maintenanceStrategyTypeId">
                                <option value="">@Localizer["Strategy Type..."]</option>
                                @foreach (var st in strategyTypes) { <option value="@st.MaintenanceStrategyTypeId">@st.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="recommendedPMTemplateId">
                                <option value="">PM Template (optional)...</option>
                                @foreach (var pt in pmTemplates) { <option value="@pt.PMTemplateId">@pt.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="2">
                            <pems-select scale="small" name="consequenceCategory">
                                <option value="Safety">@Localizer["Safety"]</option>
                                <option value="Environmental">@Localizer["Environmental"]</option>
                                <option value="Operational" selected>@Localizer["Operational"]</option>
                                <option value="Economic">@Localizer["Economic"]</option>
                            </pems-select>
                        </pems-col>
                        <pems-col md="6"><pems-input scale="small" name="rationale" placeholder="@Localizer["Rationale"]" /></pems-col>
                        <pems-col md="2"><pems-button tone="neutral" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-plus-lg" /> Add Decision</pems-button></pems-col>
                    </pems-row></form>
                }
            </div>
        }
        @if (!rcmAnalyses.Any()) { <p class="text-muted small">@Localizer["هنوز هیچ تحلیل RCM ای برای این کلاس ساخته نشده."]</p> }
    </div>
</div>

@if (canEdit)
{
    <pems-modal id="createFrModal" tabindex="-1">
            <form asp-action="CreateFunctionalRequirement" method="post">
                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                <div class="modal-header"><h6 class="modal-title">@Localizer["Functional Requirement جدید"]</h6></div>
                <div class="modal-body">
                    <div class="mb-2"><pems-label css="small">@Localizer["Code"]</pems-label><pems-input scale="small" name="code" required /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Title"]</pems-label><pems-input scale="small" name="title" required /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Required Function"]</pems-label><pems-input scale="small" name="requiredFunction" /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Description"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </pems-modal>

    <pems-modal id="createFfModal" tabindex="-1">
            <form asp-action="CreateFunctionalFailure" method="post">
                <input type="hidden" name="equipmentClassId" value="@equipmentClass.EquipmentClassId" />
                <div class="modal-header"><h6 class="modal-title">@Localizer["Functional Failure جدید"]</h6></div>
                <div class="modal-body">
                    <div class="mb-2"><pems-label css="small">Functional Requirement</pems-label>
                        <pems-select scale="small" name="functionalRequirementId" required>
                            @foreach (var fr in functionalRequirements)
                            {
                                <option value="@fr.FunctionalRequirementId">@fr.Code — @fr.Title</option>
                            }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Code"]</pems-label><pems-input scale="small" name="code" required /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Title"]</pems-label><pems-input scale="small" name="title" required /></div>
                    <div class="mb-2"><pems-label css="small">Failure Definition</pems-label><pems-textarea scale="small" name="failureDefinition" rows="2"></pems-textarea></div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </pems-modal>
}
