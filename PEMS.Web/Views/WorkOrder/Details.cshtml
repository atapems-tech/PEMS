@model PEMS.Domain.Entities.WorkOrder
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Models
@using PEMS.WorkflowPlatform.Interfaces
@using PEMS.Application.Common
@using PEMS.Application.Interfaces
@inject IStringLocalizer<SharedResource> Localizer
@{
    var sparesUsed = (List<PEMS.Domain.Entities.MaintenanceSpareUsage>)ViewBag.SparesUsed;
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var requiredSkills = (List<PEMS.Domain.Entities.RequiredSkill>)(ViewBag.RequiredSkills ?? new List<PEMS.Domain.Entities.RequiredSkill>());
    var allSkillsForWO = (IEnumerable<dynamic>)(ViewBag.AllSkills ?? new List<object>());
    var tasks = (List<PEMS.Domain.Entities.WorkOrderTask>)(ViewBag.Tasks ?? new List<PEMS.Domain.Entities.WorkOrderTask>());
    var nextStatus = (string?)ViewBag.NextStatus;

    string statusClass = Model.Status switch
    {
        "Closed" or "Completed" => "success",
        "InProgress" => "warning",
        "Assigned" => "info",
        _ => "neutral"
    };

    var hasPendingReview = (bool)(ViewBag.HasPendingReview ?? false);

    // Phase 3B: Work Order حاکمیتی → ساختار/اقدام‌ها/شرکت‌کنندگان/تاریخچه از مدل خواندنی مرکزی. Legacy (بدون Instance) → مسیر قدیمی.
    var wf = ViewBag.Workflow as WorkflowRuntimeViewModel;
    var isLegacy = wf == null;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var employeeNames = (Dictionary<int, string>?)ViewBag.EmployeeNames ?? new Dictionary<int, string>();
    string StageName(WorkflowStageView st) => fa && !string.IsNullOrWhiteSpace(st.NameFa) ? st.NameFa! : st.Name;
    string ActionLabel(WorkflowAvailableAction a) => (fa && !string.IsNullOrWhiteSpace(a.LabelFa)) ? a.LabelFa! : (!string.IsNullOrWhiteSpace(a.Label) ? a.Label! : a.ActionType);
    string StageByName(string? n) => string.IsNullOrEmpty(n) ? "-" : (fa ? (wf?.Stages.FirstOrDefault(x => x.Name == n)?.NameFa ?? n) : n);
    string Who(int? id) => id.HasValue && employeeNames.TryGetValue(id.Value, out var nm) ? nm : (id.HasValue ? "#" + id.Value : "-");
    string ActionText(string a) { var t = Localizer[a]; return t.ResourceNotFound ? a : t.Value; }
    string Participant(WorkflowParticipantView pt) => (pt.Role ?? "").Contains("Permission:")
        ? Localizer["Permission"] + ": \u2066" + (pt.Role ?? "").Replace("Permission:", "").Replace(",", " / ") + "\u2069" : (pt.Role ?? "");
    var diagram = new StageDiagramViewModel();
    if (wf != null)
        foreach (var st in wf.Stages.OrderBy(x => x.Order))
            diagram.Stages.Add(new StageDiagramItem
            {
                Label = StageName(st), IconCssClass = "bi-circle",
                RoleLabel = st.Status == "Current" ? string.Join(", ", st.Participants.Where(x => x.Status == "Pending").Select(Participant).Distinct()) : null,
                State = st.Status switch { "Current" => StageItemState.Current, "Completed" or "Skipped" => StageItemState.Done, "Rejected" or "Cancelled" => StageItemState.Rejected, _ => StageItemState.Pending }
            });
    var actions = wf?.AvailableActions ?? new List<WorkflowAvailableAction>();

    // H25/H26: ماتریس واحد «بخش × فاز × مجوز» (همان که POSTها اعمال می‌کنند). بدون آن (دروازه پیکربندی نشده) همه‌ی کنترل‌های جهشی Fail-Closed پنهان‌اند.
    var failureModeOptions = (List<PEMS.Application.DTOs.FailureOption>)(ViewBag.FailureModeOptions ?? new List<PEMS.Application.DTOs.FailureOption>());
    var failureCauseOptions = (List<PEMS.Application.DTOs.FailureOption>)(ViewBag.FailureCauseOptions ?? new List<PEMS.Application.DTOs.FailureOption>());
    // B12: دکمه‌های مسیر Legacy فقط برای دارندگان همان مجوزی نشان داده می‌شوند که کنترلر اعمال می‌کند (Edit برای پیشروی/توقف، Approve برای رد/لغو)
    var canEditWo = (bool)(ViewBag.CanEditWorkOrder ?? false);
    var canApproveWo = (bool)(ViewBag.CanApproveWorkOrder ?? false);
    var secPage = ViewBag.Sections as WoSectionPage;
    bool Ctl(WoSection s) => secPage != null && secPage.Controls(s);
    SectionAccess Acc(WoSection s) => secPage?.AccessOf(s) ?? SectionAccess.Hidden;
    bool hasMaterialItems = (bool)(ViewBag.HasMaterialItems ?? true);
    var laborEntries = (List<PEMS.Domain.Entities.WorkOrderLabor>)ViewBag.LaborEntries;
    var totalLaborCost = (decimal)ViewBag.TotalLaborCost;
    var spareCost = (decimal)ViewBag.SpareCost;
    var materialMasterUrl = Url.Action("Index", "MaterialItem", new { area = "Warehouse" });
}

@if (wf != null)
{
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="mb-0">@Localizer["Workflow"] <span class="text-muted small">@wf.WorkflowName · @Localizer["Version"] @wf.VersionNumber · @Localizer[wf.Status]</span></h6>
            @foreach (var w in wf.Warnings) { <span class="small text-warning"><pems-icon name="bi-exclamation-triangle" /> @w</span> }
        </div>
        <partial name="_PemsStageDiagram" model="diagram" />
    </div>
}
else
{
<div class="content-card mb-3">
    <partial name="_WorkOrderStagesDiagram" model="@(( Model.Status, hasPendingReview ))" />
</div>
}

@if (ViewBag.EquipmentIdentity is PEMS.Application.DTOs.EquipmentIdentityDto eqIdentity)
{
    <partial name="_EquipmentIdentity" model="eqIdentity" />
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.WorkOrderNumber</h5>
            <pems-badge tone="@statusClass">@Model.Status</pems-badge>
            <pems-badge tone="@(Model.Priority == "Critical" ? "danger" : "neutral")">@Model.Priority</pems-badge>
            <pems-badge tone="neutral">@Model.WorkOrderType</pems-badge>
        </div>
        @if (isLegacy)
        {
        <div>
            @if (nextStatus != null && canEditWo)
            {
                @if (nextStatus == "Completed")
                {
                    <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#completeFailureModal">
                        Advance to Completed
                    </pems-button>

                    <pems-modal id="completeFailureModal" tabindex="-1">
                            <form asp-action="AdvanceStatus" method="post">
                                <input type="hidden" name="id" value="@Model.WorkOrderId" />
                                <div class="modal-header"><h6 class="modal-title"><pems-icon name="bi-clipboard-data" /> ثبت اطلاعات تکمیل</h6></div>
                                <div class="modal-body">
                                    @if (Model.WorkOrderType is "Corrective" or "Emergency")
                                    {
                                        <p class="text-muted small">برای کار اصلاحی/اضطراری، ثبت این اطلاعات برای تحلیل قابلیت‌اطمینان لازمه (ISO 14224).</p>
                                        <div class="mb-2">
                                            <pems-label css="small">حالت خرابی (Failure Mode)</pems-label>
                                            <pems-select scale="small" name="failureModeCode">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                @foreach (var fm in failureModeOptions) { <option value="@fm.Code" selected="@string.Equals(fm.Code, Model.FailureModeCode, StringComparison.OrdinalIgnoreCase)">@fm.Code - @fm.Name</option> }
                                            </pems-select>
                                        </div>
                                        <div class="mb-2">
                                            <pems-label css="small">علت خرابی (Failure Cause)</pems-label>
                                            <pems-select scale="small" name="failureCauseCode">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                @foreach (var fc in failureCauseOptions) { <option value="@fc.Code" selected="@string.Equals(fc.Code, Model.FailureCauseCode, StringComparison.OrdinalIgnoreCase)">@fc.Code - @fc.Name</option> }
                                            </pems-select>
                                        </div>
                                        <div class="mb-2">
                                            <pems-label css="small">اثر خرابی (Failure Effect)</pems-label>
                                            <pems-select scale="small" name="failureEffect">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                <option>Unplanned Shutdown</option><option>Production Loss</option><option>Safety Impact</option>
                                                <option>Environmental Impact</option><option>Quality Impact</option><option>No Impact</option>
                                                <option>@Localizer["Other"]</option>
                                            </pems-select>
                                        </div>
                                        <div class="mb-2">
                                            <pems-label css="small">ریشه‌ی مشکل (Root Cause)</pems-label>
                                            <pems-textarea scale="small" name="rootCause" rows="2"></pems-textarea>
                                        </div>
                                        <div class="mb-2">
                                            <pems-label css="small">اقدام اصلاحی (Corrective Action)</pems-label>
                                            <pems-textarea scale="small" name="correctiveAction" rows="2"></pems-textarea>
                                        </div>
                                        <div class="mb-2">
                                            <pems-label css="small">Downtime واقعی (ساعت)</pems-label>
                                            <pems-input scale="small" name="downtimeHours" type="number" step="0.1" value="@Model.DowntimeHours" />
                                        </div>
                                        <hr />
                                    }
                                    <div class="mb-2">
                                        <pems-label css="small">هزینه پیمانکار (Contractor Cost)</pems-label>
                                        <pems-input scale="small" name="contractorCost" type="number" step="0.01" />
                                    </div>
                                    <div class="mb-2">
                                        <pems-label css="small">نام پیمانکار (Contractor Name)</pems-label>
                                        <pems-input scale="small" name="contractorName" />
                                    </div>
                                    <div class="mb-2">
                                        <pems-label css="small">دلیل / یادداشت این تغییر وضعیت (اختیاری)</pems-label>
                                        <pems-input scale="small" name="reason" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                                    <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت و تکمیل"]</pems-button>
                                </div>
                            </form>
                        </pems-modal>
                }
                else
                {
                    <form asp-action="AdvanceStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.WorkOrderId" />
                        @if (nextStatus == "Assigned")
                        {
                            <pems-select class="pems-w-200" scale="small" css="d-inline-block" name="assignedTeamId" required>
                                <option value="">گروه کاری...</option>
                                @foreach (var c in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@c.TeamId">@c.Name</option> }
                            </pems-select>
                        }
                        <pems-input class="pems-w-180" scale="small" css="d-inline-block" name="reason" placeholder="@Localizer["دلیل (اختیاری)"]" />
                        <pems-button tone="primary" size="small" type="submit">Advance to @nextStatus</pems-button>
                    </form>
                }
            }
            else if (Model.Status != "OnHold")
            {
                <pems-badge tone="success"><pems-icon name="bi-check2-circle" /> Final Status</pems-badge>
            }

            @* طبق CMMS Production Baseline v1 بند ۹.۲: مسیرهای انشعابی OnHold/Cancelled/Rejected -
               مستقل از nextStatus خطی، چون این وضعیت‌ها در StatusFlow اصلی نیستند. *@
            @if (canEditWo && Model.Status is "Assigned" or "InProgress")
            {
                <form asp-action="Hold" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <pems-input class="pems-w-160" scale="small" css="d-inline-block" name="reason" required placeholder="@Localizer["Reason (required)"]" />
                    <pems-button tone="warning" size="small" outline="true" type="submit" data-legacy="hold"><pems-icon name="bi-pause-circle" /> @Localizer["Hold"]</pems-button>
                </form>
            }
            @if (canEditWo && Model.Status == "OnHold")
            {
                <form asp-action="Resume" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-play-circle" /> Resume</pems-button>
                </form>
            }
            @if (canApproveWo && Model.Status == "Open")
            {
                <form asp-action="Reject" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <pems-input class="pems-w-160" scale="small" css="d-inline-block" name="reason" required placeholder="@Localizer["Reason (required)"]" />
                    <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="این WorkOrder رد شود؟">@Localizer["Reject"]</pems-button>
                </form>
            }
            @if (canApproveWo && Model.Status is "Open" or "Assigned" or "InProgress" or "OnHold")
            {
                <form asp-action="Cancel" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <pems-input class="pems-w-160" scale="small" css="d-inline-block" name="reason" required placeholder="@Localizer["Reason (required)"]" />
                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-legacy="cancel" data-pems-confirm="این WorkOrder لغو شود؟">@Localizer["Cancel"]</pems-button>
                </form>
            }
        </div>
        }
    </div>

    @if (!isLegacy)
    {
        <div class="small mt-2 d-flex flex-wrap gap-3">
            <span><strong>@Localizer["Originating Discipline"]:</strong> <bdi>@(Model.OriginatingOrganization) / @(ViewBag.OriginatingDisciplineName ?? "-")</bdi></span>
            <span><strong>@Localizer["Responsible Maintenance Discipline"]:</strong> <bdi>@(ViewBag.ResponsibleDisciplineName != null ? Model.ResponsibleOrganization + " / " + ViewBag.ResponsibleDisciplineName : "-")</bdi></span>
        </div>
    }

    @if (Model.SourceWorkRequestId.HasValue)
    {
        <div class="small text-muted mt-1">
            <pems-icon name="bi-clipboard-plus" /> Source: <a asp-controller="WorkRequest" asp-action="Details" asp-route-id="@Model.SourceWorkRequestId">Work Request</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.FailureModeCode) || !string.IsNullOrWhiteSpace(Model.RootCause))
    {
        <pems-alert tone="secondary" css="small mt-2 mb-0">
            <strong><pems-icon name="bi-clipboard-data" /> Failure Analysis:</strong>
            @Model.FailureModeCode / @Model.FailureCauseCode
            @if (Model.DowntimeHours.HasValue) { <span> — Downtime: @Model.DowntimeHours ساعت</span> }
            @if (!string.IsNullOrWhiteSpace(Model.RootCause)) { <div>Root Cause: @Model.RootCause</div> }
        </pems-alert>
    }

    <pems-info-grid class="mt-3">
        <pems-info-item label="@Localizer["Equipment"]" num><a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.Equipment?.TagNumber</a></pems-info-item>
        <pems-info-item label="@Localizer["Assigned"]">
            @if (Model.AssignedTeam != null)
            {
                <span>@Model.AssignedTeam.Name</span>
            }
            @if (Model.AssignedEmployee != null)
            {
                <span class="text-muted">(@Model.AssignedEmployee.FirstName @Model.AssignedEmployee.LastName)</span>
            }
            @if (Model.AssignedTeam == null && Model.AssignedEmployee == null && !string.IsNullOrEmpty(Model.AssignedTo))
            {
                <span class="text-muted">@Model.AssignedTo</span>
            }
        </pems-info-item>
        <pems-info-item label="@Localizer["Planned"]">
            @if (Model.PlannedStart.HasValue && Model.PlannedFinish.HasValue)
            {
                <span dir="ltr">@Model.PlannedStart.Value.ToString("yyyy-MM-dd HH:mm") &rarr; @Model.PlannedFinish.Value.ToString("HH:mm")</span>
            }
            else
            {
                <span class="text-muted">@Localizer["Unscheduled"]</span>
            }
        </pems-info-item>
        <pems-info-item label="@Localizer["Info_Started"]" num>@Model.StartDate?.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Info_Completed"]" num>@Model.CompletionDate?.ToString("yyyy-MM-dd")</pems-info-item>
        @if (Model.MaintenancePlan != null)
        {
            <pems-info-item label="@Localizer["Info_FromPlan"]" wide><span dir="ltr">@Model.MaintenancePlan.PlanNumber</span> - @Model.MaintenancePlan.Title</pems-info-item>
        }
        <pems-info-item label="@Localizer["Description"]" wide>@Model.Description</pems-info-item>
    </pems-info-grid>
</div>

@if (!isLegacy)
{
    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["Actions"]</h6>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            @if (actions.Count > 0)
            {
                <form asp-action="WorkflowAction" method="post" class="d-flex flex-column gap-2 w-100">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <pems-input class="pems-w-300" scale="small" type="text" name="comment" placeholder="@Localizer["Comment (required for Reject / Cancel / Hold / Return)"]" />
                        @foreach (var a in actions)
                        {
                            var cls = a.ActionType == "Approve" ? "btn-pems-solid" : a.ActionType is "Reject" or "Cancel" ? "btn-outline-danger" : "btn-outline-primary";
                            var needsReason = WorkflowActionRules.ActionRequiresReason(a.ActionType);
                            <pems-button tone="none" size="small" css="@cls" type="submit" name="actionType" value="@a.ActionType" disabled="@(!a.IsAllowed)" title="@(a.IsAllowed ? "" : a.DeniedReason)" data-pems-require="@(needsReason ? "comment" : "")" data-pems-confirm="@(needsReason && (a.ActionType is "Reject" or "Cancel") ? Localizer["Are you sure?"].Value : "")">
                                @ActionLabel(a)@if (!string.IsNullOrWhiteSpace(a.ToStageName)) { <span class="opacity-75"> → @StageByName(a.ToStageName)</span> }
                            </pems-button>
                        }
                    </div>
                    @if (Model.Status == "InProgress")
                    {
                        @* داده‌های تکمیل (قواعد دامنه‌ی Work Order؛ اعتبارسنجی نهایی سمت سرور) *@
                        <details class="small">
                            <summary>@Localizer["Completion data"]</summary>
                            <pems-row gap="2" css="mt-1">
                                @if (Model.WorkOrderType is "Corrective" or "Emergency")
                                {
                                    <pems-col md="3"><pems-label css="small">@Localizer["Failure Mode"]</pems-label>
                                        @if (failureModeOptions.Count > 0)
                                        {
                                            <pems-select scale="small" name="failureModeCode">
                                                <option value="">--</option>
                                                @foreach (var fm in failureModeOptions) { <option value="@fm.Code" selected="@string.Equals(fm.Code, Model.FailureModeCode, StringComparison.OrdinalIgnoreCase)">@fm.Code - @fm.Name</option> }
                                            </pems-select>
                                        }
                                        else { <pems-input scale="small" name="failureModeCode" value="@Model.FailureModeCode" /> }
                                    </pems-col>
                                    <pems-col md="3"><pems-label css="small">@Localizer["Failure Cause"]</pems-label>
                                        @if (failureCauseOptions.Count > 0)
                                        {
                                            <pems-select scale="small" name="failureCauseCode">
                                                <option value="">--</option>
                                                @foreach (var fc in failureCauseOptions) { <option value="@fc.Code" selected="@string.Equals(fc.Code, Model.FailureCauseCode, StringComparison.OrdinalIgnoreCase)">@fc.Code - @fc.Name</option> }
                                            </pems-select>
                                        }
                                        else { <pems-input scale="small" name="failureCauseCode" value="@Model.FailureCauseCode" /> }
                                    </pems-col>
                                    <pems-col md="3"><pems-label css="small">@Localizer["Root Cause"]</pems-label><pems-input scale="small" name="rootCause" /></pems-col>
                                    <pems-col md="3"><pems-label css="small">@Localizer["Downtime Hours"]</pems-label><pems-input scale="small" name="downtimeHours" type="number" step="0.1" /></pems-col>
                                    <pems-col md="6"><pems-label css="small">@Localizer["Failure Effect"]</pems-label><pems-input scale="small" name="failureEffect" value="@Model.FailureEffect" /></pems-col>
                                    <pems-col md="6"><pems-label css="small">@Localizer["Corrective Action"]</pems-label><pems-input scale="small" name="correctiveAction" /></pems-col>
                                }
                                <pems-col md="6"><pems-label css="small">@Localizer["Contractor"]</pems-label><pems-input scale="small" name="contractorName" /></pems-col>
                                <pems-col md="6"><pems-label css="small">@Localizer["Contractor Cost"]</pems-label><pems-input scale="small" name="contractorCost" type="number" step="0.01" /></pems-col>
                            </pems-row>
                        </details>
                    }
                </form>
                @foreach (var denied in actions.Where(a => !a.IsAllowed && !string.IsNullOrWhiteSpace(a.DeniedReason)))
                {
                    <div class="small text-muted w-100"><pems-icon name="bi-lock" /> @ActionLabel(denied): @denied.DeniedReason</div>
                }
            }
            else
            {
                <span class="text-muted small">@Localizer["No further actions available."]</span>
            }
        </div>

        @if (Ctl(WoSection.ResponsibleDiscipline) || Ctl(WoSection.ExecutorAssignment) || Ctl(WoSection.Schedule))
        {
            @* برنامه‌ریزی/تخصیص: داده‌های دامنه‌ی Work Order؛ فقط وقتی ماتریس بخش + مجوز اجازه می‌دهد رندر می‌شود (سمت سرور هم همین اعمال می‌شود) *@
            <hr class="my-3" />
            <pems-row gap="2">
                @if (Ctl(WoSection.ResponsibleDiscipline))
                {
                <pems-col md="6">
                    <form asp-action="SetPlanning" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                        <input type="hidden" name="id" value="@Model.WorkOrderId" />
                        <div><pems-label css="small mb-1">@Localizer["Responsible Maintenance Discipline"]</pems-label>
                            <pems-select scale="small" name="responsibleDisciplineId" required>
                                <option value="">--</option>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@(Model.ResponsibleDisciplineId == (int)d.DisciplineId)">@d.Name</option> }
                            </pems-select></div>
                        <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                    </form>
                </pems-col>
                }
                @if (Ctl(WoSection.ExecutorAssignment))
                {
                    @if (!((IEnumerable<dynamic>)ViewBag.Teams).Any())
                    {
                        <pems-col span="12">
                            <pems-alert tone="info" css="small py-2 mb-0">
                                <pems-icon name="bi-info-circle" /> @Localizer["No teams exist for the responsible discipline yet; assign an individual executor or create a team first."]
                                <a asp-controller="Team" asp-action="Index" class="alert-link">@Localizer["Go to Teams"]</a>
                            </pems-alert>
                        </pems-col>
                    }
                    <pems-col md="6">
                        <form asp-action="AssignExecutor" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                            <input type="hidden" name="id" value="@Model.WorkOrderId" />
                            <div><pems-label css="small mb-1">@Localizer["Team"]</pems-label>
                                <pems-select scale="small" name="teamId"><option value="">--</option>
                                    @foreach (var c in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@c.TeamId">@c.Name</option> }
                                </pems-select></div>
                            <div><pems-label css="small mb-1">@Localizer["Executor"]</pems-label>
                                <pems-select scale="small" name="employeeId"><option value="">--</option>
                                    @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                                </pems-select></div>
                            <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Assign"]</pems-button>
                        </form>
                    </pems-col>
                }
                @if (Ctl(WoSection.Schedule))
                {
                    <pems-col md="6">
                        @* طبق «PEMS — Work Request/Work Order Scheduling & Maintenance Calendar»: زمان‌بندی مستقل از
                           تخصیص تیم/کارمند است (ترتیب الزامی نیست) - همان مرحله/مجوز، فرم جدا. *@
                        <form asp-action="SetSchedule" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                            <input type="hidden" name="id" value="@Model.WorkOrderId" />
                            <div><pems-label css="small mb-1">@Localizer["Planned Start"]</pems-label>
                                <pems-input type="datetime-local" name="plannedStart" value="@(Model.PlannedStart?.ToString("yyyy-MM-ddTHH:mm"))" required scale="small" /></div>
                            <div><pems-label css="small mb-1">@Localizer["Planned Finish"]</pems-label>
                                <pems-input type="datetime-local" name="plannedFinish" value="@(Model.PlannedFinish?.ToString("yyyy-MM-ddTHH:mm"))" required scale="small" /></div>
                            <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Save Schedule"]</pems-button>
                        </form>
                    </pems-col>
                }
            </pems-row>
        }
    </div>

    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["Workflow History"]</h6>
        <div class="table-responsive">
        <pems-related-table>
            <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Action"]</th><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["By"]</th><th>@Localizer["Reason"]</th></tr></thead>
            <tbody>
                @foreach (var h in wf!.HistorySummary.OrderByDescending(x => x.ActionDate))
                {
                    <tr>
                        <td class="small"><bdi dir="ltr">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</bdi></td>
                        <td class="small">@ActionText(h.ActionType)</td>
                        <td class="small">@StageByName(h.FromStageName)</td>
                        <td class="small">@StageByName(h.ToStageName)</td>
                        <td class="small">@Who(h.UserId)</td>
                        <td class="small text-muted">@h.Comment</td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
        </div>
    </div>
}

@{
    var reviewStatus = (IEnumerable<PEMS.Application.Interfaces.VdrReviewStatusItemDto>)(ViewBag.ReviewStatus ?? new List<PEMS.Application.Interfaces.VdrReviewStatusItemDto>());
    var findings = (List<PEMS.Domain.Entities.WorkOrderDisciplineFinding>)(ViewBag.Findings ?? new List<PEMS.Domain.Entities.WorkOrderDisciplineFinding>());
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
    var statusHistory = (List<PEMS.Domain.Entities.WorkOrderStatusHistory>)(ViewBag.StatusHistory ?? new List<PEMS.Domain.Entities.WorkOrderStatusHistory>());
}

@if (statusHistory.Any())
{
    <div class="content-card mb-3">
        <h6 class="mb-3"><pems-icon name="bi-clock-history" /> @(isLegacy ? Localizer["Status History"] : Localizer["Business Audit"])</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var h in statusHistory)
            {
                <li class="d-flex justify-content-between border-bottom py-2 small">
                    <span><pems-badge tone="neutral">@h.FromStatus</pems-badge> → <pems-badge tone="neutral">@h.ToStatus</pems-badge>
                        @if (!string.IsNullOrWhiteSpace(h.Reason)) { <span class="text-muted"> — @h.Reason</span> }
                    </span>
                    <span class="text-muted">
                        @(h.ChangedBy != null ? $"{h.ChangedBy.FirstName} {h.ChangedBy.LastName}" : "-")
                        · @h.ChangedDate.ToString("yyyy-MM-dd HH:mm")
                    </span>
                </li>
            }
        </ul>
    </div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-people" /> @Localizer["بازبینی چند-دیسیپلینه"]</h6>
    <p class="text-muted small">
        طبق رویه‌ی استاندارد هماهنگی چند-تخصصی (Multi-Craft Coordination، EN 13460): اگه این
        کار نیاز به تایید/یافته‌ی چند دیسیپلین تعمیراتی داره (مثلاً برق + مکانیک + ابزاردقیق)،
        این‌جا ارجاع بده. تا همه پاسخ ندن، WorkOrder نمی‌تونه Completed بشه.
    </p>

    @if (!hasPendingReview && !Ctl(WoSection.DisciplineReview))
    {
        <p class="text-muted small mb-2"><pems-icon name="bi-lock" /> @Localizer["Requesting a multi-discipline review is not available at this stage or with your permissions."]</p>
    }
    else if (!hasPendingReview)
    {
        <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#requestReviewModal">
            <pems-icon name="bi-send" /> @Localizer["درخواست بازبینی چند-دیسیپلینه"]
        </pems-button>

        <pems-modal id="requestReviewModal" tabindex="-1">
                <form asp-action="RequestDisciplineReview" method="post">
                    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["انتخاب دیسیپلین‌ها"]</h6></div>
                    <div class="modal-body">
                        @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines)
                        {
                            <div class="form-check">
                                <pems-input kind="check" type="checkbox" name="disciplineIds" value="@d.DisciplineId" id="woDisc_@d.DisciplineId" />
                                <label class="form-check-label small" for="woDisc_@d.DisciplineId">@d.Name</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                        <pems-button tone="primary" size="small" type="submit">@Localizer["شروع بازبینی"]</pems-button>
                    </div>
                </form>
            </pems-modal>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var r in reviewStatus)
            {
                var badgeClass = r.Status switch { "Approve" => "success", "Comment" => "warning", "Reject" => "danger", _ => "neutral" };
                <pems-badge tone="@badgeClass">@r.DisciplineName: @r.Status</pems-badge>
            }
        </div>

        var myPending = reviewStatus.FirstOrDefault(x => x.DisciplineId == myDisciplineId && x.Status == "Pending");
        @if (myPending != null)
        {
            <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#respondReviewModal">
                <pems-icon name="bi-reply" /> ثبت نظر دیسیپلین من
            </pems-button>

            <pems-modal id="respondReviewModal" tabindex="-1">
                    <form asp-action="RespondDisciplineReview" method="post">
                        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                        <div class="modal-header"><h6 class="modal-title">@Localizer["ثبت نظر / یافته"]</h6></div>
                        <div class="modal-body">
                            <div class="mb-2">
                                <pems-label css="small">@Localizer["تصمیم"]</pems-label>
                                <pems-select scale="small" name="decision" required>
                                    <option value="Approve">@Localizer["تایید (بدون ایراد)"]</option>
                                    <option value="Comment">@Localizer["تایید با یادداشت"]</option>
                                    <option value="Reject">@Localizer["ایراد جدی دارد"]</option>
                                </pems-select>
                            </div>
                            <div class="mb-2">
                                <pems-label css="small">@Localizer["یافته / توضیح"]</pems-label>
                                <pems-textarea scale="small" name="findings" rows="3"></pems-textarea>
                            </div>
                            <div class="mb-2">
                                <pems-label css="small">حالت خرابی (از دید این دیسیپلین - اختیاری)</pems-label>
                                <pems-select scale="small" name="failureModeCode">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    <option>@Localizer["Leakage"]</option><option>@Localizer["Fracture"]</option><option>@Localizer["Vibration"]</option>
                                    <option>@Localizer["Overheating"]</option><option>@Localizer["Blockage"]</option><option>@Localizer["ElectricalFault"]</option>
                                    <option>@Localizer["Other"]</option>
                                </pems-select>
                            </div>
                            <div class="mb-2">
                                <pems-label css="small">علت خرابی (از دید این دیسیپلین - اختیاری)</pems-label>
                                <pems-select scale="small" name="failureCauseCode">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    <option>@Localizer["Corrosion"]</option><option>@Localizer["Fatigue"]</option><option>@Localizer["Wear"]</option>
                                    <option>@Localizer["OperatorError"]</option><option>@Localizer["DesignDeficiency"]</option><option>@Localizer["MaterialDefect"]</option>
                                    <option>@Localizer["Other"]</option>
                                </pems-select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                            <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
                        </div>
                    </form>
                </pems-modal>
        }
        else
        {
            <pems-badge tone="warning"><pems-icon name="bi-hourglass-split" /> در انتظار پاسخ سایر دیسیپلین‌ها</pems-badge>
        }
    }

    @if (findings.Any())
    {
        <hr class="my-3" />
        <h6 class="small fw-bold mb-2">@Localizer["یافته‌های ثبت‌شده"]</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var f in findings)
            {
                <li class="border-bottom py-2">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold small">@f.Discipline?.Name</span>
                        <pems-badge tone="@(f.Decision == "Approve" ? "success" : f.Decision == "Comment" ? "warning" : "danger")">@f.Decision</pems-badge>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(f.Findings)) { <p class="small mb-0">@f.Findings</p> }
                    @if (!string.IsNullOrWhiteSpace(f.FailureModeCode)) { <p class="small text-muted mb-0">@f.FailureModeCode / @f.FailureCauseCode</p> }
                    <span class="text-muted small">@f.RespondedDate.ToString("yyyy-MM-dd HH:mm")</span>
                </li>
            }
        </ul>
    }
</div>

@if (secPage != null && (secPage.Phase is WoPhase.Closed or WoPhase.Cancelled or WoPhase.Rejected))
{
    <pems-alert tone="secondary" css="d-flex align-items-center gap-2 small">
        <pems-icon name="bi-lock-fill" />
        <span>@Localizer["This Work Order is {0} and immutable; every section is read-only.", fa ? WorkOrderSectionPolicy.PhaseNameFa(secPage.Phase) : WorkOrderSectionPolicy.PhaseNameEn(secPage.Phase)]</span>
    </pems-alert>
}

@if (secPage != null && secPage.CanReopen)
{
    <div class="content-card mb-3 border-warning">
        <h6 class="mb-2"><pems-icon name="bi-unlock" /> @Localizer["Reopen Work Order"]</h6>
        <p class="text-muted small mb-2">@Localizer["A formal reopen requires a reason and is audited; the Work Order returns to the verification stage."]</p>
        <form asp-action="ReopenWorkOrder" method="post"><pems-row gap="2">
            <input type="hidden" name="id" value="@Model.WorkOrderId" />
            <pems-col md="9"><pems-input scale="small" name="reason" maxlength="500" required placeholder="@Localizer["Reason for reopening (required)"]" /></pems-col>
            <pems-col md="3"><pems-button tone="warning" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-unlock" /> @Localizer["Reopen"]</pems-button></pems-col>
        </pems-row></form>
    </div>
}

@if (Acc(WoSection.Labor) == SectionAccess.Hidden)
{
    <div class="content-card mb-3 text-muted small"><pems-icon name="bi-lock" /> @Localizer["Actual labor hours are not available until execution starts."]</div>
}
else
{
<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-person-workspace" /> @Localizer["Labor (ساعت‌کار واقعی)"]</h6>
    @if (TempData.Peek("LaborRateEmployeeId") is int rateEmployeeId)
    {
        <pems-alert tone="warning" css="small py-2">
            <pems-icon name="bi-cash-coin" /> @Localizer["This employee has no hourly rate defined."]
            <a asp-controller="Employee" asp-action="Details" asp-route-id="@rateEmployeeId" class="alert-link">@Localizer["Go to rate setup"]</a>
        </pems-alert>
    }
    <p class="text-muted small">
        <strong>Assigned Employee</strong> فقط نشون می‌ده مسئول اجرای این WorkOrder کیه؛ اینجا
        ثبت واقعی می‌شه که کدوم کارمندها، چند ساعت، با چه نرخی واقعاً کار کردن. نرخ موقع ثبت
        Snapshot می‌شه - تغییر نرخ آینده هزینه‌ی این رکورد رو تغییر نمی‌ده.
    </p>

    <div class="table-responsive pems-s-7bf38d03">
        <pems-related-table>
            <thead><tr><th>@Localizer["Employee"]</th><th>Team</th><th>@Localizer["Date"]</th><th>@Localizer["Regular Hrs"]</th><th>OT Hrs</th><th>Rate</th><th>@Localizer["OT Rate"]</th><th>@Localizer["Cost"]</th></tr></thead>
            <tbody>
                @foreach (var l in laborEntries)
                {
                    <tr>
                        <td>@l.Employee?.FirstName @l.Employee?.LastName</td>
                        <td class="small">@l.Team?.Name</td>
                        <td class="small">@l.WorkDate.ToString("yyyy-MM-dd")</td>
                        <td>@l.RegularHours</td>
                        <td>@l.OvertimeHours</td>
                        <td class="small">@l.Rate.ToString("N0")</td>
                        <td class="small">@l.OvertimeRate.ToString("N0")</td>
                        <td class="fw-bold">@l.LaborCost.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
    </div>
    @if (!laborEntries.Any()) { <p class="text-muted small">@Localizer["ساعت‌کاری هنوز ثبت نشده."]</p> }

    @if (Ctl(WoSection.Labor))
    {
    <form asp-action="AddLaborEntry" method="post"><pems-row gap="2" css="mt-2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        @if (Acc(WoSection.Labor) == SectionAccess.Correctable)
        {
            <pems-col span="12"><pems-input scale="small" name="correctionReason" maxlength="500" required placeholder="@Localizer["Correction reason (required after execution)"]" /></pems-col>
        }
        <pems-col md="3">
            <pems-select scale="small" name="employeeId" required>
                @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-select scale="small" name="teamId">
                <option value="">@Localizer["Team (optional)"]</option>
                @foreach (var t in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@t.TeamId">@t.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-date name="workDate" scale="small" required /></pems-col>
        <pems-col md="1"><pems-input scale="small" name="regularHours" type="number" step="0.5" min="0" placeholder="Reg" /></pems-col>
        <pems-col md="1"><pems-input scale="small" name="overtimeHours" type="number" step="0.5" min="0" placeholder="OT" /></pems-col>
        <pems-col md="2"><pems-input scale="small" name="notes" placeholder="@Localizer["Notes (optional)"]" /></pems-col>
        <pems-col md="1"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /></pems-button></pems-col>
    </pems-row></form>
    }
    else
    {
        <p class="text-muted small mb-0"><pems-icon name="bi-lock" /> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }

    <hr class="my-3" />
    <pems-row gap="2" css="text-center">
        <pems-col span="4"><div class="fw-bold">@totalLaborCost.ToString("N0")</div><div class="text-muted small">@Localizer["Labor Cost"]</div></pems-col>
        <pems-col span="4"><div class="fw-bold">@spareCost.ToString("N0")</div><div class="text-muted small">@Localizer["Spare Cost"]</div></pems-col>
        <pems-col span="4"><div class="fw-bold text-success">@((totalLaborCost + spareCost).ToString("N0"))</div><div class="text-muted small">@Localizer["Total Maintenance Cost"]</div></pems-col>
    </pems-row>
</div>
}

@if (Acc(WoSection.SpareParts) == SectionAccess.Hidden)
{
    <div class="content-card text-muted small"><pems-icon name="bi-lock" /> @Localizer["Spare parts usage is not available until execution starts."]</div>
}
else
{
<div class="content-card">
    <h6 class="mb-3">@Localizer["Spare Parts Used"]</h6>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
    <pems-related-table>
        <thead><tr><th>@Localizer["Material Code"]</th><th>@Localizer["Description"]</th><th>@Localizer["Qty"]</th><th>Returned</th><th>@Localizer["Unit Cost"]</th><th>@Localizer["Total"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in sparesUsed)
            {
                var outstanding = s.Quantity - (s.ReturnedQuantity ?? 0);
                <tr>
                    <td>@s.MaterialItem?.MaterialCode</td>
                    <td>@s.MaterialItem?.Description</td>
                    <td>@s.Quantity</td>
                    <td>@(s.ReturnedQuantity ?? 0)</td>
                    <td>@s.UnitCost</td>
                    <td>@s.TotalCost</td>
                    <td>
                        @if (outstanding > 0 && Ctl(WoSection.SpareParts))
                        {
                            <form asp-action="ReturnSpareUsage" method="post" class="d-flex gap-1">
                                <input type="hidden" name="maintenanceSpareUsageId" value="@s.MaintenanceSpareUsageId" />
                                <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                                @if (Acc(WoSection.SpareParts) == SectionAccess.Correctable)
                                {
                                    <pems-input class="pems-w-140" scale="small" name="reason" maxlength="500" required placeholder="@Localizer["Correction reason"]" />
                                }
                                <pems-input class="pems-w-80" scale="small" type="number" name="returnQuantity" step="0.01" max="@outstanding" placeholder="@Localizer["Qty"]" required />
                                <pems-button tone="neutral" size="small" outline="true" type="submit" title="Return"><pems-icon name="bi-arrow-return-left" /></pems-button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-related-table>
    </div>
    @if (!sparesUsed.Any()) { <p class="text-muted small">@Localizer["No spare parts recorded yet."]</p> }

    @if (!Ctl(WoSection.SpareParts))
    {
        <p class="text-muted small mb-0"><pems-icon name="bi-lock" /> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }
    else if (!hasMaterialItems)
    {
        <pems-alert tone="info" css="small mb-0">
            @Localizer["No materials exist in the Material Master yet; define materials first."]
            @if (!string.IsNullOrEmpty(materialMasterUrl)) { <a href="@materialMasterUrl" class="alert-link">@Localizer["Go to Material Master"]</a> }
        </pems-alert>
    }
    else
    {
    <div class="input-group input-group-sm mb-2 pems-s-0fd8744d">
        <span class="input-group-text"><pems-icon name="bi-upc-scan" /></span>
        <pems-input type="text" id="spareUsageScanInput" dir="ltr" placeholder="@Localizer["Scan Material barcode..."]" />
        <pems-button tone="neutral" outline="true" type="button" id="spareUsageScanBtn">@Localizer["Resolve"]</pems-button>
    </div>
    <form asp-action="AddSpareUsage" method="post"><pems-row gap="2" css="mt-2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        @if (Acc(WoSection.SpareParts) == SectionAccess.Correctable)
        {
            <pems-col span="12"><pems-input scale="small" name="correctionReason" maxlength="500" required placeholder="@Localizer["Correction reason (required after execution)"]" /></pems-col>
        }
        <pems-col md="4">
            <pems-select scale="small" name="materialItemId" id="spareUsageMaterialSelect" required>
                @foreach (var p in materialItems) { <option value="@p.MaterialItemId">@p.MaterialCode - @p.Description</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3"><pems-input scale="small" name="quantity" type="number" step="0.01" placeholder="@Localizer["Quantity"]" required /></pems-col>
        <pems-col md="3"><pems-input scale="small" name="unitCost" type="number" step="0.01" placeholder="@Localizer["Unit cost (optional)"]" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
    </pems-row></form>
    }
</div>
}

@if (tasks.Any())
{
    <div class="content-card mt-3">
        <h6 class="mb-3"><pems-icon name="bi-list-ol" /> Tasks (@tasks.Count(t => t.IsCompleted)/@tasks.Count completed)</h6>
        <pems-related-table>
            <thead><tr><th class="pems-w-50"></th><th class="pems-w-60">#</th><th>@Localizer["Title"]</th><th>@Localizer["Description"]</th><th>@Localizer["Completed"]</th></tr></thead>
            <tbody>
                @foreach (var t in tasks)
                {
                    <tr class="@(t.IsCompleted ? "text-muted" : "")">
                        <td>
                            @if (Ctl(WoSection.JobPlanTasks))
                            {
                                <form asp-action="@(t.IsCompleted ? "ReopenTask" : "CompleteTask")" method="post">
                                    <input type="hidden" name="workOrderTaskId" value="@t.WorkOrderTaskId" />
                                    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                                    <pems-button tone="none" size="small" css="p-0 border-0" type="submit" title="@(t.IsCompleted ? "Reopen" : "Mark complete")">
                                        <pems-icon class="pems-fs-11rem" css="@(t.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")" />
                                    </pems-button>
                                </form>
                            }
                            else
                            {
                                <pems-icon class="pems-fs-11rem" css="@(t.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")" />
                            }
                        </td>
                        <td class="small fw-bold">@t.TaskNumber</td>
                        <td class="small @(t.IsCompleted ? "text-decoration-line-through" : "")">@t.Title</td>
                        <td class="small text-muted">@t.Description</td>
                        <td class="small">@(t.IsCompleted ? $"{t.CompletedBy} @ {t.CompletedDate:yyyy-MM-dd HH:mm}" : "-")</td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
    </div>
}

@{
    var totalPlannedHours = requiredSkills.Sum(x => x.PlannedHours ?? 0);
    var totalActualHours = laborEntries.Sum(x => x.RegularHours + x.OvertimeHours);
}

<div class="content-card mt-3">
    <h6 class="mb-3"><pems-icon name="bi-mortarboard" /> @Localizer["Required Skills"]</h6>
    @if (totalPlannedHours > 0 || totalActualHours > 0)
    {
        <p class="small text-muted mb-2">
            <pems-icon name="bi-hourglass-split" /> Planned: <strong>@totalPlannedHours h</strong>
            &middot; Actual: <strong>@totalActualHours h</strong>
        </p>
    }
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var rs in requiredSkills)
        {
            <pems-badge tone="neutral" css="d-flex align-items-center gap-1">
                @rs.Skill?.Name @(string.IsNullOrWhiteSpace(rs.MinimumProficiencyLevel) ? "" : $"({rs.MinimumProficiencyLevel}+)")
                @(rs.PlannedHours.HasValue ? $"[{rs.PlannedHours}h]" : "")
                @if (Ctl(WoSection.RequiredSkills))
                {
                <form asp-action="RemoveRequiredSkill" method="post" class="d-inline">
                    <input type="hidden" name="requiredSkillId" value="@rs.RequiredSkillId" />
                    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                    <pems-button class="lh-1" tone="none" size="small" css="p-0 border-0 text-white" type="submit" title="@Localizer["حذف"]"><pems-icon name="bi-x" /></pems-button>
                </form>
                }
            </pems-badge>
        }
    </div>
    @if (!requiredSkills.Any()) { <p class="text-muted small">@Localizer["مهارت موردنیازی ثبت نشده."]</p> }

    @if (Ctl(WoSection.RequiredSkills))
    {
    <form asp-action="AddRequiredSkill" method="post"><pems-row gap="2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        <pems-col md="4">
            <pems-select scale="small" name="skillId" required>
                @foreach (var s in allSkillsForWO) { <option value="@s.SkillId">@s.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="minimumProficiencyLevel">
                <option value="">@Localizer["حداقل سطح (اختیاری)"]</option>
                <option value="Basic">@Localizer["Basic"]</option>
                <option value="Intermediate">@Localizer["Intermediate"]</option>
                <option value="Advanced">@Localizer["Advanced"]</option>
                <option value="Expert">@Localizer["Expert"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-input scale="small" name="plannedHours" type="number" step="0.5" placeholder="@Localizer["Planned h"]" /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
    </pems-row></form>
    }
    else
    {
        <p class="text-muted small mb-0"><pems-icon name="bi-lock" /> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }
</div>

<div class="content-card mt-3">
    @{
        var requiredMaterials = (List<PEMS.Domain.Entities.WorkOrderMaterial>)ViewBag.RequiredMaterials;
        var intake = ViewBag.WarehouseIntake as PEMS.Application.Interfaces.WarehouseIntakeDto;   // SCRUM-472
    }
    <h6 class="mb-3"><pems-icon name="bi-box-seam" /> @Localizer["Required Materials"]</h6>
    <pems-related-table>
        <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Required Qty"]</th><th>@Localizer["Whi_SupplyCode"]</th><th>@Localizer["Whi_Sourced"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var rm in requiredMaterials)
            {
                var il = intake?.Lines.FirstOrDefault(l => l.WorkOrderMaterialId == rm.WorkOrderMaterialId);
                var sourcedAlready = il != null && il.Requisitions.Count > 0;
                <tr>
                    <td class="small">@rm.MaterialItem?.MaterialCode - @rm.MaterialItem?.Description</td>
                    <td>@rm.RequiredQuantity</td>
                    <td class="small">
                        @if (Ctl(WoSection.RequiredMaterials) && !sourcedAlready)
                        {
                        <form asp-action="SetMaterialSupplyCode" method="post" class="d-flex gap-1">
                            <input type="hidden" name="workOrderMaterialId" value="@rm.WorkOrderMaterialId" />
                            <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                            <pems-select scale="small" name="supplyCode" aria-label="@Localizer["Whi_SupplyCode"]" data-pems-select="off">
                                @foreach (var code in PEMS.Domain.Entities.WorkOrderMaterialSupplyCodes.All)
                                {
                                    <option value="@code" selected="@(code == rm.SupplyCode)">@Localizer["Whi_Supply_" + code]</option>
                                }
                            </pems-select>
                            <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["Whi_Save"]"><pems-icon name="bi-check2" /></pems-button>
                        </form>
                        }
                        else
                        {
                            <span class="vs-pill @(rm.SupplyCode == PEMS.Domain.Entities.WorkOrderMaterialSupplyCodes.DirectPurchase ? "vs-pill--warning" : "vs-pill--neutral")">@Localizer["Whi_Supply_" + rm.SupplyCode]</span>
                        }
                    </td>
                    <td class="small">
                        @if (il != null && rm.SupplyCode == PEMS.Domain.Entities.WorkOrderMaterialSupplyCodes.Stock)
                        {
                            <span dir="ltr">@il.SourcedQuantity.ToString("0.###") / @il.RequiredQuantity.ToString("0.###")</span>
                            @foreach (var r in il.Requisitions)
                            {
                                <a class="ms-1" href="/Warehouse/StoreRequisition/Details/@r.StoreRequisitionId" dir="ltr">@r.RequisitionNumber (@r.WarehouseCode)</a>
                            }
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td class="text-end">
                        @if (Ctl(WoSection.RequiredMaterials))
                        {
                        <form asp-action="RemoveRequiredMaterial" method="post" class="d-inline">
                            <input type="hidden" name="workOrderMaterialId" value="@rm.WorkOrderMaterialId" />
                            <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                            <pems-button tone="danger" size="small" outline="true" type="submit" title="@Localizer["حذف"]"><pems-icon name="bi-x" /></pems-button>
                        </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-related-table>
    @if (!requiredMaterials.Any()) { <p class="text-muted small">@Localizer["متریال موردنیازی ثبت نشده."]</p> }

    @* SCRUM-472: warehouse intake of the stock lines *@
    @if (intake != null && intake.Lines.Count > 0)
    {
        var unsourced = intake.Lines.Where(l => l.UnsourcedQuantity > 0).ToList();
        var hasDirectPurchase = intake.Lines.Any(l => l.SupplyCode == PEMS.Domain.Entities.WorkOrderMaterialSupplyCodes.DirectPurchase);   // SCRUM-471
        <div class="d-flex flex-wrap align-items-center gap-2 small mb-3">
            <span class="fw-semibold"><pems-icon name="bi-inboxes" aria-hidden="true" /> @Localizer["Whi_Title"]:</span>
            @if (intake.IsOpen)
            {
                <span class="vs-pill vs-pill--warning">@Localizer["Whi_State_Open"]</span>
                <a href="/Warehouse/WarehouseIntake/Details/@Model.WorkOrderId">@Localizer["Whi_Open"]</a>
            }
            else if (unsourced.Count == 0 && !hasDirectPurchase)
            {
                <span class="vs-pill vs-pill--success">@Localizer["Whi_State_Sourced"]</span>
            }
            else
            {
                <span class="vs-pill vs-pill--neutral">@Localizer["Whi_State_NotRequested"]</span>
                @if (canEditWo)
                {
                    <form asp-action="RequestWarehouseMaterials" method="post" class="d-inline">
                        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                        <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-send" aria-hidden="true" /> @Localizer["Whi_Request"]</pems-button>
                    </form>
                }
                <span class="text-muted">@Localizer["Whi_RequestHint"]</span>
            }
        </div>
    }

    @if (!Ctl(WoSection.RequiredMaterials))
    {
        <p class="text-muted small mb-0"><pems-icon name="bi-lock" /> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }
    else if (!hasMaterialItems)
    {
        <pems-alert tone="info" css="small mb-0">
            @Localizer["No materials exist in the Material Master yet; define materials first."]
            @if (!string.IsNullOrEmpty(materialMasterUrl)) { <a href="@materialMasterUrl" class="alert-link">@Localizer["Go to Material Master"]</a> }
        </pems-alert>
    }
    else
    {
    <div class="input-group input-group-sm mb-2 pems-s-0fd8744d">
        <span class="input-group-text"><pems-icon name="bi-upc-scan" /></span>
        <pems-input type="text" id="requiredMaterialScanInput" dir="ltr" placeholder="@Localizer["Scan Material barcode..."]" />
        <pems-button tone="neutral" outline="true" type="button" id="requiredMaterialScanBtn">@Localizer["Resolve"]</pems-button>
    </div>
    <form asp-action="AddRequiredMaterial" method="post"><pems-row gap="2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        <pems-col md="6">
            <pems-select scale="small" name="materialItemId" id="requiredMaterialSelect" required>
                @foreach (var m in materialItems) { <option value="@m.MaterialItemId">@m.MaterialCode - @m.Description</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3"><pems-input scale="small" name="requiredQuantity" type="number" step="0.001" placeholder="@Localizer["Quantity"]" required /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
    </pems-row></form>
    }
</div>

<div class="content-card mt-3">
    <h6 class="mb-3"><pems-icon name="bi-people-fill" /> Crew</h6>
    @{ var woCrews = (List<PEMS.Domain.Entities.Crew>)(ViewBag.Crews ?? new List<PEMS.Domain.Entities.Crew>()); }
    @if (woCrews.Any())
    {
        @foreach (var c in woCrews)
        {
            <div class="mb-2">
                <span class="fw-bold small">@c.Code — @c.Name</span>
                <span class="text-muted small">(@c.Members.Count(m => m.IsActive) عضو)</span>
                @if (Ctl(WoSection.Crew)) { <a asp-controller="Crew" asp-action="Index" class="small">@Localizer["مدیریت اعضا"]</a> }
            </div>
        }
    }
    else if (!Ctl(WoSection.Crew))
    {
        <p class="text-muted small mb-0"><pems-icon name="bi-lock" /> @Localizer["Creating a crew is not available at the current stage or with your permissions."]</p>
    }
    else
    {
        <form asp-action="CreateCrewForWorkOrder" method="post"><pems-row gap="2">
            <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
            <pems-col md="4"><pems-input scale="small" name="code" placeholder="@Localizer["کد Crew"]" required /></pems-col>
            <pems-col md="5"><pems-input scale="small" name="name" placeholder="@Localizer["نام Crew"]" required /></pems-col>
            <pems-col md="3"><pems-button tone="primary" size="small" outline="true" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["ساخت Crew برای این WorkOrder"]</pems-button></pems-col>
        </pems-row></form>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@section Scripts {
<script src="~/js/views/workorder-details.js" asp-append-version="true"></script>
}
