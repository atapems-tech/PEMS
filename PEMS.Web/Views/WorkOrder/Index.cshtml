@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.WorkOrderListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipments = (IEnumerable<dynamic>)ViewBag.Equipments;
}

@* Re-composed: KPI cards -> a chip strip (the status chips are real filters), filters + one search + primary action on ONE toolbar row. *@
<div class="vs-chips">
    <a class="vs-chip text-decoration-none @(((int)ViewBag.OpenCount) > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-status="Open"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @Localizer["Wo_Open"] <strong>@ViewBag.OpenCount</strong></a>
    <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-status="InProgress"><i class="bi bi-tools" aria-hidden="true"></i> @Localizer["Wo_InProgress"] <strong>@ViewBag.InProgressCount</strong></a>
    <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-status="Completed"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Wo_Completed"] <strong>@ViewBag.CompletedCount</strong></a>
    <span class="vs-chip @(((int)ViewBag.CriticalOpenCount) > 0 ? "vs-chip--danger" : "")"><i class="bi bi-lightning" aria-hidden="true"></i> @Localizer["Wo_CriticalOpen"] <strong>@ViewBag.CriticalOpenCount</strong></span>
</div>

<form method="get" class="vs-toolbar" role="search">
    <div class="pems-search-bar">
        <i class="bi bi-search pems-search-icon" aria-hidden="true"></i>
        <input type="text" class="form-control" id="woEquipmentFilterSearch" placeholder="@Localizer["Wo_SearchEquipment"]" aria-label="@Localizer["Wo_SearchEquipment"]"
               value="@ViewBag.SelectedEquipmentLabel" data-pems-search data-search-type="Equipment" autocomplete="off" />
        <input type="hidden" name="equipmentId" id="woEquipmentFilterHidden" value="@ViewBag.SelectedEquipmentId" />
    </div>
    <select name="status" class="form-select form-select-sm" aria-label="@Localizer["Ed_Status"]">
        <option value="">@Localizer["Eq_AllStatuses"]</option>
        @foreach (var s in new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" })
        { <option value="@s" selected="@(s == (string)ViewBag.SelectedStatus)">@s</option> }
    </select>
    <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" name="assignedToMe" value="true" id="assignedToMeCheck"
               checked="@(((bool)ViewBag.AssignedToMe) ? "checked" : null)" onchange="this.form.submit()" />
        <label class="form-check-label small" for="assignedToMeCheck">@Localizer["Wo_AssignedToMe"]</label>
    </div>
    <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-funnel" aria-hidden="true"></i> @Localizer["Eq_Apply"]</button>
    <a asp-action="Index" class="vs-icon-btn" title="@Localizer["Reset"]" aria-label="@Localizer["Reset"]"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
    <span class="vs-toolbar__end">
        <a asp-action="Create" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["Wo_New"]</a>
    </span>
</form>
<script>
    document.getElementById('woEquipmentFilterSearch').addEventListener('pems:search-select', function (e) {
        if (e.detail) document.getElementById('woEquipmentFilterHidden').value = e.detail.id;
    });
</script>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('WorkOrder')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
        </button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="WorkOrder">
            <thead>
                <tr>
                    <th data-col-key="woNo" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Wo_ColNo"]</th>
                    <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Wo_ColEquipment"]</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Ed_Type"]</th>
                    <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Cm_Priority"]</th>
                    <th data-col-key="assignedTo" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["Wo_ColAssigned"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Ed_Status"]</th>
                    <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Ed_Created"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model.Items)
                {
                    <tr>
                        <td class="vs-num"><a asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNumber</a></td>
                        <td class="small">@w.EquipmentTagNumber</td>
                        <td><span class="badge bg-secondary">@w.WorkOrderType</span></td>
                        <td><span class="badge @(w.Priority == "Critical" ? "bg-danger" : w.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")">@w.Priority</span></td>
                        <td class="small">@(w.AssignedTeamName ?? w.AssignedEmployeeName ?? w.AssignedTo ?? "-")</td>
                        <td><span class="badge @(w.Status == "Closed" || w.Status == "Completed" ? "bg-success" : w.Status == "InProgress" ? "bg-warning text-dark" : "bg-secondary")">@w.Status</span></td>
                        <td class="small text-muted">@w.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["No work orders yet."]</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (ViewBag.SelectedEquipmentId != null) qsParts.Add($"equipmentId={ViewBag.SelectedEquipmentId}");
        if ((bool)ViewBag.AssignedToMe) qsParts.Add("assignedToMe=true");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "WorkOrder",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('WorkOrder');
        });
    </script>
}
