@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.WorkOrderListDto>
@{
    var equipments = (IEnumerable<dynamic>)ViewBag.Equipments;
}

<div class="row g-3 mb-3">
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-red"><i class="bi bi-exclamation-circle"></i></div><div><div class="kpi-value">@ViewBag.OpenCount</div><div class="kpi-label">Open</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-tools"></i></div><div><div class="kpi-value">@ViewBag.InProgressCount</div><div class="kpi-label">In Progress</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-check-circle"></i></div><div><div class="kpi-value">@ViewBag.CompletedCount</div><div class="kpi-label">Completed / Closed</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-lightning"></i></div><div><div class="kpi-value">@ViewBag.CriticalOpenCount</div><div class="kpi-label">Critical Open</div></div></div></div>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" })
                { <option value="@s" selected="@(s == (string)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" class="form-control form-control-sm" id="woEquipmentFilterSearch"
                   placeholder="جستجوی تجهیز..." value="@ViewBag.SelectedEquipmentLabel"
                   data-pems-search data-search-type="Equipment" autocomplete="off" />
            <input type="hidden" name="equipmentId" id="woEquipmentFilterHidden" value="@ViewBag.SelectedEquipmentId" />
            <script>
                document.getElementById('woEquipmentFilterSearch').addEventListener('pems:search-select', function (e) {
                    if (e.detail) document.getElementById('woEquipmentFilterHidden').value = e.detail.id;
                });
            </script>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-pems-solid flex-fill"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger" title="Reset"><i class="bi bi-x-lg"></i></a>
        </div>
        <div class="col-md-3 text-end">
            <a asp-action="Create" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg"></i> New Work Order</a>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="assignedToMe" value="true" id="assignedToMeCheck"
                       checked="@(((bool)ViewBag.AssignedToMe) ? "checked" : null)" onchange="this.form.submit()" />
                <label class="form-check-label small" for="assignedToMeCheck">
                    <i class="bi bi-person-check"></i> Assigned to Me
                </label>
            </div>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('WorkOrder')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="WorkOrder">
            <thead>
                <tr>
                    <th data-col-key="woNo" data-resizable="true" data-min-width="100" data-max-width="200">WO No</th>
                    <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220">Equipment</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180">Type</th>
                    <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140">Priority</th>
                    <th data-col-key="assignedTo" data-resizable="true" data-min-width="120" data-max-width="260">Assigned To</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">Status</th>
                    <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160">Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNumber</a></td>
                        <td class="small">@w.EquipmentTagNumber</td>
                        <td><span class="badge bg-secondary">@w.WorkOrderType</span></td>
                        <td><span class="badge @(w.Priority == "Critical" ? "bg-danger" : w.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")">@w.Priority</span></td>
                        <td class="small">@(w.AssignedTeamName ?? w.AssignedEmployeeName ?? w.AssignedTo ?? "-")</td>
                        <td><span class="badge @(w.Status == "Closed" || w.Status == "Completed" ? "bg-success" : w.Status == "InProgress" ? "bg-warning text-dark" : "bg-secondary")">@w.Status</span></td>
                        <td class="small text-muted">@w.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No work orders yet.</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (ViewBag.SelectedEquipmentId != null) qsParts.Add($"equipmentId={ViewBag.SelectedEquipmentId}");
        if ((bool)ViewBag.AssignedToMe) qsParts.Add("assignedToMe=true");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "WorkOrder",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('WorkOrder');
        });
    </script>
}
