@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.WorkOrderListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = (string?)ViewBag.SelectedStatus;
    var equipmentId = (int?)ViewBag.SelectedEquipmentId;
    var equipmentLabel = (string?)ViewBag.SelectedEquipmentLabel;
    var assignedToMe = (bool)ViewBag.AssignedToMe;
    bool? mine = assignedToMe ? true : null;
    var statuses = new[] { "Open", "Assigned", "InProgress", "Completed", "Closed" };
    var filterCount = (string.IsNullOrEmpty(status) ? 0 : 1) + (equipmentId.HasValue ? 1 : 0) + (assignedToMe ? 1 : 0);

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (equipmentId.HasValue) qsParts.Add($"equipmentId={equipmentId}");
    if (assignedToMe) qsParts.Add("assignedToMe=true");

    // display text of a stored value; no key => the raw value
    string StatusText(string? s) => VdrUi.Loc(Localizer, "Wo_St_", s);
    string StatusTone(string? s) => s is "Closed" or "Completed" ? "vs-pill--success" : s == "InProgress" ? "vs-pill--warning" : "vs-pill--info";
    string PriorityTone(string? p) => p == "Critical" ? "vs-pill--danger" : p == "High" ? "vs-pill--warning" : "vs-pill--neutral";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its filters (equipment, status, assigned to me),
   its status counts (they stay links that filter the list) and its columns. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Wo_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="woFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="woEquipmentFilterSearch">@Localizer["Wo_ColEquipment"]</label>
                        <input type="text" class="form-control form-control-sm" id="woEquipmentFilterSearch" placeholder="@Localizer["Wo_SearchEquipment"]"
                               value="@equipmentLabel" data-pems-search data-search-type="Equipment" autocomplete="off" />
                        <input type="hidden" name="equipmentId" id="woEquipmentFilterHidden" value="@equipmentId" />
                    </div>
                    <div>
                        <label class="lp-lbl" for="woFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="woFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" name="assignedToMe" value="true" id="assignedToMeCheck" checked="@assignedToMe" />
                        <label class="form-check-label small" for="assignedToMeCheck">@Localizer["Wo_AssignedToMe"]</label>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="woKpis" storage-key="pems.wo.kpis" />
                <pems-list-reset-columns grid-key="WorkOrder" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Wo_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="woKpis">
            <a class="vs-chip text-decoration-none @(((int)ViewBag.OpenCount) > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-status="Open"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @Localizer["Wo_Open"] <strong>@ViewBag.OpenCount</strong></a>
            <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-status="InProgress"><i class="bi bi-tools" aria-hidden="true"></i> @Localizer["Wo_InProgress"] <strong>@ViewBag.InProgressCount</strong></a>
            <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-status="Completed"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Wo_Completed"] <strong>@ViewBag.CompletedCount</strong></a>
            <span class="vs-chip @(((int)ViewBag.CriticalOpenCount) > 0 ? "vs-chip--danger" : "")"><i class="bi bi-lightning" aria-hidden="true"></i> @Localizer["Wo_CriticalOpen"] <strong>@ViewBag.CriticalOpenCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (equipmentId.HasValue)
            { <pems-list-chip label="@Localizer["Wo_ColEquipment"]" value="@equipmentLabel" remove-href="@Url.Action("Index", new { status, assignedToMe = mine })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { equipmentId, assignedToMe = mine })" /> }
            @if (assignedToMe)
            { <pems-list-chip label="@Localizer["Wo_AssignedToMe"]" remove-href="@Url.Action("Index", new { status, equipmentId })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="WorkOrder" empty="@(!Model.Items.Any())" empty-text="@Localizer["Wo_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="woNo" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Wo_ColNo"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Wo_ColEquipment"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Ed_Type"]</th>
                        <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Cm_Priority"]</th>
                        <th data-col-key="assignedTo" data-resizable="true" data-min-width="120" data-max-width="260" style="width:180px" class="vs-hide-md">@Localizer["Wo_ColAssigned"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180" style="width:130px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Ed_Created"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@w.WorkOrderId" class="lp-subject" title="@w.WorkOrderNumber">@w.WorkOrderNumber</a></td>
                            <td class="small"><span class="vs-num">@w.EquipmentTagNumber</span></td>
                            <td><span class="vs-pill vs-pill--neutral">@w.WorkOrderType</span></td>
                            <td><span class="vs-pill @PriorityTone(w.Priority)">@VdrUi.Loc(Localizer, "Pri_", w.Priority)</span></td>
                            <td class="small vs-hide-md">@(w.AssignedTeamName ?? w.AssignedEmployeeName ?? w.AssignedTo ?? "-")</td>
                            <td><span class="vs-pill @StatusTone(w.Status)">@StatusText(w.Status)</span></td>
                            <td class="small text-muted"><span class="vs-num">@w.CreatedDate.ToString("yyyy-MM-dd")</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "WorkOrder",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
    <script>
        // picking an equipment from the suggestions fills the hidden filter field
        document.getElementById('woEquipmentFilterSearch').addEventListener('pems:search-select', function (e) {
            if (e.detail) document.getElementById('woEquipmentFilterHidden').value = e.detail.id;
        });
    </script>
}
