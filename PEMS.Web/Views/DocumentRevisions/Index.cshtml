@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.DocumentRevisionDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var documents = ((IEnumerable<dynamic>)ViewBag.Documents).ToList();
    int? selectedDoc = ViewBag.DocumentId;
    var existingQueryString = selectedDoc.HasValue ? $"documentId={selectedDoc}" : "";
    string? selectedDocText = null;
    foreach (var d in documents) { if (d.DocumentId == selectedDoc) { selectedDocText = d.DocumentNo; } }

    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
    string OrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component; the page keeps its document filter and its "new revision" rule
   (only for a chosen document). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Rv_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="rvFilterForm" action="@Url.Action("Index")" count="@(selectedDoc.HasValue ? 1 : 0)" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="rvFilterDocument">@Localizer["Rv_Document"]</label>
                        <select id="rvFilterDocument" name="documentId" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var d in documents)
                            { <option value="@d.DocumentId" selected="@(d.DocumentId == selectedDoc)">@d.DocumentNo - @d.Title</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-reset-columns grid-key="DocumentRevisions" />
                @if (selectedDoc.HasValue)
                {
                    <pems-list-new href="@Url.Action("Create", new { documentId = selectedDoc })" text="@Localizer["Rv_New"]" />
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (selectedDoc.HasValue)
            { <pems-list-chip label="@Localizer["Rv_Document"]" value="@selectedDocText" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="DocumentRevisions" empty="@(!Model.Items.Any())" empty-text="@Localizer["Rv_Empty"]"
                             filtered="@selectedDoc.HasValue" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="docNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Ed_DocNo"]</th>
                        <th data-col-key="revision" data-resizable="true" data-min-width="70" data-max-width="120" style="width:90px">@Localizer["Ed_Rev"]</th>
                        <th data-col-key="prevRev" data-resizable="true" data-min-width="70" data-max-width="120" style="width:100px">@Localizer["Rv_PreviousRev"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="issuePurpose" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Rv_IssuePurpose"]</th>
                        <th data-col-key="preparedBy" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Rv_PreparedBy"]</th>
                        <th data-col-key="checkedBy" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Rv_CheckedBy"]</th>
                        <th data-col-key="approvedBy" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Rv_ApprovedBy"]</th>
                        <th data-col-key="date" data-resizable="true" data-min-width="100" data-max-width="160" style="width:120px">@Localizer["Rv_Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no">@r.DocumentNo</td>
                            <td><span class="vs-pill vs-pill--neutral vs-num">@r.RevisionNo</span></td>
                            <td class="small"><span class="vs-num">@OrDash(r.PreviousRevisionNo)</span></td>
                            <td><span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(r.Status)"><i class="bi @DocumentStatusBadge.Icon(r.Status)" aria-hidden="true"></i> @StatusText(r.Status)</span></td>
                            <td class="small">@r.IssuePurpose</td>
                            <td class="vs-hide-md small">@OrDash(r.PreparedBy)</td>
                            <td class="vs-hide-md small">@OrDash(r.CheckedBy)</td>
                            <td class="vs-hide-md small">@OrDash(r.ApprovedBy)</td>
                            <td class="small text-muted">@r.RevisionDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "DocumentRevisions",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = existingQueryString
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
