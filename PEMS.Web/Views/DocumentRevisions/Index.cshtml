@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.DocumentRevisionDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var documents = ((IEnumerable<dynamic>)ViewBag.Documents).ToList();
    int? selectedDoc = ViewBag.DocumentId;
    var existingQueryString = selectedDoc.HasValue ? $"documentId={selectedDoc}" : "";
    string? selectedDocText = null;
    foreach (var d in documents) { if (d.DocumentId == selectedDoc) { selectedDocText = d.DocumentNo; } }

    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
    string OrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component; the page keeps its document filter and its "new revision" rule
   (only for a chosen document). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Rv_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="rvFilterForm" action="@Url.Action("Index")" count="@(selectedDoc.HasValue ? 1 : 0)" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="rvFilterDocument">@Localizer["Rv_Document"]</label>
                        <pems-select scale="small" id="rvFilterDocument" name="documentId">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var d in documents)
                            { <option value="@d.DocumentId" selected="@(d.DocumentId == selectedDoc)">@d.DocumentNo - @d.Title</option> }
                        </pems-select>
                    </div>
                </pems-list-filters>
                <pems-list-reset-columns grid-key="DocumentRevisions" />
                @if (selectedDoc.HasValue)
                {
                    <pems-list-new href="@Url.Action("Create", new { documentId = selectedDoc })" text="@Localizer["Rv_New"]" />
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (selectedDoc.HasValue)
            { <pems-list-chip label="@Localizer["Rv_Document"]" value="@selectedDocText" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="DocumentRevisions" empty="@(!Model.Items.Any())" empty-text="@Localizer["Rv_Empty"]"
                             filtered="@selectedDoc.HasValue" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="docNo" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_DocNo"]</pems-table-header>
                        <pems-table-header class="pems-w-90" data-col-key="revision" data-resizable="true" data-min-width="70" data-max-width="120">@Localizer["Ed_Rev"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="prevRev" data-resizable="true" data-min-width="70" data-max-width="120">@Localizer["Rv_PreviousRev"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-140" data-col-key="issuePurpose" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Rv_IssuePurpose"]</pems-table-header>
                        <pems-table-header data-col-key="preparedBy" data-resizable="true" data-min-width="100" data-max-width="200" class="vs-hide-md pems-w-130">@Localizer["Rv_PreparedBy"]</pems-table-header>
                        <pems-table-header data-col-key="checkedBy" data-resizable="true" data-min-width="100" data-max-width="200" class="vs-hide-md pems-w-130">@Localizer["Rv_CheckedBy"]</pems-table-header>
                        <pems-table-header data-col-key="approvedBy" data-resizable="true" data-min-width="100" data-max-width="200" class="vs-hide-md pems-w-130">@Localizer["Rv_ApprovedBy"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="date" data-resizable="true" data-min-width="100" data-max-width="160">@Localizer["Rv_Date"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var r in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no">@r.DocumentNo</pems-table-cell>
                            <pems-table-cell><span class="vs-pill vs-pill--neutral vs-num">@r.RevisionNo</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@OrDash(r.PreviousRevisionNo)</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(r.Status)"><pems-icon css="@DocumentStatusBadge.Icon(r.Status)" aria-hidden="true" /> @StatusText(r.Status)</span></pems-table-cell>
                            <pems-table-cell class="small">@r.IssuePurpose</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@OrDash(r.PreparedBy)</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@OrDash(r.CheckedBy)</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small">@OrDash(r.ApprovedBy)</pems-table-cell>
                            <pems-table-cell class="small text-muted">@r.RevisionDate.ToString("yyyy-MM-dd")</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "DocumentRevisions",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = existingQueryString
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
