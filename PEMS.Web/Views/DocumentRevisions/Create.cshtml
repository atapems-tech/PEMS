@model PEMS.Domain.Entities.DocumentRevision
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    dynamic document = ViewBag.Document;
}

<pems-content-card css="pems-s-e2b01b0d">
    <p class="text-muted mb-3">Document: <strong>@document.DocumentNo - @document.Title</strong> (current revision: @document.RevisionNo)</p>

    <pems-form asp-action="Create" method="post">
        <input type="hidden" asp-for="DocumentId" />

        <pems-row gap="3">
            <pems-col md="6">
                <pems-label>New Revision No</pems-label>
                <pems-input asp-for="RevisionNo" placeholder="e.g. 01" />
            </pems-col>
            <pems-col md="6">
                <pems-label>Previous Revision No</pems-label>
                <pems-input asp-for="PreviousRevisionNo" readonly />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Status"]</pems-label>
                <pems-select asp-for="Status">
                    <option>@Localizer["Draft"]</option>
                    <option>@Localizer["Review"]</option>
                    <option>@Localizer["Approved"]</option>
                    <option>@Localizer["Rejected"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Issue Purpose"]</pems-label>
                <pems-input asp-for="IssuePurpose" placeholder="For Approval / For Construction / For Information" />
            </pems-col>
            <pems-col span="12">
                <pems-label>@Localizer["Comment"]</pems-label>
                <pems-textarea asp-for="Comment" rows="3"></pems-textarea>
            </pems-col>
        </pems-row>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">Save Revision</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index" asp-route-documentId="@document.DocumentId">Cancel</pems-button>
        </div>
    </pems-form>
</pems-content-card>
