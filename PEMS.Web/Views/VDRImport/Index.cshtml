@model List<PEMS.Application.DTOs.VDRImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}


<div class="vs-page">

<div class="vs-stepper">
    <div class="vs-stepper__item vs-stepper__item--active"><span class="vs-stepper__num">1</span>@Localizer["Vs_StepUpload"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">2</span>@Localizer["Vs_StepReview"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">3</span>@Localizer["Vs_StepCommit"]</div>
</div>

<div class="content-card mb-3" style="max-width:700px;">
    <p class="text-muted small">@Localizer["Vs_ImportSub"]</p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">@Localizer["Vs_Project"]</label>
            <select name="projectId" class="form-select" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small">@Localizer["Vs_ExcelFile"]</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" css="w-100" type="submit"><i class="bi bi-cloud-upload"></i> @Localizer["Vs_Upload"]</pems-button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Vs_RecentImports"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Vs_File"]</th><th>@Localizer["Vs_Project"]</th><th>@Localizer["Vs_Date"]</th><th>@Localizer["Total"]</th><th>@Localizer["Vs_Valid"]</th><th>@Localizer["Vs_Warning"]</th><th>@Localizer["Vs_Error"]</th><th>@Localizer["Vs_Duplicate"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ProjectName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@b.RowsTotal</td>
                    <td><pems-badge tone="success">@b.RowsValid</pems-badge></td>
                    <td><pems-badge tone="warning">@b.RowsWarning</pems-badge></td>
                    <td><pems-badge tone="danger">@b.RowsError</pems-badge></td>
                    <td><pems-badge tone="neutral">@b.RowsDuplicate</pems-badge></td>
                    <td><pems-badge tone="@(b.Status == "Committed" ? "success" : "neutral")">@b.Status</pems-badge></td>
                    <td>
                        @if (b.Status == "Staged")
                        {
                            <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Review" asp-route-batchId="@b.VDRImportBatchId">Review</pems-button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">@Localizer["Vs_NoImports"]</p> }
</div>

</div>

@{ ViewData["Title"] = Localizer["Vs_ImportTitle"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
