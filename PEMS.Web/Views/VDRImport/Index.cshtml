@model List<PEMS.Application.DTOs.VDRImportBatchDto>
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}


<div class="content-card mb-3" style="max-width:700px;">
    <p class="text-muted">
        فایل اکسل VDR فعلی سازمان را آپلود کنید. سیستم آن را می‌خواند، اعتبارسنجی و بررسی موارد
        تکراری می‌کند، ولی هیچ داده‌ای وارد جداول اصلی نمی‌شود تا شما در صفحه‌ی بعد آن را تایید کنید.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">Project</label>
            <select name="projectId" class="form-select" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small">VDR Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-pems-solid w-100"><i class="bi bi-cloud-upload"></i> Upload</button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">Recent Import Batches</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>File</th><th>Project</th><th>Date</th><th>Total</th><th>Valid</th><th>Warning</th><th>Error</th><th>Duplicate</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ProjectName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@b.RowsTotal</td>
                    <td><span class="badge bg-success">@b.RowsValid</span></td>
                    <td><span class="badge bg-warning text-dark">@b.RowsWarning</span></td>
                    <td><span class="badge bg-danger">@b.RowsError</span></td>
                    <td><span class="badge bg-secondary">@b.RowsDuplicate</span></td>
                    <td><span class="badge @(b.Status == "Committed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                    <td>
                        @if (b.Status == "Staged")
                        {
                            <a asp-action="Review" asp-route-batchId="@b.VDRImportBatchId" class="btn btn-sm btn-outline-primary">Review</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No imports yet.</p> }
</div>
