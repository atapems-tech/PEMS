@model PEMS.Application.DTOs.VDRImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="vs-page">


<div class="vs-stepper">
    <div class="vs-stepper__item vs-stepper__item--done"><span class="vs-stepper__num"><i class="bi bi-check-lg"></i></span>@Localizer["Vs_StepUpload"]</div>
    <div class="vs-stepper__item vs-stepper__item--active"><span class="vs-stepper__num">2</span>@Localizer["Vs_StepReview"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">3</span>@Localizer["Vs_StepCommit"]</div>
</div>

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>@Localizer["File:"]</strong> @Model.FileName</div>
        <div class="col-md-3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-2"><strong>@Localizer["Total:"]</strong> @Model.RowsTotal</div>
        <div class="col-md-2"><strong>@Localizer["Duplicates:"]</strong> @Model.RowsDuplicate</div>
        <div class="col-md-2"><strong>@Localizer["Status:"]</strong> <span class="badge @(Model.Status == "Committed" ? "bg-success" : "bg-secondary")">@Model.Status</span></div>
    </div>

    @if (Model.Status == "Staged")
    {
        <div class="d-flex gap-2 mt-3">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                <pems-button tone="primary" type="submit" onclick="return confirm('Commit the selected rows into the live VDR register?')">
                    <i class="bi bi-check-circle"></i> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" onclick="return confirm('Discard this entire import batch?')">
                    <i class="bi bi-trash"></i> Discard Batch
                </pems-button>
            </form>
        </div>
    }
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Include"]</th><th>#</th><th>@Localizer["Document No"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Type"]</th>
                    <th>@Localizer["Discipline"]</th><th>@Localizer["Revisions"]</th><th>@Localizer["Validation"]</th><th>@Localizer["Message"]</th><th>@Localizer["Duplicate"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.ValidationStatus == "Error" ? "table-danger" : r.ValidationStatus == "Warning" ? "table-warning" : "")">
                        <td>
                            @if (Model.Status == "Staged")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.VDRImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <button type="submit" class="btn btn-sm @(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" style="width:36px;">
                                        <i class="bi @(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </td>
                        <td>@r.RowNumber</td>
                        <td>@r.DocumentNumber</td>
                        <td>@r.VendorNameRaw</td>
                        <td>@r.Payload?.DocumentTypeCode</td>
                        <td>@r.Payload?.DisciplineCodeRaw</td>
                        <td><pems-badge tone="neutral">@(r.Payload?.Submissions.Count ?? 0)</pems-badge></td>
                        <td>
                            @{
                                var vb = r.ValidationStatus switch { "Error" => "bg-danger", "Warning" => "bg-warning text-dark", _ => "bg-success" };
                            }
                            <span class="badge @vb">@r.ValidationStatus</span>
                        </td>
                        <td class="small text-muted">@r.ValidationMessage</td>
                        <td>@(r.IsDuplicate ? "Update existing" : "New")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

</div>

@{ ViewData["Title"] = Localizer["Vs_ImportTitle"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
