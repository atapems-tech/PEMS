@model PEMS.Application.DTOs.VDRImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-page-shell kind="workspace">


<div class="vs-stepper">
    <div class="vs-stepper__item vs-stepper__item--done"><span class="vs-stepper__num"><pems-icon name="bi-check-lg" /></span>@Localizer["Vs_StepUpload"]</div>
    <div class="vs-stepper__item vs-stepper__item--active"><span class="vs-stepper__num">2</span>@Localizer["Vs_StepReview"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">3</span>@Localizer["Vs_StepCommit"]</div>
</div>

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3"><strong>@Localizer["File:"]</strong> @Model.FileName</pems-col>
        <pems-col md="3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</pems-col>
        <pems-col md="2"><strong>@Localizer["Total:"]</strong> @Model.RowsTotal</pems-col>
        <pems-col md="2"><strong>@Localizer["Duplicates:"]</strong> @Model.RowsDuplicate</pems-col>
        <pems-col md="2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></pems-col>
    </pems-row>

    @if (Model.Status == "Staged")
    {
        <pems-flex gap="2" css="mt-3">
            <pems-form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                <pems-button tone="primary" type="submit" data-pems-confirm="Commit the selected rows into the live VDR register?">
                    <pems-icon name="bi-check-circle" /> Commit Selected Rows
                </pems-button>
            </pems-form>
            <pems-form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" data-pems-confirm="Discard this entire import batch?">
                    <pems-icon name="bi-trash" /> Discard Batch
                </pems-button>
            </pems-form>
        </pems-flex>
    }
</pems-content-card>

<pems-content-card>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["Include"]</pems-table-header><pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Document No"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header>
                    <pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Revisions"]</pems-table-header><pems-table-header>@Localizer["Validation"]</pems-table-header><pems-table-header>@Localizer["Message"]</pems-table-header><pems-table-header>@Localizer["Duplicate"]</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var r in Model.Rows)
                {
                    <pems-table-row class="@(r.ValidationStatus == "Error" ? "table-danger" : r.ValidationStatus == "Warning" ? "table-warning" : "")">
                        <pems-table-cell>
                            @if (Model.Status == "Staged")
                            {
                                <pems-form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.VDRImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.VDRImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <pems-button class="pems-w-36" tone="none" size="small" css="@(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" type="submit">
                                        <pems-icon css="@(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")" />
                                    </pems-button>
                                </pems-form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </pems-table-cell>
                        <pems-table-cell>@r.RowNumber</pems-table-cell>
                        <pems-table-cell>@r.DocumentNumber</pems-table-cell>
                        <pems-table-cell>@r.VendorNameRaw</pems-table-cell>
                        <pems-table-cell>@r.Payload?.DocumentTypeCode</pems-table-cell>
                        <pems-table-cell>@r.Payload?.DisciplineCodeRaw</pems-table-cell>
                        <pems-table-cell><pems-badge tone="neutral">@(r.Payload?.Submissions.Count ?? 0)</pems-badge></pems-table-cell>
                        <pems-table-cell>
                            @{
                                var vb = r.ValidationStatus switch { "Error" => "danger", "Warning" => "warning", _ => "success" };
                            }
                            <pems-badge tone="@vb">@r.ValidationStatus</pems-badge>
                        </pems-table-cell>
                        <pems-table-cell class="small text-muted">@r.ValidationMessage</pems-table-cell>
                        <pems-table-cell>@(r.IsDuplicate ? "Update existing" : "New")</pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    </pems-table-scroll>
</pems-content-card>

</pems-page-shell>

@{ ViewData["Title"] = Localizer["Vs_ImportTitle"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
