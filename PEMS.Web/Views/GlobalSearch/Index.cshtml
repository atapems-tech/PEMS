@model IReadOnlyList<PEMS.Web.Navigation.CommandPaletteGroup>
@using Microsoft.Extensions.Localization
@using PEMS.UI.Components
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* SCRUM-64: the same permission- and row-checked results as the command palette (CommandPaletteService). *@
@{
    var query = (string?)ViewBag.Query;
}

<pems-content-card css="mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2" role="search">
        <pems-input type="search" name="q" value="@query" placeholder="@Localizer["GlobalSearch_Placeholder"]" aria-label="@Localizer["GlobalSearch_Placeholder"]" minlength="2" autofocus />
        <pems-button tone="primary"><pems-icon name="bi-search" aria-hidden="true" /> @Localizer["Search"]</pems-button>
    </form>
    <p class="text-muted small mt-2 mb-0">@Localizer["GlobalSearch_PaletteHint"]</p>
</pems-content-card>

@if (!string.IsNullOrWhiteSpace(query))
{
    if (Model.Count == 0)
    {
        <partial name="_PemsState" model="@(new EmptyStateOptions { Title = Localizer["GlobalSearch_NoResults", query].Value, Icon = "bi-search" })" />
    }
    else
    {
        foreach (var g in Model)
        {
            <pems-content-card as="section" css="mb-3" aria-labelledby="gs-@g.Type">
                <h2 class="h6 mb-3" id="gs-@g.Type"><pems-icon css="@g.Icon" aria-hidden="true" /> @g.Title <pems-badge tone="neutral">@g.Total</pems-badge></h2>
                <ul class="list-unstyled mb-0">
                    @foreach (var item in g.Items)
                    {
                        <li class="mb-1 d-flex justify-content-between gap-3 border-bottom pb-1">
                            <a href="@item.Url">@item.Label</a>
                            <span class="text-muted small text-truncate">@item.Sub</span>
                        </li>
                    }
                </ul>
            </pems-content-card>
        }
    }
}
