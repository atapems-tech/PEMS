@model IReadOnlyList<PEMS.Web.Navigation.CommandPaletteGroup>
@using Microsoft.Extensions.Localization
@using PEMS.UI.Components
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* SCRUM-64: the same permission- and row-checked results as the command palette (CommandPaletteService). *@
@{
    var query = (string?)ViewBag.Query;
}

<div class="content-card mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2" role="search">
        <input type="search" name="q" value="@query" class="form-control" placeholder="@Localizer["GlobalSearch_Placeholder"]"
               aria-label="@Localizer["GlobalSearch_Placeholder"]" minlength="2" autofocus />
        <button class="btn btn-pems-solid"><i class="bi bi-search" aria-hidden="true"></i> @Localizer["Search"]</button>
    </form>
    <p class="text-muted small mt-2 mb-0">@Localizer["GlobalSearch_PaletteHint"]</p>
</div>

@if (!string.IsNullOrWhiteSpace(query))
{
    if (Model.Count == 0)
    {
        <partial name="_PemsState" model="@(new EmptyStateOptions { Title = Localizer["GlobalSearch_NoResults", query].Value, Icon = "bi-search" })" />
    }
    else
    {
        foreach (var g in Model)
        {
            <section class="content-card mb-3" aria-labelledby="gs-@g.Type">
                <h2 class="h6 mb-3" id="gs-@g.Type"><i class="bi @g.Icon" aria-hidden="true"></i> @g.Title <span class="badge bg-secondary">@g.Total</span></h2>
                <ul class="list-unstyled mb-0">
                    @foreach (var item in g.Items)
                    {
                        <li class="mb-1 d-flex justify-content-between gap-3 border-bottom pb-1">
                            <a href="@item.Url">@item.Label</a>
                            <span class="text-muted small text-truncate">@item.Sub</span>
                        </li>
                    }
                </ul>
            </section>
        }
    }
}
