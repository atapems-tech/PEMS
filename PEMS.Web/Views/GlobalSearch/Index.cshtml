@model PEMS.Web.Controllers.GlobalSearchResults
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="search" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search documents, equipment, vendors, letters, projects..." autofocus />
        <button class="btn btn-pems-solid"><i class="bi bi-search"></i> @Localizer["Search"]</button>
    </form>
</div>

@if (!string.IsNullOrEmpty((string?)ViewBag.Query))
{
    @if (Model.TotalCount == 0)
    {
        <div class="content-card"><p class="text-muted text-center py-4">No results for "@ViewBag.Query".</p></div>
    }
    else
    {
        var sections = new (string Title, string Icon, List<PEMS.Web.Controllers.GlobalSearchItem> Items, string Controller)[]
        {
            ("Permits", "bi-shield-check", Model.Permits, "Permit"),
            ("Work Orders", "bi-tools", Model.WorkOrders, "WorkOrder"),
            ("Projects", "bi-kanban", Model.Projects, "Projects"),
            ("Engineering Documents", "bi-file-earmark-text", Model.Documents, "EngineeringDocuments"),
            ("Vendor Documents (VDR)", "bi-journal-check", Model.VendorDocuments, "VDR"),
            ("Equipment", "bi-gear", Model.Equipment, "Equipment"),
            ("Vendors", "bi-building", Model.Vendors, "Vendor"),
            ("Correspondence", "bi-envelope-paper", Model.Letters, "Letter"),
            ("Help", "bi-life-preserver", Model.HelpArticles, "Help"),
        };

        foreach (var s in sections.Where(s => s.Items.Any()))
        {
            <div class="content-card mb-3">
                <h6 class="mb-3"><i class="bi @s.Icon"></i> @s.Title <span class="badge bg-secondary">@s.Items.Count</span></h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var item in s.Items)
                    {
                        <li class="mb-1 d-flex justify-content-between border-bottom pb-1">
                            @if (item.Url != null)
                            {
                                <a href="@item.Url">@item.Title</a>
                            }
                            else
                            {
                                <a asp-controller="@s.Controller" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                            }
                            <span class="text-muted small">@item.SubTitle</span>
                        </li>
                    }
                </ul>
            </div>
        }
    }
}
