@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.NotificationDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var filter = (string)(ViewBag.Filter ?? "all");
    var tabs = new[] { ("all", "Notif_All"), ("unread", "Notif_Unread"), ("read", "Notif_Read"), ("dismissed", "Notif_Dismissed") };
}

<div class="content-card">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <ul class="nav nav-pills">
            @foreach (var (key, label) in tabs)
            {
                <li class="nav-item"><a class="nav-link py-1 @(filter == key ? "active" : "")" asp-action="Index" asp-route-filter="@key">@Localizer[label]</a></li>
            }
        </ul>
        <div class="d-flex gap-2">
            <form asp-action="MarkAllRead" method="post"><pems-button tone="neutral" size="small" outline="true">@Localizer["Notif_MarkAllRead"]</pems-button></form>
            <form asp-action="DismissAll" method="post"><pems-button tone="neutral" size="small" outline="true">@Localizer["Notif_DismissAll"]</pems-button></form>
        </div>
    </div>

    <ul class="list-unstyled">
        @foreach (var n in Model.Items)
        {
            <li class="mb-2 p-2 border-bottom d-flex align-items-start gap-2 @(n.IsRead ? "" : "bg-light")">
                <a href="@Url.Action("Open", "Notification", new { id = n.NotificationId })" class="text-decoration-none flex-grow-1">
                    @if (!n.IsRead) { <i class="bi bi-circle-fill text-primary me-1" style="font-size:8px;" aria-hidden="true"></i> }
                    <strong>@n.Title</strong>
                    <div class="small text-muted">@n.Message</div>
                    <div class="small text-muted">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                </a>
                @if (!n.DismissedDate.HasValue)
                {
                    <form asp-action="Dismiss" asp-route-id="@n.NotificationId" method="post">
                        <button class="btn btn-sm btn-link text-muted" title="@Localizer["Notif_Dismiss"]" aria-label="@Localizer["Notif_Dismiss"]"><i class="bi bi-x-lg"></i></button>
                    </form>
                }
            </li>
        }
    </ul>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["Notif_Empty"]</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = $"filter={filter}"
    })
</div>
