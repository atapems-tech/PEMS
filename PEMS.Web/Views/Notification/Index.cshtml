@model List<PEMS.Application.DTOs.NotificationDto>

<div class="content-card">
    <div class="d-flex justify-content-between mb-3">
        <h6 class="mb-0">Notifications</h6>
        <form asp-action="MarkAllRead" method="post"><button class="btn btn-sm btn-outline-secondary">Mark all as read</button></form>
    </div>
    <ul class="list-unstyled">
        @foreach (var n in Model)
        {
            <li class="mb-2 p-2 border-bottom @(n.IsRead ? "" : "bg-light")">
                <a href="@n.LinkUrl" class="text-decoration-none">
                    <strong>@n.Title</strong>
                    <div class="small text-muted">@n.Message</div>
                    <div class="small text-muted">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                </a>
            </li>
        }
    </ul>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No notifications.</p> }
</div>
