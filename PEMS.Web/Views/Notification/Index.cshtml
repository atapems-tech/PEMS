@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.NotificationDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var filter = (string)(ViewBag.Filter ?? "all");
    var tabs = new[] { ("all", "Notif_All"), ("unread", "Notif_Unread"), ("read", "Notif_Read"), ("dismissed", "Notif_Dismissed") };
}

<pems-content-card>
    <pems-flex wrap="true" justify="between" align="center" gap="2" css="mb-3">
        <pems-nav kind="pills">
            @foreach (var (key, label) in tabs)
            {
                <pems-nav-link active="@(filter == key)" css="py-1" asp-action="Index" asp-route-filter="@key">@Localizer[label]</pems-nav-link>
            }
        </pems-nav>
        <pems-flex gap="2">
            <pems-form asp-action="MarkAllRead" method="post"><pems-button tone="neutral" size="small" outline="true">@Localizer["Notif_MarkAllRead"]</pems-button></pems-form>
            <pems-form asp-action="DismissAll" method="post"><pems-button tone="neutral" size="small" outline="true">@Localizer["Notif_DismissAll"]</pems-button></pems-form>
        </pems-flex>
    </pems-flex>

    <ul class="list-unstyled">
        @foreach (var n in Model.Items)
        {
            <pems-flex as="li" align="start" gap="2" css="mb-2 p-2 border-bottom @(n.IsRead ? "" : "bg-light")">
                <a href="@Url.Action("Open", "Notification", new { id = n.NotificationId })" class="text-decoration-none flex-grow-1">
                    @if (!n.IsRead) { <pems-icon name="bi-circle-fill" css="text-primary me-1 pems-s-3494e7ef" aria-hidden="true" /> }
                    <strong>@n.Title</strong>
                    <div class="small text-muted">@n.Message</div>
                    <div class="small text-muted">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                </a>
                @if (!n.DismissedDate.HasValue)
                {
                    <pems-form asp-action="Dismiss" asp-route-id="@n.NotificationId" method="post">
                        <pems-button tone="none" size="small" css="btn-link text-muted" title="@Localizer["Notif_Dismiss"]" aria-label="@Localizer["Notif_Dismiss"]"><pems-icon name="bi-x-lg" /></pems-button>
                    </pems-form>
                }
            </pems-flex>
        }
    </ul>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["Notif_Empty"]</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = $"filter={filter}"
    })
</pems-content-card>
