@model List<PEMS.Application.DTOs.NotificationDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@* شناسه‌ی Anti-forgery برای POSTهای AJAX (MarkRead/Dismiss/MarkAll) - همراه همین Partial بارگذاری می‌شود *@
<div id="notifAf" class="d-none">@Html.AntiForgeryToken()</div>

<div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
    <strong class="small">@Localizer["Notifications"]</strong>
    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-notif-action="markAll">@Localizer["Notif_MarkAllRead"]</button>
</div>

@if (Model.Any())
{
    foreach (var n in Model)
    {
        <div class="d-flex align-items-start border-bottom @(n.IsRead ? "" : "bg-light")" data-notif-id="@n.NotificationId">
            <a href="@Url.Action("Open", "Notification", new { id = n.NotificationId })" class="dropdown-item small py-2 flex-grow-1 text-wrap">
                @if (!n.IsRead) { <i class="bi bi-circle-fill text-primary me-1" style="font-size:8px;" aria-hidden="true"></i> }
                <strong>@n.Title</strong>
                <div class="text-muted">@n.Message</div>
                <div class="text-muted" style="font-size:11px;">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
            </a>
            <button type="button" class="btn btn-sm btn-link text-muted px-2 py-2" data-notif-action="dismiss" data-notif-id="@n.NotificationId"
                    title="@Localizer["Notif_Dismiss"]" aria-label="@Localizer["Notif_Dismiss"]"><i class="bi bi-x-lg"></i></button>
        </div>
    }
}
else
{
    <span class="dropdown-item small text-muted">@Localizer["Notif_NoNew"]</span>
}

<div class="text-center border-top py-2">
    <a asp-controller="Notification" asp-action="Index" class="small text-decoration-none">@Localizer["Notif_ViewAll"]</a>
</div>
