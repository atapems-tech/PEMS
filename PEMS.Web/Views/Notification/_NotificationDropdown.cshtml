@model List<PEMS.Application.DTOs.NotificationDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@* شناسه‌ی Anti-forgery برای POSTهای AJAX (MarkRead/Dismiss/MarkAll) - همراه همین Partial بارگذاری می‌شود *@
<div id="notifAf" class="d-none">@Html.AntiForgeryToken()</div>

<pems-flex justify="between" align="center" css="px-3 py-2 border-bottom">
    <strong class="small">@Localizer["Notifications"]</strong>
    <pems-button tone="none" size="small" css="btn-link p-0 text-decoration-none" type="button" data-notif-action="markAll">@Localizer["Notif_MarkAllRead"]</pems-button>
</pems-flex>

@if (Model.Any())
{
    foreach (var n in Model)
    {
        <pems-flex align="start" css="border-bottom @(n.IsRead ? "" : "bg-light")" data-notif-id="@n.NotificationId">
            <a href="@Url.Action("Open", "Notification", new { id = n.NotificationId })" class="dropdown-item small py-2 flex-grow-1 text-wrap">
                @if (!n.IsRead) { <pems-icon name="bi-circle-fill" css="text-primary me-1 pems-s-3494e7ef" aria-hidden="true" /> }
                <strong>@n.Title</strong>
                <div class="text-muted">@n.Message</div>
                <div class="text-muted pems-s-11a50812">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
            </a>
            <pems-button tone="none" size="small" css="btn-link text-muted px-2 py-2" type="button" data-notif-action="dismiss" data-notif-id="@n.NotificationId" title="@Localizer["Notif_Dismiss"]" aria-label="@Localizer["Notif_Dismiss"]"><pems-icon name="bi-x-lg" /></pems-button>
        </pems-flex>
    }
}
else
{
    <span class="dropdown-item small text-muted">@Localizer["Notif_NoNew"]</span>
}

<div class="text-center border-top py-2">
    <a asp-controller="Notification" asp-action="Index" class="small text-decoration-none">@Localizer["Notif_ViewAll"]</a>
</div>
