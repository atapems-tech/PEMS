@model PEMS.Application.DTOs.MaintenanceHistoryImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusBadge(string status) => status switch
    {
        "New" => "bg-success",
        "Duplicate" => "bg-warning text-dark",
        "UnresolvedEquipment" => "bg-danger",
        "ConflictEquipment" => "bg-danger",
        "ValidationError" => "bg-danger",
        _ => "bg-light text-dark"
    };

    string StatusLabel(string status) => status switch
    {
        "New" => "New record",
        "Duplicate" => "Duplicate (already exists)",
        "UnresolvedEquipment" => "Equipment not found",
        "ConflictEquipment" => "Duplicate Equipment match",
        "ValidationError" => "Validation error",
        _ => status
    };

    var statusFilter = (string?)ViewBag.StatusFilter;
    var filterOptions = new[] { "New", "Duplicate", "UnresolvedEquipment", "ConflictEquipment", "ValidationError" };
}

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>@Localizer["File:"]</strong> @Model.FileName</div>
        <div class="col-md-2"><strong>@Localizer["Total Rows:"]</strong> @Model.TotalRows</div>
        <div class="col-md-2"><strong>New:</strong> @Model.NewCount</div>
        <div class="col-md-2"><strong>Duplicate:</strong> @Model.DuplicateCount</div>
        <div class="col-md-1"><strong>@Localizer["Unresolved:"]</strong> @Model.UnresolvedCount</div>
        <div class="col-md-2"><strong>@Localizer["Status:"]</strong> <span class="badge @(Model.Status == "Committed" ? "bg-success" : "bg-secondary")">@Model.Status</span></div>
    </div>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.MaintenanceHistoryImportBatchId" />
                <button type="submit" class="btn btn-pems-solid" onclick="return confirm('Commit the approved rows? New Maintenance History records will be created.')">
                    <i class="bi bi-check-circle"></i> Commit Approved Rows
                </button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.MaintenanceHistoryImportBatchId" />
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Discard this entire import batch?')">
                    <i class="bi bi-trash"></i> Discard Batch
                </button>
            </form>
        </div>
    }
</div>

<div class="pems-filter-bar mb-3">
    <span class="pems-filter-label">@Localizer["Filter"]</span>
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-filter-active-count">1</span>
    }
    <a asp-action="Review" asp-route-batchId="@Model.MaintenanceHistoryImportBatchId"
       class="btn btn-sm @(statusFilter == null ? "btn-pems-solid" : "btn-outline-secondary")">All</a>
    @foreach (var s in filterOptions)
    {
        <a asp-action="Review" asp-route-batchId="@Model.MaintenanceHistoryImportBatchId" asp-route-status="@s"
           class="btn btn-sm @(statusFilter == s ? "btn-pems-solid" : "btn-outline-secondary")">@StatusLabel(s)</a>
    }
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-command-bar-spacer"></span>
        <a asp-action="Review" asp-route-batchId="@Model.MaintenanceHistoryImportBatchId" class="pems-filter-clear-all">Clear All</a>
    }
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Approve"]</th><th>@Localizer["Src Row"]</th><th>@Localizer["Equipment Tag"]</th><th>@Localizer["Equipment"]</th>
                    <th>@Localizer["Execution Date"]</th><th>@Localizer["Work Order"]</th><th>@Localizer["Action Taken"]</th><th>@Localizer["Match Result"]</th><th>@Localizer["Note"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows.Items)
                {
                    <tr>
                        <td>
                            @if (Model.Status == "Staging")
                            {
                                var canToggle = r.Status is "New" or "Duplicate";
                                if (canToggle)
                                {
                                    <form asp-action="ToggleRow" method="post">
                                        <input type="hidden" name="rowId" value="@r.MaintenanceHistoryImportRowId" />
                                        <input type="hidden" name="batchId" value="@Model.MaintenanceHistoryImportBatchId" />
                                        <input type="hidden" name="page" value="@Model.Rows.Page" />
                                        <input type="hidden" name="status" value="@statusFilter" />
                                        <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                        <button type="submit" class="btn btn-sm @(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" style="width:36px;"
                                                title="@(r.IncludeInCommit ? "Approved - click to exclude" : "Excluded - click to approve")">
                                            <i class="bi @(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            }
                            else
                            {
                                @(r.CommittedMaintenanceHistoryId.HasValue ? "Created" : (r.IncludeInCommit ? "Approved" : "No"))
                            }
                        </td>
                        <td>@r.SourceRowNumber</td>
                        <td><strong dir="ltr">@r.EquipmentTag</strong></td>
                        <td class="small">@(r.EquipmentDescription ?? "-")</td>
                        <td class="small" dir="ltr">@(r.ExecutionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="small" dir="ltr">@(r.WorkOrderNumber ?? "-")</td>
                        <td class="small">@(r.ActionTaken ?? "-")</td>
                        <td><span class="badge @StatusBadge(r.Status)">@StatusLabel(r.Status)</span></td>
                        <td class="small">
                            @if (r.ValidationMessage != null)
                            {
                                <span class="text-muted" style="white-space:normal;">@r.ValidationMessage</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Rows.Items.Any()) { <p class="text-muted text-center py-4">@Localizer["No rows match this filter."]</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty(statusFilter)) qsParts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        qsParts.Add($"batchId={Model.MaintenanceHistoryImportBatchId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Rows.Page,
        TotalPages = Model.Rows.TotalPages,
        TotalCount = Model.Rows.TotalCount,
        PageSize = Model.Rows.PageSize,
        GridKey = "MaintenanceHistoryImport",
        BaseUrl = Url.Action("Review") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>
