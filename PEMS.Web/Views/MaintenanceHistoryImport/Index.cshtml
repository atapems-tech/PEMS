@model List<PEMS.Application.DTOs.MaintenanceHistoryImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Equipment" asp-action="Index">@Localizer["← Equipment"]</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <p class="text-muted small">
        Upload an Excel file with <strong>@Localizer["Equipment Tag"]</strong> / <strong>@Localizer["Execution Date"]</strong> columns
        (optional <strong>Work Order Number</strong>, <strong>Finding</strong>, <strong>@Localizer["Action Taken"]</strong>,
        <strong>@Localizer["Technician"]</strong>, <strong>Duration Hours</strong>, <strong>@Localizer["Cost"]</strong>, <strong>@Localizer["Description"]</strong>).
        Records are append-only - nothing is written to the live Maintenance History table until you review the
        staged rows and click Commit. A row whose Equipment/Execution Date/Action/Technician combination already
        matches an existing record is flagged as a duplicate and is never committed twice.
    </p>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="8">
            <pems-label css="small">Maintenance History Excel File</pems-label>
            <pems-input type="file" name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="4">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["File"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Imported By"]</pems-table-header><pems-table-header class="text-end">@Localizer["Total"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["New"]</pems-table-header><pems-table-header class="text-end">@Localizer["Duplicate"]</pems-table-header>
                <pems-table-header class="text-end">@Localizer["Unresolved"]</pems-table-header><pems-table-header class="text-end">@Localizer["Conflicts"]</pems-table-header>
                <pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var b in Model)
            {
                <pems-table-row>
                    <pems-table-cell>@b.FileName</pems-table-cell>
                    <pems-table-cell>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell class="small">@b.ImportedByName</pems-table-cell>
                    <pems-table-cell class="text-end">@b.TotalRows</pems-table-cell>
                    <pems-table-cell class="text-end"><pems-badge tone="success">@b.NewCount</pems-badge></pems-table-cell>
                    <pems-table-cell class="text-end">@if (b.DuplicateCount > 0) { <pems-badge tone="warning">@b.DuplicateCount</pems-badge> } else { @b.DuplicateCount }</pems-table-cell>
                    <pems-table-cell class="text-end">@if (b.UnresolvedCount > 0) { <pems-badge tone="danger">@b.UnresolvedCount</pems-badge> } else { @b.UnresolvedCount }</pems-table-cell>
                    <pems-table-cell class="text-end">@if (b.ConflictCount > 0) { <pems-badge tone="danger">@b.ConflictCount</pems-badge> } else { @b.ConflictCount }</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(b.Status == "Committed" ? "success" : "neutral")">@b.Status</pems-badge></pems-table-cell>
                    <pems-table-cell>
                        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Review" asp-route-batchId="@b.MaintenanceHistoryImportBatchId">Review</pems-button>
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No Maintenance History import batches yet.</p> }
</pems-content-card>
