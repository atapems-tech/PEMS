@model List<PEMS.Application.DTOs.MaintenanceHistoryImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Equipment" asp-action="Index">@Localizer["← Equipment"]</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-text class="text-muted small">
        Upload an Excel file with <strong>@Localizer["Equipment Tag"]</strong> / <strong>@Localizer["Execution Date"]</strong> columns
        (optional <strong>Work Order Number</strong>, <strong>Finding</strong>, <strong>@Localizer["Action Taken"]</strong>,
        <strong>@Localizer["Technician"]</strong>, <strong>Duration Hours</strong>, <strong>@Localizer["Cost"]</strong>, <strong>@Localizer["Description"]</strong>).
        Records are append-only - nothing is written to the live Maintenance History table until you review the
        staged rows and click Commit. A row whose Equipment/Execution Date/Action/Technician combination already
        matches an existing record is flagged as a duplicate and is never committed twice.
    </pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="8">
            <pems-label css="small">Maintenance History Excel File</pems-label>
            <pems-input type="file" name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="4">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Recent Import Batches"]</pems-heading>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["File"])?.ToString() ?? ""), b => (object?)(b.FileName)).Add(((Localizer["Date"])?.ToString() ?? ""), b => (object?)((PemsDates.DateTime(b.ImportDate)))).Add(((Localizer["Imported By"])?.ToString() ?? ""), b => (object?)(b.ImportedByName), css: "small").Add(((Localizer["Total"])?.ToString() ?? ""), b => (object?)(b.TotalRows), css: "text-end", headerCss: "text-end").Add(((Localizer["New"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("success", b.NewCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Duplicate"])?.ToString() ?? ""), b => (object?)((b.DuplicateCount > 0 ? (object?)DataCell.Badge("warning", b.DuplicateCount) : b.DuplicateCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Unresolved"])?.ToString() ?? ""), b => (object?)((b.UnresolvedCount > 0 ? (object?)DataCell.Badge("danger", b.UnresolvedCount) : b.UnresolvedCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Conflicts"])?.ToString() ?? ""), b => (object?)((b.ConflictCount > 0 ? (object?)DataCell.Badge("danger", b.ConflictCount) : b.ConflictCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge(b.Status == "Committed" ? "success" : "neutral", b.Status))).Add("", b => (object?)(DataCell.ButtonLink(Url.Action("Review", null, new { batchId = b.MaintenanceHistoryImportBatchId }), "primary", "small", true, null, "Review")))))" />
    </pems-table-scroll>
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">No Maintenance History import batches yet.</pems-text> }
</pems-content-card>
