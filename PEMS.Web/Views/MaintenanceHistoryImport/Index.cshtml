@model List<PEMS.Application.DTOs.MaintenanceHistoryImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["← Equipment"]</a>
</div>

<div class="content-card mb-3">
    <p class="text-muted small">
        Upload an Excel file with <strong>@Localizer["Equipment Tag"]</strong> / <strong>@Localizer["Execution Date"]</strong> columns
        (optional <strong>Work Order Number</strong>, <strong>Finding</strong>, <strong>@Localizer["Action Taken"]</strong>,
        <strong>@Localizer["Technician"]</strong>, <strong>Duration Hours</strong>, <strong>@Localizer["Cost"]</strong>, <strong>@Localizer["Description"]</strong>).
        Records are append-only - nothing is written to the live Maintenance History table until you review the
        staged rows and click Commit. A row whose Equipment/Execution Date/Action/Technician combination already
        matches an existing record is flagged as a duplicate and is never committed twice.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small">Maintenance History Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-pems-solid w-100"><i class="bi bi-cloud-upload"></i> @Localizer["Upload"]</button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead>
            <tr>
                <th>@Localizer["File"]</th><th>@Localizer["Date"]</th><th>@Localizer["Imported By"]</th><th class="text-end">@Localizer["Total"]</th>
                <th class="text-end">@Localizer["New"]</th><th class="text-end">@Localizer["Duplicate"]</th>
                <th class="text-end">@Localizer["Unresolved"]</th><th class="text-end">@Localizer["Conflicts"]</th>
                <th>@Localizer["Status"]</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@b.ImportedByName</td>
                    <td class="text-end">@b.TotalRows</td>
                    <td class="text-end"><span class="badge bg-success">@b.NewCount</span></td>
                    <td class="text-end">@if (b.DuplicateCount > 0) { <span class="badge bg-warning text-dark">@b.DuplicateCount</span> } else { @b.DuplicateCount }</td>
                    <td class="text-end">@if (b.UnresolvedCount > 0) { <span class="badge bg-danger">@b.UnresolvedCount</span> } else { @b.UnresolvedCount }</td>
                    <td class="text-end">@if (b.ConflictCount > 0) { <span class="badge bg-danger">@b.ConflictCount</span> } else { @b.ConflictCount }</td>
                    <td><span class="badge @(b.Status == "Committed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                    <td>
                        <a asp-action="Review" asp-route-batchId="@b.MaintenanceHistoryImportBatchId" class="btn btn-sm btn-outline-primary">Review</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No Maintenance History import batches yet.</p> }
</div>
