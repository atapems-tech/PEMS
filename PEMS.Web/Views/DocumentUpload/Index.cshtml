@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<div class="content-card pems-s-bcaa1805">
    <p class="text-muted">
        فایل‌های PDF، Word، Excel یا عکس (اسکن) را انتخاب کنید. برخلاف قبل، آپلود دیگر خودکار
        یک مدرک مهندسی نمی‌سازد — هر فایل ابتدا وارد <strong>AI Intake Queue</strong> می‌شود:
        هوش مصنوعی نوع مدرک، دیسیپلین، Vendor و ماژول درست (MDR/VDR/...) را تشخیص می‌دهد و بر اساس
        میزان اطمینان، یا خودکار پردازش می‌کند یا برای بازبینی شما در صف می‌ماند.
    </p>

    <form asp-controller="DocumentUpload" asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-md-6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-12">
                <pems-label>Files</pems-label>
                <pems-input type="file" name="files" multiple accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png,.bmp,.tif,.tiff" required />
                <div class="form-text">Supported: PDF, Word (.docx), Excel (.xlsx), images/scans (OCR).</div>
            </div>
        </div>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">
                <i class="bi bi-cloud-upload"></i> Upload to AI Intake Queue
            </pems-button>
        </div>
    </form>
</div>
