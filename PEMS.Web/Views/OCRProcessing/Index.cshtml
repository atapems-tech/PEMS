@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.OCRProcessingAttachmentListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    string GetCount(string key) => counts.TryGetValue(key, out var c) ? c.ToString() : "0";
    var selected = (string?)ViewBag.SelectedStatus;
    var filterCount = string.IsNullOrEmpty(selected) ? 0 : 1;
    var statuses = new[] { "Pending", "Processing", "Completed", "Failed" };
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the status select became the status filter. The four count tiles stay above the list. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-row gap="3" css="mb-3">
        <pems-col md="3" sm="6">
            <pems-kpi-tile icon="bi-hourglass" color="slate" label="@Localizer["Pending"]">@GetCount("Pending")</pems-kpi-tile>
        </pems-col>
        <pems-col md="3" sm="6">
            <pems-kpi-tile icon="bi-arrow-repeat" color="blue" label="Processing">@GetCount("Processing")</pems-kpi-tile>
        </pems-col>
        <pems-col md="3" sm="6">
            <pems-kpi-tile icon="bi-check-circle" color="green" label="@Localizer["Completed"]">@GetCount("Completed")</pems-kpi-tile>
        </pems-col>
        <pems-col md="3" sm="6">
            <pems-kpi-tile icon="bi-x-circle" color="red" label="Failed">@GetCount("Failed")</pems-kpi-tile>
        </pems-col>
    </pems-row>

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["OCR Processing"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="ocrFilter" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="ocrStatus" name="status" label="@Localizer["Status"]" value="@selected"
                                             all-text="@Localizer["All statuses"]" items="@statuses.Select(s => new SelectListItem(s, s))" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="OCRProcessing" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(selected)) { <pems-list-chip label="@Localizer["Status"]" value="@selected" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="OCRProcessing" empty="@(!Model.Items.Any())" empty-text="No files uploaded yet."
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header data-col-key="file">@Localizer["File"]</pems-table-header>
                        <pems-table-header data-col-key="document">@Localizer["Document"]</pems-table-header>
                        <pems-table-header data-col-key="type">@Localizer["Type"]</pems-table-header>
                        <pems-table-header data-col-key="size">@Localizer["Size"]</pems-table-header>
                        <pems-table-header data-col-key="status">@Localizer["Status"]</pems-table-header>
                        <pems-table-header data-col-key="summary">Summary / Error</pems-table-header>
                        <pems-table-header data-col-key="uploaded">@Localizer["Uploaded"]</pems-table-header>
                        <pems-table-header data-col-key="actions"></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var a in Model.Items)
                    {
                        var tone = a.AIStatus switch { "Completed" => "success", "Processing" => "info", "Failed" => "danger", _ => "neutral" };
                        <pems-table-row class="lp-row">
                            <pems-table-cell>@a.FileName</pems-table-cell>
                            <pems-table-cell>@a.DocumentNo</pems-table-cell>
                            <pems-table-cell>@a.FileExtension</pems-table-cell>
                            <pems-table-cell>@(a.FileSize / 1024) KB</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@tone">@a.AIStatus</pems-badge></pems-table-cell>
                            <pems-table-cell class="small text-muted pems-s-55585d51">
                                @(a.AIStatus == "Failed" ? a.AIError : a.AISummary)
                            </pems-table-cell>
                            <pems-table-cell>@a.UploadDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                            <pems-table-cell>
                                <form asp-action="Retry" asp-route-id="@a.AttachmentId" method="post" class="d-inline">
                                    <pems-button tone="neutral" size="small" outline="true"><pems-icon name="bi-arrow-repeat" /></pems-button>
                                </form>
                                @if (a.AIStatus == "Completed")
                                {
                                    <pems-button tone="warning" size="small" outline="true" as="a" asp-controller="AIExtraction" asp-action="Review" asp-route-attachmentId="@a.AttachmentId"><pems-icon name="bi-eye" /></pems-button>
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "OCRProcessing",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.IsNullOrEmpty(selected) ? "" : $"status={Uri.EscapeDataString(selected)}"
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
