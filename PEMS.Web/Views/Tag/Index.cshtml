@model List<PEMS.Application.DTOs.TagDto>

<div class="content-card mb-3">
    <h6 class="mb-3">Create Tag</h6>
    <form asp-action="Create" method="post" class="row g-2">
        <input type="hidden" name="returnUrl" value="/Tag" />
        <div class="col-md-4"><input name="name" class="form-control form-control-sm" placeholder="Tag name" required /></div>
        <div class="col-md-3">
            <select name="color" class="form-select form-select-sm">
                @foreach (var c in new[] { "secondary", "primary", "success", "danger", "warning", "info", "dark" })
                { <option value="@c">@c</option> }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100">Create</button></div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">All Tags</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Tag</th><th>Used on</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><span class="badge bg-@t.Color">@t.Name</span></td>
                    <td>@t.LetterCount letter(s)</td>
                    <td>
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this tag?')">
                            <input type="hidden" name="tagId" value="@t.TagId" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No tags yet.</p> }
</div>
