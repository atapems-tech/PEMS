@model List<PEMS.Application.DTOs.TagDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The create form moved into a modal opened by "New tag";
   the tag colour stays the colour the user chose (a Bootstrap colour name), so the badge keeps it. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Tg_Title"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new modal="createTagModal" text="@Localizer["Tg_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(!Model.Any())" empty-text="@Localizer["Tg_Empty"]">
                <thead>
                    <tr>
                        <th>@Localizer["Tg_Tag"]</th>
                        <th>@Localizer["Tg_UsedOn"]</th>
                        <th style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr class="lp-row">
                            <td><span class="badge bg-@t.Color">@t.Name</span></td>
                            <td class="small">@string.Format(Localizer["Tg_LetterCount"].Value, t.LetterCount)</td>
                            <td class="lp-actions">
                                <form asp-action="Delete" method="post" class="d-inline" data-confirm="@Localizer["Tg_DeleteConfirm"]" onsubmit="return confirm(this.dataset.confirm)">
                                    <input type="hidden" name="tagId" value="@t.TagId" />
                                    <button type="submit" class="lp-act lp-act--always" title="@Localizer["Delete"]" aria-label="@Localizer["Delete"]"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createTagModal" tabindex="-1" aria-labelledby="createTagTitle">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <input type="hidden" name="returnUrl" value="/Tag" />
            <div class="modal-header"><h6 class="modal-title" id="createTagTitle">@Localizer["Tg_New"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small" for="tagName">@Localizer["Tg_Name"]</label>
                    <input name="name" id="tagName" class="form-control form-control-sm" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="tagColor">@Localizer["Tg_Color"]</label>
                    <select name="color" id="tagColor" class="form-select form-select-sm">
                        @foreach (var c in new[] { "secondary", "primary", "success", "danger", "warning", "info", "dark" })
                        { <option value="@c">@c</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Create"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
