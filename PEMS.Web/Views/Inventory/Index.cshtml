@{
    var lowStockItems = (List<PEMS.Application.DTOs.MaterialStockRowDto>)ViewBag.LowStockItems;
    var recentTransactions = (List<PEMS.Domain.Entities.InventoryTransaction>)ViewBag.RecentTransactions;
}

<div class="row g-3 mb-3">
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold">@ViewBag.TotalMaterialItems</div><div class="text-muted small">Total Materials</div></div></div>
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold">@ViewBag.StockItems</div><div class="text-muted small">Stock Items</div></div></div>
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold text-warning">@ViewBag.CriticalItems</div><div class="text-muted small">Critical</div></div></div>
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold text-danger">@ViewBag.OutOfStockCount</div><div class="text-muted small">Out of Stock</div></div></div>
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold">@ViewBag.TotalWarehouses</div><div class="text-muted small">Warehouses</div></div></div>
    <div class="col-md-2"><div class="content-card text-center"><div class="fs-3 fw-bold">@ViewBag.ActiveReservations</div><div class="text-muted small">Active Reservations</div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="content-card">
            <a asp-controller="MaterialItem" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mb-2"><i class="bi bi-box-seam"></i> Material Master</a>
            <a asp-controller="InventoryMasterData" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-diagram-3"></i> Master Data</a>
            <a asp-controller="InventoryTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-list-ul"></i> Transaction Ledger</a>
            <a asp-controller="StoreRequisition" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-clipboard-check"></i> Store Requisitions</a>
            <a asp-controller="MrsImport" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100"><i class="bi bi-file-earmark-excel"></i> MRS Import</a>
        </div>
    </div>
    <div class="col-md-8">
        <div class="content-card">
            <h6 class="mb-3"><i class="bi bi-exclamation-triangle text-danger"></i> Low Stock</h6>
            <table class="table table-enterprise table-sm">
                <thead><tr><th>Warehouse</th><th>On Hand</th><th>Available</th><th>Reorder Point</th></tr></thead>
                <tbody>
                    @foreach (var s in lowStockItems)
                    {
                        <tr>
                            <td>@s.WarehouseCode</td>
                            <td>@s.OnHandQuantity</td>
                            <td class="text-danger">@s.AvailableQuantity</td>
                            <td>@s.ReorderPoint</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!lowStockItems.Any()) { <p class="text-muted text-center py-3">فعلاً موجودی کمی ثبت نشده.</p> }
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-3">Recent Transactions</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th>Date</th><th>Material</th><th>Type</th><th>Warehouse</th><th>Qty</th><th>Reference</th></tr></thead>
        <tbody>
            @foreach (var t in recentTransactions)
            {
                <tr>
                    <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@t.MaterialItem?.MaterialCode</td>
                    <td><span class="badge bg-light text-dark border">@t.TransactionType</span></td>
                    <td>@t.Warehouse?.Code</td>
                    <td>@t.Quantity</td>
                    <td class="small">@t.ReferenceType</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!recentTransactions.Any()) { <p class="text-muted text-center py-3">هنوز تراکنشی ثبت نشده.</p> }
</div>
