@model PEMS.Application.DTOs.JobPlanDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var allSkills = (IEnumerable<dynamic>)ViewBag.AllSkills;
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var equipmentClasses = (IEnumerable<dynamic>)ViewBag.EquipmentClasses;
    var nextTaskNumber = Model.Tasks.Any() ? ((Model.Tasks.Max(t => t.TaskNumber) / 10 + 1) * 10) : 10;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="3" wrap="true" css="mb-2">
        <div class="kpi-icon bg-icon-blue pems-s-792bd2d6"><pems-icon name="bi-list-check" /></div>
        <div>
            <h5 class="mb-0">@Model.JobPlanNumber &mdash; @Model.Title</h5>
            <span class="text-muted small">@(Model.EstimatedDurationHours.HasValue ? Model.EstimatedDurationHours + " hours estimated" : "no duration estimate")</span>
        </div>
        <pems-button tone="neutral" size="small" outline="true" css="ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#editJobPlanModal"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</pems-button>
    </pems-flex>
    <pems-info-grid class="mt-2">
        <pems-info-item label="@Localizer["Scope"]">@Model.Scope</pems-info-item>
        <pems-info-item label="@Localizer["Safety Requirements"]">@Model.SafetyRequirements</pems-info-item>
        <pems-info-item label="@Localizer["Equipment Class"]">@Model.EquipmentClassName</pems-info-item>
        <pems-info-item label="@Localizer["Info_SafetyControls"]">
            <pems-badge tone="@(Model.PermitRequired ? "warning" : "light")">Permit @(Model.PermitRequired ? "Required" : "Not Required")</pems-badge>
            <pems-badge tone="@(Model.LOTORequired ? "warning" : "light")">LOTO @(Model.LOTORequired ? "Required" : "Not Required")</pems-badge>
        </pems-info-item>
    </pems-info-grid>
</pems-content-card>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

@* SCRUM-337 RelatedList: tasks of the job plan *@
<pems-related-list id="jpTasks" icon="bi-list-ol" title="@Localizer["JpD_Tasks"]" count="@Model.Tasks.Count" empty="@(!Model.Tasks.Any())" empty-text="@Localizer["هنوز Task ای ثبت نشده."]">
    @if (Model.Tasks.Any())
    {
        <pems-related-table>
            <thead><tr><th class="pems-w-70">#</th><th>@Localizer["Title"]</th><th>@Localizer["Description"]</th><th class="pems-w-90">@Localizer["JpD_EstMin"]</th><th class="pems-w-50"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tasks)
                {
                    <tr>
                        <td><span class="vs-num">@t.TaskNumber</span></td>
                        <td>@t.Title</td>
                        <td class="text-muted">@t.Description</td>
                        <td><span class="vs-num">@t.EstimatedDurationMinutes</span></td>
                        <td class="text-end">
                            <pems-related-remove action="@Url.Action("RemoveTask")" key-name="maintenanceTaskId" key-value="@t.MaintenanceTaskId.ToString()"
                                                 parent-name="jobPlanId" parent-value="@Model.JobPlanId.ToString()" label="@Localizer["حذف"]" />
                        </td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
    }
    <pems-related-add action="@Url.Action("AddTask")" parent-name="jobPlanId" parent-value="@Model.JobPlanId.ToString()" submit-label="@Localizer["Add"]">
        <div class="pems-s-4c35a544"><label class="lp-lbl" for="jpTaskNo">#</label><pems-input scale="small" id="jpTaskNo" name="taskNumber" type="number" step="10" value="@nextTaskNumber" required /></div>
        <div><label class="lp-lbl" for="jpTaskTitle">@Localizer["Title"]</label><pems-input scale="small" id="jpTaskTitle" name="title" placeholder="Isolate equipment" required /></div>
        <div><label class="lp-lbl" for="jpTaskDesc">@Localizer["Description"]</label><pems-input scale="small" id="jpTaskDesc" name="description" placeholder="@Localizer["Description (optional)"]" /></div>
        <div class="pems-s-09277c18"><label class="lp-lbl" for="jpTaskMin">@Localizer["JpD_EstMin"]</label><pems-input scale="small" id="jpTaskMin" name="estimatedDurationMinutes" type="number" /></div>
    </pems-related-add>
</pems-related-list>
<pems-content-card css="mb-3">
    <h6 class="mb-3"><pems-icon name="bi-mortarboard" /> @Localizer["Required Skills"]</h6>
    <pems-flex wrap="true" gap="2" css="mb-3">
        @foreach (var rs in Model.RequiredSkills)
        {
            <pems-badge tone="neutral" css="d-flex align-items-center gap-1">
                @rs.SkillName @(string.IsNullOrWhiteSpace(rs.MinimumProficiencyLevel) ? "" : $"({rs.MinimumProficiencyLevel}+)")
                @(rs.PlannedHours.HasValue ? $"[{rs.PlannedHours}h]" : "")
                <form asp-action="RemoveRequiredSkill" method="post" class="d-inline">
                    <input type="hidden" name="jobPlanRequiredSkillId" value="@rs.JobPlanRequiredSkillId" />
                    <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
                    <pems-button class="lh-1" tone="none" size="small" css="p-0 border-0 text-white" type="submit" title="@Localizer["حذف"]"><pems-icon name="bi-x" /></pems-button>
                </form>
            </pems-badge>
        }
    </pems-flex>
    @if (!Model.RequiredSkills.Any()) { <p class="text-muted small">@Localizer["مهارت موردنیازی ثبت نشده."]</p> }

    <form asp-action="AddRequiredSkill" method="post"><pems-row gap="2">
        <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
        <pems-col md="4">
            <pems-select scale="small" name="skillId" required>
                @foreach (var s in allSkills) { <option value="@s.SkillId">@s.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-select scale="small" name="minimumProficiencyLevel">
                <option value="">@Localizer["حداقل سطح (اختیاری)"]</option>
                <option value="Basic">@Localizer["Basic"]</option>
                <option value="Intermediate">@Localizer["Intermediate"]</option>
                <option value="Advanced">@Localizer["Advanced"]</option>
                <option value="Expert">@Localizer["Expert"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-input scale="small" name="plannedHours" type="number" step="0.5" placeholder="@Localizer["Planned h"]" /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
    </pems-row></form>
</pems-content-card>

@* SCRUM-337 RelatedList: materials the job plan needs *@
<pems-related-list id="jpMaterials" icon="bi-box-seam" title="@Localizer["Required Materials"]" count="@Model.RequiredMaterials.Count" empty="@(!Model.RequiredMaterials.Any())" empty-text="@Localizer["متریال موردنیازی ثبت نشده."]">
    @if (Model.RequiredMaterials.Any())
    {
        <pems-related-table>
            <thead><tr><th>@Localizer["Material"]</th><th class="pems-w-130">@Localizer["Required Qty"]</th><th class="pems-w-50"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var rm in Model.RequiredMaterials)
                {
                    <tr>
                        <td><span class="vs-num">@rm.MaterialCode</span> - @rm.MaterialDescription</td>
                        <td><span class="vs-num">@rm.RequiredQuantity</span></td>
                        <td class="text-end">
                            <pems-related-remove action="@Url.Action("RemoveRequiredMaterial")" key-name="jobPlanRequiredMaterialId" key-value="@rm.JobPlanRequiredMaterialId.ToString()"
                                                 parent-name="jobPlanId" parent-value="@Model.JobPlanId.ToString()" label="@Localizer["حذف"]" />
                        </td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
    }
    <pems-related-add action="@Url.Action("AddRequiredMaterial")" parent-name="jobPlanId" parent-value="@Model.JobPlanId.ToString()" submit-label="@Localizer["Add"]">
        <pems-list-filter-select id="jpMaterial" name="materialItemId" label="@Localizer["Material"]" items="@materialItems.Select(m => new SelectListItem($"{m.MaterialCode} - {m.Description}", ((int)m.MaterialItemId).ToString()))" />
        <div class="pems-s-929aba04"><label class="lp-lbl" for="jpMaterialQty">@Localizer["Quantity"]</label><pems-input scale="small" id="jpMaterialQty" name="requiredQuantity" type="number" step="0.001" required /></div>
    </pems-related-add>
</pems-related-list>

<pems-modal id="editJobPlanModal" tabindex="-1">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
            <div class="modal-header"><h6 class="modal-title">Edit Job Plan</h6></div>
            <div class="modal-body">
                <div class="mb-2"><pems-label css="small">@Localizer["Title"]</pems-label><pems-input scale="small" name="title" value="@Model.Title" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["Scope"]</pems-label><pems-textarea scale="small" name="scope" rows="2">@Model.Scope</pems-textarea></div>
                <div class="mb-2"><pems-label css="small">@Localizer["Estimated Duration (hours)"]</pems-label><pems-input scale="small" name="estimatedDurationHours" type="number" step="0.1" value="@Model.EstimatedDurationHours" /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["Safety Requirements"]</pems-label><pems-textarea scale="small" name="safetyRequirements" rows="2">@Model.SafetyRequirements</pems-textarea></div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Equipment Class"]</pems-label>
                    <pems-select scale="small" name="equipmentClassId">
                        <option value="">@Localizer["Not linked..."]</option>
                        @foreach (var ec in equipmentClasses)
                        {
                            <option value="@ec.EquipmentClassId" selected="@(Model.EquipmentClassId == (int)ec.EquipmentClassId)">@ec.Name (@ec.Code)</option>
                        }
                    </pems-select>
                </div>
                <div class="form-check">
                    <pems-input type="checkbox" name="permitRequired" value="true" id="editPermitRequired" checked="@Model.PermitRequired" kind="check" />
                    <label class="form-check-label small" for="editPermitRequired">@Localizer["Permit Required for execution"]</label>
                </div>
                <div class="form-check">
                    <pems-input type="checkbox" name="lotoRequired" value="true" id="editLotoRequired" checked="@Model.LOTORequired" kind="check" />
                    <label class="form-check-label small" for="editLotoRequired">@Localizer["LOTO (Isolation) Required for execution"]</label>
                </div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
            </div>
        </form>
    </pems-modal>
