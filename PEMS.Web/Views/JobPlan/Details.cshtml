@model PEMS.Application.DTOs.JobPlanDetailDto
@{
    var allSkills = (IEnumerable<dynamic>)ViewBag.AllSkills;
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var equipmentClasses = (IEnumerable<dynamic>)ViewBag.EquipmentClasses;
    var nextTaskNumber = Model.Tasks.Any() ? ((Model.Tasks.Max(t => t.TaskNumber) / 10 + 1) * 10) : 10;
}

<div class="content-card mb-3">
    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
        <div class="kpi-icon bg-icon-blue" style="width:56px;height:56px;font-size:26px;"><i class="bi bi-list-check"></i></div>
        <div>
            <h5 class="mb-0">@Model.JobPlanNumber &mdash; @Model.Title</h5>
            <span class="text-muted small">@(Model.EstimatedDurationHours.HasValue ? Model.EstimatedDurationHours + " hours estimated" : "no duration estimate")</span>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-bs-toggle="modal" data-bs-target="#editJobPlanModal"><i class="bi bi-pencil"></i> Edit</button>
    </div>
    <div class="row g-2 small mt-1">
        <div class="col-md-6"><strong>Scope:</strong> @(Model.Scope ?? "N/A")</div>
        <div class="col-md-6"><strong>Safety Requirements:</strong> @(Model.SafetyRequirements ?? "N/A")</div>
        <div class="col-md-6"><strong>Equipment Class:</strong> @(Model.EquipmentClassName ?? "N/A")</div>
        <div class="col-md-6">
            <strong>Safety Controls:</strong>
            <span class="badge @(Model.PermitRequired ? "text-bg-warning" : "text-bg-light border")">Permit @(Model.PermitRequired ? "Required" : "Not Required")</span>
            <span class="badge @(Model.LOTORequired ? "text-bg-warning" : "text-bg-light border")">LOTO @(Model.LOTORequired ? "Required" : "Not Required")</span>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-list-ol"></i> Tasks (execution steps)</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th style="width:70px;">#</th><th>Title</th><th>Description</th><th>Est. Min</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model.Tasks)
            {
                <tr>
                    <td class="small fw-bold">@t.TaskNumber</td>
                    <td class="small">@t.Title</td>
                    <td class="small text-muted">@t.Description</td>
                    <td class="small">@t.EstimatedDurationMinutes</td>
                    <td class="text-end">
                        <form asp-action="RemoveTask" method="post" class="d-inline">
                            <input type="hidden" name="maintenanceTaskId" value="@t.MaintenanceTaskId" />
                            <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-x"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Tasks.Any()) { <p class="text-muted small">هنوز Task ای ثبت نشده.</p> }

    <form asp-action="AddTask" method="post" class="row g-2">
        <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
        <div class="col-md-2"><input name="taskNumber" type="number" step="10" class="form-control form-control-sm" value="@nextTaskNumber" required /></div>
        <div class="col-md-3"><input name="title" class="form-control form-control-sm" placeholder="Isolate equipment" required /></div>
        <div class="col-md-4"><input name="description" class="form-control form-control-sm" placeholder="Description (optional)" /></div>
        <div class="col-md-2"><input name="estimatedDurationMinutes" type="number" class="form-control form-control-sm" placeholder="Min" /></div>
        <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i></button></div>
    </form>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-mortarboard"></i> Required Skills</h6>
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var rs in Model.RequiredSkills)
        {
            <span class="badge bg-secondary d-flex align-items-center gap-1">
                @rs.SkillName @(string.IsNullOrWhiteSpace(rs.MinimumProficiencyLevel) ? "" : $"({rs.MinimumProficiencyLevel}+)")
                @(rs.PlannedHours.HasValue ? $"[{rs.PlannedHours}h]" : "")
                <form asp-action="RemoveRequiredSkill" method="post" class="d-inline">
                    <input type="hidden" name="jobPlanRequiredSkillId" value="@rs.JobPlanRequiredSkillId" />
                    <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
                    <button type="submit" class="btn btn-sm p-0 border-0 text-white" style="line-height:1;" title="حذف"><i class="bi bi-x"></i></button>
                </form>
            </span>
        }
    </div>
    @if (!Model.RequiredSkills.Any()) { <p class="text-muted small">مهارت موردنیازی ثبت نشده.</p> }

    <form asp-action="AddRequiredSkill" method="post" class="row g-2">
        <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
        <div class="col-md-4">
            <select name="skillId" class="form-select form-select-sm" required>
                @foreach (var s in allSkills) { <option value="@s.SkillId">@s.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="minimumProficiencyLevel" class="form-select form-select-sm">
                <option value="">حداقل سطح (اختیاری)</option>
                <option value="Basic">Basic</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
                <option value="Expert">Expert</option>
            </select>
        </div>
        <div class="col-md-2"><input name="plannedHours" type="number" step="0.5" class="form-control form-control-sm" placeholder="Planned h" /></div>
        <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> Add</button></div>
    </form>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-box-seam"></i> Required Materials</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th>Material</th><th>Required Qty</th><th></th></tr></thead>
        <tbody>
            @foreach (var rm in Model.RequiredMaterials)
            {
                <tr>
                    <td class="small">@rm.MaterialCode - @rm.MaterialDescription</td>
                    <td>@rm.RequiredQuantity</td>
                    <td class="text-end">
                        <form asp-action="RemoveRequiredMaterial" method="post" class="d-inline">
                            <input type="hidden" name="jobPlanRequiredMaterialId" value="@rm.JobPlanRequiredMaterialId" />
                            <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-x"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.RequiredMaterials.Any()) { <p class="text-muted small">متریال موردنیازی ثبت نشده.</p> }

    <form asp-action="AddRequiredMaterial" method="post" class="row g-2">
        <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
        <div class="col-md-6">
            <select name="materialItemId" class="form-select form-select-sm" required>
                @foreach (var m in materialItems) { <option value="@m.MaterialItemId">@m.MaterialCode - @m.Description</option> }
            </select>
        </div>
        <div class="col-md-3"><input name="requiredQuantity" type="number" step="0.001" class="form-control form-control-sm" placeholder="Quantity" required /></div>
        <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> Add</button></div>
    </form>
</div>

<div class="modal fade" id="editJobPlanModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="jobPlanId" value="@Model.JobPlanId" />
            <div class="modal-header"><h6 class="modal-title">Edit Job Plan</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">Title</label><input name="title" class="form-control form-control-sm" value="@Model.Title" required /></div>
                <div class="mb-2"><label class="form-label small">Scope</label><textarea name="scope" class="form-control form-control-sm" rows="2">@Model.Scope</textarea></div>
                <div class="mb-2"><label class="form-label small">Estimated Duration (hours)</label><input name="estimatedDurationHours" type="number" step="0.1" class="form-control form-control-sm" value="@Model.EstimatedDurationHours" /></div>
                <div class="mb-2"><label class="form-label small">Safety Requirements</label><textarea name="safetyRequirements" class="form-control form-control-sm" rows="2">@Model.SafetyRequirements</textarea></div>
                <div class="mb-2">
                    <label class="form-label small">Equipment Class</label>
                    <select name="equipmentClassId" class="form-select form-select-sm">
                        <option value="">Not linked...</option>
                        @foreach (var ec in equipmentClasses)
                        {
                            <option value="@ec.EquipmentClassId" selected="@(Model.EquipmentClassId == (int)ec.EquipmentClassId)">@ec.Name (@ec.Code)</option>
                        }
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="permitRequired" value="true" class="form-check-input" id="editPermitRequired" checked="@Model.PermitRequired" />
                    <label class="form-check-label small" for="editPermitRequired">Permit Required for execution</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="lotoRequired" value="true" class="form-check-input" id="editLotoRequired" checked="@Model.LOTORequired" />
                    <label class="form-check-label small" for="editLotoRequired">LOTO (Isolation) Required for execution</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">Save</button>
            </div>
        </form>
    </div></div>
</div>
