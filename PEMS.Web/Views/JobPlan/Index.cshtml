@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.JobPlanListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentClasses = (IEnumerable<dynamic>)ViewBag.EquipmentClasses;
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createJobPlanModal">
        <i class="bi bi-plus-lg"></i> @Localizer["New Job Plan"]
    </button>
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 بند ۱۰.۳: دستورالعمل اجرای قابل استفاده‌ی مجدد - یک بار
    ساخته می‌شود، توسط چند Maintenance Plan استفاده می‌شود.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('JobPlan')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="JobPlan">
        <thead>
            <tr>
                <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Number"]</th>
                <th data-col-key="title" data-resizable="true" data-min-width="160" data-max-width="400">@Localizer["Title"]</th>
                <th data-col-key="duration" data-resizable="true" data-min-width="100" data-max-width="160">Est. Duration</th>
                <th data-col-key="tasks" data-resizable="true" data-min-width="70" data-max-width="120">@Localizer["Tasks"]</th>
                <th data-col-key="usage" data-resizable="true" data-min-width="90" data-max-width="150">Used by Plans</th>
                <th data-col-key="safety" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Safety"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jp in Model.Items)
            {
                <tr>
                    <td class="small fw-bold">@jp.JobPlanNumber</td>
                    <td class="small">@jp.Title</td>
                    <td class="small">@(jp.EstimatedDurationHours.HasValue ? jp.EstimatedDurationHours + " h" : "-")</td>
                    <td class="small">@jp.TaskCount</td>
                    <td class="small">@jp.PlanUsageCount</td>
                    <td class="small">
                        @if (jp.PermitRequired) { <span class="badge text-bg-warning">@Localizer["Permit"]</span> }
                        @if (jp.LOTORequired) { <span class="badge text-bg-warning">LOTO</span> }
                        @if (!jp.PermitRequired && !jp.LOTORequired) { <span class="text-muted">-</span> }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@jp.JobPlanId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هنوز Job Plan ای ثبت نشده."]</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "JobPlan",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

<div class="modal fade" id="createJobPlanModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["New Job Plan"]</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">@Localizer["Title"]</label><input name="title" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Scope"]</label><textarea name="scope" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Estimated Duration (hours)"]</label><input name="estimatedDurationHours" type="number" step="0.1" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Safety Requirements"]</label><textarea name="safetyRequirements" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Equipment Class"]</label>
                    <select name="equipmentClassId" class="form-select form-select-sm">
                        <option value="">@Localizer["Not linked..."]</option>
                        @foreach (var ec in equipmentClasses)
                        {
                            <option value="@ec.EquipmentClassId">@ec.Name (@ec.Code)</option>
                        }
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="permitRequired" value="true" class="form-check-input" id="createPermitRequired" />
                    <label class="form-check-label small" for="createPermitRequired">@Localizer["Permit Required for execution"]</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="lotoRequired" value="true" class="form-check-input" id="createLotoRequired" />
                    <label class="form-check-label small" for="createLotoRequired">@Localizer["LOTO (Isolation) Required for execution"]</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Create"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('JobPlan');
        });
    </script>
}
