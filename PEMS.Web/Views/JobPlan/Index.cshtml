@model List<PEMS.Application.DTOs.JobPlanListDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-list-check"></i> Job Plans</h5>
    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createJobPlanModal">
        <i class="bi bi-plus-lg"></i> New Job Plan
    </button>
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 بند ۱۰.۳: دستورالعمل اجرای قابل استفاده‌ی مجدد - یک بار
    ساخته می‌شود، توسط چند Maintenance Plan استفاده می‌شود.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead><tr><th>Number</th><th>Title</th><th>Est. Duration</th><th>Tasks</th><th>Used by Plans</th><th></th></tr></thead>
        <tbody>
            @foreach (var jp in Model)
            {
                <tr>
                    <td class="small fw-bold">@jp.JobPlanNumber</td>
                    <td class="small">@jp.Title</td>
                    <td class="small">@(jp.EstimatedDurationHours.HasValue ? jp.EstimatedDurationHours + " h" : "-")</td>
                    <td class="small">@jp.TaskCount</td>
                    <td class="small">@jp.PlanUsageCount</td>
                    <td><a asp-action="Details" asp-route-id="@jp.JobPlanId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز Job Plan ای ثبت نشده.</p> }
</div>

<div class="modal fade" id="createJobPlanModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">New Job Plan</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">Title</label><input name="title" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">Scope</label><textarea name="scope" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2"><label class="form-label small">Estimated Duration (hours)</label><input name="estimatedDurationHours" type="number" step="0.1" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">Safety Requirements</label><textarea name="safetyRequirements" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">Create</button>
            </div>
        </form>
    </div></div>
</div>
