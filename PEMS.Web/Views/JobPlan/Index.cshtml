@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.JobPlanListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentClasses = (IEnumerable<dynamic>)ViewBag.EquipmentClasses;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The page note (a job plan is written once and used by many
   maintenance plans) became the tool tip of the title; "New job plan" still opens the create modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Jp_Title"]" heading-title="@Localizer["Jp_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="JobPlan" />
                <pems-list-new modal="createJobPlanModal" text="@Localizer["Jp_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="JobPlan" empty="@(!Model.Items.Any())" empty-text="@Localizer["Jp_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Jp_Number"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="160" data-max-width="400" style="width:280px">@Localizer["Cm_Title"]</th>
                        <th data-col-key="duration" data-resizable="true" data-min-width="100" data-max-width="160" style="width:120px">@Localizer["Jp_Duration"]</th>
                        <th data-col-key="tasks" data-resizable="true" data-min-width="70" data-max-width="120" style="width:90px">@Localizer["Jp_Tasks"]</th>
                        <th data-col-key="usage" data-resizable="true" data-min-width="90" data-max-width="150" style="width:120px" class="vs-hide-md">@Localizer["Jp_UsedByPlans"]</th>
                        <th data-col-key="safety" data-resizable="true" data-min-width="100" data-max-width="180" style="width:140px">@Localizer["Jp_Safety"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jp in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@jp.JobPlanId" class="lp-subject" title="@jp.JobPlanNumber">@jp.JobPlanNumber</a></td>
                            <td><span class="vs-title-cell" title="@jp.Title">@jp.Title</span></td>
                            <td class="small"><span class="vs-num">@(jp.EstimatedDurationHours.HasValue ? string.Format(Localizer["Jp_Hours"].Value, jp.EstimatedDurationHours) : "-")</span></td>
                            <td class="small"><span class="vs-num">@jp.TaskCount</span></td>
                            <td class="small vs-hide-md"><span class="vs-num">@jp.PlanUsageCount</span></td>
                            <td class="small">
                                @if (jp.PermitRequired) { <span class="vs-pill vs-pill--warning">@Localizer["Jp_Permit"]</span> }
                                @if (jp.LOTORequired) { <span class="vs-pill vs-pill--warning">@Localizer["Jp_Loto"]</span> }
                                @if (!jp.PermitRequired && !jp.LOTORequired) { <span class="text-muted">-</span> }
                            </td>
                            <td class="lp-actions">
                                <a asp-action="Details" asp-route-id="@jp.JobPlanId" class="lp-act lp-act--always" title="@Localizer["Lp_Details"]" aria-label="@Localizer["Lp_Details"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "JobPlan",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createJobPlanModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["Jp_New"]</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">@Localizer["Title"]</label><input name="title" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Scope"]</label><textarea name="scope" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Estimated Duration (hours)"]</label><input name="estimatedDurationHours" type="number" step="0.1" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">@Localizer["Safety Requirements"]</label><textarea name="safetyRequirements" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Equipment Class"]</label>
                    <select name="equipmentClassId" class="form-select form-select-sm">
                        <option value="">@Localizer["Not linked..."]</option>
                        @foreach (var ec in equipmentClasses)
                        {
                            <option value="@ec.EquipmentClassId">@ec.Name (@ec.Code)</option>
                        }
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="permitRequired" value="true" class="form-check-input" id="createPermitRequired" />
                    <label class="form-check-label small" for="createPermitRequired">@Localizer["Permit Required for execution"]</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="lotoRequired" value="true" class="form-check-input" id="createLotoRequired" />
                    <label class="form-check-label small" for="createLotoRequired">@Localizer["LOTO (Isolation) Required for execution"]</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Create"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
