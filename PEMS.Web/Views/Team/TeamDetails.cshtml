@model PEMS.Application.DTOs.OrganizationTeamNodeDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS Dynamic Maintenance Organization — Phase 6B»: تمام جهش‌ها (Create/Move/
    // Deactivate/Assign/Remove/Move) فقط از طریق IOrganizationStructureService انجام می‌شوند
    // (بند ۱). این View مستقیم به EF Core دسترسی ندارد - فقط داده‌ی از پیش خوانده‌شده‌ی
    // Controller (GetTeamDetailsAsync/GetOrganizationTreeAsync) را نمایش می‌دهد.
    //
    // تصمیم معماری آگاهانه (بند ۲۵ سند): "Leadership" یک مفهوم مجزا در Schema نیست - سرگروه/
    // معاون فقط Position های معمولی روی همین تیم‌اند (بند ۵ سند). حدس‌زدن این‌که کدام Position
    // «رهبری» است از روی متن Title، یک قاعده‌ی کسب‌وکاری اختراعی می‌بود؛ به‌جایش سرگروه/معاون در
    // همان جدول «سمت‌ها و نیروی انسانی» زیر - مثل هر Position دیگر - دیده می‌شوند.
    var allEmployees = (IEnumerable<dynamic>)ViewBag.Employees;
    var allTeamNodes = (IEnumerable<dynamic>)ViewBag.AllTeamNodes;
    var vacantPositions = (IEnumerable<dynamic>)ViewBag.VacantPositions;

    var historyRows = Model.Positions
        .SelectMany(p => p.History.Select(h => new { Position = p, Assignment = h }))
        .OrderByDescending(x => x.Assignment.StartDate)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-team-details.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="OrganizationChart" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-diagram-3"></i> @Localizer["نمودار سازمانی"]
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-people"></i> @Localizer["تیم‌های تعمیرونگهداری"]
        </a>
        @if (Model.ParentTeamId.HasValue)
        {
            <a asp-action="TeamDetails" asp-route-teamId="@Model.ParentTeamId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "bar-right" : "bar-left")"></i>
                @Localizer["تیم والد"]
            </a>
        }
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (!Model.IsActive)
        {
            <span class="badge text-bg-secondary">@Localizer["غیرفعال"]</span>
        }
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addChildNodeModal">
            <i class="bi bi-diagram-2"></i> @Localizer["افزودن زیرتیم/شیفت"]
        </button>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#addPositionModal">
            <i class="bi bi-plus-lg"></i> @Localizer["افزودن سمت"]
        </button>
    </div>
</div>

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Model.Name</h5>
            <div class="text-muted small">
                <code>@Model.Code</code> &middot; @Model.NodeKind
                @if (!string.IsNullOrEmpty(Model.DisciplineName))
                {
                    <span> &middot; @Localizer["دیسیپلین"]: @Model.DisciplineName</span>
                }
                @if (!string.IsNullOrEmpty(Model.SupervisorName))
                {
                    <span> &middot; @Localizer["سرپرست"]: @Model.SupervisorName</span>
                }
            </div>
        </div>
        @if (Model.IsActive)
        {
            <form asp-action="DeactivateTeamNode" method="post" onsubmit="return confirm('@Localizer["این گره غیرفعال شود؟ زیرگروه‌ها/سمت‌ها دست‌نخورده می‌مانند."]');">
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <input type="hidden" name="returnTeamId" value="@(Model.ParentTeamId?.ToString() ?? "")" />
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> @Localizer["غیرفعال کردن این گره"]</button>
            </form>
        }
    </div>

    <div class="pems-team-summary">
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.PositionCount</div>
            <div class="pems-team-summary-label">@Localizer["سمت‌ها"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@(Model.PositionCount - Model.VacantPositionCount)</div>
            <div class="pems-team-summary-label">@Localizer["اشغال‌شده"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value pems-vacant-badge">@Model.VacantPositionCount</div>
            <div class="pems-team-summary-label">@Localizer["خالی (Vacant)"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.MemberCount</div>
            <div class="pems-team-summary-label">@Localizer["اعضا"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.Children.Count</div>
            <div class="pems-team-summary-label">@Localizer["زیرگره‌ها"]</div>
        </div>
    </div>
</div>

@* ========================= Organizational Units (child Team nodes / shifts) ========================= *@
<div class="content-card mb-3">
    <h6 class="fw-bold mb-3">@Localizer["واحدهای سازمانی (زیرتیم/شیفت)"]</h6>
    @if (!Model.Children.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["این گره هیچ زیرمجموعه‌ای (شیفت/زیرتیم) ندارد."]</p>
    }
    else
    {
        <div class="row g-2">
            @foreach (var child in Model.Children.OrderBy(c => c.Name))
            {
                <div class="col-md-4 col-lg-3">
                    <div class="pems-unit-card" data-inactive="@(!child.IsActive ? "true" : "false")">
                        <div class="pems-unit-kind">@child.NodeKind</div>
                        <div class="fw-semibold">@child.Name</div>
                        <div class="small text-muted">
                            @Localizer["سمت‌ها"]: @child.PositionCount
                            @if (child.VacantPositionCount > 0)
                            {
                                <span class="pems-vacant-badge"> (@child.VacantPositionCount @Localizer["خالی (Vacant)"])</span>
                            }
                        </div>
                        <a asp-action="TeamDetails" asp-route-teamId="@child.TeamId" class="btn btn-sm btn-outline-secondary mt-2 w-100">
                            @Localizer["مشاهده‌ی جزئیات تیم"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ========================= Positions & Workforce ========================= *@
<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h6 class="fw-bold mb-0">@Localizer["سمت‌ها و نیروی انسانی"]</h6>
        @if (Model.Positions.Any())
        {
            @* طبق «Phase 6C» بند ۸: فیلتر سمت‌شمار سمت کلاینت روی همان داده‌ی از پیش رندرشده -
               بدون درخواست تازه به سرور، بدون فیلد وضعیت تکراری (فقط IsActive/IsVacant موجود). *@
            <div class="btn-group btn-group-sm" role="group" id="positionStatusFilter" aria-label="@Localizer["فیلتر وضعیت سمت"]">
                <button type="button" class="btn btn-outline-secondary active" data-filter="all">@Localizer["همه"]</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="occupied">@Localizer["اشغال‌شده"]</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="vacant">@Localizer["خالی (Vacant)"]</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="inactive">@Localizer["غیرفعال"]</button>
            </div>
        }
    </div>
    @if (!Model.Positions.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز سمتی برای این تیم تعریف نشده."]</p>
    }
    else
    {
        <table class="table table-enterprise pems-responsive-table">
            <thead>
                <tr>
                    <th>@Localizer["سمت"]</th>
                    <th>@Localizer["کارمند"]</th>
                    <th>@Localizer["وضعیت"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="positionsTableBody">
                @foreach (var p in Model.Positions.OrderBy(x => x.SortOrder).ThenBy(x => x.Title))
                {
                    var status = !p.IsActive ? "inactive" : (p.IsVacant ? "vacant" : "occupied");
                    <tr data-status="@status">
                        <td data-label="@Localizer["سمت"]">
                            @p.Title
                        </td>
                        <td data-label="@Localizer["کارمند"]">
                            @if (p.IsVacant)
                            {
                                <span class="pems-vacant-badge"><i class="bi bi-person-dash"></i> @Localizer["خالی (Vacant)"]</span>
                            }
                            else
                            {
                                <span><i class="bi bi-person-check"></i> @p.CurrentAssignment!.EmployeeName</span>
                            }
                        </td>
                        <td data-label="@Localizer["وضعیت"]">
                            @if (p.IsActive)
                            {
                                <span class="badge text-bg-success"><i class="bi bi-check-circle"></i> @Localizer["فعال"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary"><i class="bi bi-dash-circle"></i> @Localizer["غیرفعال"]</span>
                            }
                        </td>
                        <td class="text-end pems-actions-cell">
                            @* طبق بند ۱۷ سند: یک منوی کشویی واحد به‌جای ردیفی از دکمه‌های پراکنده -
                               همان الگوی Bootstrap dropdown موجود در _Layout (تم/زبان). *@
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["عملیات"]
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editPositionModal"
                                           data-position-id="@p.PositionId" data-position-title="@p.Title"
                                           data-position-description="@p.Description" data-position-sortorder="@p.SortOrder">
                                            <i class="bi bi-pencil"></i> @Localizer["ویرایش"]
                                        </a>
                                    </li>
                                    @if (p.IsActive && p.IsVacant)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#assignEmployeeModal"
                                               data-position-id="@p.PositionId" data-position-title="@p.Title">
                                                <i class="bi bi-person-plus"></i> @Localizer["تخصیص کارمند"]
                                            </a>
                                        </li>
                                    }
                                    @if (!p.IsVacant)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#moveEmployeeModal"
                                               data-position-id="@p.PositionId" data-position-title="@p.Title"
                                               data-employee-name="@p.CurrentAssignment!.EmployeeName">
                                                <i class="bi bi-arrow-left-right"></i> @Localizer["جابه‌جایی کارمند"]
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#movePositionModal"
                                           data-position-id="@p.PositionId" data-position-title="@p.Title">
                                            <i class="bi bi-diagram-2"></i> @Localizer["جابه‌جایی سمت"]
                                        </a>
                                    </li>
                                    @if (!p.IsVacant)
                                    {
                                        <li>
                                            <form asp-action="RemoveAssignment" method="post"
                                                  onsubmit="return confirm('@Localizer["این عملیات فقط تخصیص کارمند به این سمت را پایان می‌دهد؛ خودِ کارمند حذف نمی‌شود و سمت خالی (Vacant) باقی می‌ماند."]');">
                                                <input type="hidden" name="positionId" value="@p.PositionId" />
                                                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-person-dash"></i> @Localizer["پایان تخصیص"]</button>
                                            </form>
                                        </li>
                                    }
                                    @if (p.IsActive)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-action="DeactivatePosition" method="post"
                                                  onsubmit="return confirm('@(p.IsVacant ? Localizer["این سمت خالی غیرفعال شود؟"] : Localizer["این سمت اشغال شده است؛ غیرفعال‌کردن آن، تخصیص کارمند فعلی را هم پایان می‌دهد و سمت خالی خواهد شد. ادامه می‌دهید؟"])');">
                                                <input type="hidden" name="positionId" value="@p.PositionId" />
                                                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle"></i> @Localizer["غیرفعال کردن"]</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="text-muted text-center py-3 mb-0" id="positionsFilterEmpty" hidden>@Localizer["هیچ سمتی با این فیلتر یافت نشد."]</p>
    }
</div>

@* ========================= Assignment History ========================= *@
<div class="content-card">
    <h6 class="fw-bold mb-3">@Localizer["تاریخچه‌ی تخصیص"]</h6>
    @if (!historyRows.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز تخصیصی برای سمت‌های این تیم ثبت نشده."]</p>
    }
    else
    {
        <table class="table table-enterprise pems-responsive-table">
            <thead>
                <tr>
                    <th>@Localizer["سمت"]</th>
                    <th>@Localizer["کارمند"]</th>
                    <th>@Localizer["تاریخ شروع"]</th>
                    <th>@Localizer["تاریخ پایان"]</th>
                    <th>@Localizer["وضعیت"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in historyRows)
                {
                    <tr>
                        <td data-label="@Localizer["سمت"]">@row.Position.Title</td>
                        <td data-label="@Localizer["کارمند"]">@row.Assignment.EmployeeName</td>
                        <td data-label="@Localizer["تاریخ شروع"]">@row.Assignment.StartDate.ToString("yyyy-MM-dd")</td>
                        <td data-label="@Localizer["تاریخ پایان"]">@(row.Assignment.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td data-label="@Localizer["وضعیت"]">
                            @if (row.Assignment.IsActive)
                            {
                                <span class="badge text-bg-success"><i class="bi bi-play-circle"></i> @Localizer["جاری"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary"><i class="bi bi-check2"></i> @Localizer["پایان‌یافته"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* ========================= Modals ========================= *@

<div class="modal fade" id="addPositionModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreatePosition" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["افزودن سمت"]</h6></div>
            <div class="modal-body">
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <label class="form-label small">@Localizer["عنوان سمت"]</label>
                    <input name="title" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً سرگروه، تکنسین ارشد..."]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["توضیحات (اختیاری)"]</label>
                    <input name="description" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["ترتیب نمایش"]</label>
                    <input name="sortOrder" type="number" value="0" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ساخت"]</button>
            </div>
        </form>
    </div></div>
</div>

@* طبق بند ۷ سند (Edit Position): ویرایش افزایشی همان فیلدهای پشتیبانی‌شده - عنوان/توضیحات/ترتیب. *@
<div class="modal fade" id="editPositionModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="UpdatePosition" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["ویرایش سمت"]</h6></div>
            <div class="modal-body">
                <input type="hidden" name="positionId" id="editPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <label class="form-label small">@Localizer["عنوان سمت"]</label>
                    <input name="title" id="editPositionTitle" class="form-control form-control-sm" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["توضیحات (اختیاری)"]</label>
                    <input name="description" id="editPositionDescription" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["ترتیب نمایش"]</label>
                    <input name="sortOrder" id="editPositionSortOrder" type="number" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ذخیره"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="addChildNodeModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateSubTeam" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["افزودن زیرتیم/شیفت"]</h6></div>
            <div class="modal-body">
                <input type="hidden" name="maintenanceGroupId" value="@Model.MaintenanceGroupId" />
                <input type="hidden" name="parentTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <label class="form-label small">@Localizer["نوع گره"]</label>
                    <select name="nodeKind" class="form-select form-select-sm">
                        <option value="SubTeam">SubTeam</option>
                        <option value="Shift">Shift</option>
                        <option value="Unit">Unit</option>
                        <option value="Team">Team</option>
                    </select>
                    <div class="form-text">@Localizer["نمونه‌های رایج - می‌توانید در کد بعداً هر نام دیگری هم بسازید."]</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["کد"]</label>
                    <input name="code" class="form-control form-control-sm" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["نام"]</label>
                    <input name="name" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً Shift A"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["سرپرست (اختیاری)"]</label>
                    <input type="search" class="form-control form-control-sm mb-1 pems-employee-search" data-target="#childNodeSupervisorSelect" placeholder="@Localizer["جستجوی کارمند..."]" />
                    <select name="supervisorEmployeeId" id="childNodeSupervisorSelect" class="form-select form-select-sm" size="1">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var e in allEmployees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ساخت"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="assignEmployeeModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="AssignEmployeeToPosition" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["تخصیص کارمند"] — <span id="assignPositionTitle"></span></h6></div>
            <div class="modal-body">
                <input type="hidden" name="positionId" id="assignPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <label class="form-label small">@Localizer["کارمند"]</label>
                    <input type="search" class="form-control form-control-sm mb-1 pems-employee-search" data-target="#assignEmployeeSelect" placeholder="@Localizer["جستجوی کارمند..."]" />
                    <select name="employeeId" id="assignEmployeeSelect" class="form-select form-select-sm" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in allEmployees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["توضیحات (اختیاری)"]</label>
                    <input name="notes" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["تخصیص"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="moveEmployeeModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="MoveEmployeeBetweenPositions" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["جابه‌جایی کارمند"] — <span id="moveEmployeeFromTitle"></span></h6></div>
            <div class="modal-body">
                <input type="hidden" name="fromPositionId" id="moveEmployeeFromPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <p class="small text-muted" id="moveEmployeeCurrentOccupant"></p>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["سمت مقصد (خالی)"]</label>
                    <select name="toPositionId" class="form-select form-select-sm" required>
                        <option value="">@Localizer["سمت مقصد..."]</option>
                        @foreach (var vp in vacantPositions) { <option value="@vp.PositionId">@vp.Label</option> }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["توضیحات (اختیاری)"]</label>
                    <input name="notes" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["جابه‌جایی"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="movePositionModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="MovePosition" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["جابه‌جایی سمت"] — <span id="movePositionTitle"></span></h6></div>
            <div class="modal-body">
                <input type="hidden" name="positionId" id="movePositionPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <label class="form-label small">@Localizer["تیم مقصد"]</label>
                    <select name="newTeamId" class="form-select form-select-sm" required>
                        @foreach (var t in allTeamNodes) { <option value="@t.TeamId">@t.Name (@t.NodeKind)</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["جابه‌جایی"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script src="~/js/pems-team-details.js" asp-append-version="true"></script>
}
