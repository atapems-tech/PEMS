@model PEMS.Application.DTOs.OrganizationTeamNodeDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS Dynamic Maintenance Organization — Phase 6B»: تمام جهش‌ها (Create/Move/
    // Deactivate/Assign/Remove/Move) فقط از طریق IOrganizationStructureService انجام می‌شوند
    // (بند ۱). این View مستقیم به EF Core دسترسی ندارد - فقط داده‌ی از پیش خوانده‌شده‌ی
    // Controller (GetTeamDetailsAsync/GetOrganizationTreeAsync) را نمایش می‌دهد.
    //
    // تصمیم معماری آگاهانه (بند ۲۵ سند): "Leadership" یک مفهوم مجزا در Schema نیست - سرگروه/
    // معاون فقط Position های معمولی روی همین تیم‌اند (بند ۵ سند). حدس‌زدن این‌که کدام Position
    // «رهبری» است از روی متن Title، یک قاعده‌ی کسب‌وکاری اختراعی می‌بود؛ به‌جایش سرگروه/معاون در
    // همان جدول «سمت‌ها و نیروی انسانی» زیر - مثل هر Position دیگر - دیده می‌شوند.
    var allEmployees = (IEnumerable<dynamic>)ViewBag.Employees;
    var allTeamNodes = (IEnumerable<dynamic>)ViewBag.AllTeamNodes;
    var vacantPositions = (IEnumerable<dynamic>)ViewBag.VacantPositions;

    var historyRows = Model.Positions
        .SelectMany(p => p.History.Select(h => new { Position = p, Assignment = h }))
        .OrderByDescending(x => x.Assignment.StartDate)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-team-details.css" asp-append-version="true" />
}

<pems-flex justify="between" align="center" wrap="true" gap="2" css="mb-3">
    <pems-flex align="center" gap="2" wrap="true">
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="OrganizationChart">
            <pems-icon name="bi-diagram-3" /> @Localizer["نمودار سازمانی"]
        </pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">
            <pems-icon name="bi-people" /> @Localizer["تیم‌های تعمیرونگهداری"]
        </pems-button>
        @if (Model.ParentTeamId.HasValue)
        {
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="TeamDetails" asp-route-teamId="@Model.ParentTeamId">
                <pems-icon name="bi-arrow-@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "bar-right" : "bar-left")" />
                @Localizer["تیم والد"]
            </pems-button>
        }
    </pems-flex>

    <pems-flex align="center" gap="2" wrap="true">
        @if (!Model.IsActive)
        {
            <pems-badge tone="neutral">@Localizer["غیرفعال"]</pems-badge>
        }
        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addChildNodeModal">
            <pems-icon name="bi-diagram-2" /> @Localizer["افزودن زیرتیم/شیفت"]
        </pems-button>
        <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#addPositionModal">
            <pems-icon name="bi-plus-lg" /> @Localizer["افزودن سمت"]
        </pems-button>
    </pems-flex>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">@Model.Name</h5>
            <div class="text-muted small">
                <code>@Model.Code</code> &middot; @Model.NodeKind
                @if (!string.IsNullOrEmpty(Model.DisciplineName))
                {
                    <span> &middot; @Localizer["دیسیپلین"]: @Model.DisciplineName</span>
                }
                @if (!string.IsNullOrEmpty(Model.SupervisorName))
                {
                    <span> &middot; @Localizer["سرپرست"]: @Model.SupervisorName</span>
                }
            </div>
        </div>
        @if (Model.IsActive)
        {
            <form asp-action="DeactivateTeamNode" method="post" data-pems-confirm="@Localizer["این گره غیرفعال شود؟ زیرگروه‌ها/سمت‌ها دست‌نخورده می‌مانند."]">
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <input type="hidden" name="returnTeamId" value="@(Model.ParentTeamId?.ToString() ?? "")" />
                <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-x-circle" /> @Localizer["غیرفعال کردن این گره"]</pems-button>
            </form>
        }
    </pems-flex>

    <div class="pems-team-summary">
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.PositionCount</div>
            <div class="pems-team-summary-label">@Localizer["سمت‌ها"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@(Model.PositionCount - Model.VacantPositionCount)</div>
            <div class="pems-team-summary-label">@Localizer["اشغال‌شده"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value pems-vacant-badge">@Model.VacantPositionCount</div>
            <div class="pems-team-summary-label">@Localizer["خالی (Vacant)"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.MemberCount</div>
            <div class="pems-team-summary-label">@Localizer["اعضا"]</div>
        </div>
        <div class="pems-team-summary-item">
            <div class="pems-team-summary-value">@Model.Children.Count</div>
            <div class="pems-team-summary-label">@Localizer["زیرگره‌ها"]</div>
        </div>
    </div>
</pems-content-card>

@* ========================= Organizational Units (child Team nodes / shifts) ========================= *@
<pems-content-card css="mb-3">
    <h6 class="fw-bold mb-3">@Localizer["واحدهای سازمانی (زیرتیم/شیفت)"]</h6>
    @if (!Model.Children.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["این گره هیچ زیرمجموعه‌ای (شیفت/زیرتیم) ندارد."]</p>
    }
    else
    {
        <pems-row gap="2">
            @foreach (var child in Model.Children.OrderBy(c => c.Name))
            {
                <pems-col md="4" lg="3">
                    <div class="pems-unit-card" data-inactive="@(!child.IsActive ? "true" : "false")">
                        <div class="pems-unit-kind">@child.NodeKind</div>
                        <div class="fw-semibold">@child.Name</div>
                        <div class="small text-muted">
                            @Localizer["سمت‌ها"]: @child.PositionCount
                            @if (child.VacantPositionCount > 0)
                            {
                                <span class="pems-vacant-badge"> (@child.VacantPositionCount @Localizer["خالی (Vacant)"])</span>
                            }
                        </div>
                        <pems-button tone="neutral" size="small" outline="true" css="mt-2 w-100" as="a" asp-action="TeamDetails" asp-route-teamId="@child.TeamId">
                            @Localizer["مشاهده‌ی جزئیات تیم"]
                        </pems-button>
                    </div>
                </pems-col>
            }
        </pems-row>
    }
</pems-content-card>

@* ========================= Positions & Workforce ========================= *@
<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2" css="mb-3">
        <h6 class="fw-bold mb-0">@Localizer["سمت‌ها و نیروی انسانی"]</h6>
        @if (Model.Positions.Any())
        {
            @* طبق «Phase 6C» بند ۸: فیلتر سمت‌شمار سمت کلاینت روی همان داده‌ی از پیش رندرشده -
               بدون درخواست تازه به سرور، بدون فیلد وضعیت تکراری (فقط IsActive/IsVacant موجود). *@
            <div class="btn-group btn-group-sm" role="group" id="positionStatusFilter" aria-label="@Localizer["فیلتر وضعیت سمت"]">
                <pems-button tone="neutral" outline="true" css="active" type="button" data-filter="all">@Localizer["همه"]</pems-button>
                <pems-button tone="neutral" outline="true" type="button" data-filter="occupied">@Localizer["اشغال‌شده"]</pems-button>
                <pems-button tone="neutral" outline="true" type="button" data-filter="vacant">@Localizer["خالی (Vacant)"]</pems-button>
                <pems-button tone="neutral" outline="true" type="button" data-filter="inactive">@Localizer["غیرفعال"]</pems-button>
            </div>
        }
    </pems-flex>
    @if (!Model.Positions.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز سمتی برای این تیم تعریف نشده."]</p>
    }
    else
    {
        <pems-table kind="enterprise" css="pems-responsive-table">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["سمت"]</pems-table-header>
                    <pems-table-header>@Localizer["کارمند"]</pems-table-header>
                    <pems-table-header>@Localizer["وضعیت"]</pems-table-header>
                    <pems-table-header></pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body id="positionsTableBody">
                @foreach (var p in Model.Positions.OrderBy(x => x.SortOrder).ThenBy(x => x.Title))
                {
                    var status = !p.IsActive ? "inactive" : (p.IsVacant ? "vacant" : "occupied");
                    <pems-table-row data-status="@status">
                        <pems-table-cell data-label="@Localizer["سمت"]">
                            @p.Title
                        </pems-table-cell>
                        <pems-table-cell data-label="@Localizer["کارمند"]">
                            @if (p.IsVacant)
                            {
                                <span class="pems-vacant-badge"><pems-icon name="bi-person-dash" /> @Localizer["خالی (Vacant)"]</span>
                            }
                            else
                            {
                                <span><pems-icon name="bi-person-check" /> @p.CurrentAssignment!.EmployeeName</span>
                            }
                        </pems-table-cell>
                        <pems-table-cell data-label="@Localizer["وضعیت"]">
                            @if (p.IsActive)
                            {
                                <pems-badge tone="success"><pems-icon name="bi-check-circle" /> @Localizer["فعال"]</pems-badge>
                            }
                            else
                            {
                                <pems-badge tone="neutral"><pems-icon name="bi-dash-circle" /> @Localizer["غیرفعال"]</pems-badge>
                            }
                        </pems-table-cell>
                        <pems-table-cell class="text-end pems-actions-cell">
                            @* طبق بند ۱۷ سند: یک منوی کشویی واحد به‌جای ردیفی از دکمه‌های پراکنده -
                               همان الگوی Bootstrap dropdown موجود در _Layout (تم/زبان). *@
                            <div class="dropdown">
                                <pems-button tone="neutral" size="small" outline="true" css="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["عملیات"]
                                </pems-button>
                                <pems-dropdown-menu end="true">
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#editPositionModal"
                                           data-position-id="@p.PositionId" data-position-title="@p.Title"
                                           data-position-description="@p.Description" data-position-sortorder="@p.SortOrder">
                                            <pems-icon name="bi-pencil" /> @Localizer["ویرایش"]
                                        </a>
                                    </li>
                                    @if (p.IsActive && p.IsVacant)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#assignEmployeeModal"
                                               data-position-id="@p.PositionId" data-position-title="@p.Title">
                                                <pems-icon name="bi-person-plus" /> @Localizer["تخصیص کارمند"]
                                            </a>
                                        </li>
                                    }
                                    @if (!p.IsVacant)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#moveEmployeeModal"
                                               data-position-id="@p.PositionId" data-position-title="@p.Title"
                                               data-employee-name="@p.CurrentAssignment!.EmployeeName">
                                                <pems-icon name="bi-arrow-left-right" /> @Localizer["جابه‌جایی کارمند"]
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#movePositionModal"
                                           data-position-id="@p.PositionId" data-position-title="@p.Title">
                                            <pems-icon name="bi-diagram-2" /> @Localizer["جابه‌جایی سمت"]
                                        </a>
                                    </li>
                                    @if (!p.IsVacant)
                                    {
                                        <li>
                                            <form asp-action="RemoveAssignment" method="post"
                                                  data-pems-confirm="@Localizer["این عملیات فقط تخصیص کارمند به این سمت را پایان می‌دهد؛ خودِ کارمند حذف نمی‌شود و سمت خالی (Vacant) باقی می‌ماند."]">
                                                <input type="hidden" name="positionId" value="@p.PositionId" />
                                                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                                                <button type="submit" class="dropdown-item text-danger"><pems-icon name="bi-person-dash" /> @Localizer["پایان تخصیص"]</button>
                                            </form>
                                        </li>
                                    }
                                    @if (p.IsActive)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-action="DeactivatePosition" method="post"
                                                  data-pems-confirm="@(p.IsVacant ? Localizer["این سمت خالی غیرفعال شود؟"] : Localizer["این سمت اشغال شده است؛ غیرفعال‌کردن آن، تخصیص کارمند فعلی را هم پایان می‌دهد و سمت خالی خواهد شد. ادامه می‌دهید؟"])">
                                                <input type="hidden" name="positionId" value="@p.PositionId" />
                                                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                                                <button type="submit" class="dropdown-item text-danger"><pems-icon name="bi-x-circle" /> @Localizer["غیرفعال کردن"]</button>
                                            </form>
                                        </li>
                                    }
                                </pems-dropdown-menu>
                            </div>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
        <p class="text-muted text-center py-3 mb-0" id="positionsFilterEmpty" hidden>@Localizer["هیچ سمتی با این فیلتر یافت نشد."]</p>
    }
</pems-content-card>

@* ========================= Assignment History ========================= *@
<pems-content-card>
    <h6 class="fw-bold mb-3">@Localizer["تاریخچه‌ی تخصیص"]</h6>
    @if (!historyRows.Any())
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز تخصیصی برای سمت‌های این تیم ثبت نشده."]</p>
    }
    else
    {
        <pems-table kind="enterprise" css="pems-responsive-table">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["سمت"]</pems-table-header>
                    <pems-table-header>@Localizer["کارمند"]</pems-table-header>
                    <pems-table-header>@Localizer["تاریخ شروع"]</pems-table-header>
                    <pems-table-header>@Localizer["تاریخ پایان"]</pems-table-header>
                    <pems-table-header>@Localizer["وضعیت"]</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var row in historyRows)
                {
                    <pems-table-row>
                        <pems-table-cell data-label="@Localizer["سمت"]">@row.Position.Title</pems-table-cell>
                        <pems-table-cell data-label="@Localizer["کارمند"]">@row.Assignment.EmployeeName</pems-table-cell>
                        <pems-table-cell data-label="@Localizer["تاریخ شروع"]">@row.Assignment.StartDate.ToString("yyyy-MM-dd")</pems-table-cell>
                        <pems-table-cell data-label="@Localizer["تاریخ پایان"]">@(row.Assignment.EndDate?.ToString("yyyy-MM-dd") ?? "—")</pems-table-cell>
                        <pems-table-cell data-label="@Localizer["وضعیت"]">
                            @if (row.Assignment.IsActive)
                            {
                                <pems-badge tone="success"><pems-icon name="bi-play-circle" /> @Localizer["جاری"]</pems-badge>
                            }
                            else
                            {
                                <pems-badge tone="neutral"><pems-icon name="bi-check2" /> @Localizer["پایان‌یافته"]</pems-badge>
                            }
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    }
</pems-content-card>

@* ========================= Modals ========================= *@

<pems-modal id="addPositionModal" tabindex="-1">
        <form asp-action="CreatePosition" method="post">
            <pems-modal-header>@Localizer["افزودن سمت"]</pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["عنوان سمت"]</pems-label>
                    <pems-input scale="small" name="title" required placeholder="@Localizer["مثلاً سرگروه، تکنسین ارشد..."]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["توضیحات (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="description" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["ترتیب نمایش"]</pems-label>
                    <pems-input scale="small" name="sortOrder" type="number" value="0" />
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

@* طبق بند ۷ سند (Edit Position): ویرایش افزایشی همان فیلدهای پشتیبانی‌شده - عنوان/توضیحات/ترتیب. *@
<pems-modal id="editPositionModal" tabindex="-1">
        <form asp-action="UpdatePosition" method="post">
            <pems-modal-header>@Localizer["ویرایش سمت"]</pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="positionId" id="editPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["عنوان سمت"]</pems-label>
                    <pems-input scale="small" name="title" id="editPositionTitle" required />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["توضیحات (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="description" id="editPositionDescription" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["ترتیب نمایش"]</pems-label>
                    <pems-input scale="small" name="sortOrder" id="editPositionSortOrder" type="number" />
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ذخیره"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="addChildNodeModal" tabindex="-1">
        <form asp-action="CreateSubTeam" method="post">
            <pems-modal-header>@Localizer["افزودن زیرتیم/شیفت"]</pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="maintenanceGroupId" value="@Model.MaintenanceGroupId" />
                <input type="hidden" name="parentTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["نوع گره"]</pems-label>
                    <pems-select scale="small" name="nodeKind">
                        <option value="SubTeam">SubTeam</option>
                        <option value="Shift">Shift</option>
                        <option value="Unit">Unit</option>
                        <option value="Team">Team</option>
                    </pems-select>
                    <pems-help-text>@Localizer["نمونه‌های رایج - می‌توانید در کد بعداً هر نام دیگری هم بسازید."]</pems-help-text>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["کد"]</pems-label>
                    <pems-input scale="small" name="code" required />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["نام"]</pems-label>
                    <pems-input scale="small" name="name" required placeholder="@Localizer["مثلاً Shift A"]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["سرپرست (اختیاری)"]</pems-label>
                    <pems-input scale="small" css="mb-1 pems-employee-search" type="search" data-target="#childNodeSupervisorSelect" placeholder="@Localizer["جستجوی کارمند..."]" />
                    <pems-select scale="small" name="supervisorEmployeeId" id="childNodeSupervisorSelect" size="1">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var e in allEmployees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </pems-select>
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="assignEmployeeModal" tabindex="-1">
        <form asp-action="AssignEmployeeToPosition" method="post">
            <pems-modal-header>@Localizer["تخصیص کارمند"] — <span id="assignPositionTitle"></span></pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="positionId" id="assignPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["کارمند"]</pems-label>
                    <pems-input scale="small" css="mb-1 pems-employee-search" type="search" data-target="#assignEmployeeSelect" placeholder="@Localizer["جستجوی کارمند..."]" />
                    <pems-select scale="small" name="employeeId" id="assignEmployeeSelect" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in allEmployees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </pems-select>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["توضیحات (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="notes" />
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["تخصیص"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="moveEmployeeModal" tabindex="-1">
        <form asp-action="MoveEmployeeBetweenPositions" method="post">
            <pems-modal-header>@Localizer["جابه‌جایی کارمند"] — <span id="moveEmployeeFromTitle"></span></pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="fromPositionId" id="moveEmployeeFromPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <p class="small text-muted" id="moveEmployeeCurrentOccupant"></p>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["سمت مقصد (خالی)"]</pems-label>
                    <pems-select scale="small" name="toPositionId" required>
                        <option value="">@Localizer["سمت مقصد..."]</option>
                        @foreach (var vp in vacantPositions) { <option value="@vp.PositionId">@vp.Label</option> }
                    </pems-select>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["توضیحات (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="notes" />
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["جابه‌جایی"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="movePositionModal" tabindex="-1">
        <form asp-action="MovePosition" method="post">
            <pems-modal-header>@Localizer["جابه‌جایی سمت"] — <span id="movePositionTitle"></span></pems-modal-header>
            <pems-modal-body>
                <input type="hidden" name="positionId" id="movePositionPositionId" />
                <input type="hidden" name="returnTeamId" value="@Model.TeamId" />
                <div class="mb-2">
                    <pems-label css="small">@Localizer["تیم مقصد"]</pems-label>
                    <pems-select scale="small" name="newTeamId" required>
                        @foreach (var t in allTeamNodes) { <option value="@t.TeamId">@t.Name (@t.NodeKind)</option> }
                    </pems-select>
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["جابه‌جایی"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

@section Scripts {
    <script src="~/js/pems-team-details.js" asp-append-version="true"></script>
}
