@model List<PEMS.Domain.Entities.Team>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" gap="2" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="OrganizationChart">
        <pems-icon name="bi-diagram-3" /> @Localizer["نمودار سازمانی"]
    </pems-button>
    <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#createTeamModal">
        <pems-icon name="bi-plus-lg" /> @Localizer["تیم جدید"]
    </pems-button>
</pems-flex>

<pems-row gap="3">
    @foreach (var team in Model)
    {
        <pems-col md="6">
            <pems-content-card css="h-100" id="team-card-@team.TeamId">
                <pems-flex justify="between" align="start">
                    <div>
                        <h6 class="mb-0">@team.Code — @team.Name</h6>
                        <span class="text-muted small">@team.MaintenanceGroup?.Name (@team.MaintenanceGroup?.Discipline?.Name) @(string.IsNullOrEmpty(team.Shift) ? "" : $"— {team.Shift}")</span>
                    </div>
                    <pems-flex align="center" gap="2">
                        @if (team.SupervisorEmployee != null)
                        {
                            <pems-badge tone="primary"><pems-icon name="bi-star" /> سرپرست: @team.SupervisorEmployee.FirstName @team.SupervisorEmployee.LastName</pems-badge>
                        }
                        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="TeamDetails" asp-route-teamId="@team.TeamId">
                            <pems-icon name="bi-diagram-2" /> @Localizer["جزئیات و نیروی انسانی"]
                        </pems-button>
                    </pems-flex>
                </pems-flex>

                <hr class="my-2" />

                <h6 class="small fw-bold mb-2">اعضا (@team.Members.Count(m => m.IsActive))</h6>
                <ul class="list-unstyled mb-2">
                    @foreach (var m in team.Members.Where(m => m.IsActive))
                    {
                        <pems-flex as="li" justify="between" align="center" css="border-bottom py-1">
                            <span class="small">@m.Employee?.FirstName @m.Employee?.LastName</span>
                            <pems-flex as="span" align="center" gap="2">
                                <pems-badge tone="neutral">@m.Role?.Name</pems-badge>
                                <pems-form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="teamMemberId" value="@m.TeamMemberId" />
                                    <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" data-pems-confirm="این عضو از تیم خارج بشه؟"><pems-icon name="bi-x" /></pems-button>
                                </pems-form>
                            </pems-flex>
                        </pems-flex>
                    }
                </ul>

                <pems-form asp-action="AddMember" method="post"><pems-flex gap="1">
                    <input type="hidden" name="teamId" value="@team.TeamId" />
                    <pems-select scale="small" name="employeeId" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </pems-select>
                    <pems-select scale="small" name="roleId" required>
                        <option value="">@Localizer["نقش..."]</option>
                        @foreach (var r in ((IEnumerable<dynamic>)ViewBag.MaintenanceRoles).Where(r => r.DisciplineName == team.MaintenanceGroup?.Discipline?.Name))
                        {
                            <option value="@r.MaintenanceRoleId">@r.Name</option>
                        }
                    </pems-select>
                    <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><pems-icon name="bi-plus-lg" /></pems-button>
                </pems-flex></pems-form>
            </pems-content-card>
        </pems-col>
    }
</pems-row>
@if (!Model.Any())
{
    <pems-content-card><p class="text-muted text-center py-4 mb-0">@Localizer["هنوز تیمی ساخته نشده."]</p></pems-content-card>
}

<pems-modal id="createTeamModal" tabindex="-1">
        <pems-form asp-action="CreateTeam" method="post">
            <pems-modal-header>@Localizer["تیم جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["کد تیم"]</pems-label>
                    <pems-input scale="small" name="code" required placeholder="@Localizer["مثلاً MECH-A"]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["نام تیم"]</pems-label>
                    <pems-input scale="small" name="name" required placeholder="@Localizer["مثلاً Mechanical Maintenance - Shift A"]" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["گروه تعمیراتی (Maintenance Group)"]</pems-label>
                    <pems-select scale="small" name="maintenanceGroupId" required>
                        @foreach (var g in (IEnumerable<dynamic>)ViewBag.MaintenanceGroups) { <option value="@g.MaintenanceGroupId">@g.Name (@g.DisciplineName)</option> }
                    </pems-select>
                    <pems-help-text>گروه‌های تعمیراتی از <a asp-controller="MaintenanceMasterData" asp-action="Index">@Localizer["Maintenance Master Data"]</a> مدیریت می‌شوند.</pems-help-text>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["شیفت (اختیاری)"]</pems-label>
                    <pems-input scale="small" name="shift" />
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["سرپرست (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="supervisorEmployeeId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </pems-select>
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

@section Scripts {
    <script src="~/js/views/team-index.js" asp-append-version="true"></script>
}
