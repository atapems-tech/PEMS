@model List<PEMS.Domain.Entities.Team>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center gap-2 mb-2">
    <a asp-action="OrganizationChart" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-diagram-3"></i> @Localizer["نمودار سازمانی"]
    </a>
    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createTeamModal">
        <i class="bi bi-plus-lg"></i> @Localizer["تیم جدید"]
    </button>
</div>

<div class="row g-3">
    @foreach (var team in Model)
    {
        <div class="col-md-6">
            <div class="content-card h-100" id="team-card-@team.TeamId">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-0">@team.Code — @team.Name</h6>
                        <span class="text-muted small">@team.MaintenanceGroup?.Name (@team.MaintenanceGroup?.Discipline?.Name) @(string.IsNullOrEmpty(team.Shift) ? "" : $"— {team.Shift}")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (team.SupervisorEmployee != null)
                        {
                            <pems-badge tone="primary"><i class="bi bi-star"></i> سرپرست: @team.SupervisorEmployee.FirstName @team.SupervisorEmployee.LastName</pems-badge>
                        }
                        <a asp-action="TeamDetails" asp-route-teamId="@team.TeamId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-diagram-2"></i> @Localizer["جزئیات و نیروی انسانی"]
                        </a>
                    </div>
                </div>

                <hr class="my-2" />

                <h6 class="small fw-bold mb-2">اعضا (@team.Members.Count(m => m.IsActive))</h6>
                <ul class="list-unstyled mb-2">
                    @foreach (var m in team.Members.Where(m => m.IsActive))
                    {
                        <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                            <span class="small">@m.Employee?.FirstName @m.Employee?.LastName</span>
                            <span class="d-flex align-items-center gap-2">
                                <pems-badge tone="neutral">@m.Role?.Name</pems-badge>
                                <form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="teamMemberId" value="@m.TeamMemberId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="return confirm('این عضو از تیم خارج بشه؟')"><i class="bi bi-x"></i></button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>

                <form asp-action="AddMember" method="post" class="d-flex gap-1">
                    <input type="hidden" name="teamId" value="@team.TeamId" />
                    <select name="employeeId" class="form-select form-select-sm" required>
                        <option value="">@Localizer["کارمند..."]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                    <select name="roleId" class="form-select form-select-sm" required>
                        <option value="">@Localizer["نقش..."]</option>
                        @foreach (var r in ((IEnumerable<dynamic>)ViewBag.MaintenanceRoles).Where(r => r.DisciplineName == team.MaintenanceGroup?.Discipline?.Name))
                        {
                            <option value="@r.MaintenanceRoleId">@r.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap"><i class="bi bi-plus-lg"></i></button>
                </form>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <div class="content-card"><p class="text-muted text-center py-4 mb-0">@Localizer["هنوز تیمی ساخته نشده."]</p></div>
}

<div class="modal fade" id="createTeamModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateTeam" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["تیم جدید"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">@Localizer["کد تیم"]</label>
                    <input name="code" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً MECH-A"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["نام تیم"]</label>
                    <input name="name" class="form-control form-control-sm" required placeholder="@Localizer["مثلاً Mechanical Maintenance - Shift A"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["گروه تعمیراتی (Maintenance Group)"]</label>
                    <select name="maintenanceGroupId" class="form-select form-select-sm" required>
                        @foreach (var g in (IEnumerable<dynamic>)ViewBag.MaintenanceGroups) { <option value="@g.MaintenanceGroupId">@g.Name (@g.DisciplineName)</option> }
                    </select>
                    <div class="form-text">گروه‌های تعمیراتی از <a asp-controller="MaintenanceMasterData" asp-action="Index">@Localizer["Maintenance Master Data"]</a> مدیریت می‌شوند.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["شیفت (اختیاری)"]</label>
                    <input name="shift" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["سرپرست (اختیاری)"]</label>
                    <select name="supervisorEmployeeId" class="form-select form-select-sm">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ساخت"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        // طبق «PEMS Dynamic Maintenance Organization — Phase 6A» بند ۶: بازکردن جزئیات یک تیم
        // از نمودار سازمانی همین صفحه‌ی موجود را (با highlightTeamId) گسترش می‌دهد - مسیر
        // جدیدی برای Team Details ساخته نشد.
        (function () {
            var params = new URLSearchParams(window.location.search);
            var teamId = params.get("highlightTeamId");
            if (!teamId) return;
            var card = document.getElementById("team-card-" + teamId);
            if (!card) return;
            card.scrollIntoView({ behavior: "smooth", block: "center" });
            card.style.transition = "box-shadow .3s ease";
            card.style.boxShadow = "0 0 0 3px var(--pems-selection)";
            setTimeout(function () { card.style.boxShadow = ""; }, 2600);
        })();
    </script>
}
