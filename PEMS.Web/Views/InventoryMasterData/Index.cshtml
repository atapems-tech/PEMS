@model List<PEMS.Domain.Entities.Warehouse>
@{
    var categories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.Categories;
    var topLevelCategories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.TopLevelCategories;
    var uoms = (List<PEMS.Domain.Entities.MaterialUOM>)ViewBag.Uoms;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<ul class="nav nav-tabs mb-3" id="imdTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-categories" type="button">
            <i class="bi bi-diagram-3"></i> Categories <span class="badge bg-secondary">@categories.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-uoms" type="button">
            <i class="bi bi-rulers"></i> Units of Measure <span class="badge bg-secondary">@uoms.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-warehouses" type="button">
            <i class="bi bi-building"></i> Warehouses <span class="badge bg-secondary">@Model.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-categories" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">دسته‌بندی سلسله‌مراتبی متریال - مستقل از Discipline.</p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                    <i class="bi bi-plus-lg"></i> دسته‌بندی جدید
                </button>
            </div>
            <table class="table table-enterprise">
                <thead><tr><th>کد</th><th>نام</th><th>والد</th><th>توضیحات</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in categories)
                    {
                        <tr>
                            <td>@c.Code</td>
                            <td>@c.Name</td>
                            <td>@(c.Parent?.Name ?? "-")</td>
                            <td class="small text-muted">@(c.Description ?? "-")</td>
                            <td class="text-end">
                                <form asp-action="ToggleCategoryActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.MaterialCategoryId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این دسته‌بندی غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-uoms" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">واحد اندازه‌گیری پایه - مستقل نگه داشته می‌شود تا بین متریال‌های مختلف مشترک باشد.</p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createUomModal">
                    <i class="bi bi-plus-lg"></i> واحد جدید
                </button>
            </div>
            <table class="table table-enterprise">
                <thead><tr><th>کد</th><th>نام</th><th>ضریب تبدیل</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in uoms)
                    {
                        <tr>
                            <td>@u.Code</td>
                            <td>@u.Name</td>
                            <td>@(u.ConversionFactor?.ToString() ?? "-")</td>
                            <td class="text-end">
                                <form asp-action="ToggleUomActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.MaterialUOMId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این واحد غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-warehouses" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">انبارهای فیزیکی - طبق پیشوندهای واقعی MRS از قبل seed شده‌اند.</p>
                <button type="button" class="btn btn-pems-solid btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createWarehouseModal">
                    <i class="bi bi-plus-lg"></i> انبار جدید
                </button>
            </div>
            <table class="table table-enterprise">
                <thead><tr><th>کد</th><th>نام</th><th>محل‌های نگهداری</th><th></th></tr></thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td>@w.Code</td>
                            <td>@w.Name</td>
                            <td>
                                @foreach (var l in w.Locations.Where(x => x.IsActive))
                                {
                                    <span class="badge bg-light text-dark border me-1">@l.Code</span>
                                }
                                <button type="button" class="btn btn-sm btn-link p-0" data-bs-toggle="modal" data-bs-target="#addLocationModal_@w.WarehouseId">+ محل</button>
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleWarehouseActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@w.WarehouseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این انبار غیرفعال بشه؟')"><i class="bi bi-x-circle"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateCategory" method="post">
            <div class="modal-header"><h6 class="modal-title">دسته‌بندی جدید</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">کد</label><input name="code" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">نام</label><input name="name" class="form-control form-control-sm" required /></div>
                <div class="mb-2">
                    <label class="form-label small">والد (اختیاری)</label>
                    <select name="parentCategoryId" class="form-select form-select-sm">
                        <option value="">-- ندارد --</option>
                        @foreach (var c in topLevelCategories) { <option value="@c.MaterialCategoryId">@c.Name</option> }
                    </select>
                </div>
                <div class="mb-2"><label class="form-label small">توضیحات</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="createUomModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateUom" method="post">
            <div class="modal-header"><h6 class="modal-title">واحد اندازه‌گیری جدید</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">کد</label><input name="code" class="form-control form-control-sm" required placeholder="مثلاً KG" /></div>
                <div class="mb-2"><label class="form-label small">نام</label><input name="name" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">ضریب تبدیل (اختیاری)</label><input name="conversionFactor" type="number" step="0.000001" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label class="form-label small">توضیحات</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="createWarehouseModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="CreateWarehouse" method="post">
            <div class="modal-header"><h6 class="modal-title">انبار جدید</h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">کد</label><input name="code" class="form-control form-control-sm" required placeholder="مثلاً WH-EL" /></div>
                <div class="mb-2"><label class="form-label small">نام</label><input name="name" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">توضیحات</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
            </div>
        </form>
    </div></div>
</div>

@foreach (var w in Model)
{
    <div class="modal fade" id="addLocationModal_@w.WarehouseId" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <form asp-action="CreateStorageLocation" method="post">
                <input type="hidden" name="warehouseId" value="@w.WarehouseId" />
                <div class="modal-header"><h6 class="modal-title">محل نگهداری جدید در @w.Code</h6></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label small">کد</label><input name="code" class="form-control form-control-sm" required placeholder="مثلاً RACK-1" /></div>
                    <div class="mb-2"><label class="form-label small">نام</label><input name="name" class="form-control form-control-sm" required /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-pems-solid btn-sm">ساخت</button>
                </div>
            </form>
        </div></div>
    </div>
}
