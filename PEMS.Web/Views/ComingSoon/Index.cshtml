@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string title = ViewData["Title"]?.ToString() ?? "Module";
    string? sectionName = ViewBag.Section as string;
}

<div class="content-card text-center py-5">
    <div class="pems-s-105f47a5">
        <pems-icon name="bi-cone-striped" />
    </div>

    <p class="text-muted">
        این ماژول در فاز بعدی توسعه (تکمیل ماژول‌های Engineering) پیاده‌سازی می‌شود.
        @if (!string.IsNullOrEmpty(sectionName))
        {
            <br />
            <span>بخش: @sectionName</span>
        }
    </p>

    <pems-button tone="neutral" size="small" outline="true" css="mt-2" as="a" asp-controller="Home" asp-action="Index">
        <pems-icon name="bi-arrow-right" /> @Localizer["بازگشت به داشبورد"]
    </pems-button>
</div>
