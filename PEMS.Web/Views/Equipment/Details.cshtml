@model PEMS.Application.DTOs.EquipmentPassportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var eq = Model.Equipment;
    var inst = Model.Instrument;
    var asset = Model.Asset;
    var mech = Model.MechanicalEquipment;
    var cm = Model.ConditionMonitoring;

    string CmEvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        "RequiresEngineeringReview" => "bg-info text-dark",
        _ => "bg-secondary"
    };
    var inspections = ViewBag.Inspections as List<PEMS.Application.DTOs.InspectionListItemDto> ?? new();

    var calBadgeClass = inst?.CalibrationStatus switch
    {
        "Overdue" => "bg-danger",
        "DueSoon" => "bg-warning text-dark",
        "OK" => "bg-success",
        _ => "bg-secondary"
    };

    bool canCreateWr = ViewBag.CanCreateWorkRequest == true, canViewWr = ViewBag.CanViewWorkRequest == true, canViewWo = ViewBag.CanViewWorkOrder == true;
    string WrTone(string s) => s switch { "Converted" or "Approved" or "Planned" => "vs-pill--success", "Rejected" => "vs-pill--danger", "Cancelled" or "Draft" => "vs-pill--neutral", _ => "vs-pill--info" };
    string WrIcon(string s) => s switch { "Draft" => "bi-pencil", "Submitted" => "bi-send", "UnderReview" => "bi-hourglass-split", "Approved" => "bi-check-circle", "Planned" => "bi-calendar-check", "Converted" => "bi-box-arrow-up-right", "Rejected" => "bi-x-circle", "Cancelled" => "bi-slash-circle", _ => "bi-circle" };
    string PrioTone(string s) => s switch { "Critical" => "vs-pill--danger", "High" => "vs-pill--warning", _ => "vs-pill--neutral" };
    string NA(string? v) => string.IsNullOrWhiteSpace(v) ? "N/A" : v;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

@* طراحی جدید: به‌جای یک صفحه‌ی طولانی با هفت جدول/بخش پشت سر هم، محتوا در تب‌ها سازمان‌دهی شده -
   همان الگویی که در EngineeringDocuments/Details.cshtml و VDR/Details.cshtml استفاده شده. هیچ
   داده‌ای حذف نشده - فقط پشت تب‌هایی که فقط وقتی کاربر انتخاب کند نمایش داده می‌شوند، دسته‌بندی شده.
   طبق درخواست: شناسنامه‌ی ابزاردقیق (در صورت وجود) حالا بخشی از همین صفحه است، نه فقط یک لینک بیرونی. *@

<div class="vs-page">
<div class="vs-section">
    <div class="vs-doc-head">
        <div class="vs-doc-identity">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="vs-doc-number vs-num">@eq.TagNumber</h2>
                <span class="vs-pill vs-pill--icon vs-pill--success"><i class="bi bi-check-circle" aria-hidden="true"></i> @eq.Status</span>
                @if (!string.IsNullOrWhiteSpace(eq.CriticalityClass))
                {
                    <span class="vs-pill vs-pill--icon @(eq.CriticalityClass == "A" ? "vs-pill--danger" : eq.CriticalityClass == "B" ? "vs-pill--warning" : "vs-pill--neutral")" title="Criticality Class"><i class="bi bi-exclamation-diamond" aria-hidden="true"></i> @Localizer["Cm_Criticality"] @eq.CriticalityClass</span>
                }
                @if (inst != null)
                {
                    <span class="vs-pill vs-pill--icon @(inst.CalibrationStatus == "Overdue" ? "vs-pill--danger" : inst.CalibrationStatus == "DueSoon" ? "vs-pill--warning" : inst.CalibrationStatus == "OK" ? "vs-pill--success" : "vs-pill--neutral")" title="Calibration status"><i class="bi bi-speedometer2" aria-hidden="true"></i> @Localizer["Cm_Cal"]: @inst.CalibrationStatus</span>
                }
            </div>
            <div class="vs-doc-title">@eq.Name</div>
            <div class="vs-doc-meta">@eq.EquipmentType &middot; @eq.ProjectName &middot; @eq.DisciplineName @(string.IsNullOrWhiteSpace(eq.Area) ? "" : "· " + eq.Area)</div>
        </div>
        <div class="vs-doc-actions">
            <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="@eq.EquipmentId" class="vs-btn"><i class="bi bi-diagram-3"></i> @Localizer["Cm_Relationships"]</a>
            <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#assignFoundationModal" title="Assign Functional Location / Parent Equipment"><i class="bi bi-pencil"></i> @Localizer["Cm_AssignLocation"]</button>
        </div>
    </div>
    <div class="vs-info">
        <div>
            <p class="vs-info__label">P&amp;ID</p>
            <p class="vs-info__value vs-num">
            @if (Model.PIDDocument != null)
            {
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.PIDDocument.DocumentId">@eq.PIDNumber <i class="bi bi-box-arrow-up-right small"></i></a>
            }
            else if (!string.IsNullOrWhiteSpace(eq.PIDNumber)) { <span title="@Localizer["مدرکی با این شماره پیدا نشد"]">@eq.PIDNumber</span> }
            else { <span class="text-muted">N/A</span> }
            </p>
        </div>
        <div><p class="vs-info__label">@Localizer["Cm_ManufacturerModel"]</p><p class="vs-info__value vs-num">@NA(eq.Manufacturer) / @NA(eq.Model)</p></div>
        <div><p class="vs-info__label">@Localizer["Cm_FunctionalLocation"]</p><p class="vs-info__value">@NA(eq.FunctionalLocationBreadcrumb)</p></div>
        <div>
            <p class="vs-info__label">@Localizer["Cm_ParentEquipment"]</p>
            <p class="vs-info__value vs-num">
            @if (eq.ParentEquipmentId.HasValue) { <a asp-action="Details" asp-route-id="@eq.ParentEquipmentId">@eq.ParentEquipmentTagNumber</a> } else { <span class="text-muted">N/A</span> }
            </p>
        </div>
        <div><p class="vs-info__label">@Localizer["Cm_InstallationDate"]</p><p class="vs-info__value vs-num">@(eq.InstallationDate?.ToString("yyyy-MM-dd") ?? "N/A")</p></div>
        <div class="vs-info__wide"><p class="vs-info__label">@Localizer["Cm_Description"]</p><p class="vs-info__value">@NA(eq.Description)</p></div>
        @if (eq.ChildEquipments.Any())
        {
            <div class="vs-info__wide">
                <p class="vs-info__label">@Localizer["Cm_ChildEquipment"] (@eq.ChildEquipmentCount)</p>
                <p class="vs-info__value">
                @foreach (var c in eq.ChildEquipments) { <a asp-action="Details" asp-route-id="@c.EquipmentId" class="vs-chip text-decoration-none vs-num me-1">@c.TagNumber</a> }
                </p>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="assignFoundationModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="AssignFoundation" method="post">
            <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Cm_AssignTitle"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Functional Location"]</label>
                    <select name="functionalLocationId" class="form-select form-select-sm">
                        <option value="">@Localizer["-- not linked --"]</option>
                        @foreach (var fl in (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                        {
                            <option value="@fl.FunctionalLocationId" selected="@(fl.FunctionalLocationId == eq.FunctionalLocationId)">@fl.PathBreadcrumb</option>
                        }
                    </select>
                    @* طبق «PEMS CMMS — Equipment Functional Location Assignment & Import» بند «Existing
                       Assignment Protection»: تخصیص فعلی باید صریحاً قابل‌دیدن باشد، نه فقط ضمنی از
                       طریق گزینه‌ی از‌قبل‌انتخاب‌شده‌ی Select - عیناً همون الگوی «Currently: ...» که
                       همین Modal برای Parent Equipment پایین‌تر دارد. *@
                    @if (eq.FunctionalLocationId.HasValue)
                    {
                        var currentFl = ((List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                            .FirstOrDefault(x => x.FunctionalLocationId == eq.FunctionalLocationId);
                        <div class="form-text">Currently: @(currentFl?.PathBreadcrumb ?? NA(eq.FunctionalLocationBreadcrumb))</div>
                    }
                    <div class="form-text">Real link, distinct from the raw "@NA(eq.Area)" import value. <a asp-controller="FunctionalLocation" asp-action="Index" target="_blank">@Localizer["Manage list"]</a></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Parent Equipment</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Search tag, name..."
                           data-pems-search data-search-type="Equipment" data-search-hidden="#parentEquipmentIdHidden" autocomplete="off" />
                    <input type="hidden" name="parentEquipmentId" id="parentEquipmentIdHidden" value="@eq.ParentEquipmentId" />
                    @if (eq.ParentEquipmentId.HasValue)
                    {
                        <div class="form-text">Currently: @eq.ParentEquipmentTagNumber</div>
                    }
                </div>
                <div class="mb-2">
                    <label class="form-label small">Installation Date</label>
                    <input name="installationDate" type="date" class="form-control form-control-sm" value="@eq.InstallationDate?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
            </div>
        </form>
    </div></div>
</div>

@if (Model.SuggestedLinks.Any())
{
    <div class="content-card mb-3 border-warning">
        <h6 class="mb-3"><i class="bi bi-lightbulb"></i> پیشنهادهای اتصال (تاییدنشده)</h6>
        <p class="text-muted small">
            این‌ها از روی شماره‌ی MRQ/PO خام ثبت‌شده روی تجهیز، با داده‌ی موجود منطبق شده‌اند.
            برای تایید و برقراری رسمی رابطه، به <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="@eq.EquipmentId">Relationship Explorer</a> برو.
        </p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var s in Model.SuggestedLinks)
            {
                <pems-badge tone="warning"><i class="bi bi-robot"></i> @s.Label <span class="small">(@s.SubLabel)</span></pems-badge>
            }
        </div>
    </div>
}

<ul class="nav nav-tabs mb-3" id="equipmentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <i class="bi bi-info-circle"></i> @Localizer["Cm_TabOverview"]
        </button>
    </li>
    @if (inst != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-instrument" type="button">
                <i class="bi bi-card-text"></i> @Localizer["Cm_InstrumentPassport"]
            </button>
        </li>
    }
    @if (mech != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mechanical" type="button">
                <i class="bi bi-gear-wide-connected"></i> @Localizer["Mechanical Passport"]
            </button>
        </li>
    }
    @if (cm != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cm" type="button">
                <i class="bi bi-activity"></i> @Localizer["Condition Monitoring"]
                @if (cm.OpenFindingCount > 0) { <pems-badge tone="danger">@cm.OpenFindingCount</pems-badge> }
            </button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-barcode" type="button">
            <i class="bi bi-upc-scan"></i> @Localizer["Cm_TabBarcode"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-asset" type="button">
            <i class="bi bi-diagram-2"></i> @Localizer["Cm_TabAsset"]
            @if (asset != null) { <pems-badge tone="neutral">@asset.Status</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button">
            <i class="bi bi-file-earmark-text"></i> @Localizer["Cm_EngDocs"]
            <pems-badge tone="neutral">@(Model.Documents.Count + Model.VDRItems.Count)</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-procurement" type="button">
            <i class="bi bi-cart-check"></i> @Localizer["Cm_TabProcurement"] <pems-badge tone="neutral">@Model.RelatedMRs.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance" type="button">
            <i class="bi bi-tools"></i> @Localizer["Cm_TabMaintenance"] <pems-badge tone="neutral">@Model.WorkRequests.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-inspection" type="button">
            <i class="bi bi-clipboard-pulse"></i> @Localizer["Cm_TabInspections"]
            @if (inspections.Any()) { <pems-badge tone="neutral">@inspections.Count</pems-badge> }
            @if (inspections.Any(x => x.ConditionStatus == "Alert")) { <pems-badge tone="danger">@Localizer["Alert"]</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-quality" type="button">
            <i class="bi bi-shield-exclamation"></i> @Localizer["Cm_TabQuality"]
            @{ var qcCount = Model.NonConformanceReports.Count + Model.MOCs.Count + Model.TechnicalQueries.Count; }
            @if (qcCount > 0) { <pems-badge tone="neutral">@qcCount</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-classification" type="button">
            <i class="bi bi-diagram-3-fill"></i> @Localizer["Cm_TabClassification"]
            @{ var pendingSuggestion = ViewBag.PendingClassificationSuggestion as PEMS.Application.DTOs.ReviewQueueItemDto; }
            @if (pendingSuggestion != null) { <pems-badge tone="warning">1</pems-badge> }
        </button>
    </li>
</ul>

<div class="tab-content">

    @* ===================== Overview ===================== *@
    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        @{ var pendingWr = Model.WorkRequests.Count(w => w.Status is "Draft" or "Submitted" or "UnderReview" or "Approved" or "Planned"); }
        <div class="vs-chips">
            <button type="button" class="vs-chip" data-goto-tab="#tab-documents"><i class="bi bi-file-earmark-text"></i> @Localizer["Cm_EngDocs"] <strong>@Model.Documents.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-documents"><i class="bi bi-journal-check"></i> VDR <strong>@Model.VDRItems.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-procurement"><i class="bi bi-cart-check"></i> MR <strong>@Model.RelatedMRs.Count</strong></button>
            <button type="button" class="vs-chip @(pendingWr > 0 ? "vs-chip--danger" : "")" data-goto-tab="#tab-maintenance"><i class="bi bi-clipboard-plus"></i> @Localizer["Cm_WorkRequests"] <strong>@Model.WorkRequests.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-maintenance"><i class="bi bi-tools"></i> @Localizer["Cm_WorkOrders"] <strong>@Model.WorkOrders.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">NCR <strong>@Model.NonConformanceReports.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">MOC <strong>@Model.MOCs.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">TQ / TSR / RFI <strong>@Model.TechnicalQueries.Count</strong></button>
        </div>

        @if (inst != null)
        {
            <div class="content-card mt-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-card-text"></i> @Localizer["Cm_InstrumentPassport"]</h6>
                    <span class="small text-muted">See the "Instrument Passport" tab for full details, calibration history and print.</span>
                </div>
                <div class="row g-2 small mt-2">
                    <div class="col-md-3"><strong>@Localizer["Type"]</strong><div>@NA(inst.InstrumentType)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Loop No."]</strong><div>@NA(inst.LoopNumber)</div></div>
                    <div class="col-md-3"><strong>System / Signal</strong><div>@NA(inst.System) / @NA(inst.SignalClass)</div></div>
                    <div class="col-md-3"><strong>Next Calibration</strong><div>@(inst.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "N/A") <pems-badge tone="none" css="@calBadgeClass">@inst.CalibrationStatus</pems-badge></div></div>
                </div>
            </div>
        }
    </div>

    @* ===================== Instrument Passport ===================== *@
    @if (inst != null)
    {
        <div class="tab-pane fade" id="tab-instrument" role="tabpanel">
            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">@Localizer["Cm_InstrumentPassport"]</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="Instrument" asp-action="Passport" asp-route-id="@inst.InstrumentId">
                        <i class="bi bi-card-text"></i> @Localizer["Cm_FullPassport"]
                    </pems-button>
                </div>
                <div class="row g-2 small">
                    <div class="col-md-3"><strong>@Localizer["Instrument Type"]</strong><div>@NA(inst.InstrumentType)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Loop No."]</strong><div>@NA(inst.LoopNumber)</div></div>
                    <div class="col-md-3"><strong>@Localizer["System"]</strong><div>@NA(inst.System)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Signal Class"]</strong><div>@NA(inst.SignalClass)</div></div>

                    <div class="col-md-3"><strong>@Localizer["Process Variable"]</strong><div>@NA(inst.ProcessVariable)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Range"]</strong><div>@(inst.RangeMin?.ToString() ?? "N/A") - @(inst.RangeMax?.ToString() ?? "N/A") @inst.Unit</div></div>
                    <div class="col-md-3"><strong>@Localizer["Output Signal"]</strong><div>@NA(inst.OutputSignal)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Current Status"]</strong><div>@NA(inst.CurrentStatus)</div></div>

                    <div class="col-md-3"><strong>@Localizer["Hazardous Area"]</strong><div>@NA(inst.HazardousArea)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Ex Protection"]</strong><div>@NA(inst.ExProtection)</div></div>
                    <div class="col-md-3"><strong>@Localizer["SIL"]</strong><div>@NA(inst.SIL)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Calibration Interval"]</strong><div>@(inst.CalibrationInterval.HasValue ? inst.CalibrationInterval + " days" : "N/A")</div></div>

                    <div class="col-md-3"><strong>@Localizer["Junction Box"]</strong><div>@NA(inst.JunctionBox)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Marshalling Cabinet"]</strong><div>@NA(inst.MarshallingCabinet)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Cable No."]</strong><div>@NA(inst.CableNumber)</div></div>
                    <div class="col-md-3"><strong>@Localizer["I/O Card / Channel"]</strong><div>@NA(inst.IOCardChannel)</div></div>

                    <div class="col-md-3"><strong>@Localizer["System Cabinet"]</strong><div>@NA(inst.SystemCabinet)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Last Calibration"]</strong><div>@(inst.LastCalibrationDate?.ToString("yyyy-MM-dd") ?? "N/A")</div></div>
                    <div class="col-md-3"><strong>Next Calibration Due</strong><div>@(inst.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "N/A") <pems-badge tone="none" css="@calBadgeClass">@inst.CalibrationStatus</pems-badge></div></div>
                    <div class="col-md-3"><strong>Next Maintenance Due</strong><div>@(inst.NextMaintenanceDue?.ToString("yyyy-MM-dd") ?? "N/A")</div></div>
                </div>
            </div>
        </div>
    }

    @* ===================== Mechanical Equipment Passport ===================== *@
    @if (mech != null)
    {
        <div class="tab-pane fade" id="tab-mechanical" role="tabpanel">
            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">@Localizer["Mechanical Passport"]</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="MechanicalEquipment" asp-action="Passport" asp-route-id="@mech.MechanicalEquipmentId">
                        <i class="bi bi-gear-wide-connected"></i> @Localizer["Full Mechanical Passport"]
                    </pems-button>
                </div>
                <div class="row g-2 small">
                    <div class="col-md-3"><strong>@Localizer["Equipment Type"]</strong><div>@NA(mech.EquipmentType)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Sub-Type"]</strong><div><pems-badge tone="neutral">@mech.SubType</pems-badge></div></div>
                    <div class="col-md-3"><strong>@Localizer["Manufacturer"]</strong><div>@NA(mech.Manufacturer)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Model"]</strong><div>@NA(mech.Model)</div></div>

                    <div class="col-md-3"><strong>@Localizer["Design Pressure"]</strong><div>@(mech.DesignPressure?.ToString() ?? "N/A")</div></div>
                    <div class="col-md-3"><strong>@Localizer["Design Temperature"]</strong><div>@(mech.DesignTemperature?.ToString() ?? "N/A")</div></div>
                    <div class="col-md-3"><strong>@Localizer["Operating Pressure"]</strong><div>@(mech.OperatingPressure?.ToString() ?? "N/A")</div></div>
                    <div class="col-md-3"><strong>@Localizer["Operating Temperature"]</strong><div>@(mech.OperatingTemperature?.ToString() ?? "N/A")</div></div>

                    @if (mech.SubType == "Rotating")
                    {
                        <div class="col-md-3"><strong>@Localizer["Flow Rate"]</strong><div>@(mech.FlowRate?.ToString() ?? "N/A")</div></div>
                        <div class="col-md-3"><strong>@Localizer["Speed (RPM)"]</strong><div>@(mech.SpeedRPM?.ToString() ?? "N/A")</div></div>
                        <div class="col-md-3"><strong>@Localizer["Power (kW)"]</strong><div>@(mech.RotatingPowerKW?.ToString() ?? "N/A")</div></div>
                        <div class="col-md-3"><strong>@Localizer["Driver Type"]</strong><div>@NA(mech.DriverType)</div></div>
                    }
                    else if (mech.SubType == "Static")
                    {
                        <div class="col-md-3"><strong>@Localizer["Volume"]</strong><div>@(mech.Volume?.ToString() ?? "N/A")</div></div>
                        <div class="col-md-3"><strong>@Localizer["Orientation"]</strong><div>@NA(mech.Orientation)</div></div>
                        <div class="col-md-3"><strong>@Localizer["Code Standard"]</strong><div>@NA(mech.CodeStandard)</div></div>
                    }
                </div>
            </div>
        </div>
    }

    @* ===================== Condition Monitoring ===================== *@
    @if (cm != null)
    {
        <div class="tab-pane fade" id="tab-cm" role="tabpanel">
            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">@Localizer["Condition Monitoring"]</h6>
                    <div class="d-flex gap-2">
                        <pems-button tone="danger" size="small" outline="true" as="a" asp-controller="Finding" asp-action="Index" asp-route-equipmentId="@eq.EquipmentId">
                            <i class="bi bi-flag"></i> @Localizer["Findings"] @(cm.OpenFindingCount > 0 ? $"({cm.OpenFindingCount})" : "")
                        </pems-button>
                        <pems-button tone="primary" size="small" as="a" asp-controller="Reliability" asp-action="ConditionMonitoring" asp-route-equipmentId="@eq.EquipmentId">
                            <i class="bi bi-activity"></i> @Localizer["Full Condition Monitoring"]
                        </pems-button>
                    </div>
                </div>
                <div class="row g-2 small mb-3">
                    <div class="col-md-3"><strong>@Localizer["Monitoring Points"]:</strong> @cm.PointCount</div>
                    <div class="col-md-3"><strong>@Localizer["CBM Strategy"]:</strong> @(cm.HasCbmStrategy ? Localizer["Linked"] : Localizer["No"])</div>
                    <div class="col-md-3"><strong>@Localizer["Next Due"]:</strong> @(cm.NextDueDate?.ToString("yyyy-MM-dd") ?? "N/A")</div>
                    <div class="col-md-3"><strong>@Localizer["Findings"]:</strong> @cm.OpenFindingCount</div>
                </div>
                <table class="table table-enterprise table-sm mb-0">
                    <thead><tr><th>@Localizer["Variable"]</th><th>@Localizer["Tag"]</th><th>@Localizer["Last Reading"]</th><th>@Localizer["Evaluation"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in cm.Points)
                        {
                            <tr class="@(p.LastReadingIsAlarm ? "table-danger" : "")">
                                <td>@p.VariableType</td>
                                <td dir="ltr">@p.Tag</td>
                                <td class="small">@(p.LastReadingDate.HasValue ? $"{p.LastValue} {p.Unit} @ {p.LastReadingDate.Value:yyyy-MM-dd}" : Localizer["No readings yet"])</td>
                                <td>
                                    @if (p.EvaluationProfileId.HasValue)
                                    {
                                        <pems-badge tone="none" css="@CmEvalBadge(p.LastReadingEvaluationStatus)">@p.LastReadingEvaluationStatus</pems-badge>
                                    }
                                    else
                                    {
                                        <pems-badge tone="neutral">@Localizer["NotEvaluated"]</pems-badge>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ===================== Asset ===================== *@
    <div class="tab-pane fade" id="tab-asset" role="tabpanel">
        <div class="content-card">
            @if (asset != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Asset - @asset.AssetNumber</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="Asset" asp-action="Details" asp-route-id="@asset.AssetId">
                        <i class="bi bi-diagram-2"></i> @Localizer["Cm_FullAsset"]
                    </pems-button>
                </div>
                <div class="row g-2 small">
                    <div class="col-md-3"><strong>@Localizer["Status"]</strong><div>@NA(asset.Status)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Criticality"]</strong><div>@NA(asset.CriticalityClass)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Maintenance Class"]</strong><div>@NA(asset.MaintenanceClass)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Functional Location"]</strong><div>@NA(asset.FunctionalLocation)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Commissioning Date"]</strong><div>@(asset.CommissioningDate?.ToString("yyyy-MM-dd") ?? "N/A")</div></div>
                </div>
            }
            else
            {
                <p class="text-muted small">@Localizer["Cm_NoAsset"]</p>
                <form asp-controller="Asset" asp-action="Create" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
                    <div class="col-md-4">
                        <label class="form-label small">@Localizer["Asset Number"]</label>
                        <input name="assetNumber" class="form-control form-control-sm" placeholder="AST-@eq.TagNumber" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">@Localizer["Maintenance Class"]</label>
                        <input name="maintenanceClass" class="form-control form-control-sm" placeholder="Rotating, Static ..." />
                    </div>
                    <div class="col-md-2">
                        <input type="hidden" name="status" value="Active" />
                        <pems-button tone="primary" size="small" type="submit"><i class="bi bi-plus-lg"></i> @Localizer["Cm_CreateAsset"]</pems-button>
                    </div>
                </form>
            }
        </div>
    </div>

    @* ===================== Documents ===================== *@
    <div class="tab-pane fade" id="tab-documents" role="tabpanel">
        <div class="content-card mb-3">
            <h6 class="mb-3"><i class="bi bi-file-earmark-text"></i> @Localizer["Cm_SecEngDocs"]</h6>
            <div class="table-responsive table-scroll-area" style="max-height:55vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cm_DocNo"]</th><th>@Localizer["Cm_Title"]</th><th>@Localizer["Cm_Type"]</th><th>@Localizer["Cm_Discipline"]</th><th>@Localizer["Cm_Rev"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Documents)
                    {
                        <tr>
                            <td>@d.DocumentNo</td><td>@d.Title</td><td>@d.DocumentType</td><td>@d.DisciplineName</td>
                            <td>@d.RevisionNo</td><td><pems-badge tone="none" css="badge-status-@d.Status">@d.Status</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId"><i class="bi bi-eye"></i></pems-button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.Documents.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoDocs"]</p> }
        </div>

        <div class="content-card">
            <h6 class="mb-3"><i class="bi bi-journal-check"></i> @Localizer["Cm_SecVdr"]</h6>
            <div class="table-responsive table-scroll-area" style="max-height:55vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cm_DocNo"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Vendor"]</th><th>@Localizer["Cm_Rev"]</th><th>@Localizer["Cm_Category"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model.VDRItems)
                    {
                        <tr>
                            <td>@v.DocumentNumber</td><td>@v.DocumentDescription</td><td>@v.VendorName</td>
                            <td>@v.LatestRevisionNo</td><td>@v.LatestReviewCategory</td>
                            <td><pems-badge tone="neutral">@v.WorkflowStatus</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="VDR" asp-action="Details" asp-route-id="@v.VDRItemId"><i class="bi bi-eye"></i></pems-button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.VDRItems.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoVdr"]</p> }
        </div>
    </div>

    @* ===================== Procurement ===================== *@
    <div class="tab-pane fade" id="tab-procurement" role="tabpanel">
        <div class="content-card">
            <h6 class="mb-3"><i class="bi bi-cart-check"></i> @Localizer["Cm_SecMr"]</h6>
            <div class="table-responsive table-scroll-area" style="max-height:60vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cm_MrNumber"]</th><th>@Localizer["Cm_Project"]</th><th>@Localizer["Cm_Discipline"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var m in Model.RelatedMRs)
                    {
                        <tr>
                            <td>@m.MRNumber</td><td>@m.ProjectName</td><td>@m.DisciplineName</td><td>@m.Description</td>
                            <td><pems-badge tone="neutral">@m.Status</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@m.MRId"><i class="bi bi-eye"></i></pems-button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.RelatedMRs.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoMr"]</p> }
        </div>
    </div>

    @* ===================== Maintenance ===================== *@
    <div class="tab-pane fade" id="tab-maintenance" role="tabpanel">
        @{ var reliability = ViewBag.Reliability as PEMS.Application.DTOs.EquipmentReliabilityDto; }
        @if (reliability != null && reliability.FailureCount > 0)
        {
            <div class="content-card mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="bi bi-graph-up-arrow"></i> @Localizer["Cm_Reliability"]</h6>
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Reliability" asp-action="Details" asp-route-id="@eq.EquipmentId">
                        <i class="bi bi-clock-history"></i> @Localizer["Cm_FailureHistory"]
                    </pems-button>
                </div>
                <div class="row g-2 text-center">
                    <div class="col-md-3"><div class="small text-muted">@Localizer["MTBF"]</div><div class="fw-bold">@(reliability.MTBFHours.HasValue ? $"{reliability.MTBFHours.Value:N1} h" : "N/A")</div></div>
                    <div class="col-md-3"><div class="small text-muted">@Localizer["MTTR"]</div><div class="fw-bold">@(reliability.MTTRHours.HasValue ? $"{reliability.MTTRHours.Value:N1} h" : "N/A")</div></div>
                    <div class="col-md-3"><div class="small text-muted">@Localizer["Availability"]</div><div class="fw-bold">@(reliability.AvailabilityPercent.HasValue ? $"{reliability.AvailabilityPercent.Value:N1}%" : "N/A")</div></div>
                    <div class="col-md-3"><div class="small text-muted">@Localizer["Failure Count"]</div><div class="fw-bold">@reliability.FailureCount</div></div>
                </div>
            </div>
        }
        @* استراتژی و PM (فقط خواندنی) - از روابط موجود MaintenanceStrategy/MaintenancePlan.EquipmentId *@
        <div class="content-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0"><i class="bi bi-diagram-2"></i> @Localizer["Cm_StrategyPm"]</h6>
                <span class="d-flex gap-2">
                    @if (ViewBag.CanViewStrategy == true) { <a asp-controller="MaintenanceStrategy" asp-action="Index" asp-route-equipmentId="@eq.EquipmentId" class="vs-btn vs-btn--sm">@Localizer["Cm_Strategies"]</a> }
                    @if (ViewBag.CanViewPlan == true) { <a asp-controller="MaintenancePlan" asp-action="Index" class="vs-btn vs-btn--sm">@Localizer["Cm_PmPlans"]</a> }
                </span>
            </div>
            @if (!Model.Strategies.Any() && !Model.Plans.Any())
            {
                <p class="text-muted mb-0 small">@Localizer["Cm_NoStrategy"]</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-enterprise mb-0">
                    <thead><tr><th>@Localizer["Cm_Kind"]</th><th>@Localizer["Cm_Reference"]</th><th>@Localizer["Cm_Trigger"]</th><th>@Localizer["Cm_Interval"]</th><th>@Localizer["Cm_LastDone"]</th><th>@Localizer["Cm_NextDue"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Strategies)
                        {
                            <tr>
                                <td>@Localizer["Cm_Strategy"]</td>
                                <td>@s.StrategyType <span class="vs-sub">@s.ConsequenceCategory</span></td>
                                <td>@s.RecommendedTriggerType</td>
                                <td class="vs-num">@(string.IsNullOrWhiteSpace(s.Frequency) ? "—" : s.Frequency)</td>
                                <td>—</td><td>—</td>
                            </tr>
                        }
                        @foreach (var p in Model.Plans)
                        {
                            <tr>
                                <td>@Localizer["Cm_PmPlan"]</td>
                                <td><span class="vs-num">@p.PlanNumber</span> <span class="vs-sub">@p.Title</span></td>
                                <td>@p.TriggerType</td>
                                <td class="vs-num">@(p.IntervalDays.HasValue ? p.IntervalDays + " d" : "—")</td>
                                <td class="vs-num">@(p.LastExecutionDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="vs-num">
                                    @if (p.NextDueDate.HasValue)
                                    {
                                        var overdue = p.NextDueDate.Value.Date < DateTime.Today;
                                        <span class="vs-pill vs-pill--icon @(overdue ? "vs-pill--danger" : "vs-pill--neutral")"><i class="bi @(overdue ? "bi-exclamation-triangle" : "bi-calendar-event")" aria-hidden="true"></i> @p.NextDueDate.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else { <span>—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>

        <div class="content-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0"><i class="bi bi-clipboard-plus"></i> @Localizer["Cm_MaintHistoryWr"]</h6>
                @if (canCreateWr)
                {
                    <a asp-controller="WorkRequest" asp-action="Create" asp-route-equipmentId="@eq.EquipmentId" class="vs-btn vs-btn--primary vs-btn--sm">
                        <i class="bi bi-plus-lg"></i> @Localizer["Cm_NewWorkRequest"]
                    </a>
                }
            </div>
            <div class="table-responsive table-scroll-area" style="max-height:50vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cm_WrNumber"]</th><th>@Localizer["Cm_Title"]</th><th>@Localizer["Cm_Priority"]</th><th>@Localizer["Cm_Status"]</th><th>@Localizer["Cm_Requested"]</th><th>@Localizer["Cm_LinkedWo"]</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.WorkRequests)
                    {
                        <tr>
                            <td class="vs-num">@if (canViewWr) { <a asp-controller="WorkRequest" asp-action="Details" asp-route-id="@r.WorkRequestId">@r.RequestNumber</a> } else { @r.RequestNumber }</td>
                            <td>@r.Title</td>
                            <td><span class="vs-pill @PrioTone(r.Priority)">@r.Priority</span></td>
                            <td><span class="vs-pill vs-pill--icon @WrTone(r.Status)"><i class="bi @WrIcon(r.Status)" aria-hidden="true"></i> @r.Status</span></td>
                            <td class="vs-num">@r.RequestedDate.ToString("yyyy-MM-dd")</td>
                            <td class="vs-num">@if (r.LinkedWorkOrderId.HasValue) { if (canViewWo) { <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@r.LinkedWorkOrderId">@r.LinkedWorkOrderNo</a> } else { @r.LinkedWorkOrderNo } } else { <span class="text-muted">—</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.WorkRequests.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoWorkRequests"]</p> }
        </div>

        @* Work Orderهای اجراشده: فقط خواندنی - ساخت Work Order از این بخش مجاز نیست؛ فقط از Work Request تاییدشده *@
        <div class="content-card">
            <h6 class="mb-2"><i class="bi bi-tools"></i> @Localizer["Cm_ExecutedWo"]</h6>
            <div class="table-responsive table-scroll-area" style="max-height:40vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cm_WoNumber"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Status"]</th><th>@Localizer["Cm_Date"]</th></tr></thead>
                <tbody>
                    @foreach (var w in Model.WorkOrders)
                    {
                        <tr>
                            <td class="vs-num">@if (canViewWo) { <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNo</a> } else { @w.WorkOrderNo }</td>
                            <td>@w.Description</td>
                            <td><span class="vs-pill">@w.Status</span></td>
                            <td class="vs-num">@(w.CreatedDate?.ToString("yyyy-MM-dd"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.WorkOrders.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoWorkOrders"]</p> }
        </div>
    </div>

    @* ===================== Inspections ===================== *@
    <div class="tab-pane fade" id="tab-inspection" role="tabpanel">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0"><i class="bi bi-clipboard-pulse"></i> @Localizer["Cm_SecInspections"]</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#newInspectionModal">
                    <i class="bi bi-plus-lg"></i> @Localizer["Cm_NewInspection"]
                </pems-button>
            </div>
            <table class="table table-enterprise mb-0">
                <thead>
                    <tr><th>@Localizer["Cm_Type"]</th><th>@Localizer["Cm_Date"]</th><th>@Localizer["Cm_Measurement"]</th><th>@Localizer["Cm_Condition"]</th><th>@Localizer["Cm_NextDue"]</th><th>@Localizer["Cm_DueStatus"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var i in inspections)
                    {
                        <tr>
                            <td class="small">@i.InspectionType</td>
                            <td class="small">@i.InspectionDate.ToString("yyyy-MM-dd")</td>
                            <td class="small">@(i.MeasurementValue.HasValue ? $"{i.MeasurementValue.Value:N2} {i.MeasurementUnit}" : "-")</td>
                            <td class="small">
                                @switch (i.ConditionStatus)
                                {
                                    case "Alert": <pems-badge tone="danger">@Localizer["Alert"]</pems-badge> break;
                                    case "Normal": <pems-badge tone="success">@Localizer["Normal"]</pems-badge> break;
                                    default: <span class="text-muted">N/A</span> break;
                                }
                            </td>
                            <td class="small">@(i.NextInspectionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="small">
                                @switch (i.DueStatus)
                                {
                                    case "Overdue": <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge> break;
                                    case "DueSoon": <pems-badge tone="warning">@Localizer["Due Soon"]</pems-badge> break;
                                    case "OK": <pems-badge tone="success">OK</pems-badge> break;
                                    default: <span class="text-muted">N/A</span> break;
                                }
                            </td>
                            <td>
                                @if (i.ConditionStatus == "Alert")
                                {
                                    <form asp-controller="Inspection" asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                        <input type="hidden" name="inspectionRecordId" value="@i.InspectionRecordId" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit"><i class="bi bi-exclamation-triangle"></i> @Localizer["Cm_RaiseWr"]</pems-button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!inspections.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoInspections"]</p> }
        </div>

        <div class="modal fade" id="newInspectionModal" tabindex="-1">
            <div class="modal-dialog"><div class="modal-content">
                <form asp-controller="Inspection" asp-action="Create" method="post">
                    <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
                    <div class="modal-header"><h6 class="modal-title">New Inspection</h6></div>
                    <div class="modal-body">
                        <div class="mb-2"><label class="form-label small">Inspection Type</label>
                            <input name="inspectionType" class="form-control form-control-sm" placeholder="Vibration, Thickness, Visual..." required /></div>
                        <div class="mb-2"><label class="form-label small">Inspection Date</label>
                            <input name="inspectionDate" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                        <div class="mb-2"><label class="form-label small">@Localizer["Inspector"]</label>
                            <input name="inspector" class="form-control form-control-sm" /></div>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="form-label small">Measurement Value</label>
                                <input name="measurementValue" type="number" step="0.01" class="form-control form-control-sm" /></div>
                            <div class="col-6"><label class="form-label small">@Localizer["Unit"]</label>
                                <input name="measurementUnit" class="form-control form-control-sm" placeholder="mm/s, mm, °C..." /></div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="form-label small">Lower Limit</label>
                                <input name="lowerLimit" type="number" step="0.01" class="form-control form-control-sm" /></div>
                            <div class="col-6"><label class="form-label small">Upper Limit</label>
                                <input name="upperLimit" type="number" step="0.01" class="form-control form-control-sm" /></div>
                        </div>
                        <div class="mb-2"><label class="form-label small">Next Inspection Date</label>
                            <input name="nextInspectionDate" type="date" class="form-control form-control-sm" /></div>
                        <div class="mb-2"><label class="form-label small">Recommendation</label>
                            <textarea name="recommendation" class="form-control form-control-sm" rows="2"></textarea></div>
                        <div class="mb-2"><label class="form-label small">@Localizer["Description"]</label>
                            <textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </div></div>
        </div>
    </div>

    @* ===================== Quality & Change ===================== *@
    <div class="tab-pane fade" id="tab-quality" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="content-card h-100">
                    <h6 class="mb-3"><i class="bi bi-exclamation-triangle"></i> NCR <pems-badge tone="neutral">@Model.NonConformanceReports.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var n in Model.NonConformanceReports)
                        {
                            <li class="d-flex justify-content-between border-bottom py-1">
                                <a asp-controller="QC" asp-action="NcrDetails" asp-route-id="@n.NodeId">@n.Label</a>
                                <pems-badge tone="@(n.Priority == "Urgent" ? "danger" : "neutral")">@n.SubLabel</pems-badge>
                            </li>
                        }
                    </ul>
                    @if (!Model.NonConformanceReports.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </div>
            </div>
            <div class="col-md-4">
                <div class="content-card h-100">
                    <h6 class="mb-3"><i class="bi bi-arrow-repeat"></i> MOC <pems-badge tone="neutral">@Model.MOCs.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var m in Model.MOCs)
                        {
                            <li class="d-flex justify-content-between border-bottom py-1">
                                <a asp-controller="MOC" asp-action="Details" asp-route-id="@m.NodeId">@m.Label</a>
                                <pems-badge tone="@(m.Priority == "Urgent" ? "danger" : "neutral")">@m.SubLabel</pems-badge>
                            </li>
                        }
                    </ul>
                    @if (!Model.MOCs.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </div>
            </div>
            <div class="col-md-4">
                <div class="content-card h-100">
                    <h6 class="mb-3"><i class="bi bi-question-circle"></i> TQ / TSR / RFI <pems-badge tone="neutral">@Model.TechnicalQueries.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var t in Model.TechnicalQueries)
                        {
                            <li class="d-flex justify-content-between border-bottom py-1">
                                <a asp-controller="TechnicalQuery" asp-action="Details" asp-route-id="@t.NodeId">@t.Label</a>
                                <pems-badge tone="@(t.Priority == "Urgent" ? "danger" : "neutral")">@t.SubLabel</pems-badge>
                            </li>
                        }
                    </ul>
                    @if (!Model.TechnicalQueries.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </div>
            </div>
        </div>
    </div>

    @* ===================== Classification & Maintenance Intelligence ===================== *@
    <div class="tab-pane fade" id="tab-classification" role="tabpanel">
        @{
            var intel = ViewBag.MaintenanceIntelligence as PEMS.Application.DTOs.EquipmentMaintenanceIntelligenceDto;
            var explanation = ViewBag.ClassificationExplanation as PEMS.Application.DTOs.ClassificationExplanationDto;
        }
        <div class="content-card mb-3">
            <h6 class="mb-3"><i class="bi bi-diagram-3-fill"></i> @Localizer["Cm_SecClassification"]</h6>
            @if (intel?.EquipmentClassId != null)
            {
                <div class="row g-2 small">
                    <div class="col-md-3"><strong>@Localizer["Equipment Class"]</strong><div>@intel.EquipmentClassName <code>@intel.EquipmentClassCode</code></div></div>
                    <div class="col-md-3"><strong>Class Hierarchy</strong><div>@string.Join(" ← ", intel.ResolvedClassHierarchy)</div></div>
                    <div class="col-md-3"><strong>@Localizer["Confidence"]</strong><div><pems-badge tone="info">@intel.ClassificationConfidence</pems-badge></div></div>
                    <div class="col-md-3"><strong>@Localizer["Source"]</strong><div><pems-badge tone="neutral">@intel.ClassificationSource</pems-badge></div></div>
                </div>
                @if (explanation?.MatchedRuleTier != null)
                {
                    <div class="alert alert-light border small mt-3 mb-0">
                        <strong>@Localizer["چرا این طبقه‌بندی؟"]</strong>
                        Rule tier: <pems-badge tone="light">@explanation.MatchedRuleTier</pems-badge> &middot;
                        Matched on: <code>@explanation.MatchedInput</code> &middot;
                        @explanation.Reason
                    </div>
                }
            }
            else
            {
                <p class="text-muted small mb-0">این تجهیز هنوز طبقه‌بندی نشده (EquipmentType: <code>@eq.EquipmentType</code>).</p>
            }

            @if (pendingSuggestion != null)
            {
                <pems-alert tone="warning" css="small mt-3 mb-0">
                    <strong>پیشنهاد در انتظار بازبینی:</strong> @pendingSuggestion.SuggestedEquipmentClassName
                    (<pems-badge tone="warning">@pendingSuggestion.Confidence</pems-badge>) &mdash; @pendingSuggestion.Reason
                    <a asp-controller="EquipmentClassification" asp-action="ReviewQueue" class="ms-2">بازبینی در صف →</a>
                </pems-alert>
            }
        </div>

        @if (intel?.EquipmentClassId != null)
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="content-card h-100">
                        <h6 class="mb-3">@Localizer["Cm_ApplicableActivities"] <pems-badge tone="neutral">@intel.ApplicableActivities.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var a in intel.ApplicableActivities)
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@a.Name</span>
                                    <span class="text-muted">@a.Source</span>
                                </li>
                            }
                        </ul>
                        @if (!intel.ApplicableActivities.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="content-card h-100">
                        <h6 class="mb-3">@Localizer["Cm_PmTemplates"] <pems-badge tone="neutral">@intel.CandidatePMTemplates.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var t in intel.CandidatePMTemplates)
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@t.Name (@t.TriggerType@(t.IntervalDays.HasValue ? $" / {t.IntervalDays}d" : ""))</span>
                                    <span class="text-muted">@t.Source</span>
                                </li>
                            }
                        </ul>
                        @if (!intel.CandidatePMTemplates.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="content-card h-100">
                        <h6 class="mb-3">@Localizer["Cm_FailureModes"] <pems-badge tone="neutral">@intel.ApplicableFailureModes.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var fm in intel.ApplicableFailureModes)
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@fm.Name</span>
                                    <span class="text-muted">@fm.Source</span>
                                </li>
                            }
                        </ul>
                        @if (!intel.ApplicableFailureModes.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="content-card h-100">
                        <h6 class="mb-3">@Localizer["Cm_StdRefs"] <pems-badge tone="neutral">@intel.ApplicableStandardReferences.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var s in intel.ApplicableStandardReferences)
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span>@s.Name</span>
                                    <code>@s.Code</code>
                                </li>
                            }
                        </ul>
                        @if (!intel.ApplicableStandardReferences.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </div>
                </div>
            </div>
        }
    </div>

    @* ===================== Barcode ===================== *@
    <div class="tab-pane fade" id="tab-barcode" role="tabpanel">
        <partial name="_BarcodePanel" model="(PEMS.Web.Models.BarcodePanelViewModel)ViewBag.BarcodePanel" />
    </div>

</div>

</div> @* end .vs-page *@

@section Scripts {
    <script>
        // Summary chips jump to the matching tab (Bootstrap tabs only activate from inside a .nav/tablist, so drive the real tab button)
        document.querySelectorAll('[data-goto-tab]').forEach(function (chip) {
            chip.addEventListener('click', function () {
                var btn = document.querySelector('#equipmentTabs [data-bs-target="' + chip.getAttribute('data-goto-tab') + '"]');
                if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
            });
        });
    </script>
}
