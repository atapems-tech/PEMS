@model PEMS.Application.DTOs.EquipmentPassportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var eq = Model.Equipment;
    var inst = Model.Instrument;
    var asset = Model.Asset;
    var mech = Model.MechanicalEquipment;
    var cm = Model.ConditionMonitoring;

    string CmEvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        "RequiresEngineeringReview" => "bg-info text-dark",
        _ => "bg-secondary"
    };
    var inspections = ViewBag.Inspections as List<PEMS.Application.DTOs.InspectionListItemDto> ?? new();

    var calBadgeClass = inst?.CalibrationStatus switch
    {
        "Overdue" => "danger",
        "DueSoon" => "warning",
        "OK" => "success",
        _ => "neutral"
    };

    bool canCreateWr = ViewBag.CanCreateWorkRequest == true, canViewWr = ViewBag.CanViewWorkRequest == true, canViewWo = ViewBag.CanViewWorkOrder == true;
    string WrTone(string s) => s switch { "Converted" or "Approved" or "Planned" => "vs-pill--success", "Rejected" => "vs-pill--danger", "Cancelled" or "Draft" => "vs-pill--neutral", _ => "vs-pill--info" };
    string WrIcon(string s) => s switch { "Draft" => "bi-pencil", "Submitted" => "bi-send", "UnderReview" => "bi-hourglass-split", "Approved" => "bi-check-circle", "Planned" => "bi-calendar-check", "Converted" => "bi-box-arrow-up-right", "Rejected" => "bi-x-circle", "Cancelled" => "bi-slash-circle", _ => "bi-circle" };
    string PrioTone(string s) => s switch { "Critical" => "vs-pill--danger", "High" => "vs-pill--warning", _ => "vs-pill--neutral" };
    string NA(string? v) => string.IsNullOrWhiteSpace(v) ? "N/A" : v;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

@* طراحی جدید: به‌جای یک صفحه‌ی طولانی با هفت جدول/بخش پشت سر هم، محتوا در تب‌ها سازمان‌دهی شده -
   همان الگویی که در EngineeringDocuments/Details.cshtml و VDR/Details.cshtml استفاده شده. هیچ
   داده‌ای حذف نشده - فقط پشت تب‌هایی که فقط وقتی کاربر انتخاب کند نمایش داده می‌شوند، دسته‌بندی شده.
   طبق درخواست: شناسنامه‌ی ابزاردقیق (در صورت وجود) حالا بخشی از همین صفحه است، نه فقط یک لینک بیرونی. *@

<pems-page-shell kind="workspace">
<div class="vs-section">
    <div class="vs-doc-head">
        <div class="vs-doc-identity">
            <pems-flex align="center" gap="2" wrap="true">
                <h2 class="vs-doc-number vs-num">@eq.TagNumber</h2>
                <span class="vs-pill vs-pill--icon vs-pill--success"><pems-icon name="bi-check-circle" aria-hidden="true" /> @eq.Status</span>
                @if (!string.IsNullOrWhiteSpace(eq.CriticalityClass))
                {
                    <span class="vs-pill vs-pill--icon @(eq.CriticalityClass == "A" ? "vs-pill--danger" : eq.CriticalityClass == "B" ? "vs-pill--warning" : "vs-pill--neutral")" title="Criticality Class"><pems-icon name="bi-exclamation-diamond" aria-hidden="true" /> @Localizer["Cm_Criticality"] @eq.CriticalityClass</span>
                }
                @if (inst != null)
                {
                    <span class="vs-pill vs-pill--icon @(inst.CalibrationStatus == "Overdue" ? "vs-pill--danger" : inst.CalibrationStatus == "DueSoon" ? "vs-pill--warning" : inst.CalibrationStatus == "OK" ? "vs-pill--success" : "vs-pill--neutral")" title="Calibration status"><pems-icon name="bi-speedometer2" aria-hidden="true" /> @Localizer["Cm_Cal"]: @inst.CalibrationStatus</span>
                }
            </pems-flex>
            <div class="vs-doc-title">@eq.Name</div>
            <div class="vs-doc-meta">@eq.EquipmentType &middot; @eq.ProjectName &middot; @eq.DisciplineName @(string.IsNullOrWhiteSpace(eq.Area) ? "" : "· " + eq.Area)</div>
        </div>
        <div class="vs-doc-actions">
            <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="@eq.EquipmentId" class="vs-btn"><pems-icon name="bi-diagram-3" /> @Localizer["Cm_Relationships"]</a>
            <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#assignFoundationModal" title="Assign Functional Location / Parent Equipment"><pems-icon name="bi-pencil" /> @Localizer["Cm_AssignLocation"]</button>
        </div>
    </div>
    <pems-info-grid>
        <pems-info-item label="P&ID" num>
            @if (Model.PIDDocument != null)
            {
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.PIDDocument.DocumentId">@eq.PIDNumber <pems-icon name="bi-box-arrow-up-right" css="small" /></a>
            }
            else if (!string.IsNullOrWhiteSpace(eq.PIDNumber)) { <span title="@Localizer["مدرکی با این شماره پیدا نشد"]">@eq.PIDNumber</span> }
            else { <span class="text-muted">N/A</span> }
        </pems-info-item>
        <pems-info-item label="@Localizer["Cm_ManufacturerModel"]" num>@NA(eq.Manufacturer) / @NA(eq.Model)</pems-info-item>
        <pems-info-item label="@Localizer["Cm_FunctionalLocation"]">@NA(eq.FunctionalLocationBreadcrumb)</pems-info-item>
        <pems-info-item label="@Localizer["Cm_ParentEquipment"]" num>
            @if (eq.ParentEquipmentId.HasValue) { <a asp-action="Details" asp-route-id="@eq.ParentEquipmentId">@eq.ParentEquipmentTagNumber</a> } else { <span class="text-muted">N/A</span> }
        </pems-info-item>
        <pems-info-item label="@Localizer["Cm_InstallationDate"]" num>@(eq.InstallationDate?.ToString("yyyy-MM-dd") ?? "N/A")</pems-info-item>
        <pems-info-item label="@Localizer["Cm_Description"]" wide>@NA(eq.Description)</pems-info-item>
        @if (eq.ChildEquipments.Any())
        {
            <pems-info-item label="@Localizer["Cm_ChildEquipment"] (@eq.ChildEquipmentCount)" wide>
                @foreach (var c in eq.ChildEquipments) { <a asp-action="Details" asp-route-id="@c.EquipmentId" class="vs-chip text-decoration-none vs-num me-1">@c.TagNumber</a> }
            </pems-info-item>
        }
    </pems-info-grid>
</div>

<pems-modal id="assignFoundationModal" tabindex="-1">
        <form asp-action="AssignFoundation" method="post">
            <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
            <pems-modal-header>@Localizer["Cm_AssignTitle"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Functional Location"]</pems-label>
                    <pems-select scale="small" name="functionalLocationId">
                        <option value="">@Localizer["-- not linked --"]</option>
                        @foreach (var fl in (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                        {
                            <option value="@fl.FunctionalLocationId" selected="@(fl.FunctionalLocationId == eq.FunctionalLocationId)">@fl.PathBreadcrumb</option>
                        }
                    </pems-select>
                    @* طبق «PEMS CMMS — Equipment Functional Location Assignment & Import» بند «Existing
                       Assignment Protection»: تخصیص فعلی باید صریحاً قابل‌دیدن باشد، نه فقط ضمنی از
                       طریق گزینه‌ی از‌قبل‌انتخاب‌شده‌ی Select - عیناً همون الگوی «Currently: ...» که
                       همین Modal برای Parent Equipment پایین‌تر دارد. *@
                    @if (eq.FunctionalLocationId.HasValue)
                    {
                        var currentFl = ((List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                            .FirstOrDefault(x => x.FunctionalLocationId == eq.FunctionalLocationId);
                        <pems-help-text>Currently: @(currentFl?.PathBreadcrumb ?? NA(eq.FunctionalLocationBreadcrumb))</pems-help-text>
                    }
                    <pems-help-text>Real link, distinct from the raw "@NA(eq.Area)" import value. <a asp-controller="FunctionalLocation" asp-action="Index" target="_blank">@Localizer["Manage list"]</a></pems-help-text>
                </div>
                <div class="mb-2">
                    <pems-label css="small">Parent Equipment</pems-label>
                    <pems-input scale="small" type="text" placeholder="Search tag, name..." data-pems-search data-search-type="Equipment" data-search-hidden="#parentEquipmentIdHidden" autocomplete="off" />
                    <input type="hidden" name="parentEquipmentId" id="parentEquipmentIdHidden" value="@eq.ParentEquipmentId" />
                    @if (eq.ParentEquipmentId.HasValue)
                    {
                        <pems-help-text>Currently: @eq.ParentEquipmentTagNumber</pems-help-text>
                    }
                </div>
                <div class="mb-2">
                    <pems-label css="small">Installation Date</pems-label>
                    <pems-date name="installationDate" value="@eq.InstallationDate?.ToString("yyyy-MM-dd")" scale="small" />
                </div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

@if (Model.SuggestedLinks.Any())
{
    <pems-content-card css="mb-3 border-warning">
        <h6 class="mb-3"><pems-icon name="bi-lightbulb" /> پیشنهادهای اتصال (تاییدنشده)</h6>
        <p class="text-muted small">
            این‌ها از روی شماره‌ی MRQ/PO خام ثبت‌شده روی تجهیز، با داده‌ی موجود منطبق شده‌اند.
            برای تایید و برقراری رسمی رابطه، به <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="@eq.EquipmentId">Relationship Explorer</a> برو.
        </p>
        <pems-flex wrap="true" gap="2">
            @foreach (var s in Model.SuggestedLinks)
            {
                <pems-badge tone="warning"><pems-icon name="bi-robot" /> @s.Label <span class="small">(@s.SubLabel)</span></pems-badge>
            }
        </pems-flex>
    </pems-content-card>
}

@{ var pendingSuggestion = ViewBag.PendingClassificationSuggestion as PEMS.Application.DTOs.ReviewQueueItemDto; }
<pems-nav css="mb-3" id="equipmentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <pems-icon name="bi-info-circle" /> @Localizer["Cm_TabOverview"]
        </button>
    </li>
    @if (inst != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-instrument" type="button">
                <pems-icon name="bi-card-text" /> @Localizer["Cm_InstrumentPassport"]
            </button>
        </li>
    }
    @if (mech != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mechanical" type="button">
                <pems-icon name="bi-gear-wide-connected" /> @Localizer["Mechanical Passport"]
            </button>
        </li>
    }
    @if (cm != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cm" type="button">
                <pems-icon name="bi-activity" /> @Localizer["Condition Monitoring"]
                @if (cm.OpenFindingCount > 0) { <pems-badge tone="danger">@cm.OpenFindingCount</pems-badge> }
            </button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-barcode" type="button">
            <pems-icon name="bi-upc-scan" /> @Localizer["Cm_TabBarcode"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-asset" type="button">
            <pems-icon name="bi-diagram-2" /> @Localizer["Cm_TabAsset"]
            @if (asset != null) { <pems-badge tone="neutral">@asset.Status</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button">
            <pems-icon name="bi-file-earmark-text" /> @Localizer["Cm_EngDocs"]
            <pems-badge tone="neutral">@(Model.Documents.Count + Model.VDRItems.Count)</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-procurement" type="button">
            <pems-icon name="bi-cart-check" /> @Localizer["Cm_TabProcurement"] <pems-badge tone="neutral">@Model.RelatedMRs.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-maintenance" type="button">
            <pems-icon name="bi-tools" /> @Localizer["Cm_TabMaintenance"] <pems-badge tone="neutral">@Model.WorkRequests.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-inspection" type="button">
            <pems-icon name="bi-clipboard-pulse" /> @Localizer["Cm_TabInspections"]
            @if (inspections.Any()) { <pems-badge tone="neutral">@inspections.Count</pems-badge> }
            @if (inspections.Any(x => x.ConditionStatus == "Alert")) { <pems-badge tone="danger">@Localizer["Alert"]</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-quality" type="button">
            <pems-icon name="bi-shield-exclamation" /> @Localizer["Cm_TabQuality"]
            @{ var qcCount = Model.NonConformanceReports.Count + Model.MOCs.Count + Model.TechnicalQueries.Count; }
            @if (qcCount > 0) { <pems-badge tone="neutral">@qcCount</pems-badge> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-classification" type="button">
            <pems-icon name="bi-diagram-3-fill" /> @Localizer["Cm_TabClassification"]
            @if (pendingSuggestion != null) { <pems-badge tone="warning">1</pems-badge> }
        </button>
    </li>
</pems-nav>

<pems-tab-content>

    @* ===================== Overview ===================== *@
    <pems-tab-pane fade="true" active="true" id="tab-overview" role="tabpanel">
        @{ var pendingWr = Model.WorkRequests.Count(w => w.Status is "Draft" or "Submitted" or "UnderReview" or "Approved" or "Planned"); }
        <div class="vs-chips">
            <button type="button" class="vs-chip" data-goto-tab="#tab-documents"><pems-icon name="bi-file-earmark-text" /> @Localizer["Cm_EngDocs"] <strong>@Model.Documents.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-documents"><pems-icon name="bi-journal-check" /> VDR <strong>@Model.VDRItems.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-procurement"><pems-icon name="bi-cart-check" /> MR <strong>@Model.RelatedMRs.Count</strong></button>
            <button type="button" class="vs-chip @(pendingWr > 0 ? "vs-chip--danger" : "")" data-goto-tab="#tab-maintenance"><pems-icon name="bi-clipboard-plus" /> @Localizer["Cm_WorkRequests"] <strong>@Model.WorkRequests.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-maintenance"><pems-icon name="bi-tools" /> @Localizer["Cm_WorkOrders"] <strong>@Model.WorkOrders.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">NCR <strong>@Model.NonConformanceReports.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">MOC <strong>@Model.MOCs.Count</strong></button>
            <button type="button" class="vs-chip" data-goto-tab="#tab-quality">TQ / TSR / RFI <strong>@Model.TechnicalQueries.Count</strong></button>
        </div>

        @if (inst != null)
        {
            <pems-content-card css="mt-3">
                <pems-flex justify="between" align="center">
                    <h6 class="mb-0"><pems-icon name="bi-card-text" /> @Localizer["Cm_InstrumentPassport"]</h6>
                    <span class="small text-muted">See the "Instrument Passport" tab for full details, calibration history and print.</span>
                </pems-flex>
                <pems-row gap="2" css="small mt-2">
                    <pems-col md="3"><strong>@Localizer["Type"]</strong><div>@NA(inst.InstrumentType)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Loop No."]</strong><div>@NA(inst.LoopNumber)</div></pems-col>
                    <pems-col md="3"><strong>System / Signal</strong><div>@NA(inst.System) / @NA(inst.SignalClass)</div></pems-col>
                    <pems-col md="3"><strong>Next Calibration</strong><div>@(inst.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "N/A") <pems-badge tone="@calBadgeClass">@inst.CalibrationStatus</pems-badge></div></pems-col>
                </pems-row>
            </pems-content-card>
        }
    </pems-tab-pane>

    @* ===================== Instrument Passport ===================== *@
    @if (inst != null)
    {
        <pems-tab-pane fade="true" id="tab-instrument" role="tabpanel">
            <pems-content-card css="mb-3">
                <pems-flex justify="between" align="center" css="mb-3">
                    <h6 class="mb-0">@Localizer["Cm_InstrumentPassport"]</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="Instrument" asp-action="Passport" asp-route-id="@inst.InstrumentId">
                        <pems-icon name="bi-card-text" /> @Localizer["Cm_FullPassport"]
                    </pems-button>
                </pems-flex>
                <pems-row gap="2" css="small">
                    <pems-col md="3"><strong>@Localizer["Instrument Type"]</strong><div>@NA(inst.InstrumentType)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Loop No."]</strong><div>@NA(inst.LoopNumber)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["System"]</strong><div>@NA(inst.System)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Signal Class"]</strong><div>@NA(inst.SignalClass)</div></pems-col>

                    <pems-col md="3"><strong>@Localizer["Process Variable"]</strong><div>@NA(inst.ProcessVariable)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Range"]</strong><div>@(inst.RangeMin?.ToString() ?? "N/A") - @(inst.RangeMax?.ToString() ?? "N/A") @inst.Unit</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Output Signal"]</strong><div>@NA(inst.OutputSignal)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Current Status"]</strong><div>@NA(inst.CurrentStatus)</div></pems-col>

                    <pems-col md="3"><strong>@Localizer["Hazardous Area"]</strong><div>@NA(inst.HazardousArea)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Ex Protection"]</strong><div>@NA(inst.ExProtection)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["SIL"]</strong><div>@NA(inst.SIL)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Calibration Interval"]</strong><div>@(inst.CalibrationInterval.HasValue ? inst.CalibrationInterval + " days" : "N/A")</div></pems-col>

                    <pems-col md="3"><strong>@Localizer["Junction Box"]</strong><div>@NA(inst.JunctionBox)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Marshalling Cabinet"]</strong><div>@NA(inst.MarshallingCabinet)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Cable No."]</strong><div>@NA(inst.CableNumber)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["I/O Card / Channel"]</strong><div>@NA(inst.IOCardChannel)</div></pems-col>

                    <pems-col md="3"><strong>@Localizer["System Cabinet"]</strong><div>@NA(inst.SystemCabinet)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Last Calibration"]</strong><div>@(inst.LastCalibrationDate?.ToString("yyyy-MM-dd") ?? "N/A")</div></pems-col>
                    <pems-col md="3"><strong>Next Calibration Due</strong><div>@(inst.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "N/A") <pems-badge tone="@calBadgeClass">@inst.CalibrationStatus</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>Next Maintenance Due</strong><div>@(inst.NextMaintenanceDue?.ToString("yyyy-MM-dd") ?? "N/A")</div></pems-col>
                </pems-row>
            </pems-content-card>
        </pems-tab-pane>
    }

    @* ===================== Mechanical Equipment Passport ===================== *@
    @if (mech != null)
    {
        <pems-tab-pane fade="true" id="tab-mechanical" role="tabpanel">
            <pems-content-card css="mb-3">
                <pems-flex justify="between" align="center" css="mb-3">
                    <h6 class="mb-0">@Localizer["Mechanical Passport"]</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="MechanicalEquipment" asp-action="Passport" asp-route-id="@mech.MechanicalEquipmentId">
                        <pems-icon name="bi-gear-wide-connected" /> @Localizer["Full Mechanical Passport"]
                    </pems-button>
                </pems-flex>
                <pems-row gap="2" css="small">
                    <pems-col md="3"><strong>@Localizer["Equipment Type"]</strong><div>@NA(mech.EquipmentType)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Sub-Type"]</strong><div><pems-badge tone="neutral">@mech.SubType</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Manufacturer"]</strong><div>@NA(mech.Manufacturer)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Model"]</strong><div>@NA(mech.Model)</div></pems-col>

                    <pems-col md="3"><strong>@Localizer["Design Pressure"]</strong><div>@(mech.DesignPressure?.ToString() ?? "N/A")</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Design Temperature"]</strong><div>@(mech.DesignTemperature?.ToString() ?? "N/A")</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Operating Pressure"]</strong><div>@(mech.OperatingPressure?.ToString() ?? "N/A")</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Operating Temperature"]</strong><div>@(mech.OperatingTemperature?.ToString() ?? "N/A")</div></pems-col>

                    @if (mech.SubType == "Rotating")
                    {
                        <pems-col md="3"><strong>@Localizer["Flow Rate"]</strong><div>@(mech.FlowRate?.ToString() ?? "N/A")</div></pems-col>
                        <pems-col md="3"><strong>@Localizer["Speed (RPM)"]</strong><div>@(mech.SpeedRPM?.ToString() ?? "N/A")</div></pems-col>
                        <pems-col md="3"><strong>@Localizer["Power (kW)"]</strong><div>@(mech.RotatingPowerKW?.ToString() ?? "N/A")</div></pems-col>
                        <pems-col md="3"><strong>@Localizer["Driver Type"]</strong><div>@NA(mech.DriverType)</div></pems-col>
                    }
                    else if (mech.SubType == "Static")
                    {
                        <pems-col md="3"><strong>@Localizer["Volume"]</strong><div>@(mech.Volume?.ToString() ?? "N/A")</div></pems-col>
                        <pems-col md="3"><strong>@Localizer["Orientation"]</strong><div>@NA(mech.Orientation)</div></pems-col>
                        <pems-col md="3"><strong>@Localizer["Code Standard"]</strong><div>@NA(mech.CodeStandard)</div></pems-col>
                    }
                </pems-row>
            </pems-content-card>
        </pems-tab-pane>
    }

    @* ===================== Condition Monitoring ===================== *@
    @if (cm != null)
    {
        <pems-tab-pane fade="true" id="tab-cm" role="tabpanel">
            <pems-content-card css="mb-3">
                <pems-flex justify="between" align="center" css="mb-3">
                    <h6 class="mb-0">@Localizer["Condition Monitoring"]</h6>
                    <pems-flex gap="2">
                        <pems-button tone="danger" size="small" outline="true" as="a" asp-controller="Finding" asp-action="Index" asp-route-equipmentId="@eq.EquipmentId">
                            <pems-icon name="bi-flag" /> @Localizer["Findings"] @(cm.OpenFindingCount > 0 ? $"({cm.OpenFindingCount})" : "")
                        </pems-button>
                        <pems-button tone="primary" size="small" as="a" asp-controller="Reliability" asp-action="ConditionMonitoring" asp-route-equipmentId="@eq.EquipmentId">
                            <pems-icon name="bi-activity" /> @Localizer["Full Condition Monitoring"]
                        </pems-button>
                    </pems-flex>
                </pems-flex>
                <pems-row gap="2" css="small mb-3">
                    <pems-col md="3"><strong>@Localizer["Monitoring Points"]:</strong> @cm.PointCount</pems-col>
                    <pems-col md="3"><strong>@Localizer["CBM Strategy"]:</strong> @(cm.HasCbmStrategy ? Localizer["Linked"] : Localizer["No"])</pems-col>
                    <pems-col md="3"><strong>@Localizer["Next Due"]:</strong> @(cm.NextDueDate?.ToString("yyyy-MM-dd") ?? "N/A")</pems-col>
                    <pems-col md="3"><strong>@Localizer["Findings"]:</strong> @cm.OpenFindingCount</pems-col>
                </pems-row>
                <pems-table kind="enterprise" scale="small" css="mb-0">
                    <thead><tr><th>@Localizer["Variable"]</th><th>@Localizer["Tag"]</th><th>@Localizer["Last Reading"]</th><th>@Localizer["Evaluation"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in cm.Points)
                        {
                            <tr class="@(p.LastReadingIsAlarm ? "table-danger" : "")">
                                <td>@p.VariableType</td>
                                <td dir="ltr">@p.Tag</td>
                                <td class="small">@(p.LastReadingDate.HasValue ? $"{p.LastValue} {p.Unit} @ {p.LastReadingDate.Value:yyyy-MM-dd}" : Localizer["No readings yet"])</td>
                                <td>
                                    @if (p.EvaluationProfileId.HasValue)
                                    {
                                        <pems-badge tone="none" css="@CmEvalBadge(p.LastReadingEvaluationStatus)">@p.LastReadingEvaluationStatus</pems-badge>
                                    }
                                    else
                                    {
                                        <pems-badge tone="neutral">@Localizer["NotEvaluated"]</pems-badge>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </pems-content-card>
        </pems-tab-pane>
    }

    @* ===================== Asset ===================== *@
    <pems-tab-pane fade="true" id="tab-asset" role="tabpanel">
        <pems-content-card>
            @if (asset != null)
            {
                <pems-flex justify="between" align="center" css="mb-3">
                    <h6 class="mb-0">Asset - @asset.AssetNumber</h6>
                    <pems-button tone="primary" size="small" as="a" asp-controller="Asset" asp-action="Details" asp-route-id="@asset.AssetId">
                        <pems-icon name="bi-diagram-2" /> @Localizer["Cm_FullAsset"]
                    </pems-button>
                </pems-flex>
                <pems-row gap="2" css="small">
                    <pems-col md="3"><strong>@Localizer["Status"]</strong><div>@NA(asset.Status)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Criticality"]</strong><div>@NA(asset.CriticalityClass)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Maintenance Class"]</strong><div>@NA(asset.MaintenanceClass)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Functional Location"]</strong><div>@NA(asset.FunctionalLocation)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Commissioning Date"]</strong><div>@(asset.CommissioningDate?.ToString("yyyy-MM-dd") ?? "N/A")</div></pems-col>
                </pems-row>
            }
            else
            {
                <p class="text-muted small">@Localizer["Cm_NoAsset"]</p>
                <form asp-controller="Asset" asp-action="Create" method="post"><pems-row gap="2" css="align-items-end">
                    <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
                    <pems-col md="4">
                        <pems-label css="small">@Localizer["Asset Number"]</pems-label>
                        <pems-input scale="small" name="assetNumber" placeholder="AST-@eq.TagNumber" required />
                    </pems-col>
                    <pems-col md="3">
                        <pems-label css="small">@Localizer["Maintenance Class"]</pems-label>
                        <pems-input scale="small" name="maintenanceClass" placeholder="Rotating, Static ..." />
                    </pems-col>
                    <pems-col md="2">
                        <input type="hidden" name="status" value="Active" />
                        <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-plus-lg" /> @Localizer["Cm_CreateAsset"]</pems-button>
                    </pems-col>
                </pems-row></form>
            }
        </pems-content-card>
    </pems-tab-pane>

    @* ===================== Documents ===================== *@
    <pems-tab-pane fade="true" id="tab-documents" role="tabpanel">
        <pems-content-card css="mb-3">
            <h6 class="mb-3"><pems-icon name="bi-file-earmark-text" /> @Localizer["Cm_SecEngDocs"]</h6>
            <pems-table-scroll css="table-scroll-area pems-s-b4b96c72">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Cm_DocNo"]</th><th>@Localizer["Cm_Title"]</th><th>@Localizer["Cm_Type"]</th><th>@Localizer["Cm_Discipline"]</th><th>@Localizer["Cm_Rev"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Documents)
                    {
                        <tr>
                            <td>@d.DocumentNo</td><td>@d.Title</td><td>@d.DocumentType</td><td>@d.DisciplineName</td>
                            <td>@d.RevisionNo</td><td><pems-badge tone="none" css="badge-status-@d.Status">@d.Status</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId"><pems-icon name="bi-eye" /></pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            </pems-table-scroll>
            @if (!Model.Documents.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoDocs"]</p> }
        </pems-content-card>

        <pems-content-card>
            <h6 class="mb-3"><pems-icon name="bi-journal-check" /> @Localizer["Cm_SecVdr"]</h6>
            <pems-table-scroll css="table-scroll-area pems-s-b4b96c72">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Cm_DocNo"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Vendor"]</th><th>@Localizer["Cm_Rev"]</th><th>@Localizer["Cm_Category"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model.VDRItems)
                    {
                        <tr>
                            <td>@v.DocumentNumber</td><td>@v.DocumentDescription</td><td>@v.VendorName</td>
                            <td>@v.LatestRevisionNo</td><td>@v.LatestReviewCategory</td>
                            <td><pems-badge tone="neutral">@v.WorkflowStatus</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="VDR" asp-action="Details" asp-route-id="@v.VDRItemId"><pems-icon name="bi-eye" /></pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            </pems-table-scroll>
            @if (!Model.VDRItems.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoVdr"]</p> }
        </pems-content-card>
    </pems-tab-pane>

    @* ===================== Procurement ===================== *@
    <pems-tab-pane fade="true" id="tab-procurement" role="tabpanel">
        <pems-content-card>
            <h6 class="mb-3"><pems-icon name="bi-cart-check" /> @Localizer["Cm_SecMr"]</h6>
            <pems-table-scroll css="table-scroll-area pems-s-a3f95238">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Cm_MrNumber"]</th><th>@Localizer["Cm_Project"]</th><th>@Localizer["Cm_Discipline"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Status"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var m in Model.RelatedMRs)
                    {
                        <tr>
                            <td>@m.MRNumber</td><td>@m.ProjectName</td><td>@m.DisciplineName</td><td>@m.Description</td>
                            <td><pems-badge tone="neutral">@m.Status</pems-badge></td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@m.MRId"><pems-icon name="bi-eye" /></pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            </pems-table-scroll>
            @if (!Model.RelatedMRs.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoMr"]</p> }
        </pems-content-card>
    </pems-tab-pane>

    @* ===================== Maintenance ===================== *@
    <pems-tab-pane fade="true" id="tab-maintenance" role="tabpanel">
        @{ var reliability = ViewBag.Reliability as PEMS.Application.DTOs.EquipmentReliabilityDto; }
        @if (reliability != null && reliability.FailureCount > 0)
        {
            <pems-content-card css="mb-3">
                <pems-flex justify="between" align="center" css="mb-2">
                    <h6 class="mb-0"><pems-icon name="bi-graph-up-arrow" /> @Localizer["Cm_Reliability"]</h6>
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Reliability" asp-action="Details" asp-route-id="@eq.EquipmentId">
                        <pems-icon name="bi-clock-history" /> @Localizer["Cm_FailureHistory"]
                    </pems-button>
                </pems-flex>
                <pems-row gap="2" css="text-center">
                    <pems-col md="3"><div class="small text-muted">@Localizer["MTBF"]</div><div class="fw-bold">@(reliability.MTBFHours.HasValue ? $"{reliability.MTBFHours.Value:N1} h" : "N/A")</div></pems-col>
                    <pems-col md="3"><div class="small text-muted">@Localizer["MTTR"]</div><div class="fw-bold">@(reliability.MTTRHours.HasValue ? $"{reliability.MTTRHours.Value:N1} h" : "N/A")</div></pems-col>
                    <pems-col md="3"><div class="small text-muted">@Localizer["Availability"]</div><div class="fw-bold">@(reliability.AvailabilityPercent.HasValue ? $"{reliability.AvailabilityPercent.Value:N1}%" : "N/A")</div></pems-col>
                    <pems-col md="3"><div class="small text-muted">@Localizer["Failure Count"]</div><div class="fw-bold">@reliability.FailureCount</div></pems-col>
                </pems-row>
            </pems-content-card>
        }
        @* استراتژی و PM (فقط خواندنی) - از روابط موجود MaintenanceStrategy/MaintenancePlan.EquipmentId *@
        <pems-content-card css="mb-3">
            <pems-flex justify="between" align="center" css="mb-2">
                <h6 class="mb-0"><pems-icon name="bi-diagram-2" /> @Localizer["Cm_StrategyPm"]</h6>
                <pems-flex as="span" gap="2">
                    @if (ViewBag.CanViewStrategy == true) { <a asp-controller="MaintenanceStrategy" asp-action="Index" asp-route-equipmentId="@eq.EquipmentId" class="vs-btn vs-btn--sm">@Localizer["Cm_Strategies"]</a> }
                    @if (ViewBag.CanViewPlan == true) { <a asp-controller="MaintenancePlan" asp-action="Index" class="vs-btn vs-btn--sm">@Localizer["Cm_PmPlans"]</a> }
                </pems-flex>
            </pems-flex>
            @if (!Model.Strategies.Any() && !Model.Plans.Any())
            {
                <p class="text-muted mb-0 small">@Localizer["Cm_NoStrategy"]</p>
            }
            else
            {
                <pems-table-scroll>
                <pems-table kind="enterprise" css="mb-0">
                    <thead><tr><th>@Localizer["Cm_Kind"]</th><th>@Localizer["Cm_Reference"]</th><th>@Localizer["Cm_Trigger"]</th><th>@Localizer["Cm_Interval"]</th><th>@Localizer["Cm_LastDone"]</th><th>@Localizer["Cm_NextDue"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Strategies)
                        {
                            <tr>
                                <td>@Localizer["Cm_Strategy"]</td>
                                <td>@s.StrategyType <span class="vs-sub">@s.ConsequenceCategory</span></td>
                                <td>@s.RecommendedTriggerType</td>
                                <td class="vs-num">@(string.IsNullOrWhiteSpace(s.Frequency) ? "—" : s.Frequency)</td>
                                <td>—</td><td>—</td>
                            </tr>
                        }
                        @foreach (var p in Model.Plans)
                        {
                            <tr>
                                <td>@Localizer["Cm_PmPlan"]</td>
                                <td><span class="vs-num">@p.PlanNumber</span> <span class="vs-sub">@p.Title</span></td>
                                <td>@p.TriggerType</td>
                                <td class="vs-num">@(p.IntervalDays.HasValue ? p.IntervalDays + " d" : "—")</td>
                                <td class="vs-num">@(p.LastExecutionDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="vs-num">
                                    @if (p.NextDueDate.HasValue)
                                    {
                                        var overdue = p.NextDueDate.Value.Date < DateTime.Today;
                                        <span class="vs-pill vs-pill--icon @(overdue ? "vs-pill--danger" : "vs-pill--neutral")"><pems-icon css="@(overdue ? "bi-exclamation-triangle" : "bi-calendar-event")" aria-hidden="true" /> @p.NextDueDate.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else { <span>—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
                </pems-table-scroll>
            }
        </pems-content-card>

        <pems-content-card css="mb-3">
            <pems-flex justify="between" align="center" css="mb-2">
                <h6 class="mb-0"><pems-icon name="bi-clipboard-plus" /> @Localizer["Cm_MaintHistoryWr"]</h6>
                @if (canCreateWr)
                {
                    <a asp-controller="WorkRequest" asp-action="Create" asp-route-equipmentId="@eq.EquipmentId" class="vs-btn vs-btn--primary vs-btn--sm">
                        <pems-icon name="bi-plus-lg" /> @Localizer["Cm_NewWorkRequest"]
                    </a>
                }
            </pems-flex>
            <pems-table-scroll css="table-scroll-area pems-s-7bf38d03">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Cm_WrNumber"]</th><th>@Localizer["Cm_Title"]</th><th>@Localizer["Cm_Priority"]</th><th>@Localizer["Cm_Status"]</th><th>@Localizer["Cm_Requested"]</th><th>@Localizer["Cm_LinkedWo"]</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.WorkRequests)
                    {
                        <tr>
                            <td class="vs-num">@if (canViewWr) { <a asp-controller="WorkRequest" asp-action="Details" asp-route-id="@r.WorkRequestId">@r.RequestNumber</a> } else { @r.RequestNumber }</td>
                            <td>@r.Title</td>
                            <td><span class="vs-pill @PrioTone(r.Priority)">@r.Priority</span></td>
                            <td><span class="vs-pill vs-pill--icon @WrTone(r.Status)"><pems-icon css="@WrIcon(r.Status)" aria-hidden="true" /> @r.Status</span></td>
                            <td class="vs-num">@r.RequestedDate.ToString("yyyy-MM-dd")</td>
                            <td class="vs-num">@if (r.LinkedWorkOrderId.HasValue) { if (canViewWo) { <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@r.LinkedWorkOrderId">@r.LinkedWorkOrderNo</a> } else { @r.LinkedWorkOrderNo } } else { <span class="text-muted">—</span> }</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            </pems-table-scroll>
            @if (!Model.WorkRequests.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoWorkRequests"]</p> }
        </pems-content-card>

        @* Work Orderهای اجراشده: فقط خواندنی - ساخت Work Order از این بخش مجاز نیست؛ فقط از Work Request تاییدشده *@
        <pems-content-card>
            <h6 class="mb-2"><pems-icon name="bi-tools" /> @Localizer["Cm_ExecutedWo"]</h6>
            <pems-table-scroll css="table-scroll-area pems-s-f7dce87f">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Cm_WoNumber"]</th><th>@Localizer["Cm_Description"]</th><th>@Localizer["Cm_Status"]</th><th>@Localizer["Cm_Date"]</th></tr></thead>
                <tbody>
                    @foreach (var w in Model.WorkOrders)
                    {
                        <tr>
                            <td class="vs-num">@if (canViewWo) { <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNo</a> } else { @w.WorkOrderNo }</td>
                            <td>@w.Description</td>
                            <td><span class="vs-pill">@w.Status</span></td>
                            <td class="vs-num">@(w.CreatedDate?.ToString("yyyy-MM-dd"))</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            </pems-table-scroll>
            @if (!Model.WorkOrders.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoWorkOrders"]</p> }
        </pems-content-card>
    </pems-tab-pane>

    @* ===================== Inspections ===================== *@
    <pems-tab-pane fade="true" id="tab-inspection" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <h6 class="mb-0"><pems-icon name="bi-clipboard-pulse" /> @Localizer["Cm_SecInspections"]</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#newInspectionModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["Cm_NewInspection"]
                </pems-button>
            </pems-flex>
            <pems-table kind="enterprise" css="mb-0">
                <thead>
                    <tr><th>@Localizer["Cm_Type"]</th><th>@Localizer["Cm_Date"]</th><th>@Localizer["Cm_Measurement"]</th><th>@Localizer["Cm_Condition"]</th><th>@Localizer["Cm_NextDue"]</th><th>@Localizer["Cm_DueStatus"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var i in inspections)
                    {
                        <tr>
                            <td class="small">@i.InspectionType</td>
                            <td class="small">@i.InspectionDate.ToString("yyyy-MM-dd")</td>
                            <td class="small">@(i.MeasurementValue.HasValue ? $"{i.MeasurementValue.Value:N2} {i.MeasurementUnit}" : "-")</td>
                            <td class="small">
                                @switch (i.ConditionStatus)
                                {
                                    case "Alert": <pems-badge tone="danger">@Localizer["Alert"]</pems-badge> break;
                                    case "Normal": <pems-badge tone="success">@Localizer["Normal"]</pems-badge> break;
                                    default: <span class="text-muted">N/A</span> break;
                                }
                            </td>
                            <td class="small">@(i.NextInspectionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="small">
                                @switch (i.DueStatus)
                                {
                                    case "Overdue": <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge> break;
                                    case "DueSoon": <pems-badge tone="warning">@Localizer["Due Soon"]</pems-badge> break;
                                    case "OK": <pems-badge tone="success">OK</pems-badge> break;
                                    default: <span class="text-muted">N/A</span> break;
                                }
                            </td>
                            <td>
                                @if (i.ConditionStatus == "Alert")
                                {
                                    <form asp-controller="Inspection" asp-action="RaiseWorkRequest" method="post" class="d-inline">
                                        <input type="hidden" name="inspectionRecordId" value="@i.InspectionRecordId" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Cm_RaiseWr"]</pems-button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!inspections.Any()) { <p class="text-muted mb-0 small">@Localizer["Cm_NoInspections"]</p> }
        </pems-content-card>

        <pems-modal id="newInspectionModal" tabindex="-1">
                <form asp-controller="Inspection" asp-action="Create" method="post">
                    <input type="hidden" name="equipmentId" value="@eq.EquipmentId" />
                    <pems-modal-header>New Inspection</pems-modal-header>
                    <pems-modal-body>
                        <div class="mb-2"><pems-label css="small">Inspection Type</pems-label>
                            <pems-input scale="small" name="inspectionType" placeholder="Vibration, Thickness, Visual..." required /></div>
                        <div class="mb-2"><pems-label css="small">Inspection Date</pems-label>
                            <pems-date name="inspectionDate" scale="small" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                        <div class="mb-2"><pems-label css="small">@Localizer["Inspector"]</pems-label>
                            <pems-input scale="small" name="inspector" /></div>
                        <pems-row gap="2" css="mb-2">
                            <pems-col span="6"><pems-label css="small">Measurement Value</pems-label>
                                <pems-input scale="small" name="measurementValue" type="number" step="0.01" /></pems-col>
                            <pems-col span="6"><pems-label css="small">@Localizer["Unit"]</pems-label>
                                <pems-input scale="small" name="measurementUnit" placeholder="mm/s, mm, °C..." /></pems-col>
                        </pems-row>
                        <pems-row gap="2" css="mb-2">
                            <pems-col span="6"><pems-label css="small">Lower Limit</pems-label>
                                <pems-input scale="small" name="lowerLimit" type="number" step="0.01" /></pems-col>
                            <pems-col span="6"><pems-label css="small">Upper Limit</pems-label>
                                <pems-input scale="small" name="upperLimit" type="number" step="0.01" /></pems-col>
                        </pems-row>
                        <div class="mb-2"><pems-label css="small">Next Inspection Date</pems-label>
                            <pems-date name="nextInspectionDate" scale="small" /></div>
                        <div class="mb-2"><pems-label css="small">Recommendation</pems-label>
                            <pems-textarea scale="small" name="recommendation" rows="2"></pems-textarea></div>
                        <div class="mb-2"><pems-label css="small">@Localizer["Description"]</pems-label>
                            <pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                    </pems-modal-footer>
                </form>
            </pems-modal>
    </pems-tab-pane>

    @* ===================== Quality & Change ===================== *@
    <pems-tab-pane fade="true" id="tab-quality" role="tabpanel">
        <pems-row gap="3">
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <h6 class="mb-3"><pems-icon name="bi-exclamation-triangle" /> NCR <pems-badge tone="neutral">@Model.NonConformanceReports.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var n in Model.NonConformanceReports)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <a asp-controller="QC" asp-action="NcrDetails" asp-route-id="@n.NodeId">@n.Label</a>
                                <pems-badge tone="@(n.Priority == "Urgent" ? "danger" : "neutral")">@n.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </ul>
                    @if (!Model.NonConformanceReports.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </pems-content-card>
            </pems-col>
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <h6 class="mb-3"><pems-icon name="bi-arrow-repeat" /> MOC <pems-badge tone="neutral">@Model.MOCs.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var m in Model.MOCs)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <a asp-controller="MOC" asp-action="Details" asp-route-id="@m.NodeId">@m.Label</a>
                                <pems-badge tone="@(m.Priority == "Urgent" ? "danger" : "neutral")">@m.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </ul>
                    @if (!Model.MOCs.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </pems-content-card>
            </pems-col>
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <h6 class="mb-3"><pems-icon name="bi-question-circle" /> TQ / TSR / RFI <pems-badge tone="neutral">@Model.TechnicalQueries.Count</pems-badge></h6>
                    <ul class="list-unstyled mb-0">
                        @foreach (var t in Model.TechnicalQueries)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <a asp-controller="TechnicalQuery" asp-action="Details" asp-route-id="@t.NodeId">@t.Label</a>
                                <pems-badge tone="@(t.Priority == "Urgent" ? "danger" : "neutral")">@t.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </ul>
                    @if (!Model.TechnicalQueries.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</p> }
                </pems-content-card>
            </pems-col>
        </pems-row>
    </pems-tab-pane>

    @* ===================== Classification & Maintenance Intelligence ===================== *@
    <pems-tab-pane fade="true" id="tab-classification" role="tabpanel">
        @{
            var intel = ViewBag.MaintenanceIntelligence as PEMS.Application.DTOs.EquipmentMaintenanceIntelligenceDto;
            var explanation = ViewBag.ClassificationExplanation as PEMS.Application.DTOs.ClassificationExplanationDto;
        }
        <pems-content-card css="mb-3">
            <h6 class="mb-3"><pems-icon name="bi-diagram-3-fill" /> @Localizer["Cm_SecClassification"]</h6>
            @if (intel?.EquipmentClassId != null)
            {
                <pems-row gap="2" css="small">
                    <pems-col md="3"><strong>@Localizer["Equipment Class"]</strong><div>@intel.EquipmentClassName <code>@intel.EquipmentClassCode</code></div></pems-col>
                    <pems-col md="3"><strong>Class Hierarchy</strong><div>@string.Join(" ← ", intel.ResolvedClassHierarchy)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Confidence"]</strong><div><pems-badge tone="info">@intel.ClassificationConfidence</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Source"]</strong><div><pems-badge tone="neutral">@intel.ClassificationSource</pems-badge></div></pems-col>
                </pems-row>
                @if (explanation?.MatchedRuleTier != null)
                {
                    <pems-alert tone="light" css="border small mt-3 mb-0">
                        <strong>@Localizer["چرا این طبقه‌بندی؟"]</strong>
                        Rule tier: <pems-badge tone="light">@explanation.MatchedRuleTier</pems-badge> &middot;
                        Matched on: <code>@explanation.MatchedInput</code> &middot;
                        @explanation.Reason
                    </pems-alert>
                }
            }
            else
            {
                <p class="text-muted small mb-0">این تجهیز هنوز طبقه‌بندی نشده (EquipmentType: <code>@eq.EquipmentType</code>).</p>
            }

            @if (pendingSuggestion != null)
            {
                <pems-alert tone="warning" css="small mt-3 mb-0">
                    <strong>پیشنهاد در انتظار بازبینی:</strong> @pendingSuggestion.SuggestedEquipmentClassName
                    (<pems-badge tone="warning">@pendingSuggestion.Confidence</pems-badge>) &mdash; @pendingSuggestion.Reason
                    <a asp-controller="EquipmentClassification" asp-action="ReviewQueue" class="ms-2">بازبینی در صف →</a>
                </pems-alert>
            }
        </pems-content-card>

        @if (intel?.EquipmentClassId != null)
        {
            <pems-row gap="3">
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <h6 class="mb-3">@Localizer["Cm_ApplicableActivities"] <pems-badge tone="neutral">@intel.ApplicableActivities.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var a in intel.ApplicableActivities)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@a.Name</span>
                                    <span class="text-muted">@a.Source</span>
                                </pems-flex>
                            }
                        </ul>
                        @if (!intel.ApplicableActivities.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <h6 class="mb-3">@Localizer["Cm_PmTemplates"] <pems-badge tone="neutral">@intel.CandidatePMTemplates.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var t in intel.CandidatePMTemplates)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@t.Name (@t.TriggerType@(t.IntervalDays.HasValue ? $" / {t.IntervalDays}d" : ""))</span>
                                    <span class="text-muted">@t.Source</span>
                                </pems-flex>
                            }
                        </ul>
                        @if (!intel.CandidatePMTemplates.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <h6 class="mb-3">@Localizer["Cm_FailureModes"] <pems-badge tone="neutral">@intel.ApplicableFailureModes.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var fm in intel.ApplicableFailureModes)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@fm.Name</span>
                                    <span class="text-muted">@fm.Source</span>
                                </pems-flex>
                            }
                        </ul>
                        @if (!intel.ApplicableFailureModes.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <h6 class="mb-3">@Localizer["Cm_StdRefs"] <pems-badge tone="neutral">@intel.ApplicableStandardReferences.Count</pems-badge></h6>
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var s in intel.ApplicableStandardReferences)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@s.Name</span>
                                    <code>@s.Code</code>
                                </pems-flex>
                            }
                        </ul>
                        @if (!intel.ApplicableStandardReferences.Any()) { <p class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</p> }
                    </pems-content-card>
                </pems-col>
            </pems-row>
        }
    </pems-tab-pane>

    @* ===================== Barcode ===================== *@
    <pems-tab-pane fade="true" id="tab-barcode" role="tabpanel">
        <partial name="_BarcodePanel" model="(PEMS.Web.Models.BarcodePanelViewModel)ViewBag.BarcodePanel" />
    </pems-tab-pane>

</pems-tab-content>

</pems-page-shell> @* end .vs-page *@

@section Scripts {
    <script src="~/js/views/equipment-details.js" asp-append-version="true"></script>
}
