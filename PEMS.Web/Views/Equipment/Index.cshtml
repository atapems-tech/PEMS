@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.Interfaces.EquipmentDashboardDto)ViewBag.Dashboard;
}

@* One search (was two: a quick-jump card + a filter box). The single input keeps both behaviours: picking a suggestion opens that
   equipment's passport, pressing Enter filters the list. KPI cards became a chip strip; New Equipment moved into the toolbar. *@
<div class="vs-chips">
    <span class="vs-chip">@Localizer["Eq_Total"] <strong>@dash.TotalCount</strong></span>
    <span class="vs-chip"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Eq_Active"] <strong>@dash.ActiveCount</strong></span>
    <span class="vs-chip"><i class="bi bi-dash-circle" aria-hidden="true"></i> @Localizer["Eq_Inactive"] <strong>@dash.InactiveCount</strong></span>
    @foreach (var d in dash.ByDiscipline.Take(4))
    {
        <span class="vs-chip">@d.Discipline <strong>@d.Count</strong></span>
    }
</div>

<form method="get" class="vs-toolbar" role="search">
    <div class="pems-search-bar">
        <i class="bi bi-search pems-search-icon" aria-hidden="true"></i>
        <input name="q" id="equipmentQuickSearch" value="@ViewBag.SearchTerm" class="form-control" placeholder="@Localizer["Eq_SearchPlaceholder"]" aria-label="@Localizer["Eq_SearchPlaceholder"]"
               data-pems-search data-search-type="Equipment" autocomplete="off" />
    </div>
    <select name="projectId" class="form-select form-select-sm" aria-label="@Localizer["Ed_Project"]">
        <option value="">@Localizer["Eq_AllProjects"]</option>
        @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
    </select>
    <select name="disciplineId" class="form-select form-select-sm" aria-label="@Localizer["Ed_Discipline"]">
        <option value="">@Localizer["Eq_AllDisciplines"]</option>
        @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
    </select>
    <select name="equipmentType" class="form-select form-select-sm" aria-label="@Localizer["Ed_Type"]">
        <option value="">@Localizer["Eq_AllTypes"]</option>
        @foreach (var t in (IEnumerable<string>)ViewBag.EquipmentTypes) { <option value="@t" selected="@(t == (string?)ViewBag.SelectedEquipmentType)">@t</option> }
    </select>
    <select name="status" class="form-select form-select-sm" aria-label="@Localizer["Ed_Status"]">
        <option value="">@Localizer["Eq_AllStatuses"]</option>
        @foreach (var s in (IEnumerable<string>)ViewBag.Statuses) { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
    </select>
    <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-funnel" aria-hidden="true"></i> @Localizer["Eq_Apply"]</button>
    <a asp-action="Index" class="vs-icon-btn" title="@Localizer["Reset"]" aria-label="@Localizer["Reset"]"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
    <span class="vs-toolbar__end">
        <button type="button" class="vs-btn vs-btn--primary vs-btn--sm" data-bs-toggle="modal" data-bs-target="#createEquipmentModal">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["Eq_NewEquipment"]
        </button>
    </span>
</form>

<script>
    document.getElementById('equipmentQuickSearch').addEventListener('pems:search-select', function (e) {
        if (e.detail && e.detail.url) window.location.href = e.detail.url;
    });
</script>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Equipment')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="table-responsive pems-grid-scroll table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Equipment">
            <thead>
                <tr>
                    <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Tag Number"]</th>
                    <th data-col-key="name" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">@Localizer["Name"]</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Type"]</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Project"]</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Discipline"]</th>
                    <th data-col-key="docs" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">Docs</th>
                    <th data-col-key="vdr" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">@Localizer["VDR"]</th>
                    <th data-col-key="wo" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Work Orders"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Status"]</th>
                    <th data-col-key="actions" data-resizable="false" style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td>@e.TagNumber</td>
                        <td>@e.Name</td>
                        <td>@e.EquipmentType</td>
                        <td>@e.ProjectName</td>
                        <td>@e.DisciplineName</td>
                        <td><span class="badge bg-secondary">@e.DocumentsCount</span></td>
                        <td><span class="badge bg-secondary">@e.VDRItemsCount</span></td>
                        <td><span class="badge bg-secondary">@e.WorkOrdersCount</span></td>
                        <td><span class="badge bg-success">@e.Status</span></td>
                        <td><a asp-action="Details" asp-route-id="@e.EquipmentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No equipment registered yet.</p> }
    </div>

    @{
        var qsParts = new List<string>();
        if (ViewBag.SelectedProjectId != null) qsParts.Add($"projectId={ViewBag.SelectedProjectId}");
        if (ViewBag.SelectedDisciplineId != null) qsParts.Add($"disciplineId={ViewBag.SelectedDisciplineId}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedEquipmentType)) qsParts.Add($"equipmentType={Uri.EscapeDataString((string)ViewBag.SelectedEquipmentType)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.SearchTerm)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Equipment",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Equipment');
        });
    </script>
}

<div class="modal fade" id="createEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Equipment" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Equipment</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@Localizer["Tag Number"]</label><input name="TagNumber" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Name"]</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Type"]</label><input name="EquipmentType" class="form-control" placeholder="@Localizer["Pump, Vessel, Motor ..."]" /></div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="ProjectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="DisciplineId" class="form-select" required>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Manufacturer"]</label><input name="Manufacturer" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Model"]</label><input name="Model" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Serial Number"]</label><input name="SerialNumber" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="Description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
