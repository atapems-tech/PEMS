@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.Interfaces.EquipmentDashboardDto)ViewBag.Dashboard;
    var projects = ((IEnumerable<dynamic>)ViewBag.Projects).ToList();
    var disciplines = ((IEnumerable<dynamic>)ViewBag.Disciplines).ToList();
    var q = (string?)ViewBag.SearchTerm;
    var projectId = (int?)ViewBag.SelectedProjectId;
    var disciplineId = (int?)ViewBag.SelectedDisciplineId;
    var equipmentType = (string?)ViewBag.SelectedEquipmentType;
    var status = (string?)ViewBag.SelectedStatus;
    string? projectName = null, disciplineName = null;
    foreach (var p in projects) { if (p.ProjectId == projectId) { projectName = p.ProjectName; } }
    foreach (var d in disciplines) { if (d.DisciplineId == disciplineId) { disciplineName = d.Name; } }
    var filterCount = (projectId.HasValue ? 1 : 0) + (disciplineId.HasValue ? 1 : 0) + (string.IsNullOrEmpty(equipmentType) ? 0 : 1) + (string.IsNullOrEmpty(status) ? 0 : 1);

    var qsParts = new List<string>();
    if (projectId.HasValue) qsParts.Add($"projectId={projectId}");
    if (disciplineId.HasValue) qsParts.Add($"disciplineId={disciplineId}");
    if (!string.IsNullOrEmpty(equipmentType)) qsParts.Add($"equipmentType={Uri.EscapeDataString(equipmentType)}");
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. One search keeps both behaviours: picking a suggestion opens
   that equipment's passport, pressing Enter filters the list. The counts became the KPI row; "New equipment" still opens
   the create modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Eq_Title"]" total="@Model.TotalCount">
            <pems-list-search id="eqSearchForm" action="@Url.Action("Index")" input-id="equipmentQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Eq_SearchPlaceholder"]" search-type="Equipment">
                @if (projectId.HasValue) { <input type="hidden" name="projectId" value="@projectId" /> }
                @if (disciplineId.HasValue) { <input type="hidden" name="disciplineId" value="@disciplineId" /> }
                @if (!string.IsNullOrEmpty(equipmentType)) { <input type="hidden" name="equipmentType" value="@equipmentType" /> }
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="eqSearchForm">
                <pems-list-filters form-id="eqFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="eqFilterProject">@Localizer["Ed_Project"]</label>
                        <select id="eqFilterProject" name="projectId" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllProjects"]</option>
                            @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == projectId)">@p.ProjectName</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="eqFilterDiscipline">@Localizer["Ed_Discipline"]</label>
                        <select id="eqFilterDiscipline" name="disciplineId" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllDisciplines"]</option>
                            @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == disciplineId)">@d.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="eqFilterType">@Localizer["Ed_Type"]</label>
                        <select id="eqFilterType" name="equipmentType" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllTypes"]</option>
                            @foreach (var t in (IEnumerable<string>)ViewBag.EquipmentTypes) { <option value="@t" selected="@(t == equipmentType)">@t</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="eqFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="eqFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllStatuses"]</option>
                            @foreach (var s in (IEnumerable<string>)ViewBag.Statuses) { <option value="@s" selected="@(s == status)">@s</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="eqKpis" storage-key="pems.equipment.kpis" />
                <pems-list-reset-columns grid-key="Equipment" />
                <pems-list-new modal="createEquipmentModal" text="@Localizer["Eq_NewEquipment"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="eqKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@dash.TotalCount</strong></span>
            <span class="vs-chip"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Eq_Active"] <strong>@dash.ActiveCount</strong></span>
            <span class="vs-chip"><i class="bi bi-dash-circle" aria-hidden="true"></i> @Localizer["Eq_Inactive"] <strong>@dash.InactiveCount</strong></span>
            @foreach (var d in dash.ByDiscipline.Take(4))
            {
                <span class="vs-chip">@d.Discipline <strong>@d.Count</strong></span>
            }
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index", new { q })">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { projectId, disciplineId, equipmentType, status })" /> }
            @if (projectId.HasValue)
            { <pems-list-chip label="@Localizer["Ed_Project"]" value="@projectName" remove-href="@Url.Action("Index", new { q, disciplineId, equipmentType, status })" /> }
            @if (disciplineId.HasValue)
            { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@disciplineName" remove-href="@Url.Action("Index", new { q, projectId, equipmentType, status })" /> }
            @if (!string.IsNullOrEmpty(equipmentType))
            { <pems-list-chip label="@Localizer["Ed_Type"]" value="@equipmentType" remove-href="@Url.Action("Index", new { q, projectId, disciplineId, status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@status" remove-href="@Url.Action("Index", new { q, projectId, disciplineId, equipmentType })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Equipment" empty="@(!Model.Items.Any())" empty-text="@Localizer["Eq_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Ins_Tag"]</th>
                        <th data-col-key="name" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">@Localizer["Eq_Name"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Ed_Type"]</th>
                        <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Ed_Project"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="docs" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">@Localizer["Eq_Docs"]</th>
                        <th data-col-key="vdr" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">@Localizer["VDR"]</th>
                        <th data-col-key="wo" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Cm_WorkOrders"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Ed_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@e.EquipmentId" class="lp-subject" title="@e.TagNumber">@e.TagNumber</a></td>
                            <td><span class="vs-title-cell" title="@e.Name">@e.Name</span></td>
                            <td class="small">@e.EquipmentType</td>
                            <td class="small vs-hide-md">@e.ProjectName</td>
                            <td class="small vs-hide-md">@e.DisciplineName</td>
                            <td><span class="vs-num">@e.DocumentsCount</span></td>
                            <td><span class="vs-num">@e.VDRItemsCount</span></td>
                            <td><span class="vs-num">@e.WorkOrdersCount</span></td>
                            <td><span class="vs-pill @(e.Status == "Active" ? "vs-pill--success" : "vs-pill--neutral")">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Equipment",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Equipment" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["Eq_NewEquipment"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@Localizer["Tag Number"]</label><input name="TagNumber" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Name"]</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Type"]</label><input name="EquipmentType" class="form-control" placeholder="@Localizer["Pump, Vessel, Motor ..."]" /></div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="ProjectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="DisciplineId" class="form-select" required>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Manufacturer"]</label><input name="Manufacturer" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Model"]</label><input name="Model" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Serial Number"]</label><input name="SerialNumber" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="Description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
    <script>
        // picking a suggestion opens that equipment's passport; Enter filters the list
        document.getElementById('equipmentQuickSearch').addEventListener('pems:search-select', function (e) {
            if (e.detail && e.detail.url) window.location.href = e.detail.url;
        });
    </script>
}
