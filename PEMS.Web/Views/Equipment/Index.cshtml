@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentDto>
@{
    var dash = (PEMS.Application.Interfaces.EquipmentDashboardDto)ViewBag.Dashboard;
}

@* ============================================================
   جستجوی سریع هوشمند - طبق Global Search Framework؛ همون مثال اصلی: PI، ۱۰۱، PUMP، MCC
   با انتخاب یک نتیجه، مستقیم به Passport همون تجهیز می‌ره
   ============================================================ *@
<div class="content-card mb-3">
    <label class="form-label small fw-bold"><i class="bi bi-search"></i> جستجوی سریع تجهیز (Tag، نام، سازنده، توضیح)</label>
    <input type="text" class="form-control" id="equipmentQuickSearch" placeholder="مثلاً PI، 101، PUMP، MCC..."
           data-pems-search data-search-type="Equipment" autocomplete="off" />
</div>
<script>
    document.getElementById('equipmentQuickSearch').addEventListener('pems:search-select', function (e) {
        if (e.detail && e.detail.url) window.location.href = e.detail.url;
    });
</script>

@* ============================================================
   داشبورد تجهیزات - طبق درخواست
   ============================================================ *@
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold">@dash.TotalCount</div>
            <div class="text-muted small">کل تجهیزات</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-success">@dash.ActiveCount</div>
            <div class="text-muted small">Active</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-secondary">@dash.InactiveCount</div>
            <div class="text-muted small">غیر Active</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card">
            <div class="text-muted small mb-1">به تفکیک دیسیپلین</div>
            @foreach (var d in dash.ByDiscipline.Take(4))
            {
                <div class="d-flex justify-content-between small">
                    <span>@d.Discipline</span><strong>@d.Count</strong>
                </div>
            }
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-2">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">All Projects</option>
                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">All Disciplines</option>
                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="equipmentType" class="form-select form-select-sm">
                <option value="">All Types</option>
                @foreach (var t in (IEnumerable<string>)ViewBag.EquipmentTypes) { <option value="@t" selected="@(t == (string?)ViewBag.SelectedEquipmentType)">@t</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in (IEnumerable<string>)ViewBag.Statuses) { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="q" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search tag, name, S/N..." /></div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-pems-solid flex-fill"><i class="bi bi-funnel"></i></button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger" title="Reset"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createEquipmentModal">
            <i class="bi bi-plus-lg"></i> New Equipment
        </button>
    </div>
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Equipment')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="table-responsive pems-grid-scroll table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Equipment">
            <thead>
                <tr>
                    <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Tag Number</th>
                    <th data-col-key="name" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">Name</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">Type</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Project</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Discipline</th>
                    <th data-col-key="docs" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">Docs</th>
                    <th data-col-key="vdr" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">VDR</th>
                    <th data-col-key="wo" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">Work Orders</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">Status</th>
                    <th data-col-key="actions" data-resizable="false" style="width:70px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td>@e.TagNumber</td>
                        <td>@e.Name</td>
                        <td>@e.EquipmentType</td>
                        <td>@e.ProjectName</td>
                        <td>@e.DisciplineName</td>
                        <td><span class="badge bg-secondary">@e.DocumentsCount</span></td>
                        <td><span class="badge bg-secondary">@e.VDRItemsCount</span></td>
                        <td><span class="badge bg-secondary">@e.WorkOrdersCount</span></td>
                        <td><span class="badge bg-success">@e.Status</span></td>
                        <td><a asp-action="Details" asp-route-id="@e.EquipmentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No equipment registered yet.</p> }
    </div>

    @{
        var qsParts = new List<string>();
        if (ViewBag.SelectedProjectId != null) qsParts.Add($"projectId={ViewBag.SelectedProjectId}");
        if (ViewBag.SelectedDisciplineId != null) qsParts.Add($"disciplineId={ViewBag.SelectedDisciplineId}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedEquipmentType)) qsParts.Add($"equipmentType={Uri.EscapeDataString((string)ViewBag.SelectedEquipmentType)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.SearchTerm)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Equipment",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Equipment');
        });
    </script>
}

<div class="modal fade" id="createEquipmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Equipment" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Equipment</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">Tag Number</label><input name="TagNumber" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">Name</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">Type</label><input name="EquipmentType" class="form-control" placeholder="Pump, Vessel, Motor ..." /></div>
                        <div class="col-md-6">
                            <label class="form-label">Project</label>
                            <select name="ProjectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Discipline</label>
                            <select name="DisciplineId" class="form-select" required>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Manufacturer</label><input name="Manufacturer" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Model</label><input name="Model" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Serial Number</label><input name="SerialNumber" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea name="Description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
