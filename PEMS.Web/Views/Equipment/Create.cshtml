@model PEMS.Domain.Entities.Equipment
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Tag Number</label><input asp-for="TagNumber" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">Name</label><input asp-for="Name" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">Type</label><input asp-for="EquipmentType" class="form-control" placeholder="Pump, Vessel, Motor ..." /></div>
            <div class="col-md-6">
                <label class="form-label">Project</label>
                <select asp-for="ProjectId" class="form-select" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Discipline</label>
                <select asp-for="DisciplineId" class="form-select" required>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">Manufacturer</label><input asp-for="Manufacturer" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Model</label><input asp-for="Model" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Serial Number</label><input asp-for="SerialNumber" class="form-control" /></div>
            <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
