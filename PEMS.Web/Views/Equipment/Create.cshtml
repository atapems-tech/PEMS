@model PEMS.Domain.Entities.Equipment
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="content-card pems-s-bcaa1805">
    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="4"><pems-label>@Localizer["Tag Number"]</pems-label><pems-input asp-for="TagNumber" required /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Name"]</pems-label><pems-input asp-for="Name" required /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Type"]</pems-label><pems-input asp-for="EquipmentType" placeholder="@Localizer["Pump, Vessel, Motor ..."]" /></pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select asp-for="ProjectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select asp-for="DisciplineId" required>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="4"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input asp-for="Manufacturer" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Model"]</pems-label><pems-input asp-for="Model" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Serial Number"]</pems-label><pems-input asp-for="SerialNumber" /></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea asp-for="Description" rows="2"></pems-textarea></pems-col>
        </pems-row>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
