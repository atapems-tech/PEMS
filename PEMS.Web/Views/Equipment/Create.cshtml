@model PEMS.Domain.Entities.Equipment
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="content-card pems-s-bcaa1805">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-4"><pems-label>@Localizer["Tag Number"]</pems-label><pems-input asp-for="TagNumber" required /></div>
            <div class="col-md-4"><pems-label>@Localizer["Name"]</pems-label><pems-input asp-for="Name" required /></div>
            <div class="col-md-4"><pems-label>@Localizer["Type"]</pems-label><pems-input asp-for="EquipmentType" placeholder="@Localizer["Pump, Vessel, Motor ..."]" /></div>
            <div class="col-md-6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select asp-for="ProjectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select asp-for="DisciplineId" required>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </div>
            <div class="col-md-4"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input asp-for="Manufacturer" /></div>
            <div class="col-md-4"><pems-label>@Localizer["Model"]</pems-label><pems-input asp-for="Model" /></div>
            <div class="col-md-4"><pems-label>@Localizer["Serial Number"]</pems-label><pems-input asp-for="SerialNumber" /></div>
            <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea asp-for="Description" rows="2"></pems-textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
