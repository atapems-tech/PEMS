@model PEMS.Application.DTOs.MaterialItemDetailDto
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-1">@Model.MaterialCode @if (Model.IsCritical) { <i class="bi bi-star-fill text-warning" title="Critical"></i> }</h5>
            <div class="text-muted">@Model.Description</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editMaterialModal"><i class="bi bi-pencil"></i> Edit</button>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#receiveStockModal"><i class="bi bi-box-arrow-in-down"></i> Receive Stock</button>
            <form asp-action="ToggleActive" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.MaterialItemId" />
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('وضعیت این متریال تغییر کنه؟')"><i class="bi bi-slash-circle"></i></button>
            </form>
        </div>
    </div>
    <hr />
    <div class="row g-3">
        <div class="col-md-3"><div class="text-muted small">Category</div><div>@(Model.CategoryName ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Discipline</div><div>@(Model.DisciplineName ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">UOM</div><div>@(Model.UomCode ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Manufacturer</div><div>@(Model.Manufacturer ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Vendor</div><div>@(Model.VendorName ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Model</div><div>@(Model.Model ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Size</div><div>@(Model.Size ?? "-")</div></div>
        <div class="col-md-3"><div class="text-muted small">Material Grade</div><div>@(Model.MaterialGrade ?? "-")</div></div>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-stock" type="button"><i class="bi bi-boxes"></i> Stock <span class="badge bg-secondary">@Model.Stocks.Count</span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-tx" type="button"><i class="bi bi-list-ul"></i> Recent Transactions</button></li>
    @if (Model.SourceImports.Any())
    {
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-source" type="button"><i class="bi bi-file-earmark-excel"></i> Source Imports <span class="badge bg-secondary">@Model.SourceImports.Count</span></button></li>
    }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-stock" role="tabpanel">
        <div class="content-card">
            <table class="table table-enterprise">
                <thead><tr><th>Warehouse</th><th>Location</th><th>On Hand</th><th>Reserved</th><th>Available</th><th>Reorder Point</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Stocks)
                    {
                        <tr class="@(s.IsOutOfStock ? "table-danger" : s.IsLowStock ? "table-warning" : "")">
                            <td>@s.WarehouseCode</td>
                            <td class="small">@(s.StorageLocationCode ?? "-")</td>
                            <td>@s.OnHandQuantity</td>
                            <td>@s.ReservedQuantity</td>
                            <td>@s.AvailableQuantity</td>
                            <td>@(s.ReorderPoint?.ToString() ?? "-")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary adjust-stock-btn"
                                        data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-onhand="@s.OnHandQuantity"
                                        title="Adjust"><i class="bi bi-sliders"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-secondary transfer-stock-btn"
                                        data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-available="@s.AvailableQuantity"
                                        title="Transfer"><i class="bi bi-arrow-left-right"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Stocks.Any()) { <p class="text-muted text-center py-4">هنوز موجودی‌ای در هیچ انباری ثبت نشده.</p> }
        </div>
    </div>

    @if (Model.SourceImports.Any())
    {
        <div class="tab-pane fade" id="tab-source" role="tabpanel">
            <div class="content-card">
                <p class="text-muted small">
                    این متریال از این ردیف(های) Excel ساخته/به‌روزرسانی شده - طبق پایه‌ی Metadata، هر بار Import یک رکورد
                    جداگانه می‌ماند (رونویسی نمی‌شود).
                </p>
                <table class="table table-enterprise">
                    <thead><tr><th>Source File</th><th>Import Date</th><th>MRS No</th><th>Vendor</th><th>PO No</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.SourceImports)
                        {
                            <tr>
                                <td class="small">@s.SourceFileName</td>
                                <td class="small">@s.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@(s.RawMrsNo ?? "-")</td>
                                <td class="small">@(s.RawSupplier ?? "-")</td>
                                <td class="small">@(s.RawPoNo ?? "-")</td>
                                <td class="text-end"><a asp-controller="MrsImport" asp-action="Review" asp-route-batchId="@s.MrsImportBatchId" class="btn btn-sm btn-outline-secondary">Open Batch</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="tab-pane fade" id="tab-tx" role="tabpanel">
        <div class="content-card">
            <table class="table table-enterprise">
                <thead><tr><th>Date</th><th>Type</th><th>Warehouse</th><th>Qty</th><th>Reference</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var t in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-light text-dark border">@t.TransactionType</span></td>
                            <td>@t.WarehouseCode</td>
                            <td>@t.Quantity</td>
                            <td class="small">@(t.ReferenceType ?? "-") @(t.ReferenceId?.ToString() ?? "")</td>
                            <td class="small">@(t.EmployeeName ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.RecentTransactions.Any()) { <p class="text-muted text-center py-4">هنوز تراکنشی ثبت نشده.</p> }
        </div>
    </div>
</div>

<div class="modal fade" id="receiveStockModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="ReceiveStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <div class="modal-header"><h6 class="modal-title">دریافت کالا به انبار</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">انبار</label>
                    <select name="warehouseId" class="form-select form-select-sm" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </select>
                </div>
                <div class="mb-2"><label class="form-label small">مقدار</label><input name="quantity" type="number" step="0.001" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">دلیل / مرجع (اختیاری)</label><input name="reason" class="form-control form-control-sm" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ثبت</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="AdjustStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="warehouseId" id="adjustWarehouseId" />
            <div class="modal-header"><h6 class="modal-title">اصلاح موجودی <span id="adjustWarehouseLabel" class="text-muted small"></span></h6></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">موجودی جدید (On Hand)</label><input name="newOnHandQuantity" id="adjustNewOnHand" type="number" step="0.001" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">دلیل</label><input name="reason" class="form-control form-control-sm" required /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ثبت</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="transferStockModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="TransferStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="fromWarehouseId" id="transferFromWarehouseId" />
            <div class="modal-header"><h6 class="modal-title">انتقال بین انبارها <span id="transferFromWarehouseLabel" class="text-muted small"></span></h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">انبار مقصد</label>
                    <select name="toWarehouseId" class="form-select form-select-sm" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </select>
                </div>
                <div class="mb-2"><label class="form-label small">مقدار (حداکثر: <span id="transferAvailable"></span>)</label><input name="quantity" type="number" step="0.001" class="form-control form-control-sm" required /></div>
                <div class="mb-2"><label class="form-label small">دلیل / مرجع (اختیاری)</label><input name="reason" class="form-control form-control-sm" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">ثبت</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="editMaterialModal" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <div class="modal-header"><h6 class="modal-title">Edit Material</h6></div>
            <div class="modal-body">
                <div class="row g-3 mb-2">
                    <div class="col-md-6"><label class="form-label">Material Code</label><input name="materialCode" value="@Model.MaterialCode" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label">Material Type</label><input name="materialType" value="@Model.MaterialType" class="form-control" /></div>
                </div>
                <div class="mb-2"><label class="form-label">Description</label><input name="description" value="@Model.Description" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Long Description</label><textarea name="longDescription" class="form-control" rows="2">@Model.LongDescription</textarea></div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6"><label class="form-label">Manufacturer</label><input name="manufacturer" value="@Model.Manufacturer" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Manufacturer Part No.</label><input name="manufacturerPartNumber" value="@Model.ManufacturerPartNumber" class="form-control" /></div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-4"><label class="form-label">Model</label><input name="model" value="@Model.Model" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Size</label><input name="size" value="@Model.Size" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Material Grade</label><input name="materialGrade" value="@Model.MaterialGrade" class="form-control" /></div>
                </div>
                <div class="d-flex gap-3">
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="isStockItem" value="true" checked="@Model.IsStockItem" id="editIsStockItem" /><label class="form-check-label" for="editIsStockItem">Stock Item</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="isCritical" value="true" checked="@Model.IsCritical" id="editIsCritical" /><label class="form-check-label" for="editIsCritical">Critical Spare</label></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pems-solid">Save</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.adjust-stock-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('adjustWarehouseId').value = btn.dataset.warehouseId;
        document.getElementById('adjustWarehouseLabel').textContent = '(' + btn.dataset.warehouseCode + ')';
        document.getElementById('adjustNewOnHand').value = btn.dataset.onhand;
        new bootstrap.Modal(document.getElementById('adjustStockModal')).show();
    });
});
document.querySelectorAll('.transfer-stock-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('transferFromWarehouseId').value = btn.dataset.warehouseId;
        document.getElementById('transferFromWarehouseLabel').textContent = '(' + btn.dataset.warehouseCode + ')';
        document.getElementById('transferAvailable').textContent = btn.dataset.available;
        new bootstrap.Modal(document.getElementById('transferStockModal')).show();
    });
});
</script>
}
