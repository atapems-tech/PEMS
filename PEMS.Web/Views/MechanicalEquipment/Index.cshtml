@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MechanicalEquipmentListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
    var q = (string?)ViewBag.SearchTerm;
    var subType = (string?)ViewBag.SelectedSubType;
    var subTypes = new[] { "Rotating", "Static", "Unclassified" };
    var filterCount = string.IsNullOrEmpty(subType) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(subType)) qsParts.Add($"subType={Uri.EscapeDataString(subType)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");

    string SubTypeText(string? s) => VdrUi.Loc(Localizer, "Me_Sub_", s);
    string SubTypeTone(string? s) => s switch { "Rotating" => "vs-pill--info", "Static" => "vs-pill--current", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2b: built from the PEMS.UI list-page component; the page keeps its search, sub-type filter, counts (KPI row,
   sub-type chips filter the list), columns and row actions; "New mechanical equipment" still opens the create modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Me_Title"]" total="@Model.TotalCount">
            <pems-list-search id="meSearchForm" action="@Url.Action("Index")" input-id="meQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Me_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(subType)) { <input type="hidden" name="subType" value="@subType" /> }
            </pems-list-search>

            <pems-list-tools search-for="meSearchForm">
                <pems-list-filters form-id="meFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="meFilterSubType">@Localizer["Me_SubType"]</label>
                        <select id="meFilterSubType" name="subType" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllTypes"]</option>
                            @foreach (var s in subTypes)
                            { <option value="@s" selected="@(s == subType)">@SubTypeText(s)</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="meKpis" storage-key="pems.mechanicalEquipment.kpis" />
                <pems-list-reset-columns grid-key="MechanicalEquipment" />
                <pems-list-new modal="createMechanicalModal" text="@Localizer["Me_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="meKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@ViewBag.TotalCount</strong></span>
            @foreach (var s in subTypes)
            {
                var count = s switch { "Rotating" => ViewBag.RotatingCount, "Static" => ViewBag.StaticCount, _ => ViewBag.UnclassifiedCount };
                <a class="vs-chip" href="@Url.Action("Index", new { subType = s, q })">@SubTypeText(s) <strong>@count</strong></a>
            }
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { subType })" /> }
            @if (!string.IsNullOrEmpty(subType))
            { <pems-list-chip label="@Localizer["Me_SubType"]" value="@SubTypeText(subType)" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="MechanicalEquipment" empty="@(!Model.Items.Any())" empty-text="@Localizer["Me_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Me_Tag"]</th>
                        <th data-col-key="mfr" data-resizable="true" data-min-width="140" data-max-width="320" style="width:220px">@Localizer["Cm_ManufacturerModel"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="200" style="width:140px">@Localizer["Cm_Type"]</th>
                        <th data-col-key="subtype" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px">@Localizer["Me_SubType"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:90px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Passport" asp-route-id="@m.MechanicalEquipmentId" class="lp-subject"><span class="vs-num">@m.TagNumber</span></a></td>
                            <td class="small"><span class="vs-title-cell" title="@m.Manufacturer / @m.Model">@m.Manufacturer / @m.Model</span></td>
                            <td class="small">@m.EquipmentType</td>
                            <td><span class="vs-pill @SubTypeTone(m.SubType)">@SubTypeText(m.SubType)</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Passport" asp-route-id="@m.MechanicalEquipmentId" class="lp-act lp-act--always" title="@Localizer["Me_Passport"]" aria-label="@Localizer["Me_Passport"]"><i class="bi bi-card-text" aria-hidden="true"></i></a>
                                <a asp-action="Edit" asp-route-id="@m.MechanicalEquipmentId" class="lp-act lp-act--always" title="@Localizer["Rcm_Edit"]" aria-label="@Localizer["Rcm_Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "MechanicalEquipment",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createMechanicalModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["Me_New"]</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        @Localizer["Equipment link is optional - only fill it when this mechanical record represents an existing Equipment tag. Rotating/Static sub-type details are added afterwards from the Passport page."]
                    </p>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Equipment (اختیاری)"]</label>
                        <select name="equipmentId" class="form-select">
                            <option value="">@Localizer["-- ندارد --"]</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Tag Number"]</label>
                            <input name="tagNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Equipment Type"]</label>
                            <input name="equipmentType" class="form-control" required placeholder="@Localizer["Pump, Compressor, Vessel, Tank, Heat Exchanger ..."]" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Manufacturer"]</label>
                            <input name="manufacturer" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Model"]</label>
                            <input name="model" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@Localizer["توضیحات (اختیاری)"]</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                    <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ساخت"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
