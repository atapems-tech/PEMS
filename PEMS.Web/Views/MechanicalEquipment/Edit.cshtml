@model PEMS.Domain.Entities.MechanicalEquipment
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Edit Mechanical Equipment";
}

<pems-content-card>
    <h5 class="mb-3">@Model.TagNumber</h5>
    <form asp-action="Edit" method="post">
        <input type="hidden" name="mechanicalEquipmentId" value="@Model.MechanicalEquipmentId" />

        <h6 class="text-muted mb-2">@Localizer["General"]</h6>
        <pems-row gap="3" css="mb-4">
            <pems-col md="4">
                <pems-label>@Localizer["Equipment Type"]</pems-label>
                <pems-input name="EquipmentType" value="@Model.EquipmentType" required />
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Manufacturer"]</pems-label>
                <pems-input name="Manufacturer" value="@Model.Manufacturer" />
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Model"]</pems-label>
                <pems-input name="Model" value="@Model.Model" />
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Material"]</pems-label>
                <pems-input name="Material" value="@Model.Material" />
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Design Pressure"]</pems-label>
                <pems-input type="number" step="any" name="DesignPressure" value="@Model.DesignPressure" />
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Design Temperature"]</pems-label>
                <pems-input type="number" step="any" name="DesignTemperature" value="@Model.DesignTemperature" />
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Operating Pressure"]</pems-label>
                <pems-input type="number" step="any" name="OperatingPressure" value="@Model.OperatingPressure" />
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Operating Temperature"]</pems-label>
                <pems-input type="number" step="any" name="OperatingTemperature" value="@Model.OperatingTemperature" />
            </pems-col>
            <pems-col span="12">
                <pems-label>@Localizer["توضیحات (اختیاری)"]</pems-label>
                <pems-textarea name="Description" rows="2">@Model.Description</pems-textarea>
            </pems-col>
        </pems-row>

        <pems-flex gap="2">
            <pems-button tone="primary" type="submit"><pems-icon name="bi-save" /> @Localizer["ذخیره"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Passport" asp-route-id="@Model.MechanicalEquipmentId">@Localizer["انصراف"]</pems-button>
        </pems-flex>
    </form>
</pems-content-card>
