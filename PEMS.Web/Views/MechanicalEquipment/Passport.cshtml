@model PEMS.Domain.Entities.MechanicalEquipment
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Mechanical Equipment Passport";
    var rotating = (PEMS.Domain.Entities.RotatingEquipment?)ViewBag.Rotating;
    var staticEq = (PEMS.Domain.Entities.StaticEquipment?)ViewBag.Static;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small d-print-none">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small d-print-none">@TempData["Error"]</pems-alert>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.TagNumber</h5>
            <div class="text-muted small">@Model.EquipmentType @(Model.Equipment != null ? $"— {Model.Equipment.Name}" : "")</div>
        </div>
        <div class="d-print-none d-flex gap-2">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Edit" asp-route-id="@Model.MechanicalEquipmentId"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" type="button" onclick="window.print()"><pems-icon name="bi-printer" /> @Localizer["Print"]</pems-button>
            @if (Model.EquipmentId.HasValue)
            {
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-box-seam" /> @Localizer["Equipment"]</pems-button>
            }
        </div>
    </div>

    <hr />
    <pems-row gap="2" css="small">
        <pems-col md="3"><strong>@Localizer["Manufacturer"]:</strong> @(Model.Manufacturer ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Model"]:</strong> @(Model.Model ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Material"]:</strong> @(Model.Material ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Design Pressure"]:</strong> @(Model.DesignPressure?.ToString() ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Design Temperature"]:</strong> @(Model.DesignTemperature?.ToString() ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Operating Pressure"]:</strong> @(Model.OperatingPressure?.ToString() ?? "N/A")</pems-col>
        <pems-col md="3"><strong>@Localizer["Operating Temperature"]:</strong> @(Model.OperatingTemperature?.ToString() ?? "N/A")</pems-col>
    </pems-row>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="small text-muted mt-2 mb-0">@Model.Description</p>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-gear-wide-connected" /> @Localizer["Rotating Equipment"]</h6>
    @if (rotating != null)
    {
        <pems-row gap="2" css="small">
            <pems-col md="3"><strong>@Localizer["Type"]:</strong> @rotating.EquipmentType</pems-col>
            <pems-col md="3"><strong>@Localizer["Flow Rate"]:</strong> @(rotating.FlowRate?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Head"]:</strong> @(rotating.Head?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Speed (RPM)"]:</strong> @(rotating.SpeedRPM?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Power (kW)"]:</strong> @(rotating.PowerKW?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Driver Type"]:</strong> @(rotating.DriverType ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Bearing Type"]:</strong> @(rotating.BearingType ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Lubrication"]:</strong> @(rotating.LubricationType ?? "N/A")</pems-col>
        </pems-row>
    }
    else if (staticEq == null)
    {
        <p class="text-muted small mb-2">@Localizer["هنوز به‌عنوان Rotating طبقه‌بندی نشده."]</p>
        <pems-button tone="primary" size="small" outline="true" css="d-print-none" type="button" data-bs-toggle="modal" data-bs-target="#classifyRotatingModal">
            <pems-icon name="bi-plus-lg" /> @Localizer["Classify as Rotating"]
        </pems-button>
    }
    else
    {
        <p class="text-muted small mb-0">@Localizer["این تجهیز به‌عنوان Static طبقه‌بندی شده - یک تجهیز نمی‌تواند هم Rotating هم Static باشد."]</p>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><pems-icon name="bi-box" /> @Localizer["Static Equipment"]</h6>
    @if (staticEq != null)
    {
        <pems-row gap="2" css="small">
            <pems-col md="3"><strong>@Localizer["Type"]:</strong> @staticEq.EquipmentType</pems-col>
            <pems-col md="3"><strong>@Localizer["Volume"]:</strong> @(staticEq.Volume?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Design Pressure"]:</strong> @(staticEq.DesignPressure?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Design Temperature"]:</strong> @(staticEq.DesignTemperature?.ToString() ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Material"]:</strong> @(staticEq.Material ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Orientation"]:</strong> @(staticEq.Orientation ?? "N/A")</pems-col>
            <pems-col md="3"><strong>@Localizer["Code Standard"]:</strong> @(staticEq.CodeStandard ?? "N/A")</pems-col>
        </pems-row>
    }
    else if (rotating == null)
    {
        <p class="text-muted small mb-2">@Localizer["هنوز به‌عنوان Static طبقه‌بندی نشده."]</p>
        <pems-button tone="info" size="small" outline="true" css="d-print-none" type="button" data-bs-toggle="modal" data-bs-target="#classifyStaticModal">
            <pems-icon name="bi-plus-lg" /> @Localizer["Classify as Static"]
        </pems-button>
    }
    else
    {
        <p class="text-muted small mb-0">@Localizer["این تجهیز به‌عنوان Rotating طبقه‌بندی شده - یک تجهیز نمی‌تواند هم Rotating هم Static باشد."]</p>
    }
</div>

<pems-modal size="large" id="classifyRotatingModal" tabindex="-1">
        <form asp-action="ClassifyRotating" method="post">
            <input type="hidden" name="mechanicalEquipmentId" value="@Model.MechanicalEquipmentId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Classify as Rotating Equipment"]</h6></div>
            <div class="modal-body">
                <pems-row gap="3" css="mb-3">
                    <pems-col md="6"><pems-label>@Localizer["Equipment Type"]</pems-label><pems-input name="equipmentType" required placeholder="@Localizer["Pump, Compressor, Fan, Blower ..."]" /></pems-col>
                    <pems-col md="6"><pems-label>@Localizer["Driver Type"]</pems-label><pems-input name="driverType" placeholder="@Localizer["Motor, Turbine, Engine"]" /></pems-col>
                </pems-row>
                <pems-row gap="3" css="mb-3">
                    <pems-col md="3"><pems-label>@Localizer["Flow Rate"]</pems-label><pems-input type="number" step="any" name="flowRate" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Head"]</pems-label><pems-input type="number" step="any" name="head" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Speed (RPM)"]</pems-label><pems-input type="number" name="speedRPM" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Power (kW)"]</pems-label><pems-input type="number" step="any" name="powerKW" /></pems-col>
                </pems-row>
                <pems-row gap="3" css="mb-3">
                    <pems-col md="6"><pems-label>@Localizer["Bearing Type"]</pems-label><pems-input name="bearingType" /></pems-col>
                    <pems-col md="6"><pems-label>@Localizer["Lubrication Type"]</pems-label><pems-input name="lubricationType" /></pems-col>
                </pems-row>
                <div class="mb-2"><pems-label>@Localizer["توضیحات (اختیاری)"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </div>
        </form>
    </pems-modal>

<pems-modal size="large" id="classifyStaticModal" tabindex="-1">
        <form asp-action="ClassifyStatic" method="post">
            <input type="hidden" name="mechanicalEquipmentId" value="@Model.MechanicalEquipmentId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Classify as Static Equipment"]</h6></div>
            <div class="modal-body">
                <pems-row gap="3" css="mb-3">
                    <pems-col md="6"><pems-label>@Localizer["Equipment Type"]</pems-label><pems-input name="equipmentType" required placeholder="@Localizer["Vessel, Tank, Column, Heat Exchanger, Filter ..."]" /></pems-col>
                    <pems-col md="6"><pems-label>@Localizer["Orientation"]</pems-label><pems-input name="orientation" placeholder="@Localizer["Vertical, Horizontal"]" /></pems-col>
                </pems-row>
                <pems-row gap="3" css="mb-3">
                    <pems-col md="3"><pems-label>@Localizer["Volume"]</pems-label><pems-input type="number" step="any" name="volume" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Design Pressure"]</pems-label><pems-input type="number" step="any" name="designPressure" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Design Temperature"]</pems-label><pems-input type="number" step="any" name="designTemperature" /></pems-col>
                    <pems-col md="3"><pems-label>@Localizer["Code Standard"]</pems-label><pems-input name="codeStandard" placeholder="@Localizer["ASME, API"]" /></pems-col>
                </pems-row>
                <div class="mb-2"><pems-label>@Localizer["Material"]</pems-label><pems-input name="material" /></div>
                <div class="mb-2"><pems-label>@Localizer["توضیحات (اختیاری)"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </div>
        </form>
    </pems-modal>
