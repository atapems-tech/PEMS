@model PEMS.Domain.Entities.MechanicalEquipment
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Mechanical Equipment Passport";
    var rotating = (PEMS.Domain.Entities.RotatingEquipment?)ViewBag.Rotating;
    var staticEq = (PEMS.Domain.Entities.StaticEquipment?)ViewBag.Static;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small d-print-none">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small d-print-none">@TempData["Error"]</pems-alert>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.TagNumber</h5>
            <div class="text-muted small">@Model.EquipmentType @(Model.Equipment != null ? $"— {Model.Equipment.Name}" : "")</div>
        </div>
        <div class="d-print-none d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MechanicalEquipmentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> @Localizer["Edit"]</a>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> @Localizer["Print"]</button>
            @if (Model.EquipmentId.HasValue)
            {
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-seam"></i> @Localizer["Equipment"]</a>
            }
        </div>
    </div>

    <hr />
    <div class="row g-2 small">
        <div class="col-md-3"><strong>@Localizer["Manufacturer"]:</strong> @(Model.Manufacturer ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Model"]:</strong> @(Model.Model ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Material"]:</strong> @(Model.Material ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Design Pressure"]:</strong> @(Model.DesignPressure?.ToString() ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Design Temperature"]:</strong> @(Model.DesignTemperature?.ToString() ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Operating Pressure"]:</strong> @(Model.OperatingPressure?.ToString() ?? "N/A")</div>
        <div class="col-md-3"><strong>@Localizer["Operating Temperature"]:</strong> @(Model.OperatingTemperature?.ToString() ?? "N/A")</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="small text-muted mt-2 mb-0">@Model.Description</p>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-gear-wide-connected"></i> @Localizer["Rotating Equipment"]</h6>
    @if (rotating != null)
    {
        <div class="row g-2 small">
            <div class="col-md-3"><strong>@Localizer["Type"]:</strong> @rotating.EquipmentType</div>
            <div class="col-md-3"><strong>@Localizer["Flow Rate"]:</strong> @(rotating.FlowRate?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Head"]:</strong> @(rotating.Head?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Speed (RPM)"]:</strong> @(rotating.SpeedRPM?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Power (kW)"]:</strong> @(rotating.PowerKW?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Driver Type"]:</strong> @(rotating.DriverType ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Bearing Type"]:</strong> @(rotating.BearingType ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Lubrication"]:</strong> @(rotating.LubricationType ?? "N/A")</div>
        </div>
    }
    else if (staticEq == null)
    {
        <p class="text-muted small mb-2">@Localizer["هنوز به‌عنوان Rotating طبقه‌بندی نشده."]</p>
        <button type="button" class="btn btn-sm btn-outline-primary d-print-none" data-bs-toggle="modal" data-bs-target="#classifyRotatingModal">
            <i class="bi bi-plus-lg"></i> @Localizer["Classify as Rotating"]
        </button>
    }
    else
    {
        <p class="text-muted small mb-0">@Localizer["این تجهیز به‌عنوان Static طبقه‌بندی شده - یک تجهیز نمی‌تواند هم Rotating هم Static باشد."]</p>
    }
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-box"></i> @Localizer["Static Equipment"]</h6>
    @if (staticEq != null)
    {
        <div class="row g-2 small">
            <div class="col-md-3"><strong>@Localizer["Type"]:</strong> @staticEq.EquipmentType</div>
            <div class="col-md-3"><strong>@Localizer["Volume"]:</strong> @(staticEq.Volume?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Design Pressure"]:</strong> @(staticEq.DesignPressure?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Design Temperature"]:</strong> @(staticEq.DesignTemperature?.ToString() ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Material"]:</strong> @(staticEq.Material ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Orientation"]:</strong> @(staticEq.Orientation ?? "N/A")</div>
            <div class="col-md-3"><strong>@Localizer["Code Standard"]:</strong> @(staticEq.CodeStandard ?? "N/A")</div>
        </div>
    }
    else if (rotating == null)
    {
        <p class="text-muted small mb-2">@Localizer["هنوز به‌عنوان Static طبقه‌بندی نشده."]</p>
        <button type="button" class="btn btn-sm btn-outline-info d-print-none" data-bs-toggle="modal" data-bs-target="#classifyStaticModal">
            <i class="bi bi-plus-lg"></i> @Localizer["Classify as Static"]
        </button>
    }
    else
    {
        <p class="text-muted small mb-0">@Localizer["این تجهیز به‌عنوان Rotating طبقه‌بندی شده - یک تجهیز نمی‌تواند هم Rotating هم Static باشد."]</p>
    }
</div>

<div class="modal fade" id="classifyRotatingModal" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <form asp-action="ClassifyRotating" method="post">
            <input type="hidden" name="mechanicalEquipmentId" value="@Model.MechanicalEquipmentId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Classify as Rotating Equipment"]</h6></div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label class="form-label">@Localizer["Equipment Type"]</label><input name="equipmentType" class="form-control" required placeholder="@Localizer["Pump, Compressor, Fan, Blower ..."]" /></div>
                    <div class="col-md-6"><label class="form-label">@Localizer["Driver Type"]</label><input name="driverType" class="form-control" placeholder="@Localizer["Motor, Turbine, Engine"]" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><label class="form-label">@Localizer["Flow Rate"]</label><input type="number" step="any" name="flowRate" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Head"]</label><input type="number" step="any" name="head" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Speed (RPM)"]</label><input type="number" name="speedRPM" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Power (kW)"]</label><input type="number" step="any" name="powerKW" class="form-control" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label class="form-label">@Localizer["Bearing Type"]</label><input name="bearingType" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">@Localizer["Lubrication Type"]</label><input name="lubricationType" class="form-control" /></div>
                </div>
                <div class="mb-2"><label class="form-label">@Localizer["توضیحات (اختیاری)"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ثبت"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="classifyStaticModal" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <form asp-action="ClassifyStatic" method="post">
            <input type="hidden" name="mechanicalEquipmentId" value="@Model.MechanicalEquipmentId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Classify as Static Equipment"]</h6></div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label class="form-label">@Localizer["Equipment Type"]</label><input name="equipmentType" class="form-control" required placeholder="@Localizer["Vessel, Tank, Column, Heat Exchanger, Filter ..."]" /></div>
                    <div class="col-md-6"><label class="form-label">@Localizer["Orientation"]</label><input name="orientation" class="form-control" placeholder="@Localizer["Vertical, Horizontal"]" /></div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3"><label class="form-label">@Localizer["Volume"]</label><input type="number" step="any" name="volume" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Design Pressure"]</label><input type="number" step="any" name="designPressure" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Design Temperature"]</label><input type="number" step="any" name="designTemperature" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">@Localizer["Code Standard"]</label><input name="codeStandard" class="form-control" placeholder="@Localizer["ASME, API"]" /></div>
                </div>
                <div class="mb-2"><label class="form-label">@Localizer["Material"]</label><input name="material" class="form-control" /></div>
                <div class="mb-2"><label class="form-label">@Localizer["توضیحات (اختیاری)"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ثبت"]</button>
            </div>
        </form>
    </div></div>
</div>
