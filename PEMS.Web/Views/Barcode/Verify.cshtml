@model PEMS.Application.DTOs.BarcodeIdentityDto?
@{
    ViewData["Title"] = "Verify Barcode";
    var resolution = ViewBag.Resolution as PEMS.Application.DTOs.BarcodeResolutionResultDto;
    var mismatch = (bool)ViewBag.Mismatch;
}

@await Html.PartialAsync("_PageHeader")

<pems-content-card>
    @if (mismatch)
    {
        <pems-alert tone="danger">
            <strong><pems-icon name="bi-exclamation-octagon-fill" /> EQUIPMENT IDENTITY MISMATCH</strong>
            <pems-text class="mb-0 small">This barcode resolves to a different target than expected. Do not assume this label is attached to the correct physical object without further investigation.</pems-text>
        </pems-alert>
    }
    else if (resolution?.Success == true)
    {
        <pems-alert tone="success" css="mb-0">
            <strong><pems-icon name="bi-check-circle-fill" /> Match</strong>
            <pems-text class="mb-0 small">Resolved to @Model?.TargetType #@Model?.TargetDisplayLabel - Status: @Model?.Status</pems-text>
        </pems-alert>
    }
    else
    {
        <pems-alert tone="danger" css="mb-0">
            <strong>@resolution?.ErrorCode</strong>
            <pems-text class="mb-0 small">@resolution?.ErrorMessage</pems-text>
        </pems-alert>
    }
    <pems-text class="text-muted small mt-3 mb-0">
        Barcode verification confirms the digital identity only - it cannot prove the physical label is
        attached to the correct physical object beyond what is checked here.
    </pems-text>
</pems-content-card>
