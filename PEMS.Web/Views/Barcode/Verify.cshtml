@model PEMS.Application.DTOs.BarcodeIdentityDto?
@{
    ViewData["Title"] = "Verify Barcode";
    var resolution = ViewBag.Resolution as PEMS.Application.DTOs.BarcodeResolutionResultDto;
    var mismatch = (bool)ViewBag.Mismatch;
}

@await Html.PartialAsync("_PageHeader")

<div class="content-card">
    @if (mismatch)
    {
        <pems-alert tone="danger">
            <strong><i class="bi bi-exclamation-octagon-fill"></i> EQUIPMENT IDENTITY MISMATCH</strong>
            <p class="mb-0 small">This barcode resolves to a different target than expected. Do not assume this label is attached to the correct physical object without further investigation.</p>
        </pems-alert>
    }
    else if (resolution?.Success == true)
    {
        <pems-alert tone="success" css="mb-0">
            <strong><i class="bi bi-check-circle-fill"></i> Match</strong>
            <p class="mb-0 small">Resolved to @Model?.TargetType #@Model?.TargetDisplayLabel - Status: @Model?.Status</p>
        </pems-alert>
    }
    else
    {
        <pems-alert tone="danger" css="mb-0">
            <strong>@resolution?.ErrorCode</strong>
            <p class="mb-0 small">@resolution?.ErrorMessage</p>
        </pems-alert>
    }
    <p class="text-muted small mt-3 mb-0">
        Barcode verification confirms the digital identity only - it cannot prove the physical label is
        attached to the correct physical object beyond what is checked here.
    </p>
</div>
