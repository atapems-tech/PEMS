@{
    var disciplines = ViewBag.Disciplines;
    var equipmentTypes = (List<string>)ViewBag.EquipmentTypes;
    var equipments = (List<PEMS.Domain.Entities.Equipment>)ViewBag.Equipments;
    var noFilterApplied = (bool)ViewBag.NoFilterApplied;
    var maxResults = (int)ViewBag.MaxResults;
    var alreadyBarcodedIds = ((List<int>)ViewBag.AlreadyBarcodedIds).ToHashSet();
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Barcode</a>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-0">Discipline</label>
            <select name="disciplineIds" class="form-select" multiple size="4">
                @foreach (dynamic d in disciplines)
                {
                    <option value="@d.DisciplineId">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-0">Equipment Type</label>
            <select name="equipmentTypes" class="form-select" multiple size="4">
                @foreach (var t in equipmentTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">Tag Number (partial search)</label>
            <input name="tagSearch" class="form-control" dir="ltr" />
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-pems-solid w-100"><i class="bi bi-funnel"></i></button>
        </div>
    </form>
</div>

@if (noFilterApplied)
{
    <div class="alert alert-info">Select at least one filter to see matching Equipment - the full fleet is never listed unfiltered.</div>
}
else
{
    <form asp-action="BulkGenerateCommit" method="post">
        <div class="content-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted">Showing @equipments.Count of @ViewBag.MatchingCount matching (capped at @maxResults)</span>
                <div class="d-flex gap-2 align-items-center">
                    <select name="symbology" class="form-select form-select-sm" style="width:auto;">
                        <option value="Code128">Code128</option>
                        <option value="QR">QR</option>
                    </select>
                    <button type="submit" class="btn btn-pems-solid btn-sm" onclick="return confirm('Generate barcodes for the selected Equipment? Equipment that already has an active barcode is skipped.')">
                        <i class="bi bi-upc-scan"></i> Generate &amp; Print Labels
                    </button>
                </div>
            </div>
            <div class="table-responsive table-scroll-area" style="max-height:55vh; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th></th><th>Tag</th><th>Name</th><th>Type</th><th>Barcode</th></tr></thead>
                    <tbody>
                        @foreach (var eq in equipments)
                        {
                            var already = alreadyBarcodedIds.Contains(eq.EquipmentId);
                            <tr>
                                <td><input type="checkbox" name="equipmentIds" value="@eq.EquipmentId" checked="@(!already)" /></td>
                                <td dir="ltr"><strong>@eq.TagNumber</strong></td>
                                <td class="small">@eq.Name</td>
                                <td class="small">@eq.EquipmentType</td>
                                <td>@if (already) { <span class="badge bg-secondary">Already has barcode</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!equipments.Any()) { <p class="text-muted text-center py-4">No Equipment matches this filter.</p> }
        </div>
    </form>
}
