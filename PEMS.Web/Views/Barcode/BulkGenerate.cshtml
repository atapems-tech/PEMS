@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var disciplines = ViewBag.Disciplines;
    var equipmentTypes = (List<string>)ViewBag.EquipmentTypes;
    var equipments = (List<PEMS.Domain.Entities.Equipment>)ViewBag.Equipments;
    var noFilterApplied = (bool)ViewBag.NoFilterApplied;
    var maxResults = (int)ViewBag.MaxResults;
    var alreadyBarcodedIds = ((List<int>)ViewBag.AlreadyBarcodedIds).ToHashSet();
}

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Barcode"]</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <form method="get"><pems-row gap="2">
        <pems-col md="4">
            <pems-label css="small mb-0">@Localizer["Discipline"]</pems-label>
            <pems-select name="disciplineIds" multiple size="4">
                @foreach (dynamic d in disciplines)
                {
                    <option value="@d.DisciplineId">@d.Name</option>
                }
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label css="small mb-0">@Localizer["Equipment Type"]</pems-label>
            <pems-select name="equipmentTypes" multiple size="4">
                @foreach (var t in equipmentTypes)
                {
                    <option value="@t">@t</option>
                }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">Tag Number (partial search)</pems-label>
            <pems-input name="tagSearch" dir="ltr" />
        </pems-col>
        <pems-col md="1" css="d-flex align-items-end">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-funnel" /></pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

@if (noFilterApplied)
{
    <pems-alert tone="info">Select at least one filter to see matching Equipment - the full fleet is never listed unfiltered.</pems-alert>
}
else
{
    <form asp-action="BulkGenerateCommit" method="post">
        <pems-content-card css="mb-3">
            <pems-flex justify="between" align="center" css="mb-2">
                <span class="small text-muted">Showing @equipments.Count of @ViewBag.MatchingCount matching (capped at @maxResults)</span>
                <pems-flex gap="2" align="center">
                    <pems-select class="w-auto" scale="small" name="symbology">
                        <option value="Code128">@Localizer["Code128"]</option>
                        <option value="QR">QR</option>
                    </pems-select>
                    <pems-button tone="primary" size="small" type="submit" data-pems-confirm="Generate barcodes for the selected Equipment? Equipment that already has an active barcode is skipped.">
                        <pems-icon name="bi-upc-scan" /> Generate &amp; Print Labels
                    </pems-button>
                </pems-flex>
            </pems-flex>
            <pems-table-scroll css="table-scroll-area pems-s-b4b96c72">
                <pems-table kind="enterprise">
                    <thead><tr><th></th><th>@Localizer["Tag"]</th><th>@Localizer["Name"]</th><th>@Localizer["Type"]</th><th>@Localizer["Barcode"]</th></tr></thead>
                    <tbody>
                        @foreach (var eq in equipments)
                        {
                            var already = alreadyBarcodedIds.Contains(eq.EquipmentId);
                            <tr>
                                <td><input type="checkbox" name="equipmentIds" value="@eq.EquipmentId" checked="@(!already)" /></td>
                                <td dir="ltr"><strong>@eq.TagNumber</strong></td>
                                <td class="small">@eq.Name</td>
                                <td class="small">@eq.EquipmentType</td>
                                <td>@if (already) { <pems-badge tone="neutral">Already has barcode</pems-badge> }</td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </pems-table-scroll>
            @if (!equipments.Any()) { <p class="text-muted text-center py-4">No Equipment matches this filter.</p> }
        </pems-content-card>
    </form>
}
