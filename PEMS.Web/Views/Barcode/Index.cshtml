@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var recent = ViewBag.RecentBarcodes as System.Collections.IEnumerable;
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-action="BulkGenerate" class="btn btn-pems-solid btn-sm"><i class="bi bi-grid-3x3-gap"></i> Bulk Generate (Equipment)</a>
</div>

<div class="content-card mb-3">
    <p class="text-muted small mb-0">
        A shared identification capability across PEMS - Equipment, Material, Warehouse and Storage Location.
        A barcode carries only a stable, non-guessable token; the actual business data always stays inside PEMS
        and is loaded only after resolving the barcode and passing the target resource's own authorization.
        Generate barcodes from an existing record's own Barcode tab (Equipment/Material Details), or use Bulk
        Generate for Equipment.
    </p>
</div>

<div class="content-card mb-3">
    <form asp-action="Resolve" method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small">Scan or type a barcode code</label>
            <input type="text" name="code" class="form-control" dir="ltr" placeholder="PEMS-BR-..." required autofocus />
        </div>
        <div class="col-md-4">
            <pems-button tone="primary" css="w-100" type="submit"><i class="bi bi-search"></i> @Localizer["Resolve"]</pems-button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Recent Barcodes"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead>
            <tr>
                <th>@Localizer["Code"]</th><th>@Localizer["Symbology"]</th><th>@Localizer["Target"]</th><th>@Localizer["Status"]</th><th class="text-end">@Localizer["Prints"]</th><th>@Localizer["Created"]</th>
            </tr>
        </thead>
        <tbody>
            @if (recent != null)
            {
                @foreach (dynamic b in recent)
                {
                    <tr>
                        <td dir="ltr"><code>@b.Code</code></td>
                        <td>@b.Symbology</td>
                        <td class="small">@b.TargetType #@b.TargetId</td>
                        <td><span class="badge @(b.Status == "Active" ? "bg-success" : b.Status == "Disabled" ? "bg-secondary" : "bg-danger")">@b.Status</span></td>
                        <td class="text-end">@b.PrintCount</td>
                        <td class="small">@(((DateTime)b.CreatedDate).ToString("yyyy-MM-dd HH:mm"))</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</div>
