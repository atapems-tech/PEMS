@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var recent = ViewBag.RecentBarcodes as System.Collections.IEnumerable;
}

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="primary" size="small" as="a" asp-action="BulkGenerate"><pems-icon name="bi-grid-3x3-gap" /> Bulk Generate (Equipment)</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <p class="text-muted small mb-0">
        A shared identification capability across PEMS - Equipment, Material, Warehouse and Storage Location.
        A barcode carries only a stable, non-guessable token; the actual business data always stays inside PEMS
        and is loaded only after resolving the barcode and passing the target resource's own authorization.
        Generate barcodes from an existing record's own Barcode tab (Equipment/Material Details), or use Bulk
        Generate for Equipment.
    </p>
</pems-content-card>

<pems-content-card css="mb-3">
    <form asp-action="Resolve" method="get"><pems-row gap="2" css="align-items-end">
        <pems-col md="8">
            <pems-label css="small">Scan or type a barcode code</pems-label>
            <pems-input type="text" name="code" dir="ltr" placeholder="PEMS-BR-..." required autofocus />
        </pems-col>
        <pems-col md="4">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-search" /> @Localizer["Resolve"]</pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Recent Barcodes"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <thead>
            <tr>
                <th>@Localizer["Code"]</th><th>@Localizer["Symbology"]</th><th>@Localizer["Target"]</th><th>@Localizer["Status"]</th><th class="text-end">@Localizer["Prints"]</th><th>@Localizer["Created"]</th>
            </tr>
        </thead>
        <tbody>
            @if (recent != null)
            {
                @foreach (dynamic b in recent)
                {
                    <tr>
                        <td dir="ltr"><code>@b.Code</code></td>
                        <td>@b.Symbology</td>
                        <td class="small">@b.TargetType #@b.TargetId</td>
                        <td><pems-badge tone="@(b.Status == "Active" ? "success" : b.Status == "Disabled" ? "neutral" : "danger")">@b.Status</pems-badge></td>
                        <td class="text-end">@b.PrintCount</td>
                        <td class="small">@(((DateTime)b.CreatedDate).ToString("yyyy-MM-dd HH:mm"))</td>
                    </tr>
                }
            }
        </tbody>
    </pems-table>
    </pems-table-scroll>
</pems-content-card>
