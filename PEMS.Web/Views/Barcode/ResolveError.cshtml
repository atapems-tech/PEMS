@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Barcode Not Resolved";
    var errorCode = (string?)ViewBag.ErrorCode;
    var message = (string?)ViewBag.ErrorMessage;
}

<pems-content-card>
    <pems-alert tone="danger" css="mb-0">
        <pems-heading level="6" class="alert-heading"><pems-icon name="bi-exclamation-triangle-fill" /> @errorCode</pems-heading>
        <pems-text class="mb-0">@message</pems-text>
    </pems-alert>
    <pems-button tone="neutral" size="small" outline="true" css="mt-3" as="a" asp-action="Index">@Localizer["← Back to Barcode"]</pems-button>
</pems-content-card>
