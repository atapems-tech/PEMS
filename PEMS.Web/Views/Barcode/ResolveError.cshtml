@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Barcode Not Resolved";
    var errorCode = (string?)ViewBag.ErrorCode;
    var message = (string?)ViewBag.ErrorMessage;
}

<div class="content-card">
    <pems-alert tone="danger" css="mb-0">
        <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> @errorCode</h6>
        <p class="mb-0">@message</p>
    </pems-alert>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-3">@Localizer["← Back to Barcode"]</a>
</div>
