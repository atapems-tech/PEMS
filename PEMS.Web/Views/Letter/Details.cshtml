@model PEMS.Application.DTOs.LetterDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var l = Model.Letter;
    var departments = (IEnumerable<dynamic>)ViewBag.Departments;
    var allTags = (List<PEMS.Application.DTOs.TagDto>)ViewBag.AllTags;
    var timeline = (List<PEMS.Application.DTOs.LetterTimelineEventDto>)ViewBag.Timeline;
    var thread = (List<PEMS.Application.DTOs.ThreadMessageDto>)ViewBag.Thread;
    var conversation = ViewBag.Conversation as List<PEMS.Application.DTOs.ConversationMessageDto>;
    bool canEditReturned = ViewBag.CanEditReturned;
    bool canEditDraft = ViewBag.CanEditDraft;
    bool canReview = ViewBag.CanReview;
    bool isCurrentApprover = ViewBag.IsCurrentApprover == true;
    bool canEditNow = canEditReturned || canEditDraft;
    bool canManageResponse = ViewBag.CanManageResponse == true;
    bool isAuthor = ViewBag.IsAuthor == true;
    bool isAdmin = ViewBag.IsAdmin == true;
    bool canArchive = ViewBag.CanArchive == true;
    bool canAudit = ViewBag.CanAudit == true;
    bool isFormal = l.LetterType == "Internal" || l.LetterType == "Outgoing";

    string statusBadgeClass = PEMS.Web.Helpers.LetterStatusBadge.CssClass(l.Status);

    // embedded in the cartable's side pane: compact layout; every action inside opens the full page (see _LayoutEmbed: <base target="_top">)
    bool embed = ViewBag.Embed == true;
    if (embed) { Layout = "_LayoutEmbed"; ViewData["HidePageTitle"] = true; }
    string historyRole = (string?)ViewBag.HistoryRole ?? "all";
    string historyOrder = (string?)ViewBag.HistoryOrder ?? "asc";
}


<pems-content-card css="mb-3 letter-header">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <pems-flex align="center" wrap="true" gap="2">
                <h5 class="mb-0">@l.LetterNumber</h5>
                <pems-badge tone="none" css="@statusBadgeClass">@l.Status</pems-badge>
                <pems-badge tone="light">@l.LetterType</pems-badge>
                @if (l.ConfidentialityLevel != "Public" && l.ConfidentialityLevel != "Internal")
                { <pems-badge tone="dark"><pems-icon name="bi-lock-fill" /> @l.ConfidentialityLevel</pems-badge> }
                @if (l.RevisionCount > 0)
                { <pems-badge tone="light">Rev. @l.RevisionCount</pems-badge> }
            </pems-flex>
            <h6 class="mt-2 mb-1">@l.Subject</h6>
            <pems-flex wrap="true" gap="3" css="small meta-item">
                <span><strong>@(l.LetterType == "Incoming" ? "From" : "To"):</strong> @(l.LetterType == "Incoming" ? l.Sender : l.Receiver)</span>
                <span><strong>Date:</strong> @l.LetterDate.ToString("yyyy-MM-dd")</span>
                <span><strong>@Localizer["Priority:"]</strong> @l.Priority</span>
                @if (!string.IsNullOrEmpty(l.Category)) { <span><strong>@Localizer["Lc_Category"]:</strong> @Localizer["Lc_Cat_" + l.Category]</span> }
                @if (!string.IsNullOrEmpty(l.ReferenceNumber)) { <span><strong>@Localizer["Lc_Reference"]:</strong> @l.ReferenceNumber</span> }
                @if (!string.IsNullOrEmpty(l.ProjectName)) { <span><strong>@Localizer["Project:"]</strong> @l.ProjectName</span> }
                @if (!string.IsNullOrEmpty(l.DisciplineName)) { <span><strong>@Localizer["Discipline:"]</strong> @l.DisciplineName</span> }
                @if (l.ResponseRequired && l.ResponseDueDate.HasValue)
                {
                    <span>
                        <strong>@Localizer["Lt_ResponseDueDate"]:</strong> @l.ResponseDueDate.Value.ToString("yyyy-MM-dd")
                        @if (l.ResponseAnswered) { <pems-badge tone="success"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Lt_ResponseAnswered"]</pems-badge> }
                        else if (l.ResponseOverdue) { <pems-badge tone="danger"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Lt_Overdue"]</pems-badge> }
                        else { <pems-badge tone="neutral"><pems-icon name="bi-hourglass-split" aria-hidden="true" /> @Localizer["Lt_ResponsePending"]</pems-badge> }
                    </span>
                }
            </pems-flex>
            @if (canManageResponse)
            {
                <details class="mt-2 small">
                    <summary>@Localizer["Lt_ResponseEdit"]</summary>
                    <pems-form class="mt-2" asp-action="SetResponseDue" method="post"><pems-flex wrap="true" align="end" gap="2">
                        <input type="hidden" name="letterId" value="@l.LetterId" />
                        <pems-check-row>
                            <pems-input type="checkbox" name="responseRequired" value="true" id="detResponseRequired" checked="@l.ResponseRequired" kind="check" />
                            <label class="form-check-label" for="detResponseRequired">@Localizer["Lt_ResponseRequired"]</label>
                        </pems-check-row>
                        <div>
                            <pems-label css="mb-1" for="detResponseDue">@Localizer["Lt_ResponseDueDate"]</pems-label>
                            <pems-date name="responseDueDate" id="detResponseDue" scale="small"
                                   value="@(l.ResponseDueDate?.ToString("yyyy-MM-dd"))" min="@l.LetterDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                    </pems-flex></pems-form>
                </details>
            }
        </div>

        <pems-flex align="center" gap="2">
            @* طبق بند ۳۳: بدون دکمه‌ی وضعیت آزاد - فقط اقدامات کسب‌وکاری نام‌گذاری‌شده، هرکدام
               فقط زمانی نمایش داده می‌شوند که واقعاً از وضعیت فعلی مجاز باشند (سرویس هم دوباره
               اعتبارسنجی می‌کند - این‌جا فقط UX است) *@
            @if (isFormal && (l.Status == "Draft" || l.Status == "ReturnedForRevision") && isAuthor)
            {
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="LetterCompose" asp-action="Compose" asp-route-id="@l.LetterId"><pems-icon name="bi-pencil-square" aria-hidden="true" /> @Localizer["Lc_EditInComposer"]</pems-button>
            }
            @if (l.Status == "Approved" && l.LetterType == "Internal" && isAuthor)
            {
                <pems-form asp-controller="LetterCompose" asp-action="Send" method="post" data-pems-confirm="@Localizer["Lc_ConfirmSend"]">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-send-check" aria-hidden="true" /> @Localizer["Lt_Send"]</pems-button>
                </pems-form>
            }
            @if (canArchive && (l.Status is "Sent" or "Closed" or "Issued" or "Acknowledged" or "Registered"))
            {
                <pems-form asp-controller="LetterCompose" asp-action="Archive" method="post" data-pems-confirm="@Localizer["Lc_ConfirmArchive"]">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-archive" aria-hidden="true" /> @Localizer["Lc_Archive"]</pems-button>
                </pems-form>
            }
            @if (l.Status == "Draft" && canEditDraft)
            {
                <pems-form asp-action="SubmitForReview" method="post" data-pems-confirm="Submit this draft for review?">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-send" /> @Localizer["Submit for Review"]</pems-button>
                </pems-form>
            }
            @if (l.Status == "ReturnedForRevision" && canEditReturned)
            {
                <pems-button tone="primary" size="small" type="button" data-pems-click="call" data-pems-fn="toggleBodyEdit" data-pems-arg="none"><pems-icon name="bi-pencil-square" /> Edit &amp; Resubmit</pems-button>
            }
            @if (l.Status == "PendingApproval" && (canReview || isCurrentApprover))
            {
                <pems-form asp-action="Approve" method="post" class="d-inline" data-pems-confirm="Approve this letter?">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> @Localizer["Approve"]</pems-button>
                </pems-form>
                <pems-button tone="warning" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#returnModal"><pems-icon name="bi-arrow-return-left" /> Return</pems-button>
                <pems-button tone="danger" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal"><pems-icon name="bi-x-lg" /> @Localizer["Reject"]</pems-button>
            }
            @if (l.Status == "Approved" && canReview && l.LetterType != "Internal")
            {
                <pems-form asp-action="Issue" method="post" data-pems-confirm="Issue this letter?">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-send-check" /> Issue</pems-button>
                </pems-form>
            }
            @if (l.Status == "Issued" && canReview)
            {
                <pems-form asp-action="Close" method="post" data-pems-confirm="Close this letter?">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-archive" /> Close</pems-button>
                </pems-form>
            }

            @if (l.Status != "Draft" && l.Status != "PendingApproval" && l.Status != "Rejected")
            {
                @* reply and referral are one flow: both open the composer on this letter (the referral keeps the subject and only takes the «referral» tag) *@
                <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="LetterCompose" asp-action="Compose" asp-route-replyTo="@l.LetterId"><pems-icon name="bi-reply" aria-hidden="true" /> @Localizer["Ct_Reply"]</pems-button>
                <pems-button tone="warning" size="small" outline="true" as="a" asp-controller="LetterCompose" asp-action="Compose" asp-route-referTo="@l.LetterId"><pems-icon name="bi-signpost-split" aria-hidden="true" /> @Localizer["Ct_Refer"]</pems-button>
            }
            <div class="dropdown">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More">
                    <pems-icon name="bi-three-dots-vertical" />
                </pems-button>
                <pems-dropdown-menu end="true">
                    <li><a class="dropdown-item" asp-action="Reply" asp-route-id="@l.LetterId"><pems-icon name="bi-reply-fill" css="me-1" /> Reply</a></li>
                    <li><a class="dropdown-item" asp-action="ExportPdf" asp-route-id="@l.LetterId"><pems-icon name="bi-file-earmark-pdf" css="me-1" /> Export PDF</a></li>
                    @if (canAudit)
                    {
                        <li><a class="dropdown-item" asp-controller="LetterCompose" asp-action="History" asp-route-id="@l.LetterId"><pems-icon name="bi-clock-history" css="me-1" aria-hidden="true" /> @Localizer["Lc_HistoryTitle"]</a></li>
                    }
                    @if (string.IsNullOrEmpty(l.SignedByName))
                    {
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#signModal"><pems-icon name="bi-pen" css="me-1" /> @Localizer["Sign / Acknowledge"]</a></li>
                    }
                    <li><a class="dropdown-item" href="#" data-bs-toggle="collapse" data-bs-target="#addTagCollapse"><pems-icon name="bi-tag" css="me-1" /> Manage Tags</a></li>
                </pems-dropdown-menu>
            </div>
        </pems-flex>
    </pems-flex>

    @if (l.Tags.Any())
    {
        <pems-flex wrap="true" align="center" gap="1" css="mt-2">
            @foreach (var tag in l.Tags)
            {
                <pems-badge tone="none" css="bg-@tag.Color">
                    @tag.Name
                    <pems-form asp-action="DetachTag" method="post" class="d-inline">
                        <input type="hidden" name="letterId" value="@l.LetterId" />
                        <input type="hidden" name="tagId" value="@tag.TagId" />
                        <pems-button plain="true" type="submit" css="btn-close btn-close-white btn-sm pems-s-3494e7ef" title="Remove tag"></pems-button>
                    </pems-form>
                </pems-badge>
            }
        </pems-flex>
    }

    <div class="collapse mt-2" id="addTagCollapse">
        <pems-flex wrap="true" gap="2">
            <pems-form asp-action="AttachTag" method="post"><pems-flex gap="1">
                <input type="hidden" name="letterId" value="@l.LetterId" />
                <pems-select scale="small" name="tagId" data-pems-change="submit-form">
                    <option value="">-- existing tag --</option>
                    @foreach (var t in allTags.Where(t => !l.Tags.Any(lt => lt.TagId == t.TagId)))
                    { <option value="@t.TagId">@t.Name</option> }
                </pems-select>
            </pems-flex></pems-form>
            <pems-form asp-action="AttachTag" method="post"><pems-flex gap="1">
                <input type="hidden" name="letterId" value="@l.LetterId" />
                <pems-input scale="small" name="newTagName" placeholder="New tag..." />
                <pems-select class="pems-w-90" scale="small" name="newTagColor">
                    @foreach (var c in new[] { "secondary", "primary", "success", "danger", "warning", "info", "dark" })
                    { <option value="@c">@c</option> }
                </pems-select>
                <pems-button tone="primary" size="small">+</pems-button>
            </pems-flex></pems-form>
        </pems-flex>
    </div>

    @if (l.Status == "ReturnedForRevision" && !string.IsNullOrEmpty(l.ReturnReason))
    {
        <pems-alert tone="warning" css="mt-3 mb-0 py-2 small">
            <pems-icon name="bi-arrow-return-left" /> Returned for revision by <strong>@l.ReturnedByName</strong>
            on @l.ReturnedDate?.ToString("yyyy-MM-dd HH:mm") &mdash; <em>@l.ReturnReason</em>
        </pems-alert>
    }
    @if (l.Status == "Rejected" && !string.IsNullOrEmpty(l.RejectReason))
    {
        <pems-alert tone="danger" css="mt-3 mb-0 py-2 small">
            <pems-icon name="bi-x-circle" /> Rejected by <strong>@l.RejectedByName</strong>
            on @l.RejectedDate?.ToString("yyyy-MM-dd HH:mm") &mdash; <em>@l.RejectReason</em>
        </pems-alert>
    }
</pems-content-card>

@if (Model.ApprovalSteps.Any())
{
    <pems-content-card css="mb-3" id="approvalChain">
        <div class="section-title mb-2">@Localizer["Lc_ApprovalChain"]</div>
        <ol class="list-unstyled mb-0">
            @foreach (var step in Model.ApprovalSteps.OrderBy(x => x.StepOrder))
            {
                var stepBadge = step.Status switch { "Approved" => "success", "Rejected" => "danger", "Returned" => "warning", _ => step.IsCurrent ? "primary" : "neutral" };
                <pems-flex as="li" wrap="true" align="center" gap="2" css="py-1 @(step.IsCurrent ? "fw-semibold" : "")">
                    <pems-badge tone="light" css="rounded-pill">@step.StepOrder</pems-badge>
                    <span>@step.ApproverName</span>
                    <pems-badge tone="@stepBadge">@(step.IsCurrent ? Localizer["Lc_StepCurrent"].Value : step.Status)</pems-badge>
                    @if (step.DecidedDate.HasValue) { <small class="text-muted">@step.DecidedDate.Value.ToString("yyyy-MM-dd HH:mm")</small> }
                    @if (!string.IsNullOrWhiteSpace(step.Comment)) { <small class="text-muted">&mdash; @step.Comment</small> }
                    @if (isAdmin && step.Status == "Pending" && l.Status == "PendingApproval")
                    {
                        <pems-form class="ms-auto" asp-controller="LetterCompose" asp-action="ReassignApprover" method="post"><pems-flex gap="1">
                            <input type="hidden" name="letterId" value="@l.LetterId" />
                            <input type="hidden" name="stepOrder" value="@step.StepOrder" />
                            <label class="visually-hidden" for="reassign@(step.StepOrder)">@Localizer["Lc_Reassign"]</label>
                            <pems-select scale="small" name="newApproverUserId" id="reassign@(step.StepOrder)" required>
                                <option value="">@Localizer["Lc_Reassign"]</option>
                                @foreach (var opt in (IEnumerable<PEMS.Application.DTOs.ApproverOptionDto>)(ViewBag.ApproverOptions ?? new List<PEMS.Application.DTOs.ApproverOptionDto>()))
                                {
                                    <option value="@opt.UserId">@opt.FullName</option>
                                }
                            </pems-select>
                            <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Lc_Reassign"]</pems-button>
                        </pems-flex></pems-form>
                    }
                </pems-flex>
            }
        </ol>
    </pems-content-card>
}

@* طبق بند ۱۴-۲۰: مکالمه/زنجیره‌ی پاسخ - محتوای رسمی به‌طور پیش‌فرض فقط-خواندنی؛ ویرایش فقط
   در حالت‌های مجاز و فقط توسط نویسنده‌ی اصلی، به‌صورت یک فرم صریح و مجزا (نه دکمه‌ی همیشه-حاضر) *@
@if (conversation != null && conversation.Count > 1)
{
    <pems-content-card as="section" css="mb-3" id="conversationPanel" aria-labelledby="cvTitle">
        <pems-flex align="center" gap="2" css="mb-2">
            <div class="section-title mb-0" id="cvTitle"><pems-icon name="bi-chat-left-text" css="me-1" aria-hidden="true" /> @Localizer["Ct_ConversationTitle"] (@conversation.Count)</div>
            <pems-flex as="span" inline="true" gap="2" css="ms-auto">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-cv-toggle="open">@Localizer["Ct_ExpandAll"]</pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-cv-toggle="close">@Localizer["Ct_CollapseAll"]</pems-button>
            </pems-flex>
        </pems-flex>
        @foreach (var m in conversation)
        {
            var kindClass = m.Kind.ToLowerInvariant();
            <article class="cv-msg cv-msg--@kindClass @(m.IsCurrent ? "cv-msg--current" : "")" aria-current="@(m.IsCurrent ? "true" : null)">
                @if (m.IsCurrent)
                {
                    <div class="cv-head">
                        <span class="cv-kind cv-kind--@kindClass"><pems-icon css="@(m.Kind == "Referral" ? "bi-signpost-split" : m.Kind == "Reply" ? "bi-reply" : "bi-envelope")" aria-hidden="true" /> @Localizer["Ct_Kind_" + m.Kind]</span>
                        <span class="cv-who">@m.SenderName</span>
                        <span class="text-muted">@m.LetterNumber &middot; @m.LetterDate.ToString("yyyy-MM-dd")</span>
                        <pems-badge tone="primary" css="ms-auto">@Localizer["Ct_ThisLetter"]</pems-badge>
                    </div>
                }
                else
                {
                    <details open>
                        <summary class="cv-head pems-s-3b6a3a65">
                            <span class="cv-kind cv-kind--@kindClass"><pems-icon css="@(m.Kind == "Referral" ? "bi-signpost-split" : m.Kind == "Reply" ? "bi-reply" : "bi-envelope")" aria-hidden="true" /> @Localizer["Ct_Kind_" + m.Kind]</span>
                            <span class="cv-who">@m.SenderName</span>
                            @if (!string.IsNullOrWhiteSpace(m.RecipientsSummary)) { <span class="cv-to">&rarr; @m.RecipientsSummary</span> }
                            <span class="text-muted ms-auto">@m.LetterNumber &middot; @m.LetterDate.ToString("yyyy-MM-dd")</span>
                            @if (m.AttachmentsCount > 0) { <pems-icon name="bi-paperclip" css="text-muted" aria-hidden="true" title="@Localizer["Lt_ColAttachments"]" /> }
                        </summary>
                        @if (!string.IsNullOrWhiteSpace(m.CcSummary)) { <div class="small cv-to mt-1">@Localizer["Lc_Cc"]: @m.CcSummary</div> }
                        <div class="cv-body">@Html.Raw(m.Body)</div>
                        <div class="small mt-2"><a asp-action="Details" asp-route-id="@m.LetterId">@Localizer["Lt_Open"]</a></div>
                    </details>
                }
            </article>
        }
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <div class="section-title mb-2">@Localizer["Message"]</div>

    @if (conversation == null && thread != null && thread.Count > 1)
    {
        for (int i = 0; i < thread.Count; i++)
        {
            var msg = thread[i];
            var isCurrent = msg.LetterId == l.LetterId;
            <div class="thread-message mb-2 @(isCurrent ? "current" : "")">
                @if (isCurrent)
                {
                    <div class="small text-muted mb-1"><strong>@msg.SenderOrRegisteredByName</strong> &middot; @msg.LetterNumber &middot; @msg.LetterDate.ToString("yyyy-MM-dd")</div>
                }
                else
                {
                    <div class="msg-summary small text-muted" data-bs-toggle="collapse" data-bs-target="#threadMsg@(i)">
                        <pems-icon name="bi-chevron-right" /> <strong>@msg.SenderOrRegisteredByName</strong> &middot; @msg.LetterNumber &middot; @msg.LetterDate.ToString("yyyy-MM-dd") &mdash; @msg.Subject
                    </div>
                    <div class="collapse" id="threadMsg@(i)">
                        <div class="border rounded p-2 mt-1 small">@Html.Raw(msg.Body)</div>
                    </div>
                }
            </div>
        }
    }

    @{
        // طبق بند ۱۴: Body پیش‌فرض فقط-خواندنی است. استثنای تنها Draft: چون این نامه هنوز اصلاً
        // منتشر نشده (هیچ‌کس دیگری آن را ندیده)، فرم ویرایش مستقیماً نمایش داده می‌شود؛ برای
        // ReturnedForRevision (که قبلاً یک‌بار برای بازبینی دیده شده) پیش‌فرض فقط-خواندنی است و
        // ویرایش فقط با کلیک صریح دکمه‌ی «Edit & Resubmit» در هدر باز می‌شود.
        bool showEditFormByDefault = l.Status == "Draft" && canEditDraft;
    }

    <div id="bodyViewMode" class="@(showEditFormByDefault ? "d-none" : "")">
        <div class="border rounded p-2">@Html.Raw(Model.Body)</div>
    </div>

    @if (canEditNow)
    {
        var editAction = l.Status == "Draft" ? "SaveDraft" : "Resubmit";
        var submitLabel = l.Status == "Draft" ? "Save Draft" : "Save & Resubmit for Review";

        @* طبق بند ۱۷: حالت ویرایش کنترل‌شده - قبل از فرم ویرایش، شماره‌ی رویژن و نسخه‌ای که بازبین
           واقعاً دیده (Snapshot) قابل‌مشاهده است تا نویسنده دقیقاً بداند از چه نسخه‌ای اصلاح می‌کند *@
        @if (l.Status == "ReturnedForRevision")
        {
            var latestReturnReview = Model.Reviews.FirstOrDefault(r => r.Decision == "ReturnedForRevision");
            <pems-flex align="center" justify="between" css="mt-2">
                <pems-badge tone="light">Revision @(l.RevisionCount + 1)</pems-badge>
                @if (latestReturnReview?.PreviousBodySnapshot != null)
                {
                    <pems-button tone="none" size="small" css="btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#previousVersionPanel">
                        <pems-icon name="bi-clock-history" /> View previous version (as reviewed)
                    </pems-button>
                }
            </pems-flex>
            @if (latestReturnReview?.PreviousBodySnapshot != null)
            {
                <div class="collapse mt-2" id="previousVersionPanel">
                    <div class="border rounded p-2 bg-light">
                        <div class="small text-muted mb-1">Subject: @latestReturnReview.PreviousSubjectSnapshot</div>
                        <div class="small">@Html.Raw(latestReturnReview.PreviousBodySnapshot)</div>
                    </div>
                </div>
            }
        }

        <pems-form id="bodyEditForm" asp-action="@editAction" method="post" class="mt-2 @(showEditFormByDefault ? "" : "d-none")">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(l.RowVersion ?? Array.Empty<byte>())" id="rowVersionB64" />
            <div class="mb-2">
                <pems-label css="small">@Localizer["Subject"]</pems-label>
                <pems-input type="text" name="subject" value="@l.Subject" required />
            </div>
            <pems-textarea name="body" id="letterBodyEditEditor">@Html.Raw(Model.Body)</pems-textarea>
            <pems-flex gap="2" css="mt-2">
                <pems-button tone="primary" size="small" type="submit">@submitLabel</pems-button>
                @if (!showEditFormByDefault)
                {
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-pems-click="call" data-pems-fn="toggleBodyEdit" data-pems-arg="none">@Localizer["Cancel"]</pems-button>
                }
            </pems-flex>
        </pems-form>

        @await Html.PartialAsync("_RichTextEditorScripts", "letterBodyEditEditor")
    }

    <script src="~/js/views/letter-details-1.js" asp-append-version="true"></script>
</pems-content-card>

@* طبق بند ۷/۱۲: بخش Review کاملاً جدا از Referral - «آیا نامه می‌تواند جلو برود» *@
@if (Model.Reviews.Any())
{
    <pems-content-card css="mb-3">
        <div class="section-title mb-2">Review Decisions</div>
        <ul class="list-unstyled mb-0">
            @foreach (var rv in Model.Reviews)
            {
                var decColor = rv.Decision switch { "Approved" => "success", "Rejected" => "danger", _ => "warning" };
                <pems-flex as="li" gap="2" css="pb-2 small">
                    <pems-badge class="pems-h-fit" tone="none" css="bg-@decColor">@rv.Decision</pems-badge>
                    <div>
                        <div>by <strong>@rv.ReviewerName</strong> &middot; @rv.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                        @if (!string.IsNullOrEmpty(rv.Comment)) { <div class="text-muted">@rv.Comment</div> }
                    </div>
                </pems-flex>
            }
        </ul>
    </pems-content-card>
}

@if (!string.IsNullOrEmpty(l.SignedByName))
{
    <pems-alert tone="success" css="py-2 small mb-3">
        <pems-icon name="bi-patch-check-fill" /> Electronically acknowledged by <strong>@l.SignedByName</strong> on @l.SignedDate?.ToString("yyyy-MM-dd HH:mm")
    </pems-alert>
}

@if ((l.RelatedDocumentId.HasValue || l.RelatedMRId.HasValue))
{
    <pems-content-card css="mb-3">
        <div class="section-title mb-2">Related Records</div>
        <pems-flex wrap="true" gap="3" css="small">
            @if (l.RelatedDocumentId.HasValue)
            {
                <a asp-controller="DocumentRegister" asp-action="Open" asp-route-id="@l.RelatedDocumentId"><pems-icon name="bi-file-earmark-text" /> @l.RelatedDocumentNo</a>
            }
            @if (l.RelatedMRId.HasValue)
            {
                <a asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@l.RelatedMRId"><pems-icon name="bi-cart" /> @l.RelatedMRNumber</a>
            }
        </pems-flex>
    </pems-content-card>
}

<pems-accordion id="letterAccordion" css="mb-3">
    <pems-accordion-item target="accRecipients" parent="letterAccordion">
<pems-accordion-header><pems-icon name="bi-people" css="me-2" /> Recipients (@Model.Recipients.Count)</pems-accordion-header>
                @if (Model.Recipients.Any())
                {
                    <pems-table scale="small" css="table-enterprise mb-2">
                        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["Read"]</pems-table-header></pems-table-row></pems-table-head>
                        <pems-table-body>
                            @foreach (var r in Model.Recipients)
                            {
                                <pems-table-row>
                                    <pems-table-cell><pems-badge tone="@(r.RecipientType == "To" ? "primary" : "neutral")">@(r.RecipientType == "To" ? "To" : "Cc")</pems-badge></pems-table-cell>
                                    <pems-table-cell>@r.DisplayName</pems-table-cell>
                                    <pems-table-cell>
                                        @if (r.IsRead)
                                        { <span class="text-success small"><pems-icon name="bi-check2-all" /> @r.ReadDate?.ToString("yyyy-MM-dd")</span> }
                                        else
                                        {
                                            <pems-form asp-action="MarkRecipientRead" method="post" class="d-inline">
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <input type="hidden" name="letterRecipientId" value="@r.LetterRecipientId" />
                                                <pems-button tone="neutral" size="small" outline="true">@Localizer["Mark Read"]</pems-button>
                                            </pems-form>
                                        }
                                    </pems-table-cell>
                                </pems-table-row>
                            }
                        </pems-table-body>
                    </pems-table>
                }
                else
                { <p class="text-muted small">No additional recipients yet.</p> }

                <pems-form class="add-recipient-form" asp-action="AddRecipient" method="post"><pems-row gap="2" css="mt-1">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-col md="3">
                        <pems-select scale="small" name="recipientType">
                            <option value="To">To</option>
                            <option value="Cc">Cc</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="4">
                        <pems-select scale="small" css="employee-picker" name="employeeId">
                            <option value="">@Localizer["-- Employee --"]</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-select scale="small" name="departmentId">
                            <option value="">@Localizer["-- or Department --"]</option>
                            @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="2"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
                </pems-row></pems-form>
            </pems-accordion-item>

    <pems-accordion-item target="accAttachments" parent="letterAccordion">
<pems-accordion-header><pems-icon name="bi-paperclip" css="me-2" /> Attachments (@Model.Attachments.Count)</pems-accordion-header>
                @if (Model.Attachments.Any())
                {
                    <ul class="list-unstyled mb-2">
                        @foreach (var a in Model.Attachments)
                        {
                            <li class="mb-1"><a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><pems-icon name="bi-file-earmark" /> @a.FileName</a></li>
                        }
                    </ul>
                }
                else
                { <p class="text-muted small">No attachments yet.</p> }

                <pems-form asp-action="UploadAttachment" method="post" enctype="multipart/form-data"><pems-flex gap="2">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-input scale="small" type="file" name="file" required />
                    <pems-button tone="primary" size="small" outline="true"><pems-icon name="bi-upload" /> @Localizer["Upload"]</pems-button>
                </pems-flex></pems-form>
            </pems-accordion-item>

    <pems-accordion-item target="accReferrals" parent="letterAccordion">
<pems-accordion-header><pems-icon name="bi-signpost-split" css="me-2" /> Referrals (@Model.Referrals.Count)</pems-accordion-header>
                @if (Model.Referrals.Any())
                {
                    <pems-table scale="small" css="table-enterprise mb-2">
                        <pems-table-head><pems-table-row><pems-table-header>Referred To</pems-table-header><pems-table-header>@Localizer["Instructions"]</pems-table-header><pems-table-header>@Localizer["Due"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Read"]</pems-table-header><pems-table-header>By / When</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                        <pems-table-body>
                            @foreach (var r in Model.Referrals)
                            {
                                <pems-table-row class="@(r.IsOverdue ? "table-danger" : "")">
                                    <pems-table-cell>@(r.ReferredToEmployeeName ?? r.ReferredToDepartmentName)</pems-table-cell>
                                    <pems-table-cell class="small">@r.Instructions</pems-table-cell>
                                    <pems-table-cell>@(r.DueDate?.ToString("yyyy-MM-dd"))</pems-table-cell>
                                    <pems-table-cell>
                                        @{
                                            var sb = r.Status switch { "Completed" => "success", "InProgress" => "info", _ => "warning" };
                                        }
                                        <pems-badge tone="@sb">@r.Status</pems-badge>
                                        @if (r.IsOverdue) { <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge> }
                                    </pems-table-cell>
                                    <pems-table-cell>
                                        @if (r.IsRead)
                                        { <span class="text-success"><pems-icon name="bi-check2-all" /> @Localizer["Read"]</span> }
                                        else
                                        {
                                            <pems-form asp-action="MarkReferralRead" method="post" class="d-inline">
                                                <input type="hidden" name="referralId" value="@r.LetterReferralId" />
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <pems-button tone="neutral" size="small" outline="true">@Localizer["Mark Read"]</pems-button>
                                            </pems-form>
                                        }
                                    </pems-table-cell>
                                    <pems-table-cell class="small text-muted">@r.ReferredByName<br />@r.ReferredDate.ToString("yyyy-MM-dd")</pems-table-cell>
                                    <pems-table-cell>
                                        @if (r.Status != "Completed")
                                        {
                                            <pems-form asp-action="CompleteReferral" method="post"><pems-flex gap="1">
                                                <input type="hidden" name="referralId" value="@r.LetterReferralId" />
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <pems-input scale="small" name="responseNote" placeholder="@Localizer["Response"]" />
                                                <pems-button tone="success" size="small">Done</pems-button>
                                            </pems-flex></pems-form>
                                        }
                                        else
                                        { @r.ResponseNote }
                                    </pems-table-cell>
                                </pems-table-row>
                            }
                        </pems-table-body>
                    </pems-table>
                }
                else
                { <p class="text-muted small">No referrals yet.</p> }

                <pems-flex align="center" gap="2" css="mb-3">
                    <pems-button tone="primary" size="small" as="a" asp-controller="LetterCompose" asp-action="Compose" asp-route-referTo="@l.LetterId"><pems-icon name="bi-signpost-split" aria-hidden="true" /> @Localizer["Ct_ReferToPerson"]</pems-button>
                    <span class="small text-muted">@Localizer["Ct_ReferToPersonHint"]</span>
                </pems-flex>
                <div class="small text-muted mb-1">@Localizer["Ct_ReferToDepartment"]</div>
                <pems-form asp-action="Refer" method="post"><pems-row gap="2">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <pems-col md="6">
                        <pems-select scale="small" name="referredToDepartmentId" required>
                            <option value="">@Localizer["Ct_ChooseDepartment"]</option>
                            @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="3"><pems-input scale="small" name="instructions" placeholder="@Localizer["Instructions"]" /></pems-col>
                    <pems-col md="2"><pems-date name="dueDate" scale="small" /></pems-col>
                    <pems-col md="1"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-send" /></pems-button></pems-col>
                </pems-row></pems-form>
            </pems-accordion-item>

    <pems-accordion-item target="accTimeline" parent="letterAccordion">
<pems-accordion-header><pems-icon name="bi-diagram-3" css="me-2" /> Activity Timeline</pems-accordion-header>
                @* workflow-history options: order and who acted (the manager / subordinates come from the organization chart) *@
                <pems-form class="mb-3 small" method="get" target="_self" action="@Url.Action("Details", new { id = l.LetterId })#accTimeline"><pems-flex wrap="true" align="center" gap="2">
                    @if (embed) { <input type="hidden" name="embed" value="true" /> }
                    <label for="historyOrder" class="text-muted">@Localizer["Ct_HistoryOrder"]</label>
                    <pems-select scale="small" css="w-auto" id="historyOrder" name="historyOrder" data-pems-change="submit-form">
                        <option value="asc" selected="@(historyOrder == "asc")">@Localizer["Ct_HistoryOldest"]</option>
                        <option value="desc" selected="@(historyOrder == "desc")">@Localizer["Ct_HistoryNewest"]</option>
                    </pems-select>
                    <label for="historyRole" class="text-muted ms-2">@Localizer["Ct_HistoryWho"]</label>
                    <pems-select scale="small" css="w-auto" id="historyRole" name="historyRole" data-pems-change="submit-form">
                        <option value="all" selected="@(historyRole == "all")">@Localizer["Ct_HistoryAll"]</option>
                        <option value="me" selected="@(historyRole == "me")">@Localizer["Ct_HistoryMe"]</option>
                        <option value="manager" selected="@(historyRole == "manager")">@Localizer["Ct_HistoryManager"]</option>
                        <option value="subordinates" selected="@(historyRole == "subordinates")">@Localizer["Ct_HistorySubordinates"]</option>
                    </pems-select>
                </pems-flex></pems-form>
                @if (timeline != null && timeline.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var ev in timeline)
                        {
                            <pems-flex as="li" gap="2" css="pb-2 small">
                                <pems-flex as="span" inline="true" align="center" justify="center" css="rounded-circle bg-@ev.Color text-white flex-shrink-0 pems-size-24">
                                    <pems-icon class="pems-fs-12" css="@ev.Icon" />
                                </pems-flex>
                                <div>
                                    <div>@ev.Description</div>
                                    <div class="text-muted">
                                        @ev.EventDate.ToString("yyyy-MM-dd HH:mm")
                                        @if (!string.IsNullOrEmpty(ev.ActorName)) { <span>&middot; by @ev.ActorName</span> }
                                    </div>
                                </div>
                            </pems-flex>
                        }
                    </ul>
                }
                else
                { <p class="text-muted text-center py-2 small">No activity yet.</p> }
            </pems-accordion-item>
</pems-accordion>

@* مودال‌های Return/Reject/Sign - این‌ها Bootstrap استاندارد هستند (همون کتابخانه‌ای که Dropdown
   بالا هم استفاده می‌کند)، نه یک کتابخانه‌ی جدید *@
<pems-modal id="returnModal" tabindex="-1"><pems-form asp-action="ReturnForRevision" method="post">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <pems-modal-header close="true">@Localizer["Return for Revision"]</pems-modal-header>
            <pems-modal-body>
                <pems-label css="small">@Localizer["Reason (required)"]</pems-label>
                <pems-textarea name="reason" rows="3" required></pems-textarea>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="warning" size="small" type="submit">@Localizer["Return for Revision"]</pems-button>
            </pems-modal-footer>
        </pems-form></pems-modal>

<pems-modal id="rejectModal" tabindex="-1"><pems-form asp-action="Reject" method="post">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <pems-modal-header close="true">@Localizer["Reject Letter"]</pems-modal-header>
            <pems-modal-body>
                <pems-label css="small">@Localizer["Reason (required)"]</pems-label>
                <pems-textarea name="reason" rows="3" required></pems-textarea>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="danger" size="small" type="submit">@Localizer["Reject"]</pems-button>
            </pems-modal-footer>
        </pems-form></pems-modal>

<pems-modal id="signModal" tabindex="-1"><pems-form asp-action="Sign" method="post">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <pems-modal-header close="true">@Localizer["Sign / Acknowledge"]</pems-modal-header>
            <pems-modal-body>
                <pems-label css="small">Type your full name to sign</pems-label>
                <pems-input name="signedByName" required />
                <pems-help-text css="small">Lightweight electronic acknowledgment (typed name + timestamp), not a PKI digital signature.</pems-help-text>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">Sign</pems-button>
            </pems-modal-footer>
        </pems-form></pems-modal>

@* طبق بند ۲۶: Employee فقط زمانی که کاربر واقعاً یکی از این دو Select را باز می‌کند، به‌صورت
   یک‌باره (نه برای هر Select جدا) از GetEmployeesForPicker بارگذاری می‌شود - نه هنگام بارگذاری صفحه *@
<script src="~/js/views/letter-details-2.js" asp-append-version="true"></script>

<script src="~/js/views/letter-details-3.js" asp-append-version="true"></script>

<script src="~/js/views/letter-details-4.js" asp-append-version="true"></script>

@section Styles { <link rel="stylesheet" href="~/css/pems-letter-details.css" asp-append-version="true" /> }
