@model PEMS.Application.DTOs.LetterWorkspaceDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    bool canReview = ViewBag.CanReview == true;
    int total = Math.Max(1, Model.TotalActive);

    // یک کاشی عددی: شمارنده + برچسب (+ پیوند به فهرست فیلترشده). وضعیت «هشدار» با آیکون و متن هم نمایش داده می‌شود، نه فقط رنگ.
    void Tile(string labelKey, int value, string icon, string? href = null, bool warn = false)
    {
        var inner = $"<i class=\"bi {icon}\" aria-hidden=\"true\"></i> <span class=\"vs-tile__label\">{System.Net.WebUtility.HtmlEncode(Localizer[labelKey].Value)}</span> <strong class=\"vs-tile__value\">{value}</strong>"
            + (warn && value > 0 ? $" <span class=\"badge bg-danger\"><i class=\"bi bi-exclamation-triangle\" aria-hidden=\"true\"></i> {System.Net.WebUtility.HtmlEncode(Localizer["Lt_Dash_NeedsAction"].Value)}</span>" : "");
        if (href != null)
        {
            <a class="vs-chip text-decoration-none" href="@href">@Html.Raw(inner)</a>
        }
        else
        {
            <span class="vs-chip">@Html.Raw(inner)</span>
        }
    }

    async Task BarRow(string label, int value, string? href = null)
    {
        var pct = (int)Math.Round(100.0 * value / total);
        <pems-table-row>
            <pems-table-header scope="row" class="fw-normal">@if (href != null) { <a href="@href">@label</a> } else { @label }</pems-table-header>
            <pems-table-cell class="pems-s-a9c5e7e4">
                <pems-progress value="@pct" label="@label: @value (@pct%)"></pems-progress>
            </pems-table-cell>
            <pems-table-cell class="text-end"><strong>@value</strong> <span class="text-muted small">(@pct%)</span></pems-table-cell>
        </pems-table-row>
    }
}

<pems-flex wrap="true" justify="between" align="center" gap="2" css="mb-3">
    <p class="text-muted small mb-0">@Localizer["Lt_Dash_Scope"]</p>
    <pems-flex wrap="true" gap="2">
        @if (ViewBag.CanRunReminders == true)
        {
            <form asp-action="SendReminders" method="post" data-pems-confirm="@Localizer["Lt_RemindersConfirm"]">
                <pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-bell" aria-hidden="true" /> @Localizer["Lt_RemindersRun"]</pems-button>
            </form>
        }
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-left-short" aria-hidden="true" /> @Localizer["Correspondence"]</pems-button>
    </pems-flex>
</pems-flex>

<section aria-label="@Localizer["Lt_Dash_Summary"]" class="vs-chips mb-3">
    @{
        Tile("Lt_Dash_TotalActive", Model.TotalActive, "bi-envelope", Url.Action("Index"));
        Tile("Lt_Dash_Open", Model.OpenLetters, "bi-envelope-open");
        if (canReview) { Tile("Lt_Dash_AwaitingApproval", Model.AwaitingApproval, "bi-patch-check", Url.Action("Index", new { status = "PendingApproval" }), warn: false); }
        Tile("Lt_Dash_MyDrafts", Model.MyDrafts, "bi-pencil-square", Url.Action("Index", new { status = "Draft" }));
        Tile("Lt_Dash_MyReturned", Model.MyReturnedForRevision, "bi-arrow-counterclockwise", Url.Action("Index", new { status = "ReturnedForRevision" }), warn: true);
        Tile("Lt_Dash_MyReferrals", Model.MyOpenReferrals, "bi-person-check", Url.Action("MyReferrals"));
        Tile("Lt_Dash_OpenReferrals", Model.OpenReferrals, "bi-signpost-split", Url.Action("Index", new { hasReferrals = true }));
        Tile("Lt_Dash_OverdueReferrals", Model.OverdueReferrals, "bi-clock-history", Url.Action("Index", new { overdueReferral = true }), warn: true);
        Tile("Lt_Dash_OverdueResponses", Model.OverdueResponses, "bi-reply", Url.Action("Index", new { overdueResponse = true }), warn: true);
        Tile("Lt_Dash_Received30", Model.ReceivedLast30Days, "bi-inbox-fill");
        Tile("Lt_Dash_Issued30", Model.IssuedLast30Days, "bi-send-fill");
    }
</section>

<pems-row gap="3">
    <pems-col lg="6">
        <pems-content-card css="h-100">
            <h2 class="vs-section__title">@Localizer["Lt_Dash_NeedsAttention"]</h2>
            @if (!Model.NeedsAttention.Any())
            {
                <p class="text-muted mb-0"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Lt_Dash_NothingOverdue"]</p>
            }
            else
            {
                <pems-table-scroll>
                    <pems-table kind="enterprise" css="mb-0">
                        <pems-table-head>
                            <pems-table-row>
                                <pems-table-header scope="col">@Localizer["Letter No"]</pems-table-header>
                                <pems-table-header scope="col">@Localizer["Subject"]</pems-table-header>
                                <pems-table-header scope="col">@Localizer["Lt_Dash_Reason"]</pems-table-header>
                                <pems-table-header scope="col">@Localizer["Lt_Dash_DaysOverdue"]</pems-table-header>
                            </pems-table-row>
                        </pems-table-head>
                        <pems-table-body>
                            @foreach (var item in Model.NeedsAttention)
                            {
                                <pems-table-row>
                                    <pems-table-cell class="small">@item.LetterNumber</pems-table-cell>
                                    <pems-table-cell><a asp-action="Details" asp-route-id="@item.LetterId">@item.Subject</a></pems-table-cell>
                                    <pems-table-cell class="small">
                                        <pems-icon css="@(item.Reason == "OverdueReferral" ? "bi-signpost-split" : "bi-reply")" aria-hidden="true" />
                                        @Localizer[item.Reason == "OverdueReferral" ? "Lt_Dash_ReasonReferral" : "Lt_Dash_ReasonResponse"]
                                    </pems-table-cell>
                                    <pems-table-cell class="small pems-due-overdue"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @item.DaysOverdue <span class="text-muted fw-normal">(@item.DueDate.ToString("yyyy-MM-dd"))</span></pems-table-cell>
                                </pems-table-row>
                            }
                        </pems-table-body>
                    </pems-table>
                </pems-table-scroll>
            }
        </pems-content-card>
    </pems-col>

    <pems-col lg="6">
        <pems-content-card css="h-100">
            <h2 class="vs-section__title">@Localizer["Lt_Dash_Aging"]</h2>
            <p class="text-muted small">@Localizer["Lt_Dash_AgingNote"]</p>
            <pems-table scale="small" css="mb-0">
                <pems-table-body>
                    @foreach (var b in Model.Aging) { await BarRow(Localizer["Lt_Dash_Age_" + b.Key].Value, b.Count); }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-col>

    <pems-col lg="4">
        <pems-content-card css="h-100">
            <h2 class="vs-section__title">@Localizer["Lt_Dash_ByStatus"]</h2>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByStatus.OrderByDescending(x => x.Value)) { await BarRow(kv.Key, kv.Value, Url.Action("Index", new { status = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="h-100">
            <h2 class="vs-section__title">@Localizer["Lt_Dash_ByType"]</h2>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByType.OrderByDescending(x => x.Value)) { await BarRow(kv.Key, kv.Value, Url.Action("Index", new { letterType = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="h-100">
            <h2 class="vs-section__title">@Localizer["Lt_Dash_ByPriority"]</h2>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByPriority.OrderByDescending(x => x.Value)) { await BarRow(Localizer["Lt_P_" + kv.Key].Value, kv.Value, Url.Action("Index", new { priority = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
</pems-row>

@section Styles {
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}
