@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var thread = (List<PEMS.Application.DTOs.ThreadMessageDto>)ViewBag.Thread;
    var parentLetterId = (int)ViewBag.ParentLetterId;
}

@* طراحی الهام‌گرفته از نمونه‌ی کارتابل مرجع: پیام‌های قبلی به‌صورت زنجیره‌ای/Thread بالای
   فرم پاسخ نمایش داده می‌شوند - دقیقاً همان "مشاهده پیام‌های قبلی". *@

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2" style="cursor:pointer;" onclick="document.getElementById('threadBody').classList.toggle('d-none')">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> مشاهده پیام‌های قبلی (@thread.Count)</h6>
        <i class="bi bi-chevron-down"></i>
    </div>
    <div id="threadBody">
        @foreach (var msg in thread)
        {
            <div class="d-flex gap-3 border-bottom py-3">
                <div class="flex-shrink-0">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary text-white" style="width:40px;height:40px;">
                        <i class="bi bi-person-fill"></i>
                    </span>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@msg.Subject</div>
                    <div class="small text-muted">
                        @msg.SenderOrRegisteredByName &middot; @msg.LetterDate.ToString("yyyy-MM-dd HH:mm") &middot; @msg.LetterNumber
                    </div>
                    @if (!string.IsNullOrEmpty(msg.RecipientsSummary))
                    {
                        <div class="small text-muted">Recipients: @msg.RecipientsSummary</div>
                    }
                    <div class="mt-2">@Html.Raw(msg.Body)</div>
                </div>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <form asp-action="Reply" method="post">
        <input type="hidden" name="parentLetterId" value="@parentLetterId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">To</label>
                <input name="receiver" class="form-control" value="@ViewBag.DefaultReceiver" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Subject"]</label>
                <input name="subject" class="form-control" value="@ViewBag.DefaultSubject" required />
            </div>
            <div class="col-12">
                <label class="form-label">Body</label>
                <textarea name="body" id="replyBodyEditor" class="form-control" rows="6"></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid"><i class="bi bi-reply-fill"></i> Send Reply</button>
            <a asp-action="Details" asp-route-id="@parentLetterId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@await Html.PartialAsync("_RichTextEditorScripts", "replyBodyEditor")
