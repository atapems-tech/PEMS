@model List<PEMS.Application.DTOs.LetterDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <h6 class="mb-3">Letters Referred to Me</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Type"]</th><th>@Localizer["Letter No"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Date"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td><pems-badge tone="neutral">@l.LetterType</pems-badge></td>
                    <td>@l.LetterNumber</td>
                    <td>@l.Subject</td>
                    <td>@l.LetterDate.ToString("yyyy-MM-dd")</td>
                    <td><pems-badge tone="none" css="@PEMS.Web.Helpers.LetterStatusBadge.CssClass(l.Status)">@l.Status</pems-badge></td>
                    <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@l.LetterId"><i class="bi bi-eye"></i></pems-button></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No letters referred to you.</p> }
</div>
