@model List<PEMS.Application.DTOs.LetterDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the status keeps the letter palette (LetterStatusBadge). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="Letters Referred to Me" total="@Model.Count" />
        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="No letters referred to you.">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Letter No"]</pems-table-header><pems-table-header>@Localizer["Subject"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var l in Model)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell><pems-badge tone="neutral">@l.LetterType</pems-badge></pems-table-cell>
                            <pems-table-cell class="lp-no">@l.LetterNumber</pems-table-cell>
                            <pems-table-cell>@l.Subject</pems-table-cell>
                            <pems-table-cell>@l.LetterDate.ToString("yyyy-MM-dd")</pems-table-cell>
                            <pems-table-cell><pems-badge tone="none" css="@LetterStatusBadge.CssClass(l.Status)">@l.Status</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@l.LetterId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
