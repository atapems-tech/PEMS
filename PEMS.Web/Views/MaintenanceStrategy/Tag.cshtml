@model PEMS.Application.DTOs.TagMaintenanceViewDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0"><pems-icon name="bi-tag" /> @Localizer["Rcm_TagMaintenance"] — @Model.Equipment.Tag</h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index" asp-route-equipmentId="@Model.Equipment.EquipmentId">@Localizer["Rcm_Back"]</pems-button>
</pems-flex>

@await Html.PartialAsync("_EquipmentIdentity", Model.Equipment)

<pems-content-card css="mb-3">
    <h6 class="small fw-bold">@Localizer["Rcm_AssignedStrategies"]</h6>
    <pems-table scale="small" css="table-enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Rcm_Strategy"]</pems-table-header><pems-table-header>@Localizer["Rcm_Version"]</pems-table-header><pems-table-header>@Localizer["Rcm_Override"]</pems-table-header><pems-table-header>@Localizer["Rcm_Plans"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
        @foreach (var a in Model.Assignments)
        {
            <pems-table-row>
                <pems-table-cell><a asp-action="Details" asp-route-id="@a.MaintenanceStrategyId">#@a.MaintenanceStrategyId</a></pems-table-cell>
                <pems-table-cell>v@(a.StrategyVersion)</pems-table-cell>
                <pems-table-cell class="small">@Localizer.Label("OverrideStatus", a.OverrideStatus)</pems-table-cell>
                <pems-table-cell>@a.PlanCount</pems-table-cell>
                <pems-table-cell class="text-end"><pems-button tone="primary" size="small" outline="true" css="py-0" as="a" asp-controller="MaintenancePlan" asp-action="Create" asp-route-assignmentId="@a.AssignmentId"><pems-icon name="bi-calendar-plus" /></pems-button></pems-table-cell>
            </pems-table-row>
        }
        </pems-table-body>
    </pems-table>
    @if (!Model.Assignments.Any()) { <p class="text-muted small text-center py-2">@Localizer["Rcm_NoAssignments"]</p> }
</pems-content-card>

<pems-row>
    <pems-col md="6">
        <pems-content-card css="mb-3">
            <h6 class="small fw-bold">@Localizer["Rcm_Plans"]</h6>
            <pems-table scale="small" css="table-enterprise">
                <pems-table-body>
                @foreach (var p in Model.Plans)
                {
                    <pems-table-row><pems-table-cell>@p.PlanNumber</pems-table-cell><pems-table-cell class="small">@p.Title</pems-table-cell><pems-table-cell class="small">v@(p.StrategyVersion)</pems-table-cell><pems-table-cell class="small">@(p.NextDueDate?.ToString("yyyy-MM-dd"))</pems-table-cell></pems-table-row>
                }
                </pems-table-body>
            </pems-table>
            @if (!Model.Plans.Any()) { <p class="text-muted small text-center">@Localizer["Rcm_NoPlans"]</p> }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="mb-3">
            <h6 class="small fw-bold">@Localizer["Rcm_OpenWorkOrders"]</h6>
            <pems-table scale="small" css="table-enterprise">
                <pems-table-body>
                @foreach (var w in Model.OpenWorkOrders)
                {
                    <pems-table-row><pems-table-cell><a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNumber</a></pems-table-cell><pems-table-cell class="small">@w.Status</pems-table-cell><pems-table-cell class="small">@w.Priority</pems-table-cell></pems-table-row>
                }
                </pems-table-body>
            </pems-table>
            @if (!Model.OpenWorkOrders.Any()) { <p class="text-muted small text-center">@Localizer["Rcm_NoOpenWorkOrders"]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>
