@model PEMS.Web.ViewModels.StrategyIndexViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Domain.Common
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var filter = Model.Filter;
    var q = filter.Search;
    int? equipmentId = filter.EquipmentId, classId = filter.EquipmentClassId;
    string? status = filter.Status, type = filter.StrategyType;
    var className = Model.Classes.FirstOrDefault(c => c.Id == classId)?.Text;
    var filterCount = (equipmentId.HasValue ? 1 : 0) + (classId.HasValue ? 1 : 0) + (string.IsNullOrEmpty(status) ? 0 : 1) + (string.IsNullOrEmpty(type) ? 0 : 1);

    var qs = new List<string>();
    if (equipmentId.HasValue) qs.Add($"equipmentId={equipmentId}");
    if (classId.HasValue) qs.Add($"classId={classId}");
    if (!string.IsNullOrEmpty(status)) qs.Add($"status={status}");
    if (!string.IsNullOrEmpty(type)) qs.Add($"type={type}");
    if (!string.IsNullOrEmpty(q)) qs.Add($"q={Uri.EscapeDataString(q)}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The filter card became the search plus the filters dropdown;
   coverage, the failure-mode catalogue and bulk assignment moved into the "more" menu; the page note became the tool tip
   of the title. Permissions (CanApprove / CanCreate / CanEdit) are unchanged. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Ms_Title"]" heading-title="@Localizer["Rcm_IndexHint"]" total="@Model.Page.TotalCount">
            <pems-list-search id="msSearchForm" action="@Url.Action("Index")" input-id="msQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Rcm_Search"]">
                @if (equipmentId.HasValue) { <input type="hidden" name="equipmentId" value="@equipmentId" /> }
                @if (classId.HasValue) { <input type="hidden" name="classId" value="@classId" /> }
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
                @if (!string.IsNullOrEmpty(type)) { <input type="hidden" name="type" value="@type" /> }
            </pems-list-search>

            <pems-list-tools search-for="msSearchForm">
                <pems-list-filters form-id="msFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="strategyFilterSearch">@Localizer["Rcm_FilterByEquipment"]</label>
                        <input type="text" class="form-control form-control-sm" id="strategyFilterSearch"
                               placeholder="@Localizer["Rcm_SearchEquipmentPlaceholder"]" value="@Model.SelectedEquipmentLabel"
                               data-pems-search data-search-type="Equipment" autocomplete="off" />
                        <input type="hidden" name="equipmentId" id="strategyFilterEquipmentId" value="@equipmentId" />
                    </div>
                    <div>
                        <label class="lp-lbl" for="msFilterClass">@Localizer["Rcm_EquipmentClass"]</label>
                        <select id="msFilterClass" name="classId" class="form-select form-select-sm">
                            <option value="">@Localizer["Rcm_All"]</option>
                            @foreach (var c in Model.Classes) { <option value="@c.Id" selected="@(classId == c.Id)">@c.Text</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="msFilterStatus">@Localizer["Rcm_Status"]</label>
                        <select id="msFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Rcm_AllLive"]</option>
                            @foreach (var s in RcmCodes.Status.All) { <option value="@s" selected="@(status == s)">@Localizer.Label("Status", s)</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="msFilterType">@Localizer["Rcm_StrategyType"]</label>
                        <select id="msFilterType" name="type" class="form-select form-select-sm">
                            <option value="">@Localizer["Rcm_All"]</option>
                            @foreach (var t in RcmCodes.StrategyType.All) { <option value="@t" selected="@(type == t)">@Localizer.Label("StrategyType", t)</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-menu id="msMoreBtn" icon="bi-three-dots" label="@Localizer["Lp_More"]">
                    <li><a class="dropdown-item" asp-action="Coverage"><i class="bi bi-pie-chart" aria-hidden="true"></i> @Localizer["Rcm_Coverage"]</a></li>
                    <li><a class="dropdown-item" asp-controller="FailureModeCatalog" asp-action="Index"><i class="bi bi-journal-text" aria-hidden="true"></i> @Localizer["Rcm_FailureModeCatalog"]</a></li>
                    @if (Model.CanApprove)
                    {
                        <li><a class="dropdown-item" asp-action="BulkCreate"><i class="bi bi-collection" aria-hidden="true"></i> @Localizer["Rcm_BulkAssign"]</a></li>
                    }
                </pems-list-menu>
                <pems-list-reset-columns grid-key="MaintenanceStrategy" />
                @if (Model.CanCreate)
                {
                    <pems-list-new href="@Url.Action("Create")" text="@Localizer["Rcm_NewStrategy"]" />
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index", new { q })">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { equipmentId, classId, status, type })" /> }
            @if (equipmentId.HasValue)
            { <pems-list-chip label="@Localizer["Equipment"]" value="@Model.SelectedEquipmentLabel" remove-href="@Url.Action("Index", new { q, classId, status, type })" /> }
            @if (classId.HasValue)
            { <pems-list-chip label="@Localizer["Rcm_EquipmentClass"]" value="@className" remove-href="@Url.Action("Index", new { q, equipmentId, status, type })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Rcm_Status"]" value="@Localizer.Label("Status", status)" remove-href="@Url.Action("Index", new { q, equipmentId, classId, type })" /> }
            @if (!string.IsNullOrEmpty(type))
            { <pems-list-chip label="@Localizer["Rcm_StrategyType"]" value="@Localizer.Label("StrategyType", type)" remove-href="@Url.Action("Index", new { q, equipmentId, classId, status })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="MaintenanceStrategy" empty="@(!Model.Page.Items.Any())" empty-text="@Localizer["Rcm_NoStrategies"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="class" data-resizable="true" data-min-width="110" data-max-width="240" style="width:170px">@Localizer["Rcm_EquipmentClass"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Rcm_StrategyType"]</th>
                        <th data-col-key="failureMode" data-resizable="true" data-min-width="120" data-max-width="260" style="width:180px">@Localizer["Rcm_FailureMode"]</th>
                        <th data-col-key="consequence" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Rcm_Consequence"]</th>
                        <th data-col-key="frequency" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["Rcm_Frequency"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px">@Localizer["Rcm_Status"]</th>
                        <th data-col-key="tags" data-resizable="true" data-min-width="70" data-max-width="120" style="width:80px">@Localizer["Rcm_Tags"]</th>
                        <th data-col-key="justification" data-resizable="true" data-min-width="160" data-max-width="400" style="width:260px" class="vs-hide-md">@Localizer["Rcm_Justification"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:90px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Page.Items)
                    {
                        <tr class="lp-row">
                            <td class="small">
                                @if (!string.IsNullOrEmpty(s.EquipmentClassName))
                                {
                                    <div>@s.EquipmentClassName</div>
                                }
                                @if (!string.IsNullOrEmpty(s.EquipmentTagNumber))
                                {
                                    <div class="text-muted"><a asp-controller="MaintenanceStrategy" asp-action="Tag" asp-route-equipmentId="@s.EquipmentId">@s.EquipmentTagNumber</a></div>
                                }
                                @if (string.IsNullOrEmpty(s.EquipmentClassName) && string.IsNullOrEmpty(s.EquipmentTagNumber)) { <span class="text-muted">-</span> }
                            </td>
                            <td><span class="vs-pill vs-pill--neutral">@Localizer.Label("StrategyType", s.StrategyType)</span></td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(s.FailureModeName)) { @RcmDisplay.Name(s.FailureModeName, s.FailureModeNameFa) }
                                else if (!string.IsNullOrEmpty(s.FailureModeCode)) { <span class="text-warning" title="@Localizer["Rcm_NotInCatalog"]">@s.FailureModeCode <i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span> }
                                else { <span class="text-danger">@Localizer["Rcm_MissingFailureMode"]</span> }
                            </td>
                            <td>
                                <span class="badge @RcmDisplay.ConsequenceBadge(s.ConsequenceCategory)">@Localizer.Label("Consequence", s.ConsequenceCategory)</span>
                                @if (s.IsHiddenFailure && s.ConsequenceCategory != "Hidden") { <span class="badge bg-dark" title="@Localizer["Rcm_HiddenFailure"]">H</span> }
                            </td>
                            <td class="small">@Localizer.Label("Frequency", s.Frequency)</td>
                            <td>
                                <span class="badge @RcmDisplay.StatusBadge(s.Status)">@Localizer.Label("Status", s.Status)</span>
                                <div class="small text-muted">v@(s.VersionNumber)</div>
                                @if (s.ReviewOverdue) { <div class="small text-danger"><i class="bi bi-clock-history" aria-hidden="true"></i> @Localizer["Rcm_ReviewOverdue"]</div> }
                            </td>
                            <td><span class="vs-num">@s.AssignedTagCount</span></td>
                            <td class="small text-muted vs-hide-md">@(string.IsNullOrWhiteSpace(s.Justification) ? "-" : (s.Justification!.Length > 140 ? s.Justification[..140] + "…" : s.Justification))</td>
                            <td class="lp-actions">
                                <a asp-action="Details" asp-route-id="@s.MaintenanceStrategyId" class="lp-act lp-act--always" title="@Localizer["Lp_Details"]" aria-label="@Localizer["Lp_Details"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                @if (Model.CanEdit && s.Status != "Retired" && s.Status != "Superseded")
                                {
                                    <a asp-action="Edit" asp-route-id="@s.MaintenanceStrategyId" class="lp-act lp-act--always" title="@Localizer["Rcm_Edit"]" aria-label="@Localizer["Rcm_Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page.Page,
                    TotalPages = Model.Page.TotalPages,
                    TotalCount = Model.Page.TotalCount,
                    PageSize = Model.Page.PageSize,
                    GridKey = "MaintenanceStrategy",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qs)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
    <script>
        // picking an equipment from the suggestions fills the hidden filter field and applies the filters
        (function () {
            var input = document.getElementById('strategyFilterSearch');
            input.addEventListener('pems:search-select', function (e) {
                if (e.detail) { document.getElementById('strategyFilterEquipmentId').value = e.detail.id; input.form.submit(); }
            });
        })();
    </script>
}
