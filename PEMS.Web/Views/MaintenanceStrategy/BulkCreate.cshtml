@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Application.DTOs
@using PEMS.Web.Helpers
@using PEMS.Web.ViewModels
@{
    var bulk = (BulkAssignViewModel)ViewBag.BulkAssign;
    var classes = (List<LookupItem>)ViewBag.Classes;
    var selectedClassId = (int?)ViewBag.SelectedClassId;
    var equipments = (List<PEMS.Domain.Entities.Equipment>)ViewBag.Equipments;
    var criticalityByEquipment = (Dictionary<int, string>)ViewBag.CriticalityByEquipment;
    var noFilterApplied = (bool)ViewBag.NoFilterApplied;
    var matchingCount = (int?)ViewBag.MatchingCount;
    var maxResults = (int)ViewBag.MaxResults;
    var functionalLocations = (List<FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations;
    var equipmentWithFlCount = (int)ViewBag.EquipmentWithFunctionalLocationCount;
    var selectedDisciplineIds = (List<int>)ViewBag.SelectedDisciplineIds;
    var selectedEquipmentTypes = (List<string>)ViewBag.SelectedEquipmentTypes;
    var selectedFunctionalLocationIds = (List<int>)ViewBag.SelectedFunctionalLocationIds;
    var selectedTagSearch = (string?)ViewBag.SelectedTagSearch;

    var plants = (List<string>)ViewBag.Plants;
    var flAreas = (List<string>)ViewBag.Areas;
    var units = (List<string>)ViewBag.Units;
    var selectedPlants = (List<string>)ViewBag.SelectedPlants;
    var selectedAreas = (List<string>)ViewBag.SelectedAreas;
    var selectedUnits = (List<string>)ViewBag.SelectedUnits;
    var selectedFlMode = (string)ViewBag.SelectedFunctionalLocationMode;
    var selectedTagList = (string?)ViewBag.SelectedTagList;
    var requestedTagCount = (int)ViewBag.RequestedTagCount;
    var matchedTagCount = (int)ViewBag.MatchedTagCount;

    // طبق درخواست: دسته‌بندی دوسطحی - اول بر اساس واحد (Area/Unit)، بعد داخل هر واحد بر
    // اساس نوع تجهیز - چون در عمل RCM دقیقاً همین‌طور فکر می‌کنه («همه‌ی پمپ‌های واحد ۱۰۰»)
    var byArea = equipments
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Area) ? "نامشخص" : x.Area)
        .OrderBy(g => g.Key)
        .ToList();
}

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0"><pems-icon name="bi-collection" /> @Localizer["Rcm_BulkAssign"]</h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["بازگشت"]</pems-button>
</pems-flex>
<p class="text-muted small">@Localizer["Rcm_BulkHint"]</p>

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2">
        <pems-col md="4">
            <pems-label css="small mb-0">@Localizer["Rcm_Strategy"] (@Localizer["Rcm_ApprovedOrActive"])</pems-label>
            <pems-select scale="small" name="strategyId">
                <option value="">@Localizer["Rcm_SelectPlaceholder"]</option>
                @foreach (var s in bulk.UsableStrategies) { <option value="@s.Id" selected="@(bulk.StrategyId == s.Id)">@s.Text</option> }
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label css="small mb-0">@Localizer["Rcm_EquipmentClass"] (@Localizer["Rcm_IncludesSubclasses"])</pems-label>
            <pems-select scale="small" name="classId">
                <option value="">@Localizer["Rcm_All"]</option>
                @foreach (var c in classes) { <option value="@c.Id" selected="@(selectedClassId == c.Id)">@c.Text</option> }
            </pems-select>
        </pems-col>
        <pems-col md="4"></pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">@Localizer["Discipline (چندانتخابی)"]</pems-label>
            <pems-select scale="small" name="disciplineIds" multiple size="4">
                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@selectedDisciplineIds.Contains((int)d.DisciplineId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">@Localizer["Equipment Type (چندانتخابی)"]</pems-label>
            <pems-select scale="small" name="equipmentTypes" multiple size="4">
                @foreach (var t in (IEnumerable<string>)ViewBag.EquipmentTypes) { <option value="@t" selected="@selectedEquipmentTypes.Contains(t)">@t</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">
                Functional Location (چندانتخابی)
                @if (equipmentWithFlCount < 50)
                {
                    <pems-icon name="bi-info-circle" css="text-muted" title="فقط تعداد کمی تجهیز هنوز به Functional Location متصل شده - این فیلتر فعلاً نتیجه‌ی محدودی برمی‌گرداند." />
                }
            </pems-label>
            <pems-select scale="small" name="functionalLocationIds" multiple size="4">
                @foreach (var fl in functionalLocations) { <option value="@fl.FunctionalLocationId" selected="@selectedFunctionalLocationIds.Contains(fl.FunctionalLocationId)">@fl.PathBreadcrumb</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">@Localizer["Tag Number (جستجوی متنی)"]</pems-label>
            <pems-input scale="small" type="text" name="tagSearch" value="@selectedTagSearch" placeholder="مثلاً P-101" />
        </pems-col>

        @* طبق «PEMS CMMS — Bulk Define Maintenance Strategy Scope & Location/Equipment
           Resolution»: زنجیره‌ی Plant/Area/Unit/Functional Location/Equipment/Tag - بدون
           تغییر در ساختار فرم موجود، فقط سه بُعد جدید + حالت Exact/Descendants برای FL. *@
        <pems-col md="3">
            <pems-label css="small mb-0">
                Plant (چندانتخابی)
                @if (!plants.Any()) { <pems-icon name="bi-info-circle" css="text-muted" title="در حال حاضر هیچ Functional Location ای مقدار Plant ندارد." /> }
            </pems-label>
            <pems-select scale="small" name="plants" multiple size="3">
                @foreach (var p in plants) { <option value="@p" selected="@selectedPlants.Contains(p)">@p</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">Area (Functional Location، چندانتخابی)</pems-label>
            <pems-select scale="small" name="areas" multiple size="3">
                @foreach (var a in flAreas) { <option value="@a" selected="@selectedAreas.Contains(a)">@a</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">
                Unit (چندانتخابی)
                @if (!units.Any()) { <pems-icon name="bi-info-circle" css="text-muted" title="در حال حاضر هیچ Functional Location ای مقدار Unit ندارد." /> }
            </pems-label>
            <pems-select scale="small" name="units" multiple size="3">
                @foreach (var u in units) { <option value="@u" selected="@selectedUnits.Contains(u)">@u</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small mb-0">Functional Location Mode</pems-label>
            <pems-flex gap="3" css="mt-1">
                <pems-check-row>
                    <pems-input type="radio" name="functionalLocationMode" value="Exact" id="flModeExact" checked="@(selectedFlMode == "Exact")" kind="check" />
                    <label class="form-check-label small" for="flModeExact" title="فقط خودِ Functional Location(های) انتخاب‌شده">@Localizer["Exact"]</label>
                </pems-check-row>
                <pems-check-row>
                    <pems-input type="radio" name="functionalLocationMode" value="Descendants" id="flModeDescendants" checked="@(selectedFlMode == "Descendants")" kind="check" />
                    <label class="form-check-label small" for="flModeDescendants" title="Functional Location(های) انتخاب‌شده + همه‌ی زیرشاخه‌های واقعی آن‌ها">Descendants</label>
                </pems-check-row>
            </pems-flex>
        </pems-col>
        <pems-col md="6">
            <pems-label css="small mb-0">
                Tag List (چند Tag دقیق - با کاما یا خط جدید جدا کنید)
                <pems-icon name="bi-info-circle" css="text-muted" title="این‌ها همیشه به نتیجه اضافه می‌شوند، صرف‌نظر از فیلترهای بالا - برای وقتی که تگ‌های مشخصی را از قبل می‌دانید." />
            </pems-label>
            <pems-textarea scale="small" name="tagList" rows="2" placeholder="P-1001, P-1002, P-1003">@selectedTagList</pems-textarea>
            @if (requestedTagCount > 0)
            {
                <pems-help-text>@matchedTagCount از @requestedTagCount Tag درخواست‌شده پیدا شد.</pems-help-text>
            }
        </pems-col>
        <pems-col md="6" css="d-flex align-items-end">
            <pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-funnel" /> @Localizer["فیلتر تجهیزات"]</pems-button>
        </pems-col>

        @if (equipmentWithFlCount < 50)
        {
            <pems-col span="12">
                <p class="text-muted small mb-0">
                    <pems-icon name="bi-info-circle" /> در حال حاضر فقط @equipmentWithFlCount تجهیز به Functional Location متصل شده -
                    فیلترهای Functional Location/Plant/Area/Unit آماده‌اند اما تا زمانی که تخصیص بیشتری از طریق
                    «Equipment ↔ FL Assignment» انجام نشود، نتیجه‌ی محدودی برمی‌گردانند. این یک محدودیت داده است، نه نقص این فرم.
                </p>
            </pems-col>
        }
    </pems-row></pems-form>
</pems-content-card>

@if (noFilterApplied)
{
    <pems-alert tone="warning" css="small">
        طبق «PEMS Phase 7.6»: این فرم برای فعال‌سازی کنترل‌شده است، نه مرور کل ناوگان تجهیزات
        - ابتدا حداقل یک فیلتر (Discipline، نوع تجهیز، Functional Location/Plant/Area/Unit، یا Tag) را انتخاب کنید تا کاندیدها نمایش داده شوند.
    </pems-alert>
}
else if (matchingCount.HasValue && matchingCount.Value > maxResults)
{
    <pems-alert tone="warning" css="small">
        @matchingCount.Value.ToString("N0") تجهیز با این فیلتر مطابقت دارد - فقط @maxResults مورد
        اول نمایش داده می‌شود. برای محدودتر کردن نتیجه، فیلتر دقیق‌تری انتخاب کنید.
    </pems-alert>
}

<pems-form asp-action="BulkCreate" method="post">
    <pems-row>
        <pems-col md="5">
            <pems-content-card>
                <pems-flex justify="between" align="center" css="mb-2">
                    <h6 class="mb-0 small fw-bold">انتخاب تجهیزات (@equipments.Count)</h6>
                    <div>
                        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="document.querySelectorAll('.eq-check').forEach(c => c.checked = true)">همه</pems-button>
                        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="document.querySelectorAll('.eq-check').forEach(c => c.checked = false)">هیچ‌کدام</pems-button>
                    </div>
                </pems-flex>

                <div class="pems-s-31c8162e"><pems-accordion id="areaAccordion">
                    @foreach (var areaGroup in byArea)
                    {
                        var areaSafeId = "area_" + Math.Abs(areaGroup.Key.GetHashCode());
                        var byType = areaGroup.GroupBy(x => string.IsNullOrWhiteSpace(x.EquipmentType) ? "نامشخص" : x.EquipmentType).OrderBy(g => g.Key).ToList();

                        <pems-accordion-item target="@areaSafeId" parent="areaAccordion" button-css="small" body-css="p-2">
<pems-accordion-header><pems-icon name="bi-geo-alt" css="me-2" /> @areaGroup.Key
                                    <pems-badge tone="neutral" css="ms-2">@areaGroup.Count()</pems-badge></pems-accordion-header>
                                    <pems-button tone="primary" size="small" outline="true" css="mb-2" type="button"
                                            onclick="document.querySelectorAll('.area-@areaSafeId').forEach(c => c.checked = true)">
                                        <pems-icon name="bi-check2-square" /> انتخاب کل این واحد
                                    </pems-button>

                                    @foreach (var typeGroup in byType)
                                    {
                                        var typeSafeId = areaSafeId + "_" + Math.Abs(typeGroup.Key.GetHashCode());

                                        <div class="border rounded p-2 mb-2">
                                            <pems-flex justify="between" align="center" css="mb-1">
                                                <span class="small fw-bold"><pems-icon name="bi-gear" /> @typeGroup.Key <pems-badge tone="none" css="bg-light text-dark">@typeGroup.Count()</pems-badge></span>
                                                <pems-button tone="neutral" size="small" outline="true" css="py-0" type="button"
                                                        onclick="document.querySelectorAll('.type-@typeSafeId').forEach(c => c.checked = true)">
                                                    انتخاب این نوع
                                                </pems-button>
                                            </pems-flex>
                                            <pems-table scale="small" css="mb-0">
                                                <pems-table-body>
                                                    @foreach (var eq in typeGroup)
                                                    {
                                                        var cls = criticalityByEquipment.GetValueOrDefault(eq.EquipmentId);
                                                        <pems-table-row>
                                                            <pems-table-cell class="pems-s-322e3f5e">
                                                                <pems-input plain="true" type="checkbox" class="eq-check area-@areaSafeId type-@typeSafeId" name="equipmentIds" value="@eq.EquipmentId" disabled="@(bulk.Candidates.TryGetValue(eq.EquipmentId, out var cand0) && !cand0.WillReceive)" />
                                                            </pems-table-cell>
                                                            <pems-table-cell class="small">@eq.TagNumber — @eq.Name</pems-table-cell>
                                                            <pems-table-cell>
                                                                <pems-badge tone="@RcmDisplay.CriticalityBadge(string.IsNullOrEmpty(cls) ? "Unrated" : cls)">@Localizer.Label("Criticality", string.IsNullOrEmpty(cls) ? "Unrated" : cls)</pems-badge>
                                                                @if (bulk.Candidates.TryGetValue(eq.EquipmentId, out var cand) && !cand.WillReceive)
                                                                {
                                                                    <pems-badge tone="warning" title="@Localizer["Rcm_Bulk_" + cand.Conflict]">@Localizer["Rcm_Bulk_" + cand.Conflict]</pems-badge>
                                                                }
                                                            </pems-table-cell>
                                                        </pems-table-row>
                                                    }
                                                </pems-table-body>
                                            </pems-table>
                                        </div>
                                    }
                                </pems-accordion-item>
                    }
                    @if (!equipments.Any() && !noFilterApplied) { <p class="text-muted small text-center py-3">@Localizer["تجهیزی با این فیلتر پیدا نشد."]</p> }
                </pems-accordion></div>
            </pems-content-card>
        </pems-col>

        <pems-col md="7">
            <pems-content-card>
                <h6 class="small fw-bold mb-3">@Localizer["Rcm_AssignSummary"]</h6>
                @if (!bulk.StrategyId.HasValue)
                {
                    <pems-alert tone="info" css="small">@Localizer["Rcm_PickStrategyFirst"]</pems-alert>
                }
                else
                {
                    var willReceive = bulk.Candidates.Values.Count(c => c.WillReceive);
                    var conflicts = bulk.Candidates.Values.Count(c => !c.WillReceive);
                    <input type="hidden" name="strategyId" value="@bulk.StrategyId" />
                    <ul class="small">
                        <li>@Localizer["Rcm_WillReceive"]: <strong>@willReceive</strong></li>
                        <li>@Localizer["Rcm_HasConflict"]: <strong>@conflicts</strong> <span class="text-muted">(@Localizer["Rcm_ConflictsSkipped"])</span></li>
                    </ul>
                    <p class="small text-muted">@Localizer["Rcm_AssignAtomicNote"]</p>
                    <pems-button tone="primary" type="submit" data-pems-confirm="@Localizer["Rcm_ConfirmBulkAssign"]"><pems-icon name="bi-check2-all" /> @Localizer["Rcm_AssignSelected"]</pems-button>
                }
                <div class="small text-muted mt-3">@Localizer["Rcm_NeedTemplate"] <a asp-action="Create">@Localizer["Rcm_NewStrategy"]</a></div>
            </pems-content-card>
        </pems-col>
    </pems-row>
</pems-form>
