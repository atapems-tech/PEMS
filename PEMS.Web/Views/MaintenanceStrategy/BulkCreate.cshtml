@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Application.DTOs
@{
    var equipments = (List<PEMS.Domain.Entities.Equipment>)ViewBag.Equipments;
    var criticalityByEquipment = (Dictionary<int, string>)ViewBag.CriticalityByEquipment;
    var noFilterApplied = (bool)ViewBag.NoFilterApplied;
    var matchingCount = (int?)ViewBag.MatchingCount;
    var maxResults = (int)ViewBag.MaxResults;
    var functionalLocations = (List<FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations;
    var equipmentWithFlCount = (int)ViewBag.EquipmentWithFunctionalLocationCount;
    var selectedDisciplineIds = (List<int>)ViewBag.SelectedDisciplineIds;
    var selectedEquipmentTypes = (List<string>)ViewBag.SelectedEquipmentTypes;
    var selectedFunctionalLocationIds = (List<int>)ViewBag.SelectedFunctionalLocationIds;
    var selectedTagSearch = (string?)ViewBag.SelectedTagSearch;

    var plants = (List<string>)ViewBag.Plants;
    var flAreas = (List<string>)ViewBag.Areas;
    var units = (List<string>)ViewBag.Units;
    var selectedPlants = (List<string>)ViewBag.SelectedPlants;
    var selectedAreas = (List<string>)ViewBag.SelectedAreas;
    var selectedUnits = (List<string>)ViewBag.SelectedUnits;
    var selectedFlMode = (string)ViewBag.SelectedFunctionalLocationMode;
    var selectedTagList = (string?)ViewBag.SelectedTagList;
    var requestedTagCount = (int)ViewBag.RequestedTagCount;
    var matchedTagCount = (int)ViewBag.MatchedTagCount;

    // طبق درخواست: دسته‌بندی دوسطحی - اول بر اساس واحد (Area/Unit)، بعد داخل هر واحد بر
    // اساس نوع تجهیز - چون در عمل RCM دقیقاً همین‌طور فکر می‌کنه («همه‌ی پمپ‌های واحد ۱۰۰»)
    var byArea = equipments
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Area) ? "نامشخص" : x.Area)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-collection"></i> @Localizer["تعریف دسته‌جمعی استراتژی نگهداری"]</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["بازگشت"]</a>
</div>
<p class="text-muted small">
    طبق رویه‌ی واقعی RCM، معمولاً یک استراتژی برای خانواده‌ای از تجهیزات مشابه (مثلاً همه‌ی
    پمپ‌های سانتریفیوژ یک واحد) تعریف می‌شه، نه یکی‌یکی. تجهیزات اول بر اساس <strong>واحد
    (Area)</strong> و داخل هر واحد بر اساس <strong>@Localizer["نوع تجهیز"]</strong> دسته‌بندی شدن. کلاس
    بحرانی‌بودن هر تجهیز (اگه از قبل تحلیل شده) کنارش نشون داده می‌شه.
</p>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <label class="form-label small mb-0">@Localizer["Discipline (چندانتخابی)"]</label>
            <select name="disciplineIds" class="form-select form-select-sm" multiple size="4">
                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@selectedDisciplineIds.Contains((int)d.DisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">@Localizer["Equipment Type (چندانتخابی)"]</label>
            <select name="equipmentTypes" class="form-select form-select-sm" multiple size="4">
                @foreach (var t in (IEnumerable<string>)ViewBag.EquipmentTypes) { <option value="@t" selected="@selectedEquipmentTypes.Contains(t)">@t</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">
                Functional Location (چندانتخابی)
                @if (equipmentWithFlCount < 50)
                {
                    <i class="bi bi-info-circle text-muted" title="فقط تعداد کمی تجهیز هنوز به Functional Location متصل شده - این فیلتر فعلاً نتیجه‌ی محدودی برمی‌گرداند."></i>
                }
            </label>
            <select name="functionalLocationIds" class="form-select form-select-sm" multiple size="4">
                @foreach (var fl in functionalLocations) { <option value="@fl.FunctionalLocationId" selected="@selectedFunctionalLocationIds.Contains(fl.FunctionalLocationId)">@fl.PathBreadcrumb</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">@Localizer["Tag Number (جستجوی متنی)"]</label>
            <input type="text" name="tagSearch" value="@selectedTagSearch" class="form-control form-control-sm" placeholder="مثلاً P-101" />
        </div>

        @* طبق «PEMS CMMS — Bulk Define Maintenance Strategy Scope & Location/Equipment
           Resolution»: زنجیره‌ی Plant/Area/Unit/Functional Location/Equipment/Tag - بدون
           تغییر در ساختار فرم موجود، فقط سه بُعد جدید + حالت Exact/Descendants برای FL. *@
        <div class="col-md-3">
            <label class="form-label small mb-0">
                Plant (چندانتخابی)
                @if (!plants.Any()) { <i class="bi bi-info-circle text-muted" title="در حال حاضر هیچ Functional Location ای مقدار Plant ندارد."></i> }
            </label>
            <select name="plants" class="form-select form-select-sm" multiple size="3">
                @foreach (var p in plants) { <option value="@p" selected="@selectedPlants.Contains(p)">@p</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">Area (Functional Location، چندانتخابی)</label>
            <select name="areas" class="form-select form-select-sm" multiple size="3">
                @foreach (var a in flAreas) { <option value="@a" selected="@selectedAreas.Contains(a)">@a</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">
                Unit (چندانتخابی)
                @if (!units.Any()) { <i class="bi bi-info-circle text-muted" title="در حال حاضر هیچ Functional Location ای مقدار Unit ندارد."></i> }
            </label>
            <select name="units" class="form-select form-select-sm" multiple size="3">
                @foreach (var u in units) { <option value="@u" selected="@selectedUnits.Contains(u)">@u</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0">Functional Location Mode</label>
            <div class="d-flex gap-3 mt-1">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="functionalLocationMode" value="Exact" id="flModeExact" checked="@(selectedFlMode == "Exact")" />
                    <label class="form-check-label small" for="flModeExact" title="فقط خودِ Functional Location(های) انتخاب‌شده">@Localizer["Exact"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="functionalLocationMode" value="Descendants" id="flModeDescendants" checked="@(selectedFlMode == "Descendants")" />
                    <label class="form-check-label small" for="flModeDescendants" title="Functional Location(های) انتخاب‌شده + همه‌ی زیرشاخه‌های واقعی آن‌ها">Descendants</label>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label small mb-0">
                Tag List (چند Tag دقیق - با کاما یا خط جدید جدا کنید)
                <i class="bi bi-info-circle text-muted" title="این‌ها همیشه به نتیجه اضافه می‌شوند، صرف‌نظر از فیلترهای بالا - برای وقتی که تگ‌های مشخصی را از قبل می‌دانید."></i>
            </label>
            <textarea name="tagList" class="form-control form-control-sm" rows="2" placeholder="P-1001, P-1002, P-1003">@selectedTagList</textarea>
            @if (requestedTagCount > 0)
            {
                <div class="form-text">@matchedTagCount از @requestedTagCount Tag درخواست‌شده پیدا شد.</div>
            }
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["فیلتر تجهیزات"]</button>
        </div>

        @if (equipmentWithFlCount < 50)
        {
            <div class="col-12">
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle"></i> در حال حاضر فقط @equipmentWithFlCount تجهیز به Functional Location متصل شده -
                    فیلترهای Functional Location/Plant/Area/Unit آماده‌اند اما تا زمانی که تخصیص بیشتری از طریق
                    «Equipment ↔ FL Assignment» انجام نشود، نتیجه‌ی محدودی برمی‌گردانند. این یک محدودیت داده است، نه نقص این فرم.
                </p>
            </div>
        }
    </form>
</div>

@if (noFilterApplied)
{
    <div class="alert alert-warning small">
        طبق «PEMS Phase 7.6»: این فرم برای فعال‌سازی کنترل‌شده است، نه مرور کل ناوگان تجهیزات
        - ابتدا حداقل یک فیلتر (Discipline، نوع تجهیز، Functional Location/Plant/Area/Unit، یا Tag) را انتخاب کنید تا کاندیدها نمایش داده شوند.
    </div>
}
else if (matchingCount.HasValue && matchingCount.Value > maxResults)
{
    <div class="alert alert-warning small">
        @matchingCount.Value.ToString("N0") تجهیز با این فیلتر مطابقت دارد - فقط @maxResults مورد
        اول نمایش داده می‌شود. برای محدودتر کردن نتیجه، فیلتر دقیق‌تری انتخاب کنید.
    </div>
}

<form asp-action="BulkCreate" method="post">
    <div class="row">
        <div class="col-md-5">
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 small fw-bold">انتخاب تجهیزات (@equipments.Count)</h6>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.querySelectorAll('.eq-check').forEach(c => c.checked = true)">همه</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.querySelectorAll('.eq-check').forEach(c => c.checked = false)">هیچ‌کدام</button>
                    </div>
                </div>

                <div style="max-height:500px; overflow-y:auto;" class="accordion" id="areaAccordion">
                    @foreach (var areaGroup in byArea)
                    {
                        var areaSafeId = "area_" + Math.Abs(areaGroup.Key.GetHashCode());
                        var byType = areaGroup.GroupBy(x => string.IsNullOrWhiteSpace(x.EquipmentType) ? "نامشخص" : x.EquipmentType).OrderBy(g => g.Key).ToList();

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed small" type="button" data-bs-toggle="collapse" data-bs-target="#@areaSafeId">
                                    <i class="bi bi-geo-alt me-2"></i> @areaGroup.Key
                                    <span class="badge bg-secondary ms-2">@areaGroup.Count()</span>
                                </button>
                            </h2>
                            <div id="@areaSafeId" class="accordion-collapse collapse" data-bs-parent="#areaAccordion">
                                <div class="accordion-body p-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary mb-2"
                                            onclick="document.querySelectorAll('.area-@areaSafeId').forEach(c => c.checked = true)">
                                        <i class="bi bi-check2-square"></i> انتخاب کل این واحد
                                    </button>

                                    @foreach (var typeGroup in byType)
                                    {
                                        var typeSafeId = areaSafeId + "_" + Math.Abs(typeGroup.Key.GetHashCode());

                                        <div class="border rounded p-2 mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-bold"><i class="bi bi-gear"></i> @typeGroup.Key <span class="badge bg-light text-dark">@typeGroup.Count()</span></span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                                        onclick="document.querySelectorAll('.type-@typeSafeId').forEach(c => c.checked = true)">
                                                    انتخاب این نوع
                                                </button>
                                            </div>
                                            <table class="table table-sm mb-0">
                                                <tbody>
                                                    @foreach (var eq in typeGroup)
                                                    {
                                                        var cls = criticalityByEquipment.GetValueOrDefault(eq.EquipmentId);
                                                        <tr>
                                                            <td style="width:30px;">
                                                                <input type="checkbox" class="eq-check area-@areaSafeId type-@typeSafeId" name="equipmentIds" value="@eq.EquipmentId" />
                                                            </td>
                                                            <td class="small">@eq.TagNumber — @eq.Name</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(cls))
                                                                {
                                                                    <span class="badge @(cls == "A" ? "bg-danger" : cls == "B" ? "bg-warning text-dark" : "bg-secondary")">@cls</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted small">-</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (!equipments.Any() && !noFilterApplied) { <p class="text-muted small text-center py-3">@Localizer["تجهیزی با این فیلتر پیدا نشد."]</p> }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="content-card">
                <h6 class="small fw-bold mb-3">تعریف استراتژی (روی همه‌ی تجهیزات انتخاب‌شده اعمال می‌شه)</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Strategy Type"]</label>
                        <select name="strategyType" class="form-select" required>
                            <option>@Localizer["Preventive"]</option>
                            <option>@Localizer["Predictive"]</option>
                            <option>@Localizer["CBM"]</option>
                            <option>@Localizer["Corrective"]</option>
                            <option value="RunToFailure">@Localizer["Run-to-Failure"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Failure Mode (ISO 14224)"]</label>
                        <select name="failureModeCode" class="form-select">
                            <option value="">@Localizer["-- انتخاب --"]</option>
                            <option>@Localizer["Leakage"]</option><option>@Localizer["Fracture"]</option><option>@Localizer["Vibration"]</option>
                            <option>@Localizer["Overheating"]</option><option>@Localizer["Blockage"]</option><option>@Localizer["ElectricalFault"]</option>
                            <option>@Localizer["Other"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Consequence Category (RCM)"]</label>
                        <select name="consequenceCategory" class="form-select" required>
                            <option value="Safety">@Localizer["Safety"]</option>
                            <option value="Environmental">@Localizer["Environmental"]</option>
                            <option value="Operational" selected>@Localizer["Operational"]</option>
                            <option value="Economic">@Localizer["Economic"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Recommended Trigger Type"]</label>
                        <select name="recommendedTriggerType" class="form-select">
                            <option value="Calendar">@Localizer["Calendar"]</option>
                            <option value="Meter">@Localizer["Meter"]</option>
                            <option value="Both">@Localizer["Both"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Frequency (راهنما)"]</label>
                        <select name="frequency" class="form-select">
                            <option>@Localizer["Daily"]</option><option>@Localizer["Weekly"]</option><option>@Localizer["Monthly"]</option>
                            <option>@Localizer["Quarterly"]</option><option>@Localizer["Yearly"]</option>
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="startDate" type="date" class="form-control" /></div>
                    <div class="col-12">
                        <label class="form-label">Justification (چرا این استراتژی برای این خانواده‌ی تجهیزات؟)</label>
                        <textarea name="justification" class="form-control" rows="2" required></textarea>
                    </div>
                    <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check2-all"></i> اعمال روی تجهیزات انتخاب‌شده</button>
                </div>
            </div>
        </div>
    </div>
</form>
