@model PEMS.Web.ViewModels.StrategyDetailsViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Domain.Common
@using PEMS.Web.Helpers
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Strategy;
    var i = s.Input;
    var usable = s.Status is "Approved" or "Active";
    var live = s.IsActive && s.Status != "Retired" && s.Status != "Superseded";
}

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0"><pems-icon name="bi-diagram-3" /> @(string.IsNullOrWhiteSpace(i.Title) ? Localizer["Rcm_Strategy"].Value : i.Title)
        <pems-badge tone="@RcmDisplay.StatusBadge(s.Status)" css="ms-2">@Localizer.Label("Status", s.Status)</pems-badge>
        <pems-badge tone="light">v@(s.VersionNumber)</pems-badge>
    </h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["Rcm_Back"]</pems-button>
</pems-flex>

@await Html.PartialAsync("_RcmErrors", Model.Errors)

@if (Model.AssignReport.Any())
{
    <pems-content-card css="mb-3">
        <h6 class="small fw-bold">@Localizer["Rcm_AssignReport"]</h6>
        <pems-table scale="small" css="table-enterprise">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Rcm_Tag"]</pems-table-header><pems-table-header>@Localizer["Rcm_SkipReason"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
            @foreach (var row in Model.AssignReport)
            {
                <pems-table-row>
                    <pems-table-cell>@row[0]</pems-table-cell>
                    <pems-table-cell class="small">@(row[1] == "NotFound" ? Localizer["Rcm_Bulk_NotFound"].Value : Localizer["Rcm_Bulk_" + row[1]].Value)
                        @if (row.Length > 2 && int.TryParse(row[2], out var otherId)) { <a asp-action="Details" asp-route-id="@otherId">#@otherId</a> }</pems-table-cell>
                </pems-table-row>
            }
            </pems-table-body>
        </pems-table>
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <pems-info-grid>
        <pems-info-item label="@Localizer["Rcm_EquipmentClass"]">@(s.EquipmentClassName)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_StrategyType"]"><pems-badge tone="neutral">@Localizer.Label("StrategyType", i.StrategyType)</pems-badge></pems-info-item>
        <pems-info-item label="@Localizer["Rcm_FailureMode"]">@RcmDisplay.Name(s.FailureModeName, s.FailureModeNameFa)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_Consequence"]"><pems-badge tone="@RcmDisplay.ConsequenceBadge(i.ConsequenceCategory)">@Localizer.Label("Consequence", i.ConsequenceCategory)</pems-badge>@if (i.IsHiddenFailure) { <pems-badge tone="dark">@Localizer["Rcm_HiddenFailure"]</pems-badge> }</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_TaskType"]">@Localizer.Label("TaskType", i.TaskType)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_OwnerDiscipline"]">@(s.OwnerDisciplineName)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_Frequency"]">@Localizer.Label("Frequency", i.Frequency) @(i.DefaultIntervalDays.HasValue ? $"({i.DefaultIntervalDays} d)" : "")</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_Source"]">@Localizer.Label("Source", i.Source)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_FunctionalFailure"]">@(i.FunctionalFailure)</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_FailureEffect"]">@(i.FailureEffect)</pems-info-item>
        @if (i.StrategyType is "CBM" or "Predictive")
        {
            <pems-info-item label="@Localizer["Rcm_CbmParameter"]">@i.CbmParameter @i.ThresholdUnit</pems-info-item>
            <pems-info-item label="@Localizer["Rcm_AlarmThreshold"] / @Localizer["Rcm_TripThreshold"]">@i.AlarmThreshold / @i.TripThreshold</pems-info-item>
            <pems-info-item label="@Localizer["Rcm_PfInterval"]">@i.PfIntervalDays</pems-info-item>
            <pems-info-item label="@Localizer["Rcm_InspectionInterval"]">@i.InspectionIntervalDays</pems-info-item>
        }
        <pems-info-item label="@Localizer["Rcm_Justification"]" wide>@i.Justification</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_ReviewDate"]">@(i.ReviewDate?.ToString("yyyy-MM-dd"))</pems-info-item>
        <pems-info-item label="@Localizer["Rcm_ApprovedBy"]">@(s.ApprovedBy) @(s.ApprovedAt?.ToString("yyyy-MM-dd"))</pems-info-item>
        @if (!string.IsNullOrEmpty(s.LegacyEquipmentTag))
        {
            <pems-info-item label="@Localizer["Rcm_LegacyTag"]"><a asp-action="Tag" asp-route-equipmentId="@s.LegacyEquipmentId">@s.LegacyEquipmentTag</a></pems-info-item>
        }
    </pems-info-grid>

    <pems-flex wrap="true" gap="2" css="mt-3">
        @if (Model.CanEdit && live)
        {
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Edit" asp-route-id="@s.MaintenanceStrategyId"><pems-icon name="bi-pencil" /> @(usable ? Localizer["Rcm_NewVersion"] : Localizer["Rcm_Edit"])</pems-button>
        }
        @if (Model.CanEdit && s.Status == "Draft")
        {
            <form asp-action="Submit" asp-route-id="@s.MaintenanceStrategyId" method="post" class="d-inline">
                <pems-button tone="none" size="small" css="btn-primary"><pems-icon name="bi-send" /> @Localizer["Rcm_SubmitForReview"]</pems-button>
            </form>
        }
        @if (Model.CanApprove && s.Status == "InReview")
        {
            <form asp-action="Review" asp-route-id="@s.MaintenanceStrategyId" method="post"><pems-flex inline="true" gap="2">
                <pems-input class="pems-w-220" scale="small" name="comment" placeholder="@Localizer["Rcm_Comment"]" />
                <pems-button tone="success" size="small" name="approve" value="true"><pems-icon name="bi-check2" /> @Localizer["Rcm_Approve"]</pems-button>
                <pems-button tone="danger" size="small" outline="true" name="approve" value="false"><pems-icon name="bi-x" /> @Localizer["Rcm_Reject"]</pems-button>
            </pems-flex></form>
            @if (Model.IsAuthorOrSubmitter) { <span class="small text-muted align-self-center">@Localizer["Rcm_SodNotice"]</span> }
        }
        @if (Model.CanApprove && s.Status == "Approved")
        {
            <form asp-action="Activate" asp-route-id="@s.MaintenanceStrategyId" method="post"><pems-flex inline="true" gap="2" align="center">
                <pems-check-row css="small mb-0"><pems-input kind="check" type="checkbox" name="moveAssignments" value="true" checked id="mv" /><label class="form-check-label" for="mv">@Localizer["Rcm_MoveAssignments"]</label></pems-check-row>
                <pems-button tone="success" size="small"><pems-icon name="bi-lightning" /> @Localizer["Rcm_Activate"]</pems-button>
            </pems-flex></form>
        }
        @if (Model.CanApprove && live)
        {
            <form asp-action="Retire" asp-route-id="@s.MaintenanceStrategyId" method="post" class="d-inline" data-pems-confirm="@Localizer["Rcm_ConfirmRetire"]">
                <pems-button tone="danger" size="small" outline="true"><pems-icon name="bi-slash-circle" /> @Localizer["Rcm_Retire"]</pems-button>
            </form>
        }
    </pems-flex>
</pems-content-card>

@if (s.Versions.Count > 1)
{
    <pems-content-card css="mb-3">
        <h6 class="small fw-bold">@Localizer["Rcm_Versions"]</h6>
        <pems-flex wrap="true" gap="2">
            @foreach (var v in s.Versions)
            {
                <a asp-action="Details" asp-route-id="@v.MaintenanceStrategyId" class="text-decoration-none">
                    <pems-badge tone="@RcmDisplay.StatusBadge(v.Status)" css="@(v.MaintenanceStrategyId == s.MaintenanceStrategyId ? "border border-3 border-warning" : "")">v@(v.VersionNumber) · @Localizer.Label("Status", v.Status)</pems-badge>
                </a>
            }
        </pems-flex>
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" css="mb-2">
        <h6 class="small fw-bold mb-0">@Localizer["Rcm_AssignedTags"] (@s.Assignments.Count)</h6>
        @if (Model.CanApprove && usable)
        {
            <pems-flex gap="2">
                <form asp-action="Assign" asp-route-id="@s.MaintenanceStrategyId" method="post"><pems-flex gap="2">
                    <pems-input class="pems-w-260" scale="small" type="text" placeholder="@Localizer["Rcm_SearchEquipmentPlaceholder"]" data-pems-search data-search-type="Equipment" data-search-hidden="#assignEquipmentId" autocomplete="off" required />
                    <input type="hidden" name="equipmentIds" id="assignEquipmentId" />
                    <pems-button tone="primary" size="small" outline="true">@Localizer["Rcm_AssignTag"]</pems-button>
                </pems-flex></form>
                <pems-button tone="primary" size="small" outline="true" as="a" asp-action="BulkCreate" asp-route-strategyId="@s.MaintenanceStrategyId" asp-route-classId="@i.EquipmentClassId"><pems-icon name="bi-collection" /> @Localizer["Rcm_BulkAssign"]</pems-button>
            </pems-flex>
        }
    </pems-flex>
    @if (!usable) { <p class="small text-muted">@Localizer["Rcm_AssignRequiresApproval"]</p> }
    <pems-table-scroll>
        <pems-table scale="small" css="table-enterprise align-middle">
            <pems-table-head><pems-table-row>
                <pems-table-header>@Localizer["Rcm_Tag"]</pems-table-header><pems-table-header>@Localizer["Rcm_EquipmentName"]</pems-table-header><pems-table-header>@Localizer["Rcm_EquipmentClass"]</pems-table-header><pems-table-header>@Localizer["Rcm_AreaUnit"]</pems-table-header>
                <pems-table-header>@Localizer["Rcm_Criticality"]</pems-table-header><pems-table-header>@Localizer["Rcm_Plans"]</pems-table-header><pems-table-header>@Localizer["Rcm_Override"]</pems-table-header><pems-table-header></pems-table-header>
            </pems-table-row></pems-table-head>
            <pems-table-body>
            @foreach (var a in s.Assignments)
            {
                <pems-table-row>
                    <pems-table-cell><a asp-action="Tag" asp-route-equipmentId="@a.Equipment.EquipmentId" class="fw-bold">@a.Equipment.Tag</a></pems-table-cell>
                    <pems-table-cell class="small">@a.Equipment.Name</pems-table-cell>
                    <pems-table-cell class="small">@(a.Equipment.EquipmentClassName ?? "-")</pems-table-cell>
                    <pems-table-cell class="small">@(a.Equipment.Area ?? "-")</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@RcmDisplay.CriticalityBadge(a.Equipment.CriticalityClass)">@Localizer.Label("Criticality", a.Equipment.CriticalityClass)</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">@a.PlanCount
                        @if (usable && a.PlanCount == 0 && i.StrategyType is not ("RunToFailure" or "Corrective" or "Redesign"))
                        {
                            <a asp-controller="MaintenancePlan" asp-action="Create" asp-route-assignmentId="@a.AssignmentId" class="ms-1"><pems-icon name="bi-calendar-plus" /></a>
                        }
                    </pems-table-cell>
                    <pems-table-cell class="small">
                        @if (a.OverrideStatus != "None")
                        {
                            <div><pems-badge tone="info">@Localizer.Label("OverrideStatus", a.OverrideStatus)</pems-badge> @(a.OverrideIntervalDays.HasValue ? a.OverrideIntervalDays + " d" : "")</div>
                            <div class="text-muted">@a.OverrideJustification</div>
                            @if (a.OverrideStatus == "Pending" && Model.CanApprove)
                            {
                                <form class="mt-1" asp-action="DecideOverride" method="post"><pems-flex gap="1">
                                    <input type="hidden" name="assignmentId" value="@a.AssignmentId" /><input type="hidden" name="strategyId" value="@s.MaintenanceStrategyId" />
                                    <pems-input scale="small" name="comment" placeholder="@Localizer["Rcm_Comment"]" />
                                    <pems-button tone="success" size="small" name="approve" value="true">✓</pems-button>
                                    <pems-button tone="danger" size="small" outline="true" name="approve" value="false">✗</pems-button>
                                </pems-flex></form>
                            }
                        }
                        else if (Model.CanEdit && usable)
                        {
                            <pems-button tone="neutral" size="small" outline="true" css="py-0" type="button" data-bs-toggle="modal" data-bs-target="#overrideModal" data-assignment="@a.AssignmentId" data-tag="@a.Equipment.Tag">@Localizer["Rcm_RequestOverride"]</pems-button>
                        }
                    </pems-table-cell>
                    <pems-table-cell class="text-end">
                        @if (Model.CanApprove)
                        {
                            <form asp-action="Unassign" method="post" class="d-inline" data-pems-confirm="@Localizer["Rcm_ConfirmUnassign"]">
                                <input type="hidden" name="assignmentId" value="@a.AssignmentId" /><input type="hidden" name="strategyId" value="@s.MaintenanceStrategyId" />
                                <pems-button tone="danger" size="small" outline="true" css="py-0"><pems-icon name="bi-x-lg" /></pems-button>
                            </form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
            </pems-table-body>
        </pems-table>
        @if (!s.Assignments.Any()) { <p class="text-muted small text-center py-2">@Localizer["Rcm_NoAssignments"]</p> }
    </pems-table-scroll>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="small fw-bold">@Localizer["Rcm_PlansByVersion"]</h6>
    <pems-table scale="small" css="table-enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Rcm_PlanNumber"]</pems-table-header><pems-table-header>@Localizer["Rcm_Tag"]</pems-table-header><pems-table-header>@Localizer["Rcm_Title"]</pems-table-header><pems-table-header>@Localizer["Rcm_Version"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
        @foreach (var p in s.Plans)
        {
            <pems-table-row>
                <pems-table-cell>@p.PlanNumber</pems-table-cell><pems-table-cell>@p.Tag</pems-table-cell><pems-table-cell class="small">@p.Title</pems-table-cell>
                <pems-table-cell>v@(p.StrategyVersion) @if (p.OutOfSync) { <pems-badge tone="warning" title="@Localizer["Rcm_PlanOutOfSync"]">@Localizer["Rcm_OutOfSync"]</pems-badge> }</pems-table-cell>
            </pems-table-row>
        }
        </pems-table-body>
    </pems-table>
    @if (!s.Plans.Any()) { <p class="text-muted small text-center py-2">@Localizer["Rcm_NoPlans"]</p> }
</pems-content-card>

<pems-content-card>
    <h6 class="small fw-bold">@Localizer["Rcm_History"]</h6>
    <pems-table scale="small" css="table-enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Rcm_When"]</pems-table-header><pems-table-header>@Localizer["Rcm_Who"]</pems-table-header><pems-table-header>@Localizer["Rcm_Action"]</pems-table-header><pems-table-header>@Localizer["Rcm_Version"]</pems-table-header><pems-table-header>@Localizer["Rcm_Changes"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
        @foreach (var h in s.History)
        {
            <pems-table-row>
                <pems-table-cell class="small text-nowrap">@h.Timestamp.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                <pems-table-cell class="small">@h.ActorName</pems-table-cell>
                <pems-table-cell class="small">@Localizer.Label("HistoryAction", h.Action) @if (h.FromStatus != null || h.ToStatus != null) { <span class="text-muted">(@h.FromStatus → @h.ToStatus)</span> }</pems-table-cell>
                <pems-table-cell class="small">v@(h.VersionNumber)</pems-table-cell>
                <pems-table-cell class="small"><pre class="mb-0 pems-s-121f7751">@h.ChangesSummary</pre>@h.Comment</pems-table-cell>
            </pems-table-row>
        }
        </pems-table-body>
    </pems-table>
</pems-content-card>

<pems-modal id="overrideModal" tabindex="-1">
            <form asp-action="RequestOverride" method="post">
                <input type="hidden" name="strategyId" value="@s.MaintenanceStrategyId" />
                <input type="hidden" name="assignmentId" id="overrideAssignmentId" />
                <pems-modal-header>@Localizer["Rcm_RequestOverride"] — <span id="overrideTag"></span></pems-modal-header>
                <pems-modal-body>
                    <p class="small text-muted">@Localizer["Rcm_OverrideHint"]</p>
                    <div class="mb-2"><pems-label>@Localizer["Rcm_OverrideInterval"]</pems-label><pems-input name="overrideIntervalDays" type="number" min="1" /></div>
                    <div class="mb-2"><pems-label>@Localizer["Rcm_OverrideTaskNote"]</pems-label><pems-textarea name="overrideTaskNote" rows="2" maxlength="1000"></pems-textarea></div>
                    <div class="mb-2"><pems-label>@Localizer["Rcm_Justification"] *</pems-label><pems-textarea name="overrideJustification" rows="2" minlength="20" required maxlength="1000"></pems-textarea></div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>

@section Scripts {
    <script src="~/js/views/maintenancestrategy-details.js" asp-append-version="true"></script>
}
