@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="primary" size="small" as="a" asp-action="RegisterIncoming">
        <pems-icon name="bi-envelope-plus" /> @Localizer["ثبت مکاتبه‌ی وارده"]
    </pems-button>
</pems-flex>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-kpi-tile icon="bi-send-check" color="blue" label="@Localizer["مدارک آماده‌ی صدور (Approved)"]">@ViewBag.PendingIssueCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-kpi-tile tone="warning" icon="bi-envelope-exclamation" color="amber" label="@Localizer["مکاتبات وارده‌ی وصل‌نشده"]">@ViewBag.UnlinkedIncomingCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="text-center">
            <a asp-controller="Relationship" asp-action="Index" class="text-decoration-none">
                <div class="fs-3 fw-bold text-info"><pems-icon name="bi-diagram-3" /></div>
                <div class="text-muted small">@Localizer["Relationship Explorer"]</div>
            </a>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <h6 class="mb-3"><pems-icon name="bi-send-check" /> @Localizer["مدارک منتظر صدور"]</h6>
            @{
                var pendingIssueDocs = (IEnumerable<dynamic>)ViewBag.PendingIssueDocs;
            }
            @if (pendingIssueDocs.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var d in pendingIssueDocs)
                    {
                        <pems-flex as="li" justify="between" css="border-bottom py-1">
                            <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId">
                                @d.DocumentNo &mdash; @d.Title
                            </a>
                            <span class="text-muted small">@(((DateTime?)d.ModifiedDate)?.ToString("yyyy-MM-dd"))</span>
                        </pems-flex>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">@Localizer["مدرکی در انتظار صدور نیست."]</p>
            }
        </pems-content-card>
    </pems-col>

    <pems-col md="6">
        <pems-content-card css="h-100 border-warning">
            <h6 class="mb-3"><pems-icon name="bi-envelope-exclamation" /> @Localizer["مکاتبات وارده‌ی وصل‌نشده"]</h6>
            @{
                var unlinked = (IEnumerable<dynamic>)ViewBag.UnlinkedIncoming;
            }
            @if (unlinked.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var l in unlinked)
                    {
                        <pems-flex as="li" justify="between" css="border-bottom py-1">
                            <a asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId">
                                @l.LetterNumber &mdash; @l.Subject
                            </a>
                            <span class="text-muted small">@l.Sender</span>
                        </pems-flex>
                    }
                </ul>
                <p class="text-muted small mt-2 mb-0">این‌ها هنوز به هیچ مدرک/MR وصل نشده‌اند - روی هرکدام برو و از Relationship Explorer یا ویرایش نامه، لینکش کن.</p>
            }
            else
            {
                <p class="text-muted small mb-0">همه‌ی مکاتبات وارده به یک مدرک/MR وصل شده‌اند.</p>
            }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <h6 class="mb-3"><pems-icon name="bi-clock-history" /> @Localizer["آخرین مکاتبات وارده"]</h6>
    @{
        var recentIncoming = (IEnumerable<dynamic>)ViewBag.RecentIncoming;
    }
    <pems-table kind="enterprise" css="mb-0">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["شماره"]</pems-table-header><pems-table-header>@Localizer["فرستنده"]</pems-table-header><pems-table-header>@Localizer["موضوع"]</pems-table-header><pems-table-header>@Localizer["تاریخ"]</pems-table-header><pems-table-header>@Localizer["لینک"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var l in recentIncoming)
            {
                <pems-table-row>
                    <pems-table-cell><a asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId">@l.LetterNumber</a></pems-table-cell>
                    <pems-table-cell class="small">@l.Sender</pems-table-cell>
                    <pems-table-cell class="small">@l.Subject</pems-table-cell>
                    <pems-table-cell class="small">@(((DateTime)l.LetterDate).ToString("yyyy-MM-dd"))</pems-table-cell>
                    <pems-table-cell>
                        @if (l.RelatedDocumentId != null)
                        {
                            <pems-badge tone="success">@Localizer["مدرک"]</pems-badge>
                        }
                        else if (l.RelatedMRId != null)
                        {
                            <pems-badge tone="success">MR</pems-badge>
                        }
                        else
                        {
                            <pems-badge tone="warning">@Localizer["وصل‌نشده"]</pems-badge>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
</pems-content-card>
