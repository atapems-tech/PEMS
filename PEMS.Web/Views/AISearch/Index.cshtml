@model List<PEMS.Application.AI.Search.Models.DocumentSearchResult>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2" css="align-items-end">
        <pems-col md="4">
            <pems-label css="small">@Localizer["Search Query"]</pems-label>
            <pems-input type="text" name="q" value="@ViewBag.Query" placeholder="e.g. P-101, pressure vessel datasheet, piping isometric ..." />
        </pems-col>
        <pems-col md="2">
            <pems-label css="small">@Localizer["Discipline"]</pems-label>
            <pems-select scale="small" name="discipline">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in (List<string>)ViewBag.Disciplines)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDiscipline)">@d</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-label css="small">@Localizer["Document Type"]</pems-label>
            <pems-select scale="small" name="documentType">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in (List<string>)ViewBag.DocumentTypes)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDocumentType)">@d</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-label css="small">@Localizer["Status"]</pems-label>
            <pems-select scale="small" name="status">
                <option value="">@Localizer["All"]</option>
                @foreach (var s in (List<string>)ViewBag.Statuses)
                { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-search" /> @Localizer["Search"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    @if (!Model.Any())
    {
        <pems-text class="text-muted text-center py-4">
            Type a search term above, or use filters, to search across document numbers, titles,
            descriptions, and AI-extracted summaries/tags.
        </pems-text>
    }
    else
    {
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        @{
            var rows_19 = Model;
            var cell_19_3 = DataCell.Template(rows_19, @<text>@{ var r = item; }
                            <pems-progress class="pems-w-100" value="@((int)(r.SimilarityScore * 100))" tone="success" height="8px"></pems-progress>
                        </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_19, c_ => c_.Add(((Localizer["Document No"])?.ToString() ?? ""), r => (object?)(r.DocumentNumber)).Add(((Localizer["Title"])?.ToString() ?? ""), r => (object?)(r.Title)).Add("Match Reason", r => (object?)(r.Reason), css: "small text-muted").Add(((Localizer["Relevance"])?.ToString() ?? ""), r => (object?)cell_19_3(r)).Add("", r => (object?)(DataCell.ButtonLink(Url.Action("Details", "EngineeringDocuments", new { id = r.DocumentId }), "neutral", "small", true, null, DataCell.Icon("bi-eye"))))))" />
        </pems-table-scroll>
    }
</pems-content-card>
