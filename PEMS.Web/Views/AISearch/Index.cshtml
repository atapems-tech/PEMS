@model List<PEMS.Application.AI.Search.Models.DocumentSearchResult>

<div class="content-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">Search Query</label>
            <input type="text" name="q" value="@ViewBag.Query" class="form-control"
                   placeholder="e.g. P-101, pressure vessel datasheet, piping isometric ..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Discipline</label>
            <select name="discipline" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var d in (List<string>)ViewBag.Disciplines)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDiscipline)">@d</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Document Type</label>
            <select name="documentType" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var d in (List<string>)ViewBag.DocumentTypes)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDocumentType)">@d</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in (List<string>)ViewBag.Statuses)
                { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-pems-solid btn-sm w-100"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>
</div>

<div class="content-card">
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">
            Type a search term above, or use filters, to search across document numbers, titles,
            descriptions, and AI-extracted summaries/tags.
        </p>
    }
    else
    {
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>Document No</th><th>Title</th><th>Match Reason</th><th>Relevance</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.DocumentNumber</td>
                        <td>@r.Title</td>
                        <td class="small text-muted">@r.Reason</td>
                        <td>
                            <div class="progress" style="height:8px; width:100px;">
                                <div class="progress-bar bg-success" style="width:@((int)(r.SimilarityScore * 100))%"></div>
                            </div>
                        </td>
                        <td>
                            <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@r.DocumentId"
                               class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
