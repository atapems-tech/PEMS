@model List<PEMS.Application.AI.Search.Models.DocumentSearchResult>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <pems-label css="small">@Localizer["Search Query"]</pems-label>
            <pems-input type="text" name="q" value="@ViewBag.Query" placeholder="e.g. P-101, pressure vessel datasheet, piping isometric ..." />
        </div>
        <div class="col-md-2">
            <pems-label css="small">@Localizer["Discipline"]</pems-label>
            <pems-select scale="small" name="discipline">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in (List<string>)ViewBag.Disciplines)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDiscipline)">@d</option> }
            </pems-select>
        </div>
        <div class="col-md-2">
            <pems-label css="small">@Localizer["Document Type"]</pems-label>
            <pems-select scale="small" name="documentType">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in (List<string>)ViewBag.DocumentTypes)
                { <option value="@d" selected="@(d == (string?)ViewBag.SelectedDocumentType)">@d</option> }
            </pems-select>
        </div>
        <div class="col-md-2">
            <pems-label css="small">@Localizer["Status"]</pems-label>
            <pems-select scale="small" name="status">
                <option value="">@Localizer["All"]</option>
                @foreach (var s in (List<string>)ViewBag.Statuses)
                { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </pems-select>
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" size="small" css="w-100" type="submit"><i class="bi bi-search"></i> @Localizer["Search"]</pems-button>
        </div>
    </form>
</div>

<div class="content-card">
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">
            Type a search term above, or use filters, to search across document numbers, titles,
            descriptions, and AI-extracted summaries/tags.
        </p>
    }
    else
    {
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Document No"]</th><th>@Localizer["Title"]</th><th>Match Reason</th><th>@Localizer["Relevance"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.DocumentNumber</td>
                        <td>@r.Title</td>
                        <td class="small text-muted">@r.Reason</td>
                        <td>
                            <pems-progress value="@((int)(r.SimilarityScore * 100))" tone="success" height="8px" style="width:100px;"></pems-progress>
                        </td>
                        <td>
                            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@r.DocumentId"
                              ><i class="bi bi-eye"></i></pems-button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
