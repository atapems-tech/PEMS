@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var equipments = (IEnumerable<dynamic>)ViewBag.Equipments;
    var pos = (IEnumerable<dynamic>)ViewBag.PurchaseOrders;
}

<div class="content-card pems-s-bcaa1805">
    <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></pems-alert>

    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects)
                    {
                        <option value="@p.ProjectId">@p.ProjectName</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Equipment"]</pems-label>
                <pems-select name="equipmentId" required>
                    @foreach (var eq in equipments)
                    {
                        <option value="@eq.EquipmentId">@eq.TagNumber</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Vendor"]</pems-label>
                <pems-select name="vendorId" required>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.VendorId">@v.Name</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>Purchase Order <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                <pems-select name="poId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var po in pos)
                    {
                        <option value="@po.PoId">@po.PoNumber</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>Planned Final Issue Date <span class="text-muted small">(index due 4 weeks before)</span></pems-label>
                <pems-date name="plannedFinalIssueDate" />
            </pems-col>
        </pems-row>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">Create MDB</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
