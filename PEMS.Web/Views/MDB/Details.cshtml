@model PEMS.Application.DTOs.ManufacturerDataBookDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var documents = (IEnumerable<dynamic>)ViewBag.Documents;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">MDB - @Model.EquipmentTagNumber</h5>
            <span class="text-muted small">@Model.VendorName &middot; @Model.ProjectName @(Model.PoNumber != null ? $"· PO {Model.PoNumber}" : "")</span>
        </div>
        <pems-badge tone="neutral" css="fs-6">@Model.Status</pems-badge>
    </div>

    <hr class="my-2" />

    <div class="row g-3">
        <div class="col-md-3"><strong>Planned Final Issue:</strong> @(Model.PlannedFinalIssueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        <div class="col-md-3">
            <strong>Index of Contents Due:</strong> @(Model.IndexOfContentsDueDate?.ToString("yyyy-MM-dd") ?? "-")
            @if (Model.IsIndexOverdue)
            {
                <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge>
            }
        </div>
        <div class="col-md-3"><strong>Index Submitted:</strong> @(Model.IndexOfContentsSubmittedDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        <div class="col-md-3"><strong>Hard Copy:</strong> @(Model.HardCopyShippedDate.HasValue ? $"Shipped {Model.HardCopyShippedDate:yyyy-MM-dd} ({Model.HardCopyCount} vol)" : "Not shipped")</div>
        <div class="col-md-3"><strong>Soft Copy:</strong> @(Model.SoftCopyDeliveredDate.HasValue ? $"Delivered {Model.SoftCopyDeliveredDate:yyyy-MM-dd}" : "Not delivered")</div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @if (Model.IndexOfContentsSubmittedDate == null)
        {
            <form asp-action="MarkIndexSubmitted" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Index Submitted</pems-button></form>
        }
        @if (Model.Status != "FinalIssued" && Model.Status != "Delivered")
        {
            <form asp-action="MarkFinalIssued" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Final Issued</pems-button></form>
        }
        @if (!Model.HardCopyShippedDate.HasValue)
        {
            <form asp-action="MarkHardCopyShipped" method="post" class="d-flex gap-1">
                <input type="hidden" name="mdbId" value="@Model.MDBId" />
                <input type="number" name="hardCopyCount" class="form-control form-control-sm" style="width:90px;" placeholder="# volumes" />
                <pems-button tone="primary" size="small" outline="true">Mark Hard Copy Shipped</pems-button>
            </form>
        }
        @if (!Model.SoftCopyDeliveredDate.HasValue)
        {
            <form asp-action="MarkSoftCopyDelivered" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Soft Copy Delivered</pems-button></form>
        }
    </div>
</div>

@{
    var parts = new[] {
        ("A", "Part A - Engineering Dossier", Model.DocumentsPartA),
        ("B", "Part B - Manufacturer's Inspection Data Book", Model.DocumentsPartB),
        ("C", "Part C - Installation / Startup / Commissioning / O&M Manual", Model.DocumentsPartC)
    };
}

@foreach (var (code, label, docs) in parts)
{
    <div class="content-card mb-3">
        <h6 class="mb-3">@label</h6>
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Document No"]</th><th>@Localizer["Title"]</th><th>DVD Volume</th><th>N/A</th><th>@Localizer["Notes"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in docs)
                {
                    <tr>
                        <td>@d.DocumentNo</td>
                        <td>@d.Title</td>
                        <td>@d.DvdVolumeNo</td>
                        <td>@(d.IsNotApplicable ? "Not applicable" : "")</td>
                        <td>@d.Notes</td>
                        <td>
                            <form asp-action="RemoveDocument" method="post">
                                <input type="hidden" name="mdbId" value="@Model.MDBId" />
                                <input type="hidden" name="mdbDocumentId" value="@d.MDBDocumentId" />
                                <pems-button tone="danger" size="small" outline="true"><i class="bi bi-trash"></i></pems-button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!docs.Any())
        {
            <p class="text-muted small mb-2">No documents in this part yet.</p>
        }

        <form asp-action="AddDocument" method="post" class="row g-2 mt-2">
            <input type="hidden" name="mdbId" value="@Model.MDBId" />
            <input type="hidden" name="part" value="@code" />
            <div class="col-md-3">
                <select name="documentId" class="form-select form-select-sm">
                    <option value="">-- Link existing document (optional) --</option>
                    @foreach (var doc in documents)
                    {
                        <option value="@doc.DocumentId">@doc.DocumentNo - @doc.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input name="title" class="form-control form-control-sm" placeholder="Title (if not linking a document)" /></div>
            <div class="col-md-2"><input name="dvdVolumeNo" type="number" class="form-control form-control-sm" placeholder="DVD Vol #" /></div>
            <div class="col-md-2 form-check d-flex align-items-center">
                <input type="checkbox" name="isNotApplicable" value="true" class="form-check-input me-1" id="na_@code" />
                <label class="form-check-label small" for="na_@code">Not applicable</label>
            </div>
            <div class="col-md-2"><pems-button tone="primary" size="small" outline="true" css="w-100"><i class="bi bi-plus-lg"></i> @Localizer["Add"]</pems-button></div>
        </form>
    </div>
}
