@model PEMS.Application.DTOs.ManufacturerDataBookDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var documents = (IEnumerable<dynamic>)ViewBag.Documents;
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">MDB - @Model.EquipmentTagNumber</h5>
            <span class="text-muted small">@Model.VendorName &middot; @Model.ProjectName @(Model.PoNumber != null ? $"· PO {Model.PoNumber}" : "")</span>
        </div>
        <pems-badge tone="neutral" css="fs-6">@Model.Status</pems-badge>
    </pems-flex>

    <hr class="my-2" />

    <pems-row gap="3">
        <pems-col md="3"><strong>Planned Final Issue:</strong> @(Model.PlannedFinalIssueDate?.ToString("yyyy-MM-dd") ?? "-")</pems-col>
        <pems-col md="3">
            <strong>Index of Contents Due:</strong> @(Model.IndexOfContentsDueDate?.ToString("yyyy-MM-dd") ?? "-")
            @if (Model.IsIndexOverdue)
            {
                <pems-badge tone="danger">@Localizer["Overdue"]</pems-badge>
            }
        </pems-col>
        <pems-col md="3"><strong>Index Submitted:</strong> @(Model.IndexOfContentsSubmittedDate?.ToString("yyyy-MM-dd") ?? "-")</pems-col>
        <pems-col md="3"><strong>Hard Copy:</strong> @(Model.HardCopyShippedDate.HasValue ? $"Shipped {Model.HardCopyShippedDate:yyyy-MM-dd} ({Model.HardCopyCount} vol)" : "Not shipped")</pems-col>
        <pems-col md="3"><strong>Soft Copy:</strong> @(Model.SoftCopyDeliveredDate.HasValue ? $"Delivered {Model.SoftCopyDeliveredDate:yyyy-MM-dd}" : "Not delivered")</pems-col>
    </pems-row>

    <pems-flex wrap="true" gap="2" css="mt-3">
        @if (Model.IndexOfContentsSubmittedDate == null)
        {
            <form asp-action="MarkIndexSubmitted" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Index Submitted</pems-button></form>
        }
        @if (Model.Status != "FinalIssued" && Model.Status != "Delivered")
        {
            <form asp-action="MarkFinalIssued" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Final Issued</pems-button></form>
        }
        @if (!Model.HardCopyShippedDate.HasValue)
        {
            <form asp-action="MarkHardCopyShipped" method="post"><pems-flex gap="1">
                <input type="hidden" name="mdbId" value="@Model.MDBId" />
                <pems-input class="pems-w-90" scale="small" type="number" name="hardCopyCount" placeholder="# volumes" />
                <pems-button tone="primary" size="small" outline="true">Mark Hard Copy Shipped</pems-button>
            </pems-flex></form>
        }
        @if (!Model.SoftCopyDeliveredDate.HasValue)
        {
            <form asp-action="MarkSoftCopyDelivered" method="post"><input type="hidden" name="mdbId" value="@Model.MDBId" /><pems-button tone="primary" size="small" outline="true">Mark Soft Copy Delivered</pems-button></form>
        }
    </pems-flex>
</pems-content-card>

@{
    var parts = new[] {
        ("A", "Part A - Engineering Dossier", Model.DocumentsPartA),
        ("B", "Part B - Manufacturer's Inspection Data Book", Model.DocumentsPartB),
        ("C", "Part C - Installation / Startup / Commissioning / O&M Manual", Model.DocumentsPartC)
    };
}

@foreach (var (code, label, docs) in parts)
{
    <pems-content-card css="mb-3">
        <h6 class="mb-3">@label</h6>
        <pems-table kind="enterprise">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Document No"]</pems-table-header><pems-table-header>@Localizer["Title"]</pems-table-header><pems-table-header>DVD Volume</pems-table-header><pems-table-header>N/A</pems-table-header><pems-table-header>@Localizer["Notes"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var d in docs)
                {
                    <pems-table-row>
                        <pems-table-cell>@d.DocumentNo</pems-table-cell>
                        <pems-table-cell>@d.Title</pems-table-cell>
                        <pems-table-cell>@d.DvdVolumeNo</pems-table-cell>
                        <pems-table-cell>@(d.IsNotApplicable ? "Not applicable" : "")</pems-table-cell>
                        <pems-table-cell>@d.Notes</pems-table-cell>
                        <pems-table-cell>
                            <form asp-action="RemoveDocument" method="post">
                                <input type="hidden" name="mdbId" value="@Model.MDBId" />
                                <input type="hidden" name="mdbDocumentId" value="@d.MDBDocumentId" />
                                <pems-button tone="danger" size="small" outline="true"><pems-icon name="bi-trash" /></pems-button>
                            </form>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
        @if (!docs.Any())
        {
            <p class="text-muted small mb-2">No documents in this part yet.</p>
        }

        <form asp-action="AddDocument" method="post"><pems-row gap="2" css="mt-2">
            <input type="hidden" name="mdbId" value="@Model.MDBId" />
            <input type="hidden" name="part" value="@code" />
            <pems-col md="3">
                <pems-select scale="small" name="documentId">
                    <option value="">-- Link existing document (optional) --</option>
                    @foreach (var doc in documents)
                    {
                        <option value="@doc.DocumentId">@doc.DocumentNo - @doc.Title</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-input scale="small" name="title" placeholder="Title (if not linking a document)" /></pems-col>
            <pems-col md="2"><pems-input scale="small" name="dvdVolumeNo" type="number" placeholder="DVD Vol #" /></pems-col>
            <pems-col md="2" css="form-check d-flex align-items-center">
                <pems-input kind="check" css="me-1" type="checkbox" name="isNotApplicable" value="true" id="na_@code" />
                <label class="form-check-label small" for="na_@code">Not applicable</label>
            </pems-col>
            <pems-col md="2"><pems-button tone="primary" size="small" outline="true" css="w-100"><pems-icon name="bi-plus-lg" /> @Localizer["Add"]</pems-button></pems-col>
        </pems-row></form>
    </pems-content-card>
}
