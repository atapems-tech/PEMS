@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.AssetListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
    var q = (string?)ViewBag.SearchTerm;
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Active", "Standby", "Retired" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");

    string StatusText(string? s) => VdrUi.Loc(Localizer, "As_St_", s);
    string StatusTone(string? s) => s switch { "Active" => "vs-pill--success", "Standby" => "vs-pill--warning", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its search, status filter, counts (KPI row)
   and columns; "New asset" still opens the create modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["As_Title"]" total="@Model.TotalCount">
            <pems-list-search id="asSearchForm" action="@Url.Action("Index")" input-id="asQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["As_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="asSearchForm">
                <pems-list-filters form-id="asFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="asFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="asFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Eq_AllStatuses"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="asKpis" storage-key="pems.asset.kpis" />
                <pems-list-reset-columns grid-key="Asset" />
                <pems-list-new modal="createAssetModal" text="@Localizer["As_NewAsset"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="asKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@ViewBag.TotalCount</strong></span>
            <span class="vs-chip"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Eq_Active"] <strong>@ViewBag.ActiveCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Asset" empty="@(!Model.Items.Any())" empty-text="@Localizer["As_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="assetNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["As_ColNo"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="140" data-max-width="320" style="width:220px">@Localizer["Wo_ColEquipment"]</th>
                        <th data-col-key="maintClass" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px" class="vs-hide-md">@Localizer["As_ColMaint"]</th>
                        <th data-col-key="criticality" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Cm_Criticality"]</th>
                        <th data-col-key="commissioning" data-resizable="true" data-min-width="100" data-max-width="180" style="width:130px" class="vs-hide-md">@Localizer["As_ColCommissioning"]</th>
                        <th data-col-key="openWos" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["As_ColOpenWos"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Ed_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@a.AssetId" class="lp-subject" title="@a.AssetNumber">@a.AssetNumber</a></td>
                            <td class="small"><span class="vs-title-cell" title="@a.EquipmentTagNumber - @a.EquipmentName"><span class="vs-num">@a.EquipmentTagNumber</span> - @a.EquipmentName</span></td>
                            <td class="small vs-hide-md">@(a.MaintenanceClass ?? "-")</td>
                            <td class="small">@(a.CriticalityClass ?? "-")</td>
                            <td class="small vs-hide-md"><span class="vs-num">@(a.CommissioningDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td><span class="vs-num">@a.OpenWorkOrderCount</span></td>
                            <td><span class="vs-pill @StatusTone(a.Status)">@StatusText(a.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Asset",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createAssetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["As_NewAsset"]</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Tag number, manufacturer and model come from the Equipment record itself - pick the
                        equipment this Asset represents the CMMS lifecycle for.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Equipment"]</label>
                        <select name="equipmentId" class="form-select" required>
                            <option value="">@Localizer["-- select equipment --"]</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </select>
                        <div class="form-text">Equipment not listed here already has an Asset, or doesn't exist yet.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Asset Number"]</label>
                            <input name="assetNumber" class="form-control" placeholder="AST-P101" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Maintenance Class"]</label>
                            <input name="maintenanceClass" class="form-control" placeholder="Rotating, Static, Electrical ..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Functional Location"]</label>
                            <select name="functionalLocationId" class="form-select">
                                <option value="">@Localizer["-- not linked --"]</option>
                                @foreach (var fl in (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                                {
                                    <option value="@fl.FunctionalLocationId">@fl.PathBreadcrumb</option>
                                }
                            </select>
                            <div class="form-text">Real link to Functional Location. <a asp-controller="FunctionalLocation" asp-action="Index" target="_blank">@Localizer["Manage list"]</a></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Commissioning Date"]</label>
                            <input name="commissioningDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Functional Location (raw text, legacy)"]</label>
                        <input name="functionalLocation" class="form-control" placeholder="Unit-100 / Area-A" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Status"]</label>
                        <select name="status" class="form-select">
                            <option value="Active" selected>@Localizer["Active"]</option>
                            <option value="Standby">Standby</option>
                            <option value="Retired">Retired</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["Description"]</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
