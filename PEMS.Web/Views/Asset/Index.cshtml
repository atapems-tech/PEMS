@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.AssetListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
    var q = (string?)ViewBag.SearchTerm;
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Active", "Standby", "Retired" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");

    string StatusText(string? s) => VdrUi.Loc(Localizer, "As_St_", s);
    string StatusTone(string? s) => s switch { "Active" => "vs-pill--success", "Standby" => "vs-pill--warning", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component; the page keeps its search, status filter, counts (KPI row)
   and columns; "New asset" still opens the create modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["As_Title"]" total="@Model.TotalCount">
            <pems-list-search id="asSearchForm" action="@Url.Action("Index")" input-id="asQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["As_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="asSearchForm">
                <pems-list-filters form-id="asFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="asFilterStatus">@Localizer["Ed_Status"]</label>
                        <pems-select scale="small" id="asFilterStatus" name="status">
                            <option value="">@Localizer["Eq_AllStatuses"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </pems-select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="asKpis" storage-key="pems.asset.kpis" />
                <pems-list-reset-columns grid-key="Asset" />
                <pems-list-new modal="createAssetModal" text="@Localizer["As_NewAsset"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="asKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@ViewBag.TotalCount</strong></span>
            <span class="vs-chip"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Eq_Active"] <strong>@ViewBag.ActiveCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Asset" empty="@(!Model.Items.Any())" empty-text="@Localizer["As_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th class="pems-w-140" data-col-key="assetNo" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["As_ColNo"]</th>
                        <th class="pems-w-220" data-col-key="equipment" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["Wo_ColEquipment"]</th>
                        <th data-col-key="maintClass" data-resizable="true" data-min-width="100" data-max-width="220" class="vs-hide-md pems-w-150">@Localizer["As_ColMaint"]</th>
                        <th class="pems-w-110" data-col-key="criticality" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Cm_Criticality"]</th>
                        <th data-col-key="commissioning" data-resizable="true" data-min-width="100" data-max-width="180" class="vs-hide-md pems-w-130">@Localizer["As_ColCommissioning"]</th>
                        <th class="pems-w-100" data-col-key="openWos" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["As_ColOpenWos"]</th>
                        <th class="pems-w-110" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Ed_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@a.AssetId" class="lp-subject" title="@a.AssetNumber">@a.AssetNumber</a></td>
                            <td class="small"><span class="vs-title-cell" title="@a.EquipmentTagNumber - @a.EquipmentName"><span class="vs-num">@a.EquipmentTagNumber</span> - @a.EquipmentName</span></td>
                            <td class="small vs-hide-md">@(a.MaintenanceClass ?? "-")</td>
                            <td class="small">@(a.CriticalityClass ?? "-")</td>
                            <td class="small vs-hide-md"><span class="vs-num">@(a.CommissioningDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td><span class="vs-num">@a.OpenWorkOrderCount</span></td>
                            <td><span class="vs-pill @StatusTone(a.Status)">@StatusText(a.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Asset",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createAssetModal" tabindex="-1">
            <form asp-action="Create" method="post">
                <pems-modal-header>@Localizer["As_NewAsset"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">
                        Tag number, manufacturer and model come from the Equipment record itself - pick the
                        equipment this Asset represents the CMMS lifecycle for.
                    </p>
                    <div class="mb-3">
                        <pems-label>@Localizer["Equipment"]</pems-label>
                        <pems-select name="equipmentId" required>
                            <option value="">@Localizer["-- select equipment --"]</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </pems-select>
                        <pems-help-text>Equipment not listed here already has an Asset, or doesn't exist yet.</pems-help-text>
                    </div>

                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Asset Number"]</pems-label>
                            <pems-input name="assetNumber" placeholder="AST-P101" required />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Maintenance Class"]</pems-label>
                            <pems-input name="maintenanceClass" placeholder="Rotating, Static, Electrical ..." />
                        </pems-col>
                    </pems-row>

                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Functional Location"]</pems-label>
                            <pems-select name="functionalLocationId">
                                <option value="">@Localizer["-- not linked --"]</option>
                                @foreach (var fl in (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                                {
                                    <option value="@fl.FunctionalLocationId">@fl.PathBreadcrumb</option>
                                }
                            </pems-select>
                            <pems-help-text>Real link to Functional Location. <a asp-controller="FunctionalLocation" asp-action="Index" target="_blank">@Localizer["Manage list"]</a></pems-help-text>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Commissioning Date"]</pems-label>
                            <pems-date name="commissioningDate" />
                        </pems-col>
                    </pems-row>

                    <div class="mb-3">
                        <pems-label>@Localizer["Functional Location (raw text, legacy)"]</pems-label>
                        <pems-input name="functionalLocation" placeholder="Unit-100 / Area-A" />
                    </div>

                    <div class="mb-3">
                        <pems-label>@Localizer["Status"]</pems-label>
                        <pems-select name="status">
                            <option value="Active" selected>@Localizer["Active"]</option>
                            <option value="Standby">Standby</option>
                            <option value="Retired">Retired</option>
                        </pems-select>
                    </div>

                    <div class="mb-3">
                        <pems-label>@Localizer["Description"]</pems-label>
                        <pems-textarea name="description" rows="2"></pems-textarea>
                    </div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
