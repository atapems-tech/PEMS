@model PEMS.Application.DTOs.AssetDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">@Model.AssetNumber</h5>
            <span class="text-muted small">@Model.EquipmentTagNumber - @Model.EquipmentName</span>
        </div>
        <pems-flex gap="2">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-box-arrow-up-right" /> @Localizer["Equipment"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-left" /> Back</pems-button>
        </pems-flex>
    </pems-flex>
</pems-content-card>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-row gap="3" css="mb-3">
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Status"]">@Model.Status</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Criticality"]">@Model.CriticalityClass</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="Open Work Orders">@Model.WorkOrders.Count(w => w.Status != "Completed" && w.Status != "Closed")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="Total Cost">@Model.TotalCost.ToString("N0")</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Asset Info</h6>
            <pems-table scale="small">
                <pems-table-row><pems-table-header class="text-muted pems-w-40pct">@Localizer["Manufacturer / Model"]</pems-table-header><pems-table-cell>@Model.Manufacturer / @Model.Model</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Functional Location"]</pems-table-header><pems-table-cell>@(Model.FunctionalLocationBreadcrumb ?? "not linked")</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Functional Location (raw text, legacy)"]</pems-table-header><pems-table-cell>@(Model.FunctionalLocation ?? "N/A")</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Maintenance Class"]</pems-table-header><pems-table-cell>@(Model.MaintenanceClass ?? "N/A")</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Commissioning Date"]</pems-table-header><pems-table-cell>@(Model.CommissioningDate?.ToString("yyyy-MM-dd") ?? "N/A")</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Risk Level"]</pems-table-header><pems-table-cell>@(Model.RiskLevel ?? "N/A")</pems-table-cell></pems-table-row>
                <pems-table-row><pems-table-header class="text-muted">@Localizer["Description"]</pems-table-header><pems-table-cell>@(Model.Description ?? "N/A")</pems-table-cell></pems-table-row>
            </pems-table>
            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#editAssetModal"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</pems-button>
        </pems-content-card>

        <pems-content-card>
            <h6 class="mb-3">@Localizer["Latest Maintenance"]</h6>
            @if (Model.LatestMaintenance != null)
            {
                <pems-table scale="small">
                    <pems-table-row><pems-table-header class="text-muted pems-w-40pct">@Localizer["Execution Date"]</pems-table-header><pems-table-cell>@Model.LatestMaintenance.ExecutionDate.ToString("yyyy-MM-dd")</pems-table-cell></pems-table-row>
                    <pems-table-row><pems-table-header class="text-muted">@Localizer["Action Taken"]</pems-table-header><pems-table-cell>@(Model.LatestMaintenance.ActionTaken ?? "N/A")</pems-table-cell></pems-table-row>
                    <pems-table-row><pems-table-header class="text-muted">@Localizer["Technician"]</pems-table-header><pems-table-cell>@(Model.LatestMaintenance.Technician ?? "N/A")</pems-table-cell></pems-table-row>
                    <pems-table-row><pems-table-header class="text-muted">Duration (h)</pems-table-header><pems-table-cell>@(Model.LatestMaintenance.DurationHours?.ToString("N1") ?? "N/A")</pems-table-cell></pems-table-row>
                </pems-table>
            }
            else
            {
                <p class="text-muted small mb-0">No completed maintenance recorded yet - populated automatically when a Work Order on this equipment is marked Completed.</p>
            }
        </pems-content-card>
    </pems-col>

    <pems-col md="6">
        <pems-content-card css="mb-3">
            <h6 class="mb-3">Work Orders (@Model.WorkOrders.Count)</h6>
            @if (Model.WorkOrders.Any())
            {
                <pems-table scale="small">
                    <pems-table-head><pems-table-row><pems-table-header>No.</pems-table-header><pems-table-header>@Localizer["Description"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Created"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var w in Model.WorkOrders.Take(10))
                        {
                            <pems-table-row>
                                <pems-table-cell><a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNo</a></pems-table-cell>
                                <pems-table-cell class="small">@(w.Description ?? "-")</pems-table-cell>
                                <pems-table-cell><pems-badge tone="neutral">@w.Status</pems-badge></pems-table-cell>
                                <pems-table-cell class="small">@(w.CreatedDate?.ToString("yyyy-MM-dd") ?? "-")</pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted small mb-0">@Localizer["No work orders yet."]</p>
            }
        </pems-content-card>

        <pems-content-card css="mb-3">
            <h6 class="mb-3">Inspections (@Model.Inspections.Count)</h6>
            @if (Model.Inspections.Any())
            {
                <pems-data-table data="@(DataRows.Of(Model.Inspections.Take(10), c_ => c_.Add(((Localizer["Type"])?.ToString() ?? ""), i => (object?)(i.InspectionType)).Add(((Localizer["Date"])?.ToString() ?? ""), i => (object?)(i.InspectionDate?.ToString("yyyy-MM-dd") ?? "-"), css: "small").Add(((Localizer["Inspector"])?.ToString() ?? ""), i => (object?)(i.Inspector ?? "-"), css: "small").Add(((Localizer["Result"])?.ToString() ?? ""), i => (object?)(i.Result ?? "-"))))" enterprise="false" dense="true" />
            }
            else
            {
                <p class="text-muted small mb-0">No inspections recorded yet.</p>
            }
        </pems-content-card>

        <pems-content-card>
            <h6 class="mb-3">Failures (@Model.Failures.Count)</h6>
            @if (Model.Failures.Any())
            {
                <pems-data-table data="@(DataRows.Of(Model.Failures.Take(10), c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), f => (object?)(f.FailureDate.ToString("yyyy-MM-dd")), css: "small").Add(((Localizer["Mode"])?.ToString() ?? ""), f => (object?)(f.FailureMode)).Add(((Localizer["Cause"])?.ToString() ?? ""), f => (object?)(f.FailureCause ?? "-"), css: "small").Add("Downtime (h)", f => (object?)(f.DowntimeHours?.ToString("N1") ?? "-"))))" enterprise="false" dense="true" />
            }
            else
            {
                <p class="text-muted small mb-0">No failures recorded yet - populated automatically when a Corrective/Emergency Work Order on this equipment is marked Completed.</p>
            }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-modal id="editAssetModal" tabindex="-1">
            <pems-form asp-action="Edit" method="post">
                <input type="hidden" name="assetId" value="@Model.AssetId" />
                <pems-modal-header>Edit Asset</pems-modal-header>
                <pems-modal-body>
                    <div class="mb-3">
                        <pems-label>@Localizer["Asset Number"]</pems-label>
                        <pems-input name="assetNumber" value="@Model.AssetNumber" required />
                    </div>
                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Functional Location"]</pems-label>
                            <pems-select name="functionalLocationId">
                                <option value="">@Localizer["-- not linked --"]</option>
                                @foreach (var fl in (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations)
                                {
                                    <option value="@fl.FunctionalLocationId" selected="@(fl.FunctionalLocationId == Model.FunctionalLocationId)">@fl.PathBreadcrumb</option>
                                }
                            </pems-select>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Maintenance Class"]</pems-label>
                            <pems-input name="maintenanceClass" value="@Model.MaintenanceClass" />
                        </pems-col>
                    </pems-row>
                    <div class="mb-3">
                        <pems-label>@Localizer["Functional Location (raw text, legacy)"]</pems-label>
                        <pems-input name="functionalLocation" value="@Model.FunctionalLocation" />
                    </div>
                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Commissioning Date"]</pems-label>
                            <pems-date name="commissioningDate" value="@Model.CommissioningDate?.ToString("yyyy-MM-dd")" />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Status"]</pems-label>
                            <pems-select name="status">
                                @foreach (var s in new[] { "Active", "Standby", "Retired" })
                                {
                                    <option value="@s" selected="@(s == Model.Status)">@s</option>
                                }
                            </pems-select>
                        </pems-col>
                    </pems-row>
                    <div class="mb-3">
                        <pems-label>@Localizer["Description"]</pems-label>
                        <pems-textarea name="description" rows="2">@Model.Description</pems-textarea>
                    </div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>
