@model List<PEMS.Application.DTOs.EquipmentFunctionalLocationAssignmentBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusText(string? s) => VdrUi.Loc(Localizer, "Fla_St_", s);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2b: built from the PEMS.UI list-page component. The page lists the recent assignment batches; the Excel
   upload (with its rules) opens from the toolbar's Upload button (<pems-list-popover>), and each batch opens its review page. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Fla_Title"]" heading-title="@Localizer["Fla_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <a class="lp-icon-btn" asp-controller="Equipment" asp-action="Index" title="@Localizer["Fla_Equipment"]" aria-label="@Localizer["Fla_Equipment"]"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i></a>
                <pems-list-popover id="flaUpload" icon="bi-cloud-upload" label="@Localizer["Fla_Upload"]" primary="true">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        <p class="text-muted small mb-2">@Localizer["Fla_UploadRules"]</p>
                        <label class="lp-lbl" for="assignmentFile">@Localizer["Fla_FileLabel"]</label>
                        <input type="file" id="assignmentFile" name="file" class="form-control" accept=".xlsx" required />
                        <div class="lp-fp-foot px-0 pb-0">
                            <pems-button tone="primary" size="small" type="submit"><i class="bi bi-cloud-upload" aria-hidden="true"></i> @Localizer["Upload"]</pems-button>
                        </div>
                    </form>
                </pems-list-popover>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(!Model.Any())" empty-text="@Localizer["Fla_Empty"]">
                <thead>
                    <tr>
                        <th>@Localizer["Fla_File"]</th>
                        <th style="width:140px">@Localizer["Fla_Date"]</th>
                        <th class="vs-hide-md">@Localizer["Fla_ImportedBy"]</th>
                        <th class="text-end" style="width:80px">@Localizer["Fla_Total"]</th>
                        <th class="text-end" style="width:80px">@Localizer["Fla_Exact"]</th>
                        <th class="text-end" style="width:110px">@Localizer["Fla_AlreadyAssigned"]</th>
                        <th class="text-end" style="width:100px">@Localizer["Fla_Unresolved"]</th>
                        <th class="text-end" style="width:90px">@Localizer["Fla_Conflicts"]</th>
                        <th style="width:110px">@Localizer["Ed_Status"]</th>
                        <th style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr class="lp-row">
                            <td><a asp-action="Review" asp-route-batchId="@b.EquipmentFunctionalLocationAssignmentBatchId" class="lp-subject"><span class="vs-title-cell" title="@b.FileName">@b.FileName</span></a></td>
                            <td class="small"><span class="vs-num">@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</span></td>
                            <td class="small vs-hide-md">@b.ImportedByName</td>
                            <td class="text-end"><span class="vs-num">@b.TotalRows</span></td>
                            <td class="text-end"><span class="vs-pill vs-pill--success">@b.ExactCount</span></td>
                            <td class="text-end">@if (b.AlreadyAssignedCount > 0) { <span class="vs-pill vs-pill--warning">@b.AlreadyAssignedCount</span> } else { <span class="vs-num">0</span> }</td>
                            <td class="text-end">@if (b.UnresolvedCount > 0) { <span class="vs-pill vs-pill--danger">@b.UnresolvedCount</span> } else { <span class="vs-num">0</span> }</td>
                            <td class="text-end">@if (b.ConflictCount > 0) { <span class="vs-pill vs-pill--danger">@b.ConflictCount</span> } else { <span class="vs-num">0</span> }</td>
                            <td><span class="vs-pill @(b.Status == "Committed" ? "vs-pill--success" : "vs-pill--neutral")">@StatusText(b.Status)</span></td>
                            <td class="text-end">
                                <a asp-action="Review" asp-route-batchId="@b.EquipmentFunctionalLocationAssignmentBatchId" class="lp-act lp-act--always" title="@Localizer["Fla_Review"]" aria-label="@Localizer["Fla_Review"]"><i class="bi bi-list-check" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
