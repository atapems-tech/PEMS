@model List<PEMS.Application.DTOs.EquipmentFunctionalLocationAssignmentBatchSummaryDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-signpost-split"></i> Equipment ↔ Functional Location Assignment</h5>
    <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary btn-sm">← Equipment</a>
</div>

<div class="content-card mb-3">
    <p class="text-muted small">
        Upload an Excel file with <strong>Equipment Tag</strong> / <strong>Functional Location Code</strong>
        columns (optional <strong>Plant</strong>/<strong>Area</strong>/<strong>Unit</strong> columns are used
        only to cross-check the resolved Functional Location). Only exact Tag/Code matches are resolved -
        nothing is written to the live Equipment table until you review the proposed assignments and click
        Commit. Equipment that already has a different Functional Location is never silently overwritten -
        replacing an existing assignment always requires an explicit, separate confirmation on the review page.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label small">Assignment Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-pems-solid w-100"><i class="bi bi-cloud-upload"></i> Upload</button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">Recent Assignment Batches</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead>
            <tr>
                <th>File</th><th>Date</th><th>Imported By</th><th class="text-end">Total</th>
                <th class="text-end">Exact</th><th class="text-end">Already Assigned</th>
                <th class="text-end">Unresolved</th><th class="text-end">Conflicts</th>
                <th>Status</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@b.ImportedByName</td>
                    <td class="text-end">@b.TotalRows</td>
                    <td class="text-end"><span class="badge bg-success">@b.ExactCount</span></td>
                    <td class="text-end">@if (b.AlreadyAssignedCount > 0) { <span class="badge bg-warning text-dark">@b.AlreadyAssignedCount</span> } else { @b.AlreadyAssignedCount }</td>
                    <td class="text-end">@if (b.UnresolvedCount > 0) { <span class="badge bg-danger">@b.UnresolvedCount</span> } else { @b.UnresolvedCount }</td>
                    <td class="text-end">@if (b.ConflictCount > 0) { <span class="badge bg-danger">@b.ConflictCount</span> } else { @b.ConflictCount }</td>
                    <td><span class="badge @(b.Status == "Committed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                    <td>
                        <a asp-action="Review" asp-route-batchId="@b.EquipmentFunctionalLocationAssignmentBatchId" class="btn btn-sm btn-outline-primary">Review</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No Equipment ↔ Functional Location assignment batches yet.</p> }
</div>
