@model PEMS.Domain.Entities.Instrument
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["Title"] = "Edit Instrument - " + Model.Equipment?.TagNumber; }

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.Equipment?.TagNumber <span class="text-muted small">(@Model.Equipment?.Manufacturer / @Model.Equipment?.Model)</span></h5>
            <span class="text-muted small">Tag, manufacturer, model and description are edited on the Equipment record - <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">open Equipment</a>.</span>
        </div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Passport" asp-route-id="@Model.InstrumentId"><i class="bi bi-card-text"></i> @Localizer["Passport"]</pems-button>
    </div>
</div>

<div class="content-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />

        <h6 class="mb-2">General</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><label class="form-label">@Localizer["Instrument Type"]</label><pems-input name="InstrumentType" value="@Model.InstrumentType" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Loop Number"]</label><pems-input name="LoopNumber" value="@Model.LoopNumber" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["System"]</label><pems-input name="System" value="@Model.System" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Signal Class"]</label><pems-input name="SignalClass" value="@Model.SignalClass" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Current Status"]</label>
                <pems-select name="CurrentStatus">
                    @foreach (var s in new[] { "InService", "OutOfService", "UnderCalibration", "UnderMaintenance", "Decommissioned" })
                    {
                        <option value="@s" selected="@(s == Model.CurrentStatus)">@s</option>
                    }
                </pems-select>
            </div>
        </div>

        <h6 class="mb-2">Process / Signal</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><label class="form-label">@Localizer["Process Variable"]</label><pems-input name="ProcessVariable" value="@Model.ProcessVariable" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Accuracy"]</label><pems-input name="Accuracy" value="@Model.Accuracy" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Range Min"]</label><pems-input name="RangeMin" type="number" step="0.01" value="@Model.RangeMin" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Range Max"]</label><pems-input name="RangeMax" type="number" step="0.01" value="@Model.RangeMax" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Unit"]</label><pems-input name="Unit" value="@Model.Unit" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Output Signal"]</label><pems-input name="OutputSignal" value="@Model.OutputSignal" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Power Supply"]</label><pems-input name="PowerSupply" value="@Model.PowerSupply" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Communication"]</label><pems-input name="Communication" value="@Model.Communication" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["IP Rating"]</label><pems-input name="IPRating" value="@Model.IPRating" /></div>
            <div class="col-md-3"><label class="form-label">Process Connection</label><pems-input name="ProcessConnection" value="@Model.ProcessConnection" /></div>
            <div class="col-md-3"><label class="form-label">Electrical Connection</label><pems-input name="ElectricalConnection" value="@Model.ElectricalConnection" /></div>
        </div>

        <h6 class="mb-2">Hazardous Area / Safety</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><label class="form-label">@Localizer["Hazardous Area"]</label><pems-input name="HazardousArea" value="@Model.HazardousArea" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Ex Protection"]</label><pems-input name="ExProtection" value="@Model.ExProtection" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Zone"]</label><pems-input name="Zone" value="@Model.Zone" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Gas Group"]</label><pems-input name="GasGroup" value="@Model.GasGroup" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Temp Class"]</label><pems-input name="TempClass" value="@Model.TempClass" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Fail Action"]</label><pems-input name="FailAction" value="@Model.FailAction" /></div>
            <div class="col-md-3"><label class="form-label">Alarm Setpoint</label><pems-input name="AlarmSetpoint" type="number" step="0.01" value="@Model.AlarmSetpoint" /></div>
            <div class="col-md-3"><label class="form-label">Trip Setpoint</label><pems-input name="TripSetpoint" type="number" step="0.01" value="@Model.TripSetpoint" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["SIL"]</label><pems-input name="SIL" value="@Model.SIL" /></div>
        </div>

        <h6 class="mb-2">Wiring / Location</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-3"><label class="form-label">@Localizer["Junction Box"]</label><pems-input name="JunctionBox" value="@Model.JunctionBox" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Marshalling Cabinet"]</label><pems-input name="MarshallingCabinet" value="@Model.MarshallingCabinet" /></div>
            <div class="col-md-3"><label class="form-label">Cable Number</label><pems-input name="CableNumber" value="@Model.CableNumber" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Barrier / Relay"]</label><pems-input name="BarrierRelay" value="@Model.BarrierRelay" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["I/O Card / Channel"]</label><pems-input name="IOCardChannel" value="@Model.IOCardChannel" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["System Cabinet"]</label><pems-input name="SystemCabinet" value="@Model.SystemCabinet" /></div>
        </div>

        <h6 class="mb-2">Calibration</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label">@Localizer["Calibration Interval (days)"]</label><pems-input name="CalibrationInterval" type="number" value="@Model.CalibrationInterval" /></div>
        </div>

        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
        <pems-button tone="neutral" outline="true" as="a" asp-action="Passport" asp-route-id="@Model.InstrumentId">Cancel</pems-button>
    </form>
</div>
