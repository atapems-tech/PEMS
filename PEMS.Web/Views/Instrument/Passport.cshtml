@model PEMS.Domain.Entities.Instrument
@using PEMS.Domain.Entities
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Passport - " + Model.Equipment?.TagNumber;
    var status = (string)ViewBag.CalibrationStatus;
    var badgeClass = status switch { "Overdue" => "danger", "DueSoon" => "warning", "OK" => "success", _ => "neutral" };
    var latestCal = (CalibrationHistory?)ViewBag.LatestCalibration;
    var latestMaint = (MaintenanceHistory?)ViewBag.LatestMaintenance;
    string NA(string? v) => string.IsNullOrWhiteSpace(v) ? "N/A" : v;
}

<pems-content-card css="mb-3 d-print-none">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h4 class="mb-0">@Model.Equipment?.TagNumber <pems-badge tone="@badgeClass" css="ms-1">@status</pems-badge></h4>
            <span class="text-muted small">@Model.InstrumentType - @Model.Equipment?.Name (@NA(Model.Equipment?.Manufacturer) / @NA(Model.Equipment?.Model))</span>
        </div>
        <pems-flex gap="2">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Edit" asp-route-id="@Model.InstrumentId"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" onclick="window.print()"><pems-icon name="bi-printer" /> Print</pems-button>
            <form asp-action="GenerateCalibrationWorkOrder" method="post" class="d-inline">
                <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />
                <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-clipboard-plus" /> Generate WO</pems-button>
            </form>
        </pems-flex>
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Passport"]</h6>
    <pems-row gap="2" css="small">
        <pems-col md="3"><strong>@Localizer["Loop No."]</strong><div>@NA(Model.LoopNumber)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["System"]</strong><div>@NA(Model.System)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Signal Class"]</strong><div>@NA(Model.SignalClass)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Manufacturer / Model"]</strong><div>@NA(Model.Equipment?.Manufacturer) / @NA(Model.Equipment?.Model)</div></pems-col>

        <pems-col md="3"><strong>@Localizer["Process Variable"]</strong><div>@NA(Model.ProcessVariable)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Range"]</strong><div>@(Model.RangeMin?.ToString() ?? "N/A") - @(Model.RangeMax?.ToString() ?? "N/A") @Model.Unit</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Accuracy"]</strong><div>@NA(Model.Accuracy)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Output Signal"]</strong><div>@NA(Model.OutputSignal)</div></pems-col>

        <pems-col md="3"><strong>@Localizer["Power Supply"]</strong><div>@NA(Model.PowerSupply)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Communication"]</strong><div>@NA(Model.Communication)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["IP Rating"]</strong><div>@NA(Model.IPRating)</div></pems-col>
        <pems-col md="3"><strong>Process / Electrical Connection</strong><div>@NA(Model.ProcessConnection) / @NA(Model.ElectricalConnection)</div></pems-col>

        <pems-col md="3"><strong>@Localizer["Hazardous Area"]</strong><div>@NA(Model.HazardousArea)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Ex Protection"]</strong><div>@NA(Model.ExProtection)</div></pems-col>
        <pems-col md="2"><strong>@Localizer["Zone"]</strong><div>@NA(Model.Zone)</div></pems-col>
        <pems-col md="2"><strong>@Localizer["Gas Group"]</strong><div>@NA(Model.GasGroup)</div></pems-col>
        <pems-col md="2"><strong>@Localizer["Temp Class"]</strong><div>@NA(Model.TempClass)</div></pems-col>

        <pems-col md="3"><strong>@Localizer["Fail Action"]</strong><div>@NA(Model.FailAction)</div></pems-col>
        <pems-col md="3"><strong>Alarm / Trip Setpoint</strong><div>@(Model.AlarmSetpoint?.ToString() ?? "N/A") / @(Model.TripSetpoint?.ToString() ?? "N/A")</div></pems-col>
        <pems-col md="3"><strong>@Localizer["SIL"]</strong><div>@NA(Model.SIL)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Current Status"]</strong><div>@Model.CurrentStatus</div></pems-col>

        <pems-col md="3"><strong>@Localizer["Junction Box"]</strong><div>@NA(Model.JunctionBox)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Marshalling Cabinet"]</strong><div>@NA(Model.MarshallingCabinet)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Cable No."]</strong><div>@NA(Model.CableNumber)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Barrier / Relay"]</strong><div>@NA(Model.BarrierRelay)</div></pems-col>

        <pems-col md="3"><strong>@Localizer["I/O Card / Channel"]</strong><div>@NA(Model.IOCardChannel)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["System Cabinet"]</strong><div>@NA(Model.SystemCabinet)</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Calibration Interval"]</strong><div>@(Model.CalibrationInterval.HasValue ? Model.CalibrationInterval + " days" : "N/A")</div></pems-col>
    </pems-row>
    @if (!string.IsNullOrWhiteSpace(Model.Equipment?.Description))
    {
        <div class="mt-2 small"><strong>@Localizer["Description"]</strong><div>@Model.Equipment.Description</div></div>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="6">
            <h6>Latest Calibration</h6>
            @if (latestCal != null)
            {
                <div class="small">
                    <div>Date: @latestCal.CalibrationDate.ToString("yyyy-MM-dd") - @latestCal.CalibrationType - Result: @latestCal.Result</div>
                    <div>As Found / As Left: @NA(latestCal.AsFound) / @NA(latestCal.AsLeft)</div>
                    <div>Technician: @(latestCal.Technician != null ? latestCal.Technician.FirstName + " " + latestCal.Technician.LastName : "N/A") - Certificate: @NA(latestCal.CertificateNo)</div>
                    <div>Next Due: @(latestCal.NextDue?.ToString("yyyy-MM-dd") ?? "N/A")</div>
                </div>
            }
            else
            {
                <p class="text-muted small">No calibration recorded yet.</p>
            }
        </pems-col>
        <pems-col md="6">
            <h6>@Localizer["Latest Maintenance"]</h6>
            @if (latestMaint != null)
            {
                <div class="small">
                    <div>Date: @latestMaint.ExecutionDate.ToString("yyyy-MM-dd")</div>
                    <div>Finding: @NA(latestMaint.Finding)</div>
                    <div>Action: @NA(latestMaint.ActionTaken)</div>
                </div>
            }
            else
            {
                <p class="text-muted small">No maintenance history for this equipment yet.</p>
            }
        </pems-col>
    </pems-row>
</pems-content-card>

<pems-content-card css="d-print-none">
    <h6>Record New Calibration</h6>
    <form asp-action="AddCalibration" method="post"><pems-row gap="2" css="align-items-end mb-4">
        <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />
        <pems-col md="2"><pems-label css="small">@Localizer["Date"]</pems-label><pems-date name="calibrationDate" scale="small" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></pems-col>
        <pems-col md="2"><pems-label css="small">@Localizer["Type"]</pems-label>
            <pems-select scale="small" name="calibrationType">
                <option>Routine</option><option>PostRepair</option><option>PreCommissioning</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-label css="small">As Found</pems-label><pems-input scale="small" name="asFound" /></pems-col>
        <pems-col md="2"><pems-label css="small">As Left</pems-label><pems-input scale="small" name="asLeft" /></pems-col>
        <pems-col md="2"><pems-label css="small">@Localizer["Result"]</pems-label>
            <pems-select scale="small" name="result">
                <option>Pass</option><option>Fail</option><option>Adjusted</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-label css="small">Certificate No.</pems-label><pems-input scale="small" name="certificateNo" /></pems-col>
        <pems-col md="4"><pems-label css="small">Standard Reference</pems-label><pems-input scale="small" name="standardReference" /></pems-col>
        <pems-col md="4"><pems-label css="small">@Localizer["Remarks"]</pems-label><pems-input scale="small" name="remarks" /></pems-col>
        <pems-col md="4"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-plus-lg" /> Record Calibration</pems-button></pems-col>
    </pems-row></form>

    <h6>Calibration History</h6>
    <div class="table-scroll-area pems-s-f7dce87f">
        <pems-data-table data="@(DataRows.Of((List<CalibrationHistory>)ViewBag.CalibrationHistoryList, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), c => (object?)(c.CalibrationDate.ToString("yyyy-MM-dd"))).Add(((Localizer["Type"])?.ToString() ?? ""), c => (object?)(c.CalibrationType)).Add("As Found / As Left", c => DataCell.Join((NA(c.AsFound)), " / ", (NA(c.AsLeft)))).Add(((Localizer["Result"])?.ToString() ?? ""), c => (object?)(c.Result)).Add(((Localizer["Technician"])?.ToString() ?? ""), c => (object?)(c.Technician != null ? c.Technician.FirstName + " " + c.Technician.LastName : "N/A")).Add("Certificate", c => (object?)(NA(c.CertificateNo))).Add(((Localizer["Next Due"])?.ToString() ?? ""), c => (object?)(c.NextDue?.ToString("yyyy-MM-dd") ?? "N/A"))))" dense="true" />
    </div>
</pems-content-card>

@{
    var alarms = (List<Alarm>)ViewBag.Alarms;
    var causeEffectsByAlarm = (Dictionary<int, List<CauseEffect>>)ViewBag.CauseEffectsByAlarm;
    var controlLoop = (ControlLoop?)ViewBag.ControlLoop;
    var ioPoints = (List<IOPoint>)ViewBag.IOPoints;
}

@* ===================== I&C Integration (CMMS-09) ===================== *@
<pems-content-card css="mb-3 d-print-none">
    <h6>Record New Alarm</h6>
    <form asp-action="AddAlarm" method="post"><pems-row gap="2" css="align-items-end mb-3">
        <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />
        <pems-col md="2"><pems-label css="small">Alarm Tag</pems-label><pems-input scale="small" name="alarmTag" required /></pems-col>
        <pems-col md="2"><pems-label css="small">@Localizer["Type"]</pems-label>
            <pems-select scale="small" name="alarmType">
                <option>@Localizer["High"]</option><option>@Localizer["Low"]</option><option>HighHigh</option><option>LowLow</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-label css="small">@Localizer["Priority"]</pems-label>
            <pems-select scale="small" name="priority">
                <option>@Localizer["Low"]</option><option>@Localizer["Medium"]</option><option>@Localizer["High"]</option><option>@Localizer["Critical"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="2"><pems-label css="small">Set Point</pems-label><pems-input scale="small" name="setPoint" type="number" step="0.001" /></pems-col>
        <pems-col md="1"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" name="unit" /></pems-col>
        <pems-col md="3"><pems-label css="small">@Localizer["Action"]</pems-label><pems-input scale="small" name="action" /></pems-col>
        <pems-col md="6"><pems-label css="small">@Localizer["Description"]</pems-label><pems-input scale="small" name="description" /></pems-col>
        <pems-col md="3"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-plus-lg" /> Add Alarm</pems-button></pems-col>
    </pems-row></form>

    <h6>Alarms &amp; Cause / Effect</h6>
    @if (!alarms.Any())
    {
        <p class="text-muted small">هنوز هیچ آلارمی برای این Instrument ثبت نشده.</p>
    }
    @foreach (var alarm in alarms)
    {
        var alarmBadge = alarm.Priority switch { "Critical" => "danger", "High" => "warning", _ => "neutral" };
        var ces = causeEffectsByAlarm.TryGetValue(alarm.AlarmId, out var list) ? list : new List<CauseEffect>();

        <div class="border rounded p-2 mb-3">
            <pems-flex justify="between" align="center">
                <div class="small">
                    <strong>@alarm.AlarmTag</strong> - @alarm.AlarmType
                    <pems-badge tone="@alarmBadge">@alarm.Priority</pems-badge>
                    - SP: @(alarm.SetPoint?.ToString() ?? "N/A") @alarm.Unit
                </div>
            </pems-flex>
            @if (!string.IsNullOrWhiteSpace(alarm.Description)) { <div class="small text-muted">@alarm.Description</div> }

            <pems-table kind="enterprise" scale="small" css="mt-2 mb-2">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Cause"]</pems-table-header><pems-table-header>@Localizer["Effect"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header><pems-table-header>@Localizer["Trip Signal"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var ce in ces)
                    {
                        <pems-table-row>
                            <pems-table-cell class="small">@ce.Cause</pems-table-cell>
                            <pems-table-cell class="small">@ce.Effect</pems-table-cell>
                            <pems-table-cell class="small">@(ce.ActionType ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(ce.TripSignal ?? "-")</pems-table-cell>
                            <pems-table-cell>
                                <form asp-action="RaiseWorkRequestFromCauseEffect" method="post" class="d-inline">
                                    <input type="hidden" name="causeEffectId" value="@ce.CauseEffectId" />
                                    <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-exclamation-triangle" /> Raise Work Request</pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>

            <form asp-action="AddCauseEffect" method="post"><pems-row gap="2" css="align-items-end d-print-none">
                <input type="hidden" name="alarmId" value="@alarm.AlarmId" />
                <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />
                <pems-col md="2"><pems-input scale="small" name="cause" placeholder="@Localizer["Cause"]" required /></pems-col>
                <pems-col md="2"><pems-input scale="small" name="effect" placeholder="@Localizer["Effect"]" required /></pems-col>
                <pems-col md="2">
                    <pems-select scale="small" name="actionType">
                        <option value="">Action --</option>
                        <option>Trip</option><option>Shutdown</option><option>Alarm</option><option>@Localizer["Start"]</option><option>Stop</option>
                    </pems-select>
                </pems-col>
                <pems-col md="2"><pems-input scale="small" name="tripSignal" placeholder="@Localizer["Trip Signal"]" /></pems-col>
                <pems-col md="2"><pems-input scale="small" name="description" placeholder="@Localizer["Description"]" /></pems-col>
                <pems-col md="2"><pems-button tone="primary" size="small" outline="true" css="w-100" type="submit">+ C&amp;E</pems-button></pems-col>
            </pems-row></form>
        </div>
    }
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <h6>Control Loop</h6>
            @if (controlLoop != null)
            {
                <div class="small">
                    <div><strong>@controlLoop.LoopNumber</strong> - @NA(controlLoop.ControllerType)</div>
                    <div>System: @NA(controlLoop.ControllerSystem) - Area: @NA(controlLoop.ProcessArea)</div>
                    @if (!string.IsNullOrWhiteSpace(controlLoop.Description)) { <div class="text-muted">@controlLoop.Description</div> }
                </div>
            }
            else
            {
                <p class="text-muted small">این Instrument به هیچ Control Loop ای وصل نیست.</p>
                <form asp-action="AssignControlLoop" method="post"><pems-row gap="2" css="align-items-end d-print-none">
                    <input type="hidden" name="instrumentId" value="@Model.InstrumentId" />
                    <pems-col md="6"><pems-input scale="small" name="loopNumber" placeholder="@Localizer["Loop Number"]" required /></pems-col>
                    <pems-col md="6">
                        <pems-select scale="small" name="controllerType">
                            <option value="">Controller Type --</option>
                            <option>PID</option><option>ON/OFF</option><option>Cascade</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="6"><pems-input scale="small" name="controllerSystem" placeholder="DCS/PLC Name" /></pems-col>
                    <pems-col md="6"><pems-input scale="small" name="processArea" placeholder="Process Area" /></pems-col>
                    <pems-col md="12"><pems-input scale="small" name="description" placeholder="@Localizer["Description"]" /></pems-col>
                    <pems-col md="12"><pems-button tone="primary" size="small" css="w-100" type="submit">Assign Loop</pems-button></pems-col>
                </pems-row></form>
            }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100">
            <h6>I/O Points</h6>
            <pems-data-table data="@(DataRows.Of(ioPoints, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), io => (object?)(io.TagNumber), css: "small").Add(((Localizer["Type"])?.ToString() ?? ""), io => (object?)(io.IOType), css: "small").Add("PLC / Rack / Slot / Channel", io => DataCell.Join((NA(io.PLCName)), " / ", (NA(io.Rack)), " / ", (NA(io.Slot)), " / ", (NA(io.Channel))), css: "small")))" dense="true" css="mb-0" />
            @if (!ioPoints.Any()) { <p class="text-muted small mb-0">هیچ I/O Point ای ثبت نشده (معمولاً از طریق AI Import پر می‌شود).</p> }
        </pems-content-card>
    </pems-col>
</pems-row>
