@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InstrumentListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
    var q = (string?)ViewBag.SearchTerm;
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Overdue", "DueSoon", "OK", "Unknown" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");

    string StatusText(string? s) => VdrUi.Loc(Localizer, "In_St_", s);
    string StatusTone(string? s) => s switch { "Overdue" => "vs-pill--danger", "DueSoon" => "vs-pill--warning", "OK" => "vs-pill--success", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The count cards became the KPI row, export and "New
   instrument" moved into the toolbar; the page keeps its search, calibration-status filter and columns. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["In_Title"]" total="@Model.TotalCount">
            <pems-list-search id="inSearchForm" action="@Url.Action("Index")" input-id="inQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["In_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="inSearchForm">
                <pems-list-filters form-id="inFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="inFilterStatus">@Localizer["In_CalStatus"]</label>
                        <select id="inFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="inKpis" storage-key="pems.instrument.kpis" />
                <pems-list-export href="@Url.Action("Export")" label="@Localizer["In_ExportAll"]" />
                <pems-list-reset-columns grid-key="Instrument" />
                <pems-list-new modal="createInstrumentModal" text="@Localizer["In_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="inKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@ViewBag.TotalCount</strong></span>
            <span class="vs-chip @(((int?)ViewBag.OverdueCount ?? 0) > 0 ? "vs-chip--danger" : "")"><i class="bi bi-clock-history" aria-hidden="true"></i> @Localizer["Overdue"] <strong>@ViewBag.OverdueCount</strong></span>
            <span class="vs-chip"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @Localizer["In_DueSoon30"] <strong>@ViewBag.DueSoonCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["In_CalStatus"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Instrument" empty="@(!Model.Items.Any())" empty-text="@Localizer["In_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Ins_Tag"]</th>
                        <th data-col-key="mfr" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px" class="vs-hide-md">@Localizer["Cm_ManufacturerModel"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">@Localizer["Cm_Type"]</th>
                        <th data-col-key="loop" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["In_Loop"]</th>
                        <th data-col-key="system" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["System"]</th>
                        <th data-col-key="lastCal" data-resizable="true" data-min-width="100" data-max-width="180" style="width:120px" class="vs-hide-md">@Localizer["In_LastCal"]</th>
                        <th data-col-key="nextDue" data-resizable="true" data-min-width="100" data-max-width="180" style="width:120px">@Localizer["Cm_NextDue"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["In_CalStatus"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:90px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Passport" asp-route-id="@i.InstrumentId" class="lp-subject" title="@i.TagNumber">@i.TagNumber</a></td>
                            <td class="small vs-hide-md">@i.Manufacturer / @i.Model</td>
                            <td class="small">@i.InstrumentType</td>
                            <td class="small"><span class="vs-num">@i.LoopNumber</span></td>
                            <td class="small">@i.System</td>
                            <td class="small vs-hide-md"><span class="vs-num">@(i.LastCalibrationDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td class="small"><span class="vs-num">@(i.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td><span class="vs-pill @StatusTone(i.CalibrationStatus)">@StatusText(i.CalibrationStatus)</span></td>
                            <td class="lp-actions">
                                <a asp-action="Passport" asp-route-id="@i.InstrumentId" class="lp-act lp-act--always" title="@Localizer["In_Passport"]" aria-label="@Localizer["In_Passport"]"><i class="bi bi-card-text" aria-hidden="true"></i></a>
                                <a asp-action="Edit" asp-route-id="@i.InstrumentId" class="lp-act lp-act--always" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Instrument",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createInstrumentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["In_New"]</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Tag number, manufacturer, model and description come from the Equipment record itself -
                        pick the equipment that <em>is</em> this instrument. Only instrumentation-specific passport fields are entered here.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Equipment"]</label>
                        <select name="equipmentId" class="form-select" required>
                            <option value="">@Localizer["-- select equipment --"]</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </select>
                        <div class="form-text">Equipment not listed here already has an instrument profile, or doesn't exist yet - create it under Equipment first.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Instrument Type"]</label>
                            <input name="instrumentType" class="form-control" placeholder="PT, LT, FT, TT, Control Valve ..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Loop Number"]</label>
                            <input name="loopNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["System"]</label>
                            <input name="system" class="form-control" placeholder="DCS, ESD, F&amp;G, PLC ..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Signal Class"]</label>
                            <input name="signalClass" class="form-control" placeholder="AI, AO, DI, DO ..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Range Min"]</label>
                            <input name="rangeMin" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Range Max"]</label>
                            <input name="rangeMax" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Unit"]</label>
                            <input name="unit" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Signal Type</label>
                            <input name="signalType" class="form-control" placeholder="4-20mA, HART ..." />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Process Variable"]</label>
                            <input name="processVariable" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Accuracy"]</label>
                            <input name="accuracy" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Calibration Interval (days)"]</label>
                            <input name="calibrationInterval" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
