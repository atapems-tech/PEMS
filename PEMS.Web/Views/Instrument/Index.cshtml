@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InstrumentListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
    var q = (string?)ViewBag.SearchTerm;
    var status = (string?)ViewBag.SelectedStatus;
    var statuses = new[] { "Overdue", "DueSoon", "OK", "Unknown" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");

    string StatusText(string? s) => VdrUi.Loc(Localizer, "In_St_", s);
    string StatusTone(string? s) => s switch { "Overdue" => "vs-pill--danger", "DueSoon" => "vs-pill--warning", "OK" => "vs-pill--success", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The count cards became the KPI row, export and "New
   instrument" moved into the toolbar; the page keeps its search, calibration-status filter and columns. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["In_Title"]" total="@Model.TotalCount">
            <pems-list-search id="inSearchForm" action="@Url.Action("Index")" input-id="inQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["In_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="inSearchForm">
                <pems-list-filters form-id="inFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="inFilterStatus">@Localizer["In_CalStatus"]</label>
                        <pems-select scale="small" id="inFilterStatus" name="status">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </pems-select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="inKpis" storage-key="pems.instrument.kpis" />
                <pems-list-export href="@Url.Action("Export")" label="@Localizer["In_ExportAll"]" />
                <pems-list-reset-columns grid-key="Instrument" />
                <pems-list-new modal="createInstrumentModal" text="@Localizer["In_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="inKpis">
            <span class="vs-chip">@Localizer["Eq_Total"] <strong>@ViewBag.TotalCount</strong></span>
            <span class="vs-chip @(((int?)ViewBag.OverdueCount ?? 0) > 0 ? "vs-chip--danger" : "")"><pems-icon name="bi-clock-history" aria-hidden="true" /> @Localizer["Overdue"] <strong>@ViewBag.OverdueCount</strong></span>
            <span class="vs-chip"><pems-icon name="bi-hourglass-split" aria-hidden="true" /> @Localizer["In_DueSoon30"] <strong>@ViewBag.DueSoonCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { status })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["In_CalStatus"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Instrument" empty="@(!Model.Items.Any())" empty-text="@Localizer["In_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ins_Tag"]</pems-table-header>
                        <pems-table-header data-col-key="mfr" data-resizable="true" data-min-width="140" data-max-width="320" class="vs-hide-md pems-w-200">@Localizer["Cm_ManufacturerModel"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="180">@Localizer["Cm_Type"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="loop" data-resizable="true" data-min-width="80" data-max-width="160">@Localizer["In_Loop"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="system" data-resizable="true" data-min-width="80" data-max-width="160">@Localizer["System"]</pems-table-header>
                        <pems-table-header data-col-key="lastCal" data-resizable="true" data-min-width="100" data-max-width="180" class="vs-hide-md pems-w-120">@Localizer["In_LastCal"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="nextDue" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Cm_NextDue"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["In_CalStatus"]</pems-table-header>
                        <pems-table-header class="pems-w-90" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var i in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Passport" asp-route-id="@i.InstrumentId" class="lp-subject" title="@i.TagNumber">@i.TagNumber</a></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@i.Manufacturer / @i.Model</pems-table-cell>
                            <pems-table-cell class="small">@i.InstrumentType</pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@i.LoopNumber</span></pems-table-cell>
                            <pems-table-cell class="small">@i.System</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@(i.LastCalibrationDate?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@(i.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(i.CalibrationStatus)">@StatusText(i.CalibrationStatus)</span></pems-table-cell>
                            <pems-table-cell class="lp-actions">
                                <a asp-action="Passport" asp-route-id="@i.InstrumentId" class="lp-act lp-act--always" title="@Localizer["In_Passport"]" aria-label="@Localizer["In_Passport"]"><pems-icon name="bi-card-text" aria-hidden="true" /></a>
                                <a asp-action="Edit" asp-route-id="@i.InstrumentId" class="lp-act lp-act--always" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]"><pems-icon name="bi-pencil" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Instrument",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal size="large" id="createInstrumentModal" tabindex="-1">
            <form asp-action="Create" method="post">
                <pems-modal-header>@Localizer["In_New"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">
                        Tag number, manufacturer, model and description come from the Equipment record itself -
                        pick the equipment that <em>is</em> this instrument. Only instrumentation-specific passport fields are entered here.
                    </p>
                    <div class="mb-3">
                        <pems-label>@Localizer["Equipment"]</pems-label>
                        <pems-select name="equipmentId" required>
                            <option value="">@Localizer["-- select equipment --"]</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </pems-select>
                        <pems-help-text>Equipment not listed here already has an instrument profile, or doesn't exist yet - create it under Equipment first.</pems-help-text>
                    </div>

                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Instrument Type"]</pems-label>
                            <pems-input name="instrumentType" placeholder="PT, LT, FT, TT, Control Valve ..." />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Loop Number"]</pems-label>
                            <pems-input name="loopNumber" />
                        </pems-col>
                    </pems-row>

                    <pems-row gap="3" css="mb-3">
                        <pems-col md="6">
                            <pems-label>@Localizer["System"]</pems-label>
                            <pems-input name="system" placeholder="DCS, ESD, F&amp;G, PLC ..." />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Signal Class"]</pems-label>
                            <pems-input name="signalClass" placeholder="AI, AO, DI, DO ..." />
                        </pems-col>
                    </pems-row>

                    <pems-row gap="3" css="mb-3">
                        <pems-col md="3">
                            <pems-label>@Localizer["Range Min"]</pems-label>
                            <pems-input name="rangeMin" type="number" step="0.01" />
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Range Max"]</pems-label>
                            <pems-input name="rangeMax" type="number" step="0.01" />
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Unit"]</pems-label>
                            <pems-input name="unit" />
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>Signal Type</pems-label>
                            <pems-input name="signalType" placeholder="4-20mA, HART ..." />
                        </pems-col>
                    </pems-row>

                    <pems-row gap="3">
                        <pems-col md="6">
                            <pems-label>@Localizer["Process Variable"]</pems-label>
                            <pems-input name="processVariable" />
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Accuracy"]</pems-label>
                            <pems-input name="accuracy" />
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Calibration Interval (days)"]</pems-label>
                            <pems-input name="calibrationInterval" type="number" />
                        </pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
