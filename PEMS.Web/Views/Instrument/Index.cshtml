@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InstrumentListDto>
@{
    var equipmentOptions = (IEnumerable<dynamic>)ViewBag.Equipments;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="row g-3 text-center">
        <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Total Instruments</div><div class="fs-4 fw-bold">@ViewBag.TotalCount</div></div></div>
        <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Overdue</div><div class="fs-4 fw-bold text-danger">@ViewBag.OverdueCount</div></div></div>
        <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Due Soon (30d)</div><div class="fs-4 fw-bold text-warning">@ViewBag.DueSoonCount</div></div></div>
        <div class="col-md-3">
            <div class="border rounded p-3 d-flex flex-column gap-2 h-100 justify-content-center">
                <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createInstrumentModal">
                    <i class="bi bi-plus-lg"></i> New Instrument
                </button>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importInstrumentModal">
                        <i class="bi bi-upload"></i> Import
                    </button>
                    <a asp-action="Export" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i> Export</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content-card">
    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        <input type="search" name="q" value="@ViewBag.SearchTerm" class="form-control form-control-sm" style="max-width:260px;" placeholder="Search tag / loop..." />
        <select name="status" class="form-select form-select-sm" style="max-width:180px;">
            <option value="">All statuses</option>
            @foreach (var s in new[] { "Overdue", "DueSoon", "OK", "Unknown" })
            {
                <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> Filter</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
    </form>

    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Instrument')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Instrument">
            <thead>
                <tr>
                    <th data-col-key="tag" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Tag</th>
                    <th data-col-key="mfr" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">Manufacturer / Model</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">Type</th>
                    <th data-col-key="loop" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">Loop</th>
                    <th data-col-key="system" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">System</th>
                    <th data-col-key="lastCal" data-resizable="true" data-min-width="100" data-max-width="180" style="width:120px">Last Calibration</th>
                    <th data-col-key="nextDue" data-resizable="true" data-min-width="100" data-max-width="180" style="width:120px">Next Due</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">Status</th>
                    <th data-col-key="actions" data-resizable="false" style="width:90px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    var badgeClass = i.CalibrationStatus switch { "Overdue" => "bg-danger", "DueSoon" => "bg-warning text-dark", "OK" => "bg-success", _ => "bg-secondary" };
                    <tr>
                        <td><a asp-action="Passport" asp-route-id="@i.InstrumentId">@i.TagNumber</a></td>
                        <td class="small">@i.Manufacturer / @i.Model</td>
                        <td>@i.InstrumentType</td>
                        <td>@i.LoopNumber</td>
                        <td>@i.System</td>
                        <td class="small">@(i.LastCalibrationDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="small">@(i.NextCalibrationDue?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td><span class="badge @badgeClass">@i.CalibrationStatus</span></td>
                        <td class="text-end">
                            <a asp-action="Passport" asp-route-id="@i.InstrumentId" class="btn btn-sm btn-outline-secondary" title="Passport"><i class="bi bi-card-text"></i></a>
                            <a asp-action="Edit" asp-route-id="@i.InstrumentId" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No instruments found.</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.SearchTerm)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Instrument",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Instrument');
        });
    </script>
}

<div class="modal fade" id="importInstrumentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div class="modal-header"><h6 class="modal-title">Import Instruments</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">فایل اکسل با همون ستون‌بندی خروجی Export (Equipment, InstrumentType, LoopNumber, System, ..., CalibrationInterval). تگ تجهیز باید از قبل در Equipment ثبت شده باشد؛ تگ‌های پیدا نشده رد می‌شوند.</p>
                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createInstrumentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Instrument</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Tag number, manufacturer, model and description come from the Equipment record itself -
                        pick the equipment that <em>is</em> this instrument. Only instrumentation-specific passport fields are entered here.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Equipment</label>
                        <select name="equipmentId" class="form-select" required>
                            <option value="">-- select equipment --</option>
                            @foreach (var e in equipmentOptions)
                            {
                                <option value="@e.EquipmentId">@e.Label</option>
                            }
                        </select>
                        <div class="form-text">Equipment not listed here already has an instrument profile, or doesn't exist yet - create it under Equipment first.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Instrument Type</label>
                            <input name="instrumentType" class="form-control" placeholder="PT, LT, FT, TT, Control Valve ..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Loop Number</label>
                            <input name="loopNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">System</label>
                            <input name="system" class="form-control" placeholder="DCS, ESD, F&amp;G, PLC ..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Signal Class</label>
                            <input name="signalClass" class="form-control" placeholder="AI, AO, DI, DO ..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Range Min</label>
                            <input name="rangeMin" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Range Max</label>
                            <input name="rangeMax" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Unit</label>
                            <input name="unit" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Signal Type</label>
                            <input name="signalType" class="form-control" placeholder="4-20mA, HART ..." />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Process Variable</label>
                            <input name="processVariable" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Accuracy</label>
                            <input name="accuracy" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Calibration Interval (days)</label>
                            <input name="calibrationInterval" type="number" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
