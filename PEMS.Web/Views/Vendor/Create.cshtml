@model PEMS.Domain.Entities.Vendor
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_NewVendor"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">
    
    <div class="content-card pems-s-b12974cb">
        <form asp-action="Create" method="post">
            <pems-row gap="3">
                <pems-col span="12"><pems-label>@Localizer["Vs_Name"]</pems-label><pems-input asp-for="Name" required /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_VendorCode"] <span class="text-muted small">@Localizer["Vs_VendorCodeHint"]</span></pems-label><pems-input asp-for="VendorCode" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_Country"]</pems-label><pems-input asp-for="Country" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactName"]</pems-label><pems-input asp-for="ContactName" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactEmail"]</pems-label><pems-input asp-for="ContactEmail" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactPhone"]</pems-label><pems-input asp-for="ContactPhone" /></pems-col>
            </pems-row>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                <a asp-action="Index" class="vs-btn">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
