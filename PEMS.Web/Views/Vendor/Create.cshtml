@model PEMS.Domain.Entities.Vendor
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_NewVendor"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">
    
    <div class="content-card" style="max-width:720px;">
        <form asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-12"><label class="form-label">@Localizer["Vs_Name"]</label><input asp-for="Name" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">@Localizer["Vs_VendorCode"] <span class="text-muted small">@Localizer["Vs_VendorCodeHint"]</span></label><input asp-for="VendorCode" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@Localizer["Vs_Country"]</label><input asp-for="Country" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactName"]</label><input asp-for="ContactName" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactEmail"]</label><input asp-for="ContactEmail" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactPhone"]</label><input asp-for="ContactPhone" class="form-control" /></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                <a asp-action="Index" class="vs-btn">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
