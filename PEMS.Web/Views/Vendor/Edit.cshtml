@model PEMS.Domain.Entities.Vendor
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_EditVendor"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">
    
    <div class="content-card" style="max-width:720px;">
        <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></pems-alert>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="VendorId" />
            <input type="hidden" asp-for="RiskLevel" />
            <input type="hidden" asp-for="RiskScore" />
            <input type="hidden" asp-for="RiskAssessedDate" />
            <input type="hidden" asp-for="IsActive" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="row g-3">
                <div class="col-12"><pems-label>@Localizer["Vs_Name"]</pems-label><pems-input asp-for="Name" required /></div>
                <div class="col-md-6"><pems-label>@Localizer["Vs_VendorCode"] <span class="text-muted small">@Localizer["Vs_VendorCodeHint"]</span></pems-label><pems-input asp-for="VendorCode" /></div>
                <div class="col-md-6"><pems-label>@Localizer["Vs_Country"]</pems-label><pems-input asp-for="Country" /></div>
                <div class="col-md-6"><pems-label>@Localizer["Vs_ContactName"]</pems-label><pems-input asp-for="ContactName" /></div>
                <div class="col-md-6"><pems-label>@Localizer["Vs_ContactEmail"]</pems-label><pems-input asp-for="ContactEmail" /></div>
                <div class="col-md-6"><pems-label>@Localizer["Vs_ContactPhone"]</pems-label><pems-input asp-for="ContactPhone" /></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                <a asp-action="Details" asp-route-id="@Model.VendorId" class="vs-btn">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
