@model PEMS.Domain.Entities.Vendor
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_EditVendor"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<pems-page-shell kind="workspace">
    
    <pems-content-card css="pems-s-b12974cb">
        <pems-validation-summary css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-validation-summary>

        <pems-form asp-action="Edit" method="post">
            <input type="hidden" asp-for="VendorId" />
            <input type="hidden" asp-for="RiskLevel" />
            <input type="hidden" asp-for="RiskScore" />
            <input type="hidden" asp-for="RiskAssessedDate" />
            <input type="hidden" asp-for="IsActive" />
            <input type="hidden" asp-for="CreatedDate" />

            <pems-row gap="3">
                <pems-col span="12"><pems-label>@Localizer["Vs_Name"]</pems-label><pems-input asp-for="Name" required /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_VendorCode"] <span class="text-muted small">@Localizer["Vs_VendorCodeHint"]</span></pems-label><pems-input asp-for="VendorCode" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_Country"]</pems-label><pems-input asp-for="Country" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactName"]</pems-label><pems-input asp-for="ContactName" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactEmail"]</pems-label><pems-input asp-for="ContactEmail" /></pems-col>
                <pems-col md="6"><pems-label>@Localizer["Vs_ContactPhone"]</pems-label><pems-input asp-for="ContactPhone" /></pems-col>
            </pems-row>
            <pems-flex gap="2" css="mt-4">
                <pems-button tone="bare" type="submit" css="vs-btn vs-btn--primary">@Localizer["Save"]</pems-button>
                <a asp-action="Details" asp-route-id="@Model.VendorId" class="vs-btn">@Localizer["Cancel"]</a>
            </pems-flex>
        </pems-form>
    </pems-content-card>
</pems-page-shell>
