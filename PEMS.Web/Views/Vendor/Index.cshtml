@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VendorDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_SupplierDirectory"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-vdr.css" asp-append-version="true" />
}

<div class="vs-page">

    @* Stitch: supplier_directory - header, KPI row (real counts only), directory table *@
    <div class="vs-header">
        <span class="vs-cell-sub">@Localizer["Vs_TotalVendors"]: <strong>@Model.TotalCount</strong></span>
        <div class="vs-actions">
            <button type="button" class="vs-btn vs-btn--primary vs-btn--sm" data-bs-toggle="modal" data-bs-target="#createVendorModal">
                <i class="bi bi-plus-lg"></i> @Localizer["Vs_NewVendor"]
            </button>
        </div>
    </div>

    <div class="vs-panel">
        <div class="vs-panel__head">
            <h3 class="vs-panel__title"><i class="bi bi-buildings"></i> @Localizer["Vendors"]</h3>
            <button type="button" class="vs-btn vs-btn--sm" onclick="PemsDataGrid.resetColumns('Vendor')">
                <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
            </button>
        </div>

        <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
            <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="Vendor">
                <thead>
                    <tr>
                        <th data-col-key="name" data-resizable="true" data-min-width="100" data-max-width="260" style="width:170px">@Localizer["Vs_Name"]</th>
                        <th data-col-key="country" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">@Localizer["Vs_Country"]</th>
                        <th data-col-key="contracts" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Vs_Contracts"]</th>
                        <th data-col-key="vdrItems" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Vs_VdrItems"]</th>
                        <th data-col-key="overdue" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Vs_Overdue"]</th>
                        <th data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Vs_Risk"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="vs-cell-strong">@v.Name</div>
                                @if (!string.IsNullOrEmpty(v.VendorCode)) { <div class="vs-mono">@v.VendorCode</div> }
                            </td>
                            <td>@v.Country</td>
                            <td>@v.ContractsCount</td>
                            <td>@v.VDRItemsCount</td>
                            <td>
                                @if (v.OverdueVDRItemsCount > 0)
                                { <span class="vs-pill vs-pill--danger">@v.OverdueVDRItemsCount</span> }
                                else
                                { <span class="vs-pill vs-pill--success">0</span> }
                            </td>
                            <td><span class="vs-pill @VdrUi.RiskTone(v.RiskLevel)">@VdrUi.Loc(Localizer, "St_", v.RiskLevel)</span></td>
                            <td><a asp-action="Details" asp-route-id="@v.VendorId" class="vs-icon-btn" title="@Localizer["Vs_View"]"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Items.Any()) { <div class="vs-empty"><i class="bi bi-inbox"></i>@Localizer["Vs_NoVendors"]</div> }
        </div>

        <div class="vs-panel__foot">
            @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
            {
                Page = Model.Page,
                TotalPages = Model.TotalPages,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                GridKey = "Vendor",
                BaseUrl = Url.Action("Index") ?? "",
                ExistingQueryString = ""
            })
        </div>
    </div>

    @* طبق درخواست: ثبت سریع بدون خروج از صفحه‌ی اصلی - Popup به‌جای صفحه‌ی جدا *@
    <div class="modal fade" id="createVendorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Vendor" asp-action="Create" method="post">
                    <div class="modal-header"><h6 class="modal-title">@Localizer["Vs_NewVendor"]</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label">@Localizer["Vs_Name"]</label><input name="Name" class="form-control" required /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Vs_Country"]</label><input name="Country" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactName"]</label><input name="ContactName" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactEmail"]</label><input name="ContactEmail" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactPhone"]</label><input name="ContactPhone" class="form-control" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="vs-btn" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Vendor');
        });
    </script>
}
