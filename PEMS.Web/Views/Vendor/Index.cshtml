@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VendorDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_SupplierDirectory"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns, paging and the quick-create
   modal (opened by New; it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Vendors"]" heading-title="@Localizer["Vs_SupplierDirectory"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Vendor" />
                <pems-list-new modal="createVendorModal" text="@Localizer["Vs_NewVendor"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Vendor" empty="@(!Model.Items.Any())" empty-text="@Localizer["Vs_NoVendors"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header data-col-key="name" data-resizable="true" data-min-width="100" data-max-width="320">@Localizer["Vs_Name"]</pems-table-header>
                        <pems-table-header data-col-key="country" data-resizable="true" data-min-width="80" data-max-width="180" class="vs-hide-md pems-w-120">@Localizer["Vs_Country"]</pems-table-header>
                        <pems-table-header data-col-key="contracts" data-resizable="true" data-min-width="70" data-max-width="140" class="text-end pems-w-100">@Localizer["Vs_Contracts"]</pems-table-header>
                        <pems-table-header data-col-key="vdrItems" data-resizable="true" data-min-width="70" data-max-width="140" class="text-end pems-w-100">@Localizer["Vs_VdrItems"]</pems-table-header>
                        <pems-table-header data-col-key="overdue" data-resizable="true" data-min-width="70" data-max-width="140" class="text-end pems-w-100">@Localizer["Vs_Overdue"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140">@Localizer["Vs_Risk"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var v in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell>
                                <a asp-action="Details" asp-route-id="@v.VendorId" class="lp-subject" title="@v.Name">@v.Name</a>
                                @if (!string.IsNullOrEmpty(v.VendorCode)) { <div class="vs-mono small">@v.VendorCode</div> }
                            </pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@v.Country</pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@v.ContractsCount</span></pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@v.VDRItemsCount</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                @if (v.OverdueVDRItemsCount > 0) { <span class="vs-pill vs-pill--danger">@v.OverdueVDRItemsCount</span> }
                                else { <span class="vs-num">0</span> }
                            </pems-table-cell>
                            <pems-table-cell><span class="vs-pill @VdrUi.RiskTone(v.RiskLevel)">@VdrUi.Loc(Localizer, "St_", v.RiskLevel)</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <a asp-action="Details" asp-route-id="@v.VendorId" class="lp-act lp-act--always" title="@Localizer["Vs_View"]" aria-label="@Localizer["Vs_View"]"><pems-icon name="bi-eye" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Vendor",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@* طبق درخواست: ثبت سریع بدون خروج از صفحه‌ی اصلی - Popup به‌جای صفحه‌ی جدا *@
<pems-modal id="createVendorModal" tabindex="-1">
            <pems-form asp-controller="Vendor" asp-action="Create" method="post">
                <pems-modal-header>@Localizer["Vs_NewVendor"]</pems-modal-header>
                <pems-modal-body>
                    <pems-row gap="3">
                        <pems-col span="12"><pems-label>@Localizer["Vs_Name"]</pems-label><pems-input name="Name" required /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Vs_Country"]</pems-label><pems-input name="Country" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Vs_ContactName"]</pems-label><pems-input name="ContactName" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Vs_ContactEmail"]</pems-label><pems-input name="ContactEmail" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Vs_ContactPhone"]</pems-label><pems-input name="ContactPhone" /></pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <button type="button" class="vs-btn" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
