@model List<PEMS.Application.DTOs.VendorDto>


<div class="content-card">
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createVendorModal">
            <i class="bi bi-plus-lg"></i> New Vendor
        </button>
    </div>

    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr><th>Name</th><th>Country</th><th>Contracts</th><th>VDR Items</th><th>Overdue</th><th>Risk</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.Name</td>
                        <td>@v.Country</td>
                        <td>@v.ContractsCount</td>
                        <td>@v.VDRItemsCount</td>
                        <td>
                            @if (v.OverdueVDRItemsCount > 0)
                            { <span class="badge bg-danger">@v.OverdueVDRItemsCount</span> }
                            else
                            { <span class="badge bg-success">0</span> }
                        </td>
                        <td>
                            @{
                                var riskBadge = v.RiskLevel switch { "Low" => "bg-success", "Medium" => "bg-warning text-dark", "High" => "bg-danger", _ => "bg-secondary" };
                            }
                            <span class="badge @riskBadge">@v.RiskLevel</span>
                        </td>
                        <td><a asp-action="Details" asp-route-id="@v.VendorId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted text-center py-4">No vendors yet. They will also be created automatically when you import a VDR file.</p> }
    </div>
</div>

@* طبق درخواست: ثبت سریع بدون خروج از صفحه‌ی اصلی - Popup به‌جای صفحه‌ی جدا *@
<div class="modal fade" id="createVendorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Vendor" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Vendor</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label">Name</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Country</label><input name="Country" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Name</label><input name="ContactName" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Email</label><input name="ContactEmail" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Phone</label><input name="ContactPhone" class="form-control" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
