@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VendorDto>


<div class="content-card">
    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Vendor')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createVendorModal">
            <i class="bi bi-plus-lg"></i> New Vendor
        </button>
    </div>

    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Vendor">
            <thead>
                <tr>
                    <th data-col-key="name" data-resizable="true" data-min-width="100" data-max-width="260" style="width:170px">Name</th>
                    <th data-col-key="country" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">Country</th>
                    <th data-col-key="contracts" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">Contracts</th>
                    <th data-col-key="vdrItems" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">VDR Items</th>
                    <th data-col-key="overdue" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">Overdue</th>
                    <th data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">Risk</th>
                    <th data-col-key="actions" data-resizable="false" style="width:60px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Items)
                {
                    <tr>
                        <td>@v.Name</td>
                        <td>@v.Country</td>
                        <td>@v.ContractsCount</td>
                        <td>@v.VDRItemsCount</td>
                        <td>
                            @if (v.OverdueVDRItemsCount > 0)
                            { <span class="badge bg-danger">@v.OverdueVDRItemsCount</span> }
                            else
                            { <span class="badge bg-success">0</span> }
                        </td>
                        <td>
                            @{
                                var riskBadge = v.RiskLevel switch { "Low" => "bg-success", "Medium" => "bg-warning text-dark", "High" => "bg-danger", _ => "bg-secondary" };
                            }
                            <span class="badge @riskBadge">@v.RiskLevel</span>
                        </td>
                        <td><a asp-action="Details" asp-route-id="@v.VendorId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No vendors yet. They will also be created automatically when you import a VDR file.</p> }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Vendor",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Vendor');
        });
    </script>
}

@* طبق درخواست: ثبت سریع بدون خروج از صفحه‌ی اصلی - Popup به‌جای صفحه‌ی جدا *@
<div class="modal fade" id="createVendorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Vendor" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Vendor</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label">Name</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Country</label><input name="Country" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Name</label><input name="ContactName" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Email</label><input name="ContactEmail" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Contact Phone</label><input name="ContactPhone" class="form-control" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
