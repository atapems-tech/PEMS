@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VendorDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Localizer["Vs_SupplierDirectory"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns, paging and the quick-create
   modal (opened by New; it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Vendors"]" heading-title="@Localizer["Vs_SupplierDirectory"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Vendor" />
                <pems-list-new modal="createVendorModal" text="@Localizer["Vs_NewVendor"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Vendor" empty="@(!Model.Items.Any())" empty-text="@Localizer["Vs_NoVendors"]">
                <thead>
                    <tr>
                        <th data-col-key="name" data-resizable="true" data-min-width="100" data-max-width="320">@Localizer["Vs_Name"]</th>
                        <th data-col-key="country" data-resizable="true" data-min-width="80" data-max-width="180" style="width:120px" class="vs-hide-md">@Localizer["Vs_Country"]</th>
                        <th data-col-key="contracts" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px" class="text-end">@Localizer["Vs_Contracts"]</th>
                        <th data-col-key="vdrItems" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px" class="text-end">@Localizer["Vs_VdrItems"]</th>
                        <th data-col-key="overdue" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px" class="text-end">@Localizer["Vs_Overdue"]</th>
                        <th data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140" style="width:110px">@Localizer["Vs_Risk"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Items)
                    {
                        <tr class="lp-row">
                            <td>
                                <a asp-action="Details" asp-route-id="@v.VendorId" class="lp-subject" title="@v.Name">@v.Name</a>
                                @if (!string.IsNullOrEmpty(v.VendorCode)) { <div class="vs-mono small">@v.VendorCode</div> }
                            </td>
                            <td class="small vs-hide-md">@v.Country</td>
                            <td class="text-end"><span class="vs-num">@v.ContractsCount</span></td>
                            <td class="text-end"><span class="vs-num">@v.VDRItemsCount</span></td>
                            <td class="text-end">
                                @if (v.OverdueVDRItemsCount > 0) { <span class="vs-pill vs-pill--danger">@v.OverdueVDRItemsCount</span> }
                                else { <span class="vs-num">0</span> }
                            </td>
                            <td><span class="vs-pill @VdrUi.RiskTone(v.RiskLevel)">@VdrUi.Loc(Localizer, "St_", v.RiskLevel)</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@v.VendorId" class="lp-act lp-act--always" title="@Localizer["Vs_View"]" aria-label="@Localizer["Vs_View"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Vendor",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@* طبق درخواست: ثبت سریع بدون خروج از صفحه‌ی اصلی - Popup به‌جای صفحه‌ی جدا *@
<div class="modal fade" id="createVendorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Vendor" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["Vs_NewVendor"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label">@Localizer["Vs_Name"]</label><input name="Name" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Vs_Country"]</label><input name="Country" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactName"]</label><input name="ContactName" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactEmail"]</label><input name="ContactEmail" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Vs_ContactPhone"]</label><input name="ContactPhone" class="form-control" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="vs-btn" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="vs-btn vs-btn--primary">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
