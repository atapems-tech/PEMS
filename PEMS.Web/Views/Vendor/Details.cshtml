@model PEMS.Application.DTOs.VendorDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@{ ViewData["Title"] = Model.Name; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-vdr.css" asp-append-version="true" />
}

<div class="vs-page">

    @* Stitch: vendor_performance_scorecard / supplier_directory detail pane - only fields that exist in PEMS (no invented scores) *@
    <div class="vs-header">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="vs-pill @(Model.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@Localizer[Model.IsActive ? "Vs_Active" : "Vs_Inactive"]</span>
            <span class="vs-pill @VdrUi.RiskTone(Model.RiskLevel)">@Localizer["Vs_Risk"]: @VdrUi.Loc(Localizer, "St_", Model.RiskLevel)@(Model.RiskScore.HasValue ? " (" + Model.RiskScore.Value.ToString("P0") + ")" : "")</span>
        </div>
        <div class="vs-actions">
            <a asp-controller="VDR" asp-action="Index" asp-route-vendorId="@Model.VendorId" class="vs-btn vs-btn--sm"><i class="bi bi-list"></i> @Localizer["Vs_ViewVdrItems"]</a>
            <a asp-controller="Relationship" asp-action="Vendor" asp-route-id="@Model.VendorId" class="vs-btn vs-btn--sm"><i class="bi bi-diagram-3"></i> @Localizer["Vs_ExploreRelationships"]</a>
            <a asp-action="Edit" asp-route-id="@Model.VendorId" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-pencil"></i> @Localizer["Vs_EditVendor"]</a>
        </div>
    </div>

    <div class="vs-panel"><div class="vs-panel__body">
            <div class="vs-info">
                <div><p class="vs-info__label">@Localizer["Vs_VendorCode"]</p><p class="vs-info__value vs-mono">@(Model.VendorCode ?? "-")</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_Country"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.Country) ? "-" : Model.Country)</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_Contracts"]</p><p class="vs-info__value">@Model.ContractsCount</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_VdrItems"]</p><p class="vs-info__value">@Model.VDRItemsCount</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_Overdue"]</p><p class="vs-info__value @(Model.OverdueVDRItemsCount > 0 ? "text-danger" : "")">@Model.OverdueVDRItemsCount</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_ContactName"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.ContactName) ? "-" : Model.ContactName)</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_ContactEmail"]</p><p class="vs-info__value">@if (!string.IsNullOrEmpty(Model.ContactEmail)) { <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a> } else { <span>-</span> }</p></div>
                <div><p class="vs-info__label">@Localizer["Vs_ContactPhone"]</p><p class="vs-info__value" dir="ltr" style="text-align:start;">@(string.IsNullOrEmpty(Model.ContactPhone) ? "-" : Model.ContactPhone)</p></div>
            </div>
            <form asp-action="RecalculateRisk" asp-route-id="@Model.VendorId" method="post" class="mt-3">
                <button class="vs-btn vs-btn--sm"><i class="bi bi-arrow-repeat"></i> @Localizer["Vs_RecalcRisk"]</button>
            </form>
        </div></div>
</div>
