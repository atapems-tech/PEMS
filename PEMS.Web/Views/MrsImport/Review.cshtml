@model PEMS.Application.DTOs.MrsImportBatchDetailDto
@{
    var rows = Model.Rows;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">
                @Model.Batch.SourceFileName
                @if (!string.IsNullOrWhiteSpace(Model.Batch.SourceFileDownloadUrl))
                {
                    <a href="@Model.Batch.SourceFileDownloadUrl" class="small ms-2"><i class="bi bi-download"></i> Download original file</a>
                }
            </h5>
            <span class="text-muted small">Batch #@Model.Batch.MrsImportBatchId - شیت @Model.Batch.SourceSheet - @Model.Batch.TotalRows ردیف - @Model.Batch.ImportDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="admin-kpi-grid">
        <div class="admin-kpi"><div class="admin-kpi-label">New</div><div class="admin-kpi-value">@Model.Batch.NewCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Matched Existing</div><div class="admin-kpi-value">@Model.Batch.MatchedCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Duplicate In Batch</div><div class="admin-kpi-value">@Model.Batch.DuplicateCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Invalid</div><div class="admin-kpi-value">@Model.Batch.InvalidCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Approved</div><div class="admin-kpi-value">@Model.Batch.ApprovedCount</div></div>
    </div>
    <p class="text-muted small mt-2 mb-0">فقط ۵۰۰ ردیف اول این Batch نمایش داده می‌شود (برای Batch های بزرگ، فیلتر Match Status را از URL استفاده کن: <code>?matchStatusFilter=New</code>).</p>
</div>

<form id="bulkCommitForm" asp-action="BulkCommit" method="post">
    <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
</form>
<form id="bulkRejectForm" asp-action="BulkReject" method="post">
    <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
</form>

<div class="content-card mb-3">
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <div class="input-group admin-search" style="max-width:280px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" id="rowSearch" class="form-control" placeholder="Filter by description..." autocomplete="off" />
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary status-filter active" data-status="all">All</button>
            <button type="button" class="btn btn-outline-secondary status-filter" data-status="New">New</button>
            <button type="button" class="btn btn-outline-secondary status-filter" data-status="MatchedExisting">Matched</button>
            <button type="button" class="btn btn-outline-secondary status-filter" data-status="DuplicateInBatch">Duplicate</button>
            <button type="button" class="btn btn-outline-secondary status-filter" data-status="Invalid">Invalid</button>
        </div>
        <button type="submit" form="bulkCommitForm" id="bulkCommitBtn" class="btn btn-sm btn-pems-solid ms-auto" disabled
                onclick="return confirm('تعداد ' + document.getElementById('selectedCount').textContent + ' ردیف انتخاب‌شده تایید و به MaterialItem/InventoryTransaction تبدیل شود؟');">
            <i class="bi bi-check2-circle"></i> Commit Selected (<span id="selectedCount">0</span>)
        </button>
        <button type="submit" form="bulkRejectForm" id="bulkRejectBtn" class="btn btn-sm btn-outline-danger" disabled
                onclick="return confirm('ردیف‌های انتخاب‌شده رد شوند؟');">
            <i class="bi bi-x-circle"></i> Reject Selected
        </button>
    </div>
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:70vh; overflow-y:auto;">
        <table class="table table-enterprise table-sm">
            <thead>
                <tr>
                    <th style="width:30px;"><input type="checkbox" id="selectAllPending" /></th>
                    <th>MRS No</th><th>Item Code</th><th>Description</th><th>UOM</th><th>Vendor</th><th>PO No</th><th>Qty Recv</th><th>Qty Issued</th>
                    <th>Warehouse</th><th>Match Status</th><th>Matched Material</th><th>Review</th><th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var badgeClass = row.MatchStatus switch
                    {
                        "MatchedExisting" => "bg-info text-dark",
                        "DuplicateInBatch" => "bg-warning text-dark",
                        "Invalid" => "bg-danger",
                        _ => "bg-primary"
                    };
                    var isSelectable = row.ReviewStatus == "Pending" && row.MatchStatus != "Invalid";
                    var metaRowId = "meta-" + row.MrsImportRowId;

                    <tr class="row-item" data-status="@row.MatchStatus" data-desc="@(row.RawDescription ?? "").ToLower()">
                        <td>
                            @if (isSelectable)
                            {
                                <input type="checkbox" class="row-select" form="bulkCommitForm" name="selectedRowIds" value="@row.MrsImportRowId" />
                                <input type="checkbox" class="row-select-reject d-none" form="bulkRejectForm" name="selectedRowIds" value="@row.MrsImportRowId" />
                            }
                        </td>
                        <td class="small">@(row.RawMrsNo ?? "-")</td>
                        <td class="small">@(row.RawItemCode ?? "-")</td>
                        <td class="small" style="max-width:260px;">@(row.RawDescription ?? "-")</td>
                        <td class="small">@(row.RawUom ?? "-")</td>
                        <td class="small">@(row.RawSupplier ?? "-")</td>
                        <td class="small">@(row.RawPoNo ?? "-")</td>
                        <td class="small">@(row.RawQtyReceived?.ToString() ?? "-")</td>
                        <td class="small">@(row.RawQtyIssued?.ToString() ?? "-")</td>
                        <td class="small">@(row.ResolvedWarehouseCode ?? "-")</td>
                        <td><span class="badge @badgeClass">@row.MatchStatus</span></td>
                        <td class="small">@(row.MatchedMaterialCode != null ? row.MatchedMaterialCode + " - " + row.MatchedMaterialDescription : "-")</td>
                        <td>
                            @if (row.ReviewStatus == "Approved" && !string.IsNullOrWhiteSpace(row.ErrorMessage))
                            {
                                <span class="small text-warning" title="@row.ErrorMessage"><i class="bi bi-exclamation-triangle"></i> Approved (@row.ErrorMessage)</span>
                            }
                            else if (row.ReviewStatus == "Approved")
                            {
                                <span class="small text-success"><i class="bi bi-check-circle"></i> Approved</span>
                            }
                            else if (row.ReviewStatus == "Rejected")
                            {
                                <span class="small text-muted"><i class="bi bi-x-circle"></i> Rejected</span>
                            }
                            else if (row.MatchStatus == "Invalid")
                            {
                                <span class="small text-danger">@row.ErrorMessage</span>
                            }
                            else
                            {
                                <span class="small text-muted">Pending</span>
                            }
                        </td>
                        <td>
                            @if (row.Metadata.Any())
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary meta-toggle" data-target="@metaRowId" title="Show all Excel columns for this row">
                                    <i class="bi bi-list-columns-reverse"></i> @row.Metadata.Count
                                </button>
                            }
                        </td>
                    </tr>
                    @if (row.Metadata.Any())
                    {
                        <tr id="@metaRowId" class="d-none">
                            <td></td>
                            <td colspan="12">
                                <div class="p-2 bg-light-subtle border rounded">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr class="text-muted small"><th>Original Excel Header</th><th>Canonical Field</th><th>Value</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in row.Metadata)
                                            {
                                                <tr class="small">
                                                    <td>@m.OriginalHeader</td>
                                                    <td>@(m.CanonicalField ?? "-")</td>
                                                    <td>@(m.Value ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (!rows.Any()) { <p class="text-muted text-center py-4">No rows in this batch.</p> }
    </div>
</div>

@section Scripts {
<script>
(function () {
    var searchInput = document.getElementById('rowSearch');
    var statusButtons = [].slice.call(document.querySelectorAll('.status-filter'));
    var rows = [].slice.call(document.querySelectorAll('.row-item'));
    var activeStatus = 'all';

    function applyFilters() {
        var q = (searchInput.value || '').trim().toLowerCase();
        rows.forEach(function (r) {
            var statusOk = activeStatus === 'all' || r.getAttribute('data-status') === activeStatus;
            var descOk = !q || r.getAttribute('data-desc').indexOf(q) !== -1;
            r.style.display = (statusOk && descOk) ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', applyFilters);
    statusButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            statusButtons.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            activeStatus = btn.getAttribute('data-status');
            applyFilters();
        });
    });
})();

(function () {
    var selectAll = document.getElementById('selectAllPending');
    var checkboxes = [].slice.call(document.querySelectorAll('.row-select'));
    var rejectCheckboxes = [].slice.call(document.querySelectorAll('.row-select-reject'));
    var commitBtn = document.getElementById('bulkCommitBtn');
    var rejectBtn = document.getElementById('bulkRejectBtn');
    var countSpan = document.getElementById('selectedCount');

    function sync(i) { rejectCheckboxes[i].checked = checkboxes[i].checked; }

    function updateCount() {
        var checked = checkboxes.filter(function (c) { return c.checked; }).length;
        countSpan.textContent = checked;
        commitBtn.disabled = checked === 0;
        rejectBtn.disabled = checked === 0;
    }

    selectAll.addEventListener('change', function () {
        checkboxes.forEach(function (c, i) {
            var row = c.closest('tr');
            if (row.style.display !== 'none') { c.checked = selectAll.checked; sync(i); }
        });
        updateCount();
    });

    checkboxes.forEach(function (c, i) { c.addEventListener('change', function () { sync(i); updateCount(); }); });
    updateCount();
})();

(function () {
    [].slice.call(document.querySelectorAll('.meta-toggle')).forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = document.getElementById(btn.getAttribute('data-target'));
            if (target) target.classList.toggle('d-none');
        });
    });
})();
</script>
}
