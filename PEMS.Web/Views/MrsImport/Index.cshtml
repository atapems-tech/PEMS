@model List<PEMS.Application.DTOs.MrsImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <h6 class="mb-2"><i class="bi bi-file-earmark-excel"></i> Upload MRS Excel File</h6>
    <p class="text-muted small">
        فایل خام MRS آپلود می‌شود، بدون هیچ نوشتنی در MaterialItem/InventoryTransaction - فقط بعد از
        بازبینی و تایید در صفحه‌ی Review، ردیف‌ها به کاتالوگ متریال و دفتر تراکنش تبدیل می‌شوند.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2">
        <div class="col-md-6"><input type="file" name="file" class="form-control form-control-sm" accept=".xlsx,.xlsm" required /></div>
        <div class="col-md-4"><input type="text" name="sheetName" class="form-control form-control-sm" placeholder="@Localizer["نام شیت (اختیاری - پیش‌فرض: بزرگ‌ترین شیت)"]" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-pems-solid btn-sm w-100"><i class="bi bi-upload"></i> @Localizer["Stage"]</button></div>
    </form>
</div>

<div class="content-card">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["File"]</th><th>@Localizer["Sheet"]</th><th>@Localizer["Status"]</th><th>@Localizer["Total"]</th><th>@Localizer["New"]</th><th>@Localizer["Matched"]</th><th>@Localizer["Duplicate"]</th><th>@Localizer["Invalid"]</th><th>@Localizer["Approved"]</th><th>@Localizer["Date"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                var badgeClass = b.Status switch { "Committed" => "bg-success", "InReview" => "bg-info text-dark", "Cancelled" => "bg-secondary", _ => "bg-warning text-dark" };
                <tr>
                    <td class="small">@b.SourceFileName</td>
                    <td class="small">@b.SourceSheet</td>
                    <td><span class="badge @badgeClass">@b.Status</span></td>
                    <td>@b.TotalRows</td>
                    <td>@b.NewCount</td>
                    <td>@b.MatchedCount</td>
                    <td>@b.DuplicateCount</td>
                    <td class="text-danger">@b.InvalidCount</td>
                    <td class="text-success">@b.ApprovedCount</td>
                    <td class="small">@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end"><a asp-action="Review" asp-route-batchId="@b.MrsImportBatchId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-card-text"></i> @Localizer["Review"]</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز فایلی Upload نشده."]</p> }
</div>
