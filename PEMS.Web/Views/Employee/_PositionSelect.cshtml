@model int?
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // سمت سازمانی (EmployeeAssignment اصلیِ فعال) - نه نقش دسترسی و نه متن آزاد. فقط SystemAdmin می‌تواند تغییر دهد (سمت سرور هم اجرا می‌شود).
    var vacant = (List<(int PositionId, string Label)>)ViewBag.VacantPositions;
    var primaries = (Dictionary<int, (int PositionId, string Label)>)ViewBag.PrimaryPositions;
    var can = (bool)ViewBag.CanAssignPosition;
    (int PositionId, string Label)? current = Model.HasValue && primaries.TryGetValue(Model.Value, out var c) ? c : null;
}
<label class="form-label">@Localizer["Organizational position"]</label>
@if (can)
{
    <input type="hidden" name="positionSubmitted" value="true" />
    <select name="positionId" class="form-select">
        <option value="">@Localizer["-- no position --"]</option>
        @if (current != null) { <option value="@current.Value.PositionId" selected>@current.Value.Label</option> }
        @foreach (var p in vacant) { <option value="@p.PositionId">@p.Label</option> }
    </select>
    <div class="form-text">@Localizer["Only vacant active positions are listed. The assignment is created through the organization structure."]</div>
}
else
{
    <input class="form-control" value="@(current?.Label ?? "—")" disabled aria-label="@Localizer["Organizational position"]" />
    <div class="form-text">@Localizer["Emp_PositionAdminOnly"]</div>
}
