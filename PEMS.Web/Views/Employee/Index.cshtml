@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EmployeeListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var departments = ((IEnumerable<dynamic>)ViewBag.Departments).ToList();
    var disciplines = ((IEnumerable<dynamic>)ViewBag.Disciplines).ToList();
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var personnelTypes = new[] { "Internal", "Contractor", "External", "Temporary" };
    var departmentId = (int?)ViewBag.SelectedDepartmentId;
    var disciplineId = (int?)ViewBag.SelectedDisciplineId;
    var q = (string?)ViewBag.SearchTerm;
    var departmentName = departmentId.HasValue ? (string?)departments.FirstOrDefault(d => (int)d.DepartmentId == departmentId.Value)?.Name : null;
    var disciplineName = disciplineId.HasValue ? (string?)disciplines.FirstOrDefault(d => (int)d.DisciplineId == disciplineId.Value)?.Name : null;
    var filterCount = (departmentId.HasValue ? 1 : 0) + (disciplineId.HasValue ? 1 : 0);

    string Query(string? skip)
    {
        var parts = new List<string>();
        if (departmentId.HasValue && skip != "department") parts.Add($"departmentId={departmentId}");
        if (disciplineId.HasValue && skip != "discipline") parts.Add($"disciplineId={disciplineId}");
        if (!string.IsNullOrWhiteSpace(q) && skip != "q") parts.Add($"q={Uri.EscapeDataString(q)}");
        return string.Join("&", parts);
    }
    string Without(string key) { var s = Query(key); return Url.Action("Index") + (s.Length > 0 ? "?" + s : ""); }
    string TypeText(string? t) => VdrUi.Loc(Localizer, "EmL_Type_", t);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component. The search opens over the title; department and discipline
   are filters with chips; Export and New are toolbar tools; the create and edit modals stay (SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["EmL_Title"]" heading-title="@Localizer["EmL_Hint"]" total="@Model.TotalCount">
            <pems-list-search id="emSearch" action="@Url.Action("Index")" input-id="emQ" name="q" value="@q" placeholder="@Localizer["EmL_SearchPlaceholder"]">
                @if (departmentId.HasValue) { <input type="hidden" name="departmentId" value="@departmentId" /> }
                @if (disciplineId.HasValue) { <input type="hidden" name="disciplineId" value="@disciplineId" /> }
            </pems-list-search>
            <pems-list-tools search-for="emSearch">
                <pems-list-filters form-id="emFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    @if (!string.IsNullOrWhiteSpace(q)) { <input type="hidden" name="q" value="@q" /> }
                    <pems-list-filter-select id="emFilterDepartment" name="departmentId" label="@Localizer["EmL_Department"]" value="@departmentId?.ToString()"
                                             all-text="@Localizer["EmL_AllDepartments"]" items="@departments.Select(d => new SelectListItem((string)d.Name, ((int)d.DepartmentId).ToString()))" />
                    <pems-list-filter-select id="emFilterDiscipline" name="disciplineId" label="@Localizer["Ed_Discipline"]" value="@disciplineId?.ToString()"
                                             all-text="@Localizer["Eq_AllDisciplines"]" items="@disciplines.Select(d => new SelectListItem((string)d.Name, ((int)d.DisciplineId).ToString()))" />
                </pems-list-filters>
                <pems-list-export href="@Url.Action("Export")" />
                <pems-list-reset-columns grid-key="Employee" />
                <pems-list-new modal="createEmpModal" text="@Localizer["EmL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrWhiteSpace(q)) { <pems-list-chip label="@Localizer["Ed_Search"]" value="@q" remove-href="@Without("q")" /> }
            @if (departmentId.HasValue) { <pems-list-chip label="@Localizer["EmL_Department"]" value="@(departmentName ?? departmentId.ToString())" remove-href="@Without("department")" /> }
            @if (disciplineId.HasValue) { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@(disciplineName ?? disciplineId.ToString())" remove-href="@Without("discipline")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Employee" empty="@(!Model.Items.Any())" empty-text="@Localizer["EmL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="code" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">@Localizer["MiL_Code"]</th>
                        <th data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="260" style="width:180px">@Localizer["DpL_Name"]</th>
                        <th data-col-key="position" data-resizable="true" data-min-width="100" data-max-width="240" style="width:150px" class="vs-hide-md">@Localizer["EmL_Position"]</th>
                        <th data-col-key="department" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["EmL_Department"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="personnelType" data-resizable="true" data-min-width="100" data-max-width="240" style="width:150px" class="vs-hide-md">@Localizer["EmL_PersonnelType"]</th>
                        <th data-col-key="email" data-resizable="true" data-min-width="120" data-max-width="260" style="width:170px" class="vs-hide-md">@Localizer["EmL_Email"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:100px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@e.PersonnelCode</span></td>
                            <td><a asp-action="Details" asp-route-id="@e.EmployeeId" class="lp-subject">@e.FirstName @e.LastName</a></td>
                            <td class="small text-muted vs-hide-md">@e.Position</td>
                            <td class="small">@e.DepartmentName</td>
                            <td class="small vs-hide-md">@e.DisciplineName</td>
                            <td class="small vs-hide-md">@TypeText(e.PersonnelType)@(e.PersonnelType != "Internal" && e.VendorId.HasValue ? $" ({e.VendorName})" : "")</td>
                            <td class="small vs-hide-md">@e.Email</td>
                            <td><span class="vs-pill @(e.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@(e.IsActive ? Localizer["UsL_Active"] : Localizer["UsL_Inactive"])</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="lp-act lp-act--always" data-bs-toggle="modal" data-bs-target="#editEmpModal_@e.EmployeeId" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"] @e.FirstName @e.LastName"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                                    <button type="submit" class="lp-act lp-act--always @(e.IsActive ? "text-danger" : "text-success")" title="@(e.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"])" aria-label="@(e.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"]) @e.FirstName @e.LastName"><i class="bi @(e.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Employee",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createEmpModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["EmL_New"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@Localizer["Personnel Code"]</label><input name="personnelCode" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["First Name"]</label><input name="firstName" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Last Name"]</label><input name="lastName" class="form-control" required /></div>
                        <div class="col-md-6"><partial name="_PositionSelect" model="(int?)null" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Email"]</label><input name="email" type="email" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Phone"]</label><input name="phone" class="form-control" /></div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Department"]</label>
                            <select name="departmentId" class="form-select" required>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select" required>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Personnel Type"]</label>
                            <select name="personnelType" class="form-select" onchange="document.getElementById('createVendorField').style.display = this.value === 'Internal' ? 'none' : ''">
                                @foreach (var t in personnelTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="col-md-3" id="createVendorField" style="display:none;">
                            <label class="form-label">@Localizer["Vendor"]</label>
                            <select name="vendorId" class="form-select">
                                <option value="">@Localizer["-- انتخاب --"]</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                            </select>
                        </div>

                        <div class="col-md-3"><label class="form-label">@Localizer["Hire Date"]</label><input name="hireDate" type="date" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Location / Site"]</label><input name="location" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Shift"]</label><input name="shift" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Home Address"]</label><input name="homeAddress" class="form-control" /></div>

                        <div class="col-12"><hr /></div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="createUser" value="true" id="createUserCheck"
                                       onclick="document.getElementById('createUserFields').style.display = this.checked ? '' : 'none';">
                                <label class="form-check-label fw-bold" for="createUserCheck">
                                    <i class="bi bi-person-badge"></i> آیا نیاز است یوزر لاگین هم برای این کارمند ساخته بشه؟
                                </label>
                            </div>
                        </div>
                        <div id="createUserFields" style="display:none;" class="col-12">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">@Localizer["Username"]</label>
                                    <input name="userName" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-6">
                                    <p class="text-muted small mb-0 mt-4">یک رمز یک‌بارمصرف تصادفی ساخته و بعد از ثبت فقط یک بار نمایش داده می‌شود؛ در اولین ورود باید عوض شود.</p>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">@Localizer["نقش‌ها"]</label>
                                    <div class="row">
                                        @foreach (var role in (IEnumerable<string>)ViewBag.AllRoles)
                                        {
                                            <div class="col-6 col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role" id="empRole_@role">
                                                    <label class="form-check-label small" for="empRole_@role">@role</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var e in Model.Items)
{
    <div class="modal fade" id="editEmpModal_@e.EmployeeId" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["EmL_Edit"]</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label">@Localizer["Personnel Code"]</label><input name="personnelCode" value="@e.PersonnelCode" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">@Localizer["First Name"]</label><input name="firstName" value="@e.FirstName" class="form-control" required /></div>
                            <div class="col-md-4"><label class="form-label">@Localizer["Last Name"]</label><input name="lastName" value="@e.LastName" class="form-control" required /></div>
                            <div class="col-md-6"><partial name="_PositionSelect" model="(int?)e.EmployeeId" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Email"]</label><input name="email" value="@e.Email" type="email" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Phone"]</label><input name="phone" value="@e.Phone" class="form-control" /></div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Department"]</label>
                                <select name="departmentId" class="form-select" required>
                                    @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(d.DepartmentId == e.DepartmentId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)departments).Any(x => x.DepartmentId == e.DepartmentId)) { <option value="@e.DepartmentId" selected>@e.DepartmentName (@Localizer["Org_Inactive"])</option> }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Discipline"]</label>
                                <select name="disciplineId" class="form-select" required>
                                    @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == e.DisciplineId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)disciplines).Any(x => x.DisciplineId == e.DisciplineId)) { <option value="@e.DisciplineId" selected>@e.DisciplineName (@Localizer["Org_Inactive"])</option> }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Personnel Type"]</label>
                                <select name="personnelType" class="form-select" onchange="document.getElementById('editVendorField_@e.EmployeeId').style.display = this.value === 'Internal' ? 'none' : ''">
                                    @foreach (var t in personnelTypes) { <option value="@t" selected="@(t == e.PersonnelType)">@t</option> }
                                </select>
                            </div>
                            <div class="col-md-3" id="editVendorField_@e.EmployeeId" style="display:@(e.PersonnelType == "Internal" ? "none" : "")">
                                <label class="form-label">@Localizer["Vendor"]</label>
                                <select name="vendorId" class="form-select">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == e.VendorId)">@v.Name</option> }
                                </select>
                            </div>

                            <div class="col-md-3"><label class="form-label">@Localizer["Hire Date"]</label><input name="hireDate" type="date" value="@(e.HireDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Location / Site"]</label><input name="location" value="@e.Location" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Shift"]</label><input name="shift" value="@e.Shift" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Home Address"]</label><input name="homeAddress" value="@e.HomeAddress" class="form-control" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
