@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EmployeeListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var departments = (IEnumerable<dynamic>)ViewBag.Departments;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var personnelTypes = new[] { "Internal", "Contractor", "External", "Temporary" };

    var qsParts = new List<string>();
    if (ViewBag.SelectedDepartmentId != null) qsParts.Add($"departmentId={ViewBag.SelectedDepartmentId}");
    if (ViewBag.SelectedDisciplineId != null) qsParts.Add($"disciplineId={ViewBag.SelectedDisciplineId}");
    if (!string.IsNullOrWhiteSpace((string?)ViewBag.SearchTerm)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.SearchTerm)}");
    var existingQueryString = string.Join("&", qsParts);
}

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="departmentId" class="form-select form-select-sm">
                <option value="">All Departments</option>
                @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(d.DepartmentId == (int?)ViewBag.SelectedDepartmentId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3"><input name="q" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search name, code, email..." /></div>
        <div class="col-md-3 d-flex gap-2">
            <pems-button tone="primary" size="small" css="flex-fill" type="submit"><i class="bi bi-funnel"></i> @Localizer["Filter"]</pems-button>
            <pems-button tone="danger" size="small" outline="true" as="a" asp-action="Index" title="@Localizer["Reset"]"><i class="bi bi-x-lg"></i></pems-button>
            <pems-button tone="neutral" size="small" outline="true" css="flex-fill" type="button" data-bs-toggle="modal" data-bs-target="#createEmpModal">
                <i class="bi bi-person-plus"></i> @Localizer["New"]
            </pems-button>
        </div>
    </form>
    <div class="d-flex gap-2 mt-2">
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Export"><i class="bi bi-file-earmark-excel"></i> @Localizer["Export"]</pems-button>
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="PemsDataGrid.resetColumns('Employee')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </pems-button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise pems-grid-table" data-grid-key="Employee">
        <thead>
            <tr>
                <th data-col-key="code" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">@Localizer["Code"]</th>
                <th data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="260" style="width:170px">@Localizer["Name"]</th>
                <th data-col-key="position" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">Position</th>
                <th data-col-key="department" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Department"]</th>
                <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Discipline"]</th>
                <th data-col-key="personnelType" data-resizable="true" data-min-width="100" data-max-width="240" style="width:160px">@Localizer["Personnel Type"]</th>
                <th data-col-key="email" data-resizable="true" data-min-width="120" data-max-width="260" style="width:170px">@Localizer["Email"]</th>
                <th data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["Status"]</th>
                <th data-col-key="actions" data-resizable="false" style="width:90px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td>@e.PersonnelCode</td>
                    <td><a asp-action="Details" asp-route-id="@e.EmployeeId">@e.FirstName @e.LastName</a></td>
                    <td class="small text-muted">@e.Position</td>
                    <td class="small">@e.DepartmentName</td>
                    <td class="small">@e.DisciplineName</td>
                    <td class="small">@e.PersonnelType@(e.PersonnelType != "Internal" && e.VendorId.HasValue ? $" ({e.VendorName})" : "")</td>
                    <td class="small">@e.Email</td>
                    <td><pems-badge tone="@(e.IsActive ? "success" : "neutral")">@(e.IsActive ? "Active" : "Inactive")</pems-badge></td>
                    <td class="text-end">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#editEmpModal_@e.EmployeeId">
                            <i class="bi bi-pencil"></i>
                        </pems-button>
                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                            <button type="submit" class="btn btn-sm btn-outline-@(e.IsActive ? "danger" : "success")">
                                <i class="bi @(e.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No employees found.</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Employee",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = existingQueryString
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Employee');
        });
    </script>
}

<div class="modal fade" id="createEmpModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Employee</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@Localizer["Personnel Code"]</label><input name="personnelCode" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["First Name"]</label><input name="firstName" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Last Name"]</label><input name="lastName" class="form-control" required /></div>
                        <div class="col-md-6"><partial name="_PositionSelect" model="(int?)null" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Email"]</label><input name="email" type="email" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Phone"]</label><input name="phone" class="form-control" /></div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Department"]</label>
                            <select name="departmentId" class="form-select" required>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select" required>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Localizer["Personnel Type"]</label>
                            <select name="personnelType" class="form-select" onchange="document.getElementById('createVendorField').style.display = this.value === 'Internal' ? 'none' : ''">
                                @foreach (var t in personnelTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="col-md-3" id="createVendorField" style="display:none;">
                            <label class="form-label">@Localizer["Vendor"]</label>
                            <select name="vendorId" class="form-select">
                                <option value="">@Localizer["-- انتخاب --"]</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                            </select>
                        </div>

                        <div class="col-md-3"><label class="form-label">@Localizer["Hire Date"]</label><input name="hireDate" type="date" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Location / Site"]</label><input name="location" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Shift"]</label><input name="shift" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@Localizer["Home Address"]</label><input name="homeAddress" class="form-control" /></div>

                        <div class="col-12"><hr /></div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="createUser" value="true" id="createUserCheck"
                                       onclick="document.getElementById('createUserFields').style.display = this.checked ? '' : 'none';">
                                <label class="form-check-label fw-bold" for="createUserCheck">
                                    <i class="bi bi-person-badge"></i> آیا نیاز است یوزر لاگین هم برای این کارمند ساخته بشه؟
                                </label>
                            </div>
                        </div>
                        <div id="createUserFields" style="display:none;" class="col-12">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">@Localizer["Username"]</label>
                                    <input name="userName" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-6">
                                    <p class="text-muted small mb-0 mt-4">یک رمز یک‌بارمصرف تصادفی ساخته و بعد از ثبت فقط یک بار نمایش داده می‌شود؛ در اولین ورود باید عوض شود.</p>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">@Localizer["نقش‌ها"]</label>
                                    <div class="row">
                                        @foreach (var role in (IEnumerable<string>)ViewBag.AllRoles)
                                        {
                                            <div class="col-6 col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role" id="empRole_@role">
                                                    <label class="form-check-label small" for="empRole_@role">@role</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var e in Model.Items)
{
    <div class="modal fade" id="editEmpModal_@e.EmployeeId" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                    <div class="modal-header"><h6 class="modal-title">Edit Employee</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label">@Localizer["Personnel Code"]</label><input name="personnelCode" value="@e.PersonnelCode" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">@Localizer["First Name"]</label><input name="firstName" value="@e.FirstName" class="form-control" required /></div>
                            <div class="col-md-4"><label class="form-label">@Localizer["Last Name"]</label><input name="lastName" value="@e.LastName" class="form-control" required /></div>
                            <div class="col-md-6"><partial name="_PositionSelect" model="(int?)e.EmployeeId" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Email"]</label><input name="email" value="@e.Email" type="email" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">@Localizer["Phone"]</label><input name="phone" value="@e.Phone" class="form-control" /></div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Department"]</label>
                                <select name="departmentId" class="form-select" required>
                                    @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(d.DepartmentId == e.DepartmentId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)departments).Any(x => x.DepartmentId == e.DepartmentId)) { <option value="@e.DepartmentId" selected>@e.DepartmentName (@Localizer["Org_Inactive"])</option> }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Discipline"]</label>
                                <select name="disciplineId" class="form-select" required>
                                    @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == e.DisciplineId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)disciplines).Any(x => x.DisciplineId == e.DisciplineId)) { <option value="@e.DisciplineId" selected>@e.DisciplineName (@Localizer["Org_Inactive"])</option> }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@Localizer["Personnel Type"]</label>
                                <select name="personnelType" class="form-select" onchange="document.getElementById('editVendorField_@e.EmployeeId').style.display = this.value === 'Internal' ? 'none' : ''">
                                    @foreach (var t in personnelTypes) { <option value="@t" selected="@(t == e.PersonnelType)">@t</option> }
                                </select>
                            </div>
                            <div class="col-md-3" id="editVendorField_@e.EmployeeId" style="display:@(e.PersonnelType == "Internal" ? "none" : "")">
                                <label class="form-label">@Localizer["Vendor"]</label>
                                <select name="vendorId" class="form-select">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == e.VendorId)">@v.Name</option> }
                                </select>
                            </div>

                            <div class="col-md-3"><label class="form-label">@Localizer["Hire Date"]</label><input name="hireDate" type="date" value="@(e.HireDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Location / Site"]</label><input name="location" value="@e.Location" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Shift"]</label><input name="shift" value="@e.Shift" class="form-control" /></div>
                            <div class="col-md-3"><label class="form-label">@Localizer["Home Address"]</label><input name="homeAddress" value="@e.HomeAddress" class="form-control" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
