@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EmployeeListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var departments = ((IEnumerable<dynamic>)ViewBag.Departments).ToList();
    var disciplines = ((IEnumerable<dynamic>)ViewBag.Disciplines).ToList();
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var personnelTypes = new[] { "Internal", "Contractor", "External", "Temporary" };
    var departmentId = (int?)ViewBag.SelectedDepartmentId;
    var disciplineId = (int?)ViewBag.SelectedDisciplineId;
    var q = (string?)ViewBag.SearchTerm;
    var departmentName = departmentId.HasValue ? (string?)departments.FirstOrDefault(d => (int)d.DepartmentId == departmentId.Value)?.Name : null;
    var disciplineName = disciplineId.HasValue ? (string?)disciplines.FirstOrDefault(d => (int)d.DisciplineId == disciplineId.Value)?.Name : null;
    var filterCount = (departmentId.HasValue ? 1 : 0) + (disciplineId.HasValue ? 1 : 0);

    string Query(string? skip)
    {
        var parts = new List<string>();
        if (departmentId.HasValue && skip != "department") parts.Add($"departmentId={departmentId}");
        if (disciplineId.HasValue && skip != "discipline") parts.Add($"disciplineId={disciplineId}");
        if (!string.IsNullOrWhiteSpace(q) && skip != "q") parts.Add($"q={Uri.EscapeDataString(q)}");
        return string.Join("&", parts);
    }
    string Without(string key) { var s = Query(key); return Url.Action("Index") + (s.Length > 0 ? "?" + s : ""); }
    string TypeText(string? t) => VdrUi.Loc(Localizer, "EmL_Type_", t);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component. The search opens over the title; department and discipline
   are filters with chips; Export and New are toolbar tools; the create and edit modals stay (SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["EmL_Title"]" heading-title="@Localizer["EmL_Hint"]" total="@Model.TotalCount">
            <pems-list-search id="emSearch" action="@Url.Action("Index")" input-id="emQ" name="q" value="@q" placeholder="@Localizer["EmL_SearchPlaceholder"]">
                @if (departmentId.HasValue) { <input type="hidden" name="departmentId" value="@departmentId" /> }
                @if (disciplineId.HasValue) { <input type="hidden" name="disciplineId" value="@disciplineId" /> }
            </pems-list-search>
            <pems-list-tools search-for="emSearch">
                <pems-list-filters form-id="emFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    @if (!string.IsNullOrWhiteSpace(q)) { <input type="hidden" name="q" value="@q" /> }
                    <pems-list-filter-select id="emFilterDepartment" name="departmentId" label="@Localizer["EmL_Department"]" value="@departmentId?.ToString()"
                                             all-text="@Localizer["EmL_AllDepartments"]" items="@departments.Select(d => new SelectListItem((string)d.Name, ((int)d.DepartmentId).ToString()))" />
                    <pems-list-filter-select id="emFilterDiscipline" name="disciplineId" label="@Localizer["Ed_Discipline"]" value="@disciplineId?.ToString()"
                                             all-text="@Localizer["Eq_AllDisciplines"]" items="@disciplines.Select(d => new SelectListItem((string)d.Name, ((int)d.DisciplineId).ToString()))" />
                </pems-list-filters>
                <pems-list-export href="@Url.Action("Export")" />
                <pems-list-reset-columns grid-key="Employee" />
                <pems-list-new modal="createEmpModal" text="@Localizer["EmL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrWhiteSpace(q)) { <pems-list-chip label="@Localizer["Ed_Search"]" value="@q" remove-href="@Without("q")" /> }
            @if (departmentId.HasValue) { <pems-list-chip label="@Localizer["EmL_Department"]" value="@(departmentName ?? departmentId.ToString())" remove-href="@Without("department")" /> }
            @if (disciplineId.HasValue) { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@(disciplineName ?? disciplineId.ToString())" remove-href="@Without("discipline")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Employee" empty="@(!Model.Items.Any())" empty-text="@Localizer["EmL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-110" data-col-key="code" data-resizable="true" data-min-width="80" data-max-width="160">@Localizer["MiL_Code"]</pems-table-header>
                        <pems-table-header class="pems-w-180" data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["DpL_Name"]</pems-table-header>
                        <pems-table-header data-col-key="position" data-resizable="true" data-min-width="100" data-max-width="240" class="vs-hide-md pems-w-150">@Localizer["EmL_Position"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="department" data-resizable="true" data-min-width="90" data-max-width="200">@Localizer["EmL_Department"]</pems-table-header>
                        <pems-table-header data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" class="vs-hide-md pems-w-130">@Localizer["Ed_Discipline"]</pems-table-header>
                        <pems-table-header data-col-key="personnelType" data-resizable="true" data-min-width="100" data-max-width="240" class="vs-hide-md pems-w-150">@Localizer["EmL_PersonnelType"]</pems-table-header>
                        <pems-table-header data-col-key="email" data-resizable="true" data-min-width="120" data-max-width="260" class="vs-hide-md pems-w-170">@Localizer["EmL_Email"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="160">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var e in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><span class="vs-num">@e.PersonnelCode</span></pems-table-cell>
                            <pems-table-cell><a asp-action="Details" asp-route-id="@e.EmployeeId" class="lp-subject">@e.FirstName @e.LastName</a></pems-table-cell>
                            <pems-table-cell class="small text-muted vs-hide-md">@e.Position</pems-table-cell>
                            <pems-table-cell class="small">@e.DepartmentName</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@e.DisciplineName</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@TypeText(e.PersonnelType)@(e.PersonnelType != "Internal" && e.VendorId.HasValue ? $" ({e.VendorName})" : "")</pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@e.Email</pems-table-cell>
                            <pems-table-cell><span class="vs-pill @(e.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@(e.IsActive ? Localizer["UsL_Active"] : Localizer["UsL_Inactive"])</span></pems-table-cell>
                            <pems-table-cell class="text-end text-nowrap">
                                <pems-button plain="true" type="button" css="lp-act lp-act--always" data-bs-toggle="modal" data-bs-target="#editEmpModal_@e.EmployeeId" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"] @e.FirstName @e.LastName"><pems-icon name="bi-pencil" aria-hidden="true" /></pems-button>
                                <pems-form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                                    <pems-button plain="true" type="submit" css="lp-act lp-act--always @(e.IsActive ? "text-danger" : "text-success")" title="@(e.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"])" aria-label="@(e.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"]) @e.FirstName @e.LastName"><pems-icon css="@(e.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true" /></pems-button>
                                </pems-form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Employee",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal size="large" id="createEmpModal" tabindex="-1">
            <pems-form asp-action="Create" method="post">
                <pems-modal-header>@Localizer["EmL_New"]</pems-modal-header>
                <pems-modal-body>
                    <pems-row gap="3">
                        <pems-col md="4"><pems-label>@Localizer["Personnel Code"]</pems-label><pems-input name="personnelCode" /></pems-col>
                        <pems-col md="4"><pems-label>@Localizer["First Name"]</pems-label><pems-input name="firstName" required /></pems-col>
                        <pems-col md="4"><pems-label>@Localizer["Last Name"]</pems-label><pems-input name="lastName" required /></pems-col>
                        <pems-col md="6"><partial name="_PositionSelect" model="(int?)null" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Email"]</pems-label><pems-input name="email" type="email" /></pems-col>
                        <pems-col md="6"><pems-label>@Localizer["Phone"]</pems-label><pems-input name="phone" /></pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Department"]</pems-label>
                            <pems-select name="departmentId" required>
                                @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Discipline"]</pems-label>
                            <pems-select name="disciplineId" required>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="3">
                            <pems-label>@Localizer["Personnel Type"]</pems-label>
                            <pems-select name="personnelType" onchange="document.getElementById('createVendorField').hidden = this.value === 'Internal'">
                                @foreach (var t in personnelTypes) { <option value="@t">@t</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="3" id="createVendorField" hidden>
                            <pems-label>@Localizer["Vendor"]</pems-label>
                            <pems-select name="vendorId">
                                <option value="">@Localizer["-- انتخاب --"]</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                            </pems-select>
                        </pems-col>

                        <pems-col md="3"><pems-label>@Localizer["Hire Date"]</pems-label><pems-date name="hireDate" /></pems-col>
                        <pems-col md="3"><pems-label>@Localizer["Location / Site"]</pems-label><pems-input name="location" /></pems-col>
                        <pems-col md="3"><pems-label>@Localizer["Shift"]</pems-label><pems-input name="shift" /></pems-col>
                        <pems-col md="3"><pems-label>@Localizer["Home Address"]</pems-label><pems-input name="homeAddress" /></pems-col>

                        <pems-col span="12"><hr /></pems-col>
                        <pems-col span="12">
                            <pems-check-row>
                                <pems-input kind="check" type="checkbox" name="createUser" value="true" id="createUserCheck" onclick="document.getElementById('createUserFields').hidden = !(this.checked);" />
                                <label class="form-check-label fw-bold" for="createUserCheck">
                                    <pems-icon name="bi-person-badge" /> آیا نیاز است یوزر لاگین هم برای این کارمند ساخته بشه؟
                                </label>
                            </pems-check-row>
                        </pems-col>
                        <pems-col span="12" id="createUserFields" hidden>
                            <pems-row gap="3">
                                <pems-col md="6">
                                    <pems-label css="small">@Localizer["Username"]</pems-label>
                                    <pems-input scale="small" name="userName" />
                                </pems-col>
                                <pems-col md="6">
                                    <p class="text-muted small mb-0 mt-4">یک رمز یک‌بارمصرف تصادفی ساخته و بعد از ثبت فقط یک بار نمایش داده می‌شود؛ در اولین ورود باید عوض شود.</p>
                                </pems-col>
                                <pems-col span="12">
                                    <pems-label css="small">@Localizer["نقش‌ها"]</pems-label>
                                    <pems-row>
                                        @foreach (var role in (IEnumerable<string>)ViewBag.AllRoles)
                                        {
                                            <pems-col span="6" md="4">
                                                <pems-check-row>
                                                    <pems-input kind="check" type="checkbox" name="selectedRoles" value="@role" id="empRole_@role" />
                                                    <label class="form-check-label small" for="empRole_@role">@role</label>
                                                </pems-check-row>
                                            </pems-col>
                                        }
                                    </pems-row>
                                </pems-col>
                            </pems-row>
                        </pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@foreach (var e in Model.Items)
{
    <pems-modal size="large" id="editEmpModal_@e.EmployeeId" tabindex="-1">
                <pems-form asp-action="Edit" method="post">
                    <input type="hidden" name="employeeId" value="@e.EmployeeId" />
                    <pems-modal-header>@Localizer["EmL_Edit"]</pems-modal-header>
                    <pems-modal-body>
                        <pems-row gap="3">
                            <pems-col md="4"><pems-label>@Localizer["Personnel Code"]</pems-label><pems-input name="personnelCode" value="@e.PersonnelCode" /></pems-col>
                            <pems-col md="4"><pems-label>@Localizer["First Name"]</pems-label><pems-input name="firstName" value="@e.FirstName" required /></pems-col>
                            <pems-col md="4"><pems-label>@Localizer["Last Name"]</pems-label><pems-input name="lastName" value="@e.LastName" required /></pems-col>
                            <pems-col md="6"><partial name="_PositionSelect" model="(int?)e.EmployeeId" /></pems-col>
                            <pems-col md="6"><pems-label>@Localizer["Email"]</pems-label><pems-input name="email" value="@e.Email" type="email" /></pems-col>
                            <pems-col md="6"><pems-label>@Localizer["Phone"]</pems-label><pems-input name="phone" value="@e.Phone" /></pems-col>
                            <pems-col md="3">
                                <pems-label>@Localizer["Department"]</pems-label>
                                <pems-select name="departmentId" required>
                                    @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(d.DepartmentId == e.DepartmentId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)departments).Any(x => x.DepartmentId == e.DepartmentId)) { <option value="@e.DepartmentId" selected>@e.DepartmentName (@Localizer["Org_Inactive"])</option> }
                                </pems-select>
                            </pems-col>
                            <pems-col md="3">
                                <pems-label>@Localizer["Discipline"]</pems-label>
                                <pems-select name="disciplineId" required>
                                    @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == e.DisciplineId)">@d.Name</option> }
                                    @if (!((IEnumerable<dynamic>)disciplines).Any(x => x.DisciplineId == e.DisciplineId)) { <option value="@e.DisciplineId" selected>@e.DisciplineName (@Localizer["Org_Inactive"])</option> }
                                </pems-select>
                            </pems-col>
                            <pems-col md="3">
                                <pems-label>@Localizer["Personnel Type"]</pems-label>
                                <pems-select name="personnelType" onchange="document.getElementById('editVendorField_@e.EmployeeId').hidden = this.value === 'Internal'">
                                    @foreach (var t in personnelTypes) { <option value="@t" selected="@(t == e.PersonnelType)">@t</option> }
                                </pems-select>
                            </pems-col>
                            <pems-col md="3" id="editVendorField_@e.EmployeeId" hidden="@(e.PersonnelType == "Internal")">
                                <pems-label>@Localizer["Vendor"]</pems-label>
                                <pems-select name="vendorId">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == e.VendorId)">@v.Name</option> }
                                </pems-select>
                            </pems-col>

                            <pems-col md="3"><pems-label>@Localizer["Hire Date"]</pems-label><pems-date name="hireDate" value="@(e.HireDate?.ToString("yyyy-MM-dd"))" /></pems-col>
                            <pems-col md="3"><pems-label>@Localizer["Location / Site"]</pems-label><pems-input name="location" value="@e.Location" /></pems-col>
                            <pems-col md="3"><pems-label>@Localizer["Shift"]</pems-label><pems-input name="shift" value="@e.Shift" /></pems-col>
                            <pems-col md="3"><pems-label>@Localizer["Home Address"]</pems-label><pems-input name="homeAddress" value="@e.HomeAddress" /></pems-col>
                        </pems-row>
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </pems-modal-footer>
                </pems-form>
            </pems-modal>
}

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
