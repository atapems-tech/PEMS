@model PEMS.Domain.Entities.Employee
@using System.Globalization
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@inject PEMS.Application.Organization.IOrganizationHierarchyService OrgHierarchy
@{
    var laborRates = (List<PEMS.Domain.Entities.EmployeeLaborRate>)ViewBag.LaborRates;
    var teamHistory = (List<PEMS.Domain.Entities.TeamMember>)ViewBag.TeamHistory;
    var employeeSkills = (List<PEMS.Domain.Entities.EmployeeSkill>)ViewBag.EmployeeSkills;
    var allSkills = (IEnumerable<dynamic>)ViewBag.AllSkills;
    var employeeQualifications = (List<PEMS.Domain.Entities.EmployeeQualification>)ViewBag.EmployeeQualifications;
    var allQualifications = (IEnumerable<dynamic>)ViewBag.AllQualifications;
    var employeeCertifications = (List<PEMS.Domain.Entities.EmployeeCertification>)ViewBag.EmployeeCertifications;
    var allCertifications = (IEnumerable<dynamic>)ViewBag.AllCertifications;
    var departments = (IEnumerable<dynamic>)ViewBag.Departments;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var personnelTypes = new[] { "Internal", "Contractor", "External", "Temporary" };

    // طبق «Employee Details — Stitch UI Redesign» بخش ۶: به‌جای نمایش هم‌زمان EN+FA (که
    // معماری فعلی PEMS ندارد)، برچسب‌ها بر اساس فرهنگ جاری (همان کوکی/سوییچر موجود در
    // _Layout) سوییچ می‌شوند - زیرساخت localization تکراری نمی‌شود
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string L(string en, string fa) => isRtl ? fa : en;
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    // طبق سند معماری Employee/Team: Employee فیلد Manager مستقل ندارد - از سرپرست تیمِ فعلی
    // (عضویت IsActive) مشتق می‌شود، نه یک فیلد تکراری
    var currentMembership = teamHistory.FirstOrDefault(x => x.IsActive);
    var manager = currentMembership?.Team?.SupervisorEmployee;   // سرپرست تیم (عملیاتی) - «مدیر مستقیم» نیست
    var directManager = await OrgHierarchy.GetDirectManagerAsync(Model.EmployeeId);
    var orgCtx = ViewBag.OrgContext as PEMS.Application.Organization.OrganizationalContext;
    var linkedUser = ViewBag.LinkedUser;

    string Initials(string? first, string? last)
    {
        var f = string.IsNullOrEmpty(first) ? "" : first[0].ToString();
        var l = string.IsNullOrEmpty(last) ? "" : last[0].ToString();
        return (f + l).ToUpperInvariant();
    }

    // طبق بخش ۱۹ سند: «انقضای گواهینامه باید قابل‌تشخیص باشد» - همون منطق سررسید کالیبراسیون ابزاردقیق
    string ExpiryStatus(DateTime? expiry)
    {
        if (!expiry.HasValue) return "Unknown";
        if (expiry.Value.Date < DateTime.Today) return "Overdue";
        if (expiry.Value.Date <= DateTime.Today.AddDays(30)) return "DueSoon";
        return "OK";
    }
    string ExpiryBadgeClass(string status) => status switch
    {
        "Overdue" => "bg-danger", "DueSoon" => "bg-warning text-dark", "OK" => "bg-success", _ => "bg-secondary"
    };
}

<!-- Profile Header -->
<div class="content-card mb-3 position-relative overflow-hidden">
    <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <img src="@Model.PhotoPath" class="rounded-4 flex-shrink-0" style="width:96px;height:96px;object-fit:cover;" alt="@Model.FirstName @Model.LastName" />
        }
        else
        {
            <div class="rounded-4 d-flex align-items-center justify-content-center bg-secondary-subtle text-secondary-emphasis flex-shrink-0" style="width:96px;height:96px;font-size:30px;font-weight:700;">
                @Initials(Model.FirstName, Model.LastName)
            </div>
        }
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h4 class="mb-0">@Model.FirstName @Model.LastName</h4>
                <pems-badge tone="none" css="rounded-pill @(Model.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis") d-inline-flex align-items-center gap-1">
                    <i class="bi bi-circle-fill" style="font-size:6px;"></i>
                    @L(Model.IsActive ? "Active" : "Inactive", Model.IsActive ? "فعال" : "غیرفعال")
                </pems-badge>
            </div>
            <p class="text-muted mb-1">
                @Dash(Model.Position) &bull; @Dash(Model.Department?.Name)
                @if (Model.Discipline != null) { <text>&bull; @Model.Discipline.Name</text> }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.PersonnelCode))
            {
                <p class="small text-muted font-monospace mb-3">ID: @Model.PersonnelCode</p>
            }
            <div class="d-flex gap-2 flex-wrap mt-2">
                <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                    <i class="bi bi-pencil"></i> @L("Edit Profile", "ویرایش پروفایل")
                </pems-button>
                <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">
                    <i class="bi bi-arrow-@(isRtl ? "right" : "left")"></i> @L("Back to list", "بازگشت به فهرست")
                </pems-button>
            </div>
        </div>
    </div>
</div>

<!-- Row 1: Employment Details (large) + Current Team (compact) -->
<div class="row g-3 mb-3 align-items-stretch">
    <div class="col-lg-8">
        <div class="content-card h-100">
            <h6 class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                <i class="bi bi-briefcase text-warning"></i>
                <span>@L("Employment Details", "جزئیات استخدام")</span>
            </h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Organizational Position", "سمت سازمانی")</p>
                    <p class="mb-0 fw-semibold">@Dash(orgCtx?.PrimaryPositionTitle)</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Position) && Model.Position != orgCtx?.PrimaryPositionTitle)
                    {
                        <p class="small text-muted mb-0">@L("Title on file", "عنوان ثبت‌شده"): @Model.Position</p>
                    }
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Department", "بخش")</p>
                    <p class="mb-0 fw-semibold">@Dash(Model.Department?.Name)</p>
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Discipline", "رشته")</p>
                    <p class="mb-0 fw-semibold">@Dash(Model.Discipline?.Name)</p>
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Team Supervisor", "سرپرست تیم")</p>
                    @if (manager != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-secondary-subtle text-secondary-emphasis d-flex align-items-center justify-content-center small fw-bold" style="width:24px;height:24px;">
                                @Initials(manager.FirstName, manager.LastName)
                            </div>
                            <a asp-action="Details" asp-route-id="@manager.EmployeeId" class="fw-semibold text-decoration-none">@manager.FirstName @manager.LastName</a>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 fw-semibold">—</p>
                    }
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Direct Manager", "مدیر مستقیم")</p>
                    @if (directManager.IssueCode == null && directManager.Managers.Count > 0)
                    {
                        @foreach (var dm in directManager.Managers)
                        {
                            <a asp-action="Details" asp-route-id="@dm.EmployeeId" class="fw-semibold text-decoration-none d-block">@dm.Name</a>
                        }
                    }
                    else
                    {
                        <p class="mb-0 fw-semibold">—</p>
                        <p class="small text-muted mb-0" title="@directManager.IssueCode">@(directManager.IssueCode == null ? "" : Localizer["Org_Issue_" + directManager.IssueCode].Value)</p>
                    }
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Hire Date", "تاریخ استخدام")</p>
                    <p class="mb-0 fw-semibold">@(Model.HireDate.HasValue ? Model.HireDate.Value.ToString("yyyy-MM-dd") : "—")</p>
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1">@L("Personnel Type", "نوع پرسنل")</p>
                    <p class="mb-0 fw-semibold">
                        @Model.PersonnelType
                        @if (Model.PersonnelType != "Internal" && Model.VendorRef != null)
                        {
                            <span class="text-muted fw-normal">(@Model.VendorRef.Name)</span>
                        }
                    </p>
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1"><i class="bi bi-geo-alt"></i> @L("Location", "مکان")</p>
                    <p class="mb-0 fw-semibold">@Dash(Model.Location)</p>
                </div>
                <div class="col-sm-6">
                    <p class="text-uppercase text-muted small mb-1"><i class="bi bi-clock"></i> @L("Shift", "شیفت")</p>
                    <p class="mb-0 fw-semibold">@Dash(Model.Shift)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card h-100">
            <h6 class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                <i class="bi bi-people text-warning"></i>
                <span>@L("Current Team", "تیم فعلی")</span>
            </h6>
            @if (currentMembership != null)
            {
                <p class="text-uppercase text-muted small mb-1">@L("Team", "تیم")</p>
                <p class="fw-semibold mb-2">@Dash(currentMembership.Team?.Name)</p>
                <p class="text-uppercase text-muted small mb-1">@L("Role in Team", "نقش در تیم")</p>
                <p class="fw-semibold mb-2">@Dash(currentMembership.Role?.Name)</p>
                <p class="text-uppercase text-muted small mb-1">@L("Member Since", "عضو از تاریخ")</p>
                <p class="fw-semibold mb-0">@currentMembership.JoinedDate.ToString("yyyy-MM-dd")</p>
            }
            else
            {
                <p class="text-muted small text-center py-3 mb-0">@L("No active team membership.", "عضویت فعالی در تیمی ثبت نشده.")</p>
            }
        </div>
    </div>
</div>

<!-- System Account & Authorization (roles belong to the user account; managed in Administration -> Users) -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="content-card">
            <h6 class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                <i class="bi bi-shield-lock text-warning"></i>
                <span>@L("System Account & Authorization", "حساب کاربری و دسترسی")</span>
            </h6>
            @if (linkedUser == null)
            {
                <p class="text-muted mb-0">@L("No system account is linked to this employee.", "حساب کاربری به این کارمند متصل نیست.")</p>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-sm-4">
                        <p class="text-uppercase text-muted small mb-1">@L("Username", "نام کاربری")</p>
                        <p class="mb-0 fw-semibold">@linkedUser.UserName</p>
                    </div>
                    <div class="col-sm-2">
                        <p class="text-uppercase text-muted small mb-1">@L("Status", "وضعیت")</p>
                        <p class="mb-0"><pems-badge tone="@(linkedUser.IsActive ? "success" : "neutral")">@(linkedUser.IsActive ? L("Active", "فعال") : L("Inactive", "غیرفعال"))</pems-badge></p>
                    </div>
                    <div class="col-sm-6">
                        <p class="text-uppercase text-muted small mb-1">@L("Roles", "نقش‌ها")</p>
                        <p class="mb-0">
                            @if (((IEnumerable<string>)linkedUser.Roles).Any())
                            {
                                foreach (var role in (IEnumerable<string>)linkedUser.Roles) { <pems-badge tone="info" css="me-1">@role</pems-badge> }
                            }
                            else { <span class="text-muted">—</span> }
                        </p>
                    </div>
                </div>
                @if (User.IsInRole(PEMS.Persistence.Identity.SystemRoles.SystemAdmin))
                {
                    <div class="mt-3">
                        <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@linkedUser.Id"><i class="bi bi-person-gear"></i> @L("Manage Access", "مدیریت دسترسی")</pems-button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Row 2: Contact Information (full width, 3 tiles) -->
<div class="content-card mb-3">
    <h6 class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
        <i class="bi bi-person-vcard text-warning"></i>
        <span>@L("Contact Information", "اطلاعات تماس")</span>
    </h6>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-body-tertiary h-100">
                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;">
                    <i class="bi bi-phone"></i>
                </div>
                <div>
                    <p class="text-uppercase text-muted small mb-1">@L("Mobile Phone", "تلفن همراه")</p>
                    <p class="fw-semibold mb-0 font-monospace">@Dash(Model.Phone)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-body-tertiary h-100">
                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;">
                    <i class="bi bi-envelope"></i>
                </div>
                <div class="overflow-hidden">
                    <p class="text-uppercase text-muted small mb-1">@L("Work Email", "ایمیل کاری")</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none text-truncate d-block">@Model.Email</a>
                    }
                    else
                    {
                        <p class="fw-semibold mb-0">—</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 bg-body-tertiary h-100">
                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;">
                    <i class="bi bi-house"></i>
                </div>
                <div>
                    <p class="text-uppercase text-muted small mb-1">@L("Home Address", "آدرس منزل")</p>
                    <p class="fw-semibold mb-0">@Dash(Model.HomeAddress)</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 3+: existing functionality (Labor Rate, Team History, Skills, Qualifications, Certifications) - preserved, restyled -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-cash-coin text-warning"></i> @L("Labor Rate", "نرخ دستمزد")</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#setRateModal">
                    <i class="bi bi-plus-lg"></i> @L("New Rate", "ثبت نرخ جدید")
                </pems-button>
            </div>
            <table class="table table-sm">
                <thead><tr><th>@L("Type", "نوع")</th><th>@L("Rate", "نرخ")</th><th>@L("From", "از تاریخ")</th><th>@L("To", "تا تاریخ")</th></tr></thead>
                <tbody>
                    @foreach (var r in laborRates)
                    {
                        <tr class="@(r.EffectiveTo == null ? "table-success" : "")">
                            <td>@r.RateType</td>
                            <td>@r.Rate.ToString("N0") @r.Currency</td>
                            <td class="small">@r.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                            <td class="small">@(r.EffectiveTo?.ToString("yyyy-MM-dd") ?? L("Current", "فعلی"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!laborRates.Any()) { <p class="text-muted small text-center py-2">@L("No rate recorded.", "نرخی ثبت نشده.")</p> }
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle"></i> @L(
                    "A new rate does not overwrite the previous one - it only closes it (EffectiveTo), preserving history. Past work order costs remain unchanged since the rate is snapshotted at time of use.",
                    "نرخ جدید، نرخ قبلی رو Overwrite نمی‌کنه - فقط می‌بندتش (EffectiveTo) و تاریخچه حفظ می‌شه. هزینه‌ی WorkOrderهای قدیمی هم تغییر نمی‌کنه چون نرخ موقع ثبت Snapshot می‌شه.")
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3 pb-2 border-bottom d-flex align-items-center gap-2"><i class="bi bi-diagram-3 text-warning"></i> @L("Team Membership History", "تاریخچه‌ی عضویت تیم")</h6>
            <table class="table table-sm">
                <thead><tr><th>@L("Team", "تیم")</th><th>@L("Role", "نقش")</th><th>@L("From", "از")</th><th>@L("To", "تا")</th></tr></thead>
                <tbody>
                    @foreach (var m in teamHistory)
                    {
                        <tr class="@(m.IsActive ? "table-success" : "")">
                            <td>@m.Team?.Name</td>
                            <td class="small">@m.Role?.Name</td>
                            <td class="small">@m.JoinedDate.ToString("yyyy-MM-dd")</td>
                            <td class="small">@(m.LeftDate?.ToString("yyyy-MM-dd") ?? (m.IsActive ? L("Current", "فعلی") : "-"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!teamHistory.Any()) { <p class="text-muted small text-center py-2">@L("No membership recorded.", "عضویتی ثبت نشده.")</p> }
        </div>
    </div>

    <div class="col-md-6">
        <div class="content-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-mortarboard text-warning"></i> @L("Skills", "مهارت‌ها")</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addSkillModal">
                    <i class="bi bi-plus-lg"></i> @L("Add", "افزودن")
                </pems-button>
            </div>
            <ul class="list-unstyled mb-0">
                @foreach (var es in employeeSkills)
                {
                    <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <span>
                            <span class="small">@es.Skill?.Name</span>
                            <pems-badge tone="neutral">@es.ProficiencyLevel</pems-badge>
                            @if (es.CertifiedDate.HasValue) { <span class="text-muted small">— @es.CertifiedDate.Value.ToString("yyyy-MM-dd")</span> }
                        </span>
                        <form asp-action="RemoveSkill" method="post" class="d-inline">
                            <input type="hidden" name="employeeSkillId" value="@es.EmployeeSkillId" />
                            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                            <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" onclick="return confirm('@L("Remove this skill?", "این مهارت حذف بشه؟")')"><i class="bi bi-x"></i></pems-button>
                        </form>
                    </li>
                }
            </ul>
            @if (!employeeSkills.Any()) { <p class="text-muted small text-center py-2 mb-0">@L("No skills recorded.", "مهارتی ثبت نشده.")</p> }
        </div>
    </div>

    <div class="col-md-6">
        <div class="content-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-patch-check text-warning"></i> @L("Qualifications", "صلاحیت‌ها")</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addQualificationModal">
                    <i class="bi bi-plus-lg"></i> @L("Add", "افزودن")
                </pems-button>
            </div>
            <ul class="list-unstyled mb-0">
                @foreach (var eq in employeeQualifications)
                {
                    var status = ExpiryStatus(eq.ExpiryDate);
                    <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <span>
                            <span class="small">@eq.Qualification?.Name</span>
                            @if (eq.ExpiryDate.HasValue) { <pems-badge tone="none" css="@ExpiryBadgeClass(status)">@status — @eq.ExpiryDate.Value.ToString("yyyy-MM-dd")</pems-badge> }
                            @if (!string.IsNullOrWhiteSpace(eq.Issuer)) { <span class="text-muted small">— @eq.Issuer</span> }
                        </span>
                        <form asp-action="RemoveQualification" method="post" class="d-inline">
                            <input type="hidden" name="employeeQualificationId" value="@eq.EmployeeQualificationId" />
                            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                            <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" onclick="return confirm('@L("Remove this qualification?", "این صلاحیت حذف بشه؟")')"><i class="bi bi-x"></i></pems-button>
                        </form>
                    </li>
                }
            </ul>
            @if (!employeeQualifications.Any()) { <p class="text-muted small text-center py-2 mb-0">@L("No qualifications recorded.", "صلاحیتی ثبت نشده.")</p> }
        </div>
    </div>

    <div class="col-md-6">
        <div class="content-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-award text-warning"></i> @L("Certifications", "گواهینامه‌ها")</h6>
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addCertificationModal">
                    <i class="bi bi-plus-lg"></i> @L("Add", "افزودن")
                </pems-button>
            </div>
            <ul class="list-unstyled mb-0">
                @foreach (var ec in employeeCertifications)
                {
                    var status = ExpiryStatus(ec.ExpiryDate);
                    <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                        <span>
                            <span class="small">@ec.Certification?.Name</span>
                            @if (!string.IsNullOrWhiteSpace(ec.CertificateNumber)) { <span class="text-muted small">#@ec.CertificateNumber</span> }
                            @if (ec.ExpiryDate.HasValue) { <pems-badge tone="none" css="@ExpiryBadgeClass(status)">@status — @ec.ExpiryDate.Value.ToString("yyyy-MM-dd")</pems-badge> }
                        </span>
                        <form asp-action="RemoveCertification" method="post" class="d-inline">
                            <input type="hidden" name="employeeCertificationId" value="@ec.EmployeeCertificationId" />
                            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                            <pems-button tone="danger" size="small" outline="true" css="py-0 px-1" type="submit" onclick="return confirm('@L("Remove this certification?", "این گواهینامه حذف بشه؟")')"><i class="bi bi-x"></i></pems-button>
                        </form>
                    </li>
                }
            </ul>
            @if (!employeeCertifications.Any()) { <p class="text-muted small text-center py-2 mb-0">@L("No certifications recorded.", "گواهینامه‌ای ثبت نشده.")</p> }
        </div>
    </div>
</div>

<!-- Edit Profile Modal - posts to the same Edit action used by the Index grid -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                <input type="hidden" name="returnToDetails" value="true" />
                <div class="modal-header"><h6 class="modal-title">@L("Edit Profile", "ویرایش پروفایل")</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@L("Personnel Code", "کد پرسنلی")</label><input name="personnelCode" value="@Model.PersonnelCode" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@L("First Name", "نام")</label><input name="firstName" value="@Model.FirstName" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">@L("Last Name", "نام خانوادگی")</label><input name="lastName" value="@Model.LastName" class="form-control" required /></div>
                        <div class="col-md-6"><partial name="_PositionSelect" model="(int?)Model.EmployeeId" /></div>
                        <div class="col-md-6"><label class="form-label">@L("Email", "ایمیل")</label><input name="email" value="@Model.Email" type="email" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@L("Phone", "تلفن")</label><input name="phone" value="@Model.Phone" class="form-control" /></div>
                        <div class="col-md-3">
                            <label class="form-label">@L("Department", "بخش")</label>
                            <select name="departmentId" class="form-select" required>
                                @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(d.DepartmentId == Model.DepartmentId)">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@L("Discipline", "رشته")</label>
                            <select name="disciplineId" class="form-select" required>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == Model.DisciplineId)">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@L("Personnel Type", "نوع پرسنل")</label>
                            <select name="personnelType" class="form-select" onchange="document.getElementById('editProfileVendorField').style.display = this.value === 'Internal' ? 'none' : ''">
                                @foreach (var t in personnelTypes) { <option value="@t" selected="@(t == Model.PersonnelType)">@t</option> }
                            </select>
                        </div>
                        <div class="col-md-3" id="editProfileVendorField" style="display:@(Model.PersonnelType == "Internal" ? "none" : "")">
                            <label class="form-label">@L("Vendor", "فروشنده")</label>
                            <select name="vendorId" class="form-select">
                                <option value="">-- @L("select", "انتخاب") --</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == Model.VendorId)">@v.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-3"><label class="form-label">@L("Hire Date", "تاریخ استخدام")</label><input name="hireDate" type="date" value="@(Model.HireDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@L("Location / Site", "مکان")</label><input name="location" value="@Model.Location" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@L("Shift", "شیفت")</label><input name="shift" value="@Model.Shift" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">@L("Home Address", "آدرس منزل")</label><input name="homeAddress" value="@Model.HomeAddress" class="form-control" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@L("Cancel", "انصراف")</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@L("Save", "ذخیره")</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

