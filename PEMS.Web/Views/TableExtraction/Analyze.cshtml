@model PEMS.Application.AI.Models.AIAnalysisResult
@using PEMS.Domain.Entities
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var attachment = (DocumentAttachment)ViewBag.Attachment;
    var table = Model.ExtractedTableData;
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">@attachment.FileName</h5>
            <span class="text-muted small">Table extraction test result - nothing was saved to the database.</span>
        </div>
        <pems-flex gap="2">
            @if (Model.Success && table != null && table.Rows.Any())
            {
                <form asp-action="StageForReview" method="post" class="d-inline">
                    <input type="hidden" name="attachmentId" value="@attachment.AttachmentId" />
                    <pems-button tone="primary" size="small" type="submit">
                        <pems-icon name="bi-link-45deg" /> Stage for Review (link to Equipment)
                    </pems-button>
                </form>
            }
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-left" /> Back</pems-button>
        </pems-flex>
    </pems-flex>
</pems-content-card>

@if (!Model.Success)
{
    <pems-content-card>
        <pems-alert tone="danger" css="mb-0">@Model.ErrorMessage</pems-alert>
    </pems-content-card>
    return;
}

<pems-content-card css="mb-3">
    <pems-stat-grid>
        <pems-stat label="Rows extracted">@(table?.RowCount ?? 0)</pems-stat>
        <pems-stat label="@Localizer["Confidence"]">@Model.Confidence.ToString("P0")</pems-stat>
        <pems-stat label="Used OCR">@(Model.UsedOcr ? "Yes" : "No")</pems-stat>
        <pems-stat label="Warnings">@Model.Warnings.Count</pems-stat>
    </pems-stat-grid>
    <p class="text-muted small mt-2 mb-0">@Model.Summary</p>
</pems-content-card>

@if (Model.Warnings.Any())
{
    <pems-content-card css="mb-3">
        <pems-alert tone="warning" css="mb-0">
            <strong>Warnings reported by the model:</strong>
            <ul class="mb-0">
                @foreach (var w in Model.Warnings)
                {
                    <li>@w</li>
                }
            </ul>
        </pems-alert>
    </pems-content-card>
}

@if (table?.DocumentInfo != null)
{
    var info = table.DocumentInfo;
    <pems-content-card css="mb-3">
        <h6 class="mb-2">Document Info</h6>
        <pems-row gap="2" css="small">
            <pems-col md="3"><strong>Document No.</strong><div>@(info.DocumentNo ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["Title"]</strong><div>@(info.Title ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["Type"]</strong><div>@(info.DocumentType ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["Discipline"]</strong><div>@(info.Discipline ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["Revision"]</strong><div>@(info.RevisionNo ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["Vendor"]</strong><div>@(info.VendorName ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>Area / Unit</strong><div>@(info.Area ?? "N/A") / @(info.Unit ?? "N/A")</div></pems-col>
            <pems-col md="3"><strong>@Localizer["System"]</strong><div>@(info.System ?? "N/A")</div></pems-col>
        </pems-row>
    </pems-content-card>
}

<pems-content-card>
    <h6 class="mb-2">Rows (@(table?.Rows.Count ?? 0))</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise" scale="small">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>Tag No.</pems-table-header><pems-table-header>@Localizer["Description"]</pems-table-header><pems-table-header>Signal</pems-table-header><pems-table-header>JB / Terminal</pems-table-header>
                    <pems-table-header>Cable</pems-table-header><pems-table-header>Marshalling</pems-table-header><pems-table-header>I/O Card / Ch</pems-table-header><pems-table-header>@Localizer["Loop"]</pems-table-header>
                    <pems-table-header>@Localizer["System"]</pems-table-header><pems-table-header>Spare</pems-table-header><pems-table-header>@Localizer["Remarks"]</pems-table-header><pems-table-header>Raw Extra</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @if (table != null)
                {
                    @foreach (var row in table.Rows)
                    {
                        <pems-table-row>
                            <pems-table-cell class="fw-semibold">@(row.TagNumber ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.Description ?? row.Service ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.SignalType ?? "-") @(row.SignalClass != null ? $"({row.SignalClass})" : "")</pems-table-cell>
                            <pems-table-cell class="small">@(row.JunctionBox ?? "-") / @(row.Terminal ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.CableNo ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.MarshallingCabinet ?? "-") / @(row.MarshallingTerminal ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.IoCard ?? "-") / @(row.IoChannel ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.LoopNo ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.System ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(row.SpareOrHotSpare == true ? "Yes" : "-")</pems-table-cell>
                            <pems-table-cell class="small pems-s-27af8985">@(row.Remarks ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">
                                @if (row.RawExtra != null && row.RawExtra.Any())
                                {
                                    @string.Join("; ", row.RawExtra.Select(kv => $"{kv.Key}={kv.Value}"))
                                }
                                else
                                {
                                    @:-
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                }
            </pems-table-body>
        </pems-table>

        @if (table == null || !table.Rows.Any())
        {
            <p class="text-muted text-center py-4">No rows extracted.</p>
        }
    </pems-table-scroll>
</pems-content-card>
