@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TableExtractionAttachmentListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <p class="text-muted mb-0">
        ابزار آزمایش پرامپت استخراج جدولی (Wiring Connection Diagram, Instrument Index, Marshalling List,
        I/O List, Loop Drawing) روی فایل‌های آپلودشده. این صفحه مستقل از خط پردازش خودکار AI Intake است و
        هیچ نتیجه‌ای را در پایگاه‌داده ذخیره نمی‌کند - فقط خروجی مدل را برای بررسی نمایش می‌دهد.
    </p>
</pems-content-card>

<pems-content-card>
    <pems-flex justify="end" css="mb-2">
        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="PemsDataGrid.resetColumns('TableExtraction')">
            <pems-icon name="bi-arrow-counterclockwise" /> @Localizer["Reset columns"]
        </pems-button>
    </pems-flex>
    <pems-table-scroll css="pems-grid-scroll table-scroll-area pems-s-a7ef6ffc">
        <pems-table kind="enterprise" css="pems-grid-table" data-grid-key="TableExtraction">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header data-col-key="file" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["File"]</pems-table-header>
                    <pems-table-header data-col-key="ext" data-resizable="true" data-min-width="80" data-max-width="140">Extension</pems-table-header>
                    <pems-table-header data-col-key="uploaded" data-resizable="true" data-min-width="120" data-max-width="200">@Localizer["Uploaded"]</pems-table-header>
                    <pems-table-header data-col-key="aiStatus" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["AI Status"]</pems-table-header>
                    <pems-table-header class="pems-s-bec7b1d5" data-col-key="hint" data-resizable="true" data-min-width="200" data-max-width="400">Document hint (optional)</pems-table-header>
                    <pems-table-header class="pems-s-5af557a5" data-col-key="action" data-resizable="false">@Localizer["Action"]</pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var attachment in Model.Items)
                {
                    <pems-table-row>
                        <pems-table-cell>@attachment.FileName</pems-table-cell>
                        <pems-table-cell>@attachment.FileExtension</pems-table-cell>
                        <pems-table-cell class="small text-muted">@attachment.UploadDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        <pems-table-cell>
                            <pems-badge tone="neutral">@attachment.AIStatus</pems-badge>
                        </pems-table-cell>
                        <pems-table-cell>
                            <form asp-action="Analyze" method="post" id="aiForm_@attachment.AttachmentId">
                                <input type="hidden" name="attachmentId" value="@attachment.AttachmentId" />
                                <pems-input scale="small" type="text" name="documentHint" placeholder="e.g. Wiring Connection Diagram for JB-12" />
                            </form>
                        </pems-table-cell>
                        <pems-table-cell>
                            <pems-flex gap="2">
                                <pems-button tone="primary" size="small" css="text-nowrap" type="submit" form="aiForm_@attachment.AttachmentId">
                                    <pems-icon name="bi-stars" /> With AI
                                </pems-button>
                                <form asp-action="AnalyzeDeterministic" method="post" class="d-inline">
                                    <input type="hidden" name="attachmentId" value="@attachment.AttachmentId" />
                                    <pems-button tone="neutral" size="small" outline="true" css="text-nowrap" type="submit" title="PDF native text only, no LLM call - faster and more precise for real tables">
                                        <pems-icon name="bi-grid-3x3" /> No AI (PDF)
                                    </pems-button>
                                </form>
                            </pems-flex>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>

        @if (!Model.Items.Any())
        {
            <p class="text-muted text-center py-4">No uploaded attachments yet. Try Document Upload first.</p>
        }
    </pems-table-scroll>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "TableExtraction",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</pems-content-card>

@section Scripts {
    <script src="~/js/views/tableextraction-index.js" asp-append-version="true"></script>
}
