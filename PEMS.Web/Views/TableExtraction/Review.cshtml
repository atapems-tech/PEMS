@model PEMS.Domain.Entities.TableExtractionBatch
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var rows = Model.Rows.OrderBy(r => r.MatchStatus == "Confirmed" || r.MatchStatus == "Rejected" ? 1 : 0)
        .ThenBy(r => r.TagNumber)
        .ToList();
    var counts = Model.Rows.GroupBy(r => r.MatchStatus).ToDictionary(g => g.Key, g => g.Count());
    int Count(string status) => counts.TryGetValue(status, out var c) ? c : 0;
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">@Model.SourceFileName</h5>
            <span class="text-muted small">Batch #@Model.TableExtractionBatchId - @Model.ExtractionMethod - @Model.TotalRows rows - @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-left" /> Back</pems-button>
    </pems-flex>
</pems-content-card>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <div class="admin-kpi-grid">
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["Unmatched"]</div><div class="admin-kpi-value">@Count("Unmatched")</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Matched - no Instrument yet</div><div class="admin-kpi-value">@Count("MatchedNoInstrument")</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Matched - has Instrument</div><div class="admin-kpi-value">@Count("MatchedHasInstrument")</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["Confirmed"]</div><div class="admin-kpi-value">@Count("Confirmed")</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["Rejected"]</div><div class="admin-kpi-value">@Count("Rejected")</div></div>
    </div>
</pems-content-card>

<form id="bulkConfirmForm" asp-action="BulkConfirm" method="post">
    <input type="hidden" name="batchId" value="@Model.TableExtractionBatchId" />
</form>

<pems-content-card css="mb-3">
    <pems-flex gap="2" wrap="true" align="center">
        <div class="input-group admin-search pems-s-2f3f7d77">
            <span class="input-group-text"><pems-icon name="bi-search" /></span>
            <pems-input type="search" id="rowSearch" placeholder="Filter by tag..." autocomplete="off" />
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <pems-button tone="neutral" outline="true" css="status-filter active" type="button" data-status="all">@Localizer["All"]</pems-button>
            <pems-button tone="neutral" outline="true" css="status-filter" type="button" data-status="Unmatched">@Localizer["Unmatched"]</pems-button>
            <pems-button tone="neutral" outline="true" css="status-filter" type="button" data-status="MatchedNoInstrument">Needs Instrument</pems-button>
            <pems-button tone="neutral" outline="true" css="status-filter" type="button" data-status="MatchedHasInstrument">Has Instrument</pems-button>
            <pems-button tone="neutral" outline="true" css="status-filter" type="button" data-status="Confirmed">@Localizer["Confirmed"]</pems-button>
            <pems-button tone="neutral" outline="true" css="status-filter" type="button" data-status="Rejected">@Localizer["Rejected"]</pems-button>
        </div>
        <pems-button tone="primary" size="small" css="ms-auto" type="submit" form="bulkConfirmForm" id="bulkConfirmBtn" disabled
                data-pems-confirm="تعداد {n} ردیف انتخاب‌شده به Instrument متصل شود؟" data-pems-confirm-count="#selectedCount">
            <pems-icon name="bi-link-45deg" /> Confirm Selected (<span id="selectedCount">0</span>)
        </pems-button>
    </pems-flex>
</pems-content-card>

<pems-content-card>
    <div class="table-responsive table-scroll-area pems-s-a7ef6ffc">
        <pems-table kind="enterprise" scale="small">
            <thead>
                <tr>
                    <th class="pems-w-30"><input type="checkbox" id="selectAllMatched" title="Select all matched rows" /></th>
                    <th>@Localizer["Tag"]</th><th>@Localizer["Description"]</th><th>@Localizer["Junction Box"]</th><th>@Localizer["Cable No."]</th>
                    <th>DCS Tag</th><th>@Localizer["Status"]</th><th class="pems-s-e581e86b">@Localizer["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var badgeClass = row.MatchStatus switch
                    {
                        "Confirmed" => "success",
                        "Rejected" => "neutral",
                        "MatchedHasInstrument" => "info",
                        "MatchedNoInstrument" => "primary",
                        _ => "warning"
                    };
                    var isSelectable = row.MatchStatus is "MatchedNoInstrument" or "MatchedHasInstrument";

                    <tr class="row-item" data-status="@row.MatchStatus" data-tag="@(row.TagNumber ?? "").ToLower()">
                        <td>
                            @if (isSelectable)
                            {
                                <input type="checkbox" class="row-select" form="bulkConfirmForm" name="selectedRowIds" value="@row.TableExtractionRowId" />
                            }
                        </td>
                        <td class="fw-semibold">@(row.TagNumber ?? "-")</td>
                        <td class="small pems-s-27af8985">@(row.Description ?? "-")</td>
                        <td class="small">@(row.JunctionBox ?? "-")</td>
                        <td class="small">@(row.CableNo ?? "-")</td>
                        <td class="small">@(row.DcsTagNo ?? "-")</td>
                        <td><pems-badge tone="@badgeClass">@row.MatchStatus</pems-badge></td>
                        <td>
                            @if (row.MatchStatus is "MatchedNoInstrument" or "MatchedHasInstrument")
                            {
                                <pems-flex align="center" gap="2">
                                    <span class="small text-muted">→ @row.MatchedEquipment?.TagNumber</span>
                                    <form asp-action="ConfirmRow" method="post" class="d-inline">
                                        <input type="hidden" name="rowId" value="@row.TableExtractionRowId" />
                                        <input type="hidden" name="equipmentId" value="@row.MatchedEquipmentId" />
                                        <input type="hidden" name="batchId" value="@Model.TableExtractionBatchId" />
                                        <pems-button tone="primary" size="small" css="btn-xs" type="submit">Confirm</pems-button>
                                    </form>
                                    <form asp-action="RejectRow" method="post" class="d-inline">
                                        <input type="hidden" name="rowId" value="@row.TableExtractionRowId" />
                                        <input type="hidden" name="batchId" value="@Model.TableExtractionBatchId" />
                                        <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                                    </form>
                                </pems-flex>
                            }
                            else if (row.MatchStatus == "Unmatched")
                            {
                                <form asp-action="ConfirmRowManual" method="post"><pems-flex gap="2">
                                    <input type="hidden" name="rowId" value="@row.TableExtractionRowId" />
                                    <input type="hidden" name="batchId" value="@Model.TableExtractionBatchId" />
                                    <pems-input class="pems-maxw-160" scale="small" type="text" name="equipmentTagNumber" placeholder="Equipment tag..." />
                                    <pems-button tone="primary" size="small" type="submit">Link</pems-button>
                                </pems-flex></form>
                            }
                            else if (row.MatchStatus == "Confirmed")
                            {
                                <span class="small text-success"><pems-icon name="bi-check-circle" /> Instrument #@row.ResultInstrumentId</span>
                            }
                            else
                            {
                                <span class="small text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </pems-table>

        @if (!rows.Any())
        {
            <p class="text-muted text-center py-4">@Localizer["No rows in this batch."]</p>
        }
    </div>
</pems-content-card>

@section Scripts {
<script src="~/js/views/tableextraction-review.js" asp-append-version="true"></script>
}
