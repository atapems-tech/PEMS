@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.IntakeQueueItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var stages = (string[])ViewBag.Stages;
    var qs = string.IsNullOrEmpty((string?)ViewBag.SelectedStage) ? "" : $"stage={ViewBag.SelectedStage}";
}


<div class="content-card mb-3">
    <p class="text-muted mb-2">
        هر فایل آپلودشده ابتدا این‌جا می‌نشیند. هوش مصنوعی نوع مدرک را تشخیص می‌دهد؛ در سطح اطمینان
        بالا خودکار به ماژول درست (MDR/VDR) هدایت می‌شود، در سطح متوسط/پایین منتظر بازبینی شما می‌ماند.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm @(ViewBag.SelectedStage == null ? "btn-pems-solid" : "btn-outline-secondary")">All</a>
        @foreach (var s in stages)
        {
            <a asp-action="Index" asp-route-stage="@s" class="btn btn-sm @(s == (string?)ViewBag.SelectedStage ? "btn-pems-solid" : "btn-outline-secondary")">@s</a>
        }
        @if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStage))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> @Localizer["Reset"]</a>
        }
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Intake')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="table-responsive pems-grid-scroll table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="Intake">
            <thead>
                <tr>
                    <th data-col-key="file" data-resizable="true" data-min-width="140" data-max-width="360">@Localizer["File"]</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="240">@Localizer["Project"]</th>
                    <th data-col-key="category" data-resizable="true" data-min-width="120" data-max-width="260">Predicted Category</th>
                    <th data-col-key="module" data-resizable="true" data-min-width="100" data-max-width="200">Suggested Module</th>
                    <th data-col-key="confidence" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Confidence"]</th>
                    <th data-col-key="aiStatus" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["AI Status"]</th>
                    <th data-col-key="stage" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Stage"]</th>
                    <th data-col-key="routed" data-resizable="true" data-min-width="90" data-max-width="180">@Localizer["Routed"]</th>
                    <th data-col-key="uploaded" data-resizable="true" data-min-width="120" data-max-width="200">@Localizer["Uploaded"]</th>
                    <th data-col-key="actions" data-resizable="false" style="width:90px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td>@i.FileName</td>
                        <td>@i.ProjectName</td>
                        <td>@i.PredictedCategory</td>
                        <td>@i.SuggestedTargetModule</td>
                        <td>@(i.AIConfidence.HasValue ? $"{i.AIConfidence:P0}" : "-")</td>
                        <td>
                            @{
                                var ab = i.AIStatus switch { "Completed" => "bg-success", "Processing" => "bg-info text-dark", "Failed" => "bg-danger", _ => "bg-secondary" };
                            }
                            <span class="badge @ab">@i.AIStatus</span>
                        </td>
                        <td>
                            @{
                                var sb = i.IntakeStage switch
                                {
                                    "Routed" => "bg-success",
                                    "PendingEngineeringReview" => "bg-warning text-dark",
                                    "PendingManualClassification" => "bg-danger",
                                    "Rejected" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @sb">@i.IntakeStage</span>
                        </td>
                        <td>@i.RoutedModule</td>
                        <td>@i.UploadDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (i.IntakeStage != "Routed" && i.IntakeStage != "Rejected")
                            {
                                <a asp-action="Review" asp-route-id="@i.AttachmentId" class="btn btn-sm btn-pems-solid">Review</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">Intake Queue is empty.</p> }

        @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
        {
            Page = Model.Page, TotalPages = Model.TotalPages, TotalCount = Model.TotalCount,
            PageSize = Model.PageSize, GridKey = "Intake",
            BaseUrl = Url.Action("Index"), ExistingQueryString = qs
        })
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Intake');
        });
    </script>
}
