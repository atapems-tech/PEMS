@model PEMS.Application.DTOs.IntakeDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var modules = (string[])ViewBag.Modules;
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center">
        <div>
            <h5 class="mb-0">@Model.FileName</h5>
            <span class="text-muted small">Project: @Model.ProjectName</span>
        </div>
        <div class="text-end">
            @{
                var lb = Model.ConfidenceLevel switch { "High" => "success", "Medium" => "warning", _ => "danger" };
            }
            <pems-badge tone="@lb" css="fs-6">Confidence: @Model.ConfidenceLevel (@Model.ConfidenceScore.ToString("P0"))</pems-badge>
        </div>
    </pems-flex>

    @if (Model.AIStatus == "Failed")
    {
        <pems-alert tone="danger" css="mt-3 mb-0">AI analysis failed: @Model.AIError. You can still classify and route this file manually below.</pems-alert>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3"><pems-icon name="bi-robot" /> AI Suggestion &mdash; confirm or correct, then Route</h6>

    <form asp-action="Route" method="post">
        <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />

        <pems-row gap="3">
            <pems-col md="4">
                <pems-label>@Localizer["Target Module"]</pems-label>
                <pems-select name="targetModule">
                    @foreach (var m in modules)
                    { <option value="@m" selected="@(m == Model.SuggestedTargetModule)">@m</option> }
                </pems-select>
                <div class="form-text">AI suggested: <strong>@Model.SuggestedTargetModule</strong></div>
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Category"]</pems-label>
                <pems-input name="category" value="@Model.PredictedCategory" />
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Document Type"]</pems-label>
                <pems-input name="documentType" value="@Model.PredictedDocumentType" />
            </pems-col>

            <pems-col md="4">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId">
                    @foreach (var p in projects)
                    { <option value="@p.ProjectId" selected="@(p.ProjectId == Model.ProjectId)">@p.ProjectName</option> }
                </pems-select>
                @if (!string.IsNullOrEmpty(Model.PredictedProjectHint))
                { <div class="form-text">AI hint from document text: "@Model.PredictedProjectHint"</div> }
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select name="disciplineCode">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var d in disciplines)
                    { <option value="@d.Code" selected="@(d.Code == Model.PredictedDisciplineCode)">@d.Name (@d.Code)</option> }
                </pems-select>
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Area"]</pems-label>
                <pems-input name="area" value="@Model.PredictedArea" />
            </pems-col>

            <pems-col md="3"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" value="@Model.PredictedUnit" disabled /></pems-col>
            <pems-col md="3"><pems-label css="small">@Localizer["System"]</pems-label><pems-input scale="small" value="@Model.PredictedSystem" disabled /></pems-col>
            <pems-col md="3"><pems-label css="small">Subsystem</pems-label><pems-input scale="small" value="@Model.PredictedSubsystem" disabled /></pems-col>
            <pems-col md="3"><pems-label css="small">@Localizer["Equipment Tag"]</pems-label><pems-input scale="small" value="@Model.PredictedEquipmentTagNumber" disabled /></pems-col>

            <pems-col md="4">
                <pems-label>@Localizer["Revision"]</pems-label>
                <pems-input name="revisionNo" value="@Model.PredictedRevisionNo" />
            </pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Issue Purpose"]</pems-label>
                <pems-input name="issuePurpose" value="@Model.PredictedIssuePurpose" />
            </pems-col>
            <pems-col md="4">
                <pems-label>Vendor (for VDR routing)</pems-label>
                <pems-input name="vendorName" value="@Model.PredictedVendorName" />
            </pems-col>
            <pems-col md="4">
                <pems-label>Related MR Number</pems-label>
                <pems-input name="mrNumber" value="@Model.PredictedMRNumber" />
            </pems-col>
        </pems-row>

        <pems-flex gap="2" css="mt-4">
            <pems-button tone="primary" type="submit"><pems-icon name="bi-signpost-split" /> Confirm &amp; Route</pems-button>
        </pems-flex>
    </form>

    <form asp-action="Reject" method="post" class="mt-2">
        <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
        <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="Reject this file from the intake queue?">
            <pems-icon name="bi-x-lg" /> @Localizer["Reject"]
        </pems-button>
    </form>
</pems-content-card>
