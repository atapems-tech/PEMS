@model List<PEMS.Application.DTOs.KnowledgeBaseSearchResultDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <p class="text-muted">
        جستجوی معنایی واقعی (Semantic Search) روی خلاصه‌های AI ثبت‌شده در سیستم - بر اساس شباهت
        بردار Embedding، نه فقط تطابق کلمات. الان <strong>@ViewBag.EntryCount</strong> رکورد در
        Knowledge Base نمایه شده است.
    </p>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="e.g. مدارک مربوط به فشار طراحی، یا مشکلات ویبره پمپ" />
        <button class="btn btn-pems-solid"><i class="bi bi-search"></i> @Localizer["Search"]</button>
    </form>
</div>

@if (Model.Any())
{
    <div class="content-card">
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Relevance"]</th><th>@Localizer["Source"]</th><th>Content</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><pems-badge tone="info">@r.SimilarityScore.ToString("P0")</pems-badge></td>
                        <td><pems-badge tone="neutral">@r.SourceType #@r.SourceId</pems-badge></td>
                        <td class="small">@r.Content</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty((string?)ViewBag.Query))
{
    <div class="content-card"><p class="text-muted text-center py-4">No semantically relevant records found.</p></div>
}
