@model List<PEMS.Application.DTOs.KnowledgeBaseSearchResultDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <p class="text-muted">
        جستجوی معنایی واقعی (Semantic Search) روی خلاصه‌های AI ثبت‌شده در سیستم - بر اساس شباهت
        بردار Embedding، نه فقط تطابق کلمات. الان <strong>@ViewBag.EntryCount</strong> رکورد در
        Knowledge Base نمایه شده است.
    </p>
    <pems-form asp-action="Index" method="get"><pems-flex gap="2">
        <pems-input type="text" name="q" value="@ViewBag.Query" placeholder="e.g. مدارک مربوط به فشار طراحی، یا مشکلات ویبره پمپ" />
        <pems-button tone="primary"><pems-icon name="bi-search" /> @Localizer["Search"]</pems-button>
    </pems-flex></pems-form>
</pems-content-card>

@if (Model.Any())
{
    <pems-content-card>
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["Relevance"])?.ToString() ?? ""), r => (object?)(r.SimilarityScore.ToString("P0")), kind: DataCellKind.Badge, tone: r => "info").Add(((Localizer["Source"])?.ToString() ?? ""), r => DataCell.Join((r.SourceType), " #", (r.SourceId)), kind: DataCellKind.Badge, tone: r => "neutral").Add("Content", r => (object?)(r.Content), css: "small")))" />
        </pems-table-scroll>
    </pems-content-card>
}
else if (!string.IsNullOrEmpty((string?)ViewBag.Query))
{
    <pems-content-card><p class="text-muted text-center py-4">No semantically relevant records found.</p></pems-content-card>
}
