@model PEMS.Web.Models.Account.LoginViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Login_Title"];
    Layout = "_AuthLayout";
}

<h2>@Localizer["Login_Welcome"]</h2>
<p class="subtitle">@Localizer["Login_Subtitle"]</p>

<pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-alert>

<form asp-controller="Account" asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <pems-label asp-for="UserName">@Localizer["Login_UserName"]</pems-label>
        <pems-input asp-for="UserName" placeholder="@Localizer["Login_UserNamePlaceholder"]" autofocus />
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <pems-label asp-for="Password">@Localizer["Login_Password"]</pems-label>
        <pems-input asp-for="Password" placeholder="@Localizer["Login_PasswordPlaceholder"]" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-3 mt-2">
        <pems-input kind="check" asp-for="RememberMe" />
        <label asp-for="RememberMe" class="form-check-label small">@Localizer["Login_RememberMe"]</label>
    </div>

    <pems-button tone="none" css="btn-pems" type="submit" id="loginSubmitBtn">
        <span id="loginSubmitLabel" data-signing-in="@Localizer["Login_SigningIn"]">@Localizer["Login_SignIn"]</span>
    </pems-button>

    <div class="auth-links">
        <a asp-action="ForgotPassword">@Localizer["Login_ForgotPassword"]</a>
        <a asp-controller="AccountRecovery" asp-action="Index">@Localizer["Use a recovery code"]</a>
        <span class="text-muted">PEMS v1.0</span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <pems-script-templates set="account-login"></pems-script-templates>
    <script src="~/js/views/account-login.js" asp-append-version="true"></script>
}
