@model List<(int Id, string? Nickname, DateTime CreatedDate, DateTime? LastUsedDate)>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Manage Passkeys";
}

<p class="text-muted small">
    طبق سند PEMS-SEC-PERMIT-AUTH-001: تایید/رد Permit، تایید ایزوله‌سازی، اقدامات SIMOPS، و
    Execution Gate نیازمند Step-up Authentication با Passkey (اثر انگشت/Face ID/PIN دستگاه) هستند.
    بدون حداقل یک Passkey ثبت‌شده، این اقدامات مسدود می‌شوند. PEMS هرگز داده‌ی بیومتریک شما را
    نمی‌بیند یا ذخیره نمی‌کند - فقط دستگاه شما آن را تایید می‌کند.
</p>

<div id="pems-passkey-alert"></div>

<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Register New Passkey"]</h6>
    <form id="registerForm" onsubmit="return false;"><pems-row gap="2" css="align-items-end">
        @Html.AntiForgeryToken()
        <pems-col md="4">
            <pems-label css="small">@Localizer["Nickname (optional)"]</pems-label>
            <pems-input scale="small" type="text" id="nickname" placeholder="e.g. My Laptop Windows Hello" />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" size="small" type="button" onclick="registerNow()">
                <pems-icon name="bi-fingerprint" /> @Localizer["Register Passkey"]
            </pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Registered Passkeys"]</h6>
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <thead><tr><th>@Localizer["Nickname"]</th><th>@Localizer["Registered"]</th><th>@Localizer["Last Used"]</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="small">@(c.Nickname ?? "-")</td>
                    <td class="small">@c.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@(c.LastUsedDate?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                </tr>
            }
        </tbody>
    </pems-table>
    @if (!Model.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز Passkey ای ثبت نشده."]</p> }
</pems-content-card>

<pems-script-templates set="manage-passkeys"></pems-script-templates>
<script src="~/js/webauthn.js"></script>
<script src="~/js/views/account-managepasskeys.js" asp-append-version="true"></script>
