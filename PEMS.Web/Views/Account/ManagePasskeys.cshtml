@model List<(int Id, string? Nickname, DateTime CreatedDate, DateTime? LastUsedDate)>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Manage Passkeys";
}

<p class="text-muted small">
    طبق سند PEMS-SEC-PERMIT-AUTH-001: تایید/رد Permit، تایید ایزوله‌سازی، اقدامات SIMOPS، و
    Execution Gate نیازمند Step-up Authentication با Passkey (اثر انگشت/Face ID/PIN دستگاه) هستند.
    بدون حداقل یک Passkey ثبت‌شده، این اقدامات مسدود می‌شوند. PEMS هرگز داده‌ی بیومتریک شما را
    نمی‌بیند یا ذخیره نمی‌کند - فقط دستگاه شما آن را تایید می‌کند.
</p>

<div id="pems-passkey-alert"></div>

<div class="content-card mb-3">
    <h6 class="mb-3">@Localizer["Register New Passkey"]</h6>
    <form id="registerForm" class="row g-2 align-items-end" onsubmit="return false;">
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label small">@Localizer["Nickname (optional)"]</label>
            <input type="text" id="nickname" class="form-control form-control-sm" placeholder="e.g. My Laptop Windows Hello" />
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-sm btn-pems-solid" onclick="registerNow()">
                <i class="bi bi-fingerprint"></i> @Localizer["Register Passkey"]
            </button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Registered Passkeys"]</h6>
    <table class="table table-enterprise table-sm mb-0">
        <thead><tr><th>@Localizer["Nickname"]</th><th>@Localizer["Registered"]</th><th>@Localizer["Last Used"]</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="small">@(c.Nickname ?? "-")</td>
                    <td class="small">@c.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@(c.LastUsedDate?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز Passkey ای ثبت نشده."]</p> }
</div>

<script src="~/js/webauthn.js"></script>
<script>
    async function registerNow() {
        const nickname = document.getElementById('nickname').value;
        const token = document.querySelector('#registerForm input[name="__RequestVerificationToken"]').value;
        const alertBox = document.getElementById('pems-passkey-alert');
        alertBox.innerHTML = '';

        const result = await pemsRegisterPasskey(nickname, token);

        if (result.success) {
            location.reload();
        } else {
            alertBox.innerHTML = '<div class="alert alert-danger py-2 px-3 small">' + (result.error || 'ثبت ناموفق بود.') + '</div>';
        }
    }
</script>
