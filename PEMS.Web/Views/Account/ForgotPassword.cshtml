@model PEMS.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
    bool submitted = ViewBag.Submitted == true;
}

<h2>Forgot Password</h2>
<p class="subtitle">Enter your email and the System Administrator will assist you</p>

@if (submitted)
{
    <div class="alert alert-success small">
        If this email exists in our system, a system administrator has been notified.
        Please contact your <strong>System Admin</strong> to reset your password.
    </div>
}
else
{
    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="you@company.com" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-pems">Send Request</button>
    </form>
}

<div class="auth-links">
    <a asp-action="Login">&larr; Back to Login</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
