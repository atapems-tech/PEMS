@model PEMS.Web.Models.Account.ChangePasswordViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AuthLayout";
}

<h2>@Localizer["تغییر رمز عبور"]</h2>
<p class="subtitle">رمز عبور شما پیش‌فرض است - قبل از ادامه باید یک رمز جدید تنظیم کنید.</p>

<div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}

<form asp-controller="Account" asp-action="ChangePassword" method="post">
    <div class="mb-3">
        <label asp-for="CurrentPassword" class="form-label">@Localizer["رمز فعلی"]</label>
        <input asp-for="CurrentPassword" class="form-control" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">@Localizer["رمز جدید"]</label>
        <input asp-for="NewPassword" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">@Localizer["تکرار رمز جدید"]</label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-pems">@Localizer["تغییر رمز"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
