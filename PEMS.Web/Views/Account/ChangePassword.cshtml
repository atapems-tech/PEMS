@model PEMS.Web.Models.Account.ChangePasswordViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AuthLayout";
}

<h2>@Localizer["تغییر رمز عبور"]</h2>
<p class="subtitle">رمز عبور شما پیش‌فرض است - قبل از ادامه باید یک رمز جدید تنظیم کنید.</p>

<pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-alert>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}

<form asp-controller="Account" asp-action="ChangePassword" method="post">
    <div class="mb-3">
        <pems-label asp-for="CurrentPassword">@Localizer["رمز فعلی"]</pems-label>
        <pems-input asp-for="CurrentPassword" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <pems-label asp-for="NewPassword">@Localizer["رمز جدید"]</pems-label>
        <pems-input asp-for="NewPassword" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <pems-label asp-for="ConfirmPassword">@Localizer["تکرار رمز جدید"]</pems-label>
        <pems-input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <pems-button tone="none" css="btn-pems" type="submit">@Localizer["تغییر رمز"]</pems-button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
