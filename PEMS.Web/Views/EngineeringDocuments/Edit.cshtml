@model PEMS.Domain.Entities.EngineeringDocument
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Edit Document";

    string statusClass = Model.Status switch
    {
        "Approved" => "success",
        "Issued" => "primary",
        "Rejected" => "danger",
        "Submitted" => "warning",
        "Draft" => "neutral",
        _ => "primary"
    };
}

@* بازطراحی کامل صفحه‌ی Edit - قبلاً اسکلت خام Bootstrap بدون هماهنگی با بقیه‌ی برنامه بود و
   فقط ۶ فیلد داشت. حالا هم‌راستا با Create/Details است، فیلدهای مهندسی و ردیابی کامل دارد،
   و وضعیت/رویژن به‌صورت فقط‌خواندنی نشان داده می‌شوند (این‌ها از طریق گردش‌کار جدا مدیریت
   می‌شوند - Submit/Approve/Reject/Create Revision - نه ویرایش مستقیم اینجا). *@

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-1">Editing: @Model.DocumentNo</h5>
            <pems-badge tone="@statusClass">@Model.Status</pems-badge>
            <span class="text-muted small ms-2">Rev @Model.RevisionNo</span>
            @if (Model.IsFrozen) { <pems-badge tone="info" css="ms-1"><pems-icon name="bi-snow" /> Frozen</pems-badge> }
        </div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@Model.DocumentId">
            <pems-icon name="bi-arrow-return-left" /> Back to Details
        </pems-button>
    </div>
    <p class="text-muted small mb-0 mt-2">
        Status, revision, and freeze are managed through the document workflow (Submit / Approve / Reject / Create Revision
        on the Details page), not edited directly here.
    </p>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="DocumentId" />

    <pems-row gap="3">
        <pems-col lg="6">
            <div class="content-card h-100">
                <h6 class="mb-3">Basic Information</h6>
                <pems-row gap="3">
                    <pems-col md="6">
                        <pems-label>@Localizer["Document No"]</pems-label>
                        <pems-input asp-for="DocumentNo" required />
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>@Localizer["Document Type"]</pems-label>
                        <pems-input asp-for="DocumentType" required />
                    </pems-col>
                    <pems-col span="12">
                        <pems-label>@Localizer["Title"]</pems-label>
                        <pems-input asp-for="Title" required />
                    </pems-col>
                    <pems-col span="12">
                        <pems-label>@Localizer["Description"]</pems-label>
                        <pems-textarea asp-for="Description" rows="3"></pems-textarea>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>@Localizer["Project"]</pems-label>
                        <pems-select asp-for="ProjectId" asp-items="ViewBag.Projects"></pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>@Localizer["Discipline"]</pems-label>
                        <pems-select asp-for="DisciplineId" asp-items="ViewBag.Disciplines">
                            <option value="">-- Unassigned --</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>@Localizer["Area"]</pems-label>
                        <pems-input asp-for="Area" />
                    </pems-col>
                </pems-row>
            </div>
        </pems-col>

        <pems-col lg="6">
            <div class="content-card h-100">
                <h6 class="mb-3">Engineering Information</h6>
                <pems-row gap="3">
                    <pems-col span="12">
                        <pems-label>@Localizer["Issue Purpose"]</pems-label>
                        @* طبق «VENDOR DOCUMENTATION MANAGEMENT PROCEDURE» بخش ۴.۶.۱: کدهای رسمی IFA/IFR/IFI/FI
                           به‌همراه مقادیر قدیمی این فیلد (برای سازگاری با داده‌ی موجود) - همین لیست دقیقاً در
                           VDR/Details.cshtml (فرم SubmitForReview) هم تکرار شده؛ اگر این‌جا تغییر داد آن‌جا را هم به‌روزرسانی کنید. *@
                        <pems-select asp-for="IssuePurpose">
                            <option value="">-- Select --</option>
                            <option value="IFA">@Localizer["IFA - Issued for Approval"]</option>
                            <option value="IFR">@Localizer["IFR - Issue for Review and Comments"]</option>
                            <option value="IFI">IFI - Issue for Information</option>
                            <option value="FI">@Localizer["FI - Final Issue (without comments)"]</option>
                            <option value="For Approval">@Localizer["For Approval (legacy)"]</option>
                            <option value="For Construction">@Localizer["For Construction (legacy)"]</option>
                            <option value="For Information">@Localizer["For Information (legacy)"]</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="4">
                        <pems-label>@Localizer["Prepared By"]</pems-label>
                        <pems-input asp-for="PreparedBy" />
                    </pems-col>
                    <pems-col md="4">
                        <pems-label>@Localizer["Checked By"]</pems-label>
                        <pems-input asp-for="CheckedBy" />
                    </pems-col>
                    <pems-col md="4">
                        <pems-label>@Localizer["Approved By"]</pems-label>
                        <pems-input asp-for="ApprovedBy" />
                    </pems-col>
                </pems-row>

                <h6 class="mb-3 mt-4">Traceability</h6>
                <pems-row gap="3">
                    <pems-col md="6">
                        <pems-label>Related Equipment <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                        <pems-select asp-for="EquipmentId" asp-items="ViewBag.Equipments">
                            <option value="">@Localizer["-- None --"]</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>Related Contract <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                        <pems-select asp-for="ContractId" asp-items="ViewBag.Contracts">
                            <option value="">@Localizer["-- None --"]</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label>Related MR <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                        <pems-select asp-for="RelatedMRId" asp-items="ViewBag.MaterialRequisitions">
                            <option value="">@Localizer["-- None --"]</option>
                        </pems-select>
                    </pems-col>
                </pems-row>
            </div>
        </pems-col>
    </pems-row>

    <div class="content-card mt-3">
        <pems-button tone="primary" type="submit"><pems-icon name="bi-check-lg" /> Save Changes</pems-button>
        <pems-button tone="neutral" outline="true" as="a" asp-action="Details" asp-route-id="@Model.DocumentId">Cancel</pems-button>
    </div>
</form>
