@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EngineeringDocumentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Documents";

    var filter = (PEMS.Application.DTOs.EngineeringDocumentListFilter)ViewBag.Filter;
    var summary = (PEMS.Application.DTOs.EngineeringDocumentSummaryCountsDto)ViewBag.Summary;
    var disciplines = (List<PEMS.Domain.Entities.Discipline>)ViewBag.Disciplines;

    // طبق Phase E-03: مجموعه‌ی بسته‌ی وضعیت‌های واقعی که DocumentWorkflowService/
    // RecordClientResponseAsync تنظیم می‌کنند - همان الگوی Views/Permit/Index.cshtml (فهرست
    // ثابت به‌جای Query جدا برای SELECT DISTINCT Status).
    var statusOptions = new[] { "Draft", "Submitted", "IDC Review", "Checked", "Approved", "Issued", "Rejected", "Client Approved" };
}

@{
    var hasActiveAdvancedFilters = filter.DisciplineId.HasValue || !string.IsNullOrEmpty(filter.Status) || !string.IsNullOrEmpty(filter.Area);
    var selectedDisciplineName = filter.DisciplineId.HasValue ? disciplines.FirstOrDefault(d => d.DisciplineId == filter.DisciplineId)?.Name : null;
}
<div class="pems-doc-page">

@* طبق بازبینی معماری: MDR/VDR/Transmittal از نظر داده‌ای زیرمجموعه‌ی همین هسته‌ی مشترک Document
   هستند؛ این نوار دسترسی سریع همان حس یک ماژول واحد را از نظر ناوبری هم می‌دهد. *@
<div class="d-flex flex-wrap gap-2 mb-2">
    <a asp-controller="EngineeringDocuments" asp-action="Index" class="btn btn-sm btn-pems-solid"><i class="bi bi-file-earmark-text"></i> Documents</a>
    <a asp-controller="DocumentRegister" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-bookmark"></i> Register</a>
    <a asp-controller="MDRImport" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-arrow-up"></i> Import (MDR)</a>
    <a asp-controller="VDR" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> Vendor Documents (VDR)</a>
    <a asp-controller="Transmittal" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-send"></i> Transmittals</a>
</div>

@* طبق Phase E-03: این شمارش‌ها حالا از دیتابیس می‌آیند (GetSummaryCountsAsync) - با همان
   محدودیت دیسیپلین فهرست، اما مستقل از فیلترهای زیر (دقیقاً مثل رفتار قبلی).
   طبق بخش ۱۱ ممیزی UX: از کامپوننت مشترک _KpiCard (که پیش‌تر برای Dashboard ساخته شده)
   استفاده شد - فقط KPI هایی که دقیقاً به یک مقدار فیلتر Status موجود نگاشت می‌شوند کلیک‌پذیرند
   (Total/Approved/Rejected). Pending شامل دو وضعیت (Submitted+Checked) و Frozen/Overdue اصلاً
   فیلد فیلتر جدا ندارند - طبق دستور صریح ممیزی ("do not create fake frontend logic")، این سه
   KPI عمداً غیرکلیک‌پذیر ماندند تا نتیجه‌ی کلیک هیچ‌وقت با عدد KPI ناهم‌خوان نباشد. *@
<div class="row g-3 mb-2">
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["Total"], Count = summary.Total, IconClass = "bi-file-earmark-text", ColorClass = "bg-icon-slate", Url = Url.Action("Index") })" />
    </div>
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["Approved"], Count = summary.Approved, IconClass = "bi-check-circle", ColorClass = "bg-icon-green", Url = Url.Action("Index", new { Status = "Approved" }) })" />
    </div>
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["PendingReview"], Count = summary.Pending, IconClass = "bi-hourglass-split", ColorClass = "bg-icon-amber" })" />
    </div>
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["Rejected"], Count = summary.Rejected, IconClass = "bi-x-circle", ColorClass = "bg-icon-red", Url = Url.Action("Index", new { Status = "Rejected" }) })" />
    </div>
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["Frozen"], Count = summary.Frozen, IconClass = "bi-snow", ColorClass = "bg-icon-blue" })" />
    </div>
    <div class="col-6 col-md-2">
        <partial name="_KpiCard" model="@(new PEMS.Web.Models.KpiCardViewModel { Title = Localizer["Delayed"], Count = summary.Overdue, IconClass = "bi-exclamation-triangle", ColorClass = "bg-icon-purple" })" />
    </div>
</div>

@* طبق «PEMS — Engineering Documents Density/Search Consolidation» بند ۷-۱۶: قبلاً این صفحه دو
   جعبه‌ی جستجوی هم‌پوشان داشت - یک Autocomplete جدا (بدون اتصال به فیلتر Grid) و یک فیلد متنی
   "Search" جدا داخل فرم فیلتر. حالا فقط یک ورودی جستجوی قابل‌مشاهده وجود دارد که همون
   Autocomplete مشترک است؛ Enter بدون انتخاب یک نتیجه (رویداد pems:search-enter تازه‌اضافه‌شده
   به خودِ کامپوننت مشترک) همین فرم را Submit می‌کند - یعنی هر دو رفتار (پرش مستقیم به یک مدرک /
   فیلترکردن Grid) از یک Query/یک فرم تغذیه می‌شوند. Discipline/Status/Area (که فیلد فیلتر
   جداگانه‌ای در کوئری هستند، نه جستجوی متنی) به Offcanvas «Advanced Search» منتقل شدند. *@
<div class="content-card mb-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <form method="get" asp-action="Index" id="engDocSearchForm" class="pems-search-bar flex-grow-1">
            <i class="bi bi-search pems-search-icon"></i>
            <input type="text" class="form-control" id="engDocQuickSearch" name="Search" value="@filter.Search"
                   placeholder="Search documents..." data-pems-search data-search-type="EngineeringDocument" autocomplete="off"
                   aria-label="Search engineering documents" />
            <span class="pems-search-kbd d-none d-md-inline">Ctrl K</span>
            @* فیلترهای Advanced فعلی به‌صورت Hidden حفظ می‌شوند تا با Submit جستجوی متنی از بین نروند *@
            @if (filter.DisciplineId.HasValue) { <input type="hidden" name="DisciplineId" value="@filter.DisciplineId" /> }
            @if (!string.IsNullOrEmpty(filter.Status)) { <input type="hidden" name="Status" value="@filter.Status" /> }
            @if (!string.IsNullOrEmpty(filter.Area)) { <input type="hidden" name="Area" value="@filter.Area" /> }
        </form>
        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" data-bs-toggle="offcanvas" data-bs-target="#engDocAdvancedSearch"
                aria-controls="engDocAdvancedSearch" title="Advanced Search" aria-label="Advanced Search">
            <i class="bi bi-sliders"></i> <span class="d-none d-sm-inline">@Localizer["Filter"]</span>
        </button>
        <a asp-action="Create" class="btn btn-sm btn-pems-solid flex-shrink-0"><i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">@Localizer["New"]</span></a>
    </div>

    @if (hasActiveAdvancedFilters)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            @if (filter.DisciplineId.HasValue)
            {
                <span class="pems-filter-chip">@Localizer["Discipline"]: @selectedDisciplineName
                    <a class="pems-chip-remove" href="@Url.Action("Index", new { Search = filter.Search, Status = filter.Status, Area = filter.Area })" title="Remove filter" aria-label="Remove discipline filter">&times;</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(filter.Status))
            {
                <span class="pems-filter-chip">@Localizer["Status"]: @filter.Status
                    <a class="pems-chip-remove" href="@Url.Action("Index", new { Search = filter.Search, DisciplineId = filter.DisciplineId, Area = filter.Area })" title="Remove filter" aria-label="Remove status filter">&times;</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(filter.Area))
            {
                <span class="pems-filter-chip">@Localizer["Area"]: @filter.Area
                    <a class="pems-chip-remove" href="@Url.Action("Index", new { Search = filter.Search, DisciplineId = filter.DisciplineId, Status = filter.Status })" title="Remove filter" aria-label="Remove area filter">&times;</a>
                </span>
            }
            <a asp-action="Index" asp-route-Search="@filter.Search" class="small text-danger text-decoration-none">@Localizer["Reset"] all</a>
        </div>
    }
</div>

@* طبق بند ۹/۴۹ ممیزی UX: فیلترهای پیشرفته فقط با درخواست کاربر نمایش داده می‌شوند (Offcanvas) -
   Register همچنان در پس‌زمینه قابل مشاهده می‌ماند. هیچ فیلد جدیدی اضافه نشده - همون سه فیلد
   موجود (Discipline/Status/Area) فقط جابه‌جا شدند. *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="engDocAdvancedSearch" aria-labelledby="engDocAdvancedSearchLabel">
    <div class="offcanvas-header">
        <h6 class="offcanvas-title" id="engDocAdvancedSearchLabel"><i class="bi bi-sliders"></i> Advanced Search</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <form method="get" asp-action="Index" class="flex-grow-1 d-flex flex-column">
            <input type="hidden" name="Search" value="@filter.Search" />
            <div class="mb-3">
                <label class="form-label small">@Localizer["Discipline"]</label>
                <select name="DisciplineId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var d in disciplines)
                    { <option value="@d.DisciplineId" selected="@(filter.DisciplineId == d.DisciplineId)">@d.Name</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small">@Localizer["Status"]</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var s in statusOptions)
                    { <option value="@s" selected="@(filter.Status == s)">@s</option> }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small">@Localizer["Area"]</label>
                <input name="Area" value="@filter.Area" type="text" class="form-control form-control-sm" placeholder="Area..." />
            </div>
            <div class="mt-auto d-flex gap-2 border-top pt-3">
                <button type="submit" class="btn btn-pems-solid btn-sm flex-fill"><i class="bi bi-funnel"></i> Apply Filters</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill">@Localizer["Reset"]</a>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('engDocQuickSearch');
        var form = document.getElementById('engDocSearchForm');
        input.addEventListener('pems:search-select', function (e) {
            if (e.detail && e.detail.url) window.location.href = e.detail.url;
        });
        input.addEventListener('pems:search-enter', function () {
            form.submit();
        });
    })();
</script>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('EngineeringDocuments')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
        </button>
    </div>
    <div class="pems-grid-scroll table-scroll-area">
        <table class="table table-enterprise pems-grid-table" data-grid-key="EngineeringDocuments">
            <thead>
                <tr>
                    <th data-col-key="docNo" data-resizable="true" data-min-width="120" data-max-width="260" style="width:160px">@Localizer["Document"] No</th>
                    <th data-col-key="title" data-resizable="true" data-min-width="180" data-max-width="500" style="width:300px">@Localizer["Title"]</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px">@Localizer["Type"]</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Discipline"]</th>
                    <th data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="200" style="width:110px">@Localizer["Area"]</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="240" style="width:160px">@Localizer["Project"]</th>
                    <th data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="120" style="width:80px">Rev</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="180" style="width:130px">@Localizer["Status"]</th>
                    <th data-col-key="delay" data-resizable="true" data-min-width="80" data-max-width="140" style="width:90px">Delay</th>
                    <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px">@Localizer["Created"]</th>
                    <th data-col-key="actions" data-resizable="false" class="text-end" style="width:130px">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td title="@item.DocumentNo"><a asp-action="Details" asp-route-id="@item.DocumentId" class="fw-semibold text-decoration-none">@item.DocumentNo</a></td>
                        <td title="@item.Title">@item.Title</td>
                        <td><span class="badge bg-secondary">@item.DocumentType</span></td>
                        <td title="@item.DisciplineName">@item.DisciplineName</td>
                        <td title="@item.Area">@item.Area</td>
                        <td title="@item.ProjectName">@item.ProjectName</td>
                        <td>@item.RevisionNo</td>
                        <td>
                            <span class="badge @PEMS.Web.Helpers.DocumentStatusBadge.CssClass(item.Status)">@item.Status</span>
                            @if (item.IsFrozen) { <i class="bi bi-snow text-info ms-1" title="Frozen"></i> }
                        </td>
                        <td>
                            @if (item.DelayDays.HasValue && item.DelayDays > 0)
                            { <span class="badge bg-danger">@item.DelayDays d</span> }
                            else
                            { <span class="text-muted">&mdash;</span> }
                        </td>
                        <td class="text-muted small">@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.DocumentId" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="View" aria-label="View @item.DocumentNo"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.DocumentId" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Edit" aria-label="Edit @item.DocumentNo"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.DocumentId" method="post" class="d-inline" onsubmit="return confirm('Delete this document?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Delete" aria-label="Delete @item.DocumentNo"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No engineering documents match the current filters.</p> }

    @{
        var edQsParts = new List<string>();
        if (!string.IsNullOrEmpty(filter.Search)) edQsParts.Add($"Search={Uri.EscapeDataString(filter.Search)}");
        if (filter.DisciplineId.HasValue) edQsParts.Add($"DisciplineId={filter.DisciplineId}");
        if (!string.IsNullOrEmpty(filter.Status)) edQsParts.Add($"Status={Uri.EscapeDataString(filter.Status)}");
        if (!string.IsNullOrEmpty(filter.Area)) edQsParts.Add($"Area={Uri.EscapeDataString(filter.Area)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "EngineeringDocuments",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", edQsParts)
    })
</div>

</div> @* end .pems-doc-page *@

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('EngineeringDocuments');
            window.PemsTooltips.init();
        });
    </script>
}
