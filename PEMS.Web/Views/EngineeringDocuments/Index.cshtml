@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EngineeringDocumentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Documents";

    var filter = (PEMS.Application.DTOs.EngineeringDocumentListFilter)ViewBag.Filter;
    var summary = (PEMS.Application.DTOs.EngineeringDocumentSummaryCountsDto)ViewBag.Summary;
    var disciplines = (List<PEMS.Domain.Entities.Discipline>)ViewBag.Disciplines;

    // مجموعه‌ی بسته‌ی وضعیت‌های واقعی که DocumentWorkflowService/RecordClientResponseAsync تنظیم می‌کنند
    var statusOptions = new[] { "Draft", "Submitted", "IDC Review", "Checked", "Approved", "Issued", "Rejected", "Revise & Resubmit", "Client Approved" };

    var hasActiveAdvancedFilters = filter.DisciplineId.HasValue || !string.IsNullOrEmpty(filter.Status) || !string.IsNullOrEmpty(filter.Area);
    var filterCount = (filter.DisciplineId.HasValue ? 1 : 0) + (string.IsNullOrEmpty(filter.Status) ? 0 : 1) + (string.IsNullOrEmpty(filter.Area) ? 0 : 1);
    var selectedDisciplineName = filter.DisciplineId.HasValue ? disciplines.FirstOrDefault(d => d.DisciplineId == filter.DisciplineId)?.Name : null;

    // ترجمه‌ی نمایشی وضعیت؛ مقدار ذخیره‌شده هرگز تغییر نمی‌کند (کلید نبود ⇒ همان مقدار خام)
    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-408 look, built from the PEMS.UI list-page component (SCRUM-337): the table fills the page, one icon toolbar,
   filters in a dropdown, KPI chips hidden until asked. This page keeps its own columns, filters, rows and actions. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">

    @* ناوبری ماژول: MDR/VDR/Transmittal زیرمجموعه‌ی همان هسته‌ی Document هستند - Import عمداً این‌جا نیست (فقط Import Center) *@
    <nav class="vs-subnav" aria-label="@Localizer["Ed_Documents"]">
        <a asp-controller="EngineeringDocuments" asp-action="Index" class="active" aria-current="page">@Localizer["Ed_Documents"]</a>
        <a asp-controller="DocumentRegister" asp-action="Index">@Localizer["Ed_Register"]</a>
        <a asp-controller="VDR" asp-action="Index">@Localizer["Ed_VendorDocs"]</a>
        <a asp-controller="Transmittal" asp-action="Index">@Localizer["Ed_Transmittals"]</a>
    </nav>

    <pems-list-panel>

        <pems-list-toolbar id="edToolbar" heading="@Localizer["Ed_Documents"]" total="@Model.TotalCount">
            @* یک جستجوی اصلی: همان Autocomplete مشترک؛ Enter بدون انتخاب نتیجه همین فرم را Submit می‌کند *@
            <pems-list-search id="engDocSearchForm" action="@Url.Action("Index")" input-id="engDocQuickSearch" name="Search" value="@filter.Search"
                              placeholder="@Localizer["Ed_SearchPlaceholder"]" search-type="EngineeringDocument">
                @if (filter.DisciplineId.HasValue) { <input type="hidden" name="DisciplineId" value="@filter.DisciplineId" /> }
                @if (!string.IsNullOrEmpty(filter.Status)) { <input type="hidden" name="Status" value="@filter.Status" /> }
                @if (!string.IsNullOrEmpty(filter.Area)) { <input type="hidden" name="Area" value="@filter.Area" /> }
            </pems-list-search>

            <pems-list-tools search-for="engDocSearchForm">
                <pems-list-filters form-id="edFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { Search = filter.Search })">
                    <input type="hidden" name="Search" value="@filter.Search" />
                    <div>
                        <label class="lp-lbl" for="edFilterDiscipline">@Localizer["Ed_Discipline"]</label>
                        <select id="edFilterDiscipline" name="DisciplineId" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var d in disciplines)
                            { <option value="@d.DisciplineId" selected="@(filter.DisciplineId == d.DisciplineId)">@d.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="edFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="edFilterStatus" name="Status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statusOptions)
                            { <option value="@s" selected="@(filter.Status == s)">@StatusText(s)</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="edFilterArea">@Localizer["Ed_Area"]</label>
                        <input id="edFilterArea" name="Area" value="@filter.Area" type="text" class="form-control form-control-sm" />
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="edKpis" storage-key="pems.engdocs.kpis" />
                <pems-list-export href="@Url.Action("Export", new { filter.Search, filter.ProjectId, filter.DisciplineId, filter.Status, filter.Area, filter.MinRevisionCount })" />
                <pems-list-reset-columns grid-key="EngineeringDocuments" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Ed_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        @* شمارش‌ها از دیتابیس (GetSummaryCountsAsync) با همان محدودیت دیسیپلین، مستقل از فیلترها؛ پیش‌فرض پنهان (SCRUM-408).
           فقط مواردی که دقیقاً به یک مقدار فیلتر Status نگاشت می‌شوند کلیک‌پذیرند (Total/Approved/Rejected). *@
        <pems-list-kpis id="edKpis">
            <a class="vs-chip text-decoration-none" href="@Url.Action("Index")">@Localizer["Ed_Total"] <strong>@summary.Total</strong></a>
            <a class="vs-chip text-decoration-none" href="@Url.Action("Index", new { Status = "Approved" })">@StatusText("Approved") <strong>@summary.Approved</strong></a>
            <span class="vs-chip">@Localizer["Ed_Pending"] <strong>@summary.Pending</strong></span>
            <a class="vs-chip text-decoration-none @(summary.Rejected > 0 ? "vs-chip--danger" : "")" href="@Url.Action("Index", new { Status = "Rejected" })">@StatusText("Rejected") <strong>@summary.Rejected</strong></a>
            <span class="vs-chip"><i class="bi bi-snow" aria-hidden="true"></i> @Localizer["Ed_Frozen"] <strong>@summary.Frozen</strong></span>
            <span class="vs-chip @(summary.Overdue > 0 ? "vs-chip--danger" : "")">@Localizer["Ed_Overdue"] <strong>@summary.Overdue</strong></span>
        </pems-list-kpis>

        @* فیلترهای فعال: این ردیف فقط وقتی فیلتری هست دیده می‌شود *@
        <pems-list-chips reset-href="@Url.Action("Index", new { Search = filter.Search })">
            @if (filter.DisciplineId.HasValue)
            { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@selectedDisciplineName" remove-href="@Url.Action("Index", new { Search = filter.Search, Status = filter.Status, Area = filter.Area })" /> }
            @if (!string.IsNullOrEmpty(filter.Status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(filter.Status)" remove-href="@Url.Action("Index", new { Search = filter.Search, DisciplineId = filter.DisciplineId, Area = filter.Area })" /> }
            @if (!string.IsNullOrEmpty(filter.Area))
            { <pems-list-chip label="@Localizer["Ed_Area"]" value="@filter.Area" remove-href="@Url.Action("Index", new { Search = filter.Search, DisciplineId = filter.DisciplineId, Status = filter.Status })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="EngineeringDocuments" empty="@(!Model.Items.Any())" empty-text="@Localizer["Ed_Empty"]"
                             filtered="@(hasActiveAdvancedFilters || !string.IsNullOrEmpty(filter.Search))" clear-href="@Url.Action("Index")">
                    <thead>
                        <tr>
                            <th data-col-key="docNo" data-resizable="true" data-min-width="120" data-max-width="260" style="width:170px">@Localizer["Ed_DocNo"]</th>
                            <th data-col-key="title" data-resizable="true" data-min-width="200" data-max-width="600" style="width:360px">@Localizer["Ed_Title"]</th>
                            <th data-col-key="type" data-resizable="true" data-min-width="70" data-max-width="200" style="width:100px" class="vs-hide-md">@Localizer["Ed_Type"]</th>
                            <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Ed_Discipline"]</th>
                            <th data-col-key="rev" data-resizable="true" data-min-width="56" data-max-width="120" style="width:70px">@Localizer["Ed_Rev"]</th>
                            <th data-col-key="status" data-resizable="true" data-min-width="120" data-max-width="220" style="width:160px">@Localizer["Ed_Status"]</th>
                            <th data-col-key="delay" data-resizable="true" data-min-width="70" data-max-width="140" style="width:80px">@Localizer["Ed_Delay"]</th>
                            <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px" class="vs-hide-md">@Localizer["Ed_Created"]</th>
                            <th data-col-key="actions" data-resizable="false" style="width:112px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="lp-row">
                                <td class="lp-no"><a asp-action="Details" asp-route-id="@item.DocumentId" class="lp-subject" title="@item.DocumentNo">@item.DocumentNo</a></td>
                                <td>
                                    <span class="vs-title-cell" title="@item.Title">@item.Title</span>
                                    <span class="vs-sub">@item.ProjectName@(!string.IsNullOrEmpty(item.Area) ? " · " + item.Area : "")@(!string.IsNullOrWhiteSpace(item.CommentStatus) ? " · " + item.CommentStatus : "")</span>
                                </td>
                                <td class="vs-hide-md small">@item.DocumentType</td>
                                <td class="small" title="@item.DisciplineName">@item.DisciplineName</td>
                                <td><span class="vs-num">@item.RevisionNo</span></td>
                                <td>
                                    <span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(item.Status)"><i class="bi @DocumentStatusBadge.Icon(item.Status)" aria-hidden="true"></i> @StatusText(item.Status)</span>
                                    @if (item.IsFrozen) { <i class="bi bi-snow text-info ms-1" title="@Localizer["Ed_Frozen"]" aria-label="@Localizer["Ed_Frozen"]"></i> }
                                </td>
                                <td class="small">
                                    @if (item.DelayDays.HasValue && item.DelayDays > 0)
                                    { <span class="vs-pill vs-pill--icon vs-pill--danger"><i class="bi bi-clock-history" aria-hidden="true"></i> <span class="vs-num">@item.DelayDays</span> @Localizer["Ed_DaysShort"]</span> }
                                    else
                                    { <span class="text-muted">&mdash;</span> }
                                </td>
                                <td class="vs-hide-md small text-muted">@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-nowrap lp-actions">
                                    <a asp-action="Edit" asp-route-id="@item.DocumentId" class="lp-act" title="@Localizer["Ed_Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Ed_Edit"]: @item.DocumentNo</span></a>
                                    <a asp-action="Details" asp-route-id="@item.DocumentId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Ed_View"]: @item.DocumentNo</span></a>
                                    <div class="dropdown d-inline">
                                        <button type="button" class="lp-act lp-act--always" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["Ed_MoreActions"]"><i class="bi bi-three-dots" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Ed_MoreActions"]: @item.DocumentNo</span></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@item.DocumentId" method="post" onsubmit="return confirm('@Localizer["Ed_DeleteConfirm"].Value.Replace("'", "\\'")');">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash" aria-hidden="true"></i> @Localizer["Ed_Delete"]</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
            </pems-list-table>

            <pems-list-footer>
                @{
                    var edQsParts = new List<string>();
                    if (!string.IsNullOrEmpty(filter.Search)) edQsParts.Add($"Search={Uri.EscapeDataString(filter.Search)}");
                    if (filter.DisciplineId.HasValue) edQsParts.Add($"DisciplineId={filter.DisciplineId}");
                    if (!string.IsNullOrEmpty(filter.Status)) edQsParts.Add($"Status={Uri.EscapeDataString(filter.Status)}");
                    if (!string.IsNullOrEmpty(filter.Area)) edQsParts.Add($"Area={Uri.EscapeDataString(filter.Area)}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "EngineeringDocuments",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", edQsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>

</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
