@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Upload Attachment";
    var revisions = (IEnumerable<dynamic>)(ViewBag.Revisions ?? Array.Empty<dynamic>());
}


<h2>
Upload Document Attachment
</h2>


<form asp-action="UploadAttachment"
      method="post"
      enctype="multipart/form-data">


    <input type="hidden"
           name="documentId"
           value="@ViewBag.DocumentId" />


    <div class="mb-3">

        <label>
            Select File
        </label>


        <input type="file"
               name="file"
               class="form-control" />

    </div>

    <div class="mb-3">
        <label class="form-label">Revision <span class="text-muted small">(optional — leave blank for a document-level attachment not tied to a specific revision)</span></label>
        <select name="revisionId" class="form-select">
            <option value="">-- Document-level (no specific revision) --</option>
            @foreach (var rev in revisions)
            {
                <option value="@rev.RevisionId">Rev @rev.RevisionNo (@rev.Status)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">File Role <span class="text-muted small">@Localizer["(optional)"]</span></label>
        <select name="fileRole" class="form-select">
            <option value="">-- Unspecified --</option>
            <option value="Native">Native / Source File</option>
            <option value="PdfRendition">PDF Rendition</option>
            <option value="MarkedUp">Marked-up File</option>
            <option value="ReviewCopy">Review Copy</option>
            <option value="SupportingAttachment">Supporting Attachment</option>
        </select>
        <div class="form-text">If this revision has no official file yet, the first upload for it becomes official automatically.</div>
    </div>

    <button type="submit"
            class="btn btn-primary">

        @Localizer["Upload"]

    </button>


</form>
