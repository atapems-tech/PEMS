                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-pems-solid btn-sm">Create Revision</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="clientResponseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RecordClientResponse" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <div class="modal-header"><h6 class="modal-title">Record Client Response</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        This is the client's (owner's) response to the issued document, separate from the
                        internal EPC review that already happened.
                    </p>

                    @{
                        var availableIncomingLetters = (IEnumerable<PEMS.Domain.Entities.Letter>)(ViewBag.AvailableIncomingLetters ?? new List<PEMS.Domain.Entities.Letter>());
                    }
                    <div class="mb-2">
                        <label class="form-label small"><i class="bi bi-envelope-open"></i> نامه‌ی وارده (الزامی)</label>
                        @if (availableIncomingLetters.Any())
                        {
                            <select name="incomingLetterId" class="form-select form-select-sm" required>
