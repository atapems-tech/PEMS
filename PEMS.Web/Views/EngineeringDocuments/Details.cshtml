@model PEMS.Application.DTOs.EngineeringDocumentDto
@using PEMS.Web.Helpers
@using PEMS.Web.Models
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Document Details";
    // طبق «PEMS — Engineering Documents Upper-Whitespace Correction»: این صفحه از قبل یک
    // Breadcrumb محلی (خط ۶۱ پایین‌تر، شامل لینک به لیست + شماره‌ی واقعی مدرک) و یک کارت هویت
    // مدرک (DocumentNo/Status/Revision) بلافاصله زیرش دارد - H1 عمومی Layout همون متن ثابت بالا
    // را با فونت درشت‌تر و ۴۸px+ فاصله‌ی عمودی اضافه تکرار می‌کرد، بدون اطلاعات جدید.
    ViewData["HidePageTitle"] = true;

    var relatedLetters = (List<PEMS.Application.DTOs.RelatedLetterDto>)(ViewBag.RelatedLetters ?? new List<PEMS.Application.DTOs.RelatedLetterDto>());
    var idcStatusForPage = (IReadOnlyList<PEMS.Application.Interfaces.IdcStatusItemDto>)
        (ViewBag.IdcStatus ?? new List<PEMS.Application.Interfaces.IdcStatusItemDto>());
    var workflowHistoryForPage = (IReadOnlyList<PEMS.Application.Interfaces.DocumentWorkflowHistoryItemDto>)
        (ViewBag.WorkflowHistory ?? new List<PEMS.Application.Interfaces.DocumentWorkflowHistoryItemDto>());
    // طبق «Phase 9 - IDC Summary»: معیار پیشرفت، تعداد دیسیپلین‌هایی است که پاسخ داده‌اند
    // (صرف‌نظر از این‌که Approve/Comment/Reject بوده) - نه فقط تعداد Approve
    var idcApprovedCount = idcStatusForPage.Count(x => x.Status != "Pending");

    // کامنت‌ها و ترنسمیتال‌ها: شمارنده‌ی تب‌ها و کارت‌های خلاصه‌ی Overview به این مقادیر نیاز دارند (قبلاً پایین صفحه تعریف می‌شدند)
    var engComments = (List<PEMS.Application.DTOs.VDRCommentDto>)(ViewBag.Comments ?? new List<PEMS.Application.DTOs.VDRCommentDto>());
    var latestPdfAttachment = Model.Attachments
        .Where(a => a.FileExtension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(a => a.UploadDate)
        .FirstOrDefault();
    var commentsClosedCount = engComments.Count(c => c.ActionStatus is "Closed" or "Verified" or "NoActionRequired");
    var commentsOpenCount = engComments.Count - commentsClosedCount;
    var relatedTransmittals = (List<PEMS.Application.DTOs.RelatedTransmittalDto>)(ViewBag.RelatedTransmittals ?? new List<PEMS.Application.DTOs.RelatedTransmittalDto>());

    // «مرحله‌ی بعد» زیر نمودار: فقط توضیح است؛ اقدام واقعی همان دکمه‌های بالای صفحه است و سرور خودش مجاز بودن را بررسی می‌کند
    string? wfNextStep = Model.Status switch
    {
        "Draft" => Localizer["Ed_Next_Draft"].Value,
        "Submitted" => Localizer["Ed_Next_Submitted"].Value,
        "IDC Review" => string.Format(Localizer["Ed_Next_Idc"].Value, idcStatusForPage.Count(x => x.Status == "Pending")),
        "Checked" => Localizer["Ed_Next_Checked"].Value,
        "Approved" => Localizer["Ed_Next_Approved"].Value,
        "Issued" => string.IsNullOrEmpty(Model.ClientApprovalStatus) ? Localizer["Ed_Next_Issued"].Value : null,
        "Rejected" or "Revise & Resubmit" => Localizer["Ed_Next_Revise"].Value,
        _ => null
    };
    // لینک «Assign» به صفحه‌ی ویرایش می‌رود (فیلدهای امضا همان‌جا متن آزاد هستند)؛ مدرک منجمد/صادرشده قابل ویرایش نیست
    var canAssignSignoff = !Model.IsFrozen && Model.Status != "Issued";

    // طبق «PEMS Phase 2C-3»: منطق تعیین مرحله عیناً همان منطق قبلی _WorkflowStagesDiagram
    // است - فقط جابه‌جا شده به این‌جا، بدون هیچ تغییر رفتاری. محاسبه یک‌بار انجام می‌شود چون
    // این صفحه دو بار (بالای صفحه + داخل Modal Submit) همین نمودار را نشان می‌دهد.
    var wfCurrentStatus = Model.Status ?? "Draft";
    var wfStageOrder = new[] { "Draft", "Submitted", "IDC Review", "Checked", "Approved", "Issued", "ClientReview" };
    var wfStageLabels = new Dictionary<string, string>
    {
        ["Draft"] = "Draft", ["Submitted"] = "Check", ["IDC Review"] = "IDC", ["Checked"] = "Approval",
        ["Approved"] = "Issue", ["Issued"] = "Issued", ["ClientReview"] = "Client Review"
    };
    var wfStageIcons = new Dictionary<string, string>
    {
        ["Draft"] = "bi-pencil-square", ["Submitted"] = "bi-clipboard-check", ["IDC Review"] = "bi-diagram-3",
        ["Checked"] = "bi-patch-check", ["Approved"] = "bi-send-check", ["Issued"] = "bi-check2-circle", ["ClientReview"] = "bi-building"
    };
    var wfStageRoles = new Dictionary<string, string>
    {
        ["Draft"] = "Engineer", ["Submitted"] = "Eng. Supervisor / Manager", ["IDC Review"] = "دیسیپلین‌های ارجاع‌شده",
        ["Checked"] = "Eng. Manager", ["Approved"] = "Document Controller", ["Issued"] = "—", ["ClientReview"] = "Document Controller"
    };
    // ترجمه‌ی نمایشی وضعیت؛ مقدار ذخیره‌شده هرگز تغییر نمی‌کند
    string StatusText(string? s) { var l = Localizer[DocumentStatusBadge.ResourceKey(s)]; return l.ResourceNotFound ? (s ?? "") : l.Value; }
    var wfIsRejected = wfCurrentStatus == "Rejected" || wfCurrentStatus == "Revise & Resubmit";
    var wfCurrentIndex = Array.IndexOf(wfStageOrder, wfCurrentStatus);
    if (wfCurrentIndex < 0) wfCurrentIndex = wfIsRejected ? 0 : wfStageOrder.Length - 1;

    var wfStageDiagramModel = new StageDiagramViewModel
    {
        Stages = wfStageOrder.Select((key, i) => new StageDiagramItem
        {
            Label = wfStageLabels[key],
            IconCssClass = wfStageIcons[key],
            RoleLabel = wfStageRoles[key],
            State = wfIsRejected && i > wfCurrentIndex ? StageItemState.Rejected
                : i < wfCurrentIndex ? StageItemState.Done
                : i == wfCurrentIndex ? StageItemState.Current
                : StageItemState.Pending
        }).ToList()
    };
}


@* طراحی جدید: به‌جای یک صفحه‌ی بسیار طولانی با اسکرول پیوسته، محتوا در تب‌ها سازمان‌دهی شده -
   الهام‌گرفته از EDMS های رقیب که هر مدرک را به‌صورت Overview / Attachments / IDC / Revisions /
   Workflow / Correspondence نشان می‌دهند. اقدامات اصلی گردش‌کار همیشه بالای صفحه و قابل مشاهده‌اند.
   طبق «PEMS — Engineering Documents UX Transformation»: اکشن‌های کم‌تکرار (Edit/Freeze/Hold
   جدید/تحلیل AI/رویژن جدید) به منوی «More» منتقل شدند تا فقط اکشن مرحله‌ی فعلی گردش‌کار برجسته
   بماند - هیچ Route/Field/مجوز سرور تغییر نکرده، فقط محل نمایش دکمه‌ها. *@

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<pems-page-shell kind="workspace">

<div class="vs-section">
    <div class="vs-doc-head">
        <div class="vs-doc-identity">
            <pems-flex align="center" gap="2" wrap="true">
                <h1 class="vs-doc-number vs-num">@Model.DocumentNo</h1>
                <span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(Model.Status)"><pems-icon css="@DocumentStatusBadge.Icon(Model.Status)" aria-hidden="true" /> @StatusText(Model.Status)</span>
                <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentRev"] <span class="vs-num">@Model.RevisionNo</span></span>
                @if (Model.IsFrozen) { <span class="vs-pill vs-pill--icon vs-pill--info"><pems-icon name="bi-snow" aria-hidden="true" /> @Localizer["Ed_Frozen"]</span> }
                @if (Model.IsOnHold) { <span class="vs-pill vs-pill--icon vs-pill--warning"><pems-icon name="bi-pause-circle" aria-hidden="true" /> @Localizer["Ed_OnHold"]</span> }
            </pems-flex>
            <div class="vs-doc-title" title="@Model.Title">@Model.Title</div>
            <div class="vs-doc-meta">@Model.ProjectName &middot; @Model.DisciplineName@(!string.IsNullOrEmpty(Model.Area) ? " · " + Model.Area : "")</div>
        </div>

        <div class="vs-doc-actions">
            @* طبق بخش ۱۹ ممیزی UX: فقط اکشن(های) مرحله‌ی فعلی گردش‌کار این‌جا برجسته می‌مانند -
               بدون تغییر در Route/Field/بررسی وضعیت سرور. *@
            @if (Model.Status == "Draft")
            {
                <pems-button tone="bare" type="button" css="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#submitWorkflowModal">
                    <pems-icon name="bi-send" /> Submit For Review
                </pems-button>
            }
            else if (Model.Status == "Submitted")
            {
                <pems-form asp-action="Check" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <pems-button tone="bare" css="vs-btn vs-btn--primary"><pems-icon name="bi-clipboard-check" /> Check</pems-button>
                </pems-form>
                <pems-form asp-action="Reject" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <pems-button tone="bare" css="vs-btn vs-btn--dangerline">@Localizer["Reject"]</pems-button>
                </pems-form>
                <pems-button tone="bare" type="button" css="vs-btn" data-bs-toggle="modal" data-bs-target="#reviseModal">
                    <pems-icon name="bi-arrow-repeat" /> Revise &amp; Resubmit
                </pems-button>
            }
            else if (Model.Status == "IDC Review")
            {
                var myDisciplineIdForIdc = ViewBag.MyDisciplineId as int?;
                var myPendingIdc = idcStatusForPage.FirstOrDefault(x => x.DisciplineId == myDisciplineIdForIdc && x.Status == "Pending");

                if (myPendingIdc != null)
                {
                    @* طبق «Phase 11 - UI/UX» ممیزی: این دکمه‌ها فقط نتیجه‌ی بازبینیِ دیسیپلینِ خودِ کاربر
                       (My Review) هستند - نه اقدام تایید/رد رسمیِ کل مدرک (که فقط در مرحله‌ی Approval،
                       با برچسب مشابه ولی جدا، پایین‌تر ظاهر می‌شود). برچسب‌ها عمداً متفاوت نگه داشته
                       شده‌اند تا با دکمه‌های تصمیم رسمی اشتباه گرفته نشوند. *@
                    <span class="text-muted small me-1">@Localizer["My IDC Review:"]</span>
                    <pems-form asp-action="IdcRespond" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.DocumentId" />
                        <input type="hidden" name="decision" value="Approve" />
                        <pems-button tone="bare" css="vs-btn vs-btn--primary"><pems-icon name="bi-check-lg" /> No Comment</pems-button>
                    </pems-form>
                    <pems-button tone="bare" type="button" css="vs-btn" data-bs-toggle="modal" data-bs-target="#idcCommentModal">@Localizer["Approve with Comments"]</pems-button>
                    <pems-button tone="bare" type="button" css="vs-btn vs-btn--dangerline" data-bs-toggle="modal" data-bs-target="#idcRejectModal">@Localizer["Revision Required"]</pems-button>
                }
                else
                {
                    <span class="vs-pill vs-pill--icon vs-pill--warning"><pems-icon name="bi-hourglass-split" aria-hidden="true" /> منتظر بازبینی دیسیپلین‌های دیگر (IDC)</span>
                }
            }
            else if (Model.Status == "Checked")
            {
                <pems-form asp-action="Approve" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <pems-button tone="bare" css="vs-btn vs-btn--primary">@Localizer["Approve"]</pems-button>
                </pems-form>
                <pems-form asp-action="Reject" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <pems-button tone="bare" css="vs-btn vs-btn--dangerline">@Localizer["Reject"]</pems-button>
                </pems-form>
                <pems-button tone="bare" type="button" css="vs-btn" data-bs-toggle="modal" data-bs-target="#reviseModal">
                    <pems-icon name="bi-arrow-repeat" /> Revise &amp; Resubmit
                </pems-button>
            }
            else if (Model.Status == "Approved")
            {
                <pems-button tone="bare" type="button" css="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#issueModal">
                    <pems-icon name="bi-send-check" /> Issue
                </pems-button>
            }
            else if (Model.Status == "Issued")
            {
                @if (string.IsNullOrEmpty(Model.ClientApprovalStatus))
                {
                    <pems-button tone="bare" type="button" css="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#clientResponseModal">
                        <pems-icon name="bi-building" /> Record Client Response
                    </pems-button>
                }
            }
            else if (Model.Status == "Rejected" || Model.Status == "Revise & Resubmit")
            {
                <pems-button tone="bare" type="button" css="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#submitWorkflowModal">
                    <pems-icon name="bi-arrow-repeat" /> Resubmit
                </pems-button>
            }

            @* طبق بخش ۲۱ ممیزی UX: اکشن‌های کم‌تکرار این‌جا جمع شدند - نمایش هر آیتم دقیقاً همون
               شرط/مجوزی که قبلاً به‌صورت جداگانه روی صفحه داشت را حفظ می‌کند. *@
            <div class="dropdown">
                <pems-button tone="bare" css="vs-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @Localizer["Ed_MoreActions"]
                </pems-button>
                <pems-dropdown-menu end="true">
                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.DocumentId"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</a></li>
                    @if (Model.Status == "Approved" || Model.Status == "Issued")
                    {
                        <li><pems-button tone="bare" type="button" css="dropdown-item" data-bs-toggle="modal" data-bs-target="#newRevisionModal"><pems-icon name="bi-file-earmark-plus" /> Create New Revision</pems-button></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <pems-form asp-action="AnalyzeRelationships" asp-route-id="@Model.DocumentId" method="post">
                            <pems-button tone="bare" type="submit" css="dropdown-item"><pems-icon name="bi-stars" /> @Localizer["تحلیل روابط (AI)"]</pems-button>
                        </pems-form>
                    </li>
                    @if (!Model.IsFrozen && (bool)(ViewBag.CanFreeze ?? false))
                    {
                        <li><pems-button tone="bare" type="button" css="dropdown-item" data-bs-toggle="modal" data-bs-target="#freezeModal"><pems-icon name="bi-snow" /> @Localizer["Freeze"]</pems-button></li>
                    }
                    @if (!Model.IsOnHold && !Model.IsFrozen && Model.Status != "Issued" && (bool)(ViewBag.CanHold ?? false))
                    {
                        <li><pems-button tone="bare" type="button" css="dropdown-item" data-bs-toggle="modal" data-bs-target="#holdModal"><pems-icon name="bi-pause-circle" /> @Localizer["Hold"]</pems-button></li>
                    }
                </pems-dropdown-menu>
            </div>
        </div>
    </div>

    @* طبق بخش ۲۲ ممیزی UX: بنر وضعیت برجسته برای Frozen/Hold - سرور واقعاً Approve/Issue/Edit را
       مسدود می‌کند (نه فقط این بنر)؛ این‌جا فقط نمایش وضعیت + اکشن رفع آن است. *@
    @if (Model.IsFrozen)
    {
        <pems-alert tone="info" css="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0 py-2">
            <div class="small">
                <pems-icon name="bi-snow" /> <strong>FROZEN</strong> — Revision @Model.RevisionNo is frozen and cannot be modified.
                <div class="text-muted">Frozen by @(Model.FrozenByName ?? "-") on @(Model.FrozenDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")@(!string.IsNullOrWhiteSpace(Model.FreezeReason) ? " — " + Model.FreezeReason : "")</div>
            </div>
            @if ((bool)(ViewBag.CanUnfreeze ?? false))
            {
                <pems-form asp-action="Unfreeze" asp-route-id="@Model.DocumentId" method="post"><pems-flex wrap="true" gap="2" align="center">
                    <pems-input class="pems-maxw-240" scale="small" type="text" name="reason" placeholder="Unfreeze reason (required)" required />
                    <pems-button tone="dark" size="small" outline="true" type="submit" data-pems-confirm="انجماد این مدرک برداشته شود؟">
                        <pems-icon name="bi-sun" /> @Localizer["Unfreeze"]
                    </pems-button>
                </pems-flex></pems-form>
            }
        </pems-alert>
    }
    @if (Model.IsOnHold)
    {
        <pems-alert tone="warning" css="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0 py-2">
            <div class="small">
                <pems-icon name="bi-pause-circle" /> <strong>ON HOLD</strong> — این مدرک قابل تأیید (Approve) یا صدور (Issue) نیست تا زمانی که Hold رفع شود.
            </div>
            @if ((bool)(ViewBag.CanReleaseHold ?? false))
            {
                <pems-form asp-action="ReleaseHold" asp-route-id="@Model.DocumentId" method="post"><pems-flex wrap="true" gap="2" align="center">
                    <pems-input class="pems-maxw-240" scale="small" type="text" name="reason" placeholder="Release reason (required)" required />
                    <pems-button tone="dark" size="small" outline="true" type="submit" data-pems-confirm="Hold این مدرک رفع شود؟">
                        <pems-icon name="bi-play-circle" /> @Localizer["Release Hold"]
                    </pems-button>
                </pems-flex></pems-form>
            }
        </pems-alert>
    }

    @{
        var holdHistory = (List<PEMS.Application.DTOs.DocumentHoldDto>)(ViewBag.HoldHistory ?? new List<PEMS.Application.DTOs.DocumentHoldDto>());
    }
    @if (holdHistory.Any())
    {
        <details class="mt-2 small">
            <summary class="text-muted">Hold History (@holdHistory.Count)</summary>
            <pems-data-table data="@(DataRows.Of(holdHistory, c_ => c_.Add(((Localizer["Reason"])?.ToString() ?? ""), h => (object?)(h.Reason)).Add("Held", h => (object?)(h.HoldDate.ToString("yyyy-MM-dd HH:mm"))).Add("By", h => (object?)(h.HoldByName)).Add("Released", h => (object?)(h.ReleaseDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")).Add("By", h => (object?)(h.ReleaseByName)).Add("Release Reason", h => (object?)(h.ReleaseReason))))" enterprise="false" dense="true" css="table-enterprise mt-1" />
        </details>
    }

    @{
        var equipmentUsingThisAsPID = (IEnumerable<dynamic>)(ViewBag.EquipmentUsingThisAsPID ?? new List<dynamic>());
    }
    @if (equipmentUsingThisAsPID.Any())
    {
        <div class="mt-2">
            <span class="text-muted small">این مدرک P&amp;ID تجهیزات زیر است:</span>
            @foreach (var e in equipmentUsingThisAsPID)
            {
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@e.EquipmentId" class="text-decoration-none">
                    <pems-badge tone="info"><pems-icon name="bi-gear" /> @e.TagNumber</pems-badge>
                </a>
            }
        </div>
    }

    @* نمودار گرافیکی همیشه‌مرئی چرخه - همون چیزی که قبلاً فقط توی پاپ‌آپ Submit بود، حالا اینجا
       هم هست تا همیشه معلوم باشه مدرک دقیقاً کجای چرخه‌ست، بدون نیاز به باز کردن مدال. طبق بخش
       ۲۴ ممیزی UX: خلاصه‌ی پیشرفت IDC (بدون نیاز به اسکرول) این‌جا می‌ماند؛ ماتریس کامل هر
       دیسیپلین به تب اختصاصی IDC Review منتقل شد. *@
    @if (!string.IsNullOrEmpty(Model.Status))
    {
        <hr class="my-2" />
        <partial name="_PemsStageDiagram" model="wfStageDiagramModel" />

        @if (wfNextStep != null)
        {
            <pems-alert tone="info" css="py-2 mb-2 mt-2 small" role="note">
                <pems-icon name="bi-signpost-split" aria-hidden="true" /> <strong>@Localizer["Ed_NextStep"]</strong> @wfNextStep
            </pems-alert>
        }

        @if (Model.Status == "IDC Review" && idcStatusForPage.Any())
        {
            <div class="text-center small text-muted mb-1">
                IDC progress: <strong>@idcApprovedCount / @idcStatusForPage.Count</strong> disciplines completed
                &mdash; <a href="#tab-idc" data-bs-toggle="tab" data-bs-target="#tab-idc">view details</a>
            </div>
        }
    }
</div>

<pems-nav css="mb-3" id="docTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <pems-icon name="bi-info-circle" /> @Localizer["Ed_TabOverview"]
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-attachments" type="button">
            <pems-icon name="bi-paperclip" /> @Localizer["Ed_TabFiles"] <pems-badge tone="neutral">@(Model.Attachments?.Count ?? 0)</pems-badge>
        </pems-button>
    </li>
    @* طبق بخش ۲۵ ممیزی UX: IDC حالا یک تب اختصاصی است، نه فقط چند Badge کوچک توی هدر -
       فقط وقتی داده‌ی IDC واقعاً وجود دارد نمایش داده می‌شود (سند هیچ‌وقت وارد IDC نشده باشد،
       تب اضافه‌ای نیست). *@
    @if (idcStatusForPage.Any())
    {
        <li class="nav-item" role="presentation">
            <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-idc" type="button">
                <pems-icon name="bi-diagram-3" /> @Localizer["Ed_TabIdc"] <pems-badge tone="neutral">@idcApprovedCount/@idcStatusForPage.Count</pems-badge>
            </pems-button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-revisions" type="button">
            <pems-icon name="bi-clock-history" /> @Localizer["Ed_TabRevisions"] <pems-badge tone="neutral">@(Model.Revisions?.Count ?? 0)</pems-badge>
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-transmittals" type="button">
            <pems-icon name="bi-truck" /> @Localizer["Ed_TabTransmittals"]
            @if (relatedTransmittals.Any()) { <pems-badge tone="neutral">@relatedTransmittals.Count</pems-badge> }
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button">
            <pems-icon name="bi-chat-square-text" /> @Localizer["Ed_TabComments"]
            @if (engComments.Any()) { <pems-badge tone="@(commentsOpenCount > 0 ? "danger" : "neutral")">@commentsOpenCount<span class="visually-hidden"> @Localizer["Ed_OpenComments"]</span></pems-badge> }
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-workflow" type="button">
            <pems-icon name="bi-diagram-2" /> @Localizer["Ed_TabWorkflow"]
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-correspondence" type="button">
            <pems-icon name="bi-envelope-paper" /> @Localizer["Ed_TabDistribution"]
            @if (relatedLetters.Any()) { <pems-badge tone="neutral">@relatedLetters.Count</pems-badge> }
        </pems-button>
    </li>
</pems-nav>

<pems-tab-content>

    @* ===================== Overview ===================== *@
    <pems-tab-pane fade="true" active="true" id="tab-overview" role="tabpanel">
        <pems-row gap="3">
        <pems-col lg="8">
        <div class="vs-section">
            <h2 class="vs-section__title"><pems-icon name="bi-card-list" /> @Localizer["Ed_SecIdentification"]</h2>
            <pems-info-grid>
                <pems-info-item label="@Localizer["Ed_DocType"]">@Model.DocumentType</pems-info-item>
                <pems-info-item label="@Localizer["Ed_Project"]">@Model.ProjectName</pems-info-item>
                <pems-info-item label="@Localizer["Ed_Discipline"]">@Model.DisciplineName</pems-info-item>
                <pems-info-item label="@Localizer["Ed_Area"]">@(string.IsNullOrEmpty(Model.Area) ? "—" : Model.Area)</pems-info-item>
                <pems-info-item label="@Localizer["Ed_Revision"]" num>@Model.RevisionNo</pems-info-item>
                <pems-info-item label="@Localizer["Ed_CreatedDate"]" num>@Model.CreatedDate.ToString("yyyy-MM-dd")</pems-info-item>
                <pems-info-item label="@Localizer["Ed_Description"]" wide>@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</pems-info-item>
            </pems-info-grid>
        </div>

        <div class="vs-section">
            <h2 class="vs-section__title"><pems-icon name="bi-patch-check" /> @Localizer["Ed_SecEngineering"]</h2>
            <pems-info-grid>
                <pems-info-item label="@Localizer["Ed_IssuePurpose"]">@(string.IsNullOrEmpty(Model.IssuePurpose) ? "—" : Model.IssuePurpose)</pems-info-item>
                <pems-info-item label="@Localizer["Ed_PreparedBy"]">
                        @if (string.IsNullOrEmpty(Model.PreparedBy))
                        {
                            <span class="text-muted">@Localizer["Ed_NotSet"]</span>
                            @if (canAssignSignoff) { <text> &middot; <a asp-action="Edit" asp-route-id="@Model.DocumentId">@Localizer["Ed_Assign"]</a></text> }
                        }
                        else { @Model.PreparedBy }
                </pems-info-item>
                <pems-info-item label="@Localizer["Ed_CheckedBy"]">
                        @if (string.IsNullOrEmpty(Model.CheckedBy))
                        {
                            <span class="text-muted">@Localizer["Ed_NotSet"]</span>
                            @if (canAssignSignoff) { <text> &middot; <a asp-action="Edit" asp-route-id="@Model.DocumentId">@Localizer["Ed_Assign"]</a></text> }
                        }
                        else { @Model.CheckedBy }
                        @(Model.CheckedDate.HasValue ? $"({Model.CheckedDate:yyyy-MM-dd})" : "")
                        @if (!string.IsNullOrEmpty(Model.CheckedBySignaturePath))
                        {
                            <img class="pems-signature-small" src="@Model.CheckedBySignaturePath" alt="Signature" />
                        }
                </pems-info-item>
                <pems-info-item label="@Localizer["Ed_ApprovedBy"]">
                        @(string.IsNullOrEmpty(Model.ApprovedBy) ? "—" : Model.ApprovedBy) @(Model.ApprovedDate.HasValue ? $"({Model.ApprovedDate:yyyy-MM-dd})" : "")
                        @if (!string.IsNullOrEmpty(Model.ApprovedBySignaturePath))
                        {
                            <img class="pems-signature-small" src="@Model.ApprovedBySignaturePath" alt="Signature" />
                        }
                </pems-info-item>
                <pems-info-item label="@Localizer["Ed_CommentStatus"]">@(string.IsNullOrEmpty(Model.CommentStatus) ? "—" : Model.CommentStatus)</pems-info-item>
                @if (!string.IsNullOrEmpty(Model.ClientApprovalStatus))
                {
                    <pems-info-item label="@Localizer["Ed_ClientResponse"]">
                            <span class="vs-pill vs-pill--icon @(Model.ClientApprovalStatus == "Approved" ? "vs-pill--success" : Model.ClientApprovalStatus == "Rejected" ? "vs-pill--danger" : "vs-pill--warning")"><pems-icon css="@(Model.ClientApprovalStatus == "Approved" ? "bi-check-circle" : Model.ClientApprovalStatus == "Rejected" ? "bi-x-circle" : "bi-exclamation-circle")" aria-hidden="true" /> @Model.ClientApprovalStatus</span>
                            @if (!string.IsNullOrEmpty(Model.ClientComment)) { <span class="vs-sub">@Model.ClientComment</span> }
                    </pems-info-item>
                }
                <pems-info-item label="@Localizer["Ed_RelatedEquipment"]">
                        @if (Model.EquipmentId.HasValue)
                        { <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.EquipmentTagNumber</a> }
                        else { <span class="text-muted">—</span> }
                </pems-info-item>
                <pems-info-item label="@Localizer["Ed_RelatedContract"]">
                        @if (Model.ContractId.HasValue)
                        { <a asp-controller="Contract" asp-action="Details" asp-route-id="@Model.ContractId">@Model.ContractNo</a> }
                        else { <span class="text-muted">—</span> }
                </pems-info-item>
            </pems-info-grid>
        </div>
        </pems-col>
        <pems-col lg="4">
            <div class="vs-section">
                <h2 class="vs-section__title"><pems-icon name="bi-chat-square-text" /> @Localizer["Ed_TabComments"]</h2>
                <p class="small text-muted mb-2">@string.Format(Localizer["Ed_OpenClosed"].Value, commentsOpenCount, commentsClosedCount)</p>
                @if (!engComments.Any())
                {
                    <p class="small text-muted border rounded p-2 text-center mb-2">@Localizer["Ed_NoCommentsHint"]</p>
                }
                <pems-flex wrap="true" gap="2">
                    <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#addEngCommentModal"><pems-icon name="bi-plus-lg" aria-hidden="true" /> @Localizer["Add Comment"]</pems-button>
                    @if (engComments.Any())
                    {
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="tab" data-bs-target="#tab-comments">@Localizer["Ed_ViewAll"]</pems-button>
                    }
                </pems-flex>
            </div>
            <div class="vs-section">
                <h2 class="vs-section__title"><pems-icon name="bi-paperclip" /> @Localizer["Ed_TabFiles"]</h2>
                <p class="small text-muted mb-2">@((Model.Attachments?.Count ?? 0) == 0 ? Localizer["Ed_NoFilesHint"].Value : string.Format(Localizer["Ed_FilesCount"].Value, Model.Attachments!.Count))</p>
                <pems-flex wrap="true" gap="2">
                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="UploadAttachment" asp-route-id="@Model.DocumentId"><pems-icon name="bi-upload" aria-hidden="true" /> @Localizer["Ed_Upload"]</pems-button>
                    @if ((Model.Attachments?.Count ?? 0) > 0)
                    {
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="tab" data-bs-target="#tab-attachments">@Localizer["Ed_ViewAll"]</pems-button>
                    }
                </pems-flex>
            </div>
        </pems-col>
        </pems-row>
    </pems-tab-pane>

    @* ===================== Attachments & AI ===================== *@
    <pems-tab-pane fade="true" id="tab-attachments" role="tabpanel">
        <div class="vs-section">
            <pems-flex justify="between" align="center" css="mb-3">
                <h6 class="mb-0">@Localizer["Ed_SecFiles"]</h6>
                <pems-button tone="primary" size="small" as="a" asp-action="UploadAttachment" asp-route-id="@Model.DocumentId">
                    <pems-icon name="bi-upload" /> @Localizer["Ed_Upload"]
                </pems-button>
            </pems-flex>

            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <pems-table kind="enterprise">
                    <pems-table-head>
                        <pems-table-row><pems-table-header>@Localizer["Ed_FileName"]</pems-table-header><pems-table-header>@Localizer["Ed_Revision"]</pems-table-header><pems-table-header>@Localizer["Ed_Ext"]</pems-table-header><pems-table-header>@Localizer["Ed_Size"]</pems-table-header><pems-table-header>@Localizer["Ed_AiStatus"]</pems-table-header><pems-table-header>@Localizer["Ed_Date"]</pems-table-header><pems-table-header class="text-end">@Localizer["Ed_Actions"]</pems-table-header></pems-table-row>
                    </pems-table-head>
                    <pems-table-body>
                        @foreach (var file in Model.Attachments)
                        {
                            var badgeClass = file.AIStatus switch
                            {
                                "Completed" => "success",
                                "Processing" => "info",
                                "Pending" => "neutral",
                                "Failed" => "danger",
                                _ => "neutral"
                            };
                            var fileIsCurrentRev = file.DocumentRevisionId.HasValue && file.RevisionNo == Model.RevisionNo;
                            var fileIsPreviousRev = file.DocumentRevisionId.HasValue && !fileIsCurrentRev;
                            <pems-table-row class="@(fileIsPreviousRev ? "vs-rev-superseded" : "")">
                                <pems-table-cell>
                                    @file.FileName
                                    @if (!string.IsNullOrEmpty(file.FileHash))
                                    {
                                        <pems-icon name="bi-shield-check" css="text-success ms-1" data-bs-toggle="tooltip" title="SHA-256: @file.FileHash" />
                                    }
                                </pems-table-cell>
                                <pems-table-cell>
                                    @if (file.DocumentRevisionId.HasValue)
                                    {
                                        <pems-badge tone="neutral">@Localizer["Ed_CurrentRev"] @file.RevisionNo</pems-badge>
                                        @if (fileIsCurrentRev) { <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentRevFile"]</span> }
                                        else { <span class="vs-sub">@Localizer["Ed_PreviousRevFile"]</span> }
                                        @if (file.IsOfficial)
                                        {
                                            <pems-badge tone="success" data-bs-toggle="tooltip" title="Official file for this revision">Official</pems-badge>
                                        }
                                        @if (!string.IsNullOrEmpty(file.FileRole))
                                        {
                                            <span class="text-muted small d-block">@file.FileRole</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Localizer["Ed_DocLevelFile"]</span>
                                    }
                                </pems-table-cell>
                                <pems-table-cell>@file.FileExtension</pems-table-cell>
                                <pems-table-cell>@(file.FileSize / 1024) KB</pems-table-cell>
                                <pems-table-cell><pems-badge tone="@badgeClass">@file.AIStatus</pems-badge></pems-table-cell>
                                <pems-table-cell class="small text-muted">@file.UploadDate.ToString("yyyy-MM-dd")</pems-table-cell>
                                <pems-table-cell class="text-end">
                                    <pems-flex gap="1" justify="end" wrap="true">
                                        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="DownloadAttachment" asp-route-id="@file.AttachmentId" data-bs-toggle="tooltip" title="Download attachment" aria-label="Download @file.FileName"><pems-icon name="bi-download" /></pems-button>
                                        @if (file.AIStatus == "Completed")
                                        {
                                            <pems-button tone="warning" size="small" outline="true" as="a" asp-controller="AIExtraction" asp-action="Review" asp-route-attachmentId="@file.AttachmentId">AI Data</pems-button>
                                            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EngineeringDocumentIntelligence" asp-action="Review" asp-route-id="@Model.DocumentId">Intelligence</pems-button>
                                        }
                                        <pems-form asp-controller="OCRProcessing" asp-action="Retry" asp-route-id="@file.AttachmentId" method="post" class="d-inline">
                                            <pems-button tone="neutral" size="small" outline="true" data-bs-toggle="tooltip" title="Re-analyze" aria-label="Re-analyze @file.FileName"><pems-icon name="bi-arrow-repeat" /></pems-button>
                                        </pems-form>
                                        <pems-form asp-action="DeleteAttachment" asp-route-id="@file.AttachmentId" method="post" class="d-inline" data-pems-confirm="Delete file?">
                                            <pems-button tone="danger" size="small" outline="true" data-bs-toggle="tooltip" title="Delete attachment" aria-label="Delete @file.FileName"><pems-icon name="bi-trash" /></pems-button>
                                        </pems-form>
                                    </pems-flex>
                                </pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoFiles"]</p>
            }
        </div>
    </pems-tab-pane>

    @* ===================== IDC Review ===================== *@
    @* طبق «PEMS Engineering IDC Ownership Correction» (بخش ۹ - Originator Actions): این
       ماتریس اکنون خلاصه‌ی تجمیع‌شده‌ی IDC برای سازنده/تأییدکننده‌ی مدرک است - نه فقط یک
       نشانگر وضعیت. IdcStatusItemDto حالا Comment/RespondedByName/RespondedDate هم دارد
       (از DocumentIdcReferral دائمی، نه جدول گذرای موتور) تا نظرات واقعاً قابل‌مرور باشند.
       مهم: نتیجه‌ی هیچ دیسیپلینی این‌جا (حتی Reject) وضعیت رسمی مدرک را تعیین نمی‌کند -
       این فقط یک خلاصه‌ی اطلاعاتی است؛ تصمیم رسمی در مرحله‌ی Approval گرفته می‌شود. *@
    @if (idcStatusForPage.Any())
    {
        <pems-tab-pane fade="true" id="tab-idc" role="tabpanel">
            <div class="vs-section">
                <pems-flex justify="between" align="center" css="mb-3">
                    <h6 class="mb-0"><pems-icon name="bi-diagram-3" /> Inter-Discipline Check (IDC) — Discipline Review Summary</h6>
                    <span class="text-muted small">@idcApprovedCount / @idcStatusForPage.Count disciplines responded</span>
                </pems-flex>
                <p class="text-muted small">
                    <pems-icon name="bi-info-circle" /> نتایج زیر صرفاً مشورتی هستند و به‌تنهایی وضعیت رسمی مدرک را
                    تعیین نمی‌کنند - حتی اگر یک یا چند دیسیپلین «Reject» بدهند. تصمیم نهایی (Approve/Reject/Revise &amp;
                    Resubmit) همیشه توسط سازنده/تأییدکننده‌ی مدرک، با در نظر گرفتن مجموع این نظرات، گرفته می‌شود.
                </p>
                <pems-progress value="@idcApprovedCount" max="@idcStatusForPage.Count" tone="success" height="8px" css="mb-3"></pems-progress>
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Comment"]</pems-table-header><pems-table-header>Responded By</pems-table-header><pems-table-header>Responded Date</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var idc in idcStatusForPage)
                        {
                            var (idcIcon, idcBadge, idcLabel) = idc.Status switch
                            {
                                "Approve" => ("bi-check-circle-fill", "bg-success", "Approved"),
                                "Comment" => ("bi-chat-left-text-fill", "bg-warning text-dark", "Approved with Comments"),
                                "Reject" => ("bi-x-circle-fill", "bg-danger", "Revision Required"),
                                _ => ("bi-hourglass-split", "bg-secondary", "Pending")
                            };
                            <pems-table-row>
                                <pems-table-cell>@idc.DisciplineName</pems-table-cell>
                                <pems-table-cell><pems-badge tone="none" css="@idcBadge"><pems-icon css="@idcIcon" /> @idcLabel</pems-badge></pems-table-cell>
                                <pems-table-cell class="small">@(idc.Comment ?? "—")</pems-table-cell>
                                <pems-table-cell class="small">@(idc.RespondedByName ?? "—")</pems-table-cell>
                                <pems-table-cell class="small">@(idc.RespondedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
                @if (Model.Status == "IDC Review")
                {
                    var myDisciplineIdForIdcTab = ViewBag.MyDisciplineId as int?;
                    var myPendingIdcTab = idcStatusForPage.FirstOrDefault(x => x.DisciplineId == myDisciplineIdForIdcTab && x.Status == "Pending");
                    @if (myPendingIdcTab != null)
                    {
                        <pems-flex align="center" gap="2" css="mt-3">
                            <span class="text-muted small">@Localizer["My IDC Review:"]</span>
                            <pems-form asp-action="IdcRespond" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.DocumentId" />
                                <input type="hidden" name="decision" value="Approve" />
                                <pems-button tone="bare" css="vs-btn vs-btn--primary"><pems-icon name="bi-check-lg" /> No Comment</pems-button>
                            </pems-form>
                            <pems-button tone="bare" type="button" css="vs-btn" data-bs-toggle="modal" data-bs-target="#idcCommentModal">@Localizer["Approve with Comments"]</pems-button>
                            <pems-button tone="bare" type="button" css="vs-btn vs-btn--dangerline" data-bs-toggle="modal" data-bs-target="#idcRejectModal">@Localizer["Revision Required"]</pems-button>
                        </pems-flex>
                    }
                }
            </div>
        </pems-tab-pane>
    }

    @* ===================== Revisions ===================== *@
    <pems-tab-pane fade="true" id="tab-revisions" role="tabpanel">
        <div class="vs-section">
            <h6 class="mb-3">@Localizer["Ed_SecRevisionHistory"]</h6>
            @if (Model.Revisions != null && Model.Revisions.Any())
            {
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Ed_RevisionCol"]</pems-table-header><pems-table-header>@Localizer["Ed_Status"]</pems-table-header><pems-table-header>@Localizer["Ed_ClientReviewCol"]</pems-table-header><pems-table-header>@Localizer["Ed_Reason"]</pems-table-header><pems-table-header>@Localizer["Ed_CreatedBy"]</pems-table-header><pems-table-header>@Localizer["Ed_Reviewer"]</pems-table-header><pems-table-header>@Localizer["Ed_ApprovedCol"]</pems-table-header>
                        <pems-table-header>@Localizer["Ed_Created"]</pems-table-header><pems-table-header>@Localizer["Ed_IssuedCol"]</pems-table-header><pems-table-header>@Localizer["Ed_EffectiveCol"]</pems-table-header><pems-table-header>@Localizer["Ed_SupersedesCol"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var rev in Model.Revisions)
                        {
                            var revIsCurrent = rev.RevisionNo == Model.RevisionNo;
                            <pems-table-row class="@(revIsCurrent ? "vs-rev-current" : "vs-rev-superseded")">
                                <pems-table-cell><span class="vs-num vs-num--strong">@rev.RevisionNo</span> @if (revIsCurrent) { <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentBadge"]</span> }</pems-table-cell>
                                <pems-table-cell><span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(rev.Status)"><pems-icon css="@DocumentStatusBadge.Icon(rev.Status)" aria-hidden="true" /> @StatusText(rev.Status)</span></pems-table-cell>
                                <pems-table-cell class="small">
                                    @{
                                        var clientBadge = rev.ClientReviewStatus switch
                                        {
                                            "A" => "bg-success",
                                            "B" or "C" or "D" => "bg-danger",
                                            _ => null
                                        };
                                    }
                                    @if (clientBadge != null)
                                    {
                                        <pems-badge tone="none" css="@clientBadge" title="@rev.ClientReviewComment">@rev.ClientReviewStatus @(rev.ClientReviewDate.HasValue ? $"({rev.ClientReviewDate:yyyy-MM-dd})" : "")</pems-badge>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["Ed_NotSubmittedToClient"]</span>
                                    }
                                </pems-table-cell>
                                <pems-table-cell class="small">@rev.Reason</pems-table-cell>
                                <pems-table-cell class="small">@(rev.CreatedByName ?? "—")</pems-table-cell>
                                <pems-table-cell>@rev.ReviewerName</pems-table-cell>
                                <pems-table-cell>@rev.ApprovedBy</pems-table-cell>
                                <pems-table-cell class="small text-muted">@rev.CreatedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                                <pems-table-cell class="small text-muted">@(rev.IssuedDate?.ToString("yyyy-MM-dd"))</pems-table-cell>
                                <pems-table-cell class="small text-muted">@(rev.EffectiveDate?.ToString("yyyy-MM-dd"))</pems-table-cell>
                                <pems-table-cell class="small">@rev.SupersededRevisionNo</pems-table-cell>
                            </pems-table-row>
                            @if (!string.IsNullOrEmpty(rev.ChangeDescription) || !string.IsNullOrEmpty(rev.AIRevisionSummary) || !string.IsNullOrEmpty(rev.VendorComment))
                            {
                                <pems-table-row class="table-light">
                                    <pems-table-cell colspan="11" class="small">
                                        @if (!string.IsNullOrEmpty(rev.ChangeDescription)) { <div><strong>Change:</strong> @rev.ChangeDescription</div> }
                                        @if (!string.IsNullOrEmpty(rev.VendorComment)) { <div><pems-icon name="bi-building" /> <strong>Vendor Comment:</strong> @rev.VendorComment</div> }
                                        @if (!string.IsNullOrEmpty(rev.AIRevisionSummary)) { <div><pems-icon name="bi-robot" /> <strong>AI Summary:</strong> @rev.AIRevisionSummary</div> }
                                    </pems-table-cell>
                                </pems-table-row>
                            }
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoRevisions"]</p>
            }
        </div>
    </pems-tab-pane>

    @* ===================== Workflow History ===================== *@
    @* طبق بخش ۳۳ ممیزی UX: جدول خام قبلی به Timeline تبدیل شد؛ خودِ جدول کامل هم برای Audit
       کامل در یک <details> در پایین حفظ شده - هیچ داده‌ای حذف نشده. *@
    @* طبق «PEMS Engineering Workflow History Read-Path Correction»: این تب قبلاً از
       Model.Workflows (جدول قدیمی DocumentWorkflow) می‌خواند - که فقط یک‌بار موقع Create یک
       ردیف می‌گیرد و هیچ‌کدام از Submit/Check/IDC/Approve/Reject/Issue را ثبت نمی‌کند؛ یعنی
       این تب همیشه (نه فقط بعد از اصلاح مالکیت IDC) عملاً خالی/ناقص بود. حالا از
       WorkflowHistory واقعی (روی همه‌ی Instance های این مدرک، نه فقط چرخه‌ی جاری) می‌خواند. *@
    <pems-tab-pane fade="true" id="tab-workflow" role="tabpanel">
        <div class="vs-section">
            <h6 class="mb-3">@Localizer["Ed_SecWorkflowHistory"]</h6>
            @if (workflowHistoryForPage.Any())
            {
                var orderedWorkflow = workflowHistoryForPage.OrderByDescending(x => x.ActionDate).ToList();
                <div class="pems-workflow-timeline">
                    @foreach (var item in orderedWorkflow)
                    {
                        var wfIcon = item.ActionType switch
                        {
                            "Approve" => "bi-check-circle-fill text-success",
                            "Reject" => "bi-x-circle-fill text-danger",
                            "Comment" => "bi-chat-left-text-fill text-warning",
                            "Start" or "Submit" => "bi-send-fill text-primary",
                            "Issue" => "bi-check2-circle text-primary",
                            "AutoSkip" => "bi-fast-forward-fill text-secondary",
                            _ => "bi-record-circle-fill text-secondary"
                        };
                        <div class="pems-timeline-item">
                            <div class="pems-timeline-marker"><pems-icon css="@wfIcon" /></div>
                            <div class="pems-timeline-content">
                                <pems-flex justify="between" wrap="true" gap="2">
                                    <div>
                                        <pems-badge tone="neutral">@item.ActionType</pems-badge>
                                        <span class="small text-muted ms-1">@(item.FromStageName ?? "—") &rarr; @(item.ToStageName ?? "—")</span>
                                    </div>
                                    <span class="small text-muted">@item.ActionDate.ToString("yyyy-MM-dd HH:mm")</span>
                                </pems-flex>
                                @if (!string.IsNullOrEmpty(item.Comment))
                                {
                                    <div class="small mt-1">"@item.Comment"</div>
                                }
                                <div class="small text-muted mt-1"><pems-icon name="bi-person" /> @(item.ActorName ?? "System")</div>
                            </div>
                        </div>
                    }
                </div>

                <details class="mt-3 small">
                    <summary class="text-muted">Full audit table (@orderedWorkflow.Count)</summary>
                    <pems-data-table data="@(DataRows.Of(orderedWorkflow, c_ => c_.Add(((Localizer["From"])?.ToString() ?? ""), item => (object?)(item.FromStageName ?? "—")).Add("To", item => (object?)(item.ToStageName ?? "—")).Add(((Localizer["Action"])?.ToString() ?? ""), item => (object?)(item.ActionType), kind: DataCellKind.Badge, tone: item => "neutral").Add(((Localizer["Comment"])?.ToString() ?? ""), item => (object?)(item.Comment)).Add(((Localizer["Date"])?.ToString() ?? ""), item => (object?)(item.ActionDate.ToString("yyyy-MM-dd HH:mm")), css: "small text-muted").Add(((Localizer["User"])?.ToString() ?? ""), item => (object?)(item.ActorName ?? "System"))))" css="mt-2" />
                </details>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoWorkflow"]</p>
            }
        </div>
    </pems-tab-pane>

    @* ===================== Correspondence ===================== *@
    <pems-tab-pane fade="true" id="tab-correspondence" role="tabpanel">
        <div class="vs-section">
            <h6 class="mb-3"><pems-icon name="bi-envelope-paper" /> @Localizer["Ed_SecCorrespondence"]</h6>
            @if (relatedLetters.Any())
            {
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Ed_Letters_Type"]</pems-table-header><pems-table-header>@Localizer["Ed_LetterNo"]</pems-table-header><pems-table-header>@Localizer["Ed_Subject"]</pems-table-header><pems-table-header>@Localizer["Ed_Date"]</pems-table-header><pems-table-header>@Localizer["Ed_Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
