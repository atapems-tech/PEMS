                        @foreach (var l in relatedLetters)
                        {
                            <pems-table-row>
                                <pems-table-cell><pems-badge tone="neutral">@l.LetterType</pems-badge></pems-table-cell>
                                <pems-table-cell>@l.LetterNumber</pems-table-cell>
                                <pems-table-cell>@l.Subject</pems-table-cell>
                                <pems-table-cell class="small text-muted">@l.LetterDate.ToString("yyyy-MM-dd")</pems-table-cell>
                                <pems-table-cell><pems-badge tone="info">@l.Status</pems-badge></pems-table-cell>
                                <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId" data-bs-toggle="tooltip" title="View letter" aria-label="View letter @l.LetterNumber"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoCorrespondence"]</p>
            }
        </div>

    </pems-tab-pane>

    @* ===================== Transmittals ===================== *@
    <pems-tab-pane fade="true" id="tab-transmittals" role="tabpanel">
        @* طبق «PEMS Phase 2A — EDMS Foundation» بخش ۲: قبلاً هیچ پیوند متقابلی با Transmittal
           روی این صفحه نبود - Service/Entity موجود، فقط یک بخش خلاصه‌ی جدید *@
        <div class="vs-section">
            <h6 class="mb-3"><pems-icon name="bi-truck" /> @Localizer["Ed_SecTransmittals"]</h6>
            @if (relatedTransmittals.Any())
            {
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Ed_TransmittalNo"]</pems-table-header><pems-table-header>@Localizer["Ed_RevSent"]</pems-table-header><pems-table-header>@Localizer["Ed_Purpose"]</pems-table-header><pems-table-header>@Localizer["Ed_Date"]</pems-table-header><pems-table-header>@Localizer["Ed_Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var t in relatedTransmittals)
                        {
                            <pems-table-row>
                                <pems-table-cell>@t.TransmittalNo</pems-table-cell>
                                <pems-table-cell class="small text-muted">@Localizer["Ed_CurrentRev"] <span class="vs-num">@t.RevisionNoAtTransmittal</span></pems-table-cell>
                                <pems-table-cell>@t.Purpose</pems-table-cell>
                                <pems-table-cell class="small text-muted">@(t.SentDate?.ToString("yyyy-MM-dd") ?? t.TransmittalDate.ToString("yyyy-MM-dd"))</pems-table-cell>
                                <pems-table-cell><span class="vs-pill @PEMS.Web.Helpers.VdrUi.TransmittalTone(t.Status)">@VdrUi.Loc(Localizer, "St_", t.Status)</span></pems-table-cell>
                                <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Transmittal" asp-action="Details" asp-route-id="@t.TransmittalId" data-bs-toggle="tooltip" title="View transmittal" aria-label="View transmittal @t.TransmittalNo"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoTransmittals"]</p>
            }
        </div>
    </pems-tab-pane>

    @* ===================== Comments (Document Viewer + Comment Management) ===================== *@
    <pems-tab-pane fade="true" id="tab-comments" role="tabpanel">
@if (latestPdfAttachment != null)
{
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="center" css="mb-2">
            <h6 class="mb-0"><pems-icon name="bi-file-earmark-pdf" /> Document Viewer <span class="text-muted small">(click anywhere on the page to pin a comment)</span></h6>
            <pems-flex align="center" gap="2">
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfPrevPage" data-bs-toggle="tooltip" title="@Localizer["Previous page"]" aria-label="@Localizer["Previous page"]"><pems-icon name="bi-chevron-left" /></pems-button>
                <span class="small" id="pdfPageLabel">Page - / -</span>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfNextPage" data-bs-toggle="tooltip" title="@Localizer["Next page"]" aria-label="@Localizer["Next page"]"><pems-icon name="bi-chevron-right" /></pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfZoomOut" data-bs-toggle="tooltip" title="@Localizer["Zoom out"]" aria-label="@Localizer["Zoom out"]"><pems-icon name="bi-zoom-out" /></pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfZoomIn" data-bs-toggle="tooltip" title="@Localizer["Zoom in"]" aria-label="@Localizer["Zoom in"]"><pems-icon name="bi-zoom-in" /></pems-button>
            </pems-flex>
        </pems-flex>
        <div class="pems-pdf-canvas" id="pdfCanvasWrapper">
            <canvas id="pdfCanvas"></canvas>
        </div>
    </pems-content-card>

    <script type="module" src="~/js/pdfjs-loader.js"></script>
    <script type="module">
        (function () {

            var pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Download", "Files", new { id = latestPdfAttachment.AttachmentId })));
            var wrapper = document.getElementById('pdfCanvasWrapper');
            var canvas = document.getElementById('pdfCanvas');
            var ctx = canvas.getContext('2d');
            var pdfDoc = null, currentPage = 1, scale = 1.2;

            var pins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(engComments
                .Where(c => c.PageNumber.HasValue)
                .Select(c => new { c.CommentNo, c.PageNumber, c.PinX, c.PinY, c.CommentText }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            function renderPage(num) {
                pdfDoc.getPage(num).then(function (page) {
                    var viewport = page.getViewport({ scale: scale });
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;

                    page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function () {
                        document.getElementById('pdfPageLabel').textContent = 'Page ' + num + ' / ' + pdfDoc.numPages;
                        renderPins(num, viewport.width, viewport.height);
                    });
                });
            }

            function renderPins(pageNum, width, height) {
                wrapper.querySelectorAll('.pdf-pin').forEach(function (el) { el.remove(); });

                pins.filter(function (p) { return p.pageNumber === pageNum; }).forEach(function (p) {
                    var pin = document.createElement('div');
                    pin.className = 'pdf-pin';
                    pin.title = p.commentNo + ': ' + p.commentText;
                    pin.style.cssText = 'position:absolute;width:22px;height:22px;border-radius:50% 50% 50% 0;' +
                        'background:#ef4444;border:2px solid #fff;transform:translate(-50%,-100%) rotate(-45deg);' +
                        'left:' + (p.pinX / 100 * width) + 'px;top:' + (p.pinY / 100 * height) + 'px;cursor:pointer;';
                    wrapper.appendChild(pin);
                });
            }

            pdfjsLib.getDocument(pdfUrl).promise.then(function (doc) {
                pdfDoc = doc;
                renderPage(currentPage);
            }).catch(function () {
                wrapper.innerHTML = '<p class="text-muted py-4">Could not load the PDF preview.</p>';
            });

            document.getElementById('pdfPrevPage').addEventListener('click', function () {
                if (currentPage > 1) { currentPage--; renderPage(currentPage); }
            });
            document.getElementById('pdfNextPage').addEventListener('click', function () {
                if (pdfDoc && currentPage < pdfDoc.numPages) { currentPage++; renderPage(currentPage); }
            });
            document.getElementById('pdfZoomIn').addEventListener('click', function () { scale += 0.2; renderPage(currentPage); });
            document.getElementById('pdfZoomOut').addEventListener('click', function () { if (scale > 0.4) { scale -= 0.2; renderPage(currentPage); } });

            canvas.addEventListener('click', function (e) {
                var rect = canvas.getBoundingClientRect();
                var xPct = ((e.clientX - rect.left) / rect.width) * 100;
                var yPct = ((e.clientY - rect.top) / rect.height) * 100;

                document.getElementById('engPinPageNumber').value = currentPage;
                document.getElementById('engPinX').value = xPct.toFixed(2);
                document.getElementById('engPinY').value = yPct.toFixed(2);
                document.getElementById('engPinLocationLabel').textContent = 'Pinned on page ' + currentPage;

                var modal = new bootstrap.Modal(document.getElementById('addEngCommentModal'));
                modal.show();
            });

            document.getElementById('addEngCommentModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('engPinPageNumber').value = '';
                document.getElementById('engPinX').value = '';
                document.getElementById('engPinY').value = '';
                document.getElementById('engPinLocationLabel').textContent = '';
            });
        })();
    </script>
}

<pems-content-card css="mb-3">
    <h6 class="mb-3">Comment Management <span class="text-muted small">(Action Status is tracked independently from Review Status)</span></h6>

    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>No</pems-table-header><pems-table-header>@Localizer["Category"]</pems-table-header><pems-table-header>Sheet/Zone</pems-table-header><pems-table-header>@Localizer["Comment"]</pems-table-header><pems-table-header>@Localizer["Raised By"]</pems-table-header><pems-table-header>@Localizer["Raised"]</pems-table-header><pems-table-header>@Localizer["Action Status"]</pems-table-header><pems-table-header>@Localizer["Response"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var c in engComments)
            {
                <pems-table-row>
                    <pems-table-cell><strong>@c.CommentNo</strong></pems-table-cell>
                    <pems-table-cell>
                        @if (!string.IsNullOrEmpty(c.Category)) { <pems-badge tone="neutral">@c.Category</pems-badge> }
                        @if (!string.IsNullOrEmpty(c.Severity)) { <pems-badge tone="dark">@c.Severity</pems-badge> }
                    </pems-table-cell>
                    <pems-table-cell class="small">@c.Sheet @c.Zone</pems-table-cell>
                    <pems-table-cell class="small">
                        @c.CommentText
                        @if (!string.IsNullOrEmpty(c.AttachmentFilePath))
                        {
                            <div><a href="@Url.Action("Download", "Files", new { id = c.AttachmentId })" target="_blank"><pems-icon name="bi-paperclip" /> @c.AttachmentFileName</a></div>
                        }
                        @if (!string.IsNullOrEmpty(c.RequiredAction))
                        {
                            <div class="text-muted">Required: @c.RequiredAction</div>
                        }
                        @if (c.MarksRevisionRequired)
                        {
                            <div>
                                <pems-badge tone="warning"><pems-icon name="bi-cloud-fill" /> Marked for Revision</pems-badge>
                                @if (c.TriggeredRevisionId.HasValue)
                                {
                                    <pems-badge tone="success">Rev @c.TriggeredRevisionNo created</pems-badge>
                                }
                                else
                                {
                                    <pems-badge tone="neutral">no revision yet</pems-badge>
                                }
                            </div>
                        }
                    </pems-table-cell>
                    <pems-table-cell>@c.RaisedByName</pems-table-cell>
                    <pems-table-cell>@c.RaisedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                    <pems-table-cell>
                        @{
                            var eab = c.ActionStatus switch
                            {
                                "Closed" => "success",
                                "Verified" => "info",
                                "VendorResponsePending" => "warning",
                                "NoActionRequired" => "neutral",
                                _ => "danger"
                            };
                        }
                        <pems-badge tone="@eab">@c.ActionStatus</pems-badge>
                        <pems-form asp-action="SetCommentAction" method="post" class="d-inline">
                            <input type="hidden" name="documentId" value="@Model.DocumentId" />
                            <input type="hidden" name="commentId" value="@c.VDRCommentId" />
                            <pems-select class="pems-w-170" scale="small" css="mt-1" name="actionStatus" data-pems-change="submit-form">
                                @foreach (var s in new[] { "OpenComment", "VendorResponsePending", "Verified", "Closed", "NoActionRequired" })
                                { <option value="@s" selected="@(s == c.ActionStatus)">@s</option> }
                            </pems-select>
                        </pems-form>
                    </pems-table-cell>
                    <pems-table-cell class="small">
                        @c.ResponseText
                        @if (!string.IsNullOrEmpty(c.ReplyAttachmentFilePath))
                        {
                            <div><a href="@Url.Action("Download", "Files", new { id = c.ReplyAttachmentId })" target="_blank"><pems-icon name="bi-paperclip" /> @c.ReplyAttachmentFileName</a></div>
                        }
                        @if (string.IsNullOrEmpty(c.ResponseText) && string.IsNullOrEmpty(c.ReplyAttachmentFilePath))
                        {
                            <pems-button tone="primary" size="small" outline="true" css="mt-1" type="button" data-bs-toggle="modal" data-bs-target="#engReplyModal" data-fill-commentid="@c.VDRCommentId" data-fill-commentno="@c.CommentNo" data-fill-commenttext="@c.CommentText">
                                <pems-icon name="bi-reply" /> Reply
                            </pems-button>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (!engComments.Any()) { <p class="text-muted">No comments recorded yet.</p> }

    <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#addEngCommentModal">
        <pems-icon name="bi-plus-lg" /> @Localizer["Add Comment"]
    </pems-button>
</pems-content-card>
    </pems-tab-pane>

</pems-tab-content>

@* ==============================================================================
   پاپ‌آپ Submit/Resubmit با نمایش گرافیکی کل چرخه‌ی گردش‌کار - به‌جای یک دکمه‌ی تکی که
   مستقیم POST می‌کرد، حالا کاربر قبل از تایید نهایی، کل مسیر و اینکه هر مرحله دست کیه
   رو می‌بینه.
   ============================================================================== *@
<pems-modal size="large" id="submitWorkflowModal" tabindex="-1">
            <pems-form asp-action="Submit" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <pems-modal-header close="true"><pems-icon name="bi-signpost-split" /> Engineering Document Approval Workflow</pems-modal-header>
                <pems-modal-body>
                    <partial name="_PemsStageDiagram" model="wfStageDiagramModel" />

                    <hr />

                    <div class="mb-2">
                        <pems-label css="small fw-bold">
                            <pems-icon name="bi-diagram-3" /> این مدرک نیاز به بازبینی سایر دیسیپلین‌ها (IDC) داره؟
                        </pems-label>
                        <div class="text-muted small mb-2">
                            اگه دیسیپلینی رو انتخاب نکنی، مدرک بعد از Check مستقیم می‌ره مرحله‌ی تایید نهایی (بدون IDC).
                        </div>
                        <pems-row>
                            @{
                                var allDisciplinesForSubmit = (IEnumerable<PEMS.Domain.Entities.Discipline>)(ViewBag.AllDisciplines ?? new List<PEMS.Domain.Entities.Discipline>());
                            }
                            @foreach (var d in allDisciplinesForSubmit.Where(x => x.DisciplineId != Model.DisciplineId))
                            {
                                <pems-col span="6" md="4">
                                    <pems-check-row>
                                        <pems-input kind="check" type="checkbox" name="idcDisciplineIds" value="@d.DisciplineId" id="idcDisc_@d.DisciplineId" />
                                        <label class="form-check-label small" for="idcDisc_@d.DisciplineId">@d.Name</label>
                                    </pems-check-row>
                                </pems-col>
                            }
                        </pems-row>
                    </div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="warning" size="small" type="submit"><pems-icon name="bi-send" /> @Localizer["تایید و ارسال"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@* ==============================================================================
   پاسخ IDC با کامنت (Comment) یا رد (Reject) - هر دو نیاز به توضیح دارن، برخلاف Approve
   که یک دکمه‌ی ساده‌ست
   ============================================================================== *@
<pems-modal id="idcCommentModal" tabindex="-1">
            <pems-form asp-action="IdcRespond" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <input type="hidden" name="decision" value="Comment" />
                <pems-modal-header>@Localizer["ثبت کامنت بازبینی IDC (دیسیپلین شما)"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">این نظر به‌عنوان نتیجه‌ی بازبینی دیسیپلین شما ثبت می‌شود و مستقیماً روی وضعیت رسمی مدرک اثر نمی‌گذارد. بعد از پاسخ همه‌ی دیسیپلین‌های ارجاع‌شده، سازنده/تأییدکننده‌ی مدرک با دیدن مجموع نظرات IDC تصمیم نهایی را می‌گیرد.</p>
                    <pems-textarea scale="small" name="comment" rows="3" required></pems-textarea>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="warning" size="small" type="submit">@Localizer["ثبت کامنت"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

<pems-modal id="idcRejectModal" tabindex="-1">
            <pems-form asp-action="IdcRespond" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <input type="hidden" name="decision" value="Reject" />
                <pems-modal-header>@Localizer["اعلام نیاز به اصلاح (دیسیپلین شما)"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small"><strong>این اقدام، مدرک را رد نمی‌کند و آن را به سازنده برنمی‌گرداند.</strong> فقط نتیجه‌ی بازبینی دیسیپلین شما را «نیازمند اصلاح» ثبت می‌کند. بعد از پاسخ همه‌ی دیسیپلین‌های ارجاع‌شده، مدرک برای تصمیم رسمی (تایید / رد / بازگشت برای اصلاح) به سازنده/تأییدکننده می‌رسد - با دیدن نظر شما در کنار سایر نظرات.</p>
                    <pems-textarea scale="small" name="comment" rows="3" required></pems-textarea>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="danger" size="small" type="submit">@Localizer["رد کن"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@* طبق Phase E-04: برخلاف Reject (رد قطعی)، این یعنی "برگردان برای اصلاح - دوباره Submit
   می‌شود" - سند به وضعیت "Revise & Resubmit" می‌رود که خودش Submit دوباره را مجاز می‌کند. *@
<pems-modal id="reviseModal" tabindex="-1">
            <pems-form asp-action="ReviseAndResubmit" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <pems-modal-header>@Localizer["برگرداندن برای اصلاح"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">برخلاف رد قطعی، این یعنی سازنده باید اصلاح کند و دوباره Submit کند - نه رد نهایی.</p>
                    <pems-textarea scale="small" name="comment" rows="3" placeholder="@Localizer["توضیح اصلاحات لازم"]" required></pems-textarea>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="warning" size="small" type="submit">@Localizer["برگردان برای اصلاح"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@* طبق بخش ۲۱/۳۸ ممیزی UX: قبلاً Freeze/Hold یک فرم همیشه‌مرئی روی صفحه بودند - حالا برای
   انطباق با بقیه‌ی اکشن‌ها به Modal تبدیل شدند (از منوی More باز می‌شوند). Route/Field/بررسی
   مجوز (ViewBag.CanFreeze/CanHold) کاملاً دست‌نخورده ماندند - فقط محل نمایش تغییر کرده. *@
@if (!Model.IsFrozen && (bool)(ViewBag.CanFreeze ?? false))
{
    <pems-modal id="freezeModal" tabindex="-1">
                <pems-form asp-action="Freeze" asp-route-id="@Model.DocumentId" method="post">
                    <pems-modal-header><pems-icon name="bi-snow" /> Freeze Document</pems-modal-header>
                    <pems-modal-body>
                        <p class="text-muted small">این مدرک منجمد (Frozen) شود؟ پس از آن دیگر قابل ویرایش یا رویژن جدید نخواهد بود.</p>
                        <pems-label css="small">Freeze reason (required)</pems-label>
                        <pems-input scale="small" type="text" name="reason" required />
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="dark" size="small" outline="true" type="submit"><pems-icon name="bi-snow" /> @Localizer["Freeze"]</pems-button>
                    </pems-modal-footer>
                </pems-form>
            </pems-modal>
}
@if (!Model.IsOnHold && !Model.IsFrozen && Model.Status != "Issued" && (bool)(ViewBag.CanHold ?? false))
{
    <pems-modal id="holdModal" tabindex="-1">
                <pems-form asp-action="Hold" asp-route-id="@Model.DocumentId" method="post">
                    <pems-modal-header><pems-icon name="bi-pause-circle" /> Hold Document</pems-modal-header>
                    <pems-modal-body>
                        <p class="text-muted small">این مدرک در وضعیت Hold قرار بگیرد؟ تا رفع Hold، قابل تأیید (Approve) یا صدور (Issue) نخواهد بود.</p>
                        <pems-label css="small">Hold reason (required)</pems-label>
                        <pems-input scale="small" type="text" name="reason" required />
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="dark" size="small" outline="true" type="submit"><pems-icon name="bi-pause-circle" /> @Localizer["Hold"]</pems-button>
                    </pems-modal-footer>
                </pems-form>
            </pems-modal>
}


@* ==============================================================================
   پاپ‌آپ Issue: انتخاب واحد تحویل. اگر بیرونی (DCC کارفرما/پیمانکار) باشد، نامه‌ی رسمی
   خروجی اجباری می‌شود؛ برای دو حالت داخلی (DCC خودمان یا واحد دیگر)، ثبت نامه اختیاری است.
   ============================================================================== *@
<pems-modal size="large" id="issueModal" tabindex="-1">
            <pems-form asp-action="Issue" method="post" id="issueForm">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <pems-modal-header><pems-icon name="bi-send-check" /> @Localizer["صدور مدرک - انتخاب واحد تحویل"]</pems-modal-header>
                <pems-modal-body>
                    @* طبق Phase E-04: هدف واقعی همین صدور (IFC/IFA/IFI/...) - در لحظه‌ی صدور
                       ثبت می‌شود، نه مقدار قدیمی فرم Create/Edit *@
                    <div class="mb-3">
                        <pems-label css="small">Issue Purpose (IFC / IFA / IFI / ...)</pems-label>
                        <pems-input scale="small" type="text" name="issuePurpose" value="@Model.IssuePurpose" placeholder="e.g. Issued For Construction" />
                    </div>

                    <div class="mb-3">
                        <pems-label css="small fw-bold">این مدرک به کدوم واحد تحویل داده می‌شه؟</pems-label>

                        <pems-check-row>
                            <pems-input kind="check" type="radio" name="deliveryUnitType" id="dcc_internal" value="InternalDCC" checked data-pems-click="call" data-pems-fn="pemsToggleIssueFields" data-pems-arg="none" />
                            <label class="form-check-label small" for="dcc_internal">DCC داخلی (واحد کنترل مدارک خودمون)</label>
                        </pems-check-row>
                        <pems-check-row>
                            <pems-input kind="check" type="radio" name="deliveryUnitType" id="dept_internal" value="InternalDepartment" data-pems-click="call" data-pems-fn="pemsToggleIssueFields" data-pems-arg="none" />
                            <label class="form-check-label small" for="dept_internal">یک واحد دیگه داخل شرکت</label>
                        </pems-check-row>
                        <pems-check-row>
                            <pems-input kind="check" type="radio" name="deliveryUnitType" id="ext_unit" value="External" data-pems-click="call" data-pems-fn="pemsToggleIssueFields" data-pems-arg="none" />
                            <label class="form-check-label small" for="ext_unit">نهاد بیرونی (DCC کارفرما / پیمانکار)</label>
                        </pems-check-row>
                    </div>

                    <div class="mb-2" id="issueDeptField" hidden>
                        <pems-label css="small">@Localizer["واحد داخلی"]</pems-label>
                        <pems-select scale="small" name="deliveryDepartmentId">
                            @{
                                var allDepartmentsForIssue = (IEnumerable<PEMS.Domain.Entities.Department>)(ViewBag.AllDepartments ?? new List<PEMS.Domain.Entities.Department>());
                            }
                            @foreach (var dept in allDepartmentsForIssue)
                            {
                                <option value="@dept.DepartmentId">@dept.Name</option>
                            }
                        </pems-select>
                    </div>

                    <div id="issueExternalFields" hidden>
                        <pems-alert tone="warning" css="py-2 px-3 small">
                            برای تحویل بیرونی، ثبت نامه‌ی رسمی خروجی الزامی است.
                        </pems-alert>
                        <div class="mb-2">
                            <pems-label css="small">نام گیرنده (مثلاً DCC کارفرما)</pems-label>
                            <pems-input scale="small" type="text" name="externalReceiverName" />
                        </div>
                    </div>

                    <div class="mb-2" id="issueLetterNumberField" hidden>
                        <pems-label css="small">شماره‌ی نامه (اختیاری - خالی بمونه خودکار ساخته می‌شه)</pems-label>
                        <pems-input scale="small" type="text" name="letterNumber" />
                    </div>
                    <div class="mb-2" id="issueSubjectField" hidden>
                        <pems-label css="small">@Localizer["موضوع نامه"]</pems-label>
                        <pems-input scale="small" type="text" name="letterSubject" value="صدور مدرک @Model.DocumentNo" />
                    </div>
                    <div class="mb-2" id="issueBodyField" hidden>
                        <pems-label css="small">@Localizer["متن نامه (اختیاری)"]</pems-label>
                        <pems-textarea scale="small" name="letterBody" rows="2"></pems-textarea>
                    </div>

                    <div class="mb-2">
                        <pems-label css="small">توضیح / کامنت صدور (اختیاری)</pems-label>
                        <pems-textarea scale="small" name="comment" rows="2"></pems-textarea>
                    </div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-send-check" /> تایید و صدور</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

<script src="~/js/views/engineeringdocuments-details-1.js" asp-append-version="true"></script>


<pems-modal id="newRevisionModal" tabindex="-1">
            <pems-form asp-action="CreateRevision" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <pems-modal-header>Create New Revision</pems-modal-header>
                <pems-modal-body>
                    <div class="mb-2">
                        <pems-label css="small">@Localizer["Reason"]</pems-label>
                        <pems-select scale="small" name="reason">
                            <option>Design Change</option>
                            <option>Client Comment</option>
                            <option>Vendor Update</option>
                            <option>Internal Review</option>
                            <option>Regulatory Requirement</option>
                            <option>@Localizer["Other"]</option>
                        </pems-select>
                    </div>
                    <div class="mb-2">
                        <pems-label css="small">Change Description</pems-label>
                        <pems-textarea scale="small" name="changeDescription" rows="3" placeholder="What changed in this revision?"></pems-textarea>
                    </div>
                    <div class="mb-2">
                        <pems-label css="small"><pems-icon name="bi-building" /> Vendor Comment</pems-label>
                        <pems-textarea scale="small" name="vendorComment" rows="3" placeholder="Paste or summarize the vendor's comment that led to this revision (if applicable)"></pems-textarea>
                    </div>
                    @{
                        var openClouded = ((List<PEMS.Application.DTOs.VDRCommentDto>)ViewBag.Comments)
                            .Where(x => x.MarksRevisionRequired && !x.TriggeredRevisionId.HasValue).ToList();
                    }
                    @if (openClouded.Any())
                    {
                        <div class="mb-2">
                            <pems-label css="small"><pems-icon name="bi-cloud-fill" /> Closes Marked-for-Revision comment <span class="text-muted">@Localizer["(optional)"]</span></pems-label>
                            <pems-select scale="small" name="triggeringCommentId">
                                <option value="">@Localizer["-- None --"]</option>
                                @foreach (var oc in openClouded)
                                {
                                    <option value="@oc.VDRCommentId">@oc.CommentNo - @oc.CommentText</option>
                                }
                            </pems-select>
                        </div>
                    }
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="primary" size="small" type="submit">Create Revision</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@{
    var availableIncomingLetters = (IEnumerable<PEMS.Domain.Entities.Letter>)(ViewBag.AvailableIncomingLetters ?? new List<PEMS.Domain.Entities.Letter>());
                    }

<pems-modal id="clientResponseModal" tabindex="-1">
            <pems-form asp-action="RecordClientResponse" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <pems-modal-header>Record Client Response</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">
                        This is the client's (owner's) response to the issued document, separate from the
                        internal EPC review that already happened.
                    </p>


                    <div class="mb-2">
                        <pems-label css="small"><pems-icon name="bi-envelope-open" /> نامه‌ی وارده (الزامی)</pems-label>
                        @if (availableIncomingLetters.Any())
                        {
                            <pems-select scale="small" name="incomingLetterId" required>
                                <option value="">@Localizer["-- انتخاب کنید --"]</option>
                                @foreach (var l in availableIncomingLetters)
                                {
                                    <option value="@l.LetterId">@l.LetterNumber &mdash; @l.Subject (@l.LetterDate.ToString("yyyy-MM-dd"))</option>
                                }
                            </pems-select>
                        }
                        else
                        {
                            <pems-alert tone="warning" css="py-2 px-3 small mb-0">
                                هیچ نامه‌ی وارده‌ای ثبت نشده. اول باید نامه‌ی رسیده از کارفرما رو توی
                                ماژول «نامه‌نگاری» به‌عنوان Incoming ثبت کنی، بعد این‌جا انتخابش کن.
                            </pems-alert>
                        }
                    </div>

                    <div class="mb-2">
                        <pems-label css="small">Client Decision</pems-label>
                        <pems-select scale="small" name="clientStatus">
                            <option value="A">A - Approved</option>
                            <option value="B">B - Approved with Comments</option>
                            <option value="C">C - Revise &amp; Resubmit</option>
                            <option value="D">D - Rejected</option>
                        </pems-select>
                    </div>
                    <div class="mb-2">
                        <pems-label css="small">Client Comment (اختیاری - علاوه بر متن نامه)</pems-label>
                        <pems-textarea scale="small" name="clientComment" rows="3"></pems-textarea>
                    </div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="primary" size="small" type="submit" disabled="@(!(availableIncomingLetters.Any()))">Save</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@* طبق درخواست: چرخه‌ی کامنت/ریپلای دقیقاً مثل بخش VDR - همان سرویس مشترک، همان تجربه *@
<pems-modal size="large" id="addEngCommentModal" tabindex="-1">
            <pems-form asp-action="AddComment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="pageNumber" id="engPinPageNumber" value="" />
                <input type="hidden" name="pinX" id="engPinX" value="" />
                <input type="hidden" name="pinY" id="engPinY" value="" />
                <pems-modal-header>@Localizer["Add Comment"]</pems-modal-header>
                <pems-modal-body>
                    <div id="engPinLocationLabel" class="small text-primary mb-2"></div>
                    <pems-row gap="3">
                        <pems-col md="4"><pems-label css="small">@Localizer["Raised By"]</pems-label><pems-input scale="small" name="raisedByName" /></pems-col>
                        <pems-col md="4">
                            <pems-label css="small">@Localizer["Category"]</pems-label>
                            <pems-select scale="small" name="category">
                                <option value="">@Localizer["-- select --"]</option>
                                @foreach (var cat in new[] { "Technical", "Safety", "Constructability", "Documentation", "Specification", "Calculation", "Typographical", "Clarification" })
                                { <option value="@cat">@cat</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="4">
                            <pems-label css="small">@Localizer["Severity"]</pems-label>
                            <pems-select scale="small" name="severity">
                                <option value="">@Localizer["-- select --"]</option>
                                @foreach (var sev in new[] { "Low", "Medium", "High", "Critical" })
                                { <option value="@sev">@sev</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="4"><pems-label css="small">@Localizer["Sheet"]</pems-label><pems-input scale="small" name="sheet" /></pems-col>
                        <pems-col md="4"><pems-label css="small">@Localizer["Zone"]</pems-label><pems-input scale="small" name="zone" /></pems-col>
                        <pems-col md="4"><pems-label css="small">@Localizer["Reference"]</pems-label><pems-input scale="small" name="reference" /></pems-col>
                        <pems-col span="12"><pems-label css="small">@Localizer["Comment"]</pems-label><pems-textarea scale="small" name="commentText" rows="3" required></pems-textarea></pems-col>
                        <pems-col md="6"><pems-label css="small">Required Action</pems-label><pems-input scale="small" name="requiredAction" /></pems-col>
                        <pems-col md="6"><pems-label css="small">@Localizer["Due Date"]</pems-label><pems-date name="dueDate" scale="small" /></pems-col>
                        <pems-col span="12"><pems-label css="small">Attachment <span class="text-muted">@Localizer["(optional)"]</span></pems-label><pems-input scale="small" type="file" name="attachment" /></pems-col>
                        <pems-col span="12" css="form-check">
                            <pems-input kind="check" type="checkbox" name="marksRevisionRequired" value="true" id="marksRevisionRequired" />
                            <label class="form-check-label" for="marksRevisionRequired">
                                Marks this document as needing a new revision (Clouded / Marked-for-Revision)
                            </label>
                        </pems-col>
                    </pems-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">Save Comment</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@if (engComments.Any())
{
    <pems-modal id="engReplyModal" tabindex="-1">
                <pems-form asp-action="RecordCommentResponse" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="commentId" value="" />
                    <pems-modal-header>Reply to <span data-fill-text="commentno"></span></pems-modal-header>
                    <pems-modal-body>
                        <p class="small text-muted" data-fill-text="commenttext"></p>
                        <div class="mb-2">
                            <pems-label css="small">Reply <span class="text-muted">(optional if attaching a file)</span></pems-label>
                            <pems-textarea scale="small" name="responseText" rows="3"></pems-textarea>
                        </div>
                        <div class="mb-2">
                            <pems-label css="small">Or attach the Reply Sheet file</pems-label>
                            <pems-input scale="small" type="file" name="replyAttachment" />
                        </div>
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" size="small" type="submit">Save Reply</pems-button>
                    </pems-modal-footer>
                </pems-form>
            </pems-modal>
}

</pems-page-shell> @* end .vs-page *@

@section Scripts {
    <script src="~/js/views/engineeringdocuments-details-2.js" asp-append-version="true"></script>
}
