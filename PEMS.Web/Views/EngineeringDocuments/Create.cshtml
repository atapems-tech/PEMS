@model PEMS.Domain.Entities.EngineeringDocument
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Ed_NewDocument"].Value;
    ViewData["Section"] = Localizer["EngineeringManagement"].Value;
}

@* Same fields, names, values and behaviour as before (numbering rules, manual-number permission, dropdowns) - only grouping, labels and hierarchy changed. *@
<form asp-action="Create" method="post"><pems-content-card css="pems-s-0d3d737f">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <h2 class="vs-section__title"><pems-icon name="bi-card-heading" /> @Localizer["Ed_FormIdentification"]</h2>
    <pems-row gap="3" css="mb-4">
        <pems-col md="6">
            <pems-label for="DocumentNo">@Localizer["Ed_DocNo"]</pems-label>
            <div class="input-group">
                <span class="input-group-text" id="autoNumberBadge"><pems-icon name="bi-magic" aria-hidden="true" /></span>
                <pems-input css="vs-num" asp-for="DocumentNo" placeholder="@Localizer["Ed_AutoNumberHint"]" disabled />
            </div>
            @if ((bool)(ViewBag.CanManualNumber ?? false))
            {
                <div class="form-check mt-2">
                    <pems-input kind="check" type="checkbox" name="useManualNumber" value="true" id="useManualNumberCheck" />
                    <label class="form-check-label small" for="useManualNumberCheck">@Localizer["Ed_ManualNumber"]</label>
                </div>
                <div class="form-text">@Localizer["Ed_ManualNumberHelp"]</div>
            }
            else
            {
                <div class="form-text">@Localizer["Ed_AutoNumberHelp"]</div>
            }
        </pems-col>
        <pems-col md="6">
            <pems-label for="RevisionNo">@Localizer["Ed_Revision"]</pems-label>
            <pems-input css="vs-num" asp-for="RevisionNo" />
        </pems-col>
        <pems-col span="12">
            <pems-label for="Title">@Localizer["Ed_Title"]</pems-label>
            <pems-input asp-for="Title" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </pems-col>
        <pems-col span="12">
            <pems-label for="Description">@Localizer["Ed_Description"]</pems-label>
            <pems-textarea asp-for="Description" rows="2"></pems-textarea>
        </pems-col>
    </pems-row>

    <h2 class="vs-section__title"><pems-icon name="bi-diagram-3" /> @Localizer["Ed_FormClassification"]</h2>
    <pems-row gap="3" css="mb-4">
        <pems-col md="4">
            <pems-label for="DocumentType">@Localizer["Ed_Type"]</pems-label>
            <pems-select asp-for="DocumentType">
                <option value="">@Localizer["Ed_SelectType"]</option>
                <option value="Drawing">Drawing</option>
                <option value="Datasheet">@Localizer["Datasheet"]</option>
                <option value="Calculation">Calculation</option>
                <option value="Specification">@Localizer["Specification"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label for="ProjectId">@Localizer["Ed_Project"]</pems-label>
            <pems-select asp-for="ProjectId" asp-items="ViewBag.Projects">
                <option value="">@Localizer["Ed_SelectProject"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label for="DisciplineId">@Localizer["Ed_Discipline"]</pems-label>
            <pems-select asp-for="DisciplineId" asp-items="ViewBag.Disciplines">
                <option value="">@Localizer["Ed_SelectDiscipline"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="4">
            <pems-label for="Area">@Localizer["Ed_Area"] <span class="text-muted fw-normal">(@Localizer["Ed_Optional"])</span></pems-label>
            <pems-input asp-for="Area" placeholder="ABS &amp; Common, Rubber" />
        </pems-col>
        <pems-col md="4">
            <pems-label for="Status">@Localizer["Ed_Status"]</pems-label>
            <pems-select asp-for="Status">
                <option value="Draft">@Localizer["St_Draft"]</option>
                <option value="Review">@Localizer["Review"]</option>
                <option value="Approved">@Localizer["St_Approved"]</option>
                <option value="Rejected">@Localizer["St_Rejected"]</option>
            </pems-select>
        </pems-col>
    </pems-row>

    <h2 class="vs-section__title"><pems-icon name="bi-link-45deg" /> @Localizer["Ed_FormTraceability"]</h2>
    <pems-row gap="3" css="mb-4">
        <pems-col md="6">
            <pems-label for="EquipmentId">@Localizer["Ed_RelatedEquipment"] <span class="text-muted fw-normal">(@Localizer["Ed_Optional"])</span></pems-label>
            <pems-select asp-for="EquipmentId" asp-items="ViewBag.Equipments">
                <option value="">@Localizer["Ed_None"]</option>
            </pems-select>
        </pems-col>
        <pems-col md="6">
            <pems-label for="ContractId">@Localizer["Ed_RelatedContract"] <span class="text-muted fw-normal">(@Localizer["Ed_Optional"])</span></pems-label>
            <pems-select asp-for="ContractId" asp-items="ViewBag.Contracts">
                <option value="">@Localizer["Ed_None"]</option>
            </pems-select>
        </pems-col>
    </pems-row>

    <div class="d-flex gap-2 justify-content-end border-top pt-3">
        <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
    </div>
</pems-content-card></form>

@section Scripts {
    <script src="~/js/views/engineeringdocuments-create.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
