@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var engineers = (IEnumerable<dynamic>)ViewBag.Engineers;
}

<pems-content-card css="pems-s-3f7efa5f">
    <form asp-action="Create" method="post" id="mrForm">
        <pems-row gap="3">
            <pems-col md="6">
                @await Component.InvokeAsync("DocumentNumberField", new { documentType = "MaterialRequisition", name = "mrNumber", label = Localizer["MR Number"].Value })
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select name="disciplineId" required>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>Equipment Tag (optional)</pems-label>
                <pems-input name="equipmentTagNumber" placeholder="e.g. P-101A" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Required Date"]</pems-label>
                <pems-date name="requiredDate" />
            </pems-col>
            <pems-col md="6">
                <pems-label>Responsible Engineer</pems-label>
                <pems-select name="responsibleEngineerId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var e in engineers) { <option value="@e.EmployeeId">@e.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col span="12">
                <pems-label>@Localizer["Description"]</pems-label>
                <pems-textarea name="description" rows="2" required></pems-textarea>
            </pems-col>
        </pems-row>

        <hr class="my-3" />

        <pems-flex align="center" justify="between">
            <pems-label css="mb-0">@Localizer["Items"]</pems-label>
            @* SCRUM-428: a part that is not in the catalogue yet can be requested from the part catalogue *@
            <a class="small" asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Index" target="_blank" rel="noopener">
                <pems-icon name="bi-journal-plus" /> @Localizer["Mr_RequestNewPart"]
            </a>
        </pems-flex>
        <div class="form-text mb-2">@Localizer["Mr_PartLookupHint"]</div>
        <div id="itemsContainer" data-mr-items></div>
        @* SCRUM-428: one item row; the part number is a lookup over the registered parts (part catalogue and Material Master) that
           fills the description and unit; a typed part number is kept and marked "not catalogued" (the server decides the link). *@
        <template id="mrItemTemplate">
            <pems-row gap="2" css="mb-2 item-row">
                <pems-col md="3">
                    <pems-select scale="small" name="itemParts" aria-label="@Localizer["Part No"]" data-pems-select-url="@Url.Action("PartLookup")" data-pems-select-create data-create-text="@Localizer["Mr_UseTypedPart"]" data-placeholder="@Localizer["Part No"]">
                        <option value=""></option>
                    </pems-select>
                </pems-col>
                <pems-col md="4"><pems-input scale="small" name="itemDescriptions" placeholder="@Localizer["Description"]" aria-label="@Localizer["Description"]" /></pems-col>
                <pems-col md="2"><pems-input scale="small" name="itemQty" type="number" step="0.01" value="1" aria-label="@Localizer["Qty"]" /></pems-col>
                <pems-col md="2"><pems-input scale="small" name="itemUnits" placeholder="@Localizer["Unit"]" aria-label="@Localizer["Unit"]" /></pems-col>
                <pems-col md="1" css="d-flex align-items-center">
                    <span class="vs-pill vs-pill--warning" data-mr-not-catalogued hidden title="@Localizer["Mr_PartNotCataloguedHint"]">@Localizer["Mr_PartNotCatalogued"]</span>
                </pems-col>
            </pems-row>
        </template>
        <pems-button tone="neutral" size="small" outline="true" type="button" id="addItemBtn"><pems-icon name="bi-plus" /> @Localizer["Mr_AddItem"]</pems-button>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">Save MR</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</pems-content-card>

@section Scripts {
    <script src="~/js/mr-items.js" asp-append-version="true"></script>
}
