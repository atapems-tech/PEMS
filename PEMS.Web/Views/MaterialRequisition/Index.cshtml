@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MRDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusText(string? s) => VdrUi.Loc(Localizer, "MrL_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Evaluated" or "Approved" or "Closed" => "vs-pill--success",
        "Sent" or "Submitted" => "vs-pill--info",
        "Cancelled" or "Rejected" => "vs-pill--danger",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component; the page keeps its columns, paging and the New action. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["MrL_Title"]" heading-title="@Localizer["MrL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="MaterialRequisition" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["MrL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="MaterialRequisition" empty="@(!Model.Items.Any())" empty-text="@Localizer["MrL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="mrNumber" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["MrL_No"]</th>
                        <th data-col-key="project" data-resizable="true" data-min-width="120" data-max-width="240" class="vs-hide-md">@Localizer["Ed_Project"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="200" class="vs-hide-md">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="equipmentTag" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["MrL_Tag"]</th>
                        <th data-col-key="requiredDate" data-resizable="true" data-min-width="100" data-max-width="160" style="width:120px">@Localizer["MrL_Required"]</th>
                        <th data-col-key="responsible" data-resizable="true" data-min-width="120" data-max-width="240" class="vs-hide-md">@Localizer["MrL_Responsible"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="mrqs" data-resizable="true" data-min-width="60" data-max-width="100" style="width:80px" class="text-end">@Localizer["MrL_Mrqs"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@m.MRId" class="lp-subject" title="@m.MRNumber">@m.MRNumber</a></td>
                            <td class="small vs-hide-md">@m.ProjectName</td>
                            <td class="small vs-hide-md">@m.DisciplineName</td>
                            <td class="small"><span class="vs-num">@m.EquipmentTagNumber</span></td>
                            <td class="small"><span class="vs-num">@(m.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            <td class="small vs-hide-md">@m.ResponsibleEngineerName</td>
                            <td><span class="vs-pill @StatusTone(m.Status)">@StatusText(m.Status)</span></td>
                            <td class="text-end"><span class="vs-num">@m.QuotationsCount</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@m.MRId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "MaterialRequisition",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
