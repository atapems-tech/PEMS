@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MRDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="PemsDataGrid.resetColumns('MaterialRequisition')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </pems-button>
        <pems-button tone="primary" size="small" as="a" asp-action="Create"><i class="bi bi-plus-lg"></i> New MR</pems-button>
    </div>

    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="MaterialRequisition">
        <thead>
            <tr>
                <th data-col-key="mrNumber" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["MR Number"]</th>
                <th data-col-key="project" data-resizable="true" data-min-width="120" data-max-width="240">@Localizer["Project"]</th>
                <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Discipline"]</th>
                <th data-col-key="equipmentTag" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Equipment Tag"]</th>
                <th data-col-key="requiredDate" data-resizable="true" data-min-width="100" data-max-width="160">@Localizer["Required Date"]</th>
                <th data-col-key="responsible" data-resizable="true" data-min-width="120" data-max-width="240">@Localizer["Responsible"]</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Status"]</th>
                <th data-col-key="mrqs" data-resizable="true" data-min-width="60" data-max-width="100">@Localizer["MRQs"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td class="small fw-bold">@m.MRNumber</td>
                    <td class="small">@m.ProjectName</td>
                    <td class="small">@m.DisciplineName</td>
                    <td class="small">@m.EquipmentTagNumber</td>
                    <td class="small">@(m.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td class="small">@m.ResponsibleEngineerName</td>
                    <td><pems-badge tone="neutral">@m.Status</pems-badge></td>
                    <td><pems-badge tone="info">@m.QuotationsCount</pems-badge></td>
                    <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@m.MRId"><i class="bi bi-eye"></i></pems-button></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">No material requisitions created yet.</p>
    }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MaterialRequisition",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('MaterialRequisition');
        });
    </script>
}
