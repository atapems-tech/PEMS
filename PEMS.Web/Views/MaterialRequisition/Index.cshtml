@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MRDto>

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('MaterialRequisition')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
        <a asp-action="Create" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New MR</a>
    </div>

    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="MaterialRequisition">
        <thead>
            <tr>
                <th data-col-key="mrNumber" data-resizable="true" data-min-width="100" data-max-width="200">MR Number</th>
                <th data-col-key="project" data-resizable="true" data-min-width="120" data-max-width="240">Project</th>
                <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="200">Discipline</th>
                <th data-col-key="equipmentTag" data-resizable="true" data-min-width="100" data-max-width="200">Equipment Tag</th>
                <th data-col-key="requiredDate" data-resizable="true" data-min-width="100" data-max-width="160">Required Date</th>
                <th data-col-key="responsible" data-resizable="true" data-min-width="120" data-max-width="240">Responsible</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">Status</th>
                <th data-col-key="mrqs" data-resizable="true" data-min-width="60" data-max-width="100">MRQs</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td class="small fw-bold">@m.MRNumber</td>
                    <td class="small">@m.ProjectName</td>
                    <td class="small">@m.DisciplineName</td>
                    <td class="small">@m.EquipmentTagNumber</td>
                    <td class="small">@(m.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td class="small">@m.ResponsibleEngineerName</td>
                    <td><span class="badge bg-secondary">@m.Status</span></td>
                    <td><span class="badge bg-info text-dark">@m.QuotationsCount</span></td>
                    <td><a asp-action="Details" asp-route-id="@m.MRId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">No material requisitions created yet.</p>
    }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MaterialRequisition",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('MaterialRequisition');
        });
    </script>
}
