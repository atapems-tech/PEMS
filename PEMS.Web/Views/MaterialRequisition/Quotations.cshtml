@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MRQDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card>
    <pems-flex justify="end" css="mb-2">
        <pems-button tone="neutral" size="small" outline="true" type="button" data-pems-click="call" data-pems-fn="PemsDataGrid.resetColumns" data-pems-arg="none" data-pems-args='["MaterialRequisitionQuotations"]'>
            <pems-icon name="bi-arrow-counterclockwise" /> @Localizer["Reset columns"]
        </pems-button>
    </pems-flex>
    <div class="pems-grid-scroll">
    <pems-table kind="enterprise" css="pems-grid-table mb-0" data-grid-key="MaterialRequisitionQuotations">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header data-col-key="mrqNo" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["MRQ No"]</pems-table-header>
                <pems-table-header data-col-key="mrNo" data-resizable="true" data-min-width="100" data-max-width="200">MR No</pems-table-header>
                <pems-table-header data-col-key="vendor" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["Vendor"]</pems-table-header>
                <pems-table-header data-col-key="amount" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Amount"]</pems-table-header>
                <pems-table-header data-col-key="quotationStatus" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Quotation Status"]</pems-table-header>
                <pems-table-header data-col-key="technical" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Technical"]</pems-table-header>
                <pems-table-header data-col-key="commercial" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Commercial"]</pems-table-header>
                <pems-table-header data-col-key="approval" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Approval"]</pems-table-header>
                <pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var q in Model.Items)
            {
                <pems-table-row>
                    <pems-table-cell class="small fw-bold">@q.MRQNumber</pems-table-cell>
                    <pems-table-cell class="small">@q.MRNumber</pems-table-cell>
                    <pems-table-cell class="small">@q.VendorName</pems-table-cell>
                    <pems-table-cell class="small">@(q.QuotedAmount.HasValue ? $"{q.QuotedAmount:N2} {q.Currency}" : "-")</pems-table-cell>
                    <pems-table-cell><pems-badge tone="neutral">@q.QuotationStatus</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(q.TechnicalEvaluation == "Passed" ? "success" : q.TechnicalEvaluation == "Failed" ? "danger" : "neutral")">@q.TechnicalEvaluation</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(q.CommercialEvaluation == "Passed" ? "success" : q.CommercialEvaluation == "Failed" ? "danger" : "neutral")">@q.CommercialEvaluation</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(q.ApprovalStatus == "Approved" ? "success" : q.ApprovalStatus == "Rejected" ? "danger" : "neutral")">@q.ApprovalStatus</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@q.MRId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">No quotations (MRQ) have been added to any MR yet.</p>
    }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MaterialRequisitionQuotations",
        BaseUrl = Url.Action("Quotations") ?? "",
        ExistingQueryString = ""
    })
</pems-content-card>

@section Scripts {
    <script src="~/js/views/materialrequisition-quotations.js" asp-append-version="true"></script>
}
