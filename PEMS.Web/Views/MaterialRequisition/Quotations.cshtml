@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MRQDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <pems-button tone="neutral" size="small" outline="true" type="button" onclick="PemsDataGrid.resetColumns('MaterialRequisitionQuotations')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </pems-button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="MaterialRequisitionQuotations">
        <thead>
            <tr>
                <th data-col-key="mrqNo" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["MRQ No"]</th>
                <th data-col-key="mrNo" data-resizable="true" data-min-width="100" data-max-width="200">MR No</th>
                <th data-col-key="vendor" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["Vendor"]</th>
                <th data-col-key="amount" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Amount"]</th>
                <th data-col-key="quotationStatus" data-resizable="true" data-min-width="100" data-max-width="180">@Localizer["Quotation Status"]</th>
                <th data-col-key="technical" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Technical"]</th>
                <th data-col-key="commercial" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Commercial"]</th>
                <th data-col-key="approval" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Approval"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Items)
            {
                <tr>
                    <td class="small fw-bold">@q.MRQNumber</td>
                    <td class="small">@q.MRNumber</td>
                    <td class="small">@q.VendorName</td>
                    <td class="small">@(q.QuotedAmount.HasValue ? $"{q.QuotedAmount:N2} {q.Currency}" : "-")</td>
                    <td><pems-badge tone="neutral">@q.QuotationStatus</pems-badge></td>
                    <td><pems-badge tone="@(q.TechnicalEvaluation == "Passed" ? "success" : q.TechnicalEvaluation == "Failed" ? "danger" : "neutral")">@q.TechnicalEvaluation</pems-badge></td>
                    <td><pems-badge tone="@(q.CommercialEvaluation == "Passed" ? "success" : q.CommercialEvaluation == "Failed" ? "danger" : "neutral")">@q.CommercialEvaluation</pems-badge></td>
                    <td><pems-badge tone="@(q.ApprovalStatus == "Approved" ? "success" : q.ApprovalStatus == "Rejected" ? "danger" : "neutral")">@q.ApprovalStatus</pems-badge></td>
                    <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@q.MRId"><i class="bi bi-eye"></i></pems-button></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">No quotations (MRQ) have been added to any MR yet.</p>
    }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MaterialRequisitionQuotations",
        BaseUrl = Url.Action("Quotations") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('MaterialRequisitionQuotations');
        });
    </script>
}
