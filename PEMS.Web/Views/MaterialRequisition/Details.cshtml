@model PEMS.Application.DTOs.MRDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<pems-content-card css="mb-3">
    <pems-info-grid>
        <pems-info-item label="@Localizer["MR Number"]" num>@Model.MRNumber</pems-info-item>
        <pems-info-item label="@Localizer["Project"]">@Model.ProjectName</pems-info-item>
        <pems-info-item label="@Localizer["Discipline"]">@Model.DisciplineName</pems-info-item>
        <pems-info-item label="@Localizer["Equipment Tag"]" num>@Model.EquipmentTagNumber</pems-info-item>
        <pems-info-item label="@Localizer["Required Date"]" num>@Model.RequiredDate?.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Responsible"]">@Model.ResponsibleEngineerName</pems-info-item>
        <pems-info-item label="@Localizer["Status"]">
            <pems-form asp-action="ChangeStatus" method="post" class="d-inline">
                <input type="hidden" name="mrId" value="@Model.MRId" />
                <pems-select scale="small" css="d-inline w-auto" name="status" onchange="this.form.submit()">
                    @foreach (var s in new[] { "Draft", "Submitted", "Under Technical Review", "Approved", "Issued to Procurement", "Closed", "Cancelled" })
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </pems-select>
            </pems-form>
        </pems-info-item>
        <pems-info-item label="@Localizer["Description"]" wide>@Model.Description</pems-info-item>
    </pems-info-grid>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Items"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Description"]</pems-table-header><pems-table-header>@Localizer["Part No"]</pems-table-header><pems-table-header>@Localizer["Qty"]</pems-table-header><pems-table-header>@Localizer["Unit"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var i in Model.Items)
            {
                <pems-table-row>
                    <pems-table-cell>@i.ItemDescription</pems-table-cell>
                    <pems-table-cell>
                        @i.PartNumber
                        @* SCRUM-428: linked to a registered part, or typed and not catalogued yet *@
                        @if (!string.IsNullOrEmpty(i.PartNumber))
                        {
                            @if (i.IsCatalogued) { <span class="vs-pill vs-pill--success ms-1" title="@Localizer["Mr_PartCataloguedHint"]">@Localizer["Mr_PartCatalogued"]</span> }
                            else { <span class="vs-pill vs-pill--warning ms-1" title="@Localizer["Mr_PartNotCataloguedHint"]">@Localizer["Mr_PartNotCatalogued"]</span> }
                        }
                    </pems-table-cell>
                    <pems-table-cell>@i.Quantity</pems-table-cell>
                    <pems-table-cell>@i.Unit</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">Quotations (MRQ)</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["MRQ No"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>@Localizer["Amount"]</pems-table-header><pems-table-header>@Localizer["Quotation Status"]</pems-table-header>
                <pems-table-header>@Localizer["Technical"]</pems-table-header><pems-table-header>@Localizer["Commercial"]</pems-table-header><pems-table-header>@Localizer["Approval"]</pems-table-header><pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var q in Model.Quotations)
            {
                <pems-table-row>
                    <pems-table-cell>@q.MRQNumber</pems-table-cell>
                    <pems-table-cell>@q.VendorName</pems-table-cell>
                    <pems-table-cell>@(q.QuotedAmount.HasValue ? $"{q.QuotedAmount:N2} {q.Currency}" : "-")</pems-table-cell>
                    <pems-table-cell><pems-badge tone="neutral">@q.QuotationStatus</pems-badge></pems-table-cell>
                    <pems-table-cell colspan="4">
                        <pems-form asp-action="UpdateQuotationEvaluation" method="post"><pems-flex gap="1" align="center" wrap="true">
                            <input type="hidden" name="mrId" value="@Model.MRId" />
                            <input type="hidden" name="mrqId" value="@q.MRQId" />

                            <pems-select class="pems-w-110" scale="small" name="technical" title="Technical Evaluation">
                                @foreach (var v in new[] { "Pending", "Passed", "Failed" })
                                { <option value="@v" selected="@(v == q.TechnicalEvaluation)">@v</option> }
                            </pems-select>

                            <pems-select class="pems-w-110" scale="small" name="commercial" title="Commercial Evaluation">
                                @foreach (var v in new[] { "Pending", "Passed", "Failed" })
                                { <option value="@v" selected="@(v == q.CommercialEvaluation)">@v</option> }
                            </pems-select>

                            <pems-select class="pems-w-110" scale="small" name="approval" title="Approval Status">
                                @foreach (var v in new[] { "Pending", "Approved", "Rejected" })
                                { <option value="@v" selected="@(v == q.ApprovalStatus)">@v</option> }
                            </pems-select>

                            <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                        </pems-flex></pems-form>
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>

    @if (!Model.Quotations.Any())
    {
        <p class="text-muted">No quotations added yet.</p>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">Add New Quotation (MRQ)</h6>
    <pems-form asp-action="AddQuotation" method="post"><pems-row gap="2" css="align-items-end">
        <input type="hidden" name="mrId" value="@Model.MRId" />
        <pems-col md="2"><pems-input scale="small" name="mrqNumber" placeholder="@Localizer["MRQ No"]" required /></pems-col>
        <pems-col md="3"><pems-input scale="small" name="vendorName" placeholder="Vendor Name" required /></pems-col>
        <pems-col md="2"><pems-date name="inquiryDate" scale="small" /></pems-col>
        <pems-col md="2"><pems-input scale="small" name="quotedAmount" type="number" step="0.01" placeholder="@Localizer["Amount"]" /></pems-col>
        <pems-col md="1"><pems-input scale="small" name="currency" value="USD" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100" type="submit">@Localizer["Add"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>


@{
    var relatedLettersMR = (List<PEMS.Application.DTOs.RelatedLetterDto>)ViewBag.RelatedLetters;
}

@if (relatedLettersMR != null && relatedLettersMR.Any())
{
    <pems-content-card css="mt-3">
        <h6 class="mb-3"><pems-icon name="bi-envelope-paper" /> Related Correspondence</h6>
        <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Letter No"]</pems-table-header><pems-table-header>@Localizer["Subject"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var l in relatedLettersMR)
                {
                    <pems-table-row>
                        <pems-table-cell><pems-badge tone="neutral">@l.LetterType</pems-badge></pems-table-cell>
                        <pems-table-cell>@l.LetterNumber</pems-table-cell>
                        <pems-table-cell>@l.Subject</pems-table-cell>
                        <pems-table-cell>@l.LetterDate.ToString("yyyy-MM-dd")</pems-table-cell>
                        <pems-table-cell><pems-badge tone="info">@l.Status</pems-badge></pems-table-cell>
                        <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
        </pems-table-scroll>
    </pems-content-card>
}

@* SCRUM-470: purchase order from this MR (pre-procurement path) *@
@if (ViewBag.CanCreatePo is true)
{
    var poVendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    <pems-form asp-controller="PurchaseOrder" asp-action="CreateFromRequisition" method="post"><pems-content-card css="mt-3">
        <input type="hidden" name="mrId" value="@Model.MRId" />
        <h6 class="mb-2"><pems-icon name="bi-receipt" aria-hidden="true" /> @Localizer["Po_CreateFromMr"]</h6>
        <pems-row gap="2" css="align-items-end small">
            <pems-col md="4"><pems-label for="poVendor">@Localizer["Vendor"]</pems-label>
                <pems-select scale="small" id="poVendor" name="vendorId" required><option value="">—</option>@foreach (var v in poVendors) { <option value="@v.VendorId">@v.Name</option> }</pems-select></pems-col>
            <pems-col md="2"><pems-label for="poCurrency">@Localizer["Po_Currency"]</pems-label><pems-input scale="small" id="poCurrency" name="currency" dir="ltr" value="IRR" maxlength="10" required /></pems-col>
            <pems-col md="3"><pems-label for="poNumber">@Localizer["PO Number"]</pems-label><pems-input scale="small" id="poNumber" name="poNumber" dir="ltr" /></pems-col>
            <pems-col md="auto"><pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-plus" aria-hidden="true" /> @Localizer["Po_Create"]</pems-button></pems-col>
            <pems-col span="12" css="text-muted">@Localizer["Po_CreateHint"]</pems-col>
        </pems-row>
    </pems-content-card></pems-form>
}
