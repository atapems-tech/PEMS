@model PEMS.Application.DTOs.MRDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>MR Number:</strong> @Model.MRNumber</div>
        <div class="col-md-3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-3"><strong>@Localizer["Discipline:"]</strong> @Model.DisciplineName</div>
        <div class="col-md-3"><strong>Equipment Tag:</strong> @Model.EquipmentTagNumber</div>
        <div class="col-md-3"><strong>Required Date:</strong> @(Model.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</div>
        <div class="col-md-3"><strong>Responsible:</strong> @Model.ResponsibleEngineerName</div>
        <div class="col-md-6">
            <strong>@Localizer["Status:"]</strong>
            <form asp-action="ChangeStatus" method="post" class="d-inline">
                <input type="hidden" name="mrId" value="@Model.MRId" />
                <select name="status" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                    @foreach (var s in new[] { "Draft", "Submitted", "Under Technical Review", "Approved", "Issued to Procurement", "Closed", "Cancelled" })
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <p class="mt-3">@Model.Description</p>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">@Localizer["Items"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Description"]</th><th>@Localizer["Part No"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Unit"]</th></tr></thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.ItemDescription</td>
                    <td>
                        @i.PartNumber
                        @* SCRUM-428: linked to a registered part, or typed and not catalogued yet *@
                        @if (!string.IsNullOrEmpty(i.PartNumber))
                        {
                            @if (i.IsCatalogued) { <span class="vs-pill vs-pill--success ms-1" title="@Localizer["Mr_PartCataloguedHint"]">@Localizer["Mr_PartCatalogued"]</span> }
                            else { <span class="vs-pill vs-pill--warning ms-1" title="@Localizer["Mr_PartNotCataloguedHint"]">@Localizer["Mr_PartNotCatalogued"]</span> }
                        }
                    </td>
                    <td>@i.Quantity</td>
                    <td>@i.Unit</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Quotations (MRQ)</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead>
            <tr>
                <th>@Localizer["MRQ No"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Amount"]</th><th>@Localizer["Quotation Status"]</th>
                <th>@Localizer["Technical"]</th><th>@Localizer["Commercial"]</th><th>@Localizer["Approval"]</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Quotations)
            {
                <tr>
                    <td>@q.MRQNumber</td>
                    <td>@q.VendorName</td>
                    <td>@(q.QuotedAmount.HasValue ? $"{q.QuotedAmount:N2} {q.Currency}" : "-")</td>
                    <td><span class="badge bg-secondary">@q.QuotationStatus</span></td>
                    <td colspan="4">
                        <form asp-action="UpdateQuotationEvaluation" method="post" class="d-flex gap-1 align-items-center flex-wrap">
                            <input type="hidden" name="mrId" value="@Model.MRId" />
                            <input type="hidden" name="mrqId" value="@q.MRQId" />

                            <select name="technical" class="form-select form-select-sm" style="width:110px;" title="Technical Evaluation">
                                @foreach (var v in new[] { "Pending", "Passed", "Failed" })
                                { <option value="@v" selected="@(v == q.TechnicalEvaluation)">@v</option> }
                            </select>

                            <select name="commercial" class="form-select form-select-sm" style="width:110px;" title="Commercial Evaluation">
                                @foreach (var v in new[] { "Pending", "Passed", "Failed" })
                                { <option value="@v" selected="@(v == q.CommercialEvaluation)">@v</option> }
                            </select>

                            <select name="approval" class="form-select form-select-sm" style="width:110px;" title="Approval Status">
                                @foreach (var v in new[] { "Pending", "Approved", "Rejected" })
                                { <option value="@v" selected="@(v == q.ApprovalStatus)">@v</option> }
                            </select>

                            <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Save"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @if (!Model.Quotations.Any())
    {
        <p class="text-muted">No quotations added yet.</p>
    }
</div>

<div class="content-card">
    <h6 class="mb-3">Add New Quotation (MRQ)</h6>
    <form asp-action="AddQuotation" method="post" class="row g-2 align-items-end">
        <input type="hidden" name="mrId" value="@Model.MRId" />
        <div class="col-md-2"><input name="mrqNumber" class="form-control form-control-sm" placeholder="@Localizer["MRQ No"]" required /></div>
        <div class="col-md-3"><input name="vendorName" class="form-control form-control-sm" placeholder="Vendor Name" required /></div>
        <div class="col-md-2"><input name="inquiryDate" type="date" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="quotedAmount" type="number" step="0.01" class="form-control form-control-sm" placeholder="@Localizer["Amount"]" /></div>
        <div class="col-md-1"><input name="currency" class="form-control form-control-sm" value="USD" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-pems-solid w-100">@Localizer["Add"]</button></div>
    </form>
</div>


@{
    var relatedLettersMR = (List<PEMS.Application.DTOs.RelatedLetterDto>)ViewBag.RelatedLetters;
}

@if (relatedLettersMR != null && relatedLettersMR.Any())
{
    <div class="content-card mt-3">
        <h6 class="mb-3"><i class="bi bi-envelope-paper"></i> Related Correspondence</h6>
        <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Type"]</th><th>@Localizer["Letter No"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Date"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var l in relatedLettersMR)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@l.LetterType</span></td>
                        <td>@l.LetterNumber</td>
                        <td>@l.Subject</td>
                        <td>@l.LetterDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-info text-dark">@l.Status</span></td>
                        <td><a asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
