@model PEMS.Application.DTOs.SetupStatusDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Quick Setup";
}

<div class="content-card mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <div>
            <h5 class="mb-1"><i class="bi bi-rocket-takeoff"></i> @Localizer["System Setup"]</h5>
            <p class="text-muted small mb-0">
                How ready is PEMS for operational use? This page reads real data - nothing here is estimated.
            </p>
        </div>
        <span class="badge @(Model.IsFullyComplete ? "text-bg-success" : "text-bg-secondary") fs-6">
            @Model.CompletedCount of @Model.TotalCount areas ready
        </span>
    </div>

    <div class="progress" style="height: 22px;" role="progressbar" aria-label="Setup progress"
         aria-valuenow="@Model.PercentComplete" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar @(Model.IsFullyComplete ? "bg-success" : "bg-primary")" style="width: @Model.PercentComplete%">
            @Model.PercentComplete%
        </div>
    </div>

    @if (Model.IsFullyComplete)
    {
        <pems-alert tone="success" css="mt-3 mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-4"></i>
            <div>
                <strong>PEMS Setup Complete.</strong> Your system is ready for operational use.
                You can revisit this page any time - Quick Setup never locks.
            </div>
        </pems-alert>
    }
</div>

<div class="row g-3 mb-4">
    @foreach (var step in Model.Steps)
    {
        var (badgeClass, icon, statusText) = step.Status switch
        {
            PEMS.Application.DTOs.SetupStepStatus.Complete => ("text-bg-success", "bi-check-circle-fill", "Ready"),
            PEMS.Application.DTOs.SetupStepStatus.Blocked => ("text-bg-warning", "bi-exclamation-triangle-fill", "Blocked"),
            _ => ("text-bg-secondary", "bi-circle", "Not started")
        };

        <div class="col-md-6 col-lg-4">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="mb-0">@step.Title</h6>
                    <span class="badge @badgeClass"><i class="bi @icon"></i> @statusText</span>
                </div>
                <p class="text-muted small mb-2">@step.Description</p>

                @if (step.Status == PEMS.Application.DTOs.SetupStepStatus.Blocked)
                {
                    <pems-alert tone="warning" css="small py-2 mb-2">
                        <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle"></i> Cannot complete yet. Missing:</div>
                        <ul class="mb-0 ps-3">
                            @foreach (var missing in step.MissingDependencies)
                            {
                                <li>@missing</li>
                            }
                        </ul>
                    </pems-alert>
                }

                @{
                    // طبق ممیزی: PermissionMatrix و RoutingRules هر دو [Authorize(Roles=SystemAdmin)]
                    // سخت‌کد هستند (نه از طریق ماژول مجوز عمومی) - برای EngineeringManager (که
                    // Setup/View دارد ولی SystemAdmin نیست) این دو دکمه باید مخفی شوند، نه یک
                    // لینک مرده بسازند.
                    var isAdminOnlyTarget = step.Key == "Permissions" || step.Key == "AIConfiguration";
                    var showAction = step.ActionController != null && (!isAdminOnlyTarget || (bool)ViewBag.IsSystemAdmin);
                }
                @if (showAction)
                {
                    <a asp-controller="@step.ActionController" asp-action="@step.ActionAction"
                       class="btn btn-sm @(step.Status == PEMS.Application.DTOs.SetupStepStatus.Complete ? "btn-outline-secondary" : "btn-outline-primary")">
                        @step.ActionLabel
                    </a>
                }
                else if (isAdminOnlyTarget)
                {
                    <span class="text-muted small"><i class="bi bi-lock"></i> Requires SystemAdmin</span>
                }
            </div>
        </div>
    }
</div>

@if ((bool)ViewBag.CanImportEquipment || (bool)ViewBag.CanImportMrs || (bool)ViewBag.CanImportMdr || (bool)ViewBag.CanImportVdr)
{
    <div class="content-card d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h6 class="mb-1"><i class="bi bi-cloud-arrow-up"></i> @Localizer["IC_Title"]</h6>
            <p class="text-muted small mb-0">@Localizer["IC_QuickSetupPointer"]</p>
        </div>
        <a asp-controller="ImportCenter" asp-action="Index" class="btn btn-sm btn-pems-solid">@Localizer["IC_Open"]</a>
    </div>
}
