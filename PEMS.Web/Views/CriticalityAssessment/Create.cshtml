@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "New Criticality Assessment";
    int? preselectedEquipmentId = ViewBag.PreselectedEquipmentId;
    string? preselectedLabel = ViewBag.PreselectedEquipmentLabel;
}

@await Html.PartialAsync("_PageHeader")

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-action="Index" class="small">← Assessment Queue</a>
</div>

@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<div class="content-card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label small">@Localizer["Equipment"]</label>
            @if (preselectedEquipmentId.HasValue)
            {
                <input type="hidden" name="equipmentId" value="@preselectedEquipmentId" />
                <pems-input scale="small" value="@preselectedLabel" disabled />
            }
            else
            {
                <pems-input scale="small" type="number" name="equipmentId" required placeholder="@Localizer["Equipment ID"]" />
                <div class="form-text">از صفحه‌ی جزئیات تجهیز یا Activation Backlog وارد شوید تا از قبل انتخاب شود.</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label small">Rationale (optional)</label>
            <pems-textarea scale="small" name="rationale" rows="2"></pems-textarea>
        </div>
        <pems-button tone="primary" size="small" type="submit">Create Draft</pems-button>
    </form>
</div>
