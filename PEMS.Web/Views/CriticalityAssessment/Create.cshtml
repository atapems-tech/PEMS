@{
    ViewData["Title"] = "New Criticality Assessment";
    int? preselectedEquipmentId = ViewBag.PreselectedEquipmentId;
    string? preselectedLabel = ViewBag.PreselectedEquipmentLabel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-shield-exclamation"></i> New Criticality Assessment</h5>
    <a asp-action="Index" class="small">← Assessment Queue</a>
</div>

@if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

<div class="content-card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label small">Equipment</label>
            @if (preselectedEquipmentId.HasValue)
            {
                <input type="hidden" name="equipmentId" value="@preselectedEquipmentId" />
                <input class="form-control form-control-sm" value="@preselectedLabel" disabled />
            }
            else
            {
                <input type="number" name="equipmentId" class="form-control form-control-sm" required placeholder="Equipment ID" />
                <div class="form-text">از صفحه‌ی جزئیات تجهیز یا Activation Backlog وارد شوید تا از قبل انتخاب شود.</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label small">Rationale (optional)</label>
            <textarea name="rationale" class="form-control form-control-sm" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-pems-solid btn-sm">Create Draft</button>
    </form>
</div>
