@model PEMS.Application.DTOs.CriticalityDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-list-check" /> Assessment Queue</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="EquipmentCriticality" asp-action="Index"><pems-icon name="bi-clock-history" /> Published Criticality</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="CmmsReadiness" asp-action="Index"><pems-icon name="bi-clipboard-check" /> Activation Backlog</pems-button>
    </div>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 7.6»: روش‌شناسی پروژه‌ای @Model.FrameworkVersion (متاثر از رویه‌های رایج
    مهندسی ریسک/قابلیت‌اطمینان - نه ادعای انطباق با یک استاندارد بیرونی مشخص). هدف حداکثرسازی
    پوشش نیست - هدف این است که هر عدد این‌جا واقعاً قابل‌دفاع و ردیابی‌پذیر باشد.
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@Model.TotalActiveEquipment.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Total Active Equipment"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@Model.Assessed.ToString("N0")</pems-metric>
            <div class="text-muted small">Assessed (any status)</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric css="text-success">@Model.Approved.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Approved"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric css="text-warning">@Model.UnderReview.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Under Review"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@Model.Draft.ToString("N0")</pems-metric>
            <div class="text-muted small">@Localizer["Draft"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric css="text-muted">@Model.Unassessed.ToString("N0")</pems-metric>
            <div class="text-muted small">Unassessed</div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card>
    <h6 class="mb-2">Published Criticality Distribution <span class="text-muted small">(current authoritative EquipmentCriticality — not the same as "Assessed")</span></h6>
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-body>
            <pems-table-row><pems-table-cell>A (High)</pems-table-cell><pems-table-cell class="text-end">@Model.PublishedCriticalityA</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>B (Medium)</pems-table-cell><pems-table-cell class="text-end">@Model.PublishedCriticalityB</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>C (Low)</pems-table-cell><pems-table-cell class="text-end">@Model.PublishedCriticalityC</pems-table-cell></pems-table-row>
            @if (Model.PublishedCriticalityOther > 0)
            {
                <pems-table-row><pems-table-cell>Other / Legacy value</pems-table-cell><pems-table-cell class="text-end">@Model.PublishedCriticalityOther</pems-table-cell></pems-table-row>
            }
            <pems-table-row><pems-table-cell>Superseded (historical, excluded above)</pems-table-cell><pems-table-cell class="text-end">@Model.Superseded</pems-table-cell></pems-table-row>
        </pems-table-body>
    </pems-table>
</pems-content-card>
