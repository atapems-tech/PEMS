@model PEMS.Application.DTOs.CriticalityDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list-check"></i> Assessment Queue</a>
        <a asp-controller="EquipmentCriticality" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clock-history"></i> Published Criticality</a>
        <a asp-controller="CmmsReadiness" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard-check"></i> Activation Backlog</a>
    </div>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 7.6»: روش‌شناسی پروژه‌ای @Model.FrameworkVersion (متاثر از رویه‌های رایج
    مهندسی ریسک/قابلیت‌اطمینان - نه ادعای انطباق با یک استاندارد بیرونی مشخص). هدف حداکثرسازی
    پوشش نیست - هدف این است که هر عدد این‌جا واقعاً قابل‌دفاع و ردیابی‌پذیر باشد.
</p>

<div class="row g-3 mb-3">
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@Model.TotalActiveEquipment.ToString("N0")</div>
            <div class="text-muted small">@Localizer["Total Active Equipment"]</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@Model.Assessed.ToString("N0")</div>
            <div class="text-muted small">Assessed (any status)</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold text-success">@Model.Approved.ToString("N0")</div>
            <div class="text-muted small">@Localizer["Approved"]</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold text-warning">@Model.UnderReview.ToString("N0")</div>
            <div class="text-muted small">@Localizer["Under Review"]</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@Model.Draft.ToString("N0")</div>
            <div class="text-muted small">@Localizer["Draft"]</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold text-muted">@Model.Unassessed.ToString("N0")</div>
            <div class="text-muted small">Unassessed</div>
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-2">Published Criticality Distribution <span class="text-muted small">(current authoritative EquipmentCriticality — not the same as "Assessed")</span></h6>
    <table class="table table-enterprise table-sm mb-0">
        <tbody>
            <tr><td>A (High)</td><td class="text-end">@Model.PublishedCriticalityA</td></tr>
            <tr><td>B (Medium)</td><td class="text-end">@Model.PublishedCriticalityB</td></tr>
            <tr><td>C (Low)</td><td class="text-end">@Model.PublishedCriticalityC</td></tr>
            @if (Model.PublishedCriticalityOther > 0)
            {
                <tr><td>Other / Legacy value</td><td class="text-end">@Model.PublishedCriticalityOther</td></tr>
            }
            <tr><td>Superseded (historical, excluded above)</td><td class="text-end">@Model.Superseded</td></tr>
        </tbody>
    </table>
</div>
