@model PEMS.Application.DTOs.CriticalityAssessmentDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var canEdit = (bool)ViewBag.CanEdit;
    var canApprove = (bool)ViewBag.CanApprove;

    string StatusBadge(string status) => status switch
    {
        "APPROVED" => "success",
        "UNDER_REVIEW" => "warning",
        "SUPERSEDED" => "neutral",
        _ => "light"
    };

    string ScoreLabel(int? score) => score switch
    {
        1 => "1 — Negligible", 2 => "2 — Minor", 3 => "3 — Moderate", 4 => "4 — Major", 5 => "5 — Severe", _ => "Not scored"
    };
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="3" wrap="true" css="mb-2">
        <div class="kpi-icon bg-icon-blue pems-s-792bd2d6"><pems-icon name="bi-shield-exclamation" /></div>
        <div>
            <h5 class="mb-0">@Model.EquipmentTagNumber <span class="text-muted small">(@(Model.EquipmentClassName ?? "Unclassified"))</span></h5>
            <span class="text-muted small">Framework @Model.FrameworkVersion</span>
        </div>
        <pems-badge class="fs-6" tone="@StatusBadge(Model.Status)" css="ms-auto">@Model.Status</pems-badge>
    </pems-flex>

    <pems-row gap="2" css="small mt-2">
        <pems-col md="3"><strong>@Localizer["Prepared By"]</strong><div>@(Model.PreparedBy ?? "-")</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Reviewed By"]</strong><div>@(Model.ReviewedBy ?? "-")</div></pems-col>
        <pems-col md="3"><strong>@Localizer["Approved By"]</strong><div>@(Model.ApprovedBy ?? "-")</div></pems-col>
        <pems-col md="3"><strong>Approved At</strong><div>@(Model.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></pems-col>
    </pems-row>

    <pems-row gap="2" css="mt-3">
        @if (Model.Status == "DRAFT" && canEdit)
        {
            <pems-col span="auto">
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#scoresModal">@Localizer["Set Dimension Scores"]</pems-button>
            </pems-col>
        }
        @if (Model.Status != "APPROVED" && Model.Status != "SUPERSEDED" && canEdit)
        {
            <pems-col span="auto">
                <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#evidenceModal">@Localizer["Add Evidence"]</pems-button>
            </pems-col>
        }
        @if (Model.Status == "DRAFT" && canEdit)
        {
            <pems-col span="auto">
                <form asp-action="SubmitForReview" method="post">
                    <input type="hidden" name="id" value="@Model.CriticalityAssessmentId" />
                    <pems-button tone="warning" size="small" outline="true" type="submit">@Localizer["Submit for Review"]</pems-button>
                </form>
            </pems-col>
        }
        @if (Model.Status == "UNDER_REVIEW" && canApprove)
        {
            <pems-col span="auto">
                <form asp-action="Approve" method="post" data-pems-confirm="تایید این ارزیابی، نتیجه را بلافاصله در EquipmentCriticality منتشر می‌کند. ادامه می‌دهید؟">
                    <input type="hidden" name="id" value="@Model.CriticalityAssessmentId" />
                    <pems-button tone="success" size="small" type="submit">Approve &amp; Publish</pems-button>
                </form>
            </pems-col>
            <pems-col span="auto">
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="id" value="@Model.CriticalityAssessmentId" />
                    <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject → Draft"]</pems-button>
                </form>
            </pems-col>
        }
    </pems-row>
</pems-content-card>

<pems-nav css="mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-scores">Dimension Scores</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-evidence">Evidence (@Model.Evidence.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-history">History (@Model.PriorAssessments.Count)</button></li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-scores">
        <pems-content-card>
            <p class="text-muted small">
                طبق «PEMS Phase 7.6»: نتیجه از قاعده‌ی «بدترین بُعد حاکم است» (Max، نه میانگین)
                محاسبه می‌شود - یک تجهیز با پیامد ایمنی شدید صرفاً به این دلیل که پیامد
                تولید/محیط‌زیستی پایین است، کم‌اهمیت جلوه نمی‌کند.
            </p>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <tbody>
                    <tr><td>@Localizer["Safety"]</td><td class="text-end">@ScoreLabel(Model.SafetyScore)</td></tr>
                    <tr><td>@Localizer["Production / Availability"]</td><td class="text-end">@ScoreLabel(Model.ProductionScore)</td></tr>
                    <tr><td>@Localizer["Environment"]</td><td class="text-end">@ScoreLabel(Model.EnvironmentScore)</td></tr>
                    <tr class="table-active"><td><strong>Calculated (Max) Score</strong></td><td class="text-end"><strong>@(Model.CalculatedMaxScore?.ToString() ?? "N/A — incomplete")</strong></td></tr>
                    <tr class="table-active"><td><strong>Proposed Criticality Class</strong></td><td class="text-end"><strong>@(Model.ProposedCriticalityClass ?? "N/A")</strong></td></tr>
                </tbody>
            </pems-table>
            @if (!string.IsNullOrWhiteSpace(Model.Rationale))
            {
                <div class="small text-muted mt-2"><strong>Rationale:</strong> @Model.Rationale</div>
            }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-evidence">
        <pems-content-card>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <thead><tr><th>@Localizer["Source Type"]</th><th>@Localizer["Identifier"]</th><th>@Localizer["Reference"]</th><th>@Localizer["Description"]</th><th>By</th><th>@Localizer["Date"]</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Evidence)
                    {
                        <tr>
                            <td class="small">@e.SourceType</td>
                            <td class="small">@(e.SourceIdentifier ?? "-")</td>
                            <td class="small">@(e.Reference ?? "-")</td>
                            <td class="small">@e.Description</td>
                            <td class="small">@(e.CreatedBy ?? "-")</td>
                            <td class="small">@e.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!Model.Evidence.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هنوز هیچ شاهدی ثبت نشده - قبل از ارسال برای بازبینی، حداقل یکی الزامی است."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-history">
        <pems-content-card>
            <p class="text-muted small">طبق بند ۱۳: نسخه‌های قبلی هرگز حذف نمی‌شوند - فقط SUPERSEDED علامت می‌خورند.</p>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <thead><tr><th>@Localizer["Status"]</th><th>@Localizer["Proposed"]</th><th>@Localizer["Prepared By"]</th><th>@Localizer["Approved By"]</th><th>@Localizer["Created"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in Model.PriorAssessments)
                    {
                        <tr>
                            <td><pems-badge tone="@StatusBadge(p.Status)">@p.Status</pems-badge></td>
                            <td>@(p.ProposedCriticalityClass ?? "-")</td>
                            <td class="small">@(p.PreparedBy ?? "-")</td>
                            <td class="small">@(p.ApprovedBy ?? "-")</td>
                            <td class="small">@p.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@p.CriticalityAssessmentId"><pems-icon name="bi-eye" /></pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!Model.PriorAssessments.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["این اولین ارزیابی این تجهیز است."]</p> }
        </pems-content-card>
    </pems-tab-pane>
</pems-tab-content>

@if (canEdit)
{
    <pems-modal id="scoresModal" tabindex="-1">
            <form asp-action="SetScores" method="post">
                <input type="hidden" name="id" value="@Model.CriticalityAssessmentId" />
                <pems-modal-header>@Localizer["Set Dimension Scores"]</pems-modal-header>
                <pems-modal-body>
                    <p class="text-muted small">مقیاس ۱ (Negligible) تا ۵ (Severe) برای هر بُعد.</p>
                    <div class="mb-2">
                        <pems-label css="small">@Localizer["Safety"]</pems-label>
                        <pems-select scale="small" name="safetyScore">
                            <option value="">@Localizer["Not scored"]</option>
                            @for (var i = 1; i <= 5; i++) { <option value="@i" selected="@(Model.SafetyScore == i)">@i</option> }
                        </pems-select>
                    </div>
                    <div class="mb-2">
                        <pems-label css="small">@Localizer["Production / Availability"]</pems-label>
                        <pems-select scale="small" name="productionScore">
                            <option value="">@Localizer["Not scored"]</option>
                            @for (var i = 1; i <= 5; i++) { <option value="@i" selected="@(Model.ProductionScore == i)">@i</option> }
                        </pems-select>
                    </div>
                    <div class="mb-2">
                        <pems-label css="small">@Localizer["Environment"]</pems-label>
                        <pems-select scale="small" name="environmentScore">
                            <option value="">@Localizer["Not scored"]</option>
                            @for (var i = 1; i <= 5; i++) { <option value="@i" selected="@(Model.EnvironmentScore == i)">@i</option> }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Rationale"]</pems-label><pems-textarea scale="small" name="rationale" rows="2">@Model.Rationale</pems-textarea></div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>

    <pems-modal id="evidenceModal" tabindex="-1">
            <form asp-action="AddEvidence" method="post">
                <input type="hidden" name="id" value="@Model.CriticalityAssessmentId" />
                <pems-modal-header>@Localizer["Add Evidence"]</pems-modal-header>
                <pems-modal-body>
                    <div class="mb-2">
                        <pems-label css="small">@Localizer["Source Type"]</pems-label>
                        <pems-select scale="small" name="sourceType">
                            <option value="Equipment">Equipment Record</option>
                            <option value="EquipmentClass">@Localizer["Equipment Class"]</option>
                            <option value="EngineeringDocument">Engineering Document</option>
                            <option value="PID">P&amp;ID</option>
                            <option value="Datasheet">@Localizer["Datasheet"]</option>
                            <option value="ProjectRecord">Project Record</option>
                            <option value="FailureTaxonomy">Failure Taxonomy</option>
                            <option value="MaintenanceRecord">Maintenance Record</option>
                            <option value="Other">@Localizer["Other"]</option>
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-label css="small">Source Identifier</pems-label><pems-input scale="small" name="sourceIdentifier" placeholder="e.g. document number, tag" /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Reference"]</pems-label><pems-input scale="small" name="reference" placeholder="e.g. revision, path" /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Description"]</pems-label><pems-textarea scale="small" name="description" rows="2" required></pems-textarea></div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>
}
