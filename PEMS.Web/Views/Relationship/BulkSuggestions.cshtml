@model List<PEMS.Application.DTOs.BulkSuggestedLinkItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <div>
        <p class="text-muted small mb-0">
            فقط تطبیق‌های کامل (Exact Match روی شماره‌ی خام ثبت‌شده) این‌جا نشون داده می‌شن -
            همون سطح اطمینانی که برای P&amp;ID استفاده کردیم. با این حال چون تایید هرکدوم یک
            رابطه‌ی دائمی می‌سازه، هنوز یک تایید صریح (هرچند دسته‌جمعی) لازمه.
        </p>
    </div>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["بازگشت به Explorer"]</pems-button>
</pems-flex>

@if (!Model.Any())
{
    <pems-content-card><p class="text-muted text-center py-4 mb-0">@Localizer["هیچ پیشنهاد تاییدنشده‌ای یافت نشد."]</p></pems-content-card>
}
else
{
    <pems-form asp-action="BulkConfirm" method="post">
        <pems-content-card css="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <input type="checkbox" id="selectAll" onclick="document.querySelectorAll('.item-check').forEach(c => c.checked = this.checked);" />
                <label for="selectAll" class="ms-1">انتخاب همه (@Model.Count مورد)</label>
            </div>
            <pems-button tone="primary" size="small" type="submit" data-pems-confirm="موارد انتخاب‌شده رسماً وصل می‌شن. مطمئنی؟">
                <pems-icon name="bi-check2-all" /> تایید موارد انتخاب‌شده
            </pems-button>
        </pems-content-card>

        <pems-content-card>
            <pems-table kind="enterprise" css="mb-0">
                <pems-table-head>
                    <pems-table-row><pems-table-header></pems-table-header><pems-table-header>@Localizer["Equipment Tag"]</pems-table-header><pems-table-header>@Localizer["نوع"]</pems-table-header><pems-table-header>@Localizer["مقصد"]</pems-table-header><pems-table-header>@Localizer["طبق شماره‌ی خام"]</pems-table-header></pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var item in Model)
                    {
                        var value = $"{item.EquipmentId}|{item.TargetType}|{item.TargetId}";
                        <pems-table-row>
                            <pems-table-cell><input type="checkbox" class="item-check" name="selectedItems" value="@value" /></pems-table-cell>
                            <pems-table-cell><a asp-action="Equipment" asp-route-id="@item.EquipmentId">@item.EquipmentTagNumber</a></pems-table-cell>
                            <pems-table-cell><pems-badge tone="neutral">@item.TargetType</pems-badge></pems-table-cell>
                            <pems-table-cell>@item.TargetLabel</pems-table-cell>
                            <pems-table-cell class="text-muted small">@item.MatchedOnRawValue</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-form>
}
