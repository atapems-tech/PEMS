@model PEMS.Application.DTOs.RelationshipGapReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard-x"></i> @Localizer["گزارش تحلیل شکاف - رابطه‌های ناقص تجهیزات"]</h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["بازگشت به Explorer"]</pems-button>
</div>

<p class="text-muted small">
    این گزارش برعکس Explorer عمل می‌کنه: به‌جای کاوش از یک تجهیز مشخص، همه‌ی تجهیزات رو بررسی
    می‌کنه و نشون می‌ده کدوم‌ها هنوز به مدرک مهندسی، VDR، MR یا WorkOrder وصل نشدن - برای
    برنامه‌ریزی و پیگیری شکاف‌های داده.
</p>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <pems-kpi-tile label="@Localizer["کل تجهیزات"]">@Model.TotalEquipmentCount</pems-kpi-tile>
    </div>
    <div class="col-md-3">
        <pems-kpi-tile tone="success" label="@Localizer["کاملاً وصل (هر ۴ نوع رابطه)"]">@Model.FullyLinkedCount</pems-kpi-tile>
    </div>
    <div class="col-md-3">
        <pems-kpi-tile tone="warning" label="@Localizer["ناقص (بعضی روابط)"]">@Model.PartiallyLinkedCount</pems-kpi-tile>
    </div>
    <div class="col-md-3">
        <pems-kpi-tile tone="danger" label="@Localizer["کاملاً بدون رابطه"]">@Model.UnlinkedCount</pems-kpi-tile>
    </div>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead>
            <tr>
                <th>@Localizer["Tag"]</th><th>@Localizer["Name"]</th><th>@Localizer["Area"]</th><th>@Localizer["Discipline"]</th>
                <th class="text-center">@Localizer["مدارک"]</th><th class="text-center">@Localizer["VDR"]</th>
                <th class="text-center">MR</th><th class="text-center">WorkOrder</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@item.TagNumber</strong></td>
                    <td class="small">@item.Name</td>
                    <td class="small">@item.Area</td>
                    <td class="small">@item.DisciplineName</td>
                    <td class="text-center">@(item.HasDocuments ? "✅" : "❌")</td>
                    <td class="text-center">@(item.HasVdrItems ? "✅" : "❌")</td>
                    <td class="text-center">@(item.HasMR ? "✅" : "❌")</td>
                    <td class="text-center">@(item.HasWorkOrders ? "✅" : "❌")</td>
                    <td><pems-button tone="primary" size="small" outline="true" as="a" asp-action="Equipment" asp-route-id="@item.EquipmentId"><i class="bi bi-diagram-3"></i></pems-button></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">همه‌ی تجهیزات کاملاً وصل هستن - عالیه!</p>
    }
</div>
