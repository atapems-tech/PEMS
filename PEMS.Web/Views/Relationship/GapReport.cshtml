@model PEMS.Application.DTOs.RelationshipGapReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0"><pems-icon name="bi-clipboard-x" /> @Localizer["گزارش تحلیل شکاف - رابطه‌های ناقص تجهیزات"]</h5>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["بازگشت به Explorer"]</pems-button>
</pems-flex>

<p class="text-muted small">
    این گزارش برعکس Explorer عمل می‌کنه: به‌جای کاوش از یک تجهیز مشخص، همه‌ی تجهیزات رو بررسی
    می‌کنه و نشون می‌ده کدوم‌ها هنوز به مدرک مهندسی، VDR، MR یا WorkOrder وصل نشدن - برای
    برنامه‌ریزی و پیگیری شکاف‌های داده.
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["کل تجهیزات"]">@Model.TotalEquipmentCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="success" label="@Localizer["کاملاً وصل (هر ۴ نوع رابطه)"]">@Model.FullyLinkedCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="warning" label="@Localizer["ناقص (بعضی روابط)"]">@Model.PartiallyLinkedCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="danger" label="@Localizer["کاملاً بدون رابطه"]">@Model.UnlinkedCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-content-card>
    <pems-table kind="enterprise" css="mb-0">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["Tag"]</pems-table-header><pems-table-header>@Localizer["Name"]</pems-table-header><pems-table-header>@Localizer["Area"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header>
                <pems-table-header class="text-center">@Localizer["مدارک"]</pems-table-header><pems-table-header class="text-center">@Localizer["VDR"]</pems-table-header>
                <pems-table-header class="text-center">MR</pems-table-header><pems-table-header class="text-center">WorkOrder</pems-table-header><pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var item in Model.Items)
            {
                <pems-table-row>
                    <pems-table-cell><strong>@item.TagNumber</strong></pems-table-cell>
                    <pems-table-cell class="small">@item.Name</pems-table-cell>
                    <pems-table-cell class="small">@item.Area</pems-table-cell>
                    <pems-table-cell class="small">@item.DisciplineName</pems-table-cell>
                    <pems-table-cell class="text-center">@(item.HasDocuments ? "✅" : "❌")</pems-table-cell>
                    <pems-table-cell class="text-center">@(item.HasVdrItems ? "✅" : "❌")</pems-table-cell>
                    <pems-table-cell class="text-center">@(item.HasMR ? "✅" : "❌")</pems-table-cell>
                    <pems-table-cell class="text-center">@(item.HasWorkOrders ? "✅" : "❌")</pems-table-cell>
                    <pems-table-cell><pems-button tone="primary" size="small" outline="true" as="a" asp-action="Equipment" asp-route-id="@item.EquipmentId"><pems-icon name="bi-diagram-3" /></pems-button></pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">همه‌ی تجهیزات کاملاً وصل هستن - عالیه!</p>
    }
</pems-content-card>
