@model PEMS.Application.DTOs.FailureModeEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.ViewModels
@inject IStringLocalizer<SharedResource> Localizer
@{
    var classes = (List<LookupItem>)ViewBag.Classes;
    var causes = (List<LookupItem>)ViewBag.Causes;
    var errors = (List<string>)ViewBag.Errors;
}

<div class="content-card pems-s-71e17938">
    <h6 class="mb-3">@Localizer["Rcm_FailureMode"]</h6>
    @await Html.PartialAsync("_RcmErrors", errors)
    <form method="post" asp-action="Edit">
        <input type="hidden" name="FailureModeId" value="@Model.FailureModeId" />
        <div class="row g-3">
            <div class="col-md-4"><pems-label>@Localizer["Rcm_Code"] *</pems-label><pems-input name="Code" value="@Model.Code" required /></div>
            <div class="col-md-4"><pems-label>@Localizer["Rcm_NameEn"] *</pems-label><pems-input name="Name" value="@Model.Name" required /></div>
            <div class="col-md-4"><pems-label>@Localizer["Rcm_NameFa"]</pems-label><pems-input name="NameFa" value="@Model.NameFa" dir="rtl" /></div>
            <div class="col-md-6">
                <pems-label>@Localizer["Rcm_EquipmentClass"]</pems-label>
                <pems-select name="EquipmentClassId">
                    <option value="">@Localizer["Rcm_AllClasses"]</option>
                    @foreach (var c in classes) { <option value="@c.Id" selected="@(Model.EquipmentClassId == c.Id)">@c.Text (@c.Code)</option> }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Rcm_FailureCauses"]</pems-label>
                <pems-select name="CauseIds" multiple size="6">
                    @foreach (var c in causes) { <option value="@c.Id" selected="@Model.CauseIds.Contains(c.Id)">@c.Text</option> }
                </pems-select>
            </div>
            <div class="col-12"><pems-label>@Localizer["Rcm_Description"]</pems-label><pems-textarea name="Description" rows="2">@Model.Description</pems-textarea></div>
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="act" checked="@Model.IsActive" />
                    <label class="form-check-label" for="act">@Localizer["Rcm_Active"]</label>
                    <input type="hidden" name="IsActive" value="false" />
                </div>
            </div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
