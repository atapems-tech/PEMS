@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InventoryTransactionRowDto>
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
    var types = new[] { "Receipt", "Issue", "Return", "Transfer", "Adjustment", "Reservation", "ReservationRelease" };
}

<div class="content-card">
    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        <select name="warehouseId" class="form-select form-select-sm" style="max-width:180px;">
            <option value="">All warehouses</option>
            @foreach (var w in warehouses) { <option value="@w.WarehouseId" selected="@(w.WarehouseId == (int?)ViewBag.WarehouseId)">@w.Code</option> }
        </select>
        <select name="transactionType" class="form-select form-select-sm" style="max-width:200px;">
            <option value="">All types</option>
            @foreach (var t in types) { <option value="@t" selected="@(t == (string?)ViewBag.TransactionType)">@t</option> }
        </select>
        <input type="date" name="fromDate" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="max-width:160px;" />
        <input type="date" name="toDate" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" style="max-width:160px;" />
        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> Filter</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
    </form>

    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('InventoryTransaction')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:70vh; overflow-y:auto;">
        <table class="table table-enterprise table-sm pems-grid-table" data-grid-key="InventoryTransaction">
            <thead>
                <tr>
                    <th data-col-key="date" data-resizable="true" data-min-width="120" data-max-width="200">Date</th>
                    <th data-col-key="material" data-resizable="true" data-min-width="160" data-max-width="360">Material</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180">Type</th>
                    <th data-col-key="warehouse" data-resizable="true" data-min-width="80" data-max-width="160">Warehouse</th>
                    <th data-col-key="qty" data-resizable="true" data-min-width="70" data-max-width="120">Qty</th>
                    <th data-col-key="reference" data-resizable="true" data-min-width="100" data-max-width="220">Reference</th>
                    <th data-col-key="by" data-resizable="true" data-min-width="100" data-max-width="220">By</th>
                    <th data-col-key="reason" data-resizable="true" data-min-width="120" data-max-width="320">Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="small">@t.MaterialCode - @t.MaterialDescription</td>
                        <td><span class="badge bg-light text-dark border">@t.TransactionType</span></td>
                        <td>@t.WarehouseCode</td>
                        <td>@t.Quantity</td>
                        <td class="small">@(t.ReferenceType ?? "-") @(t.ReferenceId?.ToString() ?? "")</td>
                        <td class="small">@(t.EmployeeName ?? "-")</td>
                        <td class="small text-muted">@(t.Reason ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">تراکنشی یافت نشد.</p> }

    @{
        var qsParts = new List<string>();
        if (ViewBag.WarehouseId != null) qsParts.Add($"warehouseId={ViewBag.WarehouseId}");
        if (!string.IsNullOrEmpty((string?)ViewBag.TransactionType)) qsParts.Add($"transactionType={Uri.EscapeDataString((string)ViewBag.TransactionType)}");
        if (ViewBag.FromDate != null) qsParts.Add($"fromDate={((DateTime)ViewBag.FromDate):yyyy-MM-dd}");
        if (ViewBag.ToDate != null) qsParts.Add($"toDate={((DateTime)ViewBag.ToDate):yyyy-MM-dd}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "InventoryTransaction",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('InventoryTransaction');
        });
    </script>
}
