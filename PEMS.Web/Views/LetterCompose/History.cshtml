@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@model PEMS.Web.Controllers.LetterHistoryViewModel
@inject IStringLocalizer<SharedResource> Localizer
@section Styles {
    <link rel="stylesheet" href="~/css/letter-compose.css" asp-append-version="true" />
}
<div class="lc-page">
    <div class="lc-header">
        <h2 class="vs-section__title mb-0">@Localizer["Lc_HistoryTitle"]</h2>
        <span class="lc-number">@Model.Report.LetterNumber</span>
        <pems-badge tone="neutral">@Model.Report.Status</pems-badge>
        <span class="lc-savestate">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Letter" asp-action="Details" asp-route-id="@Model.Report.LetterId">@Localizer["Lc_BackToLetter"]</pems-button>
            <pems-button tone="primary" size="small" outline="true" as="a" asp-action="ComplianceExport" asp-route-id="@Model.Report.LetterId"><pems-icon name="bi-download" aria-hidden="true" /> @Localizer["Lc_ExportCsv"]</pems-button>
        </span>
    </div>
    <p class="text-muted">@Model.Report.Subject</p>

    <section class="lc-card" aria-labelledby="lhViews">
        <h3 id="lhViews"><pems-icon name="bi-eye" aria-hidden="true" /> @Localizer["Lc_WhoViewed"]</h3>
        @if (!Model.Views.Any())
        {
            <p class="text-muted mb-0">@Localizer["Lc_NobodyViewed"]</p>
        }
        else
        {
            <pems-table-scroll>
                <pems-table scale="small" css="lh-table">
                    <pems-table-head><pems-table-row><pems-table-header scope="col">@Localizer["Lc_Name"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_FirstViewed"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_LastViewed"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_ViewCount"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var v in Model.Views)
                        {
                            <pems-table-row><pems-table-cell>@v.UserName</pems-table-cell><pems-table-cell>@v.FirstViewedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell><pems-table-cell>@v.LastViewedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell><pems-table-cell>@v.ViewCount</pems-table-cell></pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            </pems-table-scroll>
        }
    </section>

    <section class="lc-card" aria-labelledby="lhVersions">
        <h3 id="lhVersions"><pems-icon name="bi-clock-history" aria-hidden="true" /> @Localizer["Lc_Versions"]</h3>
        @if (!Model.Versions.Any())
        {
            <p class="text-muted mb-0">@Localizer["Lc_NoVersions"]</p>
        }
        else
        {
            @foreach (var v in Model.Versions.OrderByDescending(x => x.VersionNo))
            {
                <details class="mb-2">
                    <summary>
                        <strong>v@(v.VersionNo)</strong> · @v.Reason · @v.SavedByName · @v.SavedDate.ToString("yyyy-MM-dd HH:mm") — @v.Subject
                    </summary>
                    @* نسخه‌ها هنگام ذخیره Sanitize شده‌اند *@
                    <div class="lh-body mt-2">@Html.Raw(v.Body)</div>
                </details>
            }
        }
    </section>

    <section class="lc-card" aria-labelledby="lhAudit">
        <h3 id="lhAudit"><pems-icon name="bi-shield-check" aria-hidden="true" /> @Localizer["Lc_AuditTrail"]</h3>
        <pems-table-scroll>
            <pems-table scale="small" css="lh-table">
                <pems-table-head><pems-table-row><pems-table-header scope="col">@Localizer["Lc_When"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_Who"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_Category"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_Event"]</pems-table-header><pems-table-header scope="col">@Localizer["Lc_DetailCol"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var r in Model.Report.Rows)
                    {
                        <pems-table-row><pems-table-cell class="text-nowrap">@r.Timestamp.ToString("yyyy-MM-dd HH:mm")</pems-table-cell><pems-table-cell>@r.Actor</pems-table-cell><pems-table-cell>@r.Category</pems-table-cell><pems-table-cell>@r.Event</pems-table-cell><pems-table-cell>@r.Detail</pems-table-cell></pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    </section>
</div>
