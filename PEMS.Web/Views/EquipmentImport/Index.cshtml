@model List<PEMS.Application.DTOs.EquipmentImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<pems-content-card css="mb-3">
    <p class="text-muted small">
        Upload an Excel file of equipment (Mechanical, Instrument, or any discipline). Column names
        vary between files - the system automatically detects the header row and recognizes common
        variants (Tag No., Item Name, EQ Type, Discipline, Area, P&amp;ID, MR/MRQ No.). Review the
        recognized rows before they are added to the live Equipment register.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">Equipment Excel File</pems-label>
            <pems-input type="file" name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

<pems-content-card css="mb-3">
    <p class="text-muted small">
        Or, scan a PDF for tag-number-looking text (best-effort recognition, not a full structured
        extraction - you'll review and pick which tags to add).
    </p>
    <form asp-action="ScanPdf" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">PDF File</pems-label>
            <pems-input type="file" name="file" accept=".pdf" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" outline="true" css="w-100" type="submit"><pems-icon name="bi-file-earmark-pdf" /> Scan PDF</pems-button>
        </pems-col>
    </pems-row></form>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["File"]</pems-table-header><pems-table-header>@Localizer["Project"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>Rows</pems-table-header><pems-table-header>@Localizer["New"]</pems-table-header><pems-table-header>Updates</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var b in Model)
            {
                <pems-table-row>
                    <pems-table-cell>@b.FileName</pems-table-cell>
                    <pems-table-cell>@b.ProjectName</pems-table-cell>
                    <pems-table-cell>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell>@b.Rows.Count</pems-table-cell>
                    <pems-table-cell><pems-badge tone="success">@b.Rows.Count(x => !x.IsUpdate)</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="info">@b.Rows.Count(x => x.IsUpdate)</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(b.Status == "Committed" ? "success" : "neutral")">@b.Status</pems-badge></pems-table-cell>
                    <pems-table-cell>
                        @if (b.Status == "Staging")
                        {
                            <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Review" asp-route-batchId="@b.EquipmentImportBatchId">Review</pems-button>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </pems-table-scroll>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No equipment imports yet.</p> }
</pems-content-card>
