@model List<PEMS.Application.DTOs.EquipmentImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<div class="content-card mb-3">
    <p class="text-muted small">
        Upload an Excel file of equipment (Mechanical, Instrument, or any discipline). Column names
        vary between files - the system automatically detects the header row and recognizes common
        variants (Tag No., Item Name, EQ Type, Discipline, Area, P&amp;ID, MR/MRQ No.). Review the
        recognized rows before they are added to the live Equipment register.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">@Localizer["Project"]</label>
            <select name="projectId" class="form-select" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small">Equipment Excel File</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" css="w-100" type="submit"><i class="bi bi-cloud-upload"></i> @Localizer["Upload"]</pems-button>
        </div>
    </form>
</div>

<div class="content-card mb-3">
    <p class="text-muted small">
        Or, scan a PDF for tag-number-looking text (best-effort recognition, not a full structured
        extraction - you'll review and pick which tags to add).
    </p>
    <form asp-action="ScanPdf" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">@Localizer["Project"]</label>
            <select name="projectId" class="form-select" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small">PDF File</label>
            <input type="file" name="file" class="form-control" accept=".pdf" required />
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" outline="true" css="w-100" type="submit"><i class="bi bi-file-earmark-pdf"></i> Scan PDF</pems-button>
        </div>
    </form>
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Recent Import Batches"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["File"]</th><th>@Localizer["Project"]</th><th>@Localizer["Date"]</th><th>Rows</th><th>@Localizer["New"]</th><th>Updates</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.FileName</td>
                    <td>@b.ProjectName</td>
                    <td>@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@b.Rows.Count</td>
                    <td><pems-badge tone="success">@b.Rows.Count(x => !x.IsUpdate)</pems-badge></td>
                    <td><pems-badge tone="info">@b.Rows.Count(x => x.IsUpdate)</pems-badge></td>
                    <td><span class="badge @(b.Status == "Committed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                    <td>
                        @if (b.Status == "Staging")
                        {
                            <a asp-action="Review" asp-route-batchId="@b.EquipmentImportBatchId" class="btn btn-sm btn-outline-primary">Review</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No equipment imports yet.</p> }
</div>
