@model PEMS.Application.DTOs.EquipmentImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-alert tone="info" css="py-2 px-3 small mb-3">
    <i class="bi bi-info-circle"></i> ستون‌های MR No / PO No فقط به‌عنوان متن ذخیره می‌شوند - دیگر
    خودکار Vendor/MR/VDR جدید ساخته نمی‌شود. برای اتصال به داده‌ی موجود، بعد از Commit به
    <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="0" onclick="return false;" class="text-decoration-underline">@Localizer["Relationship Explorer"]</a>
    هر تجهیز مراجعه کن و پیشنهاد اتصال را تایید کن.
</pems-alert>

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-3"><strong>@Localizer["File:"]</strong> @Model.FileName</div>
        <div class="col-md-3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</div>
        <div class="col-md-2"><strong>@Localizer["Total:"]</strong> @Model.Rows.Count</div>
        <div class="col-md-2"><strong>Updates:</strong> @Model.Rows.Count(x => x.IsUpdate)</div>
        <div class="col-md-2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></div>
    </div>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                <pems-button tone="primary" type="submit" onclick="return confirm('Commit the selected rows into the live Equipment register?')">
                    <i class="bi bi-check-circle"></i> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" onclick="return confirm('Discard this entire import batch?')">
                    <i class="bi bi-trash"></i> Discard Batch
                </pems-button>
            </form>
        </div>
    }
</div>

<div class="content-card">
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Include"]</th><th>#</th><th>Tag No</th><th>@Localizer["Name"]</th><th>@Localizer["Type"]</th>
                    <th>@Localizer["Discipline"]</th><th>@Localizer["Area"]</th><th>P&amp;ID</th><th>MR No</th><th>PO No</th><th>Existing?</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            @if (Model.Status == "Staging")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.EquipmentImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <button type="submit" class="btn btn-sm @(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" style="width:36px;">
                                        <i class="bi @(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </td>
                        <td>@r.RowNumber</td>
                        <td>
                            <strong>@r.TagNumber</strong>
                            @if (r.ValidationStatus == "Warning")
                            {
                                <pems-badge tone="warning" css="d-block mt-1" style="white-space:normal; text-align:right;">
                                    <i class="bi bi-exclamation-triangle"></i> @r.ValidationMessage
                                </pems-badge>
                            }
                        </td>
                        <td class="small">@r.Name</td>
                        <td class="small">@r.Payload?.EquipmentTypeCode</td>
                        <td class="small">@r.DisciplineCodeRaw</td>
                        <td class="small">@r.Payload?.Area</td>
                        <td class="small">@r.Payload?.PIDNumber</td>
                        <td class="small">@r.Payload?.MRNumber</td>
                        <td class="small">@r.Payload?.PONumber</td>
                        <td>@(r.IsUpdate ? "Update existing" : "New")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Rows.Any()) { <p class="text-muted text-center py-4">No equipment rows recognized in this file.</p> }
</div>
