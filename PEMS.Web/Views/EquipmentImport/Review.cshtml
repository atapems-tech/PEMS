@model PEMS.Application.DTOs.EquipmentImportBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-alert tone="info" css="py-2 px-3 small mb-3">
    <pems-icon name="bi-info-circle" /> ستون‌های MR No / PO No فقط به‌عنوان متن ذخیره می‌شوند - دیگر
    خودکار Vendor/MR/VDR جدید ساخته نمی‌شود. برای اتصال به داده‌ی موجود، بعد از Commit به
    <a asp-controller="Relationship" asp-action="Equipment" asp-route-id="0" onclick="return false;" class="text-decoration-underline">@Localizer["Relationship Explorer"]</a>
    هر تجهیز مراجعه کن و پیشنهاد اتصال را تایید کن.
</pems-alert>

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3"><strong>@Localizer["File:"]</strong> @Model.FileName</pems-col>
        <pems-col md="3"><strong>@Localizer["Project:"]</strong> @Model.ProjectName</pems-col>
        <pems-col md="2"><strong>@Localizer["Total:"]</strong> @Model.Rows.Count</pems-col>
        <pems-col md="2"><strong>Updates:</strong> @Model.Rows.Count(x => x.IsUpdate)</pems-col>
        <pems-col md="2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></pems-col>
    </pems-row>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                <pems-button tone="primary" type="submit" data-pems-confirm="Commit the selected rows into the live Equipment register?">
                    <pems-icon name="bi-check-circle" /> Commit Selected Rows
                </pems-button>
            </form>
            <form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                <pems-button tone="danger" outline="true" type="submit" data-pems-confirm="Discard this entire import batch?">
                    <pems-icon name="bi-trash" /> Discard Batch
                </pems-button>
            </form>
        </div>
    }
</pems-content-card>

<pems-content-card>
    <div class="table-responsive table-scroll-area pems-s-8da1c6e6">
        <pems-table kind="enterprise">
            <thead>
                <tr>
                    <th>@Localizer["Include"]</th><th>#</th><th>Tag No</th><th>@Localizer["Name"]</th><th>@Localizer["Type"]</th>
                    <th>@Localizer["Discipline"]</th><th>@Localizer["Area"]</th><th>P&amp;ID</th><th>MR No</th><th>PO No</th><th>Existing?</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>
                            @if (Model.Status == "Staging")
                            {
                                <form asp-action="ToggleRow" method="post">
                                    <input type="hidden" name="rowId" value="@r.EquipmentImportRowId" />
                                    <input type="hidden" name="batchId" value="@Model.EquipmentImportBatchId" />
                                    <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                    <pems-button class="pems-w-36" tone="none" size="small" css="@(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" type="submit">
                                        <pems-icon css="@(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")" />
                                    </pems-button>
                                </form>
                            }
                            else
                            {
                                @(r.IncludeInCommit ? "Yes" : "No")
                            }
                        </td>
                        <td>@r.RowNumber</td>
                        <td>
                            <strong>@r.TagNumber</strong>
                            @if (r.ValidationStatus == "Warning")
                            {
                                <pems-badge class="pems-wrap-start" tone="warning" css="d-block mt-1">
                                    <pems-icon name="bi-exclamation-triangle" /> @r.ValidationMessage
                                </pems-badge>
                            }
                        </td>
                        <td class="small">@r.Name</td>
                        <td class="small">@r.Payload?.EquipmentTypeCode</td>
                        <td class="small">@r.DisciplineCodeRaw</td>
                        <td class="small">@r.Payload?.Area</td>
                        <td class="small">@r.Payload?.PIDNumber</td>
                        <td class="small">@r.Payload?.MRNumber</td>
                        <td class="small">@r.Payload?.PONumber</td>
                        <td>@(r.IsUpdate ? "Update existing" : "New")</td>
                    </tr>
                }
            </tbody>
        </pems-table>
    </div>
    @if (!Model.Rows.Any()) { <p class="text-muted text-center py-4">No equipment rows recognized in this file.</p> }
</pems-content-card>
