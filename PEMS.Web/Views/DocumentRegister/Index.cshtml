@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EngineeringDocumentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var savedFilters = (List<PEMS.Application.DTOs.SavedFilterDto>)ViewBag.SavedFilters;
    var selectedDisciplines = (List<string>)ViewBag.SelectedDisciplines;
    var projects = (List<string>)ViewBag.Projects;
    var disciplines = (List<string>)ViewBag.Disciplines;
    var statuses = (List<string>)ViewBag.Statuses;
    var project = (string?)ViewBag.SelectedProject;
    var status = (string?)ViewBag.SelectedStatus;
    var q = (string?)ViewBag.SearchTerm;
    var disciplinesQs = selectedDisciplines.Any() ? string.Join(",", selectedDisciplines) : null;

    var filterCount = (string.IsNullOrEmpty(project) ? 0 : 1) + (selectedDisciplines.Any() ? 1 : 0) + (string.IsNullOrEmpty(status) ? 0 : 1);

    // display text of a status; the stored value never changes (no key => the raw value)
    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component. The register keeps its own filters (multi-discipline), saved filters,
   row selection with "export selected", and its Excel export. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">

    <nav class="vs-subnav" aria-label="@Localizer["Ed_Documents"]">
        <a asp-controller="EngineeringDocuments" asp-action="Index">@Localizer["Ed_Documents"]</a>
        <a asp-controller="DocumentRegister" asp-action="Index" class="active" aria-current="page">@Localizer["Ed_Register"]</a>
        <a asp-controller="VDR" asp-action="Index">@Localizer["Ed_VendorDocs"]</a>
        <a asp-controller="Transmittal" asp-action="Index">@Localizer["Ed_Transmittals"]</a>
    </nav>

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["DocumentRegister"]" total="@Model.TotalCount">
            <pems-list-search id="drSearchForm" action="@Url.Action("Index")" input-id="drQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Dr_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(project)) { <input type="hidden" name="project" value="@project" /> }
                @if (disciplinesQs != null) { <input type="hidden" name="disciplines" value="@disciplinesQs" /> }
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="drSearchForm">
                <pems-list-filters form-id="drFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="drFilterProject">@Localizer["Project"]</label>
                        <select id="drFilterProject" name="project" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var p in projects)
                            { <option value="@p" selected="@(p == project)">@p</option> }
                        </select>
                    </div>
                    <fieldset>
                        <legend class="lp-lbl">@Localizer["Ed_Discipline"]</legend>
                        <div class="lp-checklist">
                            @for (var i = 0; i < disciplines.Count; i++)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="@disciplines[i]" id="drDisc@(i)" data-dr-discipline
                                           checked="@selectedDisciplines.Contains(disciplines[i])" />
                                    <label class="form-check-label" for="drDisc@(i)">@disciplines[i]</label>
                                </div>
                            }
                        </div>
                        <input type="hidden" name="disciplines" id="drDisciplines" value="@disciplinesQs" />
                    </fieldset>
                    <div>
                        <label class="lp-lbl" for="drFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="drFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                </pems-list-filters>

                <pems-list-menu id="drViewsBtn" icon="bi-bookmark" label="@Localizer["Dr_Views"]">
                    <li><h6 class="dropdown-header">@Localizer["Dr_QuickFilters"]</h6></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Approved" })">@StatusText("Approved")</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Submitted" })">@Localizer["Dr_PendingReview"]</a></li>
                    @if (savedFilters.Any())
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">@Localizer["Dr_SavedFilters"]</h6></li>
                        foreach (var sf in savedFilters)
                        {
                            <li class="lp-menu-row">
                                <a class="dropdown-item" href="@(Url.Action("Index") + "?" + sf.QueryString)">
                                    @if (sf.IsDefault) { <i class="bi bi-star-fill" aria-hidden="true"></i> }
                                    @sf.Name
                                </a>
                                <form asp-action="DeleteFilter" method="post" onsubmit="return confirm('@Localizer["Dr_DeleteFilterConfirm"].Value.Replace("'", "\\'")');">
                                    <input type="hidden" name="id" value="@sf.SavedFilterId" />
                                    <button type="submit" class="lp-act lp-act--always" title="@Localizer["Dr_DeleteFilter"]"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Dr_DeleteFilter"]: @sf.Name</span></button>
                                </form>
                            </li>
                        }
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#saveFilterModal"><i class="bi bi-bookmark-plus" aria-hidden="true"></i> @Localizer["Dr_SaveFilter"]</button></li>
                </pems-list-menu>

                <pems-list-export href="@Url.Action("ExportExcel", new { project, disciplines = disciplinesQs, status, q })" />
                <pems-list-reset-columns grid-key="DocumentRegister" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index", new { q })">
            @if (!string.IsNullOrEmpty(project))
            { <pems-list-chip label="@Localizer["Project"]" value="@project" remove-href="@Url.Action("Index", new { disciplines = disciplinesQs, status, q })" /> }
            @if (disciplinesQs != null)
            { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@string.Join("، ", selectedDisciplines)" remove-href="@Url.Action("Index", new { project, status, q })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { project, disciplines = disciplinesQs, q })" /> }
        </pems-list-chips>

        <pems-list-bulk count-text="@Localizer["Lp_SelectedCount"]">
            <form asp-action="ExportSelected" method="post">
                <pems-button tone="success" size="small" outline="true" type="submit"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> @Localizer["Dr_ExportSelected"]</pems-button>
            </form>
        </pems-list-bulk>

        <pems-list-grid>
            <pems-list-table grid-key="DocumentRegister" empty="@(!Model.Items.Any())" empty-text="@Localizer["Dr_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="select" data-resizable="false" class="lp-select"><input type="checkbox" class="form-check-input" data-lp-select-all aria-label="@Localizer["Lp_SelectAll"]" /></th>
                        <th data-col-key="docNo" data-resizable="true" data-min-width="120" data-max-width="260" style="width:160px">@Localizer["Ed_DocNo"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="180" data-max-width="500" style="width:300px">@Localizer["Ed_Title"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px" class="vs-hide-md">@Localizer["Ed_Type"]</th>
                        <th data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="200" style="width:110px" class="vs-hide-md">@Localizer["Ed_Area"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="240" style="width:160px">@Localizer["Project"]</th>
                        <th data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="120" style="width:80px">@Localizer["Ed_Rev"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="commentStatus" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Dr_CommentStatus"]</th>
                        <th data-col-key="delay" data-resizable="true" data-min-width="80" data-max-width="140" style="width:90px">@Localizer["Ed_Delay"]</th>
                        <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px" class="vs-hide-md">@Localizer["Ed_Created"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-select"><input type="checkbox" class="form-check-input" value="@d.DocumentId" data-lp-select aria-label="@Localizer["Lp_SelectRow"]: @d.DocumentNo" /></td>
                            <td class="lp-no"><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId" class="lp-subject" title="@d.DocumentNo">@d.DocumentNo</a></td>
                            <td><span class="vs-title-cell" title="@d.Title">@d.Title</span></td>
                            <td class="vs-hide-md small" title="@d.DocumentType">@d.DocumentType</td>
                            <td class="vs-hide-md small" title="@d.Area">@d.Area</td>
                            <td class="small">
                                @if (string.IsNullOrWhiteSpace(d.DisciplineName))
                                { <span class="vs-pill vs-pill--neutral">@Localizer["Dr_Unassigned"]</span> }
                                else { <span title="@d.DisciplineName">@d.DisciplineName</span> }
                            </td>
                            <td class="small" title="@d.ProjectName">@d.ProjectName</td>
                            <td><span class="vs-num">@d.RevisionNo</span></td>
                            <td>
                                <span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(d.Status)"><i class="bi @DocumentStatusBadge.Icon(d.Status)" aria-hidden="true"></i> @StatusText(d.Status)</span>
                                @if (d.IsFrozen) { <i class="bi bi-snow text-info ms-1" title="@Localizer["Ed_Frozen"]" aria-label="@Localizer["Ed_Frozen"]"></i> }
                            </td>
                            <td class="vs-hide-md small" title="@d.CommentStatus">@d.CommentStatus</td>
                            <td class="small">
                                @if (d.DelayDays.HasValue && d.DelayDays > 0)
                                { <span class="vs-pill vs-pill--icon vs-pill--danger"><i class="bi bi-clock-history" aria-hidden="true"></i> <span class="vs-num">@d.DelayDays</span> @Localizer["Ed_DaysShort"]</span> }
                                else
                                { <span class="text-muted">&mdash;</span> }
                            </td>
                            <td class="vs-hide-md small text-muted">@d.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-nowrap lp-actions">
                                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Ed_View"]: @d.DocumentNo</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @{
                    var qsParts = new List<string>();
                    if (!string.IsNullOrEmpty(project)) qsParts.Add($"project={Uri.EscapeDataString(project)}");
                    if (disciplinesQs != null) qsParts.Add($"disciplines={Uri.EscapeDataString(disciplinesQs)}");
                    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
                    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "DocumentRegister",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>

</pems-list-page>

<div class="modal fade" id="saveFilterModal" tabindex="-1" aria-labelledby="saveFilterTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SaveFilter" method="post">
                <div class="modal-header"><h6 class="modal-title" id="saveFilterTitle">@Localizer["Dr_SaveFilterTitle"]</h6></div>
                <div class="modal-body">
                    <label class="form-label small" for="saveFilterName">@Localizer["Dr_FilterName"]</label>
                    <input name="name" id="saveFilterName" class="form-control" required />
                    <input type="hidden" name="queryString" id="saveFilterQueryString" />
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="saveFilterDefault" />
                        <label class="form-check-label" for="saveFilterDefault">@Localizer["Dr_SetDefault"]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
    <script>
        // this page's own filter rule: the ticked disciplines travel as one comma-separated value; a saved filter stores the filter form
        (function () {
            var hidden = document.getElementById('drDisciplines');
            var checks = document.querySelectorAll('[data-dr-discipline]');
            checks.forEach(function (c) {
                c.addEventListener('change', function () {
                    hidden.value = Array.prototype.filter.call(checks, function (x) { return x.checked; })
                        .map(function (x) { return x.value; }).join(',');
                });
            });
            var modal = document.getElementById('saveFilterModal');
            if (modal) modal.addEventListener('show.bs.modal', function () {
                var params = new URLSearchParams(new FormData(document.getElementById('drFilterForm')));
                Array.from(params.keys()).forEach(function (k) { if (!params.get(k)) params.delete(k); });
                document.getElementById('saveFilterQueryString').value = params.toString();
            });
        })();
    </script>
}
