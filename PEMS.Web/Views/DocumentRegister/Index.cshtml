@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EngineeringDocumentDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var savedFilters = (List<PEMS.Application.DTOs.SavedFilterDto>)ViewBag.SavedFilters;
    var selectedDisciplines = (List<string>)ViewBag.SelectedDisciplines;
    var projects = (List<string>)ViewBag.Projects;
    var disciplines = (List<string>)ViewBag.Disciplines;
    var statuses = (List<string>)ViewBag.Statuses;
    var project = (string?)ViewBag.SelectedProject;
    var status = (string?)ViewBag.SelectedStatus;
    var q = (string?)ViewBag.SearchTerm;
    var disciplinesQs = selectedDisciplines.Any() ? string.Join(",", selectedDisciplines) : null;

    var filterCount = (string.IsNullOrEmpty(project) ? 0 : 1) + (selectedDisciplines.Any() ? 1 : 0) + (string.IsNullOrEmpty(status) ? 0 : 1);

    // display text of a status; the stored value never changes (no key => the raw value)
    string StatusText(string? s)
    {
        var l = Localizer[DocumentStatusBadge.ResourceKey(s)];
        return l.ResourceNotFound ? (s ?? "") : l.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component. The register keeps its own filters (multi-discipline), saved filters,
   row selection with "export selected", and its Excel export. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">

    <nav class="vs-subnav" aria-label="@Localizer["Ed_Documents"]">
        <a asp-controller="EngineeringDocuments" asp-action="Index">@Localizer["Ed_Documents"]</a>
        <a asp-controller="DocumentRegister" asp-action="Index" class="active" aria-current="page">@Localizer["Ed_Register"]</a>
        <a asp-controller="VDR" asp-action="Index">@Localizer["Ed_VendorDocs"]</a>
        <a asp-controller="Transmittal" asp-action="Index">@Localizer["Ed_Transmittals"]</a>
    </nav>

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["DocumentRegister"]" total="@Model.TotalCount">
            <pems-list-search id="drSearchForm" action="@Url.Action("Index")" input-id="drQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Dr_SearchPlaceholder"]">
                @if (!string.IsNullOrEmpty(project)) { <input type="hidden" name="project" value="@project" /> }
                @if (disciplinesQs != null) { <input type="hidden" name="disciplines" value="@disciplinesQs" /> }
                @if (!string.IsNullOrEmpty(status)) { <input type="hidden" name="status" value="@status" /> }
            </pems-list-search>

            <pems-list-tools search-for="drSearchForm">
                <pems-list-filters form-id="drFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div>
                        <label class="lp-lbl" for="drFilterProject">@Localizer["Project"]</label>
                        <pems-select scale="small" id="drFilterProject" name="project">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var p in projects)
                            { <option value="@p" selected="@(p == project)">@p</option> }
                        </pems-select>
                    </div>
                    <fieldset>
                        <legend class="lp-lbl">@Localizer["Ed_Discipline"]</legend>
                        <div class="lp-checklist">
                            @for (var i = 0; i < disciplines.Count; i++)
                            {
                                <pems-check-row>
                                    <pems-input type="checkbox" value="@disciplines[i]" id="drDisc@(i)" data-dr-discipline checked="@selectedDisciplines.Contains(disciplines[i])" kind="check" />
                                    <label class="form-check-label" for="drDisc@(i)">@disciplines[i]</label>
                                </pems-check-row>
                            }
                        </div>
                        <input type="hidden" name="disciplines" id="drDisciplines" value="@disciplinesQs" />
                    </fieldset>
                    <div>
                        <label class="lp-lbl" for="drFilterStatus">@Localizer["Ed_Status"]</label>
                        <pems-select scale="small" id="drFilterStatus" name="status">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </pems-select>
                    </div>
                </pems-list-filters>

                <pems-list-menu id="drViewsBtn" icon="bi-bookmark" label="@Localizer["Dr_Views"]">
                    <li><h6 class="dropdown-header">@Localizer["Dr_QuickFilters"]</h6></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Approved" })">@StatusText("Approved")</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", new { status = "Submitted" })">@Localizer["Dr_PendingReview"]</a></li>
                    @if (savedFilters.Any())
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">@Localizer["Dr_SavedFilters"]</h6></li>
                        foreach (var sf in savedFilters)
                        {
                            <li class="lp-menu-row">
                                <a class="dropdown-item" href="@(Url.Action("Index") + "?" + sf.QueryString)">
                                    @if (sf.IsDefault) { <pems-icon name="bi-star-fill" aria-hidden="true" /> }
                                    @sf.Name
                                </a>
                                <pems-form asp-action="DeleteFilter" method="post" data-pems-confirm="@Localizer["Dr_DeleteFilterConfirm"]">
                                    <input type="hidden" name="id" value="@sf.SavedFilterId" />
                                    <pems-button plain="true" type="submit" css="lp-act lp-act--always" title="@Localizer["Dr_DeleteFilter"]"><pems-icon name="bi-x-lg" aria-hidden="true" /><span class="visually-hidden">@Localizer["Dr_DeleteFilter"]: @sf.Name</span></pems-button>
                                </pems-form>
                            </li>
                        }
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li><pems-button plain="true" type="button" css="dropdown-item" data-bs-toggle="modal" data-bs-target="#saveFilterModal"><pems-icon name="bi-bookmark-plus" aria-hidden="true" /> @Localizer["Dr_SaveFilter"]</pems-button></li>
                </pems-list-menu>

                <pems-list-export href="@Url.Action("ExportExcel", new { project, disciplines = disciplinesQs, status, q })" />
                <pems-list-reset-columns grid-key="DocumentRegister" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index", new { q })">
            @if (!string.IsNullOrEmpty(project))
            { <pems-list-chip label="@Localizer["Project"]" value="@project" remove-href="@Url.Action("Index", new { disciplines = disciplinesQs, status, q })" /> }
            @if (disciplinesQs != null)
            { <pems-list-chip label="@Localizer["Ed_Discipline"]" value="@string.Join("، ", selectedDisciplines)" remove-href="@Url.Action("Index", new { project, status, q })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { project, disciplines = disciplinesQs, q })" /> }
        </pems-list-chips>

        <pems-list-bulk count-text="@Localizer["Lp_SelectedCount"]">
            <pems-form asp-action="ExportSelected" method="post">
                <pems-button tone="success" size="small" outline="true" type="submit"><pems-icon name="bi-file-earmark-excel" aria-hidden="true" /> @Localizer["Dr_ExportSelected"]</pems-button>
            </pems-form>
        </pems-list-bulk>

        <pems-list-grid>
            <pems-list-table grid-key="DocumentRegister" empty="@(!Model.Items.Any())" empty-text="@Localizer["Dr_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header data-col-key="select" data-resizable="false" class="lp-select"><pems-input kind="check" type="checkbox" data-lp-select-all aria-label="@Localizer["Lp_SelectAll"]" /></pems-table-header>
                        <pems-table-header class="pems-w-160" data-col-key="docNo" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["Ed_DocNo"]</pems-table-header>
                        <pems-table-header class="pems-w-300" data-col-key="title" data-resizable="true" data-min-width="180" data-max-width="500">@Localizer["Ed_Title"]</pems-table-header>
                        <pems-table-header data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="200" class="vs-hide-md pems-w-120">@Localizer["Ed_Type"]</pems-table-header>
                        <pems-table-header data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="200" class="vs-hide-md pems-w-110">@Localizer["Ed_Area"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_Discipline"]</pems-table-header>
                        <pems-table-header class="pems-w-160" data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="240">@Localizer["Project"]</pems-table-header>
                        <pems-table-header class="pems-w-80" data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="120">@Localizer["Ed_Rev"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header data-col-key="commentStatus" data-resizable="true" data-min-width="100" data-max-width="220" class="vs-hide-md pems-w-140">@Localizer["Dr_CommentStatus"]</pems-table-header>
                        <pems-table-header class="pems-w-90" data-col-key="delay" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Ed_Delay"]</pems-table-header>
                        <pems-table-header data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" class="vs-hide-md pems-w-120">@Localizer["Ed_Created"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var d in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-select"><pems-input kind="check" type="checkbox" value="@d.DocumentId" data-lp-select aria-label="@Localizer["Lp_SelectRow"]: @d.DocumentNo" /></pems-table-cell>
                            <pems-table-cell class="lp-no"><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId" class="lp-subject" title="@d.DocumentNo">@d.DocumentNo</a></pems-table-cell>
                            <pems-table-cell><span class="vs-title-cell" title="@d.Title">@d.Title</span></pems-table-cell>
                            <pems-table-cell class="vs-hide-md small" title="@d.DocumentType">@d.DocumentType</pems-table-cell>
                            <pems-table-cell class="vs-hide-md small" title="@d.Area">@d.Area</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (string.IsNullOrWhiteSpace(d.DisciplineName))
                                { <span class="vs-pill vs-pill--neutral">@Localizer["Dr_Unassigned"]</span> }
                                else { <span title="@d.DisciplineName">@d.DisciplineName</span> }
                            </pems-table-cell>
                            <pems-table-cell class="small" title="@d.ProjectName">@d.ProjectName</pems-table-cell>
                            <pems-table-cell><span class="vs-num">@d.RevisionNo</span></pems-table-cell>
                            <pems-table-cell>
                                <span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(d.Status)"><pems-icon css="@DocumentStatusBadge.Icon(d.Status)" aria-hidden="true" /> @StatusText(d.Status)</span>
                                @if (d.IsFrozen) { <pems-icon name="bi-snow" css="text-info ms-1" title="@Localizer["Ed_Frozen"]" aria-label="@Localizer["Ed_Frozen"]" /> }
                            </pems-table-cell>
                            <pems-table-cell class="vs-hide-md small" title="@d.CommentStatus">@d.CommentStatus</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (d.DelayDays.HasValue && d.DelayDays > 0)
                                { <span class="vs-pill vs-pill--icon vs-pill--danger"><pems-icon name="bi-clock-history" aria-hidden="true" /> <span class="vs-num">@d.DelayDays</span> @Localizer["Ed_DaysShort"]</span> }
                                else
                                { <span class="text-muted">&mdash;</span> }
                            </pems-table-cell>
                            <pems-table-cell class="vs-hide-md small text-muted">@d.CreatedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                            <pems-table-cell class="text-nowrap lp-actions">
                                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]"><pems-icon name="bi-eye" aria-hidden="true" /><span class="visually-hidden">@Localizer["Ed_View"]: @d.DocumentNo</span></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @{
                    var qsParts = new List<string>();
                    if (!string.IsNullOrEmpty(project)) qsParts.Add($"project={Uri.EscapeDataString(project)}");
                    if (disciplinesQs != null) qsParts.Add($"disciplines={Uri.EscapeDataString(disciplinesQs)}");
                    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
                    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "DocumentRegister",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>

</pems-list-page>

<pems-modal id="saveFilterModal" tabindex="-1" aria-labelledby="saveFilterTitle" aria-hidden="true">
            <pems-form asp-action="SaveFilter" method="post">
                <pems-modal-header title-id="saveFilterTitle">@Localizer["Dr_SaveFilterTitle"]</pems-modal-header>
                <pems-modal-body>
                    <pems-label css="small" for="saveFilterName">@Localizer["Dr_FilterName"]</pems-label>
                    <pems-input name="name" id="saveFilterName" required />
                    <input type="hidden" name="queryString" id="saveFilterQueryString" />
                    <pems-check-row css="mt-2">
                        <pems-input kind="check" type="checkbox" name="isDefault" value="true" id="saveFilterDefault" />
                        <label class="form-check-label" for="saveFilterDefault">@Localizer["Dr_SetDefault"]</label>
                    </pems-check-row>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
    <script src="~/js/views/documentregister-index.js" asp-append-version="true"></script>
}
