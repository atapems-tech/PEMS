@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="d-flex justify-content-end align-items-center mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["Back to Dashboard"]</pems-button>
</div>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-kpi-tile label="@Localizer["کل NCR های ثبت‌شده"]">@ViewBag.TotalNCRs</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-kpi-tile tone="success" label="@Localizer["درصد بسته‌شده در ۱۴ روز"]">@ViewBag.ClosedOnTimeRate%</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        @{
            var bySeverity = (IEnumerable<dynamic>)ViewBag.BySeverity;
            var criticalCount = bySeverity.FirstOrDefault(x => x.Severity == "Critical")?.Count ?? 0;
        }
        <pems-kpi-tile tone="danger" label="@Localizer["NCR بحرانی (کل تاریخچه)"]">@criticalCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="7">
        <div class="content-card h-100">
            <h6 class="mb-3">@Localizer["نرخ NCR به تفکیک دیسیپلین"]</h6>
            <pems-table kind="enterprise" css="mb-0">
                <thead><tr><th>@Localizer["دیسیپلین"]</th><th>@Localizer["کل"]</th><th>@Localizer["باز"]</th><th>@Localizer["بحرانی"]</th><th>@Localizer["میانگین روز تا بستن"]</th></tr></thead>
                <tbody>
                    @foreach (var d in (IEnumerable<dynamic>)ViewBag.ByDiscipline)
                    {
                        <tr>
                            <td>@d.Discipline</td>
                            <td>@d.Total</td>
                            <td>@(d.Open > 0 ? (object)@d.Open : "0")</td>
                            <td>@(d.Critical > 0 ? (object)@d.Critical : "0")</td>
                            <td>@(Math.Round((double)d.AvgDaysToClose, 1))</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
        </div>
    </pems-col>

    <pems-col md="5">
        <div class="content-card h-100">
            <h6 class="mb-3">@Localizer["نرخ NCR به تفکیک شدت"]</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var s in (IEnumerable<dynamic>)ViewBag.BySeverity)
                {
                    var badgeClass = s.Severity == "Critical" ? "danger" : s.Severity == "Major" ? "warning" : "neutral";
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <pems-badge tone="@badgeClass">@s.Severity</pems-badge>
                        <strong>@s.Count</strong>
                    </li>
                }
            </ul>
        </div>
    </pems-col>
</pems-row>

<div class="content-card mt-3">
    <h6 class="mb-3">@Localizer["روند ماهانه NCR (۱۲ ماه اخیر)"]</h6>
    @{
        var byMonth = (IEnumerable<dynamic>)ViewBag.ByMonth;
        var maxCount = byMonth.Any() ? (int)byMonth.Max(x => (int)x.Count) : 1;
        if (maxCount == 0) maxCount = 1;
    }
    @if (byMonth.Any())
    {
        <div class="d-flex align-items-end gap-2 pems-s-a2ed4726">
            @foreach (var m in byMonth)
            {
                var heightPct = (int)((double)((int)m.Count) / maxCount * 100);
                <div class="d-flex flex-column align-items-center pems-s-97445a8d">
                    <div class="bg-primary" style="width:100%; height:@(heightPct)%; min-height:4px;" title="@m.Count"></div>
                    <div class="text-muted small mt-1 pems-s-3e8135c8">@m.Month</div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted small mb-0">@Localizer["داده‌ای برای ۱۲ ماه اخیر نیست."]</p>
    }
</div>
