@model PEMS.Domain.Entities.NonConformanceReport

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">@Model.NCRNumber</h5>
        <span class="text-muted small">@Model.QCDiscipline?.Name @(Model.Equipment != null ? " | " + Model.Equipment.TagNumber : "")</span>
    </div>
    <span class="badge @(Model.Status == "Closed" ? "bg-success" : Model.Status == "Dispositioned" ? "bg-info" : Model.Status == "PendingApproval" ? "bg-warning text-dark" : "bg-secondary") fs-6">@Model.Status</span>
</div>

<div class="content-card mb-3">
    <div class="row g-2">
        <div class="col-md-4"><strong>Severity:</strong> @Model.Severity</div>
        <div class="col-md-4"><strong>Raised:</strong> @Model.RaisedDate.ToString("yyyy-MM-dd")</div>
        <div class="col-md-4"><strong>Disposition:</strong> @(Model.Disposition ?? "-")</div>
    </div>
    <hr />
    <p class="mb-0">@Model.Description</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.RootCause) || !string.IsNullOrWhiteSpace(Model.CorrectiveAction))
{
    <div class="content-card mb-3">
        <h6 class="mb-2">Root Cause &amp; Corrective Action</h6>
        <p><strong>Root Cause:</strong> @Model.RootCause</p>
        <p><strong>Corrective Action:</strong> @Model.CorrectiveAction</p>
        <p class="mb-0"><strong>Preventive Action:</strong> @Model.PreventiveAction</p>
    </div>
}

@if (Model.Status == "Open" || Model.Status == "UnderReview")
{
    <div class="content-card mb-3">
        <h6 class="mb-3">Disposition</h6>
        <form asp-action="NcrDisposition" method="post">
            <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small">Disposition</label>
                    <select name="disposition" class="form-select form-select-sm" required>
                        <option value="RepairAccept">Repair &amp; Accept</option>
                        <option value="ReworkToConform">Rework to Conform</option>
                        <option value="UseAsIs">Use As-Is</option>
                        <option value="Reject">Reject</option>
                        <option value="Scrap">Scrap</option>
                    </select>
                </div>
                <div class="col-md-8"><label class="form-label small">Root Cause</label><input name="rootCause" class="form-control form-control-sm" /></div>
                <div class="col-md-6"><label class="form-label small">Corrective Action</label><textarea name="correctiveAction" class="form-control form-control-sm" rows="2"></textarea></div>
                <div class="col-md-6"><label class="form-label small">Preventive Action</label><textarea name="preventiveAction" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            @if (Model.Severity == "Critical")
            {
                <p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle"></i> چون این NCR بحرانه، بعد از ثبت Disposition، برای تایید نهایی به مدیر QA ارجاع می‌شه.</p>
            }
            <div class="mt-3">
                <button type="submit" class="btn btn-pems-solid btn-sm">Save Disposition</button>
            </div>
        </form>
    </div>
}
else if (Model.Status == "PendingApproval")
{
    <div class="content-card mb-3 border-warning">
        <h6 class="mb-3"><i class="bi bi-hourglass-split"></i> در انتظار تایید مدیر QA</h6>
        <p class="text-muted small">این NCR بحرانه و Disposition آن باید توسط مدیر QA تایید بشه قبل از بسته شدن.</p>
        <div class="d-flex gap-2">
            <form asp-action="NcrApprove" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
                <input type="hidden" name="decision" value="Approve" />
                <button class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> تایید Disposition</button>
            </form>
            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectDispositionModal">رد Disposition</button>
        </div>
    </div>

    <div class="modal fade" id="rejectDispositionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="NcrApprove" method="post">
                    <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
                    <input type="hidden" name="decision" value="Reject" />
                    <div class="modal-header"><h6 class="modal-title">رد Disposition</h6></div>
                    <div class="modal-body">
                        <textarea name="comment" class="form-control form-control-sm" rows="3" placeholder="دلیل رد" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">انصراف</button>
                        <button type="submit" class="btn btn-danger btn-sm">رد کن</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else if (Model.Status == "Dispositioned")
{
    <form asp-action="NcrClose" method="post">
        <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Close NCR</button>
    </form>
}
