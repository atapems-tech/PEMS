@model PEMS.Domain.Entities.NonConformanceReport
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">@Model.NCRNumber</h5>
        <span class="text-muted small">@Model.QCDiscipline?.Name @(Model.Equipment != null ? " | " + Model.Equipment.TagNumber : "")</span>
    </div>
    <pems-badge tone="none" css="@(Model.Status == "Closed" ? "bg-success" : Model.Status == "Dispositioned" ? "bg-info" : Model.Status == "PendingApproval" ? "bg-warning text-dark" : "bg-secondary") fs-6">@Model.Status</pems-badge>
</div>

<div class="content-card mb-3">
    <div class="row g-2">
        <div class="col-md-4"><strong>Severity:</strong> @Model.Severity</div>
        <div class="col-md-4"><strong>@Localizer["Raised:"]</strong> @Model.RaisedDate.ToString("yyyy-MM-dd")</div>
        <div class="col-md-4"><strong>Disposition:</strong> @(Model.Disposition ?? "-")</div>
    </div>
    <hr />
    <p class="mb-0">@Model.Description</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.RootCause) || !string.IsNullOrWhiteSpace(Model.CorrectiveAction))
{
    <div class="content-card mb-3">
        <h6 class="mb-2">Root Cause &amp; Corrective Action</h6>
        <p><strong>Root Cause:</strong> @Model.RootCause</p>
        <p><strong>Corrective Action:</strong> @Model.CorrectiveAction</p>
        <p class="mb-0"><strong>Preventive Action:</strong> @Model.PreventiveAction</p>
    </div>
}

@if (Model.Status == "Open" || Model.Status == "UnderReview")
{
    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["Disposition"]</h6>
        <form asp-action="NcrDisposition" method="post">
            <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
            <div class="row g-3">
                <div class="col-md-4">
                    <pems-label css="small">@Localizer["Disposition"]</pems-label>
                    <pems-select scale="small" name="disposition" required>
                        <option value="RepairAccept">Repair &amp; Accept</option>
                        <option value="ReworkToConform">Rework to Conform</option>
                        <option value="UseAsIs">Use As-Is</option>
                        <option value="Reject">@Localizer["Reject"]</option>
                        <option value="Scrap">Scrap</option>
                    </pems-select>
                </div>
                <div class="col-md-8"><pems-label css="small">@Localizer["Root Cause"]</pems-label><pems-input scale="small" name="rootCause" /></div>
                <div class="col-md-6"><pems-label css="small">@Localizer["Corrective Action"]</pems-label><pems-textarea scale="small" name="correctiveAction" rows="2"></pems-textarea></div>
                <div class="col-md-6"><pems-label css="small">Preventive Action</pems-label><pems-textarea scale="small" name="preventiveAction" rows="2"></pems-textarea></div>
            </div>
            @if (Model.Severity == "Critical")
            {
                <p class="text-muted small mt-2 mb-0"><pems-icon name="bi-info-circle" /> چون این NCR بحرانه، بعد از ثبت Disposition، برای تایید نهایی به مدیر QA ارجاع می‌شه.</p>
            }
            <div class="mt-3">
                <pems-button tone="primary" size="small" type="submit">Save Disposition</pems-button>
            </div>
        </form>
    </div>
}
else if (Model.Status == "PendingApproval")
{
    <div class="content-card mb-3 border-warning">
        <h6 class="mb-3"><pems-icon name="bi-hourglass-split" /> در انتظار تایید مدیر QA</h6>
        <p class="text-muted small">این NCR بحرانه و Disposition آن باید توسط مدیر QA تایید بشه قبل از بسته شدن.</p>
        <div class="d-flex gap-2">
            <form asp-action="NcrApprove" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
                <input type="hidden" name="decision" value="Approve" />
                <pems-button tone="success" size="small"><pems-icon name="bi-check-lg" /> تایید Disposition</pems-button>
            </form>
            <pems-button tone="danger" size="small" type="button" data-bs-toggle="modal" data-bs-target="#rejectDispositionModal">رد Disposition</pems-button>
        </div>
    </div>

    <pems-modal id="rejectDispositionModal" tabindex="-1">
                <form asp-action="NcrApprove" method="post">
                    <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
                    <input type="hidden" name="decision" value="Reject" />
                    <div class="modal-header"><h6 class="modal-title">رد Disposition</h6></div>
                    <div class="modal-body">
                        <pems-textarea scale="small" name="comment" rows="3" placeholder="@Localizer["دلیل رد"]" required></pems-textarea>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                        <pems-button tone="danger" size="small" type="submit">@Localizer["رد کن"]</pems-button>
                    </div>
                </form>
            </pems-modal>
}
else if (Model.Status == "Dispositioned")
{
    <form asp-action="NcrClose" method="post">
        <input type="hidden" name="id" value="@Model.NonConformanceReportId" />
        <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> Close NCR</pems-button>
    </form>
}
