@model List<PEMS.Domain.Entities.InspectionTestPlan>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the status colours became tones. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Inspection and Test Plans"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new href="@Url.Action("ItpCreate")" text="New ITP" />
            </pems-list-tools>
        </pems-list-toolbar>
        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No ITPs yet."]">
                <thead>
                    <tr><th>ITP No</th><th>@Localizer["Title"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Equipment"]</th><th>@Localizer["Status"]</th><th>@Localizer["Rev"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="ItpDetails" asp-route-id="@i.InspectionTestPlanId" class="lp-subject">@i.ITPNumber</a></td>
                            <td class="small">@i.Title</td>
                            <td class="small">@i.QCDiscipline?.Name</td>
                            <td class="small">@i.Equipment?.TagNumber</td>
                            <td><pems-badge tone="@(i.Status == "Active" ? "success" : i.Status == "Draft" ? "neutral" : "info")">@i.Status</pems-badge></td>
                            <td>@i.Revision</td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
