@model List<PEMS.Domain.Entities.InspectionTestPlan>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the status colours became tones. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Inspection and Test Plans"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new href="@Url.Action("ItpCreate")" text="New ITP" />
            </pems-list-tools>
        </pems-list-toolbar>
        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No ITPs yet."]">
                <pems-table-head>
                    <pems-table-row><pems-table-header>ITP No</pems-table-header><pems-table-header>@Localizer["Title"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Equipment"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Rev"]</pems-table-header></pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var i in Model)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="ItpDetails" asp-route-id="@i.InspectionTestPlanId" class="lp-subject">@i.ITPNumber</a></pems-table-cell>
                            <pems-table-cell class="small">@i.Title</pems-table-cell>
                            <pems-table-cell class="small">@i.QCDiscipline?.Name</pems-table-cell>
                            <pems-table-cell class="small">@i.Equipment?.TagNumber</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(i.Status == "Active" ? "success" : i.Status == "Draft" ? "neutral" : "info")">@i.Status</pems-badge></pems-table-cell>
                            <pems-table-cell>@i.Revision</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
