@model List<PEMS.Domain.Entities.InspectionTestPlan>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard-check"></i> Inspection &amp; Test Plans</h5>
    <a asp-action="ItpCreate" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New ITP</a>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>ITP No</th><th>Title</th><th>Discipline</th><th>Equipment</th><th>Status</th><th>Rev</th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td><a asp-action="ItpDetails" asp-route-id="@i.InspectionTestPlanId">@i.ITPNumber</a></td>
                    <td class="small">@i.Title</td>
                    <td class="small">@i.QCDiscipline?.Name</td>
                    <td class="small">@i.Equipment?.TagNumber</td>
                    <td><span class="badge @(i.Status == "Active" ? "bg-success" : i.Status == "Draft" ? "bg-secondary" : "bg-info")">@i.Status</span></td>
                    <td>@i.Revision</td>
                </tr>
            }
        </tbody>
    </table>
</div>
