@model List<PEMS.Domain.Entities.InspectionTestPlan>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <pems-button tone="primary" size="small" as="a" asp-action="ItpCreate"><i class="bi bi-plus-lg"></i> New ITP</pems-button>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>ITP No</th><th>@Localizer["Title"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Equipment"]</th><th>@Localizer["Status"]</th><th>@Localizer["Rev"]</th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td><a asp-action="ItpDetails" asp-route-id="@i.InspectionTestPlanId">@i.ITPNumber</a></td>
                    <td class="small">@i.Title</td>
                    <td class="small">@i.QCDiscipline?.Name</td>
                    <td class="small">@i.Equipment?.TagNumber</td>
                    <td><pems-badge tone="none" css="@(i.Status == "Active" ? "bg-success" : i.Status == "Draft" ? "bg-secondary" : "bg-info")">@i.Status</pems-badge></td>
                    <td>@i.Revision</td>
                </tr>
            }
        </tbody>
    </table>
</div>
