@model List<PEMS.Domain.Entities.NonConformanceReport>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Non-Conformance Reports</h5>
    <a asp-action="NcrCreate" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg"></i> Raise NCR</a>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>NCR No</th><th>Discipline</th><th>Equipment</th><th>Severity</th><th>Status</th><th>Raised</th></tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td><a asp-action="NcrDetails" asp-route-id="@n.NonConformanceReportId">@n.NCRNumber</a></td>
                    <td class="small">@n.QCDiscipline?.Name</td>
                    <td class="small">@n.Equipment?.TagNumber</td>
                    <td><span class="badge @(n.Severity == "Critical" ? "bg-danger" : n.Severity == "Major" ? "bg-warning text-dark" : "bg-secondary")">@n.Severity</span></td>
                    <td><span class="badge @(n.Status == "Closed" ? "bg-success" : n.Status == "Dispositioned" ? "bg-info" : n.Status == "PendingApproval" ? "bg-warning text-dark" : "bg-secondary")">@n.Status</span></td>
                    <td class="small">@n.RaisedDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
