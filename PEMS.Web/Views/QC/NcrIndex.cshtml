@model List<PEMS.Domain.Entities.NonConformanceReport>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the status colours became tones. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Non-Conformance Reports"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new href="@Url.Action("NcrCreate")" text="@Localizer["Raise NCR"]" />
            </pems-list-tools>
        </pems-list-toolbar>
        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No NCRs yet."]">
                <pems-table-head>
                    <pems-table-row><pems-table-header>NCR No</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Equipment"]</pems-table-header><pems-table-header>@Localizer["Severity"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Raised"]</pems-table-header></pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var n in Model)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="NcrDetails" asp-route-id="@n.NonConformanceReportId" class="lp-subject">@n.NCRNumber</a></pems-table-cell>
                            <pems-table-cell class="small">@n.QCDiscipline?.Name</pems-table-cell>
                            <pems-table-cell class="small">@n.Equipment?.TagNumber</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(n.Severity == "Critical" ? "danger" : n.Severity == "Major" ? "warning" : "neutral")">@n.Severity</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(n.Status == "Closed" ? "success" : n.Status == "Dispositioned" ? "info" : n.Status == "PendingApproval" ? "warning" : "neutral")">@n.Status</pems-badge></pems-table-cell>
                            <pems-table-cell class="small">@n.RaisedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
