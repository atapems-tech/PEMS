@model List<PEMS.Domain.Entities.NonConformanceReport>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <pems-button tone="danger" size="small" as="a" asp-action="NcrCreate"><i class="bi bi-plus-lg"></i> @Localizer["Raise NCR"]</pems-button>
</div>

<div class="content-card">
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>NCR No</th><th>@Localizer["Discipline"]</th><th>@Localizer["Equipment"]</th><th>@Localizer["Severity"]</th><th>@Localizer["Status"]</th><th>@Localizer["Raised"]</th></tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td><a asp-action="NcrDetails" asp-route-id="@n.NonConformanceReportId">@n.NCRNumber</a></td>
                    <td class="small">@n.QCDiscipline?.Name</td>
                    <td class="small">@n.Equipment?.TagNumber</td>
                    <td><pems-badge tone="@(n.Severity == "Critical" ? "danger" : n.Severity == "Major" ? "warning" : "neutral")">@n.Severity</pems-badge></td>
                    <td><pems-badge tone="none" css="@(n.Status == "Closed" ? "bg-success" : n.Status == "Dispositioned" ? "bg-info" : n.Status == "PendingApproval" ? "bg-warning text-dark" : "bg-secondary")">@n.Status</pems-badge></td>
                    <td class="small">@n.RaisedDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
