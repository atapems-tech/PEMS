@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="content-card pems-s-3f7efa5f">
    <h6 class="mb-3"><i class="bi bi-clipboard-check"></i> New Inspection &amp; Test Plan</h6>

    <form asp-action="ItpCreate" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <pems-label>ITP Number</pems-label>
                <pems-input name="itpNumber" required placeholder="e.g. ITP-P-101-001" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>

            <div class="col-md-6">
                <pems-label>@Localizer["QC Discipline"]</pems-label>
                <pems-select name="qcDisciplineId" required>
                    @foreach (var d in (IEnumerable<PEMS.Domain.Entities.QCDiscipline>)ViewBag.QCDisciplines)
                    {
                        <option value="@d.QCDisciplineId">@d.Name</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>Equipment <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی تگ، نام یا سازنده..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#equipmentIdHidden" autocomplete="off" />
                <input type="hidden" name="equipmentId" id="equipmentIdHidden" />
            </div>

            @* طبق ممیزی نهایی §13: بازرسی می‌تواند به یک Procurement Package یا Contract هم وصل
               باشد - نه فقط تجهیز - این دو فیلد پیش از این جلسه در دسترس نبودند *@
            <div class="col-md-6">
                <pems-label>@Localizer["Package"] <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                <pems-select name="procurementPackageId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.ProcurementPackages)
                    {
                        <option value="@p.ProcurementPackageId" selected="@(ViewBag.PrefillPackageId != null && (int)ViewBag.PrefillPackageId == (int)p.ProcurementPackageId)">@p.PackageNumber</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Contract"] <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                <pems-select name="contractId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var c in (IEnumerable<dynamic>)ViewBag.Contracts)
                    {
                        <option value="@c.ContractId" selected="@(ViewBag.PrefillContractId != null && (int)ViewBag.PrefillContractId == (int)c.ContractId)">@c.ContractNo</option>
                    }
                </pems-select>
            </div>

            <div class="col-12"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></div>
            <div class="col-md-6"><pems-label>Reference Code/Standard</pems-label><pems-input name="referenceCodeStandard" placeholder="e.g. ASME Section IX" /></div>
            <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="3"></pems-textarea></div>
        </div>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Create"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="ItpIndex">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
