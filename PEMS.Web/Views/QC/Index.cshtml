@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-flex justify="end" align="center" css="mb-2">
    <pems-flex gap="2">
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Kpi"><pems-icon name="bi-graph-up" /> KPI Report</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="ItpCreate"><pems-icon name="bi-plus-lg" /> New ITP</pems-button>
        <pems-button tone="danger" size="small" as="a" asp-action="NcrCreate"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Raise NCR"]</pems-button>
    </pems-flex>
</pems-flex>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-kpi-tile tone="danger" icon="bi-exclamation-triangle" color="red" label="@Localizer["NCR باز"]">@ViewBag.OpenNCRCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="6">
        <pems-kpi-tile icon="bi-clipboard-check" color="blue" label="@Localizer["ITP فعال"]">@ViewBag.ActiveITPCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-flex justify="between" align="center" css="mb-3">
                <h6 class="mb-0">@Localizer["آخرین ITP ها"]</h6>
                <a asp-action="ItpIndex" class="small">@Localizer["مشاهده همه"]</a>
            </pems-flex>
            @{
                var itps = (IEnumerable<PEMS.Domain.Entities.InspectionTestPlan>)ViewBag.RecentITPs;
            }
            <ul class="list-unstyled mb-0">
                @foreach (var i in itps)
                {
                    <pems-flex as="li" justify="between" css="border-bottom py-1">
                        <a asp-action="ItpDetails" asp-route-id="@i.InspectionTestPlanId">@i.ITPNumber &mdash; @i.Title</a>
                        <pems-badge tone="none" css="@(i.Status == "Active" ? "bg-success" : i.Status == "Draft" ? "bg-secondary" : "bg-info")">@i.Status</pems-badge>
                    </pems-flex>
                }
            </ul>
        </pems-content-card>
    </pems-col>

    <pems-col md="6">
        <pems-content-card css="h-100 border-danger">
            <pems-flex justify="between" align="center" css="mb-3">
                <h6 class="mb-0">@Localizer["آخرین NCR ها"]</h6>
                <a asp-action="NcrIndex" class="small">@Localizer["مشاهده همه"]</a>
            </pems-flex>
            @{
                var ncrs = (IEnumerable<PEMS.Domain.Entities.NonConformanceReport>)ViewBag.RecentNCRs;
            }
            <ul class="list-unstyled mb-0">
                @foreach (var n in ncrs)
                {
                    <pems-flex as="li" justify="between" css="border-bottom py-1">
                        <a asp-action="NcrDetails" asp-route-id="@n.NonConformanceReportId">@n.NCRNumber</a>
                        <pems-badge tone="@(n.Status == "Closed" ? "success" : n.Severity == "Critical" ? "danger" : "warning")">@n.Status</pems-badge>
                    </pems-flex>
                }
            </ul>
        </pems-content-card>
    </pems-col>
</pems-row>
