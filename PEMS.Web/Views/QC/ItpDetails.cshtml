@model PEMS.Domain.Entities.InspectionTestPlan
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <div>
        <h5 class="mb-0">@Model.ITPNumber &mdash; @Model.Title</h5>
        <span class="text-muted small">@Model.QCDiscipline?.Name @(Model.Equipment != null ? " | " + Model.Equipment.TagNumber : "")</span>
    </div>
    <pems-flex align="center" gap="2">
        <pems-badge tone="none" css="@(Model.Status == "Active" ? "bg-success" : Model.Status == "Draft" ? "bg-secondary" : "bg-info") fs-6">@Model.Status</pems-badge>
        @if (Model.Status == "Draft")
        {
            <pems-form asp-action="ItpApprove" method="post">
                <input type="hidden" name="id" value="@Model.InspectionTestPlanId" />
                <pems-button tone="success" size="small"><pems-icon name="bi-check-lg" /> Approve &amp; Activate</pems-button>
            </pems-form>
        }
    </pems-flex>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-row>
        <pems-col md="4"><strong>Reference:</strong> @Model.ReferenceCodeStandard</pems-col>
        <pems-col md="4"><strong>Revision:</strong> @Model.Revision</pems-col>
        <pems-col md="4"><strong>Approved:</strong> @(Model.ApprovedDate?.ToString("yyyy-MM-dd") ?? "-")</pems-col>
        @if (Model.ProcurementPackage != null)
        {
            <pems-col md="4" css="mt-2"><strong>@Localizer["Package"]:</strong> <a asp-controller="ProcurementPackage" asp-action="Details" asp-route-id="@Model.ProcurementPackageId">@Model.ProcurementPackage.PackageNumber</a></pems-col>
        }
        @if (Model.Contract != null)
        {
            <pems-col md="4" css="mt-2"><strong>@Localizer["Contract"]:</strong> <a asp-controller="Contract" asp-action="Details" asp-route-id="@Model.ContractId">@Model.Contract.ContractNo</a></pems-col>
        }
    </pems-row>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="mt-2 mb-0 text-muted small">@Model.Description</p>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">Line Items</h6>
    <pems-table kind="enterprise" css="mb-0">
        <pems-table-head>
            <pems-table-row><pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Activity"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Category"]</pems-table-header><pems-table-header>@Localizer["Acceptance Criteria"]</pems-table-header><pems-table-header>@Localizer["Responsible"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Actions"]</pems-table-header></pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var li in Model.LineItems.OrderBy(x => x.SequenceNo))
            {
                <pems-table-row>
                    <pems-table-cell>@li.SequenceNo</pems-table-cell>
                    <pems-table-cell class="small">@li.Activity</pems-table-cell>
                    <pems-table-cell class="small">@li.QCDiscipline?.Name</pems-table-cell>
                    <pems-table-cell>
                        <pems-badge tone="neutral" title="H=Hold, W=Witness, R=Review, S=Surveillance, M=Monitor">@li.InspectionCategory</pems-badge>
                    </pems-table-cell>
                    <pems-table-cell class="small">@li.AcceptanceCriteria</pems-table-cell>
                    <pems-table-cell class="small">@li.ResponsibleParty</pems-table-cell>
                    <pems-table-cell>
                        <pems-badge tone="none" css="@(li.Status == "Passed" ? "bg-success" : li.Status == "Failed" ? "bg-danger" : li.Status == "Notified" ? "bg-info" : "bg-light text-dark")">@li.Status</pems-badge>
                        @if (li.NotifiedDate.HasValue)
                        {
                            <div class="text-muted small">اعلان: @li.NotifiedDate.Value.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    </pems-table-cell>
                    <pems-table-cell><pems-flex dir="column" gap="1">
                        @if (li.InspectionCategory == "H" && li.Status == "Pending")
                        {
                            <pems-form asp-action="ItpNotifyHoldPoint" method="post">
                                <input type="hidden" name="lineItemId" value="@li.ITPLineItemId" />
                                <input type="hidden" name="itpId" value="@Model.InspectionTestPlanId" />
                                <pems-button tone="warning" size="small" css="w-100"><pems-icon name="bi-bell" /> Notify Hold Point</pems-button>
                            </pems-form>
                        }
                        @if (li.Status != "Passed" && li.Status != "Failed")
                        {
                            <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#inspectModal" data-fill-lineitemid="@li.ITPLineItemId" data-fill-activity="@li.Activity">
                                <pems-icon name="bi-clipboard-check" /> Perform Inspection
                            </pems-button>
                        }
                    </pems-flex></pems-table-cell>
                </pems-table-row>

            }
        </pems-table-body>
    </pems-table>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3"><pems-icon name="bi-plus-lg" /> Add Line Item</h6>
    <pems-form asp-action="ItpAddLineItem" method="post">
        <input type="hidden" name="itpId" value="@Model.InspectionTestPlanId" />
        <pems-row gap="3">
            <pems-col md="6"><pems-label css="small">@Localizer["Activity"]</pems-label><pems-input scale="small" name="activity" required /></pems-col>
            <pems-col md="3">
                <pems-label css="small">@Localizer["Discipline"]</pems-label>
                <pems-select scale="small" name="qcDisciplineId" required>
                    @foreach (var d in (IEnumerable<PEMS.Domain.Entities.QCDiscipline>)ViewBag.QCDisciplines)
                    {
                        <option value="@d.QCDisciplineId">@d.Name</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="3">
                <pems-label css="small">@Localizer["Category"]</pems-label>
                <pems-select scale="small" name="inspectionCategory">
                    <option value="H">H - Hold Point</option>
                    <option value="W">W - Witness Point</option>
                    <option value="R">R - Review Only</option>
                    <option value="S">S - Surveillance/Random</option>
                    <option value="M">M - Monitor</option>
                </pems-select>
            </pems-col>
            <pems-col md="6"><pems-label css="small">@Localizer["Acceptance Criteria"]</pems-label><pems-input scale="small" name="acceptanceCriteria" /></pems-col>
            <pems-col md="3"><pems-label css="small">Reference Code</pems-label><pems-input scale="small" name="referenceCodeStandard" /></pems-col>
            <pems-col md="3">
                <pems-label css="small">Responsible Party</pems-label>
                <pems-select scale="small" name="responsibleParty">
                    <option>Contractor</option><option>@Localizer["Client"]</option><option>ThirdParty</option>
                </pems-select>
            </pems-col>
        </pems-row>
        <div class="mt-3">
            <pems-button tone="primary" size="small" type="submit">@Localizer["Add"]</pems-button>
        </div>
    </pems-form>
</pems-content-card>

    <pems-modal id="inspectModal" tabindex="-1">
    <pems-form asp-action="ItpPerformInspection" method="post">
    <input type="hidden" name="lineItemId" value="" />
    <input type="hidden" name="itpId" value="@Model.InspectionTestPlanId" />
    <pems-modal-header>Perform Inspection - <span data-fill-text="activity"></span></pems-modal-header>
    <pems-modal-body>
    <div class="mb-2">
    <pems-label css="small">@Localizer["Result"]</pems-label>
    <pems-select scale="small" name="result" required>
    <option value="Acceptable">Acceptable</option>
    <option value="Reject">@Localizer["Reject"]</option>
    <option value="Warning">@Localizer["Warning"]</option>
    </pems-select>
    </div>
    <div class="mb-2">
    <pems-label css="small">@Localizer["Inspector"]</pems-label>
    <pems-input scale="small" name="inspector" />
    </div>
    <div class="mb-2">
    <pems-label css="small">@Localizer["Notes"]</pems-label>
    <pems-textarea scale="small" name="description" rows="2"></pems-textarea>
    </div>
    </pems-modal-body>
    <pems-modal-footer>
    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
    <pems-button tone="primary" size="small" type="submit">Save Result</pems-button>
    </pems-modal-footer>
    </pems-form>
    </pems-modal>
