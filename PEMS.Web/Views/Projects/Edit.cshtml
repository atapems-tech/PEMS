@model PEMS.Domain.Entities.Project
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card" style="max-width:640px;">
    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="CreatedDate" />
        <input type="hidden" asp-for="IsActive" />

        <div class="row g-3">
            <div class="col-md-6">
                <pems-label>@Localizer["Project Code"]</pems-label>
                <pems-input asp-for="ProjectCode" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Project Name"]</pems-label>
                <pems-input asp-for="ProjectName" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Client"]</pems-label>
                <pems-input asp-for="ClientName" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Location"]</pems-label>
                <pems-input asp-for="Location" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Start Date"]</pems-label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["End Date"]</pems-label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Status"]</pems-label>
                <pems-select asp-for="Status">
                    <option>@Localizer["Planning"]</option>
                    <option>@Localizer["Active"]</option>
                    <option>@Localizer["Completed"]</option>
                    <option>@Localizer["Cancelled"]</option>
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>Plant Code <span class="text-muted small">(e.g. J - VDR document numbering)</span></pems-label>
                <pems-input asp-for="PlantCode" />
            </div>
            <div class="col-md-6">
                <pems-label>Unit Code <span class="text-muted small">(e.g. 85 - transmittal/VDR numbering)</span></pems-label>
                <pems-input asp-for="UnitCode" />
            </div>
            <div class="col-md-6">
                <pems-label>Job Number <span class="text-muted small">(e.g. 3863 - Vendor-format VDR numbering)</span></pems-label>
                <pems-input asp-for="JobNumber" />
            </div>
        </div>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
