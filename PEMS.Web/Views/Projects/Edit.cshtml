@model PEMS.Domain.Entities.Project
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card" style="max-width:640px;">
    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="CreatedDate" />
        <input type="hidden" asp-for="IsActive" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project Code"]</label>
                <input asp-for="ProjectCode" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project Name"]</label>
                <input asp-for="ProjectName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Client"]</label>
                <input asp-for="ClientName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Location"]</label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Start Date"]</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["End Date"]</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Status"]</label>
                <select asp-for="Status" class="form-select">
                    <option>@Localizer["Planning"]</option>
                    <option>@Localizer["Active"]</option>
                    <option>@Localizer["Completed"]</option>
                    <option>@Localizer["Cancelled"]</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Plant Code <span class="text-muted small">(e.g. J - VDR document numbering)</span></label>
                <input asp-for="PlantCode" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Unit Code <span class="text-muted small">(e.g. 85 - transmittal/VDR numbering)</span></label>
                <input asp-for="UnitCode" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Job Number <span class="text-muted small">(e.g. 3863 - Vendor-format VDR numbering)</span></label>
                <input asp-for="JobNumber" class="form-control" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
