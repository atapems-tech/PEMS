@model PEMS.Domain.Entities.Project
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card pems-s-e2b01b0d">
    <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></pems-alert>

    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="6">
                <pems-label>@Localizer["Project Code"]</pems-label>
                <pems-input asp-for="ProjectCode" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Project Name"]</pems-label>
                <pems-input asp-for="ProjectName" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Client"]</pems-label>
                <pems-input asp-for="ClientName" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Location"]</pems-label>
                <pems-input asp-for="Location" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Start Date"]</pems-label>
                <pems-date asp-for="StartDate" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["End Date"]</pems-label>
                <pems-date asp-for="EndDate" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Status"]</pems-label>
                <pems-select asp-for="Status">
                    <option>@Localizer["Planning"]</option>
                    <option>@Localizer["Active"]</option>
                    <option>@Localizer["Completed"]</option>
                    <option>@Localizer["Cancelled"]</option>
                </pems-select>
            </pems-col>
        </pems-row>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
