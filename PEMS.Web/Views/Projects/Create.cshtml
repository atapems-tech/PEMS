@model PEMS.Domain.Entities.Project

<div class="content-card" style="max-width:640px;">
    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Project Code</label>
                <input asp-for="ProjectCode" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Project Name</label>
                <input asp-for="ProjectName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Client</label>
                <input asp-for="ClientName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option>Planning</option>
                    <option>Active</option>
                    <option>Completed</option>
                    <option>Cancelled</option>
                </select>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
