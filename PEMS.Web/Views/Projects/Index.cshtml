@model List<PEMS.Application.DTOs.ProjectDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the whole list is on the page, so the search filters its rows live (live-filter) and "New Project" opens the existing modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Projects"]" total="@Model.Count">
            <pems-list-search id="projectSearchForm" action="@Url.Action("Index")" input-id="projectSearch" name="search" placeholder="Search projects..." live-filter="true" />
            <pems-list-tools search-for="projectSearchForm">
                <pems-list-new modal="createProjectModal" text="@Localizer["New Project"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No projects yet."]">
                <thead>
                    <tr>
                        <th>@Localizer["Code"]</th>
                        <th>@Localizer["Project Name"]</th>
                        <th>@Localizer["Client"]</th>
                        <th>@Localizer["Location"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Documents"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var tone = p.Status switch { "Active" => "success", "Completed" => "info", "Cancelled" => "danger", _ => "neutral" };
                        <tr class="lp-row">
                            <td class="lp-no">@p.ProjectCode</td>
                            <td>@p.ProjectName</td>
                            <td>@p.ClientName</td>
                            <td>@p.Location</td>
                            <td>
                                <pems-badge tone="@tone">@p.Status</pems-badge>
                                @if (!p.IsActive)
                                {
                                    <pems-badge tone="dark">Inactive</pems-badge>
                                }
                            </td>
                            <td>
                                <a asp-controller="EngineeringDocuments" asp-action="Index" class="text-decoration-none">
                                    @p.DocumentsCount
                                </a>
                            </td>
                            <td class="text-end">
                                <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Edit" asp-route-id="@p.ProjectId">
                                    <i class="bi bi-pencil"></i>
                                </pems-button>
                                <form asp-action="ToggleActive" asp-route-id="@p.ProjectId" method="post" class="d-inline">
                                    <pems-button tone="warning" size="small" outline="true" title="Activate/Deactivate">
                                        <i class="bi bi-power"></i>
                                    </pems-button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createProjectModal" tabindex="-1">
            <form asp-controller="Projects" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Project"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><pems-label>@Localizer["Project Code"]</pems-label><pems-input name="ProjectCode" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Project Name"]</pems-label><pems-input name="ProjectName" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Client"]</pems-label><pems-input name="ClientName" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Location"]</pems-label><pems-input name="Location" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Start Date"]</pems-label><input name="StartDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["End Date"]</pems-label><input name="EndDate" type="date" class="form-control" /></div>
                        <div class="col-md-6">
                            <pems-label>@Localizer["Status"]</pems-label>
                            <pems-select name="Status">
                                <option>@Localizer["Planning"]</option><option>@Localizer["Active"]</option><option>@Localizer["Completed"]</option><option>@Localizer["Cancelled"]</option>
                            </pems-select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </pems-modal>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
