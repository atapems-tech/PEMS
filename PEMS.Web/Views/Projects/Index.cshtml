@model List<PEMS.Application.DTOs.ProjectDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<div class="content-card">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width:280px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" id="projectSearch" class="form-control" placeholder="Search projects..." />
        </div>

        <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#createProjectModal">
            <i class="bi bi-plus-lg"></i> @Localizer["New Project"]
        </pems-button>
    </div>

    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise" id="projectsTable">
            <thead>
                <tr>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["Project Name"]</th>
                    <th>@Localizer["Client"]</th>
                    <th>@Localizer["Location"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Documents"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.ProjectCode</td>
                        <td>@p.ProjectName</td>
                        <td>@p.ClientName</td>
                        <td>@p.Location</td>
                        <td>
                            @{
                                var badge = p.Status switch
                                {
                                    "Active" => "bg-success",
                                    "Completed" => "bg-primary",
                                    "Cancelled" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badge">@p.Status</span>
                            @if (!p.IsActive)
                            {
                                <pems-badge tone="dark">Inactive</pems-badge>
                            }
                        </td>
                        <td>
                            <a asp-controller="EngineeringDocuments" asp-action="Index" class="text-decoration-none">
                                @p.DocumentsCount
                            </a>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="ToggleActive" asp-route-id="@p.ProjectId" method="post" class="d-inline">
                                <pems-button tone="warning" size="small" outline="true" title="Activate/Deactivate">
                                    <i class="bi bi-power"></i>
                                </pems-button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="createProjectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Projects" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Project"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">@Localizer["Project Code"]</label><input name="ProjectCode" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Project Name"]</label><input name="ProjectName" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Client"]</label><input name="ClientName" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Location"]</label><input name="Location" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Start Date"]</label><input name="StartDate" type="date" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["End Date"]</label><input name="EndDate" type="date" class="form-control" /></div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Status"]</label>
                            <select name="Status" class="form-select">
                                <option>@Localizer["Planning"]</option><option>@Localizer["Active"]</option><option>@Localizer["Completed"]</option><option>@Localizer["Cancelled"]</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('projectSearch').addEventListener('input', function () {
            var val = this.value.toLowerCase();
            document.querySelectorAll('#projectsTable tbody tr').forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    </script>
}
