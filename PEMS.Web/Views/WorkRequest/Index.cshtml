@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.WorkRequestListDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard-plus"></i> Work Requests</h5>
    <a asp-action="Create" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New Request</a>
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 بند P0-05: مسیر رسمی قبل از ساخت WorkOrder اجرایی -
    Draft → Submitted → UnderReview → Approved → Planned → WorkOrder.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="btn-group btn-group-sm flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == null ? "active" : "")">All</a>
        @foreach (var s in new[] { "Draft", "Submitted", "UnderReview", "Approved", "Planned", "Converted", "Rejected", "Cancelled" })
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == s ? "active" : "")">@s</a>
        }
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('WorkRequest')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="WorkRequest">
        <thead>
            <tr>
                <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200">Number</th>
                <th data-col-key="title" data-resizable="true" data-min-width="160" data-max-width="400">Title</th>
                <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220">Equipment</th>
                <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140">Priority</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180">Status</th>
                <th data-col-key="requestedBy" data-resizable="true" data-min-width="120" data-max-width="260">Requested By</th>
                <th data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wr in Model.Items)
            {
                var badgeClass = wr.Status switch
                {
                    "Converted" => "bg-success",
                    "Rejected" or "Cancelled" => "bg-secondary",
                    "Approved" or "Planned" => "bg-info text-dark",
                    _ => "bg-primary"
                };
                <tr>
                    <td class="small fw-bold"><a asp-action="Details" asp-route-id="@wr.WorkRequestId">@wr.RequestNumber</a></td>
                    <td class="small">@wr.Title</td>
                    <td class="small">@(wr.EquipmentTagNumber ?? "-")</td>
                    <td class="small">@wr.Priority</td>
                    <td><span class="badge @badgeClass">@wr.Status</span></td>
                    <td class="small">@wr.RequestedByName</td>
                    <td class="small">@wr.RequestedDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز Work Request ای ثبت نشده.</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "WorkRequest",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('WorkRequest');
        });
    </script>
}
