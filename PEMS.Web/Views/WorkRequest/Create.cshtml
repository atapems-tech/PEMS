@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var functionalLocations = (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.FunctionalLocations;
}

<pems-content-card css="pems-s-bcaa1805">
    <form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col span="12"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" placeholder="e.g. Pump P-101 unusual vibration" required /></pems-col>

            <pems-col span="12">
                <pems-label>@Localizer["Equipment"] <span class="text-muted small">(@Localizer["Equipment, Asset or Functional Location is required"])</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی تگ، نام..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#wrEquipmentIdHidden" autocomplete="off" value="@ViewBag.PrefillEquipmentText" />
                <input type="hidden" name="equipmentId" id="wrEquipmentIdHidden" value="@ViewBag.PrefillEquipmentId" />
                <div class="form-text small">@Localizer["At least one of Equipment or Functional Location is required. If the problem is not tied to one equipment, leave this empty and choose a Functional Location."]</div>
            </pems-col>

            <pems-col span="12">
                <pems-label>@Localizer["Functional Location"]</pems-label>
                <pems-select name="functionalLocationId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var fl in functionalLocations)
                    {
                        <option value="@fl.FunctionalLocationId">@fl.PathBreadcrumb</option>
                    }
                </pems-select>
            </pems-col>

            <pems-col span="12"><pems-label>Reported Condition</pems-label><pems-textarea name="reportedCondition" rows="2" placeholder="@Localizer["آنچه واقعاً دیده/شنیده/اندازه‌گیری شده"]"></pems-textarea></pems-col>

            <pems-col md="6">
                <pems-label>@Localizer["Priority"]</pems-label>
                <pems-select name="priority">
                    <option value="Low">@Localizer["Low"]</option>
                    <option value="Medium" selected>@Localizer["Medium"]</option>
                    <option value="High">@Localizer["High"]</option>
                    <option value="Critical">@Localizer["Critical"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>Suggested Discipline (optional)</pems-label>
                <pems-select name="suggestedDisciplineId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </pems-col>

            <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></pems-col>

            <pems-col span="12"><hr class="my-1" /><h6 class="mb-0">@Localizer["Risk and HSE"]</h6>
                <div class="form-text small">@Localizer["Priority is derived: the final priority is never lower than the declared priority or the risk matrix result; HSE-related requests are at least High; emergencies are always Critical."]</div></pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Likelihood (1-5)"]</pems-label>
                <pems-select name="riskLikelihood"><option value="">--</option>@for (var i = 1; i <= 5; i++) { <option value="@i">@i</option> }</pems-select>
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Severity (1-5)"]</pems-label>
                <pems-select name="riskSeverity"><option value="">--</option>@for (var i = 1; i <= 5; i++) { <option value="@i">@i</option> }</pems-select>
            </pems-col>
            <pems-col md="3" css="d-flex align-items-end"><div class="form-check"><pems-input kind="check" type="checkbox" name="isHseRelated" value="true" id="wrHse" /><label class="form-check-label" for="wrHse">@Localizer["HSE related"]</label></div></pems-col>
            <pems-col md="3" css="d-flex align-items-end"><div class="form-check"><pems-input kind="check" type="checkbox" name="isEmergency" value="true" id="wrEmergency" /><label class="form-check-label text-danger" for="wrEmergency">@Localizer["Emergency"]</label></div></pems-col>

            <pems-col span="12"><hr class="my-1" /><h6 class="mb-0">@Localizer["Reported failure (ISO 14224)"]</h6></pems-col>
            <pems-col md="5">
                <pems-label>@Localizer["Failure Mode"]</pems-label>
                <pems-select name="failureModeId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var fm in (IEnumerable<dynamic>)ViewBag.FailureModes) { <option value="@fm.FailureModeId">@fm.Label</option> }
                </pems-select>
            </pems-col>
            <pems-col md="5"><pems-label>@Localizer["Failure Effect"]</pems-label><pems-input name="failureEffect" maxlength="500" /></pems-col>
            <pems-col md="2"><pems-label>@Localizer["Downtime Hours"]</pems-label><pems-input name="reportedDowntimeHours" type="number" min="0" step="0.1" /></pems-col>
        </pems-row>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">Submit Request</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</pems-content-card>
