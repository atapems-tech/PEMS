@model PEMS.Application.DTOs.WorkRequestDetailDto
@{
    var nextStatus = (string?)ViewBag.NextStatus;
    string NA(string? v) => string.IsNullOrWhiteSpace(v) ? "N/A" : v;

    var badgeClass = Model.Status switch
    {
        "Converted" => "bg-success",
        "Rejected" or "Cancelled" => "bg-secondary",
        "Approved" or "Planned" => "bg-info text-dark",
        _ => "bg-primary"
    };
}

<div class="content-card mb-3">
    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
        <div class="kpi-icon bg-icon-blue" style="width:56px;height:56px;font-size:26px;"><i class="bi bi-clipboard-plus"></i></div>
        <div>
            <h5 class="mb-0">@Model.RequestNumber &mdash; @Model.Title <span class="badge @badgeClass">@Model.Status</span></h5>
            <span class="text-muted small">Requested by @Model.RequestedByName on @Model.RequestedDate.ToString("yyyy-MM-dd")</span>
        </div>
    </div>
    <div class="row g-2 small mt-1">
        <div class="col-md-3"><strong>Equipment:</strong> @(Model.EquipmentTagNumber ?? "N/A")</div>
        <div class="col-md-3"><strong>Asset:</strong> @(Model.AssetNumber ?? "N/A")</div>
        <div class="col-md-3"><strong>Functional Location:</strong> @(Model.FunctionalLocationBreadcrumb ?? "N/A")</div>
        <div class="col-md-3">
            <strong>Priority:</strong> @Model.Priority
            @if (!string.IsNullOrWhiteSpace(Model.EquipmentCriticalityClass))
            {
                <span class="badge bg-light text-dark border" title="Equipment Criticality (context only, not auto-applied)">Crit: @Model.EquipmentCriticalityClass</span>
            }
        </div>
    </div>
    <div class="row g-2 small mt-1">
        <div class="col-md-6"><strong>Reported Condition:</strong> @NA(Model.ReportedCondition)</div>
        <div class="col-md-6"><strong>Suggested Discipline:</strong> @(Model.SuggestedDisciplineName ?? "N/A")</div>
    </div>
    <div class="row g-2 small mt-1">
        <div class="col-12"><strong>Description:</strong> @NA(Model.Description)</div>
    </div>

    @if (Model.Status == "Rejected")
    {
        <div class="alert alert-danger py-2 px-3 small mt-2 mb-0"><strong>Rejection Reason:</strong> @Model.RejectionReason</div>
    }
    @if (Model.LinkedWorkOrderId.HasValue)
    {
        <div class="alert alert-success py-2 px-3 small mt-2 mb-0">
            Converted to <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@Model.LinkedWorkOrderId">@Model.LinkedWorkOrderNumber</a>
        </div>
    }
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <h6 class="mb-3">Actions</h6>
    <div class="d-flex flex-wrap gap-2">
        @if (nextStatus != null)
        {
            <form asp-action="AdvanceStatus" method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.WorkRequestId" />
                <button type="submit" class="btn btn-sm btn-pems-solid">Advance to @nextStatus</button>
            </form>
        }
        @if (Model.Status == "Planned")
        {
            <form asp-action="ConvertToWorkOrder" method="post" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="id" value="@Model.WorkRequestId" />
                <select name="workOrderType" class="form-select form-select-sm" style="width:auto;">
                    <option value="Corrective">Corrective</option>
                    <option value="Preventive">Preventive</option>
                    <option value="Emergency">Emergency</option>
                    <option value="Predictive">Predictive</option>
                </select>
                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('یک WorkOrder واقعی ساخته می‌شود. ادامه؟');">
                    <i class="bi bi-arrow-right-circle"></i> Convert to WorkOrder
                </button>
            </form>
        }
        @if (Model.Status is "UnderReview" or "Approved")
        {
            <form asp-action="Reject" method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.WorkRequestId" />
                <input type="text" name="reason" class="form-control form-control-sm" placeholder="Rejection reason" style="width:220px;" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
            </form>
        }
        @if (Model.Status is "Draft" or "Submitted" or "UnderReview" or "Approved" or "Planned")
        {
            <form asp-action="Cancel" method="post">
                <input type="hidden" name="id" value="@Model.WorkRequestId" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این درخواست لغو شود؟');">Cancel Request</button>
            </form>
        }
        @if (nextStatus == null && Model.Status != "Planned" && Model.Status is not ("Rejected" or "Cancelled" or "Converted"))
        {
            <span class="text-muted small">No further actions available.</span>
        }
    </div>
</div>

<div class="content-card">
    <h6 class="mb-3">Status History</h6>
    <table class="table table-enterprise table-sm mb-0">
        <thead><tr><th>From</th><th>To</th><th>By</th><th>Date</th><th>Reason</th></tr></thead>
        <tbody>
            @foreach (var h in Model.StatusHistory)
            {
                <tr>
                    <td class="small">@h.FromStatus</td>
                    <td class="small">@h.ToStatus</td>
                    <td class="small">@(h.ChangedByName ?? "-")</td>
                    <td class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small text-muted">@h.Reason</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.StatusHistory.Any()) { <p class="text-muted text-center py-3 mb-0">هنوز تغییر وضعیتی ثبت نشده.</p> }
</div>
