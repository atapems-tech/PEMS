@model IEnumerable<PEMS.Domain.Entities.Tender>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="table-scroll-area">
        <table class="table table-enterprise pems-grid-table">
            <thead>
                <tr>
                    <th>@Localizer["Tender No"]</th>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Package"]</th>
                    <th>@Localizer["Status"]</th>
                    <th>@Localizer["Deadline"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TenderNumber</td>
                        <td>@t.Title</td>
                        <td>@t.ProcurementPackage?.PackageNumber</td>
                        <td><pems-badge tone="info">@t.Status</pems-badge></td>
                        <td>@t.ResponseDeadline?.ToString("yyyy-MM-dd")</td>
                        <td><pems-button tone="primary" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@t.TenderId">@Localizer["Details"]</pems-button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
