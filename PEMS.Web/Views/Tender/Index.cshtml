@model IEnumerable<PEMS.Domain.Entities.Tender>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var rows = Model.ToList();
    var packageId = ViewBag.ProcurementPackageId as int?;
    var packageNo = packageId.HasValue ? rows.Select(t => t.ProcurementPackage?.PackageNumber).FirstOrDefault(n => !string.IsNullOrEmpty(n)) ?? packageId.ToString() : null;
    string StatusText(string? s) => VdrUi.Loc(Localizer, "Tn_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Awarded" => "vs-pill--success",
        "Open" => "vs-pill--info",
        "Closed" => "vs-pill--warning",
        "Cancelled" => "vs-pill--danger",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component. Opened from a procurement package, the list is filtered to it
   and the package is a chip that removes the filter. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Tn_Title"]" heading-title="@Localizer["Tn_Hint"]" total="@rows.Count">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="Tender" />
                @if (packageId.HasValue)
                {
                    <pems-list-new href="@Url.Action("Create", new { procurementPackageId = packageId })" text="@Localizer["Tn_New"]" />
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (packageNo != null)
            {
                <pems-list-chip label="@Localizer["Tn_Package"]" value="@packageNo" remove-href="@Url.Action("Index")" />
            }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Tender" empty="@(!rows.Any())" empty-text="@Localizer["Tn_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="no" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Tn_No"]</pems-table-header>
                        <pems-table-header data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="600">@Localizer["Tn_TitleCol"]</pems-table-header>
                        <pems-table-header data-col-key="package" data-resizable="true" data-min-width="100" data-max-width="220" class="vs-hide-md pems-w-150">@Localizer["Tn_Package"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-120" data-col-key="deadline" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Tn_Deadline"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var t in rows)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@t.TenderId" class="lp-subject" title="@t.TenderNumber">@t.TenderNumber</a></pems-table-cell>
                            <pems-table-cell><span class="vs-title-cell" title="@t.Title">@t.Title</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-num">@t.ProcurementPackage?.PackageNumber</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(t.Status)">@StatusText(t.Status)</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@(t.ResponseDeadline?.ToString("yyyy-MM-dd") ?? "-")</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <a asp-action="Details" asp-route-id="@t.TenderId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><pems-icon name="bi-eye" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
