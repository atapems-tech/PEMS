@model PEMS.Domain.Entities.Tender
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var clarifications = (IEnumerable<PEMS.Domain.Entities.ProcurementCommunication>)(ViewBag.Clarifications ?? Array.Empty<PEMS.Domain.Entities.ProcurementCommunication>());
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger">@TempData["Error"]</pems-alert>
}

<div class="content-card">
    <pems-info-grid>
        <pems-info-item label="@Localizer["Tender No"]" num>@Model.TenderNumber</pems-info-item>
        <pems-info-item label="@Localizer["Title"]">@Model.Title</pems-info-item>
        <pems-info-item label="@Localizer["Package"]" num>@Model.ProcurementPackage?.PackageNumber</pems-info-item>
        <pems-info-item label="@Localizer["Status"]"><pems-badge tone="info">@Model.Status</pems-badge></pems-info-item>
        <pems-info-item label="@Localizer["Deadline"]" num>@Model.ResponseDeadline?.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Requires Vendor Qualification"]">@(Model.RequiresVendorQualification ? Localizer["Yes"] : Localizer["No"])</pems-info-item>
        @if (Model.AwardedBid != null)
        {
            <pems-info-item label="@Localizer["Awarded To"]" wide>@Model.AwardedBid.Vendor?.Name — <span dir="ltr">@Model.AwardedBid.FinalValue?.ToString("N0") @Model.AwardedBid.Currency</span></pems-info-item>
        }
    </pems-info-grid>

    <hr />
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Status == "Draft")
        {
            <form asp-action="OpenForBidding" method="post" class="d-inline">
                <input type="hidden" name="tenderId" value="@Model.TenderId" />
                <pems-button tone="primary" size="small" type="submit">@Localizer["Open for Bidding"]</pems-button>
            </form>
        }
        @if (Model.Status == "Open")
        {
            <form asp-action="CloseBidding" method="post" class="d-inline">
                <input type="hidden" name="tenderId" value="@Model.TenderId" />
                <pems-button tone="warning" size="small" type="submit">@Localizer["Close Bidding"]</pems-button>
            </form>
        }
        @if (Model.Status == "Awarded" && Model.ContractId == null)
        {
            <form asp-action="CreateContract" method="post" class="d-flex gap-1 align-items-center">
                <input type="hidden" name="tenderId" value="@Model.TenderId" />
                @await Component.InvokeAsync("DocumentNumberField", new { documentType = "Contract", name = "contractNo", label = Localizer["Contract No"].Value, inputCss = "form-control form-control-sm w-auto", compact = true })
                <pems-button tone="success" size="small" type="submit">@Localizer["Create Contract Draft"]</pems-button>
            </form>
        }
        @if (Model.ContractId != null)
        {
            <pems-button tone="success" size="small" outline="true" as="a" asp-controller="Contract" asp-action="Details" asp-route-id="@Model.ContractId">@Localizer["View Contract"]</pems-button>
        }
    </div>
</div>

@if (Model.Status == "Draft" || Model.Status == "Issued")
{
    <pems-related-list id="tenderVendors" icon="bi-people" title="@Localizer["Invited Vendors"]" count="@Model.InvitedVendors.Count" empty="@(!Model.InvitedVendors.Any())" empty-text="@Localizer["TnD_NoVendors"]">
        <pems-related-table>
            <thead><tr><th>@Localizer["Vendor"]</th><th>@Localizer["Qualification Confirmed"]</th></tr></thead>
            <tbody>
                @foreach (var v in Model.InvitedVendors)
                {
                    <tr><td>@v.Vendor?.Name</td><td>@(v.QualificationConfirmed ? Localizer["Yes"] : Localizer["No"])</td></tr>
                }
            </tbody>
        </pems-related-table>
        <pems-related-add action="@Url.Action("InviteVendor")" parent-name="tenderId" parent-value="@Model.TenderId.ToString()" submit-label="@Localizer["Invite Vendor"]">
            <pems-list-filter-select id="tenderInviteVendor" name="vendorId" label="@Localizer["Vendor"]" items="@(((IEnumerable<dynamic>)vendors).Select(v => new SelectListItem((string)v.Name, ((int)v.VendorId).ToString())))" />
        </pems-related-add>
    </pems-related-list>
}

@* SCRUM-429: invitations by the organisation's email and their send log *@
@{
    var invitationLog = (IReadOnlyList<PEMS.Application.Interfaces.TenderInvitationDispatchDto>)(ViewBag.InvitationLog ?? Array.Empty<PEMS.Application.Interfaces.TenderInvitationDispatchDto>());
    var emailEnabled = ViewBag.EmailEnabled is true;
    var statusAllowsSend = Model.Status == "Draft" || Model.Status == "Open";
    var mayEditTender = ViewBag.CanSendInvitations is true;   // Tender Edit; without it the page shows only the log
    var canSend = mayEditTender && statusAllowsSend;
}
@if (Model.InvitedVendors.Any(v => v.IsActive) || invitationLog.Count > 0)
{
    <pems-related-list id="tenderInvitations" icon="bi-envelope-paper" title="@Localizer["Tinv_Title"]" count="@invitationLog.Count">
        @if (canSend && emailEnabled)
        {
            <form asp-action="SendInvitations" method="post" class="px-3 pt-2">
                <input type="hidden" name="tenderId" value="@Model.TenderId" />
                <pems-button tone="primary" size="small" type="submit"><i class="bi bi-envelope-paper" aria-hidden="true"></i> @Localizer["Tinv_SendAll"]</pems-button>
            </form>
        }
        @if (!emailEnabled)
        {
            <pems-alert tone="secondary" css="py-2 m-2"><i class="bi bi-info-circle"></i> @Localizer["Tinv_EmailOffHint"]</pems-alert>
        }
        else if (mayEditTender && !statusAllowsSend)
        {
            <p class="lp-rel-empty">@Localizer["Tinv_StatusHint"]</p>
        }
        else if (canSend)
        {
            <p class="lp-rel-empty">@Localizer["Tinv_Hint"]</p>
        }

        @if (invitationLog.Count > 0)
        {
            <pems-related-table>
                    <thead>
                        <tr>
                            <th>@Localizer["Vendor"]</th><th>@Localizer["Tinv_To"]</th><th>@Localizer["Status"]</th><th>@Localizer["Tinv_Attempts"]</th>
                            <th>@Localizer["Tinv_QueuedBy"]</th><th>@Localizer["Tinv_SentAt"]</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in invitationLog)
                        {
                            var pill = d.Status switch { "Sent" => "vs-pill--success", "Failed" => "vs-pill--danger", "Skipped" => "vs-pill--warning", _ => "vs-pill--info" };
                            <tr>
                                <td>@d.VendorName</td>
                                <td dir="ltr">@(string.IsNullOrEmpty(d.ToAddress) ? "-" : d.ToAddress)</td>
                                <td>
                                    <span class="vs-pill @pill">@Localizer["Tinv_Status_" + d.Status]</span>
                                    @if (!string.IsNullOrEmpty(d.LastError))
                                    {
                                        <div class="small text-muted">@(d.LastError.StartsWith("Tinv_") ? Localizer[d.LastError].Value : d.LastError)</div>
                                    }
                                </td>
                                <td>@d.Attempts</td>
                                <td>@d.QueuedBy<div class="small text-muted">@d.QueuedAt.ToString("yyyy-MM-dd HH:mm")</div></td>
                                <td>@(d.SentAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td>
                                    @if (canSend && emailEnabled && d.Status is "Failed" or "Skipped")
                                    {
                                        <form asp-action="SendInvitations" method="post" class="d-inline">
                                            <input type="hidden" name="tenderId" value="@Model.TenderId" />
                                            <input type="hidden" name="vendorIds" value="@d.VendorId" />
                                            <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Tinv_Resend"]</pems-button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
            </pems-related-table>
        }
    </pems-related-list>
}

<pems-related-list id="tenderBids" icon="bi-cash-stack" title="@Localizer["Bids"]" count="@Model.Bids.Count" empty="@(!Model.Bids.Any())" empty-text="@Localizer["TnD_NoBids"]">
    @foreach (var bid in Model.Bids)
    {
        var technicalPassed = bid.Evaluations.Any(e => e.EvaluationType == "Technical" && e.Decision == "Passed");
        var commercialPassed = bid.Evaluations.Any(e => e.EvaluationType == "Commercial" && e.Decision == "Passed");
        <div class="border-bottom px-3 py-2">
            <div class="d-flex justify-content-between flex-wrap">
                <div>
                    <strong>@bid.Vendor?.Name</strong> — @bid.BidNumber
                    <pems-badge tone="neutral">@bid.Status</pems-badge>
                </div>
                <div>
                    @Localizer["Original"]: @bid.OriginalValue?.ToString("N0") @bid.Currency
                    @if (bid.NegotiatedValue.HasValue)
                    {
                        <text> | @Localizer["Negotiated"]: @bid.NegotiatedValue?.ToString("N0")</text>
                    }
                </div>
            </div>
            <div class="mt-2 d-flex gap-3 flex-wrap">
                <pems-badge tone="@(technicalPassed ? "success" : "neutral")">@Localizer["Technical"]: @(technicalPassed ? Localizer["Passed"] : Localizer["Pending"])</pems-badge>
                <pems-badge tone="@(commercialPassed ? "success" : "neutral")">@Localizer["Commercial"]: @(commercialPassed ? Localizer["Passed"] : Localizer["Pending"])</pems-badge>
            </div>

            @if (Model.Status == "Closed" || Model.Status == "Open")
            {
                <form asp-action="RecordEvaluation" method="post" class="d-flex gap-1 mt-2 flex-wrap align-items-center">
                    <input type="hidden" name="tenderId" value="@Model.TenderId" />
                    <input type="hidden" name="bidId" value="@bid.BidId" />
                    <select name="evaluationType" class="form-select form-select-sm" style="width:130px">
                        <option value="Technical">@Localizer["Technical"]</option>
                        <option value="Commercial">@Localizer["Commercial"]</option>
                    </select>
                    <select name="decision" class="form-select form-select-sm" style="width:110px">
                        <option value="Passed">@Localizer["Passed"]</option>
                        <option value="Failed">@Localizer["Failed"]</option>
                    </select>
                    <input type="text" name="comment" class="form-control form-control-sm" placeholder="@Localizer["Comment"]" style="width:180px" />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Record Evaluation"]</pems-button>
                </form>
            }

            @if (Model.Status == "Closed")
            {
                <form asp-action="RequestNegotiation" method="post" class="d-flex gap-1 mt-2 flex-wrap align-items-center">
                    <input type="hidden" name="tenderId" value="@Model.TenderId" />
                    <input type="hidden" name="bidId" value="@bid.BidId" />
                    <input type="number" step="0.01" name="negotiatedValue" class="form-control form-control-sm" placeholder="@Localizer["New value"]" style="width:130px" required />
                    <input type="text" name="justification" class="form-control form-control-sm" placeholder="@Localizer["Justification"]" style="width:180px" />
                    <pems-button tone="warning" size="small" outline="true" type="submit">@Localizer["Propose Negotiation"]</pems-button>
                </form>

                @if (bid.Negotiations.Any(n => n.Status == "Proposed"))
                {
                    var pending = bid.Negotiations.First(n => n.Status == "Proposed");
                    <form asp-action="ApproveNegotiation" method="post" class="d-inline mt-1">
                        <input type="hidden" name="tenderId" value="@Model.TenderId" />
                        <input type="hidden" name="bidNegotiationId" value="@pending.BidNegotiationId" />
                        <pems-button tone="success" size="small" type="submit">@Localizer["Approve Negotiation"] (@pending.NegotiatedValue?.ToString("N0"))</pems-button>
                    </form>
                }

                @if (Model.Status == "Closed" && technicalPassed && commercialPassed)
                {
                    <form asp-action="SelectWinner" method="post" class="d-inline mt-1">
                        <input type="hidden" name="tenderId" value="@Model.TenderId" />
                        <input type="hidden" name="bidId" value="@bid.BidId" />
                        <pems-button tone="success" size="small" type="submit">@Localizer["Select as Winner"]</pems-button>
                    </form>
                }
            }
        </div>
    }

    @if (Model.Status == "Open")
    {
        <form asp-action="SubmitBid" method="post" class="row g-2 m-0 px-2 py-2 lp-rel-add">
            <input type="hidden" name="tenderId" value="@Model.TenderId" />
            <div class="col-md-3">
                <select name="vendorId" class="form-select form-select-sm" required>
                    @foreach (var v in Model.InvitedVendors) { <option value="@v.VendorId">@v.Vendor?.Name</option> }
                </select>
            </div>
            <div class="col-md-2"><input type="number" step="0.01" name="originalValue" class="form-control form-control-sm" placeholder="@Localizer["Value"]" required /></div>
            <div class="col-md-2"><input type="text" name="currency" class="form-control form-control-sm" value="USD" /></div>
            <div class="col-md-2"><input type="text" name="technicalSubmissionReference" class="form-control form-control-sm" placeholder="@Localizer["Technical"]" /></div>
            <div class="col-md-2"><input type="text" name="commercialSubmissionReference" class="form-control form-control-sm" placeholder="@Localizer["Commercial"]" /></div>
            <div class="col-md-1"><pems-button tone="primary" size="small" type="submit">@Localizer["Submit Bid"]</pems-button></div>
        </form>
    }
</pems-related-list>

<pems-related-list id="tenderClarifications" icon="bi-chat-square-text" title="@Localizer["Clarifications"]" count="@clarifications.Count()" empty="@(!clarifications.Any())" empty-text="@Localizer["TnD_NoClarifications"]">
    @foreach (var c in clarifications)
    {
        <div class="border-bottom px-3 py-2">
            <div class="d-flex justify-content-between flex-wrap">
                <div><pems-badge tone="neutral">@c.Type</pems-badge> <strong>@c.Subject</strong> @(c.Vendor != null ? "— " + c.Vendor.Name : "")</div>
                <pems-badge tone="@(c.ActionStatus == "Answered" ? "success" : "warning")">@c.ActionStatus</pems-badge>
            </div>
            <p class="mb-1 mt-1">@c.Body</p>
            @foreach (var r in c.Responses.OrderBy(r => r.ResponseDate))
            {
                <div class="ps-3 border-start mt-1">
                    <small class="text-muted">@r.ResponseDate.ToString("yyyy-MM-dd") — @r.RespondedByName</small>
                    <div>@r.ResponseText</div>
                </div>
            }
            @if (c.ActionStatus != "Closed")
            {
                <form asp-action="RespondClarification" method="post" class="d-flex gap-1 mt-2">
                    <input type="hidden" name="tenderId" value="@Model.TenderId" />
                    <input type="hidden" name="procurementPackageId" value="@Model.ProcurementPackageId" />
                    <input type="hidden" name="communicationId" value="@c.ProcurementCommunicationId" />
                    <input type="text" name="responseText" class="form-control form-control-sm" placeholder="@Localizer["Response"]" required />
                    <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Respond"]</pems-button>
                </form>
            }
        </div>
    }
    <form asp-action="RaiseClarification" method="post" class="row g-2 m-0 px-2 py-2 lp-rel-add">
        <input type="hidden" name="tenderId" value="@Model.TenderId" />
        <input type="hidden" name="procurementPackageId" value="@Model.ProcurementPackageId" />
        <div class="col-md-2">
            <select name="type" class="form-select form-select-sm">
                <option value="TechnicalClarification">@Localizer["Technical"]</option>
                <option value="CommercialClarification">@Localizer["Commercial"]</option>
                <option value="ContractualClarification">@Localizer["Contractual"]</option>
                <option value="VendorInquiry">@Localizer["General"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="vendorId" class="form-select form-select-sm">
                <option value="">@Localizer["-- None --"]</option>
                @foreach (var v in Model.InvitedVendors) { <option value="@v.VendorId">@v.Vendor?.Name</option> }
            </select>
        </div>
        <div class="col-md-3"><input type="text" name="subject" class="form-control form-control-sm" placeholder="@Localizer["Subject"]" required /></div>
        <div class="col-md-3"><input type="text" name="body" class="form-control form-control-sm" placeholder="@Localizer["Question"]" required /></div>
        <div class="col-md-1"><pems-button tone="primary" size="small" type="submit">@Localizer["Raise"]</pems-button></div>
    </form>
</pems-related-list>
