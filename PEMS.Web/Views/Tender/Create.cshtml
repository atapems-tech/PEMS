@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var packageId = (int)ViewBag.ProcurementPackageId;
}

<pems-content-card css="pems-s-bcaa1805">
    <pems-form asp-action="Create" method="post">
        <input type="hidden" name="procurementPackageId" value="@packageId" />
        <pems-row gap="3">
            <pems-col span="12"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></pems-col>
            <pems-col md="6"><pems-label>@Localizer["Issue Date"]</pems-label><pems-date name="issueDate" /></pems-col>
            <pems-col md="6"><pems-label>@Localizer["Deadline"]</pems-label><pems-date name="responseDeadline" /></pems-col>
            <pems-col span="12" css="form-check">
                <pems-input kind="check" type="checkbox" name="requiresVendorQualification" value="true" id="reqQual" checked />
                <label class="form-check-label" for="reqQual">@Localizer["Requires Vendor Qualification"]</label>
            </pems-col>
            <pems-col span="12"><pems-label>@Localizer["Technical Requirements"]</pems-label><pems-textarea name="technicalRequirements" rows="2"></pems-textarea></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Commercial Requirements"]</pems-label><pems-textarea name="commercialRequirements" rows="2"></pems-textarea></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Inspection Requirements"]</pems-label><pems-textarea name="inspectionRequirements" rows="2"></pems-textarea></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Contractual Requirements"]</pems-label><pems-textarea name="contractualRequirements" rows="2"></pems-textarea></pems-col>
        </pems-row>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index" asp-route-procurementPackageId="@packageId">@Localizer["Cancel"]</pems-button>
        </div>
    </pems-form>
</pems-content-card>
