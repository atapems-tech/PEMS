@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var packageId = (int)ViewBag.ProcurementPackageId;
}

<div class="content-card pems-s-bcaa1805">
    <form asp-action="Create" method="post">
        <input type="hidden" name="procurementPackageId" value="@packageId" />
        <div class="row g-3">
            <div class="col-12"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></div>
            <div class="col-md-6"><pems-label>@Localizer["Issue Date"]</pems-label><pems-date name="issueDate" /></div>
            <div class="col-md-6"><pems-label>@Localizer["Deadline"]</pems-label><pems-date name="responseDeadline" /></div>
            <div class="col-12 form-check">
                <pems-input kind="check" type="checkbox" name="requiresVendorQualification" value="true" id="reqQual" checked />
                <label class="form-check-label" for="reqQual">@Localizer["Requires Vendor Qualification"]</label>
            </div>
            <div class="col-12"><pems-label>@Localizer["Technical Requirements"]</pems-label><pems-textarea name="technicalRequirements" rows="2"></pems-textarea></div>
            <div class="col-12"><pems-label>@Localizer["Commercial Requirements"]</pems-label><pems-textarea name="commercialRequirements" rows="2"></pems-textarea></div>
            <div class="col-12"><pems-label>@Localizer["Inspection Requirements"]</pems-label><pems-textarea name="inspectionRequirements" rows="2"></pems-textarea></div>
            <div class="col-12"><pems-label>@Localizer["Contractual Requirements"]</pems-label><pems-textarea name="contractualRequirements" rows="2"></pems-textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index" asp-route-procurementPackageId="@packageId">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
