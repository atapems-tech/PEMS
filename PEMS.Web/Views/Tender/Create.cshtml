@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var packageId = (int)ViewBag.ProcurementPackageId;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <input type="hidden" name="procurementPackageId" value="@packageId" />
        <div class="row g-3">
            <div class="col-12"><label class="form-label">@Localizer["Title"]</label><input name="title" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Issue Date"]</label><input type="date" name="issueDate" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Deadline"]</label><input type="date" name="responseDeadline" class="form-control" /></div>
            <div class="col-12 form-check">
                <input type="checkbox" name="requiresVendorQualification" value="true" class="form-check-input" id="reqQual" checked />
                <label class="form-check-label" for="reqQual">@Localizer["Requires Vendor Qualification"]</label>
            </div>
            <div class="col-12"><label class="form-label">@Localizer["Technical Requirements"]</label><textarea name="technicalRequirements" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label class="form-label">@Localizer["Commercial Requirements"]</label><textarea name="commercialRequirements" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label class="form-label">@Localizer["Inspection Requirements"]</label><textarea name="inspectionRequirements" class="form-control" rows="2"></textarea></div>
            <div class="col-12"><label class="form-label">@Localizer["Contractual Requirements"]</label><textarea name="contractualRequirements" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index" asp-route-procurementPackageId="@packageId">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
