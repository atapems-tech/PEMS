@model PEMS.Application.DTOs.ProcurementPackageDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Summary;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var unlinkedMRs = (IEnumerable<dynamic>)ViewBag.UnlinkedMRs;
    var tenders = (IEnumerable<PEMS.Domain.Entities.Tender>)(ViewBag.Tenders ?? Array.Empty<PEMS.Domain.Entities.Tender>());
    var stages = new[] { "MR", "VendorInquiry", "TechnicalClarification", "MRQ", "Response", "Approval", "Closeout" };
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@s.PackageNumber &mdash; @s.Title</h5>
            <span class="text-muted small">@s.ProjectName @(s.DisciplineName != null ? " | " + s.DisciplineName : "")</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Relationship" asp-action="ProcurementPackage" asp-route-id="@s.ProcurementPackageId"><i class="bi bi-diagram-3"></i> @Localizer["Cm_Relationships"]</pems-button>
            <pems-badge tone="@(s.Status == "Closed" ? "success" : "warning")" css="fs-6">@s.Status</pems-badge>
        </div>
    </div>

    @* طبق ممیزی نهایی §7: چرخه‌ی Package→Tender→Award→Contract مستقیماً این‌جا دیده می‌شود *@
    @if (tenders.Any())
    {
        <div class="mt-3">
            <div class="small text-muted mb-1">@Localizer["Tenders"]</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var t in tenders)
                {
                    <span class="btn-group">
                        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Details" asp-route-id="@t.TenderId">
                            @t.TenderNumber <pems-badge tone="neutral">@t.Status</pems-badge>
                            @if (t.AwardedBid != null)
                            {
                                <text> — @Localizer["Awarded"]: @t.AwardedBid.Vendor?.Name</text>
                            }
                        </pems-button>
                        @if (t.ContractId != null)
                        {
                            <pems-button tone="success" size="small" outline="true" as="a" asp-controller="Contract" asp-action="Details" asp-route-id="@t.ContractId">
                                <i class="bi bi-arrow-right-short"></i> @Localizer["Contract"]
                            </pems-button>
                        }
                    </span>
                }
            </div>
        </div>
    }
    <div class="mt-2">
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Index" asp-route-procurementPackageId="@s.ProcurementPackageId">@Localizer["Tenders"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Create" asp-route-procurementPackageId="@s.ProcurementPackageId">@Localizer["New Tender"]</pems-button>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-3">
        @foreach (var st in stages.Where(x => x != "Closeout"))
        {
            <form asp-action="AdvanceStage" method="post" class="d-inline">
                <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                <input type="hidden" name="newStage" value="@st" />
                <button type="submit" class="btn btn-sm @(st == s.Stage ? "btn-pems-solid" : "btn-outline-secondary")" @(s.Status == "Closed" || s.Status == "Cancelled" ? "disabled" : "")>@st</button>
            </form>
        }
        @* Closeout فقط از فرم اختصاصی «Closeout Package» (Approve + گیت بازرسی) انجام می‌شود، نه تغییر مرحله‌ی عمومی *@
        @if (s.Stage == "Closeout")
        {
            <span class="btn btn-sm btn-pems-solid disabled">Closeout</span>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3"><i class="bi bi-cart-check"></i> Material Requisitions <pems-badge tone="neutral">@Model.MaterialRequisitions.Count</pems-badge></h6>
            <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>MR No</th><th>@Localizer["Description"]</th><th>@Localizer["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var mr in Model.MaterialRequisitions)
                    {
                        <tr><td><a asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@mr.MRId">@mr.MRNumber</a></td>
                            <td class="small">@mr.Description</td><td><pems-badge tone="neutral">@mr.Status</pems-badge></td></tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.MaterialRequisitions.Any()) { <p class="text-muted small">No MRs linked yet.</p> }

            @if (s.Status != "Closed")
            {
                <form asp-action="LinkMR" method="post" class="d-flex gap-2 mt-2">
                    <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                    <select name="mrId" class="form-select form-select-sm">
                        @foreach (var mr in unlinkedMRs) { <option value="@mr.MRId">@mr.MRNumber</option> }
                    </select>
                    <pems-button tone="primary" size="small" outline="true">Link existing MR</pems-button>
                </form>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3"><i class="bi bi-file-earmark-spreadsheet"></i> Quotations (MRQ) <pems-badge tone="neutral">@Model.Quotations.Count</pems-badge></h6>
            <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["MRQ No"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var q in Model.Quotations)
                    {
                        <tr><td>@q.MRQNumber</td><td>@q.VendorName</td><td><pems-badge tone="neutral">@q.QuotationStatus</pems-badge></td></tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!Model.Quotations.Any()) { <p class="text-muted small">No quotations yet (add via the linked MR's details page).</p> }
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-chat-square-text"></i> Communications &mdash; Vendor Inquiries, Clarifications, Questions, Responses</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Type"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Raised By"]</th><th>@Localizer["Date"]</th><th>@Localizer["Status"]</th><th>@Localizer["Response"]</th></tr></thead>
        <tbody>
            @foreach (var c in Model.Communications)
            {
                <tr>
                    <td><pems-badge tone="neutral">@c.Type</pems-badge></td>
                    <td>@c.Subject<div class="small text-muted">@c.Body</div></td>
                    <td>@c.VendorName</td>
                    <td>@c.RaisedByName</td>
                    <td>@c.RaisedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var ab = c.ActionStatus switch { "Closed" => "bg-success", "Answered" => "bg-info text-dark", _ => "bg-danger" };
                        }
                        <pems-badge tone="none" css="@ab">@c.ActionStatus</pems-badge>
                        <form asp-action="SetCommunicationStatus" method="post" class="d-inline">
                            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                            <input type="hidden" name="communicationId" value="@c.ProcurementCommunicationId" />
                            <select name="actionStatus" class="form-select form-select-sm mt-1" style="width:110px;" onchange="this.form.submit()">
                                @foreach (var opt in new[] { "Open", "Answered", "Closed" })
                                { <option value="@opt" selected="@(opt == c.ActionStatus)">@opt</option> }
                            </select>
                        </form>
                    </td>
                    <td class="small">
                        @c.ResponseText
                        @if (string.IsNullOrEmpty(c.ResponseText))
                        {
                            <form asp-action="RespondCommunication" method="post" class="d-flex gap-1 mt-1">
                                <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                                <input type="hidden" name="communicationId" value="@c.ProcurementCommunicationId" />
                                <input name="responseText" class="form-control form-control-sm" placeholder="@Localizer["Response..."]" />
                                <pems-button tone="primary" size="small" outline="true">@Localizer["Save"]</pems-button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Communications.Any()) { <p class="text-muted">No communications yet.</p> }

    @if (s.Status != "Closed")
    {
        <form asp-action="AddCommunication" method="post" class="row g-2 mt-2">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <div class="col-md-2">
                <select name="type" class="form-select form-select-sm">
                    <option value="VendorInquiry">Vendor Inquiry</option>
                    <option value="TechnicalClarification">Technical Clarification</option>
                    <option value="EngineeringQuestion">Engineering Question</option>
                    <option value="Response">@Localizer["Response"]</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="vendorId" class="form-select form-select-sm">
                    <option value="">-- Vendor --</option>
                    @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                </select>
            </div>
            <div class="col-md-3"><input name="subject" class="form-control form-control-sm" placeholder="@Localizer["Subject"]" required /></div>
            <div class="col-md-4"><input name="body" class="form-control form-control-sm" placeholder="@Localizer["Details"]" required /></div>
            <div class="col-md-1"><pems-button tone="primary" size="small" css="w-100"><i class="bi bi-plus-lg"></i></pems-button></div>
        </form>
    }
</div>

<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-check-circle"></i> Approval History</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Approver</th><th>@Localizer["Decision"]</th><th>@Localizer["Comment"]</th><th>@Localizer["Date"]</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Approvals)
            {
                <tr><td>@a.ApproverName</td>
                    <td><pems-badge tone="@(a.Decision == "Approved" ? "success" : "danger")">@a.Decision</pems-badge></td>
                    <td>@a.Comment</td><td>@a.ApprovalDate.ToString("yyyy-MM-dd")</td></tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Approvals.Any()) { <p class="text-muted small">No approvals recorded yet.</p> }

    @if (s.Status != "Closed")
    {
        <form asp-action="AddApproval" method="post" class="row g-2 mt-2">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <div class="col-md-3">
                <select name="decision" class="form-select form-select-sm">
                    <option value="Approved">@Localizer["Approved"]</option>
                    <option value="Rejected">@Localizer["Rejected"]</option>
                </select>
            </div>
            <div class="col-md-6"><input name="comment" class="form-control form-control-sm" placeholder="@Localizer["Comment (optional)"]" /></div>
            <div class="col-md-3"><pems-button tone="primary" size="small" css="w-100">Record Decision</pems-button></div>
        </form>

        <form asp-action="Closeout" method="post" class="mt-3">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <pems-button tone="success" size="small" outline="true" type="submit" onclick="return confirm('Close out this procurement package?')">
                <i class="bi bi-flag"></i> Closeout Package
            </pems-button>
        </form>
    }
</div>
