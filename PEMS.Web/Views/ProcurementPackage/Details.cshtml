@model PEMS.Application.DTOs.ProcurementPackageDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Summary;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var unlinkedMRs = (IEnumerable<dynamic>)ViewBag.UnlinkedMRs;
    var tenders = (IEnumerable<PEMS.Domain.Entities.Tender>)(ViewBag.Tenders ?? Array.Empty<PEMS.Domain.Entities.Tender>());
    var stages = new[] { "MR", "VendorInquiry", "TechnicalClarification", "MRQ", "Response", "Approval", "Closeout" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}


<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center">
        <div>
            <h5 class="mb-0">@s.PackageNumber &mdash; @s.Title</h5>
            <span class="text-muted small">@s.ProjectName @(s.DisciplineName != null ? " | " + s.DisciplineName : "")</span>
        </div>
        <pems-flex align="center" gap="2">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Relationship" asp-action="ProcurementPackage" asp-route-id="@s.ProcurementPackageId"><pems-icon name="bi-diagram-3" /> @Localizer["Cm_Relationships"]</pems-button>
            <pems-badge tone="@(s.Status == "Closed" ? "success" : "warning")" css="fs-6">@s.Status</pems-badge>
        </pems-flex>
    </pems-flex>

    @* طبق ممیزی نهایی §7: چرخه‌ی Package→Tender→Award→Contract مستقیماً این‌جا دیده می‌شود *@
    @if (tenders.Any())
    {
        <div class="mt-3">
            <div class="small text-muted mb-1">@Localizer["Tenders"]</div>
            <pems-flex wrap="true" gap="2">
                @foreach (var t in tenders)
                {
                    <span class="btn-group">
                        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Details" asp-route-id="@t.TenderId">
                            @t.TenderNumber <pems-badge tone="neutral">@t.Status</pems-badge>
                            @if (t.AwardedBid != null)
                            {
                                <text> — @Localizer["Awarded"]: @t.AwardedBid.Vendor?.Name</text>
                            }
                        </pems-button>
                        @if (t.ContractId != null)
                        {
                            <pems-button tone="success" size="small" outline="true" as="a" asp-controller="Contract" asp-action="Details" asp-route-id="@t.ContractId">
                                <pems-icon name="bi-arrow-right-short" /> @Localizer["Contract"]
                            </pems-button>
                        }
                    </span>
                }
            </pems-flex>
        </div>
    }
    <div class="mt-2">
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Index" asp-route-procurementPackageId="@s.ProcurementPackageId">@Localizer["Tenders"]</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Tender" asp-action="Create" asp-route-procurementPackageId="@s.ProcurementPackageId">@Localizer["New Tender"]</pems-button>
    </div>

    <pems-flex wrap="true" gap="2" css="mt-3">
        @foreach (var st in stages.Where(x => x != "Closeout"))
        {
            <form asp-action="AdvanceStage" method="post" class="d-inline">
                <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                <input type="hidden" name="newStage" value="@st" />
                <pems-button tone="none" size="small" css="@(st == s.Stage ? "btn-pems-solid" : "btn-outline-secondary")" type="submit" disabled="@(s.Status == "Closed" || s.Status == "Cancelled")">@st</pems-button>
            </form>
        }
        @* Closeout فقط از فرم اختصاصی «Closeout Package» (Approve + گیت بازرسی) انجام می‌شود، نه تغییر مرحله‌ی عمومی *@
        @if (s.Stage == "Closeout")
        {
            <pems-button as="span" tone="primary" size="small" css="disabled">Closeout</pems-button>
        }
    </pems-flex>
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-related-list id="pkgMrs" icon="bi-cart-check" title="@Localizer["PkL_Mrs"]" count="@Model.MaterialRequisitions.Count" empty="@(!Model.MaterialRequisitions.Any())" empty-text="@Localizer["PkD_NoMrs"]">
            @if (Model.MaterialRequisitions.Any())
            {
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["MrL_No"]</pems-table-header><pems-table-header>@Localizer["Description"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var mr in Model.MaterialRequisitions)
                    {
                        <pems-table-row><pems-table-cell><a asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@mr.MRId">@mr.MRNumber</a></pems-table-cell>
                            <pems-table-cell class="small">@mr.Description</pems-table-cell><pems-table-cell><span class="vs-pill vs-pill--neutral">@VdrUi.Loc(Localizer, "MrL_St_", mr.Status)</span></pems-table-cell></pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
            }
            @if (s.Status != "Closed")
            {
                <pems-related-add action="@Url.Action("LinkMR")" parent-name="packageId" parent-value="@s.ProcurementPackageId.ToString()" submit-label="@Localizer["PkD_LinkMr"]">
                    <pems-list-filter-select id="pkgLinkMr" name="mrId" label="@Localizer["MrL_No"]" items="@(((IEnumerable<dynamic>)unlinkedMRs).Select(mr => new SelectListItem((string)mr.MRNumber, ((int)mr.MRId).ToString())))" />
                </pems-related-add>
            }
        </pems-related-list>
    </pems-col>

    <pems-col md="6">
        <pems-related-list id="pkgMrqs" icon="bi-file-earmark-spreadsheet" title="@Localizer["PkD_Quotations"]" count="@Model.Quotations.Count" empty="@(!Model.Quotations.Any())" empty-text="@Localizer["PkD_NoQuotations"]">
            @if (Model.Quotations.Any())
            {
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["MRQ No"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var q in Model.Quotations)
                    {
                        <pems-table-row><pems-table-cell><span class="vs-num">@q.MRQNumber</span></pems-table-cell><pems-table-cell>@q.VendorName</pems-table-cell><pems-table-cell><span class="vs-pill vs-pill--neutral">@q.QuotationStatus</span></pems-table-cell></pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
            }
        </pems-related-list>
    </pems-col>
</pems-row>

<pems-related-list id="pkgComms" icon="bi-chat-square-text" title="@Localizer["PkD_Communications"]" count="@Model.Communications.Count" empty="@(!Model.Communications.Any())" empty-text="@Localizer["PkD_NoCommunications"]">
    @if (Model.Communications.Any())
    {
    <pems-related-table>
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Subject"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>@Localizer["Raised By"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Response"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var c in Model.Communications)
            {
                <pems-table-row>
                    <pems-table-cell><pems-badge tone="neutral">@c.Type</pems-badge></pems-table-cell>
                    <pems-table-cell>@c.Subject<div class="small text-muted">@c.Body</div></pems-table-cell>
                    <pems-table-cell>@c.VendorName</pems-table-cell>
                    <pems-table-cell>@c.RaisedByName</pems-table-cell>
                    <pems-table-cell>@c.RaisedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                    <pems-table-cell>
                        @{
                            var ab = c.ActionStatus switch { "Closed" => "success", "Answered" => "info", _ => "danger" };
                        }
                        <pems-badge tone="@ab">@c.ActionStatus</pems-badge>
                        <form asp-action="SetCommunicationStatus" method="post" class="d-inline">
                            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                            <input type="hidden" name="communicationId" value="@c.ProcurementCommunicationId" />
                            <pems-select class="pems-w-110" scale="small" css="mt-1" name="actionStatus" onchange="this.form.submit()">
                                @foreach (var opt in new[] { "Open", "Answered", "Closed" })
                                { <option value="@opt" selected="@(opt == c.ActionStatus)">@opt</option> }
                            </pems-select>
                        </form>
                    </pems-table-cell>
                    <pems-table-cell class="small">
                        @c.ResponseText
                        @if (string.IsNullOrEmpty(c.ResponseText))
                        {
                            <form class="mt-1" asp-action="RespondCommunication" method="post"><pems-flex gap="1">
                                <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
                                <input type="hidden" name="communicationId" value="@c.ProcurementCommunicationId" />
                                <pems-input scale="small" name="responseText" placeholder="@Localizer["Response..."]" />
                                <pems-button tone="primary" size="small" outline="true">@Localizer["Save"]</pems-button>
                            </pems-flex></form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    }
    @if (s.Status != "Closed")
    {
        <form asp-action="AddCommunication" method="post"><pems-row gap="2" css="m-0 px-2 py-2 lp-rel-add">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <pems-col md="2">
                <pems-select scale="small" name="type">
                    <option value="VendorInquiry">Vendor Inquiry</option>
                    <option value="TechnicalClarification">Technical Clarification</option>
                    <option value="EngineeringQuestion">Engineering Question</option>
                    <option value="Response">@Localizer["Response"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="2">
                <pems-select scale="small" name="vendorId">
                    <option value="">-- Vendor --</option>
                    @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-input scale="small" name="subject" placeholder="@Localizer["Subject"]" required /></pems-col>
            <pems-col md="4"><pems-input scale="small" name="body" placeholder="@Localizer["Details"]" required /></pems-col>
            <pems-col md="1"><pems-button tone="primary" size="small" css="w-100" title="@Localizer["Add"]"><pems-icon name="bi-plus-lg" aria-hidden="true" /><span class="visually-hidden">@Localizer["Add"]</span></pems-button></pems-col>
        </pems-row></form>
    }
</pems-related-list>

<pems-related-list id="pkgApprovals" icon="bi-check-circle" title="@Localizer["PkD_Approvals"]" count="@Model.Approvals.Count" empty="@(!Model.Approvals.Any())" empty-text="@Localizer["PkD_NoApprovals"]">
    @if (Model.Approvals.Any())
    {
    <pems-related-table>
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["PkD_Approver"]</pems-table-header><pems-table-header>@Localizer["Decision"]</pems-table-header><pems-table-header>@Localizer["Comment"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var a in Model.Approvals)
            {
                <pems-table-row><pems-table-cell>@a.ApproverName</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@(a.Decision == "Approved" ? "success" : "danger")">@a.Decision</pems-badge></pems-table-cell>
                    <pems-table-cell>@a.Comment</pems-table-cell><pems-table-cell>@a.ApprovalDate.ToString("yyyy-MM-dd")</pems-table-cell></pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    }
    @if (s.Status != "Closed")
    {
        <form asp-action="AddApproval" method="post"><pems-row gap="2" css="m-0 px-2 py-2 lp-rel-add">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <pems-col md="3">
                <pems-select scale="small" name="decision">
                    <option value="Approved">@Localizer["Approved"]</option>
                    <option value="Rejected">@Localizer["Rejected"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="6"><pems-input scale="small" name="comment" placeholder="@Localizer["Comment (optional)"]" /></pems-col>
            <pems-col md="3"><pems-button tone="primary" size="small" css="w-100">@Localizer["PkD_RecordDecision"]</pems-button></pems-col>
        </pems-row></form>

        <form asp-action="Closeout" method="post" class="px-3 pb-3" data-pems-confirm="@Localizer["PkD_ConfirmCloseout"]">
            <input type="hidden" name="packageId" value="@s.ProcurementPackageId" />
            <pems-button tone="success" size="small" outline="true" type="submit">
                <pems-icon name="bi-flag" aria-hidden="true" /> @Localizer["PkD_Closeout"]
            </pems-button>
        </form>
    }
</pems-related-list>
