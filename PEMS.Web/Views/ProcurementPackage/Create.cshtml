@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "ProcurementPackage", name = "packageNumber", label = Localizer["Package Number"].Value })</div>
            <div class="col-md-6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select name="disciplineId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </div>
            <div class="col-md-6"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></div>
            <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></div>
        </div>
        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
