@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Package Number</label><input name="packageNumber" class="form-control" placeholder="e.g. PP-2026-001" required /></div>
            <div class="col-md-6">
                <label class="form-label">Project</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Discipline</label>
                <select name="disciplineId" class="form-select">
                    <option value="">-- none --</option>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </select>
            </div>
            <div class="col-md-6"><label class="form-label">Title</label><input name="title" class="form-control" required /></div>
            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
