@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProcurementPackageDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StageText(string? s) => VdrUi.Loc(Localizer, "PkL_Stage_", s);
    string StatusText(string? s) => VdrUi.Loc(Localizer, "PkL_St_", s);
    string StatusTone(string? s) => s switch { "Closed" => "vs-pill--success", "Open" => "vs-pill--neutral", _ => "vs-pill--warning" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component. The process note became the tool tip of the title; the
   links to all MRs and all MRQs are toolbar tools; the create modal stays (it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["PkL_Title"]" heading-title="@Localizer["PkL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <a class="lp-icon-btn" asp-controller="MaterialRequisition" asp-action="Index" title="@Localizer["PkL_AllMrs"]" aria-label="@Localizer["PkL_AllMrs"]"><i class="bi bi-cart-check" aria-hidden="true"></i></a>
                <a class="lp-icon-btn" asp-controller="MaterialRequisition" asp-action="Quotations" title="@Localizer["PkL_AllMrqs"]" aria-label="@Localizer["PkL_AllMrqs"]"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i></a>
                <pems-list-reset-columns grid-key="ProcurementPackage" />
                <pems-list-new modal="createPackageModal" text="@Localizer["PkL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="ProcurementPackage" empty="@(!Model.Items.Any())" empty-text="@Localizer["PkL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="packageNo" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["PkL_No"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="420">@Localizer["Ed_Title"]</th>
                        <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Ed_Project"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px" class="vs-hide-md">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="stage" data-resizable="true" data-min-width="80" data-max-width="160" style="width:120px">@Localizer["PkL_Stage"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">@Localizer["Ed_Status"]</th>
                        <th data-col-key="mrs" data-resizable="true" data-min-width="60" data-max-width="100" style="width:70px" class="text-end">@Localizer["PkL_Mrs"]</th>
                        <th data-col-key="mrqs" data-resizable="true" data-min-width="60" data-max-width="100" style="width:70px" class="text-end">@Localizer["PkL_Mrqs"]</th>
                        <th data-col-key="openComms" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px" class="text-end">@Localizer["PkL_OpenComms"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@p.ProcurementPackageId" class="lp-subject" title="@p.PackageNumber">@p.PackageNumber</a></td>
                            <td><span class="vs-title-cell" title="@p.Title">@p.Title</span></td>
                            <td class="small vs-hide-md">@p.ProjectName</td>
                            <td class="small vs-hide-md">@p.DisciplineName</td>
                            <td><span class="vs-pill vs-pill--info">@StageText(p.Stage)</span></td>
                            <td><span class="vs-pill @StatusTone(p.Status)">@StatusText(p.Status)</span></td>
                            <td class="text-end"><span class="vs-num">@p.MRCount</span></td>
                            <td class="text-end"><span class="vs-num">@p.MRQCount</span></td>
                            <td class="text-end">
                                @if (p.OpenCommunicationsCount > 0) { <span class="vs-pill vs-pill--danger">@p.OpenCommunicationsCount</span> }
                                else { <span class="vs-num">0</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.ProcurementPackageId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "ProcurementPackage",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createPackageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="ProcurementPackage" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["PkL_New"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">@await Component.InvokeAsync("DocumentNumberField", new { documentType = "ProcurementPackage", name = "packageNumber", label = Localizer["Package Number"].Value })</div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="projectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select">
                                <option value="">@Localizer["-- None --"]</option>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Title"]</label><input name="title" class="form-control" required /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
