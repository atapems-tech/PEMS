@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.FunctionalLocationListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var pickerList = (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.PickerList;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The page note (the plant / area / unit hierarchy that
   equipment and assets link to) became the tool tip of the title; create and edit stay modals. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Fl_Title"]" heading-title="@Localizer["Fl_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="FunctionalLocation" />
                <pems-list-new modal="createFlModal" text="@Localizer["Fl_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="FunctionalLocation" empty="@(!Model.Items.Any())" empty-text="@Localizer["Fl_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="code" data-resizable="true" data-min-width="100" data-max-width="200" style="width:150px">@Localizer["Fl_Code"]</th>
                        <th data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="280" style="width:180px">@Localizer["Eq_Name"]</th>
                        <th data-col-key="path" data-resizable="true" data-min-width="160" data-max-width="400" style="width:260px" class="vs-hide-md">@Localizer["Fl_Path"]</th>
                        <th data-col-key="plant" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Fl_Plant"]</th>
                        <th data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Area"]</th>
                        <th data-col-key="unit" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Fl_Unit"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="70" data-max-width="120" style="width:90px">@Localizer["Equipment"]</th>
                        <th data-col-key="asset" data-resizable="true" data-min-width="60" data-max-width="100" style="width:80px">@Localizer["Cm_TabAsset"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fl in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@fl.Code</span></td>
                            <td class="small">@fl.Name</td>
                            <td class="small text-muted vs-hide-md"><span class="vs-title-cell" title="@fl.PathBreadcrumb">@fl.PathBreadcrumb</span></td>
                            <td class="small">@(fl.Plant ?? "-")</td>
                            <td class="small">@(fl.Area ?? "-")</td>
                            <td class="small">@(fl.Unit ?? "-")</td>
                            <td><span class="vs-num">@fl.EquipmentCount</span></td>
                            <td><span class="vs-num">@fl.AssetCount</span></td>
                            <td class="lp-actions">
                                <button type="button" class="lp-act lp-act--always edit-fl-btn" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]"
                                        data-id="@fl.FunctionalLocationId" data-code="@fl.Code" data-name="@fl.Name"
                                        data-parentid="@fl.ParentId" data-plant="@fl.Plant" data-area="@fl.Area" data-unit="@fl.Unit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "FunctionalLocation",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createFlModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["Fl_New"]</h6></div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">@Localizer["Code"]</label><input name="code" class="form-control form-control-sm" placeholder="U100-CW-PUMP" required /></div>
                    <div class="col-6"><label class="form-label small">@Localizer["Name"]</label><input name="name" class="form-control form-control-sm" required /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Parent"]</label>
                    <select name="parentId" class="form-select form-select-sm">
                        <option value="">@Localizer["-- none (root) --"]</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small">@Localizer["Plant"]</label><input name="plant" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">@Localizer["Area"]</label><input name="area" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">@Localizer["Unit"]</label><input name="unit" class="form-control form-control-sm" /></div>
                </div>
                <div class="mb-2"><label class="form-label small">@Localizer["Description"]</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Create"]</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="editFlModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" id="editFlId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Fl_Edit"]</h6></div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">@Localizer["Code"]</label><input name="code" id="editFlCode" class="form-control form-control-sm" required /></div>
                    <div class="col-6"><label class="form-label small">@Localizer["Name"]</label><input name="name" id="editFlName" class="form-control form-control-sm" required /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Parent"]</label>
                    <select name="parentId" id="editFlParentId" class="form-select form-select-sm">
                        <option value="">@Localizer["-- none (root) --"]</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small">@Localizer["Plant"]</label><input name="plant" id="editFlPlant" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">@Localizer["Area"]</label><input name="area" id="editFlArea" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">@Localizer["Unit"]</label><input name="unit" id="editFlUnit" class="form-control form-control-sm" /></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Save"]</button>
            </div>
        </form>
    </div></div>
</div>

);
</script>
}

@section Scripts {
<script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
<script>
document.querySelectorAll('.edit-fl-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('editFlId').value = btn.dataset.id;
        document.getElementById('editFlCode').value = btn.dataset.code;
        document.getElementById('editFlName').value = btn.dataset.name;
        document.getElementById('editFlParentId').value = btn.dataset.parentid || '';
        document.getElementById('editFlPlant').value = btn.dataset.plant || '';
        document.getElementById('editFlArea').value = btn.dataset.area || '';
        document.getElementById('editFlUnit').value = btn.dataset.unit || '';
        new bootstrap.Modal(document.getElementById('editFlModal')).show();
    });
});
</script>
}
