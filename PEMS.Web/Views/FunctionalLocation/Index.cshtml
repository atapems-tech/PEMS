@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.FunctionalLocationListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var pickerList = (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.PickerList;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The page note (the plant / area / unit hierarchy that
   equipment and assets link to) became the tool tip of the title; create and edit stay modals. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Fl_Title"]" heading-title="@Localizer["Fl_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="FunctionalLocation" />
                <pems-list-new modal="createFlModal" text="@Localizer["Fl_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="FunctionalLocation" empty="@(!Model.Items.Any())" empty-text="@Localizer["Fl_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150" data-col-key="code" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Fl_Code"]</pems-table-header>
                        <pems-table-header class="pems-w-180" data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="280">@Localizer["Eq_Name"]</pems-table-header>
                        <pems-table-header data-col-key="path" data-resizable="true" data-min-width="160" data-max-width="400" class="vs-hide-md pems-w-260">@Localizer["Fl_Path"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="plant" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Fl_Plant"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Area"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="unit" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Fl_Unit"]</pems-table-header>
                        <pems-table-header class="pems-w-90" data-col-key="equipment" data-resizable="true" data-min-width="70" data-max-width="120">@Localizer["Equipment"]</pems-table-header>
                        <pems-table-header class="pems-w-80" data-col-key="asset" data-resizable="true" data-min-width="60" data-max-width="100">@Localizer["Cm_TabAsset"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var fl in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><span class="vs-num">@fl.Code</span></pems-table-cell>
                            <pems-table-cell class="small">@fl.Name</pems-table-cell>
                            <pems-table-cell class="small text-muted vs-hide-md"><span class="vs-title-cell" title="@fl.PathBreadcrumb">@fl.PathBreadcrumb</span></pems-table-cell>
                            <pems-table-cell class="small">@(fl.Plant ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(fl.Area ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(fl.Unit ?? "-")</pems-table-cell>
                            <pems-table-cell><span class="vs-num">@fl.EquipmentCount</span></pems-table-cell>
                            <pems-table-cell><span class="vs-num">@fl.AssetCount</span></pems-table-cell>
                            <pems-table-cell class="lp-actions">
                                <button type="button" class="lp-act lp-act--always edit-fl-btn" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]"
                                        data-id="@fl.FunctionalLocationId" data-code="@fl.Code" data-name="@fl.Name"
                                        data-parentid="@fl.ParentId" data-plant="@fl.Plant" data-area="@fl.Area" data-unit="@fl.Unit">
                                    <pems-icon name="bi-pencil" aria-hidden="true" />
                                </button>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "FunctionalLocation",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = ""
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createFlModal" tabindex="-1">
        <pems-form asp-action="Create" method="post">
            <pems-modal-header>@Localizer["Fl_New"]</pems-modal-header>
            <pems-modal-body>
                <pems-row gap="2" css="mb-2">
                    <pems-col span="6"><pems-label css="small">@Localizer["Code"]</pems-label><pems-input scale="small" name="code" placeholder="U100-CW-PUMP" required /></pems-col>
                    <pems-col span="6"><pems-label css="small">@Localizer["Name"]</pems-label><pems-input scale="small" name="name" required /></pems-col>
                </pems-row>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Parent"]</pems-label>
                    <pems-select scale="small" name="parentId">
                        <option value="">@Localizer["-- none (root) --"]</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </pems-select>
                </div>
                <pems-row gap="2" css="mb-2">
                    <pems-col span="4"><pems-label css="small">@Localizer["Plant"]</pems-label><pems-input scale="small" name="plant" /></pems-col>
                    <pems-col span="4"><pems-label css="small">@Localizer["Area"]</pems-label><pems-input scale="small" name="area" /></pems-col>
                    <pems-col span="4"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" name="unit" /></pems-col>
                </pems-row>
                <div class="mb-2"><pems-label css="small">@Localizer["Description"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["Create"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="editFlModal" tabindex="-1">
        <pems-form asp-action="Edit" method="post">
            <input type="hidden" name="id" id="editFlId" />
            <pems-modal-header>@Localizer["Fl_Edit"]</pems-modal-header>
            <pems-modal-body>
                <pems-row gap="2" css="mb-2">
                    <pems-col span="6"><pems-label css="small">@Localizer["Code"]</pems-label><pems-input scale="small" name="code" id="editFlCode" required /></pems-col>
                    <pems-col span="6"><pems-label css="small">@Localizer["Name"]</pems-label><pems-input scale="small" name="name" id="editFlName" required /></pems-col>
                </pems-row>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Parent"]</pems-label>
                    <pems-select scale="small" name="parentId" id="editFlParentId">
                        <option value="">@Localizer["-- none (root) --"]</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </pems-select>
                </div>
                <pems-row gap="2" css="mb-2">
                    <pems-col span="4"><pems-label css="small">@Localizer["Plant"]</pems-label><pems-input scale="small" name="plant" id="editFlPlant" /></pems-col>
                    <pems-col span="4"><pems-label css="small">@Localizer["Area"]</pems-label><pems-input scale="small" name="area" id="editFlArea" /></pems-col>
                    <pems-col span="4"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" name="unit" id="editFlUnit" /></pems-col>
                </pems-row>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

);
</script>
}

@section Scripts {
<script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
<script src="~/js/views/functionallocation-index.js" asp-append-version="true"></script>
}
