@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.FunctionalLocationListDto>
@{
    var pickerList = (List<PEMS.Application.DTOs.FunctionalLocationPickerItemDto>)ViewBag.PickerList;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Functional Locations</h5>
    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createFlModal">
        <i class="bi bi-plus-lg"></i> New Functional Location
    </button>
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 بند ۶: ساختار سلسله‌مراتبی محل نصب تجهیزات (Plant / Area /
    Unit / ...). Equipment و Asset برای اتصال واقعی (نه متن آزاد) از همین لیست استفاده می‌کنند.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('FunctionalLocation')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="FunctionalLocation">
        <thead>
            <tr>
                <th data-col-key="code" data-resizable="true" data-min-width="100" data-max-width="200">Code</th>
                <th data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="280">Name</th>
                <th data-col-key="path" data-resizable="true" data-min-width="160" data-max-width="400">Path</th>
                <th data-col-key="plant" data-resizable="true" data-min-width="80" data-max-width="140">Plant</th>
                <th data-col-key="area" data-resizable="true" data-min-width="80" data-max-width="140">Area</th>
                <th data-col-key="unit" data-resizable="true" data-min-width="80" data-max-width="140">Unit</th>
                <th data-col-key="equipment" data-resizable="true" data-min-width="70" data-max-width="120">Equipment</th>
                <th data-col-key="asset" data-resizable="true" data-min-width="60" data-max-width="100">Asset</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fl in Model.Items)
            {
                <tr>
                    <td class="small fw-bold">@fl.Code</td>
                    <td class="small">@fl.Name</td>
                    <td class="small text-muted">@fl.PathBreadcrumb</td>
                    <td class="small">@(fl.Plant ?? "-")</td>
                    <td class="small">@(fl.Area ?? "-")</td>
                    <td class="small">@(fl.Unit ?? "-")</td>
                    <td class="small">@fl.EquipmentCount</td>
                    <td class="small">@fl.AssetCount</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-secondary edit-fl-btn"
                                data-id="@fl.FunctionalLocationId" data-code="@fl.Code" data-name="@fl.Name"
                                data-parentid="@fl.ParentId" data-plant="@fl.Plant" data-area="@fl.Area" data-unit="@fl.Unit">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز هیچ Functional Location ثبت نشده.</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "FunctionalLocation",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

<div class="modal fade" id="createFlModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">New Functional Location</h6></div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">Code</label><input name="code" class="form-control form-control-sm" placeholder="U100-CW-PUMP" required /></div>
                    <div class="col-6"><label class="form-label small">Name</label><input name="name" class="form-control form-control-sm" required /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Parent</label>
                    <select name="parentId" class="form-select form-select-sm">
                        <option value="">-- none (root) --</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small">Plant</label><input name="plant" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Area</label><input name="area" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Unit</label><input name="unit" class="form-control form-control-sm" /></div>
                </div>
                <div class="mb-2"><label class="form-label small">Description</label><textarea name="description" class="form-control form-control-sm" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">Create</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="editFlModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" id="editFlId" />
            <div class="modal-header"><h6 class="modal-title">Edit Functional Location</h6></div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">Code</label><input name="code" id="editFlCode" class="form-control form-control-sm" required /></div>
                    <div class="col-6"><label class="form-label small">Name</label><input name="name" id="editFlName" class="form-control form-control-sm" required /></div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Parent</label>
                    <select name="parentId" id="editFlParentId" class="form-select form-select-sm">
                        <option value="">-- none (root) --</option>
                        @foreach (var p in pickerList)
                        {
                            <option value="@p.FunctionalLocationId">@p.PathBreadcrumb</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><label class="form-label small">Plant</label><input name="plant" id="editFlPlant" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Area</label><input name="area" id="editFlArea" class="form-control form-control-sm" /></div>
                    <div class="col-4"><label class="form-label small">Unit</label><input name="unit" id="editFlUnit" class="form-control form-control-sm" /></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">Save</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
PemsDataGrid.initColumnResize('FunctionalLocation');
document.querySelectorAll('.edit-fl-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('editFlId').value = btn.dataset.id;
        document.getElementById('editFlCode').value = btn.dataset.code;
        document.getElementById('editFlName').value = btn.dataset.name;
        document.getElementById('editFlParentId').value = btn.dataset.parentid || '';
        document.getElementById('editFlPlant').value = btn.dataset.plant || '';
        document.getElementById('editFlArea').value = btn.dataset.area || '';
        document.getElementById('editFlUnit').value = btn.dataset.unit || '';
        new bootstrap.Modal(document.getElementById('editFlModal')).show();
    });
});
</script>
}
