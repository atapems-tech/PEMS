@model List<PEMS.Domain.Entities.Department>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var counts = (Dictionary<int, int>)ViewBag.EmployeeCounts;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component; Export and New are toolbar tools; the create and edit
   modals stay (they move to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["DpL_Title"]" heading-title="@Localizer["DpL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-export href="@Url.Action("Export")" />
                <pems-list-reset-columns grid-key="Department" />
                <pems-list-new modal="createDeptModal" text="@Localizer["DpL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Department" empty="@(!Model.Any())" empty-text="@Localizer["DpL_Empty"]">
                <thead>
                    <tr>
                        <th class="pems-w-100" data-col-key="code" data-resizable="true" data-min-width="70" data-max-width="160">@Localizer["MiL_Code"]</th>
                        <th class="pems-w-220" data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="320">@Localizer["DpL_Name"]</th>
                        <th data-col-key="description" data-resizable="true" data-min-width="160" data-max-width="520" class="vs-hide-md">@Localizer["Ed_Description"]</th>
                        <th data-col-key="employees" data-resizable="true" data-min-width="80" data-max-width="140" class="text-end pems-w-100">@Localizer["DpL_Employees"]</th>
                        <th class="pems-w-110" data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Ed_Status"]</th>
                        <th class="pems-w-100" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var empCount = counts.TryGetValue(d.DepartmentId, out var c) ? c : 0;
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@d.Code</span></td>
                            <td><span class="vs-cell-strong">@d.Name</span></td>
                            <td class="small text-muted vs-hide-md"><span class="vs-title-cell" title="@d.Description">@d.Description</span></td>
                            <td class="text-end"><a asp-controller="Employee" asp-action="Index" asp-route-departmentId="@d.DepartmentId" class="lp-subject"><span class="vs-num">@empCount</span></a></td>
                            <td><span class="vs-pill @(d.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@(d.IsActive ? Localizer["UsL_Active"] : Localizer["UsL_Inactive"])</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="lp-act lp-act--always" data-bs-toggle="modal" data-bs-target="#editDeptModal" data-fill-departmentid="@d.DepartmentId" data-fill-code="@d.Code" data-fill-name="@d.Name" data-fill-description="@d.Description" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"] @d.Name"><pems-icon name="bi-pencil" aria-hidden="true" /></button>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="departmentId" value="@d.DepartmentId" />
                                    <button type="submit" class="lp-act lp-act--always @(d.IsActive ? "text-danger" : "text-success")" title="@(d.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"])" aria-label="@(d.IsActive ? Localizer["DpL_Deactivate"] : Localizer["DpL_Activate"]) @d.Name"><pems-icon css="@(d.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true" /></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createDeptModal" tabindex="-1">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Department"]</h6></div>
                <div class="modal-body">
                    <pems-row gap="3">
                        <pems-col md="4"><pems-label>@Localizer["Code"]</pems-label><pems-input name="code" placeholder="e.g. ENG" /></pems-col>
                        <pems-col md="8"><pems-label>@Localizer["Name"]</pems-label><pems-input name="name" required /></pems-col>
                        <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></pems-col>
                    </pems-row>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </pems-modal>

@if (Model.Any())
{
    <pems-modal id="editDeptModal" tabindex="-1">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="departmentId" value="" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["Edit Department"]</h6></div>
                    <div class="modal-body">
                        <pems-row gap="3">
                            <pems-col md="4"><pems-label>@Localizer["Code"]</pems-label><pems-input name="code" /></pems-col>
                            <pems-col md="8"><pems-label>@Localizer["Name"]</pems-label><pems-input name="name" required /></pems-col>
                            <pems-col span="12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></pems-col>
                        </pems-row>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </pems-modal>
}

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
