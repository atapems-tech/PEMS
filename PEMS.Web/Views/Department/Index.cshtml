@model List<PEMS.Domain.Entities.Department>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var counts = (Dictionary<int, int>)ViewBag.EmployeeCounts;
}

<div class="content-card">
    <div class="d-flex justify-content-end gap-2 mb-3">
        <a asp-action="Export" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-excel"></i> @Localizer["Export"]</a>
        <pems-button tone="primary" size="small" type="button" data-bs-toggle="modal" data-bs-target="#createDeptModal">
            <i class="bi bi-plus-lg"></i> @Localizer["New Department"]
        </pems-button>
    </div>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Name"]</th><th>@Localizer["Description"]</th><th>@Localizer["Employees"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in Model)
            {
                var empCount = counts.TryGetValue(d.DepartmentId, out var c) ? c : 0;
                <tr>
                    <td>@d.Code</td>
                    <td>@d.Name</td>
                    <td class="small text-muted">@d.Description</td>
                    <td><a asp-controller="Employee" asp-action="Index" asp-route-departmentId="@d.DepartmentId" class="badge bg-secondary text-decoration-none">@empCount</a></td>
                    <td><span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#editDeptModal_@d.DepartmentId">
                            <i class="bi bi-pencil"></i>
                        </pems-button>
                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="departmentId" value="@d.DepartmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-@(d.IsActive ? "danger" : "success")">
                                <i class="bi @(d.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No departments yet.</p> }
</div>

<div class="modal fade" id="createDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Department"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">@Localizer["Code"]</label><input name="code" class="form-control" placeholder="e.g. ENG" /></div>
                        <div class="col-md-8"><label class="form-label">@Localizer["Name"]</label><input name="name" class="form-control" required /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var d in Model)
{
    <div class="modal fade" id="editDeptModal_@d.DepartmentId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="departmentId" value="@d.DepartmentId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["Edit Department"]</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label">@Localizer["Code"]</label><input name="code" value="@d.Code" class="form-control" /></div>
                            <div class="col-md-8"><label class="form-label">@Localizer["Name"]</label><input name="name" value="@d.Name" class="form-control" required /></div>
                            <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2">@d.Description</textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
