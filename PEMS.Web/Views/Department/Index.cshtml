@model List<PEMS.Domain.Entities.Department>
@{
    var counts = (Dictionary<int, int>)ViewBag.EmployeeCounts;
}

<div class="content-card">
    <div class="d-flex justify-content-end gap-2 mb-3">
        <a asp-action="Export" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-excel"></i> Export</a>
        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#importDeptModal"><i class="bi bi-upload"></i> Import</button>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createDeptModal">
            <i class="bi bi-plus-lg"></i> New Department
        </button>
    </div>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Code</th><th>Name</th><th>Description</th><th>Employees</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in Model)
            {
                var empCount = counts.TryGetValue(d.DepartmentId, out var c) ? c : 0;
                <tr>
                    <td>@d.Code</td>
                    <td>@d.Name</td>
                    <td class="small text-muted">@d.Description</td>
                    <td><a asp-controller="Employee" asp-action="Index" asp-route-departmentId="@d.DepartmentId" class="badge bg-secondary text-decoration-none">@empCount</a></td>
                    <td><span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">@(d.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editDeptModal_@d.DepartmentId">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="departmentId" value="@d.DepartmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-@(d.IsActive ? "danger" : "success")">
                                <i class="bi @(d.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">No departments yet.</p> }
</div>

<div class="modal fade" id="importDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                <div class="modal-header"><h6 class="modal-title">Import Departments</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">فایل اکسل با همون ستون‌بندی خروجی Export - نام تکراری رد می‌شود.</p>
                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Department</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label">Code</label><input name="code" class="form-control" placeholder="e.g. ENG" /></div>
                        <div class="col-md-8"><label class="form-label">Name</label><input name="name" class="form-control" required /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var d in Model)
{
    <div class="modal fade" id="editDeptModal_@d.DepartmentId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="departmentId" value="@d.DepartmentId" />
                    <div class="modal-header"><h6 class="modal-title">Edit Department</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label">Code</label><input name="code" value="@d.Code" class="form-control" /></div>
                            <div class="col-md-8"><label class="form-label">Name</label><input name="name" value="@d.Name" class="form-control" required /></div>
                            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2">@d.Description</textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-pems-solid">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
