@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var order = ViewBag.Order;
}
<div class="content-card pems-s-e2b01b0d">
    <h5 class="mb-1">New Production Run</h5>
    <div class="text-muted mb-3">Order: @order.OrderNumber - @order.MaterialItem.MaterialCode</div>
    <form asp-action="Create" method="post">
        <input type="hidden" name="productionOrderId" value="@order.ProductionOrderId" />
        <div class="row g-3">
            <div class="col-md-6">
                <pems-label>Operator (optional)</pems-label>
                <pems-select name="operatorEmployeeId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var emp in ViewBag.Employees)
                    {
                        <option value="@emp.EmployeeId">@emp.Name</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>Shift (optional)</pems-label>
                <pems-select name="shiftDefinitionId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var s in ViewBag.Shifts)
                    {
                        <option value="@s.ShiftDefinitionId">@s.Code - @s.Name</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Equipment (optional)"]</pems-label>
                <pems-input type="number" name="equipmentId" placeholder="@Localizer["Equipment ID"]" />
            </div>
            <div class="col-12">
                <pems-label>@Localizer["Notes"]</pems-label>
                <pems-textarea name="notes" rows="2"></pems-textarea>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <pems-button tone="primary" type="submit"><pems-icon name="bi-check-lg" /> Create Run</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@order.ProductionOrderId">Cancel</pems-button>
        </div>
    </form>
</div>
