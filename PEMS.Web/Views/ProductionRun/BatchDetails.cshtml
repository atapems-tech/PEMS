@model PEMS.Application.DTOs.ProductionBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="pems-s-b12974cb">
    <pems-flex justify="between" align="start" wrap="true" gap="3">
        <div>
            <pems-flex align="center" gap="2" wrap="true">
                <h4 class="mb-0">@Model.BatchNumber</h4>
                <pems-badge tone="info">@Model.QualityStatus</pems-badge>
            </pems-flex>
            <div class="text-muted">@Model.MaterialCode - @Model.MaterialDescription</div>
            <div class="text-muted small mt-1">
                Qty: @Model.Quantity.ToString("N3") @Model.UomCode &middot;
                Produced: @Model.ProducedDate.ToString("yyyy-MM-dd HH:mm") &middot;
                Order: <a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@Model.ProductionOrderId">@Model.OrderNumber</a> &middot;
                Run: <a asp-action="Details" asp-route-id="@Model.ProductionRunId">@Model.RunNumber</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.QualityStatusReason))
            {
                <div class="small text-muted mt-1">Reason: @Model.QualityStatusReason @(Model.QualityStatusChangedByName != null ? $"({Model.QualityStatusChangedByName})" : "")</div>
            }
        </div>
        <pems-flex dir="column" gap="1" css="pems-s-7d03ac6a">
            @if (Model.QualityStatus == "Produced")
            {
                <form asp-action="SubmitBatchForQc" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="primary" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-clipboard-check" /> Submit for QC</pems-button></form>
            }
            @if (Model.QualityStatus == "AwaitingQC")
            {
                <form asp-action="ReleaseBatch" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-check2-circle" /> Release</pems-button></form>
                <pems-button tone="warning" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#blockModal"><pems-icon name="bi-slash-circle" /> Block</pems-button>
                <pems-button tone="danger" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal"><pems-icon name="bi-x-circle" /> @Localizer["Reject"]</pems-button>
            }
            @if (Model.QualityStatus == "Blocked")
            {
                <form asp-action="UnblockBatch" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="success" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-arrow-counterclockwise" /> Back to QC</pems-button></form>
            }
        </pems-flex>
    </pems-flex>
</pems-content-card>

<pems-modal id="blockModal" tabindex="-1">
        <form asp-action="BlockBatch" asp-route-id="@Model.ProductionBatchId" method="post">
            <pems-modal-header close="true">Block Batch</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="warning" type="submit">Block</pems-button></pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="rejectModal" tabindex="-1">
        <form asp-action="RejectBatch" asp-route-id="@Model.ProductionBatchId" method="post">
            <pems-modal-header close="true">Reject Batch</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="danger" type="submit">@Localizer["Reject"]</pems-button></pems-modal-footer>
        </form>
    </pems-modal>
