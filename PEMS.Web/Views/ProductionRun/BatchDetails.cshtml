@model PEMS.Application.DTOs.ProductionBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card" style="max-width:720px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h4 class="mb-0">@Model.BatchNumber</h4>
                <pems-badge tone="info">@Model.QualityStatus</pems-badge>
            </div>
            <div class="text-muted">@Model.MaterialCode - @Model.MaterialDescription</div>
            <div class="text-muted small mt-1">
                Qty: @Model.Quantity.ToString("N3") @Model.UomCode &middot;
                Produced: @Model.ProducedDate.ToString("yyyy-MM-dd HH:mm") &middot;
                Order: <a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@Model.ProductionOrderId">@Model.OrderNumber</a> &middot;
                Run: <a asp-action="Details" asp-route-id="@Model.ProductionRunId">@Model.RunNumber</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.QualityStatusReason))
            {
                <div class="small text-muted mt-1">Reason: @Model.QualityStatusReason @(Model.QualityStatusChangedByName != null ? $"({Model.QualityStatusChangedByName})" : "")</div>
            }
        </div>
        <div class="d-flex flex-column gap-1" style="min-width:170px">
            @if (Model.QualityStatus == "Produced")
            {
                <form asp-action="SubmitBatchForQc" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="primary" size="small" outline="true" css="w-100" type="submit"><i class="bi bi-clipboard-check"></i> Submit for QC</pems-button></form>
            }
            @if (Model.QualityStatus == "AwaitingQC")
            {
                <form asp-action="ReleaseBatch" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><i class="bi bi-check2-circle"></i> Release</pems-button></form>
                <pems-button tone="warning" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#blockModal"><i class="bi bi-slash-circle"></i> Block</pems-button>
                <pems-button tone="danger" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="bi bi-x-circle"></i> @Localizer["Reject"]</pems-button>
            }
            @if (Model.QualityStatus == "Blocked")
            {
                <form asp-action="UnblockBatch" asp-route-id="@Model.ProductionBatchId" method="post"><pems-button tone="success" size="small" outline="true" css="w-100" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Back to QC</pems-button></form>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="blockModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="BlockBatch" asp-route-id="@Model.ProductionBatchId" method="post">
            <div class="modal-header"><h6 class="modal-title">Block Batch</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><pems-button tone="warning" type="submit">Block</pems-button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="RejectBatch" asp-route-id="@Model.ProductionBatchId" method="post">
            <div class="modal-header"><h6 class="modal-title">Reject Batch</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><pems-button tone="danger" type="submit">@Localizer["Reject"]</pems-button></div>
        </form>
    </div></div>
</div>
