@model PEMS.Application.DTOs.ProductionRunDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h4 class="mb-0">@Model.RunNumber</h4>
                <span class="badge bg-secondary">@Model.Status</span>
            </div>
            <div class="text-muted">Order: <a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@Model.ProductionOrderId">@Model.OrderNumber</a> - @Model.MaterialCode (@Model.MaterialDescription)</div>
            <div class="text-muted small mt-1">
                @(Model.StartDate?.ToString("yyyy-MM-dd HH:mm")) &rarr; @(Model.EndDate?.ToString("yyyy-MM-dd HH:mm"))
                @if (!string.IsNullOrEmpty(Model.WorkCenterCode)) { <text>&middot; Work Center: @Model.WorkCenterCode</text> }
                @if (!string.IsNullOrEmpty(Model.EquipmentTagNumber)) { <text>&middot; Equipment: @Model.EquipmentTagNumber</text> }
                @if (!string.IsNullOrEmpty(Model.OperatorEmployeeName)) { <text>&middot; Operator: @Model.OperatorEmployeeName</text> }
                @if (!string.IsNullOrEmpty(Model.ShiftName)) { <text>&middot; Shift: @Model.ShiftName</text> }
            </div>
            @if (Model.Status == "OnHold" && !string.IsNullOrEmpty(Model.HoldReason)) { <div class="text-warning small mt-1"><i class="bi bi-pause-circle"></i> Held: @Model.HoldReason</div> }
        </div>
        <div class="d-flex flex-column gap-1" style="min-width:160px">
            @if (Model.Status == "Planned")
            {
                <form asp-action="Start" asp-route-id="@Model.ProductionRunId" method="post"><button class="btn btn-sm btn-pems-solid w-100" type="submit"><i class="bi bi-play-fill"></i> @Localizer["Start"]</button></form>
            }
            @if (Model.Status == "InProgress")
            {
                <form asp-action="Pause" asp-route-id="@Model.ProductionRunId" method="post"><button class="btn btn-sm btn-outline-secondary w-100" type="submit"><i class="bi bi-pause-fill"></i> Pause</button></form>
                <button class="btn btn-sm btn-outline-warning w-100" type="button" data-bs-toggle="modal" data-bs-target="#holdRunModal"><i class="bi bi-exclamation-circle"></i> @Localizer["Hold"]</button>
                <form asp-action="Complete" asp-route-id="@Model.ProductionRunId" method="post"><button class="btn btn-sm btn-pems-solid w-100" type="submit"><i class="bi bi-check2-circle"></i> Complete</button></form>
            }
            @if (Model.Status is "Paused" or "OnHold")
            {
                <form asp-action="Resume" asp-route-id="@Model.ProductionRunId" method="post"><button class="btn btn-sm btn-outline-success w-100" type="submit"><i class="bi bi-play-circle"></i> Resume</button></form>
            }
            @if (Model.Status is "Planned" or "Paused" or "OnHold")
            {
                <button class="btn btn-sm btn-outline-danger w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelRunModal"><i class="bi bi-x-circle"></i> @Localizer["Cancel"]</button>
            }
        </div>
    </div>
</div>

@{
    var isInProgress = Model.Status == "InProgress";
    var reconciliation = Model.Reconciliation;
}

<div class="content-card mb-3">
    <h6 class="mb-2">Reconciliation</h6>
    @if (reconciliation.IsComparable)
    {
        <div class="row row-cols-2 row-cols-md-4 g-2">
            <div class="col"><div class="text-muted small">Input</div><div class="fw-semibold">@reconciliation.TotalInputQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">Output</div><div class="fw-semibold">@reconciliation.TotalOutputQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">@Localizer["Loss"]</div><div class="fw-semibold">@reconciliation.TotalLossQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">Difference</div><div class="fw-semibold @(reconciliation.Difference != 0 ? "text-danger" : "text-success")">@reconciliation.Difference?.ToString("N3")</div></div>
        </div>
        @if (reconciliation.Difference != 0)
        {
            <div class="small text-danger mt-1"><i class="bi bi-exclamation-triangle"></i> Reconciliation difference detected - not auto-balanced, recorded as-is.</div>
        }
    }
    else
    {
        <div class="text-muted small">@reconciliation.Note</div>
        <div class="row row-cols-2 row-cols-md-3 g-2 mt-1">
            <div class="col"><div class="text-muted small">Total Input</div><div class="fw-semibold">@reconciliation.TotalInputQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">@Localizer["Total Output"]</div><div class="fw-semibold">@reconciliation.TotalOutputQuantity.ToString("N3")</div></div>
            <div class="col"><div class="text-muted small">Total Loss</div><div class="fw-semibold">@reconciliation.TotalLossQuantity.ToString("N3")</div></div>
        </div>
    }
</div>

@if (isInProgress)
{
    <div class="row row-cols-1 row-cols-lg-3 g-3 mb-3">
        <div class="col">
            <div class="content-card h-100">
                <h6 class="mb-2">@Localizer["Record Input"]</h6>
                <form asp-action="RecordInput" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2">
                        <select name="materialItemId" class="form-select form-select-sm" required>
                            <option value="">-- material --</option>
                            @foreach (var m in ViewBag.MaterialItems)
                            {
                                <option value="@m.MaterialItemId">@m.MaterialCode</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><input type="number" step="0.001" min="0.001" name="quantity" class="form-control form-control-sm" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2"><input type="number" name="sourceProductionBatchId" class="form-control form-control-sm" placeholder="Source batch ID (optional)" /></div>
                    <div class="mb-2"><input type="text" name="notes" class="form-control form-control-sm" placeholder="@Localizer["Notes"]" /></div>
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">@Localizer["Record Input"]</button>
                </form>
            </div>
        </div>
        <div class="col">
            <div class="content-card h-100">
                <h6 class="mb-2">@Localizer["Record Output"]</h6>
                <form asp-action="RecordOutput" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2">
                        <select name="materialItemId" class="form-select form-select-sm" required>
                            <option value="">-- material/product --</option>
                            @foreach (var m in ViewBag.MaterialItems)
                            {
                                <option value="@m.MaterialItemId">@m.MaterialCode</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><input type="number" name="productionBatchId" class="form-control form-control-sm" placeholder="Existing batch ID (optional - else new batch)" /></div>
                    <div class="mb-2"><input type="number" step="0.001" min="0.001" name="quantity" class="form-control form-control-sm" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2">
                        <select name="outputClassification" class="form-select form-select-sm">
                            <option value="Primary">Primary</option>
                            <option value="ByProduct">ByProduct</option>
                        </select>
                    </div>
                    <div class="mb-2"><input type="text" name="notes" class="form-control form-control-sm" placeholder="@Localizer["Notes"]" /></div>
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">@Localizer["Record Output"]</button>
                </form>
            </div>
        </div>
        <div class="col">
            <div class="content-card h-100">
                <h6 class="mb-2">@Localizer["Record Loss"]</h6>
                <form asp-action="RecordLoss" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2"><input type="number" step="0.001" min="0.001" name="quantity" class="form-control form-control-sm" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2">
                        <select name="lossCategory" class="form-select form-select-sm" required>
                            <option value="">-- category --</option>
                            @foreach (var c in (string[])ViewBag.LossCategories)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2"><input type="text" name="notes" class="form-control form-control-sm" placeholder="@Localizer["Notes"]" /></div>
                    <button type="submit" class="btn btn-sm btn-outline-warning w-100">@Localizer["Record Loss"]</button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row row-cols-1 row-cols-lg-2 g-3">
    <div class="col">
        <div class="content-card">
            <h6 class="mb-2">Inputs</h6>
            <div class="table-scroll-area" style="max-height:40vh; overflow-y:auto;">
                <table class="table table-enterprise table-sm">
                    <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Qty"]</th><th>Source Batch</th><th>@Localizer["Inventory"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Inputs)
                        {
                            <tr>
                                <td>@i.MaterialCode</td>
                                <td>@i.Quantity.ToString("N3") @i.UomCode</td>
                                <td>@i.SourceBatchNumber</td>
                                <td>@(i.PostedToInventory ? "Posted" : "-")</td>
                                <td>
                                    @if (!i.PostedToInventory)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#postInputModal-@i.ProductionInputId">Post</button>
                                        <div class="modal fade" id="postInputModal-@i.ProductionInputId" tabindex="-1">
                                            <div class="modal-dialog"><div class="modal-content">
                                                <form asp-action="PostInputToInventory" method="post">
                                                    <input type="hidden" name="productionInputId" value="@i.ProductionInputId" />
                                                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                                                    <div class="modal-header"><h6 class="modal-title">Post Consumption to Inventory</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                                    <div class="modal-body">
                                                        <label class="form-label">@Localizer["Warehouse"]</label>
                                                        <select name="warehouseId" class="form-select mb-2" required>
                                                            @foreach (var w in ViewBag.Warehouses) { <option value="@w.WarehouseId">@w.Code - @w.Name</option> }
                                                        </select>
                                                    </div>
                                                    <div class="modal-footer"><button type="submit" class="btn btn-primary">@Localizer["Post"]</button></div>
                                                </form>
                                            </div></div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Inputs.Any()) { <p class="text-muted text-center py-2 small">No inputs recorded.</p> }
        </div>
    </div>
    <div class="col">
        <div class="content-card">
            <h6 class="mb-2">Outputs</h6>
            <div class="table-scroll-area" style="max-height:40vh; overflow-y:auto;">
                <table class="table table-enterprise table-sm">
                    <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Batch"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Class"]</th><th>@Localizer["Inventory"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Outputs)
                        {
                            <tr>
                                <td>@o.MaterialCode</td>
                                <td><a asp-action="BatchDetails" asp-route-id="@o.ProductionBatchId">@o.BatchNumber</a></td>
                                <td>@o.Quantity.ToString("N3") @o.UomCode</td>
                                <td>@o.OutputClassification</td>
                                <td>@(o.PostedToInventory ? "Posted" : "-")</td>
                                <td>
                                    @if (!o.PostedToInventory)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#postOutputModal-@o.ProductionOutputId">Post</button>
                                        <div class="modal fade" id="postOutputModal-@o.ProductionOutputId" tabindex="-1">
                                            <div class="modal-dialog"><div class="modal-content">
                                                <form asp-action="PostOutputToInventory" method="post">
                                                    <input type="hidden" name="productionOutputId" value="@o.ProductionOutputId" />
                                                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                                                    <div class="modal-header"><h6 class="modal-title">Post Receipt to Inventory</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                                    <div class="modal-body">
                                                        <label class="form-label">@Localizer["Warehouse"]</label>
                                                        <select name="warehouseId" class="form-select mb-2" required>
                                                            @foreach (var w in ViewBag.Warehouses) { <option value="@w.WarehouseId">@w.Code - @w.Name</option> }
                                                        </select>
                                                    </div>
                                                    <div class="modal-footer"><button type="submit" class="btn btn-primary">@Localizer["Post"]</button></div>
                                                </form>
                                            </div></div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Outputs.Any()) { <p class="text-muted text-center py-2 small">No outputs recorded.</p> }
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-lg-2 g-3 mt-1">
    <div class="col">
        <div class="content-card">
            <h6 class="mb-2">Losses</h6>
            <table class="table table-enterprise table-sm">
                <thead><tr><th>@Localizer["Qty"]</th><th>@Localizer["Category"]</th><th>@Localizer["Notes"]</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Losses)
                    {
                        <tr><td>@l.Quantity.ToString("N3") @l.UomCode</td><td><span class="badge bg-warning text-dark">@l.LossCategory</span></td><td class="small text-muted">@l.Notes</td></tr>
                    }
                </tbody>
            </table>
            @if (!Model.Losses.Any()) { <p class="text-muted text-center py-2 small">No losses recorded.</p> }
        </div>
    </div>
    <div class="col">
        <div class="content-card">
            <h6 class="mb-2">Event History</h6>
            <div class="table-scroll-area" style="max-height:30vh; overflow-y:auto;">
                <table class="table table-enterprise table-sm">
                    <thead><tr><th>@Localizer["Date"]</th><th>Event</th><th>By</th><th>@Localizer["Details"]</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Events)
                        {
                            <tr><td class="small">@e.EventDate.ToString("yyyy-MM-dd HH:mm")</td><td>@e.EventType</td><td>@e.EmployeeName</td><td class="small text-muted">@e.Details</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="holdRunModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Hold" asp-route-id="@Model.ProductionRunId" method="post">
            <div class="modal-header"><h6 class="modal-title">Hold Production Run</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><button type="submit" class="btn btn-warning">@Localizer["Hold"]</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="cancelRunModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Cancel" asp-route-id="@Model.ProductionRunId" method="post">
            <div class="modal-header"><h6 class="modal-title">Cancel Production Run</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><button type="submit" class="btn btn-danger">Cancel Run</button></div>
        </form>
    </div></div>
</div>
