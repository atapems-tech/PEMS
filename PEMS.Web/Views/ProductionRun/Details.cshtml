@model PEMS.Application.DTOs.ProductionRunDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="3">
        <div>
            <pems-flex align="center" gap="2" wrap="true">
                <h4 class="mb-0">@Model.RunNumber</h4>
                <pems-badge tone="neutral">@Model.Status</pems-badge>
            </pems-flex>
            <div class="text-muted">Order: <a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@Model.ProductionOrderId">@Model.OrderNumber</a> - @Model.MaterialCode (@Model.MaterialDescription)</div>
            <div class="text-muted small mt-1">
                @(Model.StartDate?.ToString("yyyy-MM-dd HH:mm")) &rarr; @(Model.EndDate?.ToString("yyyy-MM-dd HH:mm"))
                @if (!string.IsNullOrEmpty(Model.WorkCenterCode)) { <text>&middot; Work Center: @Model.WorkCenterCode</text> }
                @if (!string.IsNullOrEmpty(Model.EquipmentTagNumber)) { <text>&middot; Equipment: @Model.EquipmentTagNumber</text> }
                @if (!string.IsNullOrEmpty(Model.OperatorEmployeeName)) { <text>&middot; Operator: @Model.OperatorEmployeeName</text> }
                @if (!string.IsNullOrEmpty(Model.ShiftName)) { <text>&middot; Shift: @Model.ShiftName</text> }
            </div>
            @if (Model.Status == "OnHold" && !string.IsNullOrEmpty(Model.HoldReason)) { <div class="text-warning small mt-1"><pems-icon name="bi-pause-circle" /> Held: @Model.HoldReason</div> }
        </div>
        <pems-flex dir="column" gap="1" css="pems-s-94253f99">
            @if (Model.Status == "Planned")
            {
                <form asp-action="Start" asp-route-id="@Model.ProductionRunId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-play-fill" /> @Localizer["Start"]</pems-button></form>
            }
            @if (Model.Status == "InProgress")
            {
                <form asp-action="Pause" asp-route-id="@Model.ProductionRunId" method="post"><pems-button tone="neutral" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-pause-fill" /> Pause</pems-button></form>
                <pems-button tone="warning" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#holdRunModal"><pems-icon name="bi-exclamation-circle" /> @Localizer["Hold"]</pems-button>
                <form asp-action="Complete" asp-route-id="@Model.ProductionRunId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-check2-circle" /> Complete</pems-button></form>
            }
            @if (Model.Status is "Paused" or "OnHold")
            {
                <form asp-action="Resume" asp-route-id="@Model.ProductionRunId" method="post"><pems-button tone="success" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-play-circle" /> Resume</pems-button></form>
            }
            @if (Model.Status is "Planned" or "Paused" or "OnHold")
            {
                <pems-button tone="danger" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelRunModal"><pems-icon name="bi-x-circle" /> @Localizer["Cancel"]</pems-button>
            }
        </pems-flex>
    </pems-flex>
</pems-content-card>

@{
    var isInProgress = Model.Status == "InProgress";
    var reconciliation = Model.Reconciliation;
}

<pems-content-card css="mb-3">
    <h6 class="mb-2">Reconciliation</h6>
    @if (reconciliation.IsComparable)
    {
        <pems-row gap="2" css="row-cols-2 row-cols-md-4">
            <pems-col span=""><pems-kpi-tile compact label="Input">@reconciliation.TotalInputQuantity.ToString("N3")</pems-kpi-tile></pems-col>
            <pems-col span=""><pems-kpi-tile compact label="Output">@reconciliation.TotalOutputQuantity.ToString("N3")</pems-kpi-tile></pems-col>
            <pems-col span=""><pems-kpi-tile compact label="@Localizer["Loss"]">@reconciliation.TotalLossQuantity.ToString("N3")</pems-kpi-tile></pems-col>
            <pems-col span=""><pems-kpi-tile compact label="Difference" tone="@(reconciliation.Difference != 0 ? "danger" : "success")">@reconciliation.Difference?.ToString("N3")</pems-kpi-tile></pems-col>
        </pems-row>
        @if (reconciliation.Difference != 0)
        {
            <div class="small text-danger mt-1"><pems-icon name="bi-exclamation-triangle" /> Reconciliation difference detected - not auto-balanced, recorded as-is.</div>
        }
    }
    else
    {
        <div class="text-muted small">@reconciliation.Note</div>
        <pems-row gap="2" css="row-cols-2 row-cols-md-3 mt-1">
            <pems-col span=""><pems-kpi-tile compact label="Total Input">@reconciliation.TotalInputQuantity.ToString("N3")</pems-kpi-tile></pems-col>
            <pems-col span=""><pems-kpi-tile compact label="@Localizer["Total Output"]">@reconciliation.TotalOutputQuantity.ToString("N3")</pems-kpi-tile></pems-col>
            <pems-col span=""><pems-kpi-tile compact label="Total Loss">@reconciliation.TotalLossQuantity.ToString("N3")</pems-kpi-tile></pems-col>
        </pems-row>
    }
</pems-content-card>

@if (isInProgress)
{
    <pems-row gap="3" css="row-cols-1 row-cols-lg-3 mb-3">
        <pems-col span="">
            <pems-content-card css="h-100">
                <h6 class="mb-2">@Localizer["Record Input"]</h6>
                <form asp-action="RecordInput" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2">
                        <pems-select scale="small" name="materialItemId" required>
                            <option value="">-- material --</option>
                            @foreach (var m in ViewBag.MaterialItems)
                            {
                                <option value="@m.MaterialItemId">@m.MaterialCode</option>
                            }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-input scale="small" type="number" step="0.001" min="0.001" name="quantity" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2"><pems-input scale="small" type="number" name="sourceProductionBatchId" placeholder="Source batch ID (optional)" /></div>
                    <div class="mb-2"><pems-input scale="small" type="text" name="notes" placeholder="@Localizer["Notes"]" /></div>
                    <pems-button tone="primary" size="small" outline="true" css="w-100" type="submit">@Localizer["Record Input"]</pems-button>
                </form>
            </pems-content-card>
        </pems-col>
        <pems-col span="">
            <pems-content-card css="h-100">
                <h6 class="mb-2">@Localizer["Record Output"]</h6>
                <form asp-action="RecordOutput" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2">
                        <pems-select scale="small" name="materialItemId" required>
                            <option value="">-- material/product --</option>
                            @foreach (var m in ViewBag.MaterialItems)
                            {
                                <option value="@m.MaterialItemId">@m.MaterialCode</option>
                            }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-input scale="small" type="number" name="productionBatchId" placeholder="Existing batch ID (optional - else new batch)" /></div>
                    <div class="mb-2"><pems-input scale="small" type="number" step="0.001" min="0.001" name="quantity" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2">
                        <pems-select scale="small" name="outputClassification">
                            <option value="Primary">Primary</option>
                            <option value="ByProduct">ByProduct</option>
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-input scale="small" type="text" name="notes" placeholder="@Localizer["Notes"]" /></div>
                    <pems-button tone="primary" size="small" outline="true" css="w-100" type="submit">@Localizer["Record Output"]</pems-button>
                </form>
            </pems-content-card>
        </pems-col>
        <pems-col span="">
            <pems-content-card css="h-100">
                <h6 class="mb-2">@Localizer["Record Loss"]</h6>
                <form asp-action="RecordLoss" method="post">
                    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
                    <div class="mb-2"><pems-input scale="small" type="number" step="0.001" min="0.001" name="quantity" placeholder="@Localizer["Quantity"]" required /></div>
                    <div class="mb-2">
                        <pems-select scale="small" name="lossCategory" required>
                            <option value="">-- category --</option>
                            @foreach (var c in (string[])ViewBag.LossCategories)
                            {
                                <option value="@c">@c</option>
                            }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-input scale="small" type="text" name="notes" placeholder="@Localizer["Notes"]" /></div>
                    <pems-button tone="warning" size="small" outline="true" css="w-100" type="submit">@Localizer["Record Loss"]</pems-button>
                </form>
            </pems-content-card>
        </pems-col>
    </pems-row>
}

<pems-row gap="3" css="row-cols-1 row-cols-lg-2">
    <pems-col span="">
        <pems-content-card>
            <h6 class="mb-2">Inputs</h6>
            <div class="table-scroll-area pems-s-f7dce87f">
                <pems-table kind="enterprise" scale="small">
                    <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Qty"]</th><th>Source Batch</th><th>@Localizer["Inventory"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Inputs)
                        {
                            <tr>
                                <td>@i.MaterialCode</td>
                                <td>@i.Quantity.ToString("N3") @i.UomCode</td>
                                <td>@i.SourceBatchNumber</td>
                                <td>@(i.PostedToInventory ? "Posted" : "-")</td>
                                <td>
                                    @if (!i.PostedToInventory)
                                    {
                                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#postInputModal" data-fill-productioninputid="@i.ProductionInputId">Post</pems-button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </div>
            @if (!Model.Inputs.Any()) { <p class="text-muted text-center py-2 small">No inputs recorded.</p> }
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card>
            <h6 class="mb-2">Outputs</h6>
            <div class="table-scroll-area pems-s-f7dce87f">
                <pems-table kind="enterprise" scale="small">
                    <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Batch"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Class"]</th><th>@Localizer["Inventory"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Outputs)
                        {
                            <tr>
                                <td>@o.MaterialCode</td>
                                <td><a asp-action="BatchDetails" asp-route-id="@o.ProductionBatchId">@o.BatchNumber</a></td>
                                <td>@o.Quantity.ToString("N3") @o.UomCode</td>
                                <td>@o.OutputClassification</td>
                                <td>@(o.PostedToInventory ? "Posted" : "-")</td>
                                <td>
                                    @if (!o.PostedToInventory)
                                    {
                                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#postOutputModal" data-fill-productionoutputid="@o.ProductionOutputId">Post</pems-button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </div>
            @if (!Model.Outputs.Any()) { <p class="text-muted text-center py-2 small">No outputs recorded.</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3" css="row-cols-1 row-cols-lg-2 mt-1">
    <pems-col span="">
        <pems-content-card>
            <h6 class="mb-2">Losses</h6>
            <pems-data-table data="@(DataRows.Of(Model.Losses, c_ => c_.Add(((Localizer["Qty"])?.ToString() ?? ""), l => DataCell.Join((l.Quantity.ToString("N3")), " ", (l.UomCode))).Add(((Localizer["Category"])?.ToString() ?? ""), l => (object?)(l.LossCategory), kind: DataCellKind.Badge, tone: l => "warning").Add(((Localizer["Notes"])?.ToString() ?? ""), l => (object?)(l.Notes), css: "small text-muted")))" dense="true" />
            @if (!Model.Losses.Any()) { <p class="text-muted text-center py-2 small">No losses recorded.</p> }
        </pems-content-card>
    </pems-col>
    <pems-col span="">
        <pems-content-card>
            <h6 class="mb-2">Event History</h6>
            <div class="table-scroll-area pems-s-89e84480">
                <pems-data-table data="@(DataRows.Of(Model.Events, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), e => (object?)(e.EventDate.ToString("yyyy-MM-dd HH:mm")), css: "small").Add("Event", e => (object?)(e.EventType)).Add("By", e => (object?)(e.EmployeeName)).Add(((Localizer["Details"])?.ToString() ?? ""), e => (object?)(e.Details), css: "small text-muted")))" dense="true" />
            </div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-modal id="holdRunModal" tabindex="-1">
        <form asp-action="Hold" asp-route-id="@Model.ProductionRunId" method="post">
            <pems-modal-header close="true">Hold Production Run</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="warning" type="submit">@Localizer["Hold"]</pems-button></pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="cancelRunModal" tabindex="-1">
        <form asp-action="Cancel" asp-route-id="@Model.ProductionRunId" method="post">
            <pems-modal-header close="true">Cancel Production Run</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="danger" type="submit">Cancel Run</pems-button></pems-modal-footer>
        </form>
    </pems-modal>

    <pems-modal id="postInputModal" tabindex="-1">
    <form asp-action="PostInputToInventory" method="post">
    <input type="hidden" name="productionInputId" value="" />
    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
    <pems-modal-header close="true">Post Consumption to Inventory</pems-modal-header>
    <pems-modal-body>
    <pems-label>@Localizer["Warehouse"]</pems-label>
    <pems-select css="mb-2" name="warehouseId" required>
    @foreach (var w in ViewBag.Warehouses) { <option value="@w.WarehouseId">@w.Code - @w.Name</option> }
    </pems-select>
    </pems-modal-body>
    <pems-modal-footer><pems-button tone="none" css="btn-primary" type="submit">@Localizer["Post"]</pems-button></pems-modal-footer>
    </form>
    </pems-modal>

    <pems-modal id="postOutputModal" tabindex="-1">
    <form asp-action="PostOutputToInventory" method="post">
    <input type="hidden" name="productionOutputId" value="" />
    <input type="hidden" name="productionRunId" value="@Model.ProductionRunId" />
    <pems-modal-header close="true">Post Receipt to Inventory</pems-modal-header>
    <pems-modal-body>
    <pems-label>@Localizer["Warehouse"]</pems-label>
    <pems-select css="mb-2" name="warehouseId" required>
    @foreach (var w in ViewBag.Warehouses) { <option value="@w.WarehouseId">@w.Code - @w.Name</option> }
    </pems-select>
    </pems-modal-body>
    <pems-modal-footer><pems-button tone="none" css="btn-primary" type="submit">@Localizer["Post"]</pems-button></pems-modal-footer>
    </form>
    </pems-modal>
