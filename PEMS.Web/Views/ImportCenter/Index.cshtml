@model IReadOnlyList<PEMS.Web.Security.ImportCatalog.ImportEntry>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Security
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["Title"] = Localizer["IC_Title"].Value; }

@await Html.PartialAsync("_PageHeader")

<p class="text-muted small mb-3">@Localizer["IC_Subtitle"]</p>

@if (!Model.Any())
{
    <div class="content-card text-muted text-center py-4">@Localizer["IC_Empty"]</div>
}

@foreach (var category in ImportCatalog.CategoryOrder)
{
    var items = Model.Where(e => e.Category == category).ToList();
    if (!items.Any()) { continue; }

    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["IC_Cat_" + category]</h6>
        <div class="row g-3">
            @foreach (var e in items)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="border rounded p-3 h-100 d-flex flex-column">
                        <div class="fw-semibold mb-1"><i class="bi @e.Icon"></i> @Localizer["IC_" + e.Key + "_Title"]</div>
                        <p class="text-muted small mb-2">@Localizer["IC_" + e.Key + "_Desc"]</p>
                        <div class="small mb-1"><span class="text-muted">@Localizer["IC_FileTypes"]:</span> <span dir="ltr">@e.FileTypes</span></div>
                        <div class="small text-muted mb-3 flex-grow-1">@Localizer["IC_" + e.Key + "_Flow"]</div>
                        @if (e.Mode == ImportCatalog.LaunchMode.Dialog)
                        {
                            <pems-button tone="primary" size="small" outline="true" css="align-self-start" type="button" data-bs-toggle="modal" data-bs-target="#icModal_@e.Key">
                                <i class="bi bi-box-arrow-in-right"></i> @Localizer["IC_Import"]
                            </pems-button>
                        }
                        else
                        {
                            <pems-button tone="primary" size="small" outline="true" css="align-self-start" as="a" asp-area="@e.Area" asp-controller="@e.Controller" asp-action="@e.Action">
                                <i class="bi bi-box-arrow-in-right"></i> @Localizer["IC_Open"]
                            </pems-button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Direct imports: the dialog lives here (the only place an import is started) and posts to the EXISTING import action of the owning module. *@
@foreach (var e in Model.Where(x => x.Mode == ImportCatalog.LaunchMode.Dialog))
{
    <div class="modal fade" id="icModal_@e.Key" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-area="@e.Area" asp-controller="@e.Controller" asp-action="@e.Action" method="post" enctype="multipart/form-data">
                    <div class="modal-header"><h6 class="modal-title">@Localizer["IC_" + e.Key + "_Title"]</h6></div>
                    <div class="modal-body">
                        <p class="text-muted small">@Localizer["IC_" + e.Key + "_Hint"]</p>
                        <label class="form-label small">@Localizer["IC_ChooseFile"]</label>
                        <input type="file" name="file" class="form-control" accept="@e.Accept" required />
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["IC_Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["IC_Import"]</pems-button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
