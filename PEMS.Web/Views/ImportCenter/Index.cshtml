@model IReadOnlyList<PEMS.Web.Security.ImportCatalog.ImportEntry>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Security
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["Title"] = Localizer["IC_Title"].Value; }

@await Html.PartialAsync("_PageHeader")

<p class="text-muted small mb-3">@Localizer["IC_Subtitle"]</p>

@if (!Model.Any())
{
    <pems-content-card css="text-muted text-center py-4">@Localizer["IC_Empty"]</pems-content-card>
}

@foreach (var category in ImportCatalog.CategoryOrder)
{
    var items = Model.Where(e => e.Category == category).ToList();
    if (!items.Any()) { continue; }

    <pems-content-card css="mb-3">
        <h6 class="mb-3">@Localizer["IC_Cat_" + category]</h6>
        <pems-row gap="3">
            @foreach (var e in items)
            {
                <pems-col md="6" xl="4">
                    <div class="border rounded p-3 h-100 d-flex flex-column">
                        <div class="fw-semibold mb-1"><pems-icon css="@e.Icon" /> @Localizer["IC_" + e.Key + "_Title"]</div>
                        <p class="text-muted small mb-2">@Localizer["IC_" + e.Key + "_Desc"]</p>
                        <div class="small mb-1"><span class="text-muted">@Localizer["IC_FileTypes"]:</span> <span dir="ltr">@e.FileTypes</span></div>
                        <div class="small text-muted mb-3 flex-grow-1">@Localizer["IC_" + e.Key + "_Flow"]</div>
                        @if (e.Mode == ImportCatalog.LaunchMode.Dialog)
                        {
                            <pems-button tone="primary" size="small" outline="true" css="align-self-start" type="button" data-bs-toggle="modal" data-bs-target="#icModal" data-fill-formaction="@Url.Action(e.Action, e.Controller, new { area = e.Area })" data-fill-accept="@e.Accept" data-fill-title="@Localizer["IC_" + e.Key + "_Title"]" data-fill-hint="@Localizer["IC_" + e.Key + "_Hint"]">
                                <pems-icon name="bi-box-arrow-in-right" /> @Localizer["IC_Import"]
                            </pems-button>
                        }
                        else
                        {
                            <pems-button tone="primary" size="small" outline="true" css="align-self-start" as="a" asp-area="@e.Area" asp-controller="@e.Controller" asp-action="@e.Action">
                                <pems-icon name="bi-box-arrow-in-right" /> @Localizer["IC_Open"]
                            </pems-button>
                        }
                    </div>
                </pems-col>
            }
        </pems-row>
    </pems-content-card>
}

@* Direct imports: the dialog lives here (the only place an import is started) and posts to the EXISTING import action of the owning module. *@
@if (Model.Any(x => x.Mode == ImportCatalog.LaunchMode.Dialog))
{
    <pems-modal id="icModal" tabindex="-1">
                <form method="post" enctype="multipart/form-data">
                    <div class="modal-header"><h6 class="modal-title" data-fill-text="title"></h6></div>
                    <div class="modal-body">
                        <p class="text-muted small" data-fill-text="hint"></p>
                        <pems-label css="small">@Localizer["IC_ChooseFile"]</pems-label>
                        <pems-input type="file" name="file" required />
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["IC_Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["IC_Import"]</pems-button>
                    </div>
                </form>
            </pems-modal>
}
