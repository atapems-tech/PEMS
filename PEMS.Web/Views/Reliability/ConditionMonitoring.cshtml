@model List<PEMS.Application.DTOs.ConditionMonitoringPointDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var foundation = (ConditionMonitoringFoundationStatusDto)ViewBag.Foundation;
    var equipmentId = (int?)ViewBag.EquipmentId;
    var variableTypes = (string[])ViewBag.SupportedVariableTypes;
    var pointsWithCbmStrategy = (HashSet<int>)ViewBag.PointsWithCbmStrategy;
    var evaluationProfiles = (IEnumerable<dynamic>)ViewBag.EvaluationProfiles;
    var failureModes = (IEnumerable<dynamic>)ViewBag.FailureModes;
    var failureCauses = (IEnumerable<dynamic>)ViewBag.FailureCauses;

    string EvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        "RequiresEngineeringReview" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };
}

<div class="d-flex justify-content-end align-items-center gap-2 mb-2">
    <pems-button tone="danger" size="small" outline="true" as="a" asp-controller="Finding" asp-action="Index" asp-route-equipmentId="@equipmentId"><pems-icon name="bi-flag" /> @Localizer["Findings"]</pems-button>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Reliability"]</pems-button>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 9» بند ۱۵: زیرساخت نرم‌افزاری همیشه آماده است - آنچه به داده‌ی واقعی نیاز
    دارد فقط تله‌متری زنده است. هیچ قرائتی هرگز شبیه‌سازی/جعل نمی‌شود.
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <div class="content-card h-100 text-center">
            <div class="text-muted small">Foundation</div>
            <pems-badge tone="@StatusBadge(foundation.FoundationStatus)">@foundation.FoundationStatus</pems-badge>
        </div>
    </pems-col>
    <pems-col md="3">
        <div class="content-card h-100 text-center">
            <div class="text-muted small">Live Telemetry</div>
            <pems-badge tone="@StatusBadge(foundation.LiveTelemetryStatus)">@foundation.LiveTelemetryStatus</pems-badge>
        </div>
    </pems-col>
    <pems-col md="3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@foundation.MonitoringPointCount</div>
            <div class="text-muted small">Monitoring Points (Fleet)</div>
        </div>
    </pems-col>
    <pems-col md="3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@foundation.ReadingCount</div>
            <div class="text-muted small">Readings Recorded (Fleet)</div>
        </div>
    </pems-col>
</pems-row>

<div class="content-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <pems-col span="auto">
            <pems-label css="small mb-0">@Localizer["Equipment ID"]</pems-label>
            <pems-input class="pems-w-140" scale="small" type="number" name="equipmentId" value="@equipmentId" />
        </pems-col>
        <pems-col span="auto"><pems-button tone="primary" size="small" type="submit">Load Points</pems-button></pems-col>
    </form>
</div>

@if (equipmentId.HasValue)
{
    <div class="content-card mb-3">
        <h6 class="mb-2">Monitoring Points — Equipment #@equipmentId</h6>
        <pems-table kind="enterprise" scale="small" css="mb-0">
            <thead><tr><th>@Localizer["Variable"]</th><th>@Localizer["Tag"]</th><th>@Localizer["Unit"]</th><th class="text-end">@Localizer["Alarm Range"]</th><th class="text-end">@Localizer["Readings"]</th><th>@Localizer["Last Reading"]</th><th>@Localizer["Evaluation"]</th><th>@Localizer["CBM Strategy"]</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.LastReadingIsAlarm ? "table-danger" : "")">
                        <td>@p.VariableType</td>
                        <td>@p.Tag</td>
                        <td>@p.Unit</td>
                        <td class="text-end small">@p.AlarmThresholdLow – @p.AlarmThresholdHigh</td>
                        <td class="text-end">
                            @p.ReadingCount
                            @if (p.ReadingCount > 0)
                            {
                                <pems-button tone="neutral" size="small" outline="true" css="ms-1" as="a" asp-action="Trend" asp-route-pointId="@p.ConditionMonitoringPointId" title="@Localizer["Trend"]"><pems-icon name="bi-graph-up" /></pems-button>
                            }
                        </td>
                        <td class="small">@(p.LastReadingDate.HasValue ? $"{p.LastValue} @ {p.LastReadingDate.Value:yyyy-MM-dd}" : "No readings yet")</td>
                        <td>
                            @if (p.EvaluationProfileId.HasValue)
                            {
                                <pems-badge tone="@EvalBadge(p.LastReadingEvaluationStatus)">@p.LastReadingEvaluationStatus</pems-badge>
                                <div class="small text-muted">@p.EvaluationProfileCode</div>
                                @if (p.LastReadingId.HasValue && (p.LastReadingEvaluationStatus == "Warning" || p.LastReadingEvaluationStatus == "Alarm" || p.LastReadingEvaluationStatus == "Critical"))
                                {
                                    <pems-button tone="danger" size="small" outline="true" css="mt-1" type="button" data-bs-toggle="modal" data-bs-target="#raiseFindingModal" data-reading-id="@p.LastReadingId" data-point-label="@p.VariableType — @p.Tag">
                                        <pems-icon name="bi-flag" /> @Localizer["Raise Finding"]
                                    </pems-button>
                                }
                            }
                            else
                            {
                                <form method="post" asp-action="AssignEvaluationProfile" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="equipmentId" value="@equipmentId" />
                                    <input type="hidden" name="pointId" value="@p.ConditionMonitoringPointId" />
                                    <pems-select class="pems-maxw-160" scale="small" name="evaluationProfileId">
                                        <option value="">@Localizer["-- profile --"]</option>
                                        @foreach (var ep in evaluationProfiles)
                                        {
                                            <option value="@ep.EvaluationProfileId">@ep.Code (@ep.VariableType)</option>
                                        }
                                    </pems-select>
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" title="@Localizer["Assign evaluation profile"]"><pems-icon name="bi-link-45deg" /></pems-button>
                                </form>
                            }
                            @if (p.LastReadingId.HasValue && p.LastReadingEvaluationStatus != "RequiresEngineeringReview")
                            {
                                <form method="post" asp-action="MarkRequiresEngineeringReview" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="equipmentId" value="@equipmentId" />
                                    <input type="hidden" name="readingId" value="@p.LastReadingId" />
                                    <pems-button tone="info" size="small" outline="true" css="mt-1" type="submit" title="@Localizer["Mark for Engineering Review"]">
                                        <pems-icon name="bi-person-check" />
                                    </pems-button>
                                </form>
                            }
                        </td>
                        <td>
                            @if (pointsWithCbmStrategy.Contains(p.ConditionMonitoringPointId))
                            {
                                <pems-badge tone="success">@Localizer["Linked"]</pems-badge>
                            }
                            else
                            {
                                <form method="post" asp-action="CreateCbmStrategy" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="equipmentId" value="@equipmentId" />
                                    <input type="hidden" name="conditionMonitoringPointId" value="@p.ConditionMonitoringPointId" />
                                    <pems-button tone="primary" size="small" outline="true" type="submit" title="@Localizer["ساخت استراتژی CBM برای این نقطه‌ی پایش"]">
                                        <pems-icon name="bi-plus-lg" /> @Localizer["CBM"]
                                    </pems-button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </pems-table>
        @if (!Model.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["هیچ نقطه‌ی پایشی برای این تجهیز تعریف نشده."]</p> }
    </div>

    <pems-row gap="3">
        <pems-col md="6">
            <div class="content-card">
                <h6 class="mb-2">Add Monitoring Point</h6>
                <form method="post" asp-action="CreateConditionMonitoringPoint">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="equipmentId" value="@equipmentId" />
                    <div class="mb-2">
                        <pems-label css="small">Variable Type</pems-label>
                        <pems-select scale="small" name="variableType">
                            @foreach (var vt in variableTypes) { <option value="@vt">@vt</option> }
                        </pems-select>
                    </div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Tag"]</pems-label><pems-input scale="small" name="tag" required /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" name="unit" /></div>
                    <pems-row gap="2" css="mb-2">
                        <pems-col span=""><pems-label css="small">Alarm Low</pems-label><pems-input scale="small" type="number" step="0.01" name="alarmLow" /></pems-col>
                        <pems-col span=""><pems-label css="small">Alarm High</pems-label><pems-input scale="small" type="number" step="0.01" name="alarmHigh" /></pems-col>
                    </pems-row>
                    <pems-button tone="primary" size="small" type="submit">Create Point</pems-button>
                </form>
            </div>
        </pems-col>
        <pems-col md="6">
            <div class="content-card">
                <h6 class="mb-2">Record Reading (Manual)</h6>
                <form method="post" asp-action="RecordConditionReading">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="equipmentId" value="@equipmentId" />
                    <div class="mb-2">
                        <pems-label css="small">Point</pems-label>
                        <pems-select scale="small" name="pointId">
                            @foreach (var p in Model) { <option value="@p.ConditionMonitoringPointId">@p.VariableType — @p.Tag</option> }
                        </pems-select>
                    </div>
                    <pems-row gap="2" css="mb-2">
                        <pems-col span=""><pems-label css="small">@Localizer["Date"]</pems-label><pems-input type="datetime-local" name="readingDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" scale="small" /></pems-col>
                        <pems-col span=""><pems-label css="small">@Localizer["Value"]</pems-label><pems-input scale="small" type="number" step="0.01" name="value" required /></pems-col>
                    </pems-row>
                    <div class="mb-2"><pems-label css="small">@Localizer["Source"]</pems-label><pems-input scale="small" name="source" value="Manual" /></div>
                    @{ var equipmentInstruments = (IEnumerable<dynamic>)ViewBag.EquipmentInstruments; }
                    @if (equipmentInstruments.Any())
                    {
                        <div class="mb-2">
                            <pems-label css="small">@Localizer["Instrument (اختیاری)"]</pems-label>
                            <pems-select scale="small" name="instrumentId">
                                <option value="">@Localizer["-- ندارد --"]</option>
                                @foreach (var inst in equipmentInstruments) { <option value="@inst.InstrumentId">@inst.TagNumber — @inst.InstrumentType</option> }
                            </pems-select>
                        </div>
                    }
                    <pems-button tone="primary" size="small" type="submit">Record Reading</pems-button>
                </form>
            </div>
        </pems-col>
    </pems-row>
}

<pems-modal size="large" id="raiseFindingModal" tabindex="-1">
        <form asp-controller="Finding" asp-action="CreateFromReading" method="post">
            <input type="hidden" name="conditionReadingId" id="raiseFindingReadingId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Raise Finding"] — <span id="raiseFindingPointLabel"></span></h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Description"]</pems-label>
                    <pems-textarea name="description" rows="2" required></pems-textarea>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["Recommended Action (اختیاری)"]</pems-label>
                    <pems-textarea name="recommendedAction" rows="2"></pems-textarea>
                </div>
                <pems-row gap="2">
                    <pems-col md="6">
                        <pems-label css="small">@Localizer["Failure Mode (ISO 14224، اختیاری)"]</pems-label>
                        <pems-select scale="small" name="failureModeId">
                            <option value="">@Localizer["-- ندارد --"]</option>
                            @foreach (var fm in failureModes) { <option value="@fm.FailureModeId">@fm.Name</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label css="small">@Localizer["Failure Cause (اختیاری)"]</pems-label>
                        <pems-select scale="small" name="failureCauseId">
                            <option value="">@Localizer["-- ندارد --"]</option>
                            @foreach (var fc in failureCauses) { <option value="@fc.FailureCauseId">@fc.Name</option> }
                        </pems-select>
                    </pems-col>
                </pems-row>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="danger" size="small" type="submit">@Localizer["Raise Finding"]</pems-button>
            </div>
        </form>
    </pems-modal>

<script src="~/js/views/reliability-conditionmonitoring.js" asp-append-version="true"></script>
