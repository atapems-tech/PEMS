@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Application.DTOs
@{
    var pmCompliance = (PmComplianceDto)ViewBag.PmCompliance;
    var breakdown = (MaintenanceTypeBreakdownDto)ViewBag.MaintenanceTypeBreakdown;
    var repeatFailures = (List<RepeatFailureGroupDto>)ViewBag.RepeatFailures;
    var effectiveness = (MaintenanceEffectivenessDto)ViewBag.Effectiveness;
    var criticalityMatrix = (List<CriticalityMatrixRowDto>)ViewBag.CriticalityMatrix;
    var criticalityMaintenanceMatrix = ViewBag.CriticalityFailureMaintenanceMatrix as List<CriticalityFailureMaintenanceRowDto>;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;

    string DataStatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "INSUFFICIENT_DATA" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };

    string TrendBadge(string trend) => trend switch
    {
        "IMPROVING" => "success",
        "WORSENING" => "danger",
        "STABLE" => "neutral",
        _ => "light"
    };
}

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-graph-up-arrow" /> @Localizer["Reliability"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="RcmFeedback"><pems-icon name="bi-arrow-repeat" /> @Localizer["RCM Feedback"]</pems-button>
    </div>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 7»: هیچ KPI ای جعل نمی‌شود - هرجا داده کافی نیست، وضعیت صریح (NOT_READY/
    INSUFFICIENT_DATA/PARTIAL/READY) نمایش داده می‌شود، نه یک صفر یا درصد ساختگی.
</p>

<pems-content-card css="mb-3">
    <form method="get"><pems-row gap="2" css="align-items-end">
        <pems-col md="3">
            <pems-label css="small">@Localizer["From"]</pems-label>
            <pems-date name="from" value="@(from?.ToString("yyyy-MM-dd"))" scale="small" />
        </pems-col>
        <pems-col md="3">
            <pems-label css="small">To</pems-label>
            <pems-date name="to" value="@(to?.ToString("yyyy-MM-dd"))" scale="small" />
        </pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" type="submit">@Localizer["Apply"]</pems-button></pems-col>
        <pems-col md="4" css="text-muted small">
            Period: @(from?.ToString("yyyy-MM-dd") ?? "all history") → @(to?.ToString("yyyy-MM-dd") ?? "now")
        </pems-col>
    </pems-row></form>
</pems-content-card>

@* ===================== Executive KPI Row ===================== *@
<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-content-card css="h-100">
            <div class="small text-muted">@Localizer["PM Compliance"]</div>
            <pems-metric>
                @(pmCompliance.CompliancePercent.HasValue ? $"{pmCompliance.CompliancePercent.Value:N1}%" : "N/A")
            </pems-metric>
            <pems-badge tone="@DataStatusBadge(pmCompliance.DataStatus)">@pmCompliance.DataStatus</pems-badge>
            @if (pmCompliance.DataStatusReason != null) { <div class="small text-muted mt-1">@pmCompliance.DataStatusReason</div> }
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100">
            <div class="small text-muted">Corrective Work %</div>
            <pems-metric>@(effectiveness.CorrectiveWorkloadPercent.HasValue ? $"{effectiveness.CorrectiveWorkloadPercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="small text-muted">Last @effectiveness.WindowDays days</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100">
            <div class="small text-muted">Emergency Work %</div>
            <pems-metric>@(breakdown.EmergencyWorkRatioPercent.HasValue ? $"{breakdown.EmergencyWorkRatioPercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="small text-muted">@breakdown.EmergencyWorkOrderCount of @breakdown.TotalWorkOrdersInPeriod Work Orders</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="3">
        <pems-content-card css="h-100">
            <div class="small text-muted">@Localizer["Repeat Failure Groups"]</div>
            <pems-metric>@repeatFailures.Count</pems-metric>
            <div class="small text-muted">Window: @(repeatFailures.FirstOrDefault()?.WindowDays ?? 90) days</div>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-nav css="mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-pm">@Localizer["PM Compliance"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-type">Maintenance Type</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-repeat">Repeat Failures</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-effectiveness">Effectiveness</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-matrix">Criticality Matrix</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-matrix2">Criticality × Maintenance/RCM</button></li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-pm">
        <pems-content-card>
            <p class="text-muted small">
                مخرج فقط WorkOrder هایی است که از یک Maintenance Plan تولید شده‌اند و DueDate واقعی
                دارند. Not Yet Due/Cancelled/Insufficient Data هرگز به‌عنوان «عدم انطباق» شمرده نمی‌شوند.
            </p>
            <pems-row gap="2" css="small">
                <pems-col md="2"><strong>Total in Scope</strong><div>@pmCompliance.TotalQualifyingWorkOrders</div></pems-col>
                <pems-col md="2"><strong>@Localizer["Compliant"]</strong><div class="text-success">@pmCompliance.CompliantCount</div></pems-col>
                <pems-col md="2"><strong>@Localizer["Completed Late"]</strong><div class="text-warning">@pmCompliance.CompletedLateCount</div></pems-col>
                <pems-col md="2"><strong>@Localizer["Overdue"]</strong><div class="text-danger">@pmCompliance.OverdueCount</div></pems-col>
                <pems-col md="2"><strong>@Localizer["Not Yet Due"]</strong><div>@pmCompliance.NotYetDueCount</div></pems-col>
                <pems-col md="1"><strong>@Localizer["Cancelled"]</strong><div>@pmCompliance.CancelledCount</div></pems-col>
                <pems-col md="1"><strong>Insufficient Data</strong><div>@pmCompliance.InsufficientDataCount</div></pems-col>
            </pems-row>
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-type">
        <pems-content-card>
            <pems-data-table data="@(DataRows.Of(breakdown.Items, c_ => c_.Add(((Localizer["Type"])?.ToString() ?? ""), item => (object?)(item.TypeName)).Add(((Localizer["Count"])?.ToString() ?? ""), item => (object?)(item.Count), css: "text-end", headerCss: "text-end").Add("%", item => (object?)(item.Percent.HasValue ? $"{item.Percent.Value:N1}%" : "N/A"), css: "text-end", headerCss: "text-end").Add("Hours", item => (object?)(item.TotalHours.HasValue ? $"{item.TotalHours.Value:N1}" : "N/A"), css: "text-end", headerCss: "text-end").Add(((Localizer["Cost"])?.ToString() ?? ""), item => (object?)(item.TotalCost.HasValue ? item.TotalCost.Value.ToString("N0") : "N/A"), css: "text-end", headerCss: "text-end").Add(((Localizer["Downtime"])?.ToString() ?? ""), item => (object?)(item.TotalDowntimeHours.HasValue ? $"{item.TotalDowntimeHours.Value:N1}h" : "No Recorded Downtime"), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
            @if (!breakdown.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-repeat">
        <pems-content-card>
            <p class="text-muted small">قاعده: همان تجهیز + همان حالت‌خرابی، با حداقل یک زوج خرابی متوالی در پنجره‌ی زمانی مشخص.</p>
            <pems-data-table data="@(DataRows.Of(repeatFailures, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), g => (object?)(g.TagNumber), css: "fw-bold").Add(((Localizer["Failure Mode"])?.ToString() ?? ""), g => (object?)(g.FailureModeKey)).Add("Occurrences", g => (object?)(g.OccurrenceCount), css: "text-end", headerCss: "text-end").Add("First", g => (object?)(g.FirstOccurrence.ToString("yyyy-MM-dd")), css: "small").Add("Last", g => (object?)(g.LastOccurrence.ToString("yyyy-MM-dd")), css: "small").Add("Window (days)", g => (object?)(g.WindowDays), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
            @if (!repeatFailures.Any()) { <p class="text-muted text-center py-4 mb-0">No Data Available - هیچ خرابی تکراری در این بازه تشخیص داده نشد.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-effectiveness">
        <pems-content-card>
            <p class="text-muted small">
                شواهد چندبعدی - نه یک امتیاز واحد. مقایسه‌ی @effectiveness.WindowDays روز اخیر
                (از @effectiveness.CurrentPeriodStart.ToString("yyyy-MM-dd")) با @effectiveness.WindowDays روز پیش از آن.
            </p>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-head><pems-table-row><pems-table-header>Dimension</pems-table-header><pems-table-header>Current Period</pems-table-header><pems-table-header>Prior Period</pems-table-header><pems-table-header>@Localizer["Trend"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    <pems-table-row>
                        <pems-table-cell>@Localizer["Failure Count"]</pems-table-cell>
                        <pems-table-cell>@effectiveness.CurrentPeriodFailureCount</pems-table-cell>
                        <pems-table-cell>@effectiveness.PriorPeriodFailureCount</pems-table-cell>
                        <pems-table-cell><pems-badge tone="@TrendBadge(effectiveness.FailureFrequencyTrend)">@effectiveness.FailureFrequencyTrend</pems-badge></pems-table-cell>
                    </pems-table-row>
                    <pems-table-row>
                        <pems-table-cell>Average MTTR</pems-table-cell>
                        <pems-table-cell>@(effectiveness.CurrentPeriodAverageMTTRHours.HasValue ? $"{effectiveness.CurrentPeriodAverageMTTRHours.Value:N1}h" : "N/A")</pems-table-cell>
                        <pems-table-cell>@(effectiveness.PriorPeriodAverageMTTRHours.HasValue ? $"{effectiveness.PriorPeriodAverageMTTRHours.Value:N1}h" : "N/A")</pems-table-cell>
                        <pems-table-cell><pems-badge tone="@TrendBadge(effectiveness.MttrTrend)">@effectiveness.MttrTrend</pems-badge></pems-table-cell>
                    </pems-table-row>
                    <pems-table-row>
                        <pems-table-cell>@Localizer["Downtime"]</pems-table-cell>
                        <pems-table-cell>@effectiveness.CurrentPeriodDowntimeHours.ToString("N1")h</pems-table-cell>
                        <pems-table-cell>@effectiveness.PriorPeriodDowntimeHours.ToString("N1")h</pems-table-cell>
                        <pems-table-cell><pems-badge tone="@TrendBadge(effectiveness.DowntimeTrend)">@effectiveness.DowntimeTrend</pems-badge></pems-table-cell>
                    </pems-table-row>
                </pems-table-body>
            </pems-table>
            <pems-row gap="2" css="small mt-2">
                <pems-col md="4"><strong>PM Compliance (current period)</strong><div>@(effectiveness.PmCompliancePercent.HasValue ? $"{effectiveness.PmCompliancePercent.Value:N1}%" : "N/A") <pems-badge tone="@DataStatusBadge(effectiveness.PmComplianceDataStatus)">@effectiveness.PmComplianceDataStatus</pems-badge></div></pems-col>
                <pems-col md="4"><strong>@Localizer["Repeat Failure Groups"]</strong><div>@effectiveness.RepeatFailureGroupCount</div></pems-col>
                <pems-col md="4"><strong>Emergency Workload</strong><div>@(effectiveness.EmergencyWorkloadPercent.HasValue ? $"{effectiveness.EmergencyWorkloadPercent.Value:N1}%" : "N/A")</div></pems-col>
            </pems-row>
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-matrix">
        <pems-content-card>
            <p class="text-muted small">یافته‌های هوشمندی - نه تصمیم خودکار. هر یافته با مقایسه‌ی صریح با میانگین ناوگان تولید می‌شود.</p>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Criticality"]</pems-table-header><pems-table-header class="text-end">@Localizer["Equipment"]</pems-table-header><pems-table-header class="text-end">@Localizer["With History"]</pems-table-header><pems-table-header class="text-end">@Localizer["Failures"]</pems-table-header><pems-table-header class="text-end">@Localizer["Downtime"]</pems-table-header><pems-table-header class="text-end">Repeat Groups</pems-table-header><pems-table-header class="text-end">@Localizer["PM Compliance"]</pems-table-header><pems-table-header>@Localizer["Findings"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var row in criticalityMatrix)
                    {
                        <pems-table-row>
                            <pems-table-cell class="fw-bold">@row.CriticalityClass</pems-table-cell>
                            <pems-table-cell class="text-end">@row.EquipmentCount</pems-table-cell>
                            <pems-table-cell class="text-end">@row.EquipmentWithFailureHistoryCount</pems-table-cell>
                            <pems-table-cell class="text-end">@row.FailureCount</pems-table-cell>
                            <pems-table-cell class="text-end">@row.TotalDowntimeHours.ToString("N1")h</pems-table-cell>
                            <pems-table-cell class="text-end">@row.RepeatFailureGroupCount</pems-table-cell>
                            <pems-table-cell class="text-end">@(row.PmCompliancePercent.HasValue ? $"{row.PmCompliancePercent.Value:N1}%" : "N/A")</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (row.Findings.Any())
                                {
                                    @foreach (var f in row.Findings) { <div class="text-warning">⚠ @f</div> }
                                }
                                else { <span class="text-muted">-</span> }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!criticalityMatrix.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    @* ===================== Phase 9: Criticality × Failure × Maintenance/RCM ===================== *@
    <pems-tab-pane fade="true" id="tab-matrix2">
        <pems-content-card>
            <p class="text-muted small">
                طبق «PEMS Phase 9» بند ۹: بُعد MaintenanceStrategy/RCM اضافه‌شده روی همان گروه‌بندی
                بحرانیت - آیا تجهیزات این کلاس بحرانیت واقعاً استراتژی نگهداری فعال دارند، و آیا
                کلاس‌های تجهیز نماینده‌شان تحلیل RCM تاییدشده دارند.
            </p>
            @if (criticalityMaintenanceMatrix != null && criticalityMaintenanceMatrix.Any())
            {
                <pems-table kind="enterprise" scale="small" css="mb-0">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Criticality"]</pems-table-header><pems-table-header class="text-end">@Localizer["Equipment"]</pems-table-header><pems-table-header class="text-end">@Localizer["Strategy Coverage"]</pems-table-header><pems-table-header class="text-end">Equipment Classes</pems-table-header><pems-table-header class="text-end">Classes w/ Approved RCM</pems-table-header><pems-table-header>Strategy Type Mix</pems-table-header><pems-table-header>@Localizer["Findings"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var row in criticalityMaintenanceMatrix)
                        {
                            <pems-table-row>
                                <pems-table-cell class="fw-bold">@row.CriticalityClass</pems-table-cell>
                                <pems-table-cell class="text-end">@row.EquipmentCount</pems-table-cell>
                                <pems-table-cell class="text-end">@row.StrategyCoveredEquipmentCount / @row.EquipmentCount (@row.StrategyCoveragePercent.ToString("N0")%)</pems-table-cell>
                                <pems-table-cell class="text-end">@row.DistinctEquipmentClassCount</pems-table-cell>
                                <pems-table-cell class="text-end">@row.EquipmentClassesWithApprovedRcmCount (@(row.RcmClassCoveragePercent.HasValue ? $"{row.RcmClassCoveragePercent.Value:N0}%" : "N/A"))</pems-table-cell>
                                <pems-table-cell class="small">
                                    @if (row.StrategyTypeMix.Any())
                                    {
                                        @string.Join(", ", row.StrategyTypeMix.Select(kv => $"{kv.Key}={kv.Value}"))
                                    }
                                    else { <span class="text-muted">-</span> }
                                </pems-table-cell>
                                <pems-table-cell class="small">
                                    @if (row.Findings.Any())
                                    {
                                        @foreach (var f in row.Findings) { <div class="text-warning">⚠ @f</div> }
                                    }
                                    else { <span class="text-muted">-</span> }
                                </pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p>
            }
        </pems-content-card>
    </pems-tab-pane>
</pems-tab-content>
