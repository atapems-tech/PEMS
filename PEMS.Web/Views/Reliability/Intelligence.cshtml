@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Application.DTOs
@{
    var pmCompliance = (PmComplianceDto)ViewBag.PmCompliance;
    var breakdown = (MaintenanceTypeBreakdownDto)ViewBag.MaintenanceTypeBreakdown;
    var repeatFailures = (List<RepeatFailureGroupDto>)ViewBag.RepeatFailures;
    var effectiveness = (MaintenanceEffectivenessDto)ViewBag.Effectiveness;
    var criticalityMatrix = (List<CriticalityMatrixRowDto>)ViewBag.CriticalityMatrix;
    var criticalityMaintenanceMatrix = ViewBag.CriticalityFailureMaintenanceMatrix as List<CriticalityFailureMaintenanceRowDto>;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;

    string DataStatusBadge(string status) => status switch
    {
        "READY" => "text-bg-success",
        "PARTIAL" => "text-bg-warning",
        "INSUFFICIENT_DATA" => "text-bg-warning",
        "NOT_READY" => "text-bg-secondary",
        _ => "text-bg-light border"
    };

    string TrendBadge(string trend) => trend switch
    {
        "IMPROVING" => "text-bg-success",
        "WORSENING" => "text-bg-danger",
        "STABLE" => "text-bg-secondary",
        _ => "text-bg-light border"
    };
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-graph-up-arrow"></i> @Localizer["Reliability"]</a>
        <a asp-action="RcmFeedback" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-repeat"></i> @Localizer["RCM Feedback"]</a>
    </div>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 7»: هیچ KPI ای جعل نمی‌شود - هرجا داده کافی نیست، وضعیت صریح (NOT_READY/
    INSUFFICIENT_DATA/PARTIAL/READY) نمایش داده می‌شود، نه یک صفر یا درصد ساختگی.
</p>

<div class="content-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">@Localizer["From"]</label>
            <input type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">To</label>
            <input type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2"><pems-button tone="primary" size="small" type="submit">@Localizer["Apply"]</pems-button></div>
        <div class="col-md-4 text-muted small">
            Period: @(from?.ToString("yyyy-MM-dd") ?? "all history") → @(to?.ToString("yyyy-MM-dd") ?? "now")
        </div>
    </form>
</div>

@* ===================== Executive KPI Row ===================== *@
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card h-100">
            <div class="small text-muted">@Localizer["PM Compliance"]</div>
            <div class="fs-4 fw-bold">
                @(pmCompliance.CompliancePercent.HasValue ? $"{pmCompliance.CompliancePercent.Value:N1}%" : "N/A")
            </div>
            <span class="badge @DataStatusBadge(pmCompliance.DataStatus)">@pmCompliance.DataStatus</span>
            @if (pmCompliance.DataStatusReason != null) { <div class="small text-muted mt-1">@pmCompliance.DataStatusReason</div> }
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100">
            <div class="small text-muted">Corrective Work %</div>
            <div class="fs-4 fw-bold">@(effectiveness.CorrectiveWorkloadPercent.HasValue ? $"{effectiveness.CorrectiveWorkloadPercent.Value:N1}%" : "N/A")</div>
            <div class="small text-muted">Last @effectiveness.WindowDays days</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100">
            <div class="small text-muted">Emergency Work %</div>
            <div class="fs-4 fw-bold">@(breakdown.EmergencyWorkRatioPercent.HasValue ? $"{breakdown.EmergencyWorkRatioPercent.Value:N1}%" : "N/A")</div>
            <div class="small text-muted">@breakdown.EmergencyWorkOrderCount of @breakdown.TotalWorkOrdersInPeriod Work Orders</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100">
            <div class="small text-muted">@Localizer["Repeat Failure Groups"]</div>
            <div class="fs-4 fw-bold">@repeatFailures.Count</div>
            <div class="small text-muted">Window: @(repeatFailures.FirstOrDefault()?.WindowDays ?? 90) days</div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-pm">@Localizer["PM Compliance"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-type">Maintenance Type</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-repeat">Repeat Failures</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-effectiveness">Effectiveness</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-matrix">Criticality Matrix</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-matrix2">Criticality × Maintenance/RCM</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-pm">
        <div class="content-card">
            <p class="text-muted small">
                مخرج فقط WorkOrder هایی است که از یک Maintenance Plan تولید شده‌اند و DueDate واقعی
                دارند. Not Yet Due/Cancelled/Insufficient Data هرگز به‌عنوان «عدم انطباق» شمرده نمی‌شوند.
            </p>
            <div class="row g-2 small">
                <div class="col-md-2"><strong>Total in Scope</strong><div>@pmCompliance.TotalQualifyingWorkOrders</div></div>
                <div class="col-md-2"><strong>@Localizer["Compliant"]</strong><div class="text-success">@pmCompliance.CompliantCount</div></div>
                <div class="col-md-2"><strong>@Localizer["Completed Late"]</strong><div class="text-warning">@pmCompliance.CompletedLateCount</div></div>
                <div class="col-md-2"><strong>@Localizer["Overdue"]</strong><div class="text-danger">@pmCompliance.OverdueCount</div></div>
                <div class="col-md-2"><strong>@Localizer["Not Yet Due"]</strong><div>@pmCompliance.NotYetDueCount</div></div>
                <div class="col-md-1"><strong>@Localizer["Cancelled"]</strong><div>@pmCompliance.CancelledCount</div></div>
                <div class="col-md-1"><strong>Insufficient Data</strong><div>@pmCompliance.InsufficientDataCount</div></div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-type">
        <div class="content-card">
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Type"]</th><th class="text-end">@Localizer["Count"]</th><th class="text-end">%</th><th class="text-end">Hours</th><th class="text-end">@Localizer["Cost"]</th><th class="text-end">@Localizer["Downtime"]</th></tr></thead>
                <tbody>
                    @foreach (var item in breakdown.Items)
                    {
                        <tr>
                            <td>@item.TypeName</td>
                            <td class="text-end">@item.Count</td>
                            <td class="text-end">@(item.Percent.HasValue ? $"{item.Percent.Value:N1}%" : "N/A")</td>
                            <td class="text-end">@(item.TotalHours.HasValue ? $"{item.TotalHours.Value:N1}" : "N/A")</td>
                            <td class="text-end">@(item.TotalCost.HasValue ? item.TotalCost.Value.ToString("N0") : "N/A")</td>
                            <td class="text-end">@(item.TotalDowntimeHours.HasValue ? $"{item.TotalDowntimeHours.Value:N1}h" : "No Recorded Downtime")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!breakdown.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-repeat">
        <div class="content-card">
            <p class="text-muted small">قاعده: همان تجهیز + همان حالت‌خرابی، با حداقل یک زوج خرابی متوالی در پنجره‌ی زمانی مشخص.</p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Tag"]</th><th>@Localizer["Failure Mode"]</th><th class="text-end">Occurrences</th><th>First</th><th>Last</th><th class="text-end">Window (days)</th></tr></thead>
                <tbody>
                    @foreach (var g in repeatFailures)
                    {
                        <tr>
                            <td class="fw-bold">@g.TagNumber</td>
                            <td>@g.FailureModeKey</td>
                            <td class="text-end">@g.OccurrenceCount</td>
                            <td class="small">@g.FirstOccurrence.ToString("yyyy-MM-dd")</td>
                            <td class="small">@g.LastOccurrence.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@g.WindowDays</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!repeatFailures.Any()) { <p class="text-muted text-center py-4 mb-0">No Data Available - هیچ خرابی تکراری در این بازه تشخیص داده نشد.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-effectiveness">
        <div class="content-card">
            <p class="text-muted small">
                شواهد چندبعدی - نه یک امتیاز واحد. مقایسه‌ی @effectiveness.WindowDays روز اخیر
                (از @effectiveness.CurrentPeriodStart.ToString("yyyy-MM-dd")) با @effectiveness.WindowDays روز پیش از آن.
            </p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>Dimension</th><th>Current Period</th><th>Prior Period</th><th>@Localizer["Trend"]</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Failure Count"]</td>
                        <td>@effectiveness.CurrentPeriodFailureCount</td>
                        <td>@effectiveness.PriorPeriodFailureCount</td>
                        <td><span class="badge @TrendBadge(effectiveness.FailureFrequencyTrend)">@effectiveness.FailureFrequencyTrend</span></td>
                    </tr>
                    <tr>
                        <td>Average MTTR</td>
                        <td>@(effectiveness.CurrentPeriodAverageMTTRHours.HasValue ? $"{effectiveness.CurrentPeriodAverageMTTRHours.Value:N1}h" : "N/A")</td>
                        <td>@(effectiveness.PriorPeriodAverageMTTRHours.HasValue ? $"{effectiveness.PriorPeriodAverageMTTRHours.Value:N1}h" : "N/A")</td>
                        <td><span class="badge @TrendBadge(effectiveness.MttrTrend)">@effectiveness.MttrTrend</span></td>
                    </tr>
                    <tr>
                        <td>@Localizer["Downtime"]</td>
                        <td>@effectiveness.CurrentPeriodDowntimeHours.ToString("N1")h</td>
                        <td>@effectiveness.PriorPeriodDowntimeHours.ToString("N1")h</td>
                        <td><span class="badge @TrendBadge(effectiveness.DowntimeTrend)">@effectiveness.DowntimeTrend</span></td>
                    </tr>
                </tbody>
            </table>
            <div class="row g-2 small mt-2">
                <div class="col-md-4"><strong>PM Compliance (current period)</strong><div>@(effectiveness.PmCompliancePercent.HasValue ? $"{effectiveness.PmCompliancePercent.Value:N1}%" : "N/A") <span class="badge @DataStatusBadge(effectiveness.PmComplianceDataStatus)">@effectiveness.PmComplianceDataStatus</span></div></div>
                <div class="col-md-4"><strong>@Localizer["Repeat Failure Groups"]</strong><div>@effectiveness.RepeatFailureGroupCount</div></div>
                <div class="col-md-4"><strong>Emergency Workload</strong><div>@(effectiveness.EmergencyWorkloadPercent.HasValue ? $"{effectiveness.EmergencyWorkloadPercent.Value:N1}%" : "N/A")</div></div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-matrix">
        <div class="content-card">
            <p class="text-muted small">یافته‌های هوشمندی - نه تصمیم خودکار. هر یافته با مقایسه‌ی صریح با میانگین ناوگان تولید می‌شود.</p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Criticality"]</th><th class="text-end">@Localizer["Equipment"]</th><th class="text-end">@Localizer["With History"]</th><th class="text-end">@Localizer["Failures"]</th><th class="text-end">@Localizer["Downtime"]</th><th class="text-end">Repeat Groups</th><th class="text-end">@Localizer["PM Compliance"]</th><th>@Localizer["Findings"]</th></tr></thead>
                <tbody>
                    @foreach (var row in criticalityMatrix)
                    {
                        <tr>
                            <td class="fw-bold">@row.CriticalityClass</td>
                            <td class="text-end">@row.EquipmentCount</td>
                            <td class="text-end">@row.EquipmentWithFailureHistoryCount</td>
                            <td class="text-end">@row.FailureCount</td>
                            <td class="text-end">@row.TotalDowntimeHours.ToString("N1")h</td>
                            <td class="text-end">@row.RepeatFailureGroupCount</td>
                            <td class="text-end">@(row.PmCompliancePercent.HasValue ? $"{row.PmCompliancePercent.Value:N1}%" : "N/A")</td>
                            <td class="small">
                                @if (row.Findings.Any())
                                {
                                    @foreach (var f in row.Findings) { <div class="text-warning">⚠ @f</div> }
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!criticalityMatrix.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>

    @* ===================== Phase 9: Criticality × Failure × Maintenance/RCM ===================== *@
    <div class="tab-pane fade" id="tab-matrix2">
        <div class="content-card">
            <p class="text-muted small">
                طبق «PEMS Phase 9» بند ۹: بُعد MaintenanceStrategy/RCM اضافه‌شده روی همان گروه‌بندی
                بحرانیت - آیا تجهیزات این کلاس بحرانیت واقعاً استراتژی نگهداری فعال دارند، و آیا
                کلاس‌های تجهیز نماینده‌شان تحلیل RCM تاییدشده دارند.
            </p>
            @if (criticalityMaintenanceMatrix != null && criticalityMaintenanceMatrix.Any())
            {
                <table class="table table-enterprise table-sm mb-0">
                    <thead><tr><th>@Localizer["Criticality"]</th><th class="text-end">@Localizer["Equipment"]</th><th class="text-end">@Localizer["Strategy Coverage"]</th><th class="text-end">Equipment Classes</th><th class="text-end">Classes w/ Approved RCM</th><th>Strategy Type Mix</th><th>@Localizer["Findings"]</th></tr></thead>
                    <tbody>
                        @foreach (var row in criticalityMaintenanceMatrix)
                        {
                            <tr>
                                <td class="fw-bold">@row.CriticalityClass</td>
                                <td class="text-end">@row.EquipmentCount</td>
                                <td class="text-end">@row.StrategyCoveredEquipmentCount / @row.EquipmentCount (@row.StrategyCoveragePercent.ToString("N0")%)</td>
                                <td class="text-end">@row.DistinctEquipmentClassCount</td>
                                <td class="text-end">@row.EquipmentClassesWithApprovedRcmCount (@(row.RcmClassCoveragePercent.HasValue ? $"{row.RcmClassCoveragePercent.Value:N0}%" : "N/A"))</td>
                                <td class="small">
                                    @if (row.StrategyTypeMix.Any())
                                    {
                                        @string.Join(", ", row.StrategyTypeMix.Select(kv => $"{kv.Key}={kv.Value}"))
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <td class="small">
                                    @if (row.Findings.Any())
                                    {
                                        @foreach (var f in row.Findings) { <div class="text-warning">⚠ @f</div> }
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p>
            }
        </div>
    </div>
</div>
