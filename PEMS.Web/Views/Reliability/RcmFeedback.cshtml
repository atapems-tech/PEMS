@model List<PEMS.Application.DTOs.RcmReviewRecommendationDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var statusFilter = (string?)ViewBag.StatusFilter;
    var canGenerate = (bool)ViewBag.CanGenerate;
    var canReview = (bool)ViewBag.CanReview;

    string StatusBadge(string status) => status switch
    {
        "ACCEPTED" => "success",
        "REJECTED" => "neutral",
        "PENDING" => "warning",
        _ => "light"
    };

    string TriggerLabel(string reason) => reason switch
    {
        "RepeatFailure" => "Repeat Failure",
        "HighFailureFrequency" => "High Failure Frequency",
        "HighDowntime" => "High Downtime",
        "PoorPMEffectiveness" => "Poor PM Effectiveness",
        _ => reason
    };
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Intelligence"><pems-icon name="bi-clipboard-data-fill" /> @Localizer["Maintenance Intelligence"]</pems-button>
        @if (canGenerate)
        {
            <pems-form asp-action="GenerateRcmEvidence" method="post" class="d-inline">
                <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-search" /> Generate Evidence</pems-button>
            </pems-form>
        }
    </div>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 7» بند ۲۰: این‌جا فقط شواهد و توصیه‌ی بازبینی تولید می‌شود - هیچ‌چیز خودکار
    تغییر نمی‌کند. پذیرفتن یک توصیه یعنی مهندس با تغییر دستی MaintenanceStrategy/MaintenancePlan
    موافق است؛ آن تغییر همچنان جدا و توسط خودِ مهندس (با ابزارهای موجود) انجام می‌شود.
</p>

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2" css="align-items-end">
        <pems-col md="3">
            <pems-label css="small">@Localizer["Status"]</pems-label>
            <pems-select scale="small" name="status" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(statusFilter))">All</option>
                <option value="PENDING" selected="@(statusFilter == "PENDING")">Pending</option>
                <option value="ACCEPTED" selected="@(statusFilter == "ACCEPTED")">Accepted</option>
                <option value="REJECTED" selected="@(statusFilter == "REJECTED")">Rejected</option>
            </pems-select>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["Equipment"]</pems-table-header><pems-table-header>@Localizer["Strategy"]</pems-table-header><pems-table-header>@Localizer["Trigger"]</pems-table-header><pems-table-header>Evidence</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header>
                <pems-table-header>Generated</pems-table-header><pems-table-header>Reviewed</pems-table-header><pems-table-header></pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var r in Model)
            {
                <pems-table-row>
                    <pems-table-cell class="fw-bold">@r.EquipmentTagNumber</pems-table-cell>
                    <pems-table-cell class="small text-muted">@(r.MaintenanceStrategyType ?? "-") @(r.FailureModeCode != null ? $"({r.FailureModeCode})" : "")</pems-table-cell>
                    <pems-table-cell><pems-badge tone="info">@TriggerLabel(r.TriggerReason)</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">@r.Evidence</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@StatusBadge(r.Status)">@r.Status</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">@r.GeneratedDate.ToString("yyyy-MM-dd")</pems-table-cell>
                    <pems-table-cell class="small text-muted">
                        @if (r.ReviewedBy != null)
                        {
                            @($"{r.ReviewedBy} · {r.ReviewedAt:yyyy-MM-dd}")
                            @if (r.ReviewNotes != null) { <div>@r.ReviewNotes</div> }
                        }
                        else { <span>-</span> }
                    </pems-table-cell>
                    <pems-table-cell>
                        @if (r.Status == "PENDING" && canReview)
                        {
                            <pems-form asp-action="ReviewRcmRecommendation" method="post" class="d-inline">
                                <input type="hidden" name="recommendationId" value="@r.RcmReviewRecommendationId" />
                                <input type="hidden" name="accept" value="true" />
                                <pems-button tone="success" size="small" outline="true" type="submit"><pems-icon name="bi-check-lg" /></pems-button>
                            </pems-form>
                            <pems-form asp-action="ReviewRcmRecommendation" method="post" class="d-inline">
                                <input type="hidden" name="recommendationId" value="@r.RcmReviewRecommendationId" />
                                <input type="hidden" name="accept" value="false" />
                                <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-x-lg" /></pems-button>
                            </pems-form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هیچ توصیه‌ای موجود نیست. @(canGenerate ? "برای تولید شواهد، دکمه‌ی Generate Evidence را بزنید." : "")</p> }
</pems-content-card>
