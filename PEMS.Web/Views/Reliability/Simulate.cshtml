@model PEMS.Application.DTOs.ReliabilitySimulationDto
@{
    var equipmentId = (int)ViewBag.EquipmentId;

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "NOT_READY" => "neutral",
        _ => "light"
    };
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Ram" asp-route-id="@equipmentId">← RAM / Weibull</pems-button>
</div>

<pems-alert tone="warning" css="small">
    <strong>Provenance = SIMULATED.</strong> این نتیجه یک برون‌یابی احتمالاتی از پارامترهای محاسبه‌شده
    است - هرگز به‌عنوان عملکرد واقعی کارخانه تفسیر نشود. @Model.MethodologyNote
</pems-alert>

<pems-badge tone="@StatusBadge(Model.DataStatus)">@Model.DataStatus</pems-badge>
@if (Model.Reason != null) { <p class="text-muted small mt-2">@Model.Reason</p> }

@if (Model.DataStatus == "READY")
{
    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <pems-kpi-tile label="Mean Availability">@Model.MeanAvailabilityPercent?.ToString("N2")%</pems-kpi-tile>
        </div>
        <div class="col-md-3">
            <pems-kpi-tile label="P10 – P90 Range">@Model.P10AvailabilityPercent?.ToString("N2")% – @Model.P90AvailabilityPercent?.ToString("N2")%</pems-kpi-tile>
        </div>
        <div class="col-md-3">
            <pems-kpi-tile label="Mean Downtime / @Model.SimulatedHorizonHours.ToString("N0")h">@Model.MeanDowntimeHours?.ToString("N1")h</pems-kpi-tile>
        </div>
        <div class="col-md-3">
            <pems-kpi-tile label="Mean Failure Count">@Model.MeanFailureCount?.ToString("N1")</pems-kpi-tile>
        </div>
    </div>
    <p class="text-muted small mt-3">Inputs: β=@Model.InputBeta?.ToString("N3"), η=@Model.InputEta?.ToString("N1")h, MTTR=@Model.InputMTTRHours?.ToString("N1")h — @Model.Iterations iterations.</p>
}
