@model List<PEMS.Application.DTOs.EquipmentReliabilityDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var classReliability = (List<EquipmentClassReliabilityDto>)ViewBag.ClassReliability;
    var failureModePareto = (List<FailureParetoItemDto>)ViewBag.FailureModePareto;
    var failureCausePareto = (List<FailureParetoItemDto>)ViewBag.FailureCausePareto;
    var badActors = (List<BadActorDto>)ViewBag.BadActors;
    var monthlyTrend = (List<ReliabilityTrendPointDto>)ViewBag.MonthlyTrend;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
}

<div class="d-flex justify-content-end align-items-center mb-2">
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Dashboard"><i class="bi bi-speedometer"></i> Enterprise Dashboard</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Intelligence"><i class="bi bi-clipboard-data-fill"></i> @Localizer["Maintenance Intelligence"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="RcmFeedback"><i class="bi bi-arrow-repeat"></i> @Localizer["RCM Feedback"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="DataQuality"><i class="bi bi-clipboard-data"></i> Data Quality</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="PredictiveMaintenance"><i class="bi bi-cpu"></i> @Localizer["Predictive"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ConditionMonitoring"><i class="bi bi-activity"></i> @Localizer["Condition Monitoring"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AiInsights"><i class="bi bi-stars"></i> @Localizer["AI Insights"]</pems-button>
    </div>
</div>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 - CMMS-06: MTBF/MTTR/Availability محاسبه‌شده از روی
    FailureRecord های واقعی (خرابی‌های ثبت‌شده هنگام تکمیل WorkOrder های اصلاحی/اضطراری).
    تجهیزاتی که هیچ خرابی ثبت‌شده‌ای ندارند در این لیست نمی‌آیند. بدترین‌ها (کمترین Availability) بالای لیست‌اند.
    جایی که داده‌ی کافی برای محاسبه نیست، N/A نمایش داده می‌شود - هرگز صفر جعلی.
</p>

<div class="content-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">@Localizer["From"]</label>
            <input type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">To</label>
            <input type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2"><pems-button tone="primary" size="small" type="submit">@Localizer["Apply"]</pems-button></div>
        <div class="col-md-4 text-muted small">
            Period: @(from?.ToString("yyyy-MM-dd") ?? "all history") → @(to?.ToString("yyyy-MM-dd") ?? "now")
        </div>
    </form>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-fleet">Fleet</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-class">By Equipment Class</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pareto">Failure Pareto</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-badactors">@Localizer["Bad Actors"]</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-trend">@Localizer["Trend"]</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-fleet">
        <div class="content-card">
            <table class="table table-enterprise mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Tag Number"]</th><th>@Localizer["Type"]</th><th>@Localizer["Failures"]</th><th>@Localizer["MTBF"]</th><th>@Localizer["MTTR"]</th>
                        <th>@Localizer["Availability"]</th><th>@Localizer["Total Downtime"]</th><th>Last Failure</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="small fw-bold">@r.TagNumber</td>
                            <td class="small">@r.EquipmentType</td>
                            <td class="small">@r.FailureCount</td>
                            <td class="small">@(r.MTBFHours.HasValue ? $"{r.MTBFHours.Value:N1} h" : "N/A")</td>
                            <td class="small">@(r.MTTRHours.HasValue ? $"{r.MTTRHours.Value:N1} h" : "N/A")</td>
                            <td class="small">
                                @if (r.AvailabilityPercent.HasValue)
                                {
                                    <span class="badge @(r.AvailabilityPercent >= 95 ? "bg-success" : r.AvailabilityPercent >= 85 ? "bg-warning text-dark" : "bg-danger")">
                                        @r.AvailabilityPercent.Value.ToString("N1")%
                                    </span>
                                }
                                else { <span class="text-muted">N/A</span> }
                            </td>
                            <td class="small">@r.TotalDowntimeHours.ToString("N1") h</td>
                            <td class="small">@(r.LastFailureDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@r.EquipmentId"><i class="bi bi-eye"></i></pems-button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز هیچ خرابی‌ای ثبت نشده - این لیست از روی WorkOrder های اصلاحی/اضطراری تکمیل‌شده ساخته می‌شود.</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-class">
        <div class="content-card">
            <p class="text-muted small">
                میانگین مقادیر معتبر سطح-تجهیز درون هر کلاس (نه یک نرخ Pooled روی زمان
                بهره‌برداری) - Sample Size نشان می‌دهد چند تجهیز واقعاً در میانگین سهیم بودند.
            </p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Class"]</th><th>@Localizer["Population"]</th><th>@Localizer["With History"]</th><th>@Localizer["Failures"]</th><th>@Localizer["Downtime"]</th><th>Avg MTBF (n)</th><th>Avg MTTR (n)</th><th>Avg Availability</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in classReliability)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td class="text-end">@c.EquipmentPopulation</td>
                            <td class="text-end">@c.EquipmentWithFailureHistory</td>
                            <td class="text-end">@c.FailureCount</td>
                            <td class="text-end">@c.TotalDowntimeHours.ToString("N1") h</td>
                            <td class="text-end">@(c.AverageMTBFHours.HasValue ? $"{c.AverageMTBFHours.Value:N1}h (n={c.MTBFSampleSize})" : "N/A")</td>
                            <td class="text-end">@(c.AverageMTTRHours.HasValue ? $"{c.AverageMTTRHours.Value:N1}h (n={c.MTTRSampleSize})" : "N/A")</td>
                            <td class="text-end">@(c.AverageAvailabilityPercent.HasValue ? $"{c.AverageAvailabilityPercent.Value:N1}%" : "N/A")</td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ClassDetail" asp-route-id="@c.EquipmentClassId">Open</pems-button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!classReliability.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هیچ کلاسی داده‌ی خرابی کافی ندارد."]</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-pareto">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="content-card h-100">
                    <h6 class="mb-3">Failure Mode Pareto</h6>
                    <table class="table table-enterprise table-sm mb-0">
                        <thead><tr><th>@Localizer["Failure Mode"]</th><th class="text-end">@Localizer["Count"]</th><th class="text-end">@Localizer["Downtime"]</th><th class="text-end">@Localizer["Cumulative %"]</th></tr></thead>
                        <tbody>
                            @foreach (var p in failureModePareto)
                            {
                                <tr><td>@p.Key</td><td class="text-end">@p.Count</td><td class="text-end">@p.DowntimeHours.ToString("N1")h</td><td class="text-end">@p.CumulativePercent.ToString("N1")%</td></tr>
                            }
                        </tbody>
                    </table>
                    @if (!failureModePareto.Any()) { <p class="text-muted small text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
                </div>
            </div>
            <div class="col-md-6">
                <div class="content-card h-100">
                    <h6 class="mb-3">Failure Cause Pareto</h6>
                    <table class="table table-enterprise table-sm mb-0">
                        <thead><tr><th>Failure Cause</th><th class="text-end">@Localizer["Count"]</th><th class="text-end">@Localizer["Downtime"]</th><th class="text-end">@Localizer["Cumulative %"]</th></tr></thead>
                        <tbody>
                            @foreach (var p in failureCausePareto)
                            {
                                <tr><td>@p.Key</td><td class="text-end">@p.Count</td><td class="text-end">@p.DowntimeHours.ToString("N1")h</td><td class="text-end">@p.CumulativePercent.ToString("N1")%</td></tr>
                            }
                        </tbody>
                    </table>
                    @if (!failureCausePareto.Any()) { <p class="text-muted small text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-badactors">
        <div class="content-card">
            <p class="text-muted small">هر رتبه با عوامل صریح توضیح داده می‌شود - نه یک امتیاز مبهم.</p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Tag"]</th><th>@Localizer["Class"]</th><th>@Localizer["Criticality"]</th><th class="text-end">@Localizer["Failures"]</th><th class="text-end">@Localizer["Repeat"]</th><th class="text-end">@Localizer["Downtime"]</th><th class="text-end">@Localizer["MTTR"]</th><th class="text-end">Maint. Count</th><th>Primary Mode / Cause</th><th>Why Ranked Here</th></tr></thead>
                <tbody>
                    @foreach (var b in badActors)
                    {
                        <tr>
                            <td class="fw-bold">@b.TagNumber</td>
                            <td class="small text-muted">@(b.EquipmentClassName ?? "-")</td>
                            <td class="small text-muted">@(b.CriticalityClass ?? "-")</td>
                            <td class="text-end">@b.FailureCount</td>
                            <td class="text-end">@(b.RepeatFailureCount ?? 0)</td>
                            <td class="text-end">@b.TotalDowntimeHours.ToString("N1")h</td>
                            <td class="text-end">@(b.MTTRHours.HasValue ? $"{b.MTTRHours.Value:N1}h" : "N/A")</td>
                            <td class="text-end">@(b.MaintenanceCount ?? 0)</td>
                            <td class="small text-muted">@(b.PrimaryFailureMode ?? "-") / @(b.PrimaryFailureCause ?? "-")</td>
                            <td class="small text-muted">@string.Join(" · ", b.RankFactors)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!badActors.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-trend">
        <div class="content-card">
            <p class="text-muted small">هر نقطه تعداد رویداد واقعی (Observation Count) خودش را نشان می‌دهد - روندهای با نمونه‌ی کوچک باید با احتیاط تفسیر شوند.</p>
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>Period</th><th class="text-end">Failures (Observations)</th><th class="text-end">@Localizer["Downtime"]</th></tr></thead>
                <tbody>
                    @foreach (var t in monthlyTrend)
                    {
                        <tr><td>@t.PeriodLabel</td><td class="text-end">@t.FailureCount</td><td class="text-end">@t.TotalDowntimeHours.ToString("N1")h</td></tr>
                    }
                </tbody>
            </table>
            @if (!monthlyTrend.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>
</div>
