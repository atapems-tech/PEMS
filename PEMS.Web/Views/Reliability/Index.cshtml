@model List<PEMS.Application.DTOs.EquipmentReliabilityDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var classReliability = (List<EquipmentClassReliabilityDto>)ViewBag.ClassReliability;
    var failureModePareto = (List<FailureParetoItemDto>)ViewBag.FailureModePareto;
    var failureCausePareto = (List<FailureParetoItemDto>)ViewBag.FailureCausePareto;
    var badActors = (List<BadActorDto>)ViewBag.BadActors;
    var monthlyTrend = (List<ReliabilityTrendPointDto>)ViewBag.MonthlyTrend;
    DateTime? from = ViewBag.From;
    DateTime? to = ViewBag.To;
}

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Dashboard"><pems-icon name="bi-speedometer" /> Enterprise Dashboard</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Intelligence"><pems-icon name="bi-clipboard-data-fill" /> @Localizer["Maintenance Intelligence"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="RcmFeedback"><pems-icon name="bi-arrow-repeat" /> @Localizer["RCM Feedback"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="DataQuality"><pems-icon name="bi-clipboard-data" /> Data Quality</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="PredictiveMaintenance"><pems-icon name="bi-cpu" /> @Localizer["Predictive"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ConditionMonitoring"><pems-icon name="bi-activity" /> @Localizer["Condition Monitoring"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AiInsights"><pems-icon name="bi-stars" /> @Localizer["AI Insights"]</pems-button>
    </div>
</pems-flex>
<p class="text-muted small">
    طبق CMMS Production Baseline v1 - CMMS-06: MTBF/MTTR/Availability محاسبه‌شده از روی
    FailureRecord های واقعی (خرابی‌های ثبت‌شده هنگام تکمیل WorkOrder های اصلاحی/اضطراری).
    تجهیزاتی که هیچ خرابی ثبت‌شده‌ای ندارند در این لیست نمی‌آیند. بدترین‌ها (کمترین Availability) بالای لیست‌اند.
    جایی که داده‌ی کافی برای محاسبه نیست، N/A نمایش داده می‌شود - هرگز صفر جعلی.
</p>

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2" css="align-items-end">
        <pems-col md="3">
            <pems-label css="small">@Localizer["From"]</pems-label>
            <pems-date name="from" value="@(from?.ToString("yyyy-MM-dd"))" scale="small" />
        </pems-col>
        <pems-col md="3">
            <pems-label css="small">To</pems-label>
            <pems-date name="to" value="@(to?.ToString("yyyy-MM-dd"))" scale="small" />
        </pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" type="submit">@Localizer["Apply"]</pems-button></pems-col>
        <pems-col md="4" css="text-muted small">
            Period: @(from?.ToString("yyyy-MM-dd") ?? "all history") → @(to?.ToString("yyyy-MM-dd") ?? "now")
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-nav css="mb-3">
    <li class="nav-item"><pems-button plain="true" css="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-fleet">Fleet</pems-button></li>
    <li class="nav-item"><pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-class">By Equipment Class</pems-button></li>
    <li class="nav-item"><pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pareto">Failure Pareto</pems-button></li>
    <li class="nav-item"><pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-badactors">@Localizer["Bad Actors"]</pems-button></li>
    <li class="nav-item"><pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-trend">@Localizer["Trend"]</pems-button></li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-fleet">
        <pems-content-card>
            <pems-table kind="enterprise" css="mb-0">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["Tag Number"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Failures"]</pems-table-header><pems-table-header>@Localizer["MTBF"]</pems-table-header><pems-table-header>@Localizer["MTTR"]</pems-table-header>
                        <pems-table-header>@Localizer["Availability"]</pems-table-header><pems-table-header>@Localizer["Total Downtime"]</pems-table-header><pems-table-header>Last Failure</pems-table-header><pems-table-header></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var r in Model)
                    {
                        <pems-table-row>
                            <pems-table-cell class="small fw-bold">@r.TagNumber</pems-table-cell>
                            <pems-table-cell class="small">@r.EquipmentType</pems-table-cell>
                            <pems-table-cell class="small">@r.FailureCount</pems-table-cell>
                            <pems-table-cell class="small">@(r.MTBFHours.HasValue ? $"{r.MTBFHours.Value:N1} h" : "N/A")</pems-table-cell>
                            <pems-table-cell class="small">@(r.MTTRHours.HasValue ? $"{r.MTTRHours.Value:N1} h" : "N/A")</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (r.AvailabilityPercent.HasValue)
                                {
                                    <pems-badge tone="@(r.AvailabilityPercent >= 95 ? "success" : r.AvailabilityPercent >= 85 ? "warning" : "danger")">
                                        @r.AvailabilityPercent.Value.ToString("N1")%
                                    </pems-badge>
                                }
                                else { <span class="text-muted">N/A</span> }
                            </pems-table-cell>
                            <pems-table-cell class="small">@r.TotalDowntimeHours.ToString("N1") h</pems-table-cell>
                            <pems-table-cell class="small">@(r.LastFailureDate?.ToString("yyyy-MM-dd") ?? "-")</pems-table-cell>
                            <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@r.EquipmentId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هنوز هیچ خرابی‌ای ثبت نشده - این لیست از روی WorkOrder های اصلاحی/اضطراری تکمیل‌شده ساخته می‌شود.</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-class">
        <pems-content-card>
            <p class="text-muted small">
                میانگین مقادیر معتبر سطح-تجهیز درون هر کلاس (نه یک نرخ Pooled روی زمان
                بهره‌برداری) - Sample Size نشان می‌دهد چند تجهیز واقعاً در میانگین سهیم بودند.
            </p>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Class"]</pems-table-header><pems-table-header>@Localizer["Population"]</pems-table-header><pems-table-header>@Localizer["With History"]</pems-table-header><pems-table-header>@Localizer["Failures"]</pems-table-header><pems-table-header>@Localizer["Downtime"]</pems-table-header><pems-table-header>Avg MTBF (n)</pems-table-header><pems-table-header>Avg MTTR (n)</pems-table-header><pems-table-header>Avg Availability</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var c in classReliability)
                    {
                        <pems-table-row>
                            <pems-table-cell>@c.Name</pems-table-cell>
                            <pems-table-cell class="text-end">@c.EquipmentPopulation</pems-table-cell>
                            <pems-table-cell class="text-end">@c.EquipmentWithFailureHistory</pems-table-cell>
                            <pems-table-cell class="text-end">@c.FailureCount</pems-table-cell>
                            <pems-table-cell class="text-end">@c.TotalDowntimeHours.ToString("N1") h</pems-table-cell>
                            <pems-table-cell class="text-end">@(c.AverageMTBFHours.HasValue ? $"{c.AverageMTBFHours.Value:N1}h (n={c.MTBFSampleSize})" : "N/A")</pems-table-cell>
                            <pems-table-cell class="text-end">@(c.AverageMTTRHours.HasValue ? $"{c.AverageMTTRHours.Value:N1}h (n={c.MTTRSampleSize})" : "N/A")</pems-table-cell>
                            <pems-table-cell class="text-end">@(c.AverageAvailabilityPercent.HasValue ? $"{c.AverageAvailabilityPercent.Value:N1}%" : "N/A")</pems-table-cell>
                            <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ClassDetail" asp-route-id="@c.EquipmentClassId">Open</pems-button></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!classReliability.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هیچ کلاسی داده‌ی خرابی کافی ندارد."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-pareto">
        <pems-row gap="3">
            <pems-col md="6">
                <pems-content-card css="h-100">
                    <h6 class="mb-3">Failure Mode Pareto</h6>
                    <pems-data-table data="@(DataRows.Of(failureModePareto, c_ => c_.Add(((Localizer["Failure Mode"])?.ToString() ?? ""), p => (object?)(p.Key)).Add(((Localizer["Count"])?.ToString() ?? ""), p => (object?)(p.Count), css: "text-end", headerCss: "text-end").Add(((Localizer["Downtime"])?.ToString() ?? ""), p => DataCell.Join((p.DowntimeHours.ToString("N1")), "h"), css: "text-end", headerCss: "text-end").Add(((Localizer["Cumulative %"])?.ToString() ?? ""), p => DataCell.Join((p.CumulativePercent.ToString("N1")), "%"), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
                    @if (!failureModePareto.Any()) { <p class="text-muted small text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
                </pems-content-card>
            </pems-col>
            <pems-col md="6">
                <pems-content-card css="h-100">
                    <h6 class="mb-3">Failure Cause Pareto</h6>
                    <pems-data-table data="@(DataRows.Of(failureCausePareto, c_ => c_.Add("Failure Cause", p => (object?)(p.Key)).Add(((Localizer["Count"])?.ToString() ?? ""), p => (object?)(p.Count), css: "text-end", headerCss: "text-end").Add(((Localizer["Downtime"])?.ToString() ?? ""), p => DataCell.Join((p.DowntimeHours.ToString("N1")), "h"), css: "text-end", headerCss: "text-end").Add(((Localizer["Cumulative %"])?.ToString() ?? ""), p => DataCell.Join((p.CumulativePercent.ToString("N1")), "%"), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
                    @if (!failureCausePareto.Any()) { <p class="text-muted small text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
                </pems-content-card>
            </pems-col>
        </pems-row>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-badactors">
        <pems-content-card>
            <p class="text-muted small">هر رتبه با عوامل صریح توضیح داده می‌شود - نه یک امتیاز مبهم.</p>
            <pems-data-table data="@(DataRows.Of(badActors, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), b => (object?)(b.TagNumber), css: "fw-bold").Add(((Localizer["Class"])?.ToString() ?? ""), b => (object?)(b.EquipmentClassName ?? "-"), css: "small text-muted").Add(((Localizer["Criticality"])?.ToString() ?? ""), b => (object?)(b.CriticalityClass ?? "-"), css: "small text-muted").Add(((Localizer["Failures"])?.ToString() ?? ""), b => (object?)(b.FailureCount), css: "text-end", headerCss: "text-end").Add(((Localizer["Repeat"])?.ToString() ?? ""), b => (object?)(b.RepeatFailureCount ?? 0), css: "text-end", headerCss: "text-end").Add(((Localizer["Downtime"])?.ToString() ?? ""), b => DataCell.Join((b.TotalDowntimeHours.ToString("N1")), "h"), css: "text-end", headerCss: "text-end").Add(((Localizer["MTTR"])?.ToString() ?? ""), b => (object?)(b.MTTRHours.HasValue ? $"{b.MTTRHours.Value:N1}h" : "N/A"), css: "text-end", headerCss: "text-end").Add("Maint. Count", b => (object?)(b.MaintenanceCount ?? 0), css: "text-end", headerCss: "text-end").Add("Primary Mode / Cause", b => DataCell.Join((b.PrimaryFailureMode ?? "-"), " / ", (b.PrimaryFailureCause ?? "-")), css: "small text-muted").Add("Why Ranked Here", b => (object?)(string.Join(" · ", b.RankFactors)), css: "small text-muted")))" dense="true" css="mb-0" />
            @if (!badActors.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-trend">
        <pems-content-card>
            <p class="text-muted small">هر نقطه تعداد رویداد واقعی (Observation Count) خودش را نشان می‌دهد - روندهای با نمونه‌ی کوچک باید با احتیاط تفسیر شوند.</p>
            <pems-data-table data="@(DataRows.Of(monthlyTrend, c_ => c_.Add("Period", t => (object?)(t.PeriodLabel)).Add("Failures (Observations)", t => (object?)(t.FailureCount), css: "text-end", headerCss: "text-end").Add(((Localizer["Downtime"])?.ToString() ?? ""), t => DataCell.Join((t.TotalDowntimeHours.ToString("N1")), "h"), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
            @if (!monthlyTrend.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-tab-pane>
</pems-tab-content>
