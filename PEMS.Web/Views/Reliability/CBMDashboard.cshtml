@model PEMS.Application.DTOs.CbmDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string EvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        "RequiresEngineeringReview" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

<pems-flex justify="end" align="center" gap="2" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Reliability"]</pems-button>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS — Equipment Passport Audit & CBM» فاز ۱ ممیزی §3.8: این داشبورد فقط تجمیع
    (Aggregation) روی داده‌ی واقعی موجود است - هیچ KPI جعلی/شبیه‌سازی‌شده این‌جا نمایش داده نمی‌شود.
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["Monitoring Points"]" sub="@Model.PointsWithEvaluationProfile @Localizer["با پروفایل ارزیابی"] · @Model.PointsWithCbmStrategy @Localizer["با استراتژی CBM"]">@Model.TotalActivePoints</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="danger" label="@Localizer["Critical"] / @Localizer["Alarm"]" sub="@Model.WarningCount @Localizer["Warning"] · @Model.RequiresEngineeringReviewCount @Localizer["Mark for Engineering Review"]">@(Model.CriticalCount + Model.AlarmCount)</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["Open Findings"]" sub="@Model.LinkedFindingCount @Localizer["Linked"]">@Model.OpenFindingCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="@(Model.OverdueCbmPlanCount > 0 ? "danger" : "")" label="@Localizer["Overdue"] CBM" sub="@Model.DueSoonCbmPlanCount @Localizer["Due Soon"]">@Model.OverdueCbmPlanCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card>
            <h6 class="mb-2">@Localizer["Needs Attention"]</h6>
            @if (Model.AttentionPoints.Count == 0)
            {
                <p class="text-muted small mb-0">@Localizer["هیچ نقطه‌ی پایشی در حال حاضر نیاز به توجه ندارد."]</p>
            }
            else
            {
                <pems-table scale="small">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Tag"]</pems-table-header><pems-table-header>@Localizer["Variable"]</pems-table-header><pems-table-header>@Localizer["Evaluation"]</pems-table-header><pems-table-header>@Localizer["Last Reading"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var p in Model.AttentionPoints)
                        {
                            <pems-table-row>
                                <pems-table-cell><a asp-controller="Equipment" asp-action="Details" asp-route-id="@p.EquipmentId">@p.EquipmentTagNumber</a></pems-table-cell>
                                <pems-table-cell class="small">@p.VariableType — @p.Tag</pems-table-cell>
                                <pems-table-cell><pems-badge tone="none" css="@EvalBadge(p.EvaluationStatus)">@p.EvaluationStatus</pems-badge></pems-table-cell>
                                <pems-table-cell class="small">@(p.LastReadingDate?.ToString("yyyy-MM-dd") ?? "-")</pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
                @if (Model.AttentionPointsTruncated)
                {
                    <div class="small text-muted">@Localizer["فهرست به بالاترین ۵۰ مورد محدود شده است."]</div>
                }
            }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card>
            <h6 class="mb-2">@Localizer["Overdue CBM Plans"]</h6>
            @if (Model.OverdueCbmPlans.Count == 0)
            {
                <p class="text-muted small mb-0">@Localizer["هیچ طرح CBM معوقی وجود ندارد."]</p>
            }
            else
            {
                <pems-table scale="small">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Tag"]</pems-table-header><pems-table-header>@Localizer["Variable"]</pems-table-header><pems-table-header>@Localizer["Next Due"]</pems-table-header><pems-table-header>@Localizer["Overdue"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var o in Model.OverdueCbmPlans)
                        {
                            <pems-table-row>
                                <pems-table-cell><a asp-controller="Equipment" asp-action="Details" asp-route-id="@o.EquipmentId">@o.EquipmentTagNumber</a></pems-table-cell>
                                <pems-table-cell class="small">@o.VariableType — @o.Tag</pems-table-cell>
                                <pems-table-cell class="small">@o.NextDueDate.ToString("yyyy-MM-dd")</pems-table-cell>
                                <pems-table-cell><pems-badge tone="danger">@o.DaysOverdue @Localizer["روز"]</pems-badge></pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
                @if (Model.OverdueCbmPlansTruncated)
                {
                    <div class="small text-muted">@Localizer["فهرست به بالاترین ۵۰ مورد محدود شده است."]</div>
                }
            }
        </pems-content-card>
    </pems-col>
</pems-row>
