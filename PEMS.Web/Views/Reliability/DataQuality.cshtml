@model PEMS.Application.DTOs.ReliabilityDataQualityDto

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard-data"></i> Reliability Data Quality</h5>
    <a asp-action="Index" class="small">← Fleet Reliability</a>
</div>
<p class="text-muted small">
    این صفحه هیچ رکوردی را تغییر نمی‌دهد - فقط نشان می‌دهد چه چیزی موجود است و چه چیزی غایب،
    تا کیفیت هر معیار قابلیت‌اطمینان شفاف باشد.
</p>

<div class="content-card mb-3">
    <div class="row g-3 text-center">
        <div class="col-md-3">
            <div class="fs-4 fw-bold">@Model.EquipmentReliabilityCoveragePercent.ToString("N1")%</div>
            <div class="text-muted small">Equipment Reliability Coverage</div>
        </div>
        <div class="col-md-3">
            <div class="fs-4 fw-bold">@Model.FailureTaxonomyCoveragePercent.ToString("N1")%</div>
            <div class="text-muted small">Failure Taxonomy Coverage</div>
        </div>
        <div class="col-md-3">
            <div class="fs-4 fw-bold">@Model.RepairDataCoveragePercent.ToString("N1")%</div>
            <div class="text-muted small">Repair Data Coverage</div>
        </div>
        <div class="col-md-3">
            <div class="fs-4 fw-bold">@Model.TotalFailureRecords</div>
            <div class="text-muted small">Total Failure Records</div>
        </div>
    </div>
</div>

<div class="content-card">
    <table class="table table-enterprise table-sm mb-0">
        <tbody>
            <tr><td>Total Active Equipment</td><td class="text-end">@Model.TotalActiveEquipment</td></tr>
            <tr><td>Equipment with Failure History</td><td class="text-end">@Model.EquipmentWithFailureHistory</td></tr>
            <tr><td>Failure Records without Failure Mode</td><td class="text-end">@Model.FailureRecordsWithoutFailureMode</td></tr>
            <tr><td>Failure Records without Failure Cause</td><td class="text-end">@Model.FailureRecordsWithoutFailureCause</td></tr>
            <tr><td>Failure Records without Downtime Hours</td><td class="text-end">@Model.FailureRecordsWithoutDowntimeHours</td></tr>
            <tr><td>Failure Records with Invalid (Future) Date</td><td class="text-end">@Model.FailureRecordsWithInvalidDate</td></tr>
            <tr><td>Failure Records Linked to WorkOrder Missing Start/Completion Date</td><td class="text-end">@Model.FailureRecordsLinkedToWorkOrderMissingDuration</td></tr>
            <tr><td>Failure Records with Negative Repair Duration</td><td class="text-end">@Model.FailureRecordsWithNegativeDuration</td></tr>
        </tbody>
    </table>
</div>
