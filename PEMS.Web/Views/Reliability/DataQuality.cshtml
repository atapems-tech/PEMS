@model PEMS.Application.DTOs.ReliabilityDataQualityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <a asp-action="Index" class="small">@Localizer["← Fleet Reliability"]</a>
</pems-flex>
<p class="text-muted small">
    این صفحه هیچ رکوردی را تغییر نمی‌دهد - فقط نشان می‌دهد چه چیزی موجود است و چه چیزی غایب،
    تا کیفیت هر معیار قابلیت‌اطمینان شفاف باشد.
</p>

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3">
            <pems-kpi-tile compact label="Equipment Reliability Coverage">@Model.EquipmentReliabilityCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="3">
            <pems-kpi-tile compact label="@Localizer["Failure Taxonomy Coverage"]">@Model.FailureTaxonomyCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="3">
            <pems-kpi-tile compact label="Repair Data Coverage">@Model.RepairDataCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="3">
            <pems-kpi-tile compact label="Total Failure Records">@Model.TotalFailureRecords</pems-kpi-tile>
        </pems-col>
    </pems-row>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-2">Maintenance Chain Coverage <pems-badge tone="light">Phase 7</pems-badge></h6>
    <pems-row gap="3">
        <pems-col md="2">
            <pems-kpi-tile compact label="Maintenance Type Completeness">@Model.MaintenanceTypeCompletenessPercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Work Order Completion Coverage">@Model.WorkOrderCompletionCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Criticality Coverage">@Model.CriticalityCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Maintenance Strategy Coverage">@Model.MaintenanceStrategyCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Maintenance Plan Coverage">@Model.MaintenancePlanCoveragePercent.ToString("N1")%</pems-kpi-tile>
        </pems-col>
    </pems-row>
</pems-content-card>

<pems-content-card>
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-body>
            <pems-table-row><pems-table-cell>@Localizer["Total Active Equipment"]</pems-table-cell><pems-table-cell class="text-end">@Model.TotalActiveEquipment</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>@Localizer["Equipment with Failure History"]</pems-table-cell><pems-table-cell class="text-end">@Model.EquipmentWithFailureHistory</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Equipment with Criticality</pems-table-cell><pems-table-cell class="text-end">@Model.EquipmentWithCriticality</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Equipment with Maintenance Strategy</pems-table-cell><pems-table-cell class="text-end">@Model.EquipmentWithMaintenanceStrategy</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Equipment with Maintenance Plan</pems-table-cell><pems-table-cell class="text-end">@Model.EquipmentWithMaintenancePlan</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records without Failure Mode</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsWithoutFailureMode</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records without Failure Cause</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsWithoutFailureCause</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records without Downtime Hours</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsWithoutDowntimeHours</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records with Invalid (Future) Date</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsWithInvalidDate</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records Linked to WorkOrder Missing Start/Completion Date</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsLinkedToWorkOrderMissingDuration</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Failure Records with Negative Repair Duration</pems-table-cell><pems-table-cell class="text-end">@Model.FailureRecordsWithNegativeDuration</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Total Work Orders</pems-table-cell><pems-table-cell class="text-end">@Model.TotalWorkOrders</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Work Orders Missing Work Order Type</pems-table-cell><pems-table-cell class="text-end">@Model.WorkOrdersMissingWorkOrderType</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Completed/Closed Work Orders</pems-table-cell><pems-table-cell class="text-end">@Model.CompletedOrClosedWorkOrders</pems-table-cell></pems-table-row>
            <pems-table-row><pems-table-cell>Completed/Closed Work Orders Missing Completion Date</pems-table-cell><pems-table-cell class="text-end">@Model.WorkOrdersMissingCompletionDate</pems-table-cell></pems-table-row>
        </pems-table-body>
    </pems-table>
</pems-content-card>
