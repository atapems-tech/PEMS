@model List<PEMS.Application.DTOs.EquipmentReliabilityDto>
@using PEMS.Application.DTOs
@{
    var classReliability = (List<EquipmentClassReliabilityDto>)ViewBag.ClassReliability;
    var badActors = (List<BadActorDto>)ViewBag.BadActors;
    var pareto = (List<FailureParetoItemDto>)ViewBag.FailureModePareto;
    var pmCompliance = (PmComplianceDto)ViewBag.PmCompliance;
    var breakdown = (MaintenanceTypeBreakdownDto)ViewBag.MaintenanceTypeBreakdown;
    var repeatFailures = (List<RepeatFailureGroupDto>)ViewBag.RepeatFailures;
    var criticalityMatrix = (List<CriticalityMatrixRowDto>)ViewBag.CriticalityFailureMatrix;
    var criticalityMaintenanceMatrix = (List<CriticalityFailureMaintenanceRowDto>)ViewBag.CriticalityFailureMaintenanceMatrix;
    var dataQuality = (ReliabilityDataQualityDto)ViewBag.DataQuality;
    var conditionMonitoring = (ConditionMonitoringFoundationStatusDto)ViewBag.ConditionMonitoring;
    var predictive = (PredictiveMaintenanceReadinessDto)ViewBag.Predictive;

    string StatusBadge(string status) => status switch
    {
        "READY" => "text-bg-success",
        "PARTIAL" => "text-bg-warning",
        "INSUFFICIENT_DATA" => "text-bg-warning",
        "NOT_READY" => "text-bg-secondary",
        _ => "text-bg-light border"
    };

    var totalEquipmentWithFailures = Model.Count;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-speedometer"></i> Enterprise Reliability Dashboard</h5>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Fleet Reliability</a>
        <a asp-action="Intelligence" class="btn btn-outline-secondary btn-sm">Maintenance Intelligence</a>
        <a asp-action="PredictiveMaintenance" class="btn btn-outline-secondary btn-sm">Predictive</a>
        <a asp-action="ConditionMonitoring" class="btn btn-outline-secondary btn-sm">Condition Monitoring</a>
        <a asp-action="AiInsights" class="btn btn-outline-secondary btn-sm">AI Insights</a>
    </div>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 9» بند ۲۰/۳۱: هیچ درصد/KPI جعلی این‌جا نمایش داده نمی‌شود - هرجا داده کافی
    نیست، N/A یا وضعیت صریح (NOT_READY/INSUFFICIENT_DATA) نشان داده می‌شود.
</p>

@* ===================== Executive Reliability ===================== *@
<h6 class="mt-4">Executive Reliability</h6>
<div class="row g-3 mb-3">
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@totalEquipmentWithFailures</div>
            <div class="text-muted small">Equipment with Failure History</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@(pmCompliance.CompliancePercent.HasValue ? $"{pmCompliance.CompliancePercent.Value:N1}%" : "N/A")</div>
            <div class="text-muted small">PM Compliance</div>
            <span class="badge @StatusBadge(pmCompliance.DataStatus)">@pmCompliance.DataStatus</span>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@(breakdown.Items.FirstOrDefault(x => x.TypeName == "Corrective")?.Percent is { } cp ? $"{cp:N1}%" : "N/A")</div>
            <div class="text-muted small">Corrective Ratio</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@(breakdown.EmergencyWorkRatioPercent.HasValue ? $"{breakdown.EmergencyWorkRatioPercent.Value:N1}%" : "N/A")</div>
            <div class="text-muted small">Emergency Ratio</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@repeatFailures.Count</div>
            <div class="text-muted small">Repeat Failure Groups</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@badActors.Count</div>
            <div class="text-muted small">Bad Actors (top list)</div>
        </div>
    </div>
</div>

@* ===================== Criticality ===================== *@
<h6 class="mt-4">Criticality</h6>
<div class="content-card mb-3">
    <div class="table-scroll-area" style="overflow-x:auto;">
    <table class="table table-enterprise table-sm mb-0">
        <thead><tr><th>Class</th><th class="text-end">Equipment</th><th class="text-end">Failures</th><th class="text-end">Repeat</th><th class="text-end">PM Compliance</th><th class="text-end">Strategy Coverage</th><th class="text-end">RCM Class Coverage</th></tr></thead>
        <tbody>
            @foreach (var row in criticalityMatrix)
            {
                var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass);
                <tr>
                    <td class="fw-bold">@row.CriticalityClass</td>
                    <td class="text-end">@row.EquipmentCount</td>
                    <td class="text-end">@row.FailureCount</td>
                    <td class="text-end">@row.RepeatFailureGroupCount</td>
                    <td class="text-end">@(row.PmCompliancePercent.HasValue ? $"{row.PmCompliancePercent.Value:N1}%" : "N/A")</td>
                    <td class="text-end">@(m2 != null ? $"{m2.StrategyCoveragePercent:N0}%" : "N/A")</td>
                    <td class="text-end">@(m2?.RcmClassCoveragePercent.HasValue == true ? $"{m2.RcmClassCoveragePercent.Value:N0}%" : "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <a asp-action="Intelligence" class="small">See full Criticality × Failure × Maintenance matrix with findings →</a>
</div>

@* ===================== Maintenance / Failure ===================== *@
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-2">Top Failure Modes (Pareto)</h6>
            <table class="table table-enterprise table-sm mb-0">
                <tbody>
                    @foreach (var p in pareto)
                    {
                        <tr><td>@p.Key</td><td class="text-end">@p.Count</td><td class="text-end small text-muted">@p.CumulativePercent.ToString("N0")%</td></tr>
                    }
                </tbody>
            </table>
            @if (!pareto.Any()) { <p class="text-muted text-center py-3 mb-0">داده‌ای موجود نیست.</p> }
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-2">Bad Actors</h6>
            <table class="table table-enterprise table-sm mb-0">
                <tbody>
                    @foreach (var b in badActors)
                    {
                        <tr>
                            <td><a asp-action="EquipmentProfile" asp-route-id="@b.EquipmentId">@b.TagNumber</a></td>
                            <td class="text-end">@b.FailureCount failures</td>
                            <td class="text-end small text-muted">@b.TotalDowntimeHours.ToString("N0")h</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!badActors.Any()) { <p class="text-muted text-center py-3 mb-0">داده‌ای موجود نیست.</p> }
        </div>
    </div>
</div>

@* ===================== RCM/FMEA + Predictive/Condition ===================== *@
<div class="row g-3">
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-2">Reliability Data Quality</h6>
            <div class="small">Equipment Reliability Coverage: @dataQuality.EquipmentReliabilityCoveragePercent.ToString("N1")%</div>
            <div class="small">Failure Taxonomy Coverage: @dataQuality.FailureTaxonomyCoveragePercent.ToString("N1")%</div>
            <div class="small">Repair Data Coverage: @dataQuality.RepairDataCoveragePercent.ToString("N1")%</div>
            <div class="small">Maintenance Strategy Coverage: @dataQuality.MaintenanceStrategyCoveragePercent.ToString("N1")%</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-2">Predictive Maintenance</h6>
            <div>Engine: <span class="badge @StatusBadge(predictive.EngineStatus)">@predictive.EngineStatus</span></div>
            <div>Production Model: <span class="badge @StatusBadge(predictive.ProductionModelStatus)">@predictive.ProductionModelStatus</span></div>
            <div class="small text-muted mt-1">@predictive.Reason</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-2">Condition Monitoring</h6>
            <div>Foundation: <span class="badge @StatusBadge(conditionMonitoring.FoundationStatus)">@conditionMonitoring.FoundationStatus</span></div>
            <div>Live Telemetry: <span class="badge @StatusBadge(conditionMonitoring.LiveTelemetryStatus)">@conditionMonitoring.LiveTelemetryStatus</span></div>
            <div class="small text-muted mt-1">@conditionMonitoring.MonitoringPointCount points, @conditionMonitoring.ReadingCount readings</div>
        </div>
    </div>
</div>
