@model List<PEMS.Application.DTOs.EquipmentReliabilityDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var classReliability = (List<EquipmentClassReliabilityDto>)ViewBag.ClassReliability;
    var badActors = (List<BadActorDto>)ViewBag.BadActors;
    var pareto = (List<FailureParetoItemDto>)ViewBag.FailureModePareto;
    var pmCompliance = (PmComplianceDto)ViewBag.PmCompliance;
    var breakdown = (MaintenanceTypeBreakdownDto)ViewBag.MaintenanceTypeBreakdown;
    var repeatFailures = (List<RepeatFailureGroupDto>)ViewBag.RepeatFailures;
    var criticalityMatrix = (List<CriticalityMatrixRowDto>)ViewBag.CriticalityFailureMatrix;
    var criticalityMaintenanceMatrix = (List<CriticalityFailureMaintenanceRowDto>)ViewBag.CriticalityFailureMaintenanceMatrix;
    var dataQuality = (ReliabilityDataQualityDto)ViewBag.DataQuality;
    var conditionMonitoring = (ConditionMonitoringFoundationStatusDto)ViewBag.ConditionMonitoring;
    var predictive = (PredictiveMaintenanceReadinessDto)ViewBag.Predictive;

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "INSUFFICIENT_DATA" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };

    var totalEquipmentWithFailures = Model.Count;
}

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">Fleet Reliability</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Intelligence">@Localizer["Maintenance Intelligence"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="PredictiveMaintenance">@Localizer["Predictive"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ConditionMonitoring">@Localizer["Condition Monitoring"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="CBMDashboard">@Localizer["CBM Dashboard"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AiInsights">@Localizer["AI Insights"]</pems-button>
    </div>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 9» بند ۲۰/۳۱: هیچ درصد/KPI جعلی این‌جا نمایش داده نمی‌شود - هرجا داده کافی
    نیست، N/A یا وضعیت صریح (NOT_READY/INSUFFICIENT_DATA) نشان داده می‌شود.
</p>

@* ===================== Executive Reliability ===================== *@
<h6 class="mt-4">Executive Reliability</h6>
<pems-row gap="3" css="mb-3">
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@totalEquipmentWithFailures</pems-metric>
            <div class="text-muted small">@Localizer["Equipment with Failure History"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(pmCompliance.CompliancePercent.HasValue ? $"{pmCompliance.CompliancePercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">@Localizer["PM Compliance"]</div>
            <pems-badge tone="@StatusBadge(pmCompliance.DataStatus)">@pmCompliance.DataStatus</pems-badge>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(breakdown.Items.FirstOrDefault(x => x.TypeName == "Corrective")?.Percent is { } cp ? $"{cp:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">Corrective Ratio</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(breakdown.EmergencyWorkRatioPercent.HasValue ? $"{breakdown.EmergencyWorkRatioPercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">Emergency Ratio</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@repeatFailures.Count</pems-metric>
            <div class="text-muted small">@Localizer["Repeat Failure Groups"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@badActors.Count</pems-metric>
            <div class="text-muted small">Bad Actors (top list)</div>
        </pems-content-card>
    </pems-col>
</pems-row>

@* ===================== Criticality ===================== *@
<h6 class="mt-4">@Localizer["Criticality"]</h6>
<pems-content-card css="mb-3">
    <div class="table-scroll-area pems-s-0ddf068b">
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Class"]</pems-table-header><pems-table-header class="text-end">@Localizer["Equipment"]</pems-table-header><pems-table-header class="text-end">@Localizer["Failures"]</pems-table-header><pems-table-header class="text-end">@Localizer["Repeat"]</pems-table-header><pems-table-header class="text-end">@Localizer["PM Compliance"]</pems-table-header><pems-table-header class="text-end">@Localizer["Strategy Coverage"]</pems-table-header><pems-table-header class="text-end">RCM Class Coverage</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var row in criticalityMatrix)
            {
                var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass);
                <pems-table-row>
                    <pems-table-cell class="fw-bold">@row.CriticalityClass</pems-table-cell>
                    <pems-table-cell class="text-end">@row.EquipmentCount</pems-table-cell>
                    <pems-table-cell class="text-end">@row.FailureCount</pems-table-cell>
                    <pems-table-cell class="text-end">@row.RepeatFailureGroupCount</pems-table-cell>
                    <pems-table-cell class="text-end">@(row.PmCompliancePercent.HasValue ? $"{row.PmCompliancePercent.Value:N1}%" : "N/A")</pems-table-cell>
                    <pems-table-cell class="text-end">@(m2 != null ? $"{m2.StrategyCoveragePercent:N0}%" : "N/A")</pems-table-cell>
                    <pems-table-cell class="text-end">@(m2?.RcmClassCoveragePercent.HasValue == true ? $"{m2.RcmClassCoveragePercent.Value:N0}%" : "N/A")</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </div>
    <a asp-action="Intelligence" class="small">See full Criticality × Failure × Maintenance matrix with findings →</a>
</pems-content-card>

@* ===================== Maintenance / Failure ===================== *@
<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <h6 class="mb-2">Top Failure Modes (Pareto)</h6>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-body>
                    @foreach (var p in pareto)
                    {
                        <pems-table-row><pems-table-cell>@p.Key</pems-table-cell><pems-table-cell class="text-end">@p.Count</pems-table-cell><pems-table-cell class="text-end small text-muted">@p.CumulativePercent.ToString("N0")%</pems-table-cell></pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!pareto.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100">
            <h6 class="mb-2">@Localizer["Bad Actors"]</h6>
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-body>
                    @foreach (var b in badActors)
                    {
                        <pems-table-row>
                            <pems-table-cell><a asp-action="EquipmentProfile" asp-route-id="@b.EquipmentId">@b.TagNumber</a></pems-table-cell>
                            <pems-table-cell class="text-end">@b.FailureCount failures</pems-table-cell>
                            <pems-table-cell class="text-end small text-muted">@b.TotalDowntimeHours.ToString("N0")h</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!badActors.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

@* ===================== RCM/FMEA + Predictive/Condition ===================== *@
<pems-row gap="3">
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6 class="mb-2">Reliability Data Quality</h6>
            <div class="small">Equipment Reliability Coverage: @dataQuality.EquipmentReliabilityCoveragePercent.ToString("N1")%</div>
            <div class="small">Failure Taxonomy Coverage: @dataQuality.FailureTaxonomyCoveragePercent.ToString("N1")%</div>
            <div class="small">Repair Data Coverage: @dataQuality.RepairDataCoveragePercent.ToString("N1")%</div>
            <div class="small">Maintenance Strategy Coverage: @dataQuality.MaintenanceStrategyCoveragePercent.ToString("N1")%</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6 class="mb-2">Predictive Maintenance</h6>
            <div>Engine: <pems-badge tone="@StatusBadge(predictive.EngineStatus)">@predictive.EngineStatus</pems-badge></div>
            <div>Production Model: <pems-badge tone="@StatusBadge(predictive.ProductionModelStatus)">@predictive.ProductionModelStatus</pems-badge></div>
            <div class="small text-muted mt-1">@predictive.Reason</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6 class="mb-2">@Localizer["Condition Monitoring"]</h6>
            <div>Foundation: <pems-badge tone="@StatusBadge(conditionMonitoring.FoundationStatus)">@conditionMonitoring.FoundationStatus</pems-badge></div>
            <div>Live Telemetry: <pems-badge tone="@StatusBadge(conditionMonitoring.LiveTelemetryStatus)">@conditionMonitoring.LiveTelemetryStatus</pems-badge></div>
            <div class="small text-muted mt-1">@conditionMonitoring.MonitoringPointCount points, @conditionMonitoring.ReadingCount readings</div>
        </pems-content-card>
    </pems-col>
</pems-row>
