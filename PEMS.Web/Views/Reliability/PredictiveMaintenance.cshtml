@model List<PEMS.Application.DTOs.PredictiveMaintenanceModelDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var readiness = (PredictiveMaintenanceReadinessDto)ViewBag.Readiness;

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };
}

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Reliability"]</pems-button>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 9» بند ۱۶: هیچ مدلی بدون اعتبارسنجی واقعی «آماده‌ی تولید» اعلام نمی‌شود.
    زیرساخت نرم‌افزاری از الان آماده است تا وقتی داده‌ی کافی جمع شود، بدون بازطراحی معماری.
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100 text-center">
            <div class="text-muted small">Engine (software/architecture)</div>
            <pems-badge tone="@StatusBadge(readiness.EngineStatus)" css="fs-6">@readiness.EngineStatus</pems-badge>
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100 text-center">
            <div class="text-muted small">Production Model (validated on real data)</div>
            <pems-badge tone="@StatusBadge(readiness.ProductionModelStatus)" css="fs-6">@readiness.ProductionModelStatus</pems-badge>
        </pems-content-card>
    </pems-col>
</pems-row>
<p class="text-muted small">@readiness.Reason</p>

<pems-content-card>
    <h6 class="mb-2">Defined Models (@readiness.ModelCount total, @readiness.ValidatedModelCount validated)</h6>
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <thead><tr><th>@Localizer["Target"]</th><th>Algorithm</th><th>Training Data</th><th>@Localizer["Validation"]</th><th class="text-end">Results</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.TargetName</td>
                    <td class="small">@m.Algorithm</td>
                    <td><pems-badge tone="@StatusBadge(m.TrainingDataStatus)">@m.TrainingDataStatus</pems-badge></td>
                    <td class="small">@m.ValidationStatus</td>
                    <td class="text-end">@m.ResultCount</td>
                </tr>
            }
        </tbody>
    </pems-table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">هیچ مدل پیش‌بینانه‌ای هنوز تعریف نشده - هیچ داده‌ی جعلی برای پرکردن این صفحه درج نشده.</p> }
</pems-content-card>
