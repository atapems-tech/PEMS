@model PEMS.Application.DTOs.RamAnalysisDto
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var weibull = (WeibullAnalysisDto)ViewBag.Weibull;
    var equipmentId = (int)ViewBag.EquipmentId;

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "INSUFFICIENT_DATA" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };
}

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@equipmentId">← Reliability Detail</pems-button>
</pems-flex>
<p class="text-muted small">
    طبق «PEMS Phase 9» بند ۱۲/۱۳: MTBF/MTTR/Availability از IReliabilityService موجود
    بازخوانی می‌شوند (دوباره محاسبه نمی‌شوند). پارامترهای Weibull با Median Rank Regression
    از فاصله‌های واقعی بین خرابی برازش می‌شوند - @weibull.MethodologyVersion
</p>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6>@Localizer["Reliability"]</h6>
            <pems-badge tone="@StatusBadge(Model.ReliabilityDataStatus)">@Model.ReliabilityDataStatus</pems-badge>
            <div class="small mt-2">MTBF: @(Model.MTBFHours.HasValue ? $"{Model.MTBFHours.Value:N1} h" : "N/A")</div>
            <div class="small">Failure Rate (λ): @(Model.FailureRateLambdaPerHour.HasValue ? Model.FailureRateLambdaPerHour.Value.ToString("E3") + "/h" : "N/A")</div>
            <div class="small">Sample Size: @Model.FailureSampleSize</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6>Maintainability</h6>
            <pems-badge tone="@StatusBadge(Model.MaintainabilityDataStatus)">@Model.MaintainabilityDataStatus</pems-badge>
            <div class="small mt-2">MTTR: @(Model.MTTRHours.HasValue ? $"{Model.MTTRHours.Value:N1} h" : "N/A")</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <h6>@Localizer["Availability"]</h6>
            <div class="small">Inherent: <pems-badge tone="@StatusBadge(Model.InherentAvailabilityDataStatus)">@Model.InherentAvailabilityDataStatus</pems-badge> @(Model.InherentAvailabilityPercent.HasValue ? $"{Model.InherentAvailabilityPercent.Value:N2}%" : "")</div>
            <div class="small mt-2">Operational: <pems-badge tone="@StatusBadge(Model.OperationalAvailabilityDataStatus)">@Model.OperationalAvailabilityDataStatus</pems-badge> @(Model.OperationalAvailabilityPercent.HasValue ? $"{Model.OperationalAvailabilityPercent.Value:N2}%" : "")</div>
            @if (Model.CalendarWindowHoursConsidered.HasValue)
            {
                <div class="small text-muted">Window: @Model.CalendarWindowHoursConsidered.Value.ToString("N0")h, Downtime: @Model.TotalDowntimeHoursConsidered?.ToString("N1")h</div>
            }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mb-3">
    <h6 class="mb-2">Weibull Analysis (2-parameter)</h6>
    <pems-badge tone="@StatusBadge(weibull.DataStatus)">@weibull.DataStatus</pems-badge>
    <span class="small text-muted ms-2">Sample: @weibull.SampleSize intervals (minimum required: @weibull.RequiredMinimumSample failure records)</span>
    @if (weibull.Reason != null) { <div class="small text-muted mt-1">@weibull.Reason</div> }

    @if (weibull.Beta.HasValue)
    {
        <pems-row gap="2" css="mt-2 small">
            <pems-col md="3"><strong>β (shape)</strong><div>@weibull.Beta.Value.ToString("N3")</div></pems-col>
            <pems-col md="3"><strong>η (scale, hours)</strong><div>@weibull.Eta?.ToString("N1")</div></pems-col>
            <pems-col md="3"><strong>R²</strong><div>@weibull.RSquared?.ToString("N3")</div></pems-col>
            <pems-col md="3"><strong>Interpretation</strong><div>@weibull.BetaInterpretation</div></pems-col>
        </pems-row>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-2">Monte Carlo / RAM Simulation</h6>
    <p class="text-muted small mb-2">
        فقط وقتی Weibull و MTTR هر دو واقعاً آماده باشند اجرا می‌شود - Provenance همیشه SIMULATED است.
    </p>
    <pems-form method="post" asp-action="Simulate" asp-route-id="@equipmentId">
        @Html.AntiForgeryToken()
        <pems-row gap="2" css="align-items-end">
            <pems-col span="auto">
                <pems-label css="small mb-0">Iterations</pems-label>
                <pems-input class="pems-w-120" scale="small" type="number" name="iterations" value="1000" />
            </pems-col>
            <pems-col span="auto">
                <pems-label css="small mb-0">Horizon (hours)</pems-label>
                <pems-input class="pems-w-140" scale="small" type="number" name="horizonHours" value="8760" />
            </pems-col>
            <pems-col span="auto">
                <pems-button tone="primary" size="small" type="submit">Run Simulation</pems-button>
            </pems-col>
        </pems-row>
    </pems-form>
</pems-content-card>
