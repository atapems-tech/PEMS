@model List<PEMS.Application.DTOs.AIReliabilityInsightDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var statusFilter = (string?)ViewBag.StatusFilter;
    var canGenerate = (bool)ViewBag.CanGenerate;
    var canReview = (bool)ViewBag.CanReview;

    string ReviewBadge(string status) => status switch
    {
        "Approved" => "success",
        "Rejected" => "danger",
        _ => "warning"
    };
}

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Reliability"]</pems-button>
</pems-flex>
<pems-alert tone="info" css="small">
    طبق «PEMS Phase 9» بند ۱۷ (AI Governance): این بینش‌ها فقط <strong>@Localizer["پیشنهاد"]</strong> هستند -
    هرگز خودکار هیچ RCMDecision/MaintenanceStrategy/EquipmentCriticality/FailureRecord/WorkOrder
    ای را تغییر نمی‌دهند. هر بینش باید توسط یک مهندس انسانی بازبینی (تایید/رد) شود. مدل و منبع
    داده‌ی واقعی همیشه ثبت می‌شود.
</pems-alert>

@if (canGenerate)
{
    <pems-content-card css="mb-3">
        <pems-form method="post" asp-action="GenerateAiInsights"><pems-row gap="2" css="align-items-end">
            @Html.AntiForgeryToken()
            <pems-col span="auto">
                <pems-label css="small mb-0">Equipment Class ID (optional)</pems-label>
                <pems-input class="pems-w-160" scale="small" type="number" name="equipmentClassId" />
            </pems-col>
            <pems-col span="auto">
                <pems-button tone="primary" size="small" type="submit">Generate Insights (Ollama, local)</pems-button>
            </pems-col>
        </pems-row></pems-form>
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-row gap="2">
        <pems-col span="auto">
            <pems-select scale="small" name="status" onchange="this.form.submit()">
                <option value="">@Localizer["All"]</option>
                <option value="Draft" selected="@(statusFilter == "Draft")">Draft</option>
                <option value="Approved" selected="@(statusFilter == "Approved")">Approved</option>
                <option value="Rejected" selected="@(statusFilter == "Rejected")">Rejected</option>
            </pems-select>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <div class="table-scroll-area pems-s-0ddf068b">
    <pems-table kind="enterprise" scale="small" css="mb-0">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Scope"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>Suggestion</pems-table-header><pems-table-header>Source Data</pems-table-header><pems-table-header>@Localizer["Model"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Reviewed By"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var insight in Model)
            {
                <pems-table-row>
                    <pems-table-cell class="small">@(insight.EquipmentTagNumber ?? insight.EquipmentClassName ?? "Fleet")</pems-table-cell>
                    <pems-table-cell class="small">@insight.InsightType</pems-table-cell>
                    <pems-table-cell class="small">@insight.SuggestionText</pems-table-cell>
                    <pems-table-cell class="small text-muted">@insight.SourceDataSummary</pems-table-cell>
                    <pems-table-cell class="small">@insight.ModelName <pems-badge tone="light">AI_SUGGESTED</pems-badge></pems-table-cell>
                    <pems-table-cell><pems-badge tone="@ReviewBadge(insight.ReviewStatus)">@insight.ReviewStatus</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">@insight.ReviewedByName</pems-table-cell>
                    <pems-table-cell>
                        @if (canReview && insight.ReviewStatus == "Draft")
                        {
                            <pems-form method="post" asp-action="ReviewAiInsight" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="insightId" value="@insight.AIReliabilityInsightId" />
                                <input type="hidden" name="approve" value="true" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["Approve"]</pems-button>
                            </pems-form>
                            <pems-form method="post" asp-action="ReviewAiInsight" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="insightId" value="@insight.AIReliabilityInsightId" />
                                <input type="hidden" name="approve" value="false" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                            </pems-form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    </div>
    @if (!Model.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["هیچ بینشی هنوز تولید نشده."]</p> }
</pems-content-card>
