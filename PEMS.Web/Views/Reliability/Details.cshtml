@model PEMS.Application.DTOs.EquipmentReliabilityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Reliability — @Model.TagNumber</h5>
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="EquipmentProfile" asp-route-id="@Model.EquipmentId"><i class="bi bi-person-badge"></i> Intelligence Profile</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Ram" asp-route-id="@Model.EquipmentId"><i class="bi bi-graph-up"></i> @Localizer["RAM / Weibull"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><i class="bi bi-arrow-right"></i> Back</pems-button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">@Localizer["MTBF"]</div>
            <div class="fs-5 fw-bold">@(Model.MTBFHours.HasValue ? $"{Model.MTBFHours.Value:N1} h" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">@Localizer["MTTR"]</div>
            <div class="fs-5 fw-bold">@(Model.MTTRHours.HasValue ? $"{Model.MTTRHours.Value:N1} h" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">@Localizer["Availability"]</div>
            <div class="fs-5 fw-bold">@(Model.AvailabilityPercent.HasValue ? $"{Model.AvailabilityPercent.Value:N1}%" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">@Localizer["Failure Count"]</div>
            <div class="fs-5 fw-bold">@Model.FailureCount</div>
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-2"><i class="bi bi-clock-history"></i> Failure History</h6>
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>@Localizer["Date"]</th><th>@Localizer["Mode"]</th><th>@Localizer["Cause"]</th><th>@Localizer["Effect"]</th><th>@Localizer["Root Cause"]</th><th>@Localizer["Corrective Action"]</th><th>@Localizer["Downtime"]</th><th>@Localizer["Work Order"]</th></tr>
        </thead>
        <tbody>
            @foreach (var f in Model.FailureHistory.OrderByDescending(x => x.FailureDate))
            {
                <tr>
                    <td class="small">@f.FailureDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@f.FailureMode</td>
                    <td class="small">@f.FailureCause</td>
                    <td class="small">@f.FailureEffect</td>
                    <td class="small">@f.RootCause</td>
                    <td class="small">@f.CorrectiveAction</td>
                    <td class="small">@(f.DowntimeHours.HasValue ? $"{f.DowntimeHours.Value:N1} h" : "-")</td>
                    <td class="small">
                        @if (f.WorkOrderId.HasValue)
                        {
                            <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@f.WorkOrderId">@f.WorkOrderNumber</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
