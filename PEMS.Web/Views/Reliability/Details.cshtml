@model PEMS.Application.DTOs.EquipmentReliabilityDto

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Reliability — @Model.TagNumber</h5>
    <div>
        <a asp-action="EquipmentProfile" asp-route-id="@Model.EquipmentId" class="btn btn-outline-primary btn-sm"><i class="bi bi-person-badge"></i> Intelligence Profile</a>
        <a asp-action="Ram" asp-route-id="@Model.EquipmentId" class="btn btn-outline-primary btn-sm"><i class="bi bi-graph-up"></i> RAM / Weibull</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> Back</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">MTBF</div>
            <div class="fs-5 fw-bold">@(Model.MTBFHours.HasValue ? $"{Model.MTBFHours.Value:N1} h" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">MTTR</div>
            <div class="fs-5 fw-bold">@(Model.MTTRHours.HasValue ? $"{Model.MTTRHours.Value:N1} h" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">Availability</div>
            <div class="fs-5 fw-bold">@(Model.AvailabilityPercent.HasValue ? $"{Model.AvailabilityPercent.Value:N1}%" : "N/A")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center py-3">
            <div class="small text-muted">Failure Count</div>
            <div class="fs-5 fw-bold">@Model.FailureCount</div>
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-2"><i class="bi bi-clock-history"></i> Failure History</h6>
    <table class="table table-enterprise mb-0">
        <thead>
            <tr><th>Date</th><th>Mode</th><th>Cause</th><th>Effect</th><th>Root Cause</th><th>Corrective Action</th><th>Downtime</th><th>Work Order</th></tr>
        </thead>
        <tbody>
            @foreach (var f in Model.FailureHistory.OrderByDescending(x => x.FailureDate))
            {
                <tr>
                    <td class="small">@f.FailureDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@f.FailureMode</td>
                    <td class="small">@f.FailureCause</td>
                    <td class="small">@f.FailureEffect</td>
                    <td class="small">@f.RootCause</td>
                    <td class="small">@f.CorrectiveAction</td>
                    <td class="small">@(f.DowntimeHours.HasValue ? $"{f.DowntimeHours.Value:N1} h" : "-")</td>
                    <td class="small">
                        @if (f.WorkOrderId.HasValue)
                        {
                            <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@f.WorkOrderId">@f.WorkOrderNumber</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
