@model PEMS.Application.DTOs.EquipmentReliabilityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><pems-icon name="bi-graph-up-arrow" /> Reliability — @Model.TagNumber</h5>
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="EquipmentProfile" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-person-badge" /> Intelligence Profile</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Ram" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-graph-up" /> @Localizer["RAM / Weibull"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-right" /> Back</pems-button>
    </div>
</div>

<pems-row gap="3" css="mb-3">
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["MTBF"]">@(Model.MTBFHours.HasValue ? $"{Model.MTBFHours.Value:N1} h" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["MTTR"]">@(Model.MTTRHours.HasValue ? $"{Model.MTTRHours.Value:N1} h" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Availability"]">@(Model.AvailabilityPercent.HasValue ? $"{Model.AvailabilityPercent.Value:N1}%" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Failure Count"]">@Model.FailureCount</pems-kpi-tile></pems-col>
</pems-row>

<pems-content-card>
    <h6 class="mb-2"><pems-icon name="bi-clock-history" /> Failure History</h6>
    <pems-table kind="enterprise" css="mb-0">
        <thead>
            <tr><th>@Localizer["Date"]</th><th>@Localizer["Mode"]</th><th>@Localizer["Cause"]</th><th>@Localizer["Effect"]</th><th>@Localizer["Root Cause"]</th><th>@Localizer["Corrective Action"]</th><th>@Localizer["Downtime"]</th><th>@Localizer["Work Order"]</th></tr>
        </thead>
        <tbody>
            @foreach (var f in Model.FailureHistory.OrderByDescending(x => x.FailureDate))
            {
                <tr>
                    <td class="small">@f.FailureDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@f.FailureMode</td>
                    <td class="small">@f.FailureCause</td>
                    <td class="small">@f.FailureEffect</td>
                    <td class="small">@f.RootCause</td>
                    <td class="small">@f.CorrectiveAction</td>
                    <td class="small">@(f.DowntimeHours.HasValue ? $"{f.DowntimeHours.Value:N1} h" : "-")</td>
                    <td class="small">
                        @if (f.WorkOrderId.HasValue)
                        {
                            <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@f.WorkOrderId">@f.WorkOrderNumber</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </pems-table>
</pems-content-card>
