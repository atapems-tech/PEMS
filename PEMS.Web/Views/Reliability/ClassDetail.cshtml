@model PEMS.Application.DTOs.EquipmentClassReliabilityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <h5 class="mb-0">@Model.Name <code class="small">@Model.Code</code></h5>
    <a asp-action="Index" class="small">@Localizer["← Fleet Reliability"]</a>
</pems-flex>

<pems-content-card>
    <pems-row gap="3" css="text-center">
        <pems-col md="2">
            <div class="fs-4 fw-bold">@Model.EquipmentPopulation</div>
            <div class="text-muted small">@Localizer["Population"]</div>
        </pems-col>
        <pems-col md="2">
            <div class="fs-4 fw-bold">@Model.EquipmentWithFailureHistory</div>
            <div class="text-muted small">With Failure History</div>
        </pems-col>
        <pems-col md="2">
            <div class="fs-4 fw-bold">@Model.FailureCount</div>
            <div class="text-muted small">@Localizer["Total Failures"]</div>
        </pems-col>
        <pems-col md="2">
            <div class="fs-4 fw-bold">@Model.TotalDowntimeHours.ToString("N1")h</div>
            <div class="text-muted small">@Localizer["Total Downtime"]</div>
        </pems-col>
        <pems-col md="2">
            <div class="fs-4 fw-bold">@(Model.AverageMTBFHours.HasValue ? $"{Model.AverageMTBFHours.Value:N1}h" : "N/A")</div>
            <div class="text-muted small">Avg MTBF (n=@Model.MTBFSampleSize)</div>
        </pems-col>
        <pems-col md="2">
            <div class="fs-4 fw-bold">@(Model.AverageMTTRHours.HasValue ? $"{Model.AverageMTTRHours.Value:N1}h" : "N/A")</div>
            <div class="text-muted small">Avg MTTR (n=@Model.MTTRSampleSize)</div>
        </pems-col>
    </pems-row>
    @if (Model.EquipmentWithFailureHistory == 0)
    {
        <p class="text-muted text-center py-3 mb-0 mt-3 border-top">این کلاس هنوز هیچ تاریخچه‌ی خرابی معتبری ندارد - همه‌ی معیارها N/A هستند تا داده‌ی واقعی وارد شود.</p>
    }
</pems-content-card>
