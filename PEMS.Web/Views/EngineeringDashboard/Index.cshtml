@model PEMS.Web.Models.EngineeringDashboardViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Dashboard";

    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;

    // طبق Phase E-05D: فقط KPI هایی Drilldown می‌گیرند که دقیقاً با یک مقدار Status در
    // EngineeringDocumentListFilter قابل‌بیان باشند (Approved/Rejected). Pending یعنی
    // Submitted-OR-Checked که این فیلتر تک‌مقداری نمی‌تواند دقیق بیانش کند - به‌جای Drilldown
    // نادرست/گمراه‌کننده، غیرقابل‌کلیک می‌ماند (طبق قانون "کاربر نباید حدس بزند").
    // Frozen/Overdue هم فیلد فیلتر مستقیم امروز ندارند.
    var kpis = new List<PEMS.Web.Models.KpiCardViewModel>
    {
        new() { Title = Localizer["Total"], Count = Model.Summary.Total, IconClass = "bi-file-earmark-text", ColorClass = "bg-icon-slate",
                Url = Url.Action("Index", "EngineeringDocuments") },
        new() { Title = Localizer["Approved"], Count = Model.Summary.Approved, IconClass = "bi-check-circle", ColorClass = "bg-icon-green",
                Url = Url.Action("Index", "EngineeringDocuments", new { Status = "Approved" }) },
        new() { Title = Localizer["PendingReview"], Count = Model.Summary.Pending, IconClass = "bi-hourglass-split", ColorClass = "bg-icon-amber" },
        new() { Title = Localizer["Rejected"], Count = Model.Summary.Rejected, IconClass = "bi-x-circle", ColorClass = "bg-icon-red",
                Url = Url.Action("Index", "EngineeringDocuments", new { Status = "Rejected" }) },
        new() { Title = Localizer["Frozen"], Count = Model.Summary.Frozen, IconClass = "bi-snow", ColorClass = "bg-icon-blue" },
        new() { Title = Localizer["Delayed"], Count = Model.Summary.Overdue, IconClass = "bi-exclamation-triangle", ColorClass = "bg-icon-purple" }
    };

    var attentionQueue = Model.AttentionQueue;
    var disciplinePerformance = Model.DisciplinePerformance;
}

<div class="content-card mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">@Localizer["Project"]</label>
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All"]</option>
                @foreach (var p in projects)
                { <option value="@p.ProjectId" selected="@(Model.SelectedProjectId == (int)p.ProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">@Localizer["Discipline"]</label>
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in disciplines)
                { <option value="@d.DisciplineId" selected="@(Model.SelectedDisciplineId == (int)d.DisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">@Localizer["MinRevisionCount"]</label>
            <input type="number" min="0" name="minRevisionCount" value="@Model.SelectedMinRevisionCount" class="form-control form-control-sm" placeholder="e.g. 2" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <pems-button tone="primary" size="small" css="flex-fill" type="submit"><i class="bi bi-funnel"></i> @Localizer["Filter"]</pems-button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger flex-fill" title="@Localizer["Reset"]" aria-label="@Localizer["Reset"]"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
    @if (Model.SelectedProjectId.HasValue || Model.SelectedDisciplineId.HasValue || Model.SelectedMinRevisionCount.HasValue)
    {
        <p class="text-muted small mt-2 mb-0">
            <i class="bi bi-funnel-fill"></i> @Localizer["ActiveFilter"]:
            @(Model.SelectedProjectId.HasValue ? $"Project #{Model.SelectedProjectId} " : "")
            @(Model.SelectedDisciplineId.HasValue ? $"Discipline #{Model.SelectedDisciplineId} " : "")
            @(Model.SelectedMinRevisionCount.HasValue ? $"Revision ≥ {Model.SelectedMinRevisionCount}" : "")
        </p>
    }
</div>

@* ===================== Section A: Executive Summary (GetSummaryCountsAsync, E-03) ===================== *@
<div class="content-card mb-3">
    <div class="section-head d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h6 class="section-title mb-1"><i class="bi bi-speedometer2"></i> @Localizer["ExecutiveSummary"]</h6>
            <p class="section-subtitle mb-0">Live snapshot of engineering activity</p>
        </div>
    </div>
    <div class="row g-3">
        @foreach (var kpi in kpis)
        {
            <div class="col-6 col-md-2">
                <partial name="_KpiCard" model="kpi" />
            </div>
        }
    </div>
</div>

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><i class="bi bi-shield-check"></i> Engineering Health</h6>
        <pems-badge tone="primary" css="rounded-pill fs-6">@Model.EngineeringHealthScore / 100</pems-badge>
    </div>
    <p class="text-muted small mb-3">
        Deterministic health score = weighted quality + backlog + overdue + risk. Values are computed from actual summary and revision data in the selected scope.
    </p>
    <div class="row g-3 align-items-center">
        <div class="col-md-3">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-icon-teal"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="kpi-value">@Model.EngineeringHealthScore</div>
                    <div class="kpi-label">Health Score</div>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="progress" style="height: 12px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @Model.EngineeringHealthScore%;" aria-valuenow="@Model.EngineeringHealthScore" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="small text-muted mt-2">
                @if (Model.Summary.Total == 0)
                {
                    <span>No document activity in the selected scope.</span>
                }
                else
                {
                    <span>Approved rate: @(Math.Round(((double)Model.Summary.Approved / Math.Max(Model.Summary.Total, 1)) * 100, 1))%, backlog: @Model.Summary.Pending, overdue: @Model.Summary.Overdue.</span>
                }
            </div>
        </div>
    </div>
</div>

@* ===================== Section B: Quality & Review (GetRevisionQualityAsync, E-05C) ===================== *@
<div class="content-card mb-3">
    <h6 class="mb-1"><i class="bi bi-award"></i> @Localizer["QualityAndReview"]</h6>
    <p class="text-muted small mb-3">@Localizer["FirstPassApprovalExplanation"]</p>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-icon bg-icon-teal"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="kpi-value">@(Model.FirstPassApprovalRate.HasValue ? Model.FirstPassApprovalRate.Value.ToString("P0") : "N/A")</div>
                    <div class="kpi-label">@Localizer["FirstPassApprovalRate"]</div>
                </div>
            </div>
        </div>
    </div>
    @if (!Model.FirstPassApprovalRate.HasValue)
    {
        <p class="text-muted small">@Localizer["NoCompletedCyclesYet"]</p>
    }

    @{
        var topRejected = Model.Quality.Where(x => x.RejectionCount > 0).OrderByDescending(x => x.RejectionCount).Take(10).ToList();
    }
    <h6 class="small fw-bold mt-3">@Localizer["MostRejectedDocuments"]</h6>
    @if (!topRejected.Any())
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-emoji-smile" style="font-size:32px;"></i>
            <p class="mb-0 mt-2">@Localizer["NoRejectedDocumentsInScope"]</p>
        </div>
    }
    else
    {
        <div class="table-scroll-area">
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Document"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Status"]</th><th>@Localizer["Rejections"]</th><th>@Localizer["Revisions"]</th></tr></thead>
                <tbody>
                    @foreach (var q in topRejected)
                    {
                        <tr>
                            <td><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@q.DocumentId">@q.DocumentNo</a></td>
                            <td class="small">@(q.DisciplineName ?? "-")</td>
                            <td class="small">@(q.VendorName ?? "-")</td>
                            <td><span class="badge badge-status-@q.Status">@q.Status</span></td>
                            <td><pems-badge tone="danger">@q.RejectionCount</pems-badge></td>
                            <td class="small">@q.RevisionCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ===================== Section C: Revision & Resubmission Pressure (GetRevisionQualityAsync + MinRevisionCount, E-05C ADR-5) ===================== *@
<div class="content-card mb-3">
    <h6 class="mb-1"><i class="bi bi-arrow-repeat"></i> @Localizer["RevisionPressure"]</h6>
    <p class="text-muted small mb-3">@Localizer["RevisionPressureExplanation"]</p>

    @{
        var highRevision = Model.Quality.Where(x => x.RevisionCount > 0).OrderByDescending(x => x.RevisionCount).Take(10).ToList();
    }
    @if (!highRevision.Any())
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-emoji-smile" style="font-size:32px;"></i>
            <p class="mb-0 mt-2">@Localizer["NoRevisedDocumentsInScope"]</p>
        </div>
    }
    else
    {
        <div class="table-scroll-area">
            <table class="table table-enterprise table-sm mb-0">
                <thead><tr><th>@Localizer["Document"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Status"]</th><th>@Localizer["Revisions"]</th><th>@Localizer["FirstPass"]</th></tr></thead>
                <tbody>
                    @foreach (var q in highRevision)
                    {
                        <tr>
                            <td><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@q.DocumentId">@q.DocumentNo</a></td>
                            <td class="small">@(q.DisciplineName ?? "-")</td>
                            <td><span class="badge badge-status-@q.Status">@q.Status</span></td>
                            <td><pems-badge tone="warning">@q.RevisionCount</pems-badge></td>
                            <td class="small">
                                @if (q.FirstPassApproved == true) { <i class="bi bi-check-circle text-success" title="@Localizer["FirstPass"]" aria-label="@Localizer["FirstPass"]"></i> }
                                else if (q.FirstPassApproved == false) { <i class="bi bi-x-circle text-danger" title="@Localizer["NotFirstPass"]" aria-label="@Localizer["NotFirstPass"]"></i> }
                                else { <span class="text-muted">-</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <a asp-controller="EngineeringDocuments" asp-action="Index" asp-route-MinRevisionCount="@(Model.SelectedMinRevisionCount ?? 1)"
               class="btn btn-sm btn-outline-secondary"><i class="bi bi-list-ul"></i> @Localizer["ViewAllInMdr"]</a>
        </div>
    }
</div>

<div class="content-card mb-3">
   <h6 class="mb-3"><i class="bi bi-exclamation-triangle"></i> Management Attention Queue</h6>
   @if (!attentionQueue.Any())
   {
       <div class="text-center text-muted py-4">
           <i class="bi bi-check-circle" style="font-size:32px;"></i>
           <p class="mb-0 mt-2">No high-risk documents were identified in the selected scope.</p>
       </div>
   }
   else
   {
       <div class="table-scroll-area">
           <table class="table table-enterprise table-sm mb-0">
               <thead>
                   <tr>
                       <th>@Localizer["Document"]</th>
                       <th>@Localizer["Discipline"]</th>
                       <th>@Localizer["Reason"]</th>
                       <th>@Localizer["Severity"]</th>
                       <th>@Localizer["Revisions"]</th>
                       <th>@Localizer["Rejections"]</th>
                   </tr>
               </thead>
               <tbody>
                   @foreach (var item in attentionQueue)
                   {
                       <tr>
                           <td><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@item.DocumentId">@item.DocumentNo</a></td>
                           <td class="small">@item.DisciplineName</td>
                           <td class="small">@item.Reason</td>
                           <td>
                               @if (item.Severity == "Critical")
                               {
                                   <pems-badge tone="danger">@item.Severity</pems-badge>
                               }
                               else if (item.Severity == "High")
                               {
                                   <pems-badge tone="warning">@item.Severity</pems-badge>
                               }
                               else
                               {
                                   <pems-badge tone="neutral">@item.Severity</pems-badge>
                               }
                           </td>
                           <td><pems-badge tone="info">@item.RevisionCount</pems-badge></td>
                           <td><pems-badge tone="danger">@item.RejectionCount</pems-badge></td>
                       </tr>
                   }
               </tbody>
           </table>
       </div>
   }
</div>

<div class="content-card mb-3">
   <h6 class="mb-3"><i class="bi bi-diagram-3"></i> Discipline Risk Overview</h6>
   @if (!disciplinePerformance.Any())
   {
       <div class="text-center text-muted py-4">
           <i class="bi bi-slash-circle" style="font-size:32px;"></i>
           <p class="mb-0 mt-2">No discipline data is available for the selected scope.</p>
       </div>
   }
   else
   {
       <div class="table-scroll-area">
           <table class="table table-enterprise table-sm mb-0">
               <thead>
                   <tr>
                       <th>@Localizer["Discipline"]</th>
                       <th>@Localizer["Documents"]</th>
                       <th>@Localizer["Rejections"]</th>
                       <th>Avg Revisions</th>
                       <th>@Localizer["Risk"]</th>
                   </tr>
               </thead>
               <tbody>
                   @foreach (var item in disciplinePerformance)
                   {
                       var avgRevisions = item.DocumentCount > 0 ? (double)item.RevisionCount / item.DocumentCount : 0d;
                       <tr>
                           <td class="fw-semibold">@item.DisciplineName</td>
                           <td>@item.DocumentCount</td>
                           <td>@item.RejectionCount</td>
                           <td>@avgRevisions.ToString("0.0")</td>
                           <td>
                               <div class="d-flex align-items-center gap-2">
                                   <div class="progress flex-grow-1" style="height: 8px; min-width: 70px;">
                                       <div class="progress-bar @(item.RiskScore >= 60 ? "bg-danger" : item.RiskScore >= 35 ? "bg-warning" : "bg-success")" role="progressbar" style="width: @item.RiskScore%;" aria-valuenow="@item.RiskScore" aria-valuemin="0" aria-valuemax="100"></div>
                                   </div>
                                   <span class="small text-muted">@item.RiskScore</span>
                               </div>
                           </td>
                       </tr>
                   }
               </tbody>
           </table>
       </div>
   }
</div>
