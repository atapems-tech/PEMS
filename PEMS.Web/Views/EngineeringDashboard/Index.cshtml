@model PEMS.Web.Models.EngineeringDashboardViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Dashboard";

    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;

    // طبق Phase E-05D: فقط KPI هایی Drilldown می‌گیرند که دقیقاً با یک مقدار Status در
    // EngineeringDocumentListFilter قابل‌بیان باشند (Approved/Rejected). Pending یعنی
    // Submitted-OR-Checked که این فیلتر تک‌مقداری نمی‌تواند دقیق بیانش کند - به‌جای Drilldown
    // نادرست/گمراه‌کننده، غیرقابل‌کلیک می‌ماند (طبق قانون "کاربر نباید حدس بزند").
    // Frozen/Overdue هم فیلد فیلتر مستقیم امروز ندارند.
    var kpis = new List<PEMS.Web.Models.KpiCardViewModel>
    {
        new() { Title = Localizer["Total"], Count = Model.Summary.Total, IconClass = "bi-file-earmark-text", ColorClass = "bg-icon-slate",
                Url = Url.Action("Index", "EngineeringDocuments") },
        new() { Title = Localizer["Approved"], Count = Model.Summary.Approved, IconClass = "bi-check-circle", ColorClass = "bg-icon-green",
                Url = Url.Action("Index", "EngineeringDocuments", new { Status = "Approved" }) },
        new() { Title = Localizer["PendingReview"], Count = Model.Summary.Pending, IconClass = "bi-hourglass-split", ColorClass = "bg-icon-amber" },
        new() { Title = Localizer["Rejected"], Count = Model.Summary.Rejected, IconClass = "bi-x-circle", ColorClass = "bg-icon-red",
                Url = Url.Action("Index", "EngineeringDocuments", new { Status = "Rejected" }) },
        new() { Title = Localizer["Frozen"], Count = Model.Summary.Frozen, IconClass = "bi-snow", ColorClass = "bg-icon-blue" },
        new() { Title = Localizer["Delayed"], Count = Model.Summary.Overdue, IconClass = "bi-exclamation-triangle", ColorClass = "bg-icon-purple" }
    };

    var attentionQueue = Model.AttentionQueue;
    var disciplinePerformance = Model.DisciplinePerformance;
}

<pems-content-card css="mb-3">
    <form method="get" asp-action="Index"><pems-row gap="2" css="align-items-end">
        <pems-col md="3">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select scale="small" name="projectId">
                <option value="">@Localizer["All"]</option>
                @foreach (var p in projects)
                { <option value="@p.ProjectId" selected="@(Model.SelectedProjectId == (int)p.ProjectId)">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small">@Localizer["Discipline"]</pems-label>
            <pems-select scale="small" name="disciplineId">
                <option value="">@Localizer["All"]</option>
                @foreach (var d in disciplines)
                { <option value="@d.DisciplineId" selected="@(Model.SelectedDisciplineId == (int)d.DisciplineId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small">@Localizer["MinRevisionCount"]</pems-label>
            <pems-input scale="small" type="number" min="0" name="minRevisionCount" value="@Model.SelectedMinRevisionCount" placeholder="e.g. 2" />
        </pems-col>
        <pems-col md="3" css="d-flex gap-2">
            <pems-button tone="primary" size="small" css="flex-fill" type="submit"><pems-icon name="bi-funnel" /> @Localizer["Filter"]</pems-button>
            <pems-button tone="danger" size="small" outline="true" css="flex-fill" as="a" asp-action="Index" title="@Localizer["Reset"]" aria-label="@Localizer["Reset"]"><pems-icon name="bi-x-lg" /></pems-button>
        </pems-col>
    </pems-row></form>
    @if (Model.SelectedProjectId.HasValue || Model.SelectedDisciplineId.HasValue || Model.SelectedMinRevisionCount.HasValue)
    {
        <p class="text-muted small mt-2 mb-0">
            <pems-icon name="bi-funnel-fill" /> @Localizer["ActiveFilter"]:
            @(Model.SelectedProjectId.HasValue ? $"Project #{Model.SelectedProjectId} " : "")
            @(Model.SelectedDisciplineId.HasValue ? $"Discipline #{Model.SelectedDisciplineId} " : "")
            @(Model.SelectedMinRevisionCount.HasValue ? $"Revision ≥ {Model.SelectedMinRevisionCount}" : "")
        </p>
    }
</pems-content-card>

@* ===================== Section A: Executive Summary (GetSummaryCountsAsync, E-03) ===================== *@
<pems-content-card css="mb-3">
    <pems-flex align="center" justify="between" wrap="true" gap="2" css="section-head mb-3">
        <div>
            <h6 class="section-title mb-1"><pems-icon name="bi-speedometer2" /> @Localizer["ExecutiveSummary"]</h6>
            <p class="section-subtitle mb-0">Live snapshot of engineering activity</p>
        </div>
    </pems-flex>
    <pems-row gap="3">
        @foreach (var kpi in kpis)
        {
            <pems-col span="6" md="2">
                <pems-kpi-tile model="kpi" />
            </pems-col>
        }
    </pems-row>
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" css="mb-3">
        <h6 class="mb-0"><pems-icon name="bi-shield-check" /> Engineering Health</h6>
        <pems-badge tone="primary" css="rounded-pill fs-6">@Model.EngineeringHealthScore / 100</pems-badge>
    </pems-flex>
    <p class="text-muted small mb-3">
        Deterministic health score = weighted quality + backlog + overdue + risk. Values are computed from actual summary and revision data in the selected scope.
    </p>
    <pems-row gap="3" css="align-items-center">
        <pems-col md="3">
            <pems-kpi-tile class="h-100" icon="bi-graph-up-arrow" color="teal" label="Health Score">@Model.EngineeringHealthScore</pems-kpi-tile>
        </pems-col>
        <pems-col md="9">
            <pems-progress value="@Model.EngineeringHealthScore" tone="success" height="12px"></pems-progress>
            <div class="small text-muted mt-2">
                @if (Model.Summary.Total == 0)
                {
                    <span>No document activity in the selected scope.</span>
                }
                else
                {
                    <span>Approved rate: @(Math.Round(((double)Model.Summary.Approved / Math.Max(Model.Summary.Total, 1)) * 100, 1))%, backlog: @Model.Summary.Pending, overdue: @Model.Summary.Overdue.</span>
                }
            </div>
        </pems-col>
    </pems-row>
</pems-content-card>

@* ===================== Section B: Quality & Review (GetRevisionQualityAsync, E-05C) ===================== *@
<pems-content-card css="mb-3">
    <h6 class="mb-1"><pems-icon name="bi-award" /> @Localizer["QualityAndReview"]</h6>
    <p class="text-muted small mb-3">@Localizer["FirstPassApprovalExplanation"]</p>

    <pems-row gap="3" css="mb-3">
        <pems-col span="6" md="3">
            <pems-kpi-tile icon="bi-graph-up-arrow" color="teal" label="@Localizer["FirstPassApprovalRate"]">@(Model.FirstPassApprovalRate.HasValue ? Model.FirstPassApprovalRate.Value.ToString("P0") : "N/A")</pems-kpi-tile>
        </pems-col>
    </pems-row>
    @if (!Model.FirstPassApprovalRate.HasValue)
    {
        <p class="text-muted small">@Localizer["NoCompletedCyclesYet"]</p>
    }

    @{
        var topRejected = Model.Quality.Where(x => x.RejectionCount > 0).OrderByDescending(x => x.RejectionCount).Take(10).ToList();
    }
    <h6 class="small fw-bold mt-3">@Localizer["MostRejectedDocuments"]</h6>
    @if (!topRejected.Any())
    {
        <div class="text-center text-muted py-4">
            <pems-icon name="bi-emoji-smile" css="pems-s-4361a2ff" />
            <p class="mb-0 mt-2">@Localizer["NoRejectedDocumentsInScope"]</p>
        </div>
    }
    else
    {
        <div class="table-scroll-area">
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Document"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Rejections"]</pems-table-header><pems-table-header>@Localizer["Revisions"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var q in topRejected)
                    {
                        <pems-table-row>
                            <pems-table-cell><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@q.DocumentId">@q.DocumentNo</a></pems-table-cell>
                            <pems-table-cell class="small">@(q.DisciplineName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(q.VendorName ?? "-")</pems-table-cell>
                            <pems-table-cell><pems-badge tone="none" css="badge-status-@q.Status">@q.Status</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="danger">@q.RejectionCount</pems-badge></pems-table-cell>
                            <pems-table-cell class="small">@q.RevisionCount</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </div>
    }
</pems-content-card>

@* ===================== Section C: Revision & Resubmission Pressure (GetRevisionQualityAsync + MinRevisionCount, E-05C ADR-5) ===================== *@
<pems-content-card css="mb-3">
    <h6 class="mb-1"><pems-icon name="bi-arrow-repeat" /> @Localizer["RevisionPressure"]</h6>
    <p class="text-muted small mb-3">@Localizer["RevisionPressureExplanation"]</p>

    @{
        var highRevision = Model.Quality.Where(x => x.RevisionCount > 0).OrderByDescending(x => x.RevisionCount).Take(10).ToList();
    }
    @if (!highRevision.Any())
    {
        <div class="text-center text-muted py-4">
            <pems-icon name="bi-emoji-smile" css="pems-s-4361a2ff" />
            <p class="mb-0 mt-2">@Localizer["NoRevisedDocumentsInScope"]</p>
        </div>
    }
    else
    {
        <div class="table-scroll-area">
            <pems-table kind="enterprise" scale="small" css="mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Document"]</pems-table-header><pems-table-header>@Localizer["Discipline"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Revisions"]</pems-table-header><pems-table-header>@Localizer["FirstPass"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var q in highRevision)
                    {
                        <pems-table-row>
                            <pems-table-cell><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@q.DocumentId">@q.DocumentNo</a></pems-table-cell>
                            <pems-table-cell class="small">@(q.DisciplineName ?? "-")</pems-table-cell>
                            <pems-table-cell><pems-badge tone="none" css="badge-status-@q.Status">@q.Status</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="warning">@q.RevisionCount</pems-badge></pems-table-cell>
                            <pems-table-cell class="small">
                                @if (q.FirstPassApproved == true) { <pems-icon name="bi-check-circle" css="text-success" title="@Localizer["FirstPass"]" aria-label="@Localizer["FirstPass"]" /> }
                                else if (q.FirstPassApproved == false) { <pems-icon name="bi-x-circle" css="text-danger" title="@Localizer["NotFirstPass"]" aria-label="@Localizer["NotFirstPass"]" /> }
                                else { <span class="text-muted">-</span> }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </div>
        <div class="mt-3">
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-controller="EngineeringDocuments" asp-action="Index" asp-route-MinRevisionCount="@(Model.SelectedMinRevisionCount ?? 1)"><pems-icon name="bi-list-ul" /> @Localizer["ViewAllInMdr"]</pems-button>
        </div>
    }
</pems-content-card>

<pems-content-card css="mb-3">
   <h6 class="mb-3"><pems-icon name="bi-exclamation-triangle" /> Management Attention Queue</h6>
   @if (!attentionQueue.Any())
   {
       <div class="text-center text-muted py-4">
           <pems-icon name="bi-check-circle" css="pems-s-4361a2ff" />
           <p class="mb-0 mt-2">No high-risk documents were identified in the selected scope.</p>
       </div>
   }
   else
   {
       <div class="table-scroll-area">
           <pems-table kind="enterprise" scale="small" css="mb-0">
               <pems-table-head>
                   <pems-table-row>
                       <pems-table-header>@Localizer["Document"]</pems-table-header>
                       <pems-table-header>@Localizer["Discipline"]</pems-table-header>
                       <pems-table-header>@Localizer["Reason"]</pems-table-header>
                       <pems-table-header>@Localizer["Severity"]</pems-table-header>
                       <pems-table-header>@Localizer["Revisions"]</pems-table-header>
                       <pems-table-header>@Localizer["Rejections"]</pems-table-header>
                   </pems-table-row>
               </pems-table-head>
               <pems-table-body>
                   @foreach (var item in attentionQueue)
                   {
                       <pems-table-row>
                           <pems-table-cell><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@item.DocumentId">@item.DocumentNo</a></pems-table-cell>
                           <pems-table-cell class="small">@item.DisciplineName</pems-table-cell>
                           <pems-table-cell class="small">@item.Reason</pems-table-cell>
                           <pems-table-cell>
                               @if (item.Severity == "Critical")
                               {
                                   <pems-badge tone="danger">@item.Severity</pems-badge>
                               }
                               else if (item.Severity == "High")
                               {
                                   <pems-badge tone="warning">@item.Severity</pems-badge>
                               }
                               else
                               {
                                   <pems-badge tone="neutral">@item.Severity</pems-badge>
                               }
                           </pems-table-cell>
                           <pems-table-cell><pems-badge tone="info">@item.RevisionCount</pems-badge></pems-table-cell>
                           <pems-table-cell><pems-badge tone="danger">@item.RejectionCount</pems-badge></pems-table-cell>
                       </pems-table-row>
                   }
               </pems-table-body>
           </pems-table>
       </div>
   }
</pems-content-card>

<pems-content-card css="mb-3">
   <h6 class="mb-3"><pems-icon name="bi-diagram-3" /> Discipline Risk Overview</h6>
   @if (!disciplinePerformance.Any())
   {
       <div class="text-center text-muted py-4">
           <pems-icon name="bi-slash-circle" css="pems-s-4361a2ff" />
           <p class="mb-0 mt-2">No discipline data is available for the selected scope.</p>
       </div>
   }
   else
   {
       <div class="table-scroll-area">
           <pems-table kind="enterprise" scale="small" css="mb-0">
               <pems-table-head>
                   <pems-table-row>
                       <pems-table-header>@Localizer["Discipline"]</pems-table-header>
                       <pems-table-header>@Localizer["Documents"]</pems-table-header>
                       <pems-table-header>@Localizer["Rejections"]</pems-table-header>
                       <pems-table-header>Avg Revisions</pems-table-header>
                       <pems-table-header>@Localizer["Risk"]</pems-table-header>
                   </pems-table-row>
               </pems-table-head>
               <pems-table-body>
                   @foreach (var item in disciplinePerformance)
                   {
                       var avgRevisions = item.DocumentCount > 0 ? (double)item.RevisionCount / item.DocumentCount : 0d;
                       <pems-table-row>
                           <pems-table-cell class="fw-semibold">@item.DisciplineName</pems-table-cell>
                           <pems-table-cell>@item.DocumentCount</pems-table-cell>
                           <pems-table-cell>@item.RejectionCount</pems-table-cell>
                           <pems-table-cell>@avgRevisions.ToString("0.0")</pems-table-cell>
                           <pems-table-cell>
                               <pems-flex align="center" gap="2">
                                   <pems-progress class="pems-minw-70" value="@item.RiskScore" tone="@(item.RiskScore >= 60 ? "danger" : item.RiskScore >= 35 ? "warning" : "success")" height="8px" css="flex-grow-1"></pems-progress>
                                   <span class="small text-muted">@item.RiskScore</span>
                               </pems-flex>
                           </pems-table-cell>
                       </pems-table-row>
                   }
               </pems-table-body>
           </pems-table>
       </div>
   }
</pems-content-card>
