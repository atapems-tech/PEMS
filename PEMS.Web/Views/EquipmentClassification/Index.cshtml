@model PEMS.Application.DTOs.ClassificationDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
}

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-md-2">
            <pems-kpi-tile compact label="@Localizer["Total Active Equipment"]">@Model.TotalActiveEquipment.ToString("N0")</pems-kpi-tile>
        </div>
        <div class="col-md-2">
            <pems-kpi-tile compact tone="success" label="Classified">@Model.ClassifiedCount.ToString("N0")</pems-kpi-tile>
        </div>
        <div class="col-md-2">
            <pems-kpi-tile compact label="Unclassified">@Model.UnclassifiedCount.ToString("N0")</pems-kpi-tile>
        </div>
        <div class="col-md-2">
            <pems-kpi-tile compact label="Coverage">@Model.CoveragePercent.ToString("0.0")%</pems-kpi-tile>
        </div>
        <div class="col-md-2">
            <pems-kpi-tile compact tone="warning" label="@Localizer["Pending Review"]">@Model.PendingReviewCount.ToString("N0")</pems-kpi-tile>
        </div>
        <div class="col-md-2">
            <pems-button tone="primary" size="small" css="mt-2" as="a" asp-action="ReviewQueue">
                <i class="bi bi-list-check"></i> Review Queue
            </pems-button>
            <pems-button tone="neutral" size="small" outline="true" css="mt-2" as="a" asp-action="Coverage">
                <i class="bi bi-grid-3x3-gap"></i> Coverage Matrix
            </pems-button>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3">Classified — by Confidence</h6>
            @foreach (var item in Model.ByConfidence)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </div>
                <pems-progress value="@item.Count" max="@Model.ClassifiedCount" height="6px" css="mb-2"></pems-progress>
            }
            @if (!Model.ByConfidence.Any()) { <p class="text-muted small">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3">Classified — by Source</h6>
            @foreach (var item in Model.BySource)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </div>
                <pems-progress value="@item.Count" max="@Model.ClassifiedCount" tone="info" height="6px" css="mb-2"></pems-progress>
            }
            @if (!Model.BySource.Any()) { <p class="text-muted small">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3">Pending Suggestions — by Confidence</h6>
            @foreach (var item in Model.PendingSuggestionsByConfidence)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </div>
            }
            @if (!Model.PendingSuggestionsByConfidence.Any()) { <p class="text-muted small">@Localizer["هیچ پیشنهادی در انتظار بازبینی نیست."]</p> }
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-3">Unclassified — by Discipline</h6>
            @foreach (var item in Model.UnclassifiedByDiscipline)
            {
                <div class="d-flex justify-content-between small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </div>
            }
            @if (!Model.UnclassifiedByDiscipline.Any()) { <p class="text-muted small">@Localizer["داده‌ای موجود نیست."]</p> }
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Classified — by Equipment Class (Top 20)</h6>
    <div class="table-responsive">
        <table class="table table-enterprise table-sm">
            <thead><tr><th>@Localizer["Equipment Class"]</th><th>@Localizer["Count"]</th></tr></thead>
            <tbody>
                @foreach (var item in Model.ByEquipmentClass)
                {
                    <tr><td>@item.Key</td><td>@item.Count.ToString("N0")</td></tr>
                }
            </tbody>
        </table>
        @if (!Model.ByEquipmentClass.Any()) { <p class="text-muted small text-center py-3">@Localizer["داده‌ای موجود نیست."]</p> }
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-3">Top Unclassified — EquipmentType</h6>
            <div class="table-responsive" style="max-height:400px;">
                <table class="table table-enterprise table-sm">
                    <tbody>
                        @foreach (var item in Model.TopUnclassifiedEquipmentTypes)
                        {
                            <tr><td class="small">@item.Key</td><td class="text-end">@item.Count.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-3">Top Unclassified — Name</h6>
            <div class="table-responsive" style="max-height:400px;">
                <table class="table table-enterprise table-sm">
                    <tbody>
                        @foreach (var item in Model.TopUnclassifiedEquipmentNames)
                        {
                            <tr><td class="small">@item.Key</td><td class="text-end">@item.Count.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card h-100">
            <h6 class="mb-3">Top Unclassified — Tag Pattern</h6>
            <div class="table-responsive" style="max-height:400px;">
                <table class="table table-enterprise table-sm">
                    <tbody>
                        @foreach (var item in Model.TopUnclassifiedTagPatterns)
                        {
                            <tr><td class="small"><code>@item.Key</code></td><td class="text-end">@item.Count.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
