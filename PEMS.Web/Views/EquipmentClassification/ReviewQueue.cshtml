@model PEMS.Application.DTOs.ReviewQueuePageDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = (string)ViewBag.StatusFilter;
    var totalPages = Model.PageSize == 0 ? 1 : (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    var statuses = new[] { ("PENDING", "Pending"), ("ACCEPTED", "Accepted"), ("REJECTED", "Rejected") };
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the three status buttons became the status filter (always one of the three, no "all"), the note the heading tooltip, the page-number row the shared pager. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null)
    {
        <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
    }
    @if (TempData["Error"] != null)
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
    }

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Classification Review Queue"]" total="@Model.TotalCount"
                           heading-title="هر پیشنهاد فقط MEDIUM/LOW یا AI است (EXACT/HIGH مستقیم اعمال شده‌اند) - تایید یا رد کاملاً روی Equipment.EquipmentClassId اثر دارد و به‌صورت خودکار در Audit Log ثبت می‌شود.">
            <pems-list-tools>
                <pems-list-filters form-id="ecFilter" action="@Url.Action("ReviewQueue")" count="@(status == "PENDING" ? 0 : 1)" reset-href="@Url.Action("ReviewQueue")">
                    <pems-list-filter-select id="ecStatus" name="status" label="@Localizer["Status"]" value="@status"
                                             items="@statuses.Select(s => new SelectListItem(s.Item2, s.Item1))" />
                </pems-list-filters>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(!Model.Items.Any())" empty-text="@Localizer["موردی در این وضعیت وجود ندارد."]">
                <thead>
                    <tr>
                        <th>@Localizer["Tag"]</th><th>@Localizer["Name"]</th><th>@Localizer["Type"]</th><th>@Localizer["Discipline"]</th>
                        <th>Suggested Class</th><th>@Localizer["Confidence"]</th><th>@Localizer["Source"]</th><th>@Localizer["Reason"]</th>
                        @if (status == "PENDING") { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><code>@item.TagNumber</code></td>
                            <td class="small">@item.EquipmentName</td>
                            <td class="small text-muted">@item.EquipmentType</td>
                            <td class="small text-muted">@(item.DisciplineName ?? "-")</td>
                            <td class="small"><pems-badge tone="light">@item.SuggestedEquipmentClassName</pems-badge></td>
                            <td><pems-badge tone="warning">@item.Confidence</pems-badge></td>
                            <td class="small text-muted">@item.Source</td>
                            <td class="small text-muted">@item.Reason</td>
                            @if (status == "PENDING")
                            {
                                <td class="text-end text-nowrap">
                                    <form asp-action="Accept" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.SuggestionId" />
                                        <input type="hidden" name="status" value="@status" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <pems-button tone="success" size="small" outline="true" type="submit" title="@Localizer["تایید"]"><pems-icon name="bi-check-lg" /></pems-button>
                                    </form>
                                    <form asp-action="Reject" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.SuggestionId" />
                                        <input type="hidden" name="status" value="@status" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit" title="رد"><pems-icon name="bi-x-lg" /></pems-button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = totalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    BaseUrl = Url.Action("ReviewQueue") ?? "",
                    ExistingQueryString = $"status={Uri.EscapeDataString(status)}"
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
