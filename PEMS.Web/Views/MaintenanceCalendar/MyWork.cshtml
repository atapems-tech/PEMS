@model List<PEMS.Application.DTOs.WorkOrderCalendarItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    DateTime day = ViewBag.Day;
    string TypeBadgeClass(string t) => t switch
    {
        "Preventive" => "bg-info text-dark",
        "Corrective" => "bg-warning text-dark",
        "Emergency" => "bg-danger",
        "Predictive" => "bg-purple",
        _ => "bg-secondary"
    };
}

<div class="content-card mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
        <div class="d-flex gap-2 align-items-center">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")">@Localizer["Today"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@day.AddDays(-1).ToString("yyyy-MM-dd")"><i class="bi bi-chevron-left"></i></pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@day.AddDays(1).ToString("yyyy-MM-dd")"><i class="bi bi-chevron-right"></i></pems-button>
        </div>
        <h6 class="mb-0">@Localizer["My Work"] &mdash; @day.ToString("dddd, MMM d")</h6>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">@Localizer["No work scheduled for you on this day."]</p>
    }
    <div class="pems-cal-day-timeline">
        @foreach (var it in Model.OrderBy(x => x.PlannedStart))
        {
            <a class="pems-cal-day-card @TypeBadgeClass(it.WorkOrderType) @(it.HasEmployeeConflict ? "pems-cal-conflict" : "")"
               href="@Url.Action("Details", "WorkOrder", new { id = it.WorkOrderId })">
                <div class="pems-cal-day-time" dir="ltr">@it.PlannedStart.ToString("HH:mm") &ndash; @it.PlannedFinish.ToString("HH:mm")</div>
                <div class="pems-cal-day-body">
                    <div class="fw-bold">@it.WorkOrderNumber &middot; @it.EquipmentTagNumber</div>
                    <div class="small">@it.EquipmentDescription</div>
                    <div class="small">
                        <pems-badge tone="none" css="@TypeBadgeClass(it.WorkOrderType)">@it.WorkOrderType</pems-badge>
                        <pems-badge tone="neutral">@it.Status</pems-badge>
                        @if (it.HasEmployeeConflict) { <pems-badge tone="danger"><i class="bi bi-exclamation-triangle"></i> @Localizer["Conflict"]</pems-badge> }
                    </div>
                    <div class="small text-muted">@it.AssignedTeamName</div>
                </div>
            </a>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pems-maintenance-calendar.css" asp-append-version="true" />
}
