            </pems-col>

            <pems-col lg="4">
                <section class="vs-panel" aria-labelledby="vdrSummaryTitle">
                    <div class="vs-panel__body">
                        <h2 id="vdrSummaryTitle" class="vs-section__title">@Localizer["Vd_ReviewSummary"]</h2>
                        <pems-info-grid class="small mb-3">
    <pems-info-item label="@Localizer["Vd_Reviewers"]">@Localizer["Vd_Role_Lead"], @Localizer["Vd_Role_DocControl"]</pems-info-item>
    <pems-info-item label="@Localizer["Vd_Step2Title"]">@Localizer["Vd_None"]</pems-info-item>
</pems-info-grid>
                        <pems-button tone="primary" css="w-100" type="submit" id="vdrStartBtn" aria-describedby="vdrWhyDisabled"><pems-icon name="bi-play-fill" aria-hidden="true" /> @Localizer["Vd_StartReview"]</pems-button>
                        <p id="vdrWhyDisabled" class="small text-warning-emphasis mt-2 mb-0" hidden>@Localizer["Vd_EnterTransmittalToEnable"]</p>
                    </div>
                </section>
            </pems-col>
        </pems-row>
    </pems-form>
}
else
{
<pems-content-card css="mb-3">
    <h6 class="mb-3"><pems-icon name="bi-signpost-split" /> @Localizer["Vd_ReviewWorkflow"]</h6>

    @if (Model.Submissions.Any())
    {
        <p class="text-muted small">@Localizer["Vd_AlreadyRecorded"] @string.Join(", ", Model.Submissions.OrderBy(s => s.RevisionNo).Select(s => Localizer["Vd_Rev"].Value + " " + s.RevisionNo))</p>
    }

    @if (currentStageName == "DisciplineReview")
    {
        var reviewStatus = (IEnumerable<PEMS.Application.Interfaces.VdrReviewStatusItemDto>)ViewBag.ReviewStatus;
        var myDisciplineId = ViewBag.MyDisciplineId as int?;
        var myPending = reviewStatus.FirstOrDefault(x => x.DisciplineId == myDisciplineId && x.Status == "Pending");

        <h6 class="small fw-bold">@Localizer["Vd_ParallelReview"]</h6>
        <pems-flex wrap="true" gap="2" css="mb-3">
            @foreach (var r in reviewStatus)
            {
                var badgeClass = r.Status switch { "Approve" => "success", "Comment" => "warning", "Reject" => "danger", _ => "neutral" };
                <pems-badge tone="@badgeClass">@r.DisciplineName: @VdrUi.Loc(Localizer, "St_", r.Status)</pems-badge>
            }
        </pems-flex>

        @if (myPending != null)
        {
            <pems-flex gap="2">
                <pems-form asp-action="DisciplineRespond" method="post" class="d-inline">
                    <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                    <input type="hidden" name="decision" value="Approve" />
                    <pems-button tone="success" size="small">@Localizer["Vd_Approve"]</pems-button>
                </pems-form>
                <pems-button tone="warning" size="small" type="button" data-bs-toggle="modal" data-bs-target="#vdrCommentModal">@Localizer["Vd_CommentBtn"]</pems-button>
                <pems-button tone="danger" size="small" type="button" data-bs-toggle="modal" data-bs-target="#vdrRejectModal">@Localizer["Vd_RejectBtn"]</pems-button>
            </pems-flex>

            <pems-modal id="vdrCommentModal" tabindex="-1">
                    <pems-form asp-action="DisciplineRespond" method="post">
                        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                        <input type="hidden" name="decision" value="Comment" />
                        <pems-modal-header>@Localizer["Vd_RecordComment"]</pems-modal-header>
                        <pems-modal-body><pems-textarea scale="small" name="comment" rows="3" required></pems-textarea></pems-modal-body>
                        <pems-modal-footer>
                            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</pems-button>
                            <pems-button tone="warning" size="small" type="submit">@Localizer["Vd_Submit"]</pems-button>
                        </pems-modal-footer>
                    </pems-form>
                </pems-modal>
            <pems-modal id="vdrRejectModal" tabindex="-1">
                    <pems-form asp-action="DisciplineRespond" method="post">
                        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                        <input type="hidden" name="decision" value="Reject" />
                        <pems-modal-header>@Localizer["Vd_RejectTitle"]</pems-modal-header>
                        <pems-modal-body><pems-textarea scale="small" name="comment" rows="3" required></pems-textarea></pems-modal-body>
                        <pems-modal-footer>
                            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</pems-button>
                            <pems-button tone="danger" size="small" type="submit">@Localizer["Vd_RejectBtn"]</pems-button>
                        </pems-modal-footer>
                    </pems-form>
                </pems-modal>
        }
        else
        {
            <pems-badge tone="warning"><pems-icon name="bi-hourglass-split" /> @Localizer["Vd_WaitingOthers"]</pems-badge>
        }
    }
    else if (currentStageName == "LeadReview")
    {
        <h6 class="small fw-bold">@Localizer["Vd_FinalDecision"]</h6>
        <pems-form asp-action="LeadReview" method="post"><pems-row gap="2">
            <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
            <pems-col md="3">
                <pems-label css="small">@Localizer["Vd_ReviewCategory"]</pems-label>
                <pems-select scale="small" name="reviewCategory" required>
                    <option value="AP">@Localizer["Vd_Cat_AP"]</option>
                    <option value="NC">@Localizer["Vd_Cat_NC"]</option>
                    <option value="AC">@Localizer["Vd_Cat_AC"]</option>
                    <option value="CO">@Localizer["Vd_Cat_CO"]</option>
                    <option value="RE">@Localizer["Vd_Cat_RE"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-label css="small">@Localizer["Vd_CommentSheetNo"]</pems-label><pems-input scale="small" name="clientCommentSheetNo" /></pems-col>
            <pems-col md="3"><pems-label css="small">@Localizer["Vd_CommentDate"]</pems-label><pems-date name="clientCommentDate" scale="small" /></pems-col>
            <pems-col md="3" css="d-flex align-items-end">
                <pems-button tone="primary" size="small" css="w-100" type="submit">@Localizer["Vd_RecordFinal"]</pems-button>
            </pems-col>
        </pems-row></pems-form>
    }
    else if (currentStageName == "ReturnToVendor")
    {
        <h6 class="small fw-bold">@Localizer["Vd_FormalReturn"]</h6>
        <p class="text-muted small">@Localizer["Vd_ReturnHint"]</p>
        <pems-form asp-action="ReturnToVendor" method="post"><pems-row gap="2">
            <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
            <pems-col md="4"><pems-label css="small">@Localizer["Vd_ReplySheetNo"]</pems-label><pems-input scale="small" name="replySheetNo" /></pems-col>
            <pems-col md="4"><pems-label css="small">@Localizer["Vd_ClientTransmittalNo"]</pems-label><pems-input scale="small" name="clientTransmittalNo" /></pems-col>
            <pems-col md="4" css="d-flex align-items-end">
                <pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-send" /> @Localizer["Vd_ReturnToVendor"]</pems-button>
            </pems-col>
        </pems-row></pems-form>
    }
</pems-content-card>
}


@* تاریخچه‌ی واقعی گردش‌کار از موتور عمومی (نه فقط رشته‌ی خلاصه‌ی وضعیت) *@
<pems-content-card>
    <h6 class="mb-3"><pems-icon name="bi-clock-history" /> @Localizer["Vd_WorkflowHistory"]</h6>
    @if (workflowHistory.Any())
    {
        <pems-related-table>
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Vd_From"]</pems-table-header><pems-table-header>@Localizer["Vd_To"]</pems-table-header><pems-table-header>@Localizer["Vd_Action"]</pems-table-header><pems-table-header>@Localizer["Vd_Decision"]</pems-table-header><pems-table-header>@Localizer["Vd_Comment"]</pems-table-header><pems-table-header>@Localizer["Vd_Date"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var h in workflowHistory.OrderByDescending(x => x.ActionDate))
                {
                    <pems-table-row>
                        <pems-table-cell class="small">@VdrUi.Loc(Localizer, "Vd_Stage_", h.FromStageName)</pems-table-cell>
                        <pems-table-cell class="small">@VdrUi.Loc(Localizer, "Vd_Stage_", h.ToStageName)</pems-table-cell>
                        <pems-table-cell><pems-badge tone="neutral">@h.ActionType</pems-badge></pems-table-cell>
                        <pems-table-cell class="small">@h.Decision</pems-table-cell>
                        <pems-table-cell class="small">@h.Comment</pems-table-cell>
                        <pems-table-cell class="small text-muted">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
    }
    else
    {
        <p class="text-muted text-center py-4 mb-0">@Localizer["Vd_NoWorkflowYet"]</p>
    }
</pems-content-card>
</pems-tab-pane>

@* ===================== Correspondence ===================== *@
<pems-tab-pane fade="true" id="tab-correspondence" role="tabpanel">
<pems-content-card>
    <h6 class="mb-3"><pems-icon name="bi-envelope-paper" /> @Localizer["Vd_RelatedCorr"]</h6>
    @if (relatedLetters.Any())
    {
        <pems-related-table>
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Vd_Type"]</pems-table-header><pems-table-header>@Localizer["Vd_LetterNo"]</pems-table-header><pems-table-header>@Localizer["Vd_Subject"]</pems-table-header><pems-table-header>@Localizer["Vd_Date"]</pems-table-header><pems-table-header>@Localizer["Vd_Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var l in relatedLetters)
                {
                    <pems-table-row>
                        <pems-table-cell><pems-badge tone="neutral">@l.LetterType</pems-badge></pems-table-cell>
                        <pems-table-cell>@l.LetterNumber</pems-table-cell>
                        <pems-table-cell>@l.Subject</pems-table-cell>
                        <pems-table-cell class="small text-muted">@l.LetterDate.ToString("yyyy-MM-dd")</pems-table-cell>
                        <pems-table-cell><pems-badge tone="info">@l.Status</pems-badge></pems-table-cell>
                        <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId"><pems-icon name="bi-eye" /></pems-button></pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
    }
    else
    {
        <p class="text-muted text-center py-4 mb-0">@Localizer["Vd_NoCorr"]</p>
    }
</pems-content-card>
</pems-tab-pane>

</pems-tab-content>
@* پایان tab-content *@

</pems-page-shell>
@* پایان vs-page *@

@section Scripts {
    <script src="~/js/views/vdr-details.js" asp-append-version="true"></script>
}
