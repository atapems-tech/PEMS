@model PEMS.Application.DTOs.VDRItemDto
@using PEMS.Web.Models
@using PEMS.Web.Helpers
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var relatedLetters = (List<PEMS.Application.DTOs.RelatedLetterDto>)(ViewBag.RelatedLetters ?? new List<PEMS.Application.DTOs.RelatedLetterDto>());
    var workflowHistory = (IReadOnlyList<PEMS.WorkflowPlatform.Dtos.WorkflowHistoryDto>)(ViewBag.WorkflowHistory ?? new List<PEMS.WorkflowPlatform.Dtos.WorkflowHistoryDto>());

    // طبق «PEMS Phase 2C-3»: منطق تعیین مرحله عیناً همان منطق قبلی _VdrWorkflowStagesDiagram
    // است - فقط جابه‌جا شده به این‌جا، بدون هیچ تغییر رفتاری.
    var wfStatus = Model.WorkflowStatus ?? "Planned";
    var wfStageName = (string?)ViewBag.CurrentStageName;
    var wfStageOrder = new[] { "Planned", "Check", "DisciplineReview", "LeadReview", "ReturnToVendor", "Closed" };
    var wfStageLabels = new Dictionary<string, string>
    {
        ["Planned"] = Localizer["Vd_Stage_Planned"].Value, ["Check"] = Localizer["Vd_Stage_Check"].Value, ["DisciplineReview"] = Localizer["Vd_Stage_DisciplineReview"].Value,
        ["LeadReview"] = Localizer["Vd_Stage_LeadReview"].Value, ["ReturnToVendor"] = Localizer["Vd_Stage_ReturnToVendor"].Value, ["Closed"] = Localizer["Vd_Stage_Closed"].Value
    };
    var wfStageIcons = new Dictionary<string, string>
    {
        ["Planned"] = "bi-hourglass", ["Check"] = "bi-send", ["DisciplineReview"] = "bi-diagram-3",
        ["LeadReview"] = "bi-clipboard-check", ["ReturnToVendor"] = "bi-reply", ["Closed"] = "bi-check2-circle"
    };
    var wfStageRoles = new Dictionary<string, string>
    {
        ["Planned"] = Localizer["Vd_Role_Vendor"].Value, ["Check"] = Localizer["Vd_Role_Vendor"].Value, ["DisciplineReview"] = Localizer["Vd_Role_Disciplines"].Value,
        ["LeadReview"] = Localizer["Vd_Role_Lead"].Value, ["ReturnToVendor"] = Localizer["Vd_Role_DocControl"].Value, ["Closed"] = "—"
    };
    var wfIsPendingResubmission = wfStatus == "PendingResubmission";
    // تب پیش‌فرض: گردش‌کار (شروع یا ادامه‌ی چرخه‌ی بازبینی)؛ مدرک بسته‌شده با نمای کلی باز می‌شود
    var vdrDefaultTab = wfStatus == "Closed" ? "overview" : "workflow";
    // SCRUM-530: the Files tab (every submission file with a preview); ?tab=files&file={attachmentId} opens it on that file
    var vdrFiles = VdrFiles.From(Model.Submissions);
    var vdrPreviewFile = VdrFiles.Selected(vdrFiles, int.TryParse(Context.Request.Query["file"], out var requestedFileId) ? requestedFileId : null);
    if (Context.Request.Query["tab"] == "files") vdrDefaultTab = "files";
    var vdrPreviewUrl = vdrPreviewFile == null ? null : Url.Action("Preview", "Files", new { id = vdrPreviewFile.AttachmentId });
    // شماره‌ی بازنگری بعدی را سیستم پیشنهاد می‌کند (آخرین + ۱)؛ همین مقدار با فرم ارسال می‌شود
    var nextRevisionNo = (Model.LatestRevisionNo ?? -1) + 1;

    int wfCurrentIndex;
    if (!string.IsNullOrEmpty(wfStageName) && Array.IndexOf(wfStageOrder, wfStageName) >= 0)
        wfCurrentIndex = Array.IndexOf(wfStageOrder, wfStageName);
    else if (wfStatus == "Closed")
        wfCurrentIndex = wfStageOrder.Length - 1;
    else if (wfIsPendingResubmission)
        wfCurrentIndex = Array.IndexOf(wfStageOrder, "LeadReview");
    else
        wfCurrentIndex = 0;

    var wfStageDiagramModel = new StageDiagramViewModel
    {
        Stages = wfStageOrder.Select((key, i) =>
        {
            var isBranchedRange = wfIsPendingResubmission && i >= wfCurrentIndex && key != "Planned" && key != "Check";
            var state = isBranchedRange
                ? (i == wfCurrentIndex ? StageItemState.Rejected : StageItemState.Pending)
                : i < wfCurrentIndex ? StageItemState.Done
                : i == wfCurrentIndex ? StageItemState.Current
                : StageItemState.Pending;

            return new StageDiagramItem
            {
                Label = wfStageLabels[key],
                IconCssClass = wfStageIcons[key],
                RoleLabel = wfStageRoles[key],
                State = state
            };
        }).ToList()
    };
}

@{ ViewData["Title"] = Model.DocumentNumber; ViewData["HidePageTitle"] = true; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<pems-page-shell kind="workspace">

<nav aria-label="@Localizer["Vd_Breadcrumb"]" class="small text-muted mb-2">
    <a asp-action="Index">VDR</a> / <a asp-controller="Vendor" asp-action="Details" asp-route-id="@Model.VendorId">@Model.VendorName</a> / <span>@Model.DocumentNumber</span>
</nav>

<div class="vs-doc-head">
    <div class="vs-doc-identity">
        <pems-flex align="center" gap="2" wrap="true">
            <h1 class="vs-doc-number vs-num">@Model.DocumentNumber</h1>
            <span class="vs-pill @VdrUi.WorkflowTone(Model.WorkflowStatus)">@VdrUi.Loc(Localizer, "St_", Model.WorkflowStatus)</span>
            @if (Model.IsOverdue) { <span class="vs-pill vs-pill--danger">@Localizer["Vs_Overdue"]</span> }
            <span class="vs-pill vs-pill--current">@Localizer["Vd_Rev"] <span class="vs-num">@(Model.LatestRevisionNo ?? 0)</span></span>
        </pems-flex>
        <div class="vs-doc-meta">@Localizer["Vd_VendorLabel"] <a asp-controller="Vendor" asp-action="Details" asp-route-id="@Model.VendorId">@Model.VendorName</a> &middot; @Model.ProjectName@(string.IsNullOrEmpty(Model.DisciplineCodeRaw) ? "" : " · " + Model.DisciplineCodeRaw)</div>
    </div>
    <div class="vs-doc-actions">
        <a asp-action="Index" class="vs-btn"><pems-icon name="bi-arrow-left" aria-hidden="true" /> @Localizer["Vs_Back"]</a>
    </div>
</div>

<pems-nav css="mb-3" id="vdrTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link @(vdrDefaultTab == "overview" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <pems-icon name="bi-info-circle" /> @Localizer["Vs_TabOverview"]
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link @(vdrDefaultTab == "workflow" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-workflow" type="button">
            <pems-icon name="bi-signpost-split" /> @Localizer["Vs_TabWorkflow"]
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-submissions" type="button">
            <pems-icon name="bi-clock-history" /> @Localizer["Vs_TabSubmissions"] <pems-badge tone="neutral">@Model.Submissions.Count</pems-badge>
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link @(vdrDefaultTab == "files" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-files" type="button">
            <pems-icon name="bi-paperclip" /> @Localizer["Vd_TabFiles"] <pems-badge tone="neutral">@vdrFiles.Count</pems-badge>
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button">
            <pems-icon name="bi-chat-square-text" /> @Localizer["Vs_TabComments"]
        </pems-button>
    </li>
    <li class="nav-item" role="presentation">
        <pems-button plain="true" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-correspondence" type="button">
            <pems-icon name="bi-envelope-paper" /> @Localizer["Vs_TabCorrespondence"]
            @if (relatedLetters.Any()) { <pems-badge tone="neutral">@relatedLetters.Count</pems-badge> }
        </pems-button>
    </li>
</pems-nav>

@{
    var comments = (List<PEMS.Application.DTOs.VDRCommentDto>)ViewBag.Comments;
    var latestSubmissionWithFile = Model.Submissions.OrderByDescending(s => s.RevisionNo)
        .FirstOrDefault(s => !string.IsNullOrEmpty(s.MainFilePath) && s.MainFilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase));
}

<pems-tab-content>

@* ===================== Overview ===================== *@
<pems-tab-pane fade="true" css="@(vdrDefaultTab == "overview" ? "show active" : "")" id="tab-overview" role="tabpanel">
<div class="vs-panel">
    <div class="vs-panel__body">
        <pems-info-grid>
            <pems-info-item label="@Localizer["Vs_Type"]">@Model.DocumentTypeCode</pems-info-item>
            <pems-info-item label="@Localizer["Vs_Po"]">@Model.PoNumber</pems-info-item>
            <pems-info-item label="@Localizer["Vs_Equipment"]">
                    @if (Model.EquipmentId.HasValue)
                    { <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.EquipmentTagNumber</a> }
                    else
                    { <span class="text-muted">-</span> }
            </pems-info-item>
            <pems-info-item label="@Localizer["Vs_Discipline"]">@Model.DisciplineCodeRaw @(Model.IsMultiDiscipline ? Localizer["Vs_MultiDiscipline"].Value : "")</pems-info-item>
            <pems-info-item label="@Localizer["Vs_Class"]">@Model.DocumentClass</pems-info-item>
            <pems-info-item label="@Localizer["Vs_PlannedFirstIssue"]">@(Model.PlannedFirstIssueDate?.ToString("yyyy-MM-dd"))</pems-info-item>
            <pems-info-item label="@Localizer["Vd_VendorFormatNo"]" mono empty-text="-">@Model.VendorFormatDocumentNumber</pems-info-item>
            <pems-info-item label="@Localizer["Vs_Description"]" wide>@Model.DocumentDescription</pems-info-item>
        </pems-info-grid>
    </div>
</div>

@* SCRUM-529: the CONTRACTOR and SUB-CONTRACTOR number forms moved to Admin > Document numbering (same actions and logic). *@
@if (User.IsInRole(PEMS.Persistence.Identity.SystemRoles.SystemAdmin))
{
    <pems-flex justify="end" css="mb-3">
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-area="Admin" asp-controller="Numbering" asp-action="Index" asp-route-vdrItemId="@Model.VDRItemId" asp-fragment="vdr-numbers">
            <pems-icon name="bi-hash" /> @Localizer["Vd_NumbersInAdmin"]
        </pems-button>
    </pems-flex>
}
</pems-tab-pane>

@* ===================== Submissions ===================== *@
<pems-tab-pane fade="true" id="tab-submissions" role="tabpanel">
<pems-content-card css="mb-3">
    <h6 class="mb-3">@Localizer["Vd_SubHistory"]</h6>
    <pems-related-table>
        <pems-table-head>
            <pems-table-row><pems-table-header>@Localizer["Vd_Rev"]</pems-table-header><pems-table-header>@Localizer["Vd_VendorTransmittal"]</pems-table-header><pems-table-header>@Localizer["Vd_ClientTransmittal"]</pems-table-header><pems-table-header>@Localizer["Vd_VendorIssued"]</pems-table-header><pems-table-header>@Localizer["Vd_Poi"]</pems-table-header><pems-table-header>@Localizer["Vd_Sla"]</pems-table-header><pems-table-header>@Localizer["Vd_Ftp"]</pems-table-header><pems-table-header>@Localizer["Vd_CommentSheet"]</pems-table-header><pems-table-header>@Localizer["Vd_CommentDate"]</pems-table-header><pems-table-header>@Localizer["Vd_Category"]</pems-table-header><pems-table-header>@Localizer["Vd_Resubmit"]</pems-table-header><pems-table-header>@Localizer["Vd_CommentFile"]</pems-table-header><pems-table-header>@Localizer["Vd_ReplyFile"]</pems-table-header></pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var s in Model.Submissions)
            {
                <pems-table-row>
                    <pems-table-cell>@s.RevisionNo</pems-table-cell>
                    <pems-table-cell>@s.VendorTransmittalNo</pems-table-cell>
                    <pems-table-cell>
                        @if (s.ClientTransmittalId.HasValue)
                        {
                            <a asp-controller="Transmittal" asp-action="Details" asp-route-id="@s.ClientTransmittalId">@s.ClientTransmittalNo</a>
                        }
                        else
                        {
                            @s.ClientTransmittalNo
                        }
                    </pems-table-cell>
                    <pems-table-cell>@(s.VendorActualIssuedDate?.ToString("yyyy-MM-dd"))</pems-table-cell>
                    <pems-table-cell>@s.PurposeOfIssueCode</pems-table-cell>
                    <pems-table-cell>
                        @if (s.ClientCommentDate == null && s.ContractorCommentDueDate.HasValue)
                        {
                            <pems-badge tone="@(s.IsContractorCommentOverdue ? "danger" : "info")">
                                @Localizer["Vd_ContractorDue"] @s.ContractorCommentDueDate.Value.ToString("yyyy-MM-dd")@(s.IsContractorCommentOverdue ? " " + Localizer["Vd_OverdueParen"].Value : "")
                            </pems-badge>
                        }
                        else if (s.ReplySheetDate == null && s.VendorReturnDueDate.HasValue)
                        {
                            <pems-badge tone="@(s.IsVendorReturnOverdue ? "danger" : "info")">
                                @Localizer["Vd_ReturnDue"] @s.VendorReturnDueDate.Value.ToString("yyyy-MM-dd")@(s.IsVendorReturnOverdue ? " " + Localizer["Vd_OverdueParen"].Value : "")
                            </pems-badge>
                        }
                    </pems-table-cell>
                    <pems-table-cell>
                        @if (s.FtpUploadedDate.HasValue)
                        {
                            <pems-badge tone="success" title="@s.FtpRemotePath"><pems-icon name="bi-check-circle" /> @s.FtpUploadedDate.Value.ToString("yyyy-MM-dd")</pems-badge>
                        }
                        else
                        {
                            <pems-form asp-action="UploadToFtp" method="post" enctype="multipart/form-data"><pems-flex gap="1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <pems-input class="pems-maxw-120" scale="small" type="file" name="file" required />
                                <pems-button tone="primary" size="small" outline="true" title="@Localizer["Vd_UploadFtp"]"><pems-icon name="bi-cloud-upload" /></pems-button>
                            </pems-flex></pems-form>
                        }
                    </pems-table-cell>
                    <pems-table-cell>@s.ClientCommentSheetNo</pems-table-cell>
                    <pems-table-cell>@(s.ClientCommentDate?.ToString("yyyy-MM-dd"))</pems-table-cell>
                    <pems-table-cell><pems-badge tone="neutral">@s.ReviewCategory</pems-badge></pems-table-cell>
                    <pems-table-cell>@(s.RequiresResubmission ? Localizer["Vd_Yes"].Value : "")</pems-table-cell>
                    <pems-table-cell>
                        @if (!string.IsNullOrEmpty(s.CommentSheetFilePath))
                        {
                            <pems-button tone="neutral" size="small" outline="true" as="a" href="@Url.Action("Download", "Files", new { id = s.CommentSheetAttachmentId })" target="_blank" title="@s.CommentSheetFileName"><pems-icon name="bi-file-earmark-text" /></pems-button>
                        }
                        else
                        {
                            <pems-form asp-action="UploadCommentSheet" method="post" enctype="multipart/form-data"><pems-flex gap="1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <pems-input class="pems-maxw-120" scale="small" type="file" name="file" required />
                                <pems-button tone="primary" size="small" outline="true"><pems-icon name="bi-upload" /></pems-button>
                            </pems-flex></pems-form>
                        }
                    </pems-table-cell>
                    <pems-table-cell>
                        @if (!string.IsNullOrEmpty(s.ReplySheetFilePath))
                        {
                            <pems-button tone="neutral" size="small" outline="true" as="a" href="@Url.Action("Download", "Files", new { id = s.ReplySheetAttachmentId })" target="_blank" title="@s.ReplySheetFileName"><pems-icon name="bi-file-earmark-text" /></pems-button>
                        }
                        else
                        {
                            <pems-form asp-action="UploadReplySheet" method="post" enctype="multipart/form-data"><pems-flex gap="1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <pems-input class="pems-maxw-120" scale="small" type="file" name="file" required />
                                <pems-button tone="primary" size="small" outline="true"><pems-icon name="bi-upload" /></pems-button>
                            </pems-flex></pems-form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    @if (!Model.Submissions.Any()) { <p class="text-muted">@Localizer["Vd_NoSubmissions"]</p> }
</pems-content-card>
</pems-tab-pane>

@* ===================== Files (SCRUM-530) ===================== *@
<pems-tab-pane fade="true" css="@(vdrDefaultTab == "files" ? "show active" : "")" id="tab-files" role="tabpanel">
    @* SCRUM-531: upload a file to a submission; it is stored in PEMS and listed below (Upload to FTP keeps no copy in PEMS) *@
    <pems-content-card css="mb-3">
        <h6 class="mb-2"><pems-icon name="bi-upload" /> @Localizer["Vd_UploadTitle"]</h6>
        @if (Model.Submissions.Count == 0)
        {
            <p class="text-muted small mb-0">@Localizer["Vd_UploadNeedsSubmission"]</p>
        }
        else
        {
            <p class="text-muted small mb-3">@Localizer["Vd_UploadHint"]</p>
            <pems-form asp-action="UploadSubmissionFile" method="post" enctype="multipart/form-data" id="vdrFileUpload">
                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                <pems-row gap="2" css="align-items-end">
                    <pems-col md="3">
                        <pems-label for="vdrUploadSubmission">@Localizer["Vd_UploadRevision"]</pems-label>
                        <pems-select id="vdrUploadSubmission" name="submissionId" required>
                            @foreach (var s in Model.Submissions.OrderByDescending(x => x.RevisionNo))
                            {
                                <option value="@s.VDRSubmissionId">@Localizer["Vs_Rev"] @s.RevisionNo@(string.IsNullOrEmpty(s.VendorTransmittalNo) ? "" : " - " + s.VendorTransmittalNo)</option>
                            }
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="vdrUploadKind">@Localizer["Vd_FileKind"]</pems-label>
                        <pems-select id="vdrUploadKind" name="kind" required>
                            @foreach (var k in VdrFiles.Kinds) { <option value="@k">@Localizer["Vd_FileKind_" + k]</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="4">
                        <pems-label for="vdrUploadFile">@Localizer["Vd_FileName"]</pems-label>
                        <pems-input id="vdrUploadFile" type="file" name="file" required />
                    </pems-col>
                    <pems-col md="2">
                        <pems-button tone="primary" type="submit" css="w-100"><pems-icon name="bi-upload" /> @Localizer["Vd_Upload"]</pems-button>
                    </pems-col>
                </pems-row>
            </pems-form>
        }
    </pems-content-card>

    @if (vdrFiles.Count == 0)
    {
        <p class="text-muted text-center py-4">@Localizer["Vd_NoFiles"]</p>
    }
    else
    {
        <pems-table kind="enterprise" css="mb-3">
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header>@Localizer["Vd_FileName"]</pems-table-header>
                    <pems-table-header>@Localizer["Vs_Rev"]</pems-table-header>
                    <pems-table-header>@Localizer["Vd_FileKind"]</pems-table-header>
                    <pems-table-header class="text-end"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var f in vdrFiles)
                {
                    <pems-table-row class="@(vdrPreviewFile?.AttachmentId == f.AttachmentId ? "table-active" : "")">
                        <pems-table-cell>@f.FileName</pems-table-cell>
                        <pems-table-cell><span class="vs-num">@f.RevisionNo</span></pems-table-cell>
                        <pems-table-cell>@Localizer["Vd_FileKind_" + f.Kind]</pems-table-cell>
                        <pems-table-cell class="text-end">
                            <pems-flex gap="1" justify="end">
                                @if (f.CanPreview)
                                {
                                    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@Model.VDRItemId" asp-route-tab="files" asp-route-file="@f.AttachmentId" asp-fragment="tab-files" aria-label="@Localizer["Vd_Preview"] @f.FileName"><pems-icon name="bi-eye" /> @Localizer["Vd_Preview"]</pems-button>
                                }
                                <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="Files" asp-action="Download" asp-route-id="@f.AttachmentId" aria-label="@Localizer["Vd_Download"] @f.FileName"><pems-icon name="bi-download" /></pems-button>
                            </pems-flex>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>

        @if (vdrPreviewFile != null)
        {
            <h6 class="mb-2"><pems-icon name="bi-eye" /> @vdrPreviewFile.FileName</h6>
        }
        <pems-file-preview id="vdrFilePreview" src="@vdrPreviewUrl" title="@vdrPreviewFile?.FileName" empty-text="@Localizer["Vd_NoPreview"]" />
    }
</pems-tab-pane>

@* ===================== Comments (شامل PDF Viewer) ===================== *@
<pems-tab-pane fade="true" id="tab-comments" role="tabpanel">



@if (latestSubmissionWithFile != null)
{
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="center" css="mb-2">
            <h6 class="mb-0"><pems-icon name="bi-file-earmark-pdf" /> @Localizer["Vd_DocViewer"] <span class="text-muted small">@Localizer["Vd_PinHint"]</span></h6>
            <pems-flex align="center" gap="2">
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfPrevPage"><pems-icon name="bi-chevron-left" /></pems-button>
                <span class="small" id="pdfPageLabel">@Localizer["Vd_Page"] - / -</span>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfNextPage"><pems-icon name="bi-chevron-right" /></pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfZoomOut"><pems-icon name="bi-zoom-out" /></pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" id="pdfZoomIn"><pems-icon name="bi-zoom-in" /></pems-button>
            </pems-flex>
        </pems-flex>
        <div class="pems-pdf-canvas" id="pdfCanvasWrapper">
            <canvas id="pdfCanvas"></canvas>
        </div>
    </pems-content-card>

    <script type="module" src="~/js/pdfjs-loader.js"></script>
    <script type="module">
        (function () {

            var pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Download", "Files", new { id = latestSubmissionWithFile.AttachmentId })));
            var wrapper = document.getElementById('pdfCanvasWrapper');
            var canvas = document.getElementById('pdfCanvas');
            var ctx = canvas.getContext('2d');
            var pdfDoc = null, currentPage = 1, scale = 1.2;
            var T = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { page = Localizer["Vd_Page"].Value, pinned = Localizer["Vd_PinnedOnPage"].Value, pdfError = Localizer["Vd_PdfError"].Value }, new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }));

            // پین‌های کامنت موجود، فقط برای همان چرخه‌ی ارسال فعلی (@latestSubmissionWithFile.VDRSubmissionId)
            var pins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(comments
                .Where(c => c.VDRSubmissionId == latestSubmissionWithFile.VDRSubmissionId && c.PageNumber.HasValue)
                .Select(c => new { c.CommentNo, c.PageNumber, c.PinX, c.PinY, c.CommentText }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            function renderPage(num) {
                pdfDoc.getPage(num).then(function (page) {
                    var viewport = page.getViewport({ scale: scale });
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;

                    page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function () {
                        document.getElementById('pdfPageLabel').textContent = T.page + ' ' + num + ' / ' + pdfDoc.numPages;
                        renderPins(num, viewport.width, viewport.height);
                    });
                });
            }

            function renderPins(pageNum, width, height) {
                wrapper.querySelectorAll('.pdf-pin').forEach(function (el) { el.remove(); });

                pins.filter(function (p) { return p.pageNumber === pageNum; }).forEach(function (p) {
                    var pin = document.createElement('div');
                    pin.className = 'pdf-pin';
                    pin.title = p.commentNo + ': ' + p.commentText;
                    pin.style.cssText = 'position:absolute;width:22px;height:22px;border-radius:50% 50% 50% 0;' +
                        'background:#ef4444;border:2px solid #fff;transform:translate(-50%,-100%) rotate(-45deg);' +
                        'left:' + (p.pinX / 100 * width) + 'px;top:' + (p.pinY / 100 * height) + 'px;cursor:pointer;';
                    wrapper.appendChild(pin);
                });
            }

            pdfjsLib.getDocument(pdfUrl).promise.then(function (doc) {
                pdfDoc = doc;
                renderPage(currentPage);
            }).catch(function () {
                wrapper.innerHTML = '<p class="text-muted py-4"></p>'; wrapper.firstChild.textContent = T.pdfError;
            });

            document.getElementById('pdfPrevPage').addEventListener('click', function () {
                if (currentPage > 1) { currentPage--; renderPage(currentPage); }
            });
            document.getElementById('pdfNextPage').addEventListener('click', function () {
                if (pdfDoc && currentPage < pdfDoc.numPages) { currentPage++; renderPage(currentPage); }
            });
            document.getElementById('pdfZoomIn').addEventListener('click', function () { scale += 0.2; renderPage(currentPage); });
            document.getElementById('pdfZoomOut').addEventListener('click', function () { if (scale > 0.4) { scale -= 0.2; renderPage(currentPage); } });

            canvas.addEventListener('click', function (e) {
                var rect = canvas.getBoundingClientRect();
                var xPct = ((e.clientX - rect.left) / rect.width) * 100;
                var yPct = ((e.clientY - rect.top) / rect.height) * 100;

                document.getElementById('pinPageNumber').value = currentPage;
                document.getElementById('pinX').value = xPct.toFixed(2);
                document.getElementById('pinY').value = yPct.toFixed(2);
                document.getElementById('pinLocationLabel').textContent = T.pinned + ' ' + currentPage;

                var modal = new bootstrap.Modal(document.getElementById('addCommentModal'));
                modal.show();
            });

            document.getElementById('addCommentModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('pinPageNumber').value = '';
                document.getElementById('pinX').value = '';
                document.getElementById('pinY').value = '';
                document.getElementById('pinLocationLabel').textContent = '';
            });
        })();
    </script>
}

