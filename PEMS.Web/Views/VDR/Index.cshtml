@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VDRListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.DTOs.VDRDashboardDto)ViewBag.Dashboard;
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    int? selectedProjectId = ViewBag.SelectedProjectId;
    int? selectedVendorId = ViewBag.SelectedVendorId;
    var selectedStatus = (string?)ViewBag.SelectedStatus;
    var search = (string?)ViewBag.Search;

    // تعداد فیلترهای فعال برای نشان کنار آیکون فیلتر
    var activeFilters = (selectedProjectId != null ? 1 : 0) + (selectedVendorId != null ? 1 : 0) + (!string.IsNullOrEmpty(selectedStatus) ? 1 : 0);
    string? projectName = null, vendorName = null;
    if (selectedProjectId != null) foreach (var p in projects) { if ((int)p.ProjectId == selectedProjectId) projectName = (string)p.ProjectName; }
    if (selectedVendorId != null) foreach (var v in vendors) { if ((int)v.VendorId == selectedVendorId) vendorName = (string)v.Name; }
}

@{ ViewData["Title"] = Localizer["Vs_VdrRegisterHeading"].Value; ViewData["HidePageTitle"] = true; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-409: دقیقاً همان قاب فهرست مدارک مهندسی (SCRUM-408) - جدول تمام‌صفحه، نوار ابزار آیکنی، فیلترها در منوی کشویی،
   شمارش‌ها و ریسک تأخیر فروشنده پیش‌فرض پنهان. SCRUM-337: ساخته‌شده از کامپوننت فهرست PEMS.UI. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">

    <nav class="vs-subnav" aria-label="@Localizer["Ed_Documents"]">
        <a asp-controller="EngineeringDocuments" asp-action="Index">@Localizer["Ed_Documents"]</a>
        <a asp-controller="DocumentRegister" asp-action="Index">@Localizer["Ed_Register"]</a>
        <a asp-controller="VDR" asp-action="Index" class="active" aria-current="page">@Localizer["Ed_VendorDocs"]</a>
        <a asp-controller="Transmittal" asp-action="Index">@Localizer["Ed_Transmittals"]</a>
    </nav>

    <pems-list-panel>

        <pems-list-toolbar id="vdrToolbar" heading="@Localizer["Vs_VdrRegisterHeading"]" heading-title="@Localizer["Vs_VdrSubtitle"]" total="@Model.TotalCount">
            @* جستجو در شماره، شرح و نام فروشنده؛ Autocomplete مشترک با نوع VDRItem *@
            <pems-list-search id="vdrSearchForm" action="@Url.Action("Index")" input-id="vdrSearchInput" name="search" value="@search"
                              placeholder="@Localizer["Vs_QuickSearchPlaceholder"]" search-type="VDRItem">
                @if (selectedProjectId != null) { <input type="hidden" name="projectId" value="@selectedProjectId" /> }
                @if (selectedVendorId != null) { <input type="hidden" name="vendorId" value="@selectedVendorId" /> }
                @if (!string.IsNullOrEmpty(selectedStatus)) { <input type="hidden" name="status" value="@selectedStatus" /> }
            </pems-list-search>

            <pems-list-tools search-for="vdrSearchForm">
                <pems-list-filters form-id="vdrFilterForm" action="@Url.Action("Index")" count="@activeFilters" reset-href="@Url.Action("Index", new { search })">
                    <input type="hidden" name="search" value="@search" />
                    <div>
                        <label class="lp-lbl" for="vdrFltProject">@Localizer["Vs_Project"]</label>
                        <select id="vdrFltProject" name="projectId" class="form-select form-select-sm">
                            <option value="">@Localizer["All"]</option>
                            @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == selectedProjectId)">@p.ProjectName</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="vdrFltVendor">@Localizer["Vendor"]</label>
                        <select id="vdrFltVendor" name="vendorId" class="form-select form-select-sm">
                            <option value="">@Localizer["All"]</option>
                            @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == selectedVendorId)">@v.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="vdrFltStatus">@Localizer["Status"]</label>
                        <select id="vdrFltStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["All"]</option>
                            @foreach (var s in new[] { "Planned", "Submitted", "UnderReview", "PendingResubmission", "Closed" })
                            { <option value="@s" selected="@(s == selectedStatus)">@VdrUi.Loc(Localizer, "St_", s)</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="vdrKpis" storage-key="pems.vdr.kpis" />
                <pems-list-export href="@Url.Action("Export", new { projectId = selectedProjectId, vendorId = selectedVendorId, status = selectedStatus, search })" />
                <pems-list-reset-columns grid-key="VDR" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Vs_NewVendorDocument"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        @* شمارش‌ها و ریسک تأخیر فروشنده؛ پیش‌فرض پنهان (SCRUM-409) *@
        <pems-list-kpis id="vdrKpis">
            <span class="vs-chip">@Localizer["Vs_TotalItems"] <strong>@dash.TotalItems</strong></span>
            <span class="vs-chip @(dash.OverdueItems > 0 ? "vs-chip--danger" : "")">@Localizer["Vs_Overdue"] <strong>@dash.OverdueItems</strong></span>
            <span class="vs-chip @(dash.SlaOverdueItems > 0 ? "vs-chip--danger" : "")">@Localizer["Vs_SlaOverdue"] <strong>@dash.SlaOverdueItems</strong></span>
            <span class="vs-chip">@Localizer["Vs_OnTimeRate"] <strong>@dash.OnTimePercentage.ToString("0")%</strong></span>
            @if (dash.TopDelayedVendors.Any())
            {
                <details class="lp-kpi-pop">
                    <summary class="vs-chip vs-chip--danger"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> @Localizer["Vs_VendorDelayRisk"] <strong>@dash.TopDelayedVendors.Count</strong></summary>
                    <ul class="vs-list">
                        @foreach (var v in dash.TopDelayedVendors)
                        {
                            <li>
                                <div>
                                    <div class="vs-cell-strong">@v.VendorName</div>
                                    <div class="vs-cell-sub">@Localizer["Vs_OverdueItems"]: @v.OverdueCount &middot; @Localizer["Vs_AvgDelay"]: @v.AverageDelayDays</div>
                                </div>
                                <span class="vs-pill @VdrUi.RiskTone(v.RiskLevel)">@VdrUi.Loc(Localizer, "St_", v.RiskLevel)</span>
                            </li>
                        }
                    </ul>
                </details>
            }
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index", new { search })">
            @if (selectedProjectId != null)
            { <pems-list-chip label="@Localizer["Vs_Project"]" value="@projectName" remove-href="@Url.Action("Index", new { vendorId = selectedVendorId, status = selectedStatus, search })" /> }
            @if (selectedVendorId != null)
            { <pems-list-chip label="@Localizer["Vendor"]" value="@vendorName" remove-href="@Url.Action("Index", new { projectId = selectedProjectId, status = selectedStatus, search })" /> }
            @if (!string.IsNullOrEmpty(selectedStatus))
            { <pems-list-chip label="@Localizer["Status"]" value="@VdrUi.Loc(Localizer, "St_", selectedStatus)" remove-href="@Url.Action("Index", new { projectId = selectedProjectId, vendorId = selectedVendorId, search })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="VDR" empty="@(!Model.Items.Any())" empty-text="@Localizer["Vs_NoVdrItems"]"
                             filtered="@(activeFilters > 0 || !string.IsNullOrEmpty(search))" clear-href="@Url.Action("Index")">
                    <thead>
                        <tr>
                            <th data-col-key="docNo" data-resizable="true" data-min-width="110" data-max-width="260" style="width:170px">@Localizer["Vs_DocNo"]</th>
                            <th data-col-key="description" data-resizable="true" data-min-width="180" data-max-width="500" style="width:280px">@Localizer["Vs_Description"]</th>
                            <th data-col-key="type" data-resizable="true" data-min-width="70" data-max-width="180" style="width:100px" class="vs-hide-md">@Localizer["Type"]</th>
                            <th data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="240" style="width:160px">@Localizer["Vendor"]</th>
                            <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="260" style="width:170px">@Localizer["Vs_Project"]</th>
                            <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Vs_Discipline"]</th>
                            <th data-col-key="rev" data-resizable="true" data-min-width="56" data-max-width="110" style="width:70px">@Localizer["Vs_Rev"]</th>
                            <th data-col-key="latestCategory" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px" class="vs-hide-md">@Localizer["Vs_LatestCategory"]</th>
                            <th data-col-key="status" data-resizable="true" data-min-width="110" data-max-width="220" style="width:160px">@Localizer["Status"]</th>
                            <th data-col-key="actions" data-resizable="false" style="width:80px"><span class="visually-hidden">@Localizer["Vs_View"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr class="lp-row @(i.IsOverdue ? "table-danger" : "")">
                                <td class="lp-no"><a asp-action="Details" asp-route-id="@i.VDRItemId" class="lp-subject" title="@i.DocumentNumber">@i.DocumentNumber</a></td>
                                <td><span class="vs-title-cell" title="@i.DocumentDescription">@i.DocumentDescription</span></td>
                                <td class="vs-hide-md small" title="@i.DocumentTypeCode">@i.DocumentTypeCode</td>
                                <td class="small" title="@i.VendorName">@i.VendorName</td>
                                <td class="small" title="@i.ProjectName">@i.ProjectName</td>
                                <td class="small" title="@i.DisciplineName">@(string.IsNullOrEmpty(i.DisciplineName) ? "—" : i.DisciplineName)</td>
                                <td><span class="vs-num">@i.LatestRevisionNo</span></td>
                                <td class="vs-hide-md small" title="@i.LatestReviewCategory">@i.LatestReviewCategory</td>
                                <td>
                                    <span class="vs-pill @VdrUi.WorkflowTone(i.WorkflowStatus)">@VdrUi.Loc(Localizer, "St_", i.WorkflowStatus)</span>
                                    @if (i.IsOverdue) { <span class="vs-pill vs-pill--danger">@Localizer["Vs_Overdue"]</span> }
                                </td>
                                <td class="text-nowrap lp-actions">
                                    <a asp-action="Details" asp-route-id="@i.VDRItemId" class="lp-act lp-act--always" title="@Localizer["Vs_View"]"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Vs_View"]: @i.DocumentNumber</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
            </pems-list-table>

            <pems-list-footer>
                @{
                    var vdrQsParts = new List<string>();
                    if (selectedProjectId != null) vdrQsParts.Add($"projectId={selectedProjectId}");
                    if (selectedVendorId != null) vdrQsParts.Add($"vendorId={selectedVendorId}");
                    if (!string.IsNullOrEmpty(selectedStatus)) vdrQsParts.Add($"status={Uri.EscapeDataString(selectedStatus)}");
                    if (!string.IsNullOrEmpty(search)) vdrQsParts.Add($"search={Uri.EscapeDataString(search)}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "VDR",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", vdrQsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>

</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
