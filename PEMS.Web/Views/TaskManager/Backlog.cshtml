@model PEMS.Application.DTOs.BacklogDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var view = Model.View;
    var canRank = view.CanRank;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var hasActive = view.Sprints.Any(s => s.State == PEMS.Domain.Entities.SprintStates.Active);
    var futureSprints = view.Sprints.Where(s => s.State == PEMS.Domain.Entities.SprintStates.Future).ToList();
    ViewData["CanRank"] = canRank;
    ViewData["ShowBulk"] = true;
    ViewData["Sprints"] = view.Sprints;
}
@section Styles { <link rel="stylesheet" href="~/css/pems-task-manager.css" asp-append-version="true" /> }

<partial name="_SpaceHeader" model="view" />
@if (canRank) { <div hidden data-tm-reorder-url="@Url.Action("Reorder", "TaskManager")"></div> }

<div class="vs-panel mb-2 py-2">
    <partial name="_BulkBar" />
    <p class="small text-muted mb-0" data-tm-bulk-hint>@Localizer["Tm_BulkHint"]</p>
</div>

@foreach (var (sprint, items) in Model.SprintPanels)
{
    var isActive = sprint.State == PEMS.Domain.Entities.SprintStates.Active;
    <section class="vs-panel mb-3 tm-sprint @(isActive ? "tm-sprint--active" : "")" aria-labelledby="sprint-@sprint.Id">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div>
                <h3 class="h6 mb-0" id="sprint-@sprint.Id">
                    @sprint.Name
                    <pems-badge tone="@(isActive ? "success" : "neutral")" css="ms-1">@Localizer["Tm_SprintState_" + sprint.State]</pems-badge>
                </h3>
                <div class="small text-muted">
                    @TaskManagerUi.Date(sprint.StartDate) @(sprint.StartDate != null || sprint.EndDate != null ? "–" : "") @TaskManagerUi.Date(sprint.EndDate)
                    · @Localizer["Tm_SprintCounts", sprint.ToDoCount, sprint.InProgressCount, sprint.DoneCount]
                </div>
                @if (!string.IsNullOrWhiteSpace(sprint.Goal)) { <div class="small"><pems-icon name="bi-flag" aria-hidden="true" /> @sprint.Goal</div> }
            </div>
            @if (view.CanManageSprints)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @if (!isActive && !hasActive)
                    {
                        <form asp-action="StartSprint" method="post">
                            <input type="hidden" name="sprintId" value="@sprint.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                            <pems-button tone="primary" size="small"><pems-icon name="bi-play-fill" aria-hidden="true" /> @Localizer["Tm_StartSprint"]</pems-button>
                        </form>
                    }
                    @if (isActive)
                    {
                        <form asp-action="CompleteSprint" method="post" class="d-flex gap-1 align-items-center">
                            <input type="hidden" name="sprintId" value="@sprint.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                            <label class="small text-nowrap" for="moveTo-@sprint.Id">@Localizer["Tm_MoveUnfinishedTo"]</label>
                            <pems-select scale="small" css="w-auto" id="moveTo-@sprint.Id" name="moveTo">
                                <option value="0">@Localizer["Tm_Backlog"]</option>
                                @foreach (var f in futureSprints) { <option value="@f.Id">@f.Name</option> }
                            </pems-select>
                            <pems-button tone="success" size="small" outline="true" data-pems-confirm="@Localizer["Tm_CompleteSprintConfirm"]"><pems-icon name="bi-check2-all" aria-hidden="true" /> @Localizer["Tm_CompleteSprint"]</pems-button>
                        </form>
                    }
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="collapse" data-bs-target="#editSprint-@sprint.Id" aria-expanded="false" aria-controls="editSprint-@sprint.Id"><pems-icon name="bi-pencil" aria-hidden="true" /> @Localizer["Tm_Edit"]</pems-button>
                </div>
            }
        </div>
        @if (view.CanManageSprints)
        {
            <form id="editSprint-@sprint.Id" asp-action="UpdateSprint" method="post"><pems-row gap="2" css="collapse mb-2">
                <input type="hidden" name="sprintId" value="@sprint.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                <pems-col md="3"><pems-label css="small" for="sn-@sprint.Id">@Localizer["Tm_Field_Name"]</pems-label><pems-input scale="small" id="sn-@sprint.Id" name="name" value="@sprint.Name" required maxlength="150" /></pems-col>
                <pems-col md="4"><pems-label css="small" for="sg-@sprint.Id">@Localizer["Tm_Field_Goal"]</pems-label><pems-input scale="small" id="sg-@sprint.Id" name="goal" value="@sprint.Goal" maxlength="1000" /></pems-col>
                <pems-col md="2"><pems-label css="small" for="ss-@sprint.Id">@Localizer["Tm_Field_StartDate"]</pems-label><pems-date id="ss-@sprint.Id" name="startDate" value="@TaskManagerUi.DateInput(sprint.StartDate)" scale="small" /></pems-col>
                <pems-col md="2"><pems-label css="small" for="se-@sprint.Id">@Localizer["Tm_Field_EndDate"]</pems-label><pems-date id="se-@sprint.Id" name="endDate" value="@TaskManagerUi.DateInput(sprint.EndDate)" scale="small" /></pems-col>
                <pems-col md="1" css="d-flex align-items-end"><pems-button tone="primary" size="small" css="w-100">@Localizer["Tm_Save"]</pems-button></pems-col>
            </pems-row></form>
        }
        @{ ViewData["Bucket"] = $"{view.Space.Id}:{sprint.Id}"; }
        <partial name="_ItemTable" model="items" view-data="ViewData" />
    </section>
}

<section class="vs-panel mb-3" aria-labelledby="backlogTitle">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h3 class="h6 mb-0" id="backlogTitle">@Localizer["Tm_Backlog"] <pems-badge tone="light">@Model.BacklogItems.Count</pems-badge></h3>
        @if (view.CanManageSprints)
        {
            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="collapse" data-bs-target="#newSprint" aria-expanded="false" aria-controls="newSprint"><pems-icon name="bi-plus-lg" aria-hidden="true" /> @Localizer["Tm_CreateSprint"]</pems-button>
        }
    </div>
    @if (view.CanManageSprints)
    {
        <form id="newSprint" asp-action="CreateSprint" method="post"><pems-row gap="2" css="collapse mb-2">
            <input type="hidden" name="workSpaceId" value="@view.Space.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
            <pems-col md="3"><pems-label css="small" for="ns-name">@Localizer["Tm_Field_Name"]</pems-label><pems-input scale="small" id="ns-name" name="name" required maxlength="150" /></pems-col>
            <pems-col md="4"><pems-label css="small" for="ns-goal">@Localizer["Tm_Field_Goal"]</pems-label><pems-input scale="small" id="ns-goal" name="goal" maxlength="1000" /></pems-col>
            <pems-col md="2"><pems-label css="small" for="ns-start">@Localizer["Tm_Field_StartDate"]</pems-label><pems-date id="ns-start" name="startDate" scale="small" /></pems-col>
            <pems-col md="2"><pems-label css="small" for="ns-end">@Localizer["Tm_Field_EndDate"]</pems-label><pems-date id="ns-end" name="endDate" scale="small" /></pems-col>
            <pems-col md="1" css="d-flex align-items-end"><pems-button tone="primary" size="small" css="w-100">@Localizer["Tm_Create"]</pems-button></pems-col>
        </pems-row></form>
    }
    @{ ViewData["Bucket"] = $"{view.Space.Id}:"; }
    <partial name="_ItemTable" model="Model.BacklogItems" view-data="ViewData" />
    @if (canRank) { <p class="small text-muted mt-2 mb-0"><pems-icon name="bi-arrows-move" aria-hidden="true" /> @Localizer["Tm_RankHint"]</p> }
</section>

<partial name="_CreateModal" model="view" />

@section Scripts { <script src="~/js/pems-task-manager.js" asp-append-version="true"></script> }
