@model PEMS.Application.DTOs.WorkSpaceAdminDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Space;
    var departments = (List<(int Id, string Name)>)ViewBag.Departments;
    var employees = (List<PEMS.Application.DTOs.EligibleAssigneeDto>)ViewBag.Employees;
    var memberIds = Model.Members.Select(m => m.EmployeeId).ToHashSet();
}
@section Styles { <link rel="stylesheet" href="~/css/pems-task-manager.css" asp-append-version="true" /> }

<section class="vs-panel mb-3">
    <nav aria-label="breadcrumb" class="small mb-1"><a asp-action="Admin">@Localizer["Tm_Admin_Title"]</a> / <span class="tm-key">@s.Key</span></nav>
    <h2 class="h5 mb-3">@TaskManagerUi.Name(s.Name, s.NameFa)</h2>
    <form asp-action="SaveSpace" method="post" class="row g-2">
        <input type="hidden" name="Id" value="@s.Id" />
        <input type="hidden" name="Key" value="@s.Key" />
        <pems-col md="3"><pems-label css="small" for="sp-name">@Localizer["Tm_Field_Name"]</pems-label><pems-input scale="small" id="sp-name" name="Name" value="@s.Name" required maxlength="150" /></pems-col>
        <pems-col md="3"><pems-label css="small" for="sp-namefa">@Localizer["Tm_Field_NameFa"]</pems-label><pems-input scale="small" id="sp-namefa" name="NameFa" value="@s.NameFa" maxlength="150" dir="rtl" /></pems-col>
        <pems-col md="3">
            <pems-label css="small" for="sp-dept">@Localizer["Tm_Field_Department"]</pems-label>
            <pems-select scale="small" id="sp-dept" name="OwnerDepartmentId">
                <option value="">@Localizer["Tm_NoDepartment"]</option>
                @foreach (var d in departments) { <option value="@d.Id" selected="@(d.Id == s.OwnerDepartmentId)">@d.Name</option> }
            </pems-select>
        </pems-col>
        <pems-col md="3" css="d-flex align-items-end">
            <div class="form-check">
                <pems-input type="checkbox" id="sp-active" name="IsActive" value="true" checked="@s.IsActive" kind="check" />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label small" for="sp-active">@Localizer["Tm_Field_Active"]</label>
            </div>
        </pems-col>
        <pems-col md="10"><pems-label css="small" for="sp-desc">@Localizer["Tm_Field_Description"]</pems-label><pems-input scale="small" id="sp-desc" name="Description" value="@s.Description" maxlength="1000" /></pems-col>
        <pems-col md="2" css="d-flex align-items-end"><pems-button tone="primary" size="small" css="w-100">@Localizer["Tm_Save"]</pems-button></pems-col>
    </form>
    <p class="small text-muted mt-2 mb-0">@Localizer["Tm_KeyImmutable"]</p>
</section>

<pems-row gap="3">
    <pems-col lg="6">
        <section class="vs-panel mb-3" aria-labelledby="memTitle">
            <h3 class="h6" id="memTitle">@Localizer["Tm_Members"]</h3>
            <p class="small text-muted">@Localizer["Tm_MembersHint"]</p>
            @if (!Model.Members.Any()) { <div class="vs-empty py-2 small">@Localizer["Tm_NoMembers"]</div> }
            else
            {
                <pems-table scale="small" css="vs-dense">
                    <thead><tr><th>@Localizer["Tm_Field_Name"]</th><th>@Localizer["Tm_Field_Role"]</th><th>@Localizer["Tm_Field_Active"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.Members)
                        {
                            <tr class="@(m.IsActive ? "" : "text-muted")">
                                <td>@m.Name</td>
                                <td colspan="3">
                                    <form asp-action="SetMember" method="post" class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="workSpaceId" value="@s.Id" /><input type="hidden" name="memberId" value="@m.Id" />
                                        <pems-select scale="small" css="w-auto" name="role" aria-label="@Localizer["Tm_Field_Role"] @m.Name">
                                            @foreach (var r in PEMS.Domain.Entities.WorkSpaceMemberRoles.All) { <option value="@r" selected="@(r == m.Role)">@Localizer["Tm_Role_" + r]</option> }
                                        </pems-select>
                                        <pems-input type="checkbox" name="isActive" value="true" checked="@m.IsActive" aria-label="@Localizer["Tm_Field_Active"] @m.Name" kind="check" />
                                        <input type="hidden" name="isActive" value="false" />
                                        <pems-button tone="neutral" size="small" outline="true">@Localizer["Tm_Save"]</pems-button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            }
            <form asp-action="AddMember" method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="workSpaceId" value="@s.Id" />
                <label class="visually-hidden" for="am-emp">@Localizer["Tm_Employee"]</label>
                <pems-select scale="small" css="w-auto flex-grow-1" id="am-emp" name="employeeId" required>
                    <option value="">@Localizer["Tm_SelectEmployee"]</option>
                    @foreach (var e in employees.Where(e => !memberIds.Contains(e.EmployeeId))) { <option value="@e.EmployeeId">@e.Name</option> }
                </pems-select>
                <label class="visually-hidden" for="am-role">@Localizer["Tm_Field_Role"]</label>
                <pems-select scale="small" css="w-auto" id="am-role" name="role">
                    @foreach (var r in PEMS.Domain.Entities.WorkSpaceMemberRoles.All) { <option value="@r">@Localizer["Tm_Role_" + r]</option> }
                </pems-select>
                <pems-button tone="primary" size="small">@Localizer["Tm_Add"]</pems-button>
            </form>
        </section>

        <section class="vs-panel mb-3" aria-labelledby="typeTitle">
            <h3 class="h6" id="typeTitle">@Localizer["Tm_Types"]</h3>
            <pems-table scale="small" css="vs-dense">
                <tbody>
                    @foreach (var t in Model.Types)
                    {
                        <tr class="@(t.IsActive ? "" : "text-muted")">
                            <td><pems-icon css="@t.Icon" aria-hidden="true" /> @TaskManagerUi.Name(t.Name, t.NameFa) @if (t.IsSubtask) { <pems-badge tone="light">@Localizer["Tm_Subtask"]</pems-badge> }</td>
                            <td class="text-end">
                                <form asp-action="SetTypeActive" method="post">
                                    <input type="hidden" name="workSpaceId" value="@s.Id" /><input type="hidden" name="typeId" value="@t.Id" /><input type="hidden" name="isActive" value="@(t.IsActive ? "false" : "true")" />
                                    <pems-button tone="none" size="small" css="btn-link p-0">@(t.IsActive ? Localizer["Tm_Deactivate"] : Localizer["Tm_Activate"])</pems-button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            <form asp-action="AddType" method="post" class="row g-2">
                <input type="hidden" name="workSpaceId" value="@s.Id" />
                <pems-col md="3"><pems-label css="small" for="at-name">@Localizer["Tm_Field_Name"]</pems-label><pems-input scale="small" id="at-name" name="name" required maxlength="100" /></pems-col>
                <pems-col md="3"><pems-label css="small" for="at-namefa">@Localizer["Tm_Field_NameFa"]</pems-label><pems-input scale="small" id="at-namefa" name="nameFa" maxlength="100" dir="rtl" /></pems-col>
                <pems-col md="3"><pems-label css="small" for="at-icon">@Localizer["Tm_Field_Icon"]</pems-label><pems-input scale="small" id="at-icon" name="icon" value="bi-check2-square" required pattern="bi-[a-z0-9-]{1,40}" /></pems-col>
                <pems-col md="3" css="d-flex align-items-end gap-2">
                    <div class="form-check"><pems-input kind="check" type="checkbox" id="at-sub" name="isSubtask" value="true" /><label class="form-check-label small" for="at-sub">@Localizer["Tm_Subtask"]</label></div>
                    <pems-button tone="primary" size="small">@Localizer["Tm_Add"]</pems-button>
                </pems-col>
            </form>
        </section>
    </pems-col>

    <pems-col lg="6">
        <section class="vs-panel mb-3" aria-labelledby="stTitle">
            <h3 class="h6" id="stTitle">@Localizer["Tm_Statuses"]</h3>
            <p class="small text-muted">@Localizer["Tm_StatusesHint"]</p>
            @foreach (var st in Model.Statuses)
            {
                <form asp-action="EditStatus" method="post" class="row g-1 mb-1 align-items-center @(st.IsActive ? "" : "text-muted")">
                    <input type="hidden" name="workSpaceId" value="@s.Id" /><input type="hidden" name="statusId" value="@st.Id" />
                    <pems-col span="3"><pems-input scale="small" name="name" value="@st.Name" required maxlength="100" aria-label="@Localizer["Tm_Field_Name"]" /></pems-col>
                    <pems-col span="3"><pems-input scale="small" name="nameFa" value="@st.NameFa" maxlength="100" dir="rtl" aria-label="@Localizer["Tm_Field_NameFa"]" /></pems-col>
                    <pems-col span="2">
                        <pems-select scale="small" name="category" aria-label="@Localizer["Tm_Field_Category"]">
                            @foreach (var c in PEMS.Domain.Entities.WorkItemStatusCategories.All) { <option value="@c" selected="@(c == st.Category)">@Localizer["Tm_Category_" + c]</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col span="1"><pems-input scale="small" name="sortOrder" type="number" value="@st.SortOrder" min="0" max="999" aria-label="@Localizer["Tm_Field_Order"]" /></pems-col>
                    <pems-col span="1" css="text-center">
                        <pems-input type="checkbox" name="isActive" value="true" checked="@st.IsActive" aria-label="@Localizer["Tm_Field_Active"]" kind="check" />
                        <input type="hidden" name="isActive" value="false" />
                    </pems-col>
                    <pems-col span="2"><pems-button tone="neutral" size="small" outline="true" css="w-100">@Localizer["Tm_Save"]</pems-button></pems-col>
                </form>
            }
            <form asp-action="AddStatus" method="post" class="row g-1 mt-2">
                <input type="hidden" name="workSpaceId" value="@s.Id" />
                <pems-col span="4"><pems-input scale="small" name="name" required maxlength="100" placeholder="@Localizer["Tm_Field_Name"]" aria-label="@Localizer["Tm_Field_Name"]" /></pems-col>
                <pems-col span="3"><pems-input scale="small" name="nameFa" maxlength="100" dir="rtl" placeholder="@Localizer["Tm_Field_NameFa"]" aria-label="@Localizer["Tm_Field_NameFa"]" /></pems-col>
                <pems-col span="3">
                    <pems-select scale="small" name="category" aria-label="@Localizer["Tm_Field_Category"]">
                        @foreach (var c in PEMS.Domain.Entities.WorkItemStatusCategories.All) { <option value="@c">@Localizer["Tm_Category_" + c]</option> }
                    </pems-select>
                </pems-col>
                <pems-col span="2"><pems-button tone="primary" size="small" css="w-100">@Localizer["Tm_Add"]</pems-button></pems-col>
            </form>
        </section>

        <section class="vs-panel mb-3" aria-labelledby="trTitle">
            <h3 class="h6" id="trTitle">@Localizer["Tm_Transitions"]</h3>
            <p class="small text-muted">@Localizer["Tm_TransitionsHint"]</p>
            <div class="table-responsive">
                <pems-table scale="small" css="table-bordered vs-dense tm-matrix">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Tm_FromTo"]</th>
                            @foreach (var to in Model.Statuses.Where(x => x.IsActive)) { <th scope="col" class="text-center">@TaskManagerUi.Name(to.Name, to.NameFa)</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var from in Model.Statuses.Where(x => x.IsActive))
                        {
                            <tr>
                                <th scope="row">@TaskManagerUi.Name(from.Name, from.NameFa)</th>
                                @foreach (var to in Model.Statuses.Where(x => x.IsActive))
                                {
                                    <td class="text-center">
                                        @if (from.Id != to.Id)
                                        {
                                            var allowed = Model.Transitions.Contains((from.Id, to.Id));
                                            <form asp-action="SetTransition" method="post">
                                                <input type="hidden" name="workSpaceId" value="@s.Id" /><input type="hidden" name="fromStatusId" value="@from.Id" /><input type="hidden" name="toStatusId" value="@to.Id" /><input type="hidden" name="allowed" value="@(allowed ? "false" : "true")" />
                                                <pems-button tone="none" size="small" css="btn-link p-0 @(allowed ? "text-success" : "text-muted")" aria-pressed="@(allowed ? "true" : "false")" aria-label="@TaskManagerUi.Name(from.Name, from.NameFa) → @TaskManagerUi.Name(to.Name, to.NameFa): @(allowed ? Localizer["Tm_Allowed"] : Localizer["Tm_NotAllowed"])">
                                                    <pems-icon css="@(allowed ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true" />
                                                </pems-button>
                                            </form>
                                        }
                                        else { <span class="text-muted" aria-hidden="true">—</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </div>
        </section>
    </pems-col>
</pems-row>
