@model List<PEMS.Application.DTOs.WorkItemListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var canRank = ViewData["CanRank"] is true;
    var showBulk = ViewData["ShowBulk"] is true;
    var showSpace = ViewData["ShowSpace"] is true;
    var bucket = ViewData["Bucket"] as string;
}
@if (!Model.Any())
{
    <div class="vs-empty py-2 small">@Localizer["Tm_EmptyList"]</div>
}
else
{
    <pems-table-scroll>
        <pems-table scale="small" css="table-enterprise vs-dense mb-0 tm-table">
            <pems-table-head>
                <pems-table-row>
                    @if (showBulk) { <pems-table-header class="tm-col-check"><pems-input kind="check" type="checkbox" data-tm-bulk-all aria-label="@Localizer["Tm_SelectAll"]" /></pems-table-header> }
                    <pems-table-header>@Localizer["Tm_Field_Key"]</pems-table-header>
                    @if (showSpace) { <pems-table-header>@Localizer["Tm_Field_Space"]</pems-table-header> }
                    <pems-table-header>@Localizer["Tm_Field_Title"]</pems-table-header>
                    <pems-table-header>@Localizer["Tm_Field_Status"]</pems-table-header>
                    <pems-table-header>@Localizer["Tm_Field_Priority"]</pems-table-header>
                    <pems-table-header>@Localizer["Tm_Field_Assignee"]</pems-table-header>
                    <pems-table-header>@Localizer["Tm_Field_DueDate"]</pems-table-header>
                    <pems-table-header class="text-end">@Localizer["Tm_Field_StoryPointsShort"]</pems-table-header>
                    @if (canRank) { <pems-table-header><span class="visually-hidden">@Localizer["Tm_Actions"]</span></pems-table-header> }
                </pems-table-row>
            </pems-table-head>
            <pems-table-body data-tm-bucket="@bucket">
                @foreach (var i in Model)
                {
                    <partial name="~/Views/TaskManager/_ItemRow.cshtml" model="i" view-data="ViewData" />
                }
            </pems-table-body>
        </pems-table>
    </pems-table-scroll>
}
