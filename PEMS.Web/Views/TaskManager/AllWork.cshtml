@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.WorkItemListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var q = (PEMS.Application.DTOs.WorkItemQuery)ViewBag.Query;
    var spaces = (List<PEMS.Application.DTOs.WorkSpaceDto>)ViewBag.Spaces;
    var types = ViewBag.Types as List<PEMS.Application.DTOs.WorkItemTypeDto>;
    var assignees = ViewBag.Assignees as PEMS.Application.DTOs.AssigneeResolutionDto;
    var canEdit = ViewBag.CanEdit is true;
    ViewData["ShowBulk"] = canEdit;
    ViewData["ShowSpace"] = true;
    ViewData["CanRank"] = false;
    var qs = Context.Request.QueryString.Value ?? "";
    var existing = System.Text.RegularExpressions.Regex.Replace(qs.TrimStart('?'), @"(^|&)(page|pageSize)=[^&]*", "").Trim('&');
    string SortLink(string key) => Url.Action("AllWork", new { q.WorkSpaceId, q.Text, q.Assignee, q.StatusCategory, q.Priority, q.TypeId, q.SprintId, q.IncludeArchived, Sort = key, Descending = q.Sort == key && !q.Descending })!;
}
@section Styles { <link rel="stylesheet" href="~/css/pems-task-manager.css" asp-append-version="true" /> }

<section class="vs-panel mb-3">
    <nav aria-label="breadcrumb" class="small mb-1"><a asp-action="Index">@Localizer["Tm_Title"]</a></nav>
    <h2 class="h5 mb-3"><pems-icon name="bi-collection" aria-hidden="true" /> @ViewData["Title"]</h2>

    <form method="get" asp-action="AllWork" role="search"><pems-row gap="2" css="align-items-end">
        <pems-col md="3">
            <pems-label css="small" for="f-text">@Localizer["Tm_Search"]</pems-label>
            <pems-input scale="small" id="f-text" name="Text" value="@q.Text" maxlength="200" placeholder="@Localizer["Tm_SearchPlaceholder"]" />
        </pems-col>
        <pems-col md="2">
            <pems-label css="small" for="f-space">@Localizer["Tm_Field_Space"]</pems-label>
            <pems-select scale="small" id="f-space" name="WorkSpaceId">
                <option value="">@Localizer["Tm_Any"]</option>
                @foreach (var s in spaces) { <option value="@s.Id" selected="@(q.WorkSpaceId == s.Id)">@s.Key · @TaskManagerUi.Name(s.Name, s.NameFa)</option> }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-label css="small" for="f-assignee">@Localizer["Tm_Field_Assignee"]</pems-label>
            <pems-select scale="small" id="f-assignee" name="Assignee">
                <option value="">@Localizer["Tm_Any"]</option>
                <option value="me" selected="@(q.Assignee == "me")">@Localizer["Tm_Me"]</option>
                <option value="unassigned" selected="@(q.Assignee == "unassigned")">@Localizer["Tm_Unassigned"]</option>
                @if (assignees != null)
                {
                    foreach (var e in assignees.Candidates) { <option value="@e.EmployeeId" selected="@(q.Assignee == e.EmployeeId.ToString())">@e.Name</option> }
                }
            </pems-select>
        </pems-col>
        <pems-col md="2">
            <pems-label css="small" for="f-status">@Localizer["Tm_Field_Status"]</pems-label>
            <pems-select scale="small" id="f-status" name="StatusCategory">
                <option value="">@Localizer["Tm_Any"]</option>
                @foreach (var c in new[] { "NotDone", "ToDo", "InProgress", "Done" })
                { <option value="@c" selected="@(q.StatusCategory == c)">@Localizer["Tm_Category_" + c]</option> }
            </pems-select>
        </pems-col>
        <pems-col md="1">
            <pems-label css="small" for="f-priority">@Localizer["Tm_Field_Priority"]</pems-label>
            <pems-select scale="small" id="f-priority" name="Priority">
                <option value="">@Localizer["Tm_Any"]</option>
                @foreach (var p in PEMS.Domain.Entities.TaskItemPriorities.All) { <option value="@p" selected="@(q.Priority == p)">@TaskManagerUi.Priority(Localizer, p)</option> }
            </pems-select>
        </pems-col>
        @if (types != null)
        {
            <pems-col md="2">
                <pems-label css="small" for="f-type">@Localizer["Tm_Field_Type"]</pems-label>
                <pems-select scale="small" id="f-type" name="TypeId">
                    <option value="">@Localizer["Tm_Any"]</option>
                    @foreach (var t in types) { <option value="@t.Id" selected="@(q.TypeId == t.Id)">@TaskManagerUi.Name(t.Name, t.NameFa)</option> }
                </pems-select>
            </pems-col>
        }
        <pems-col md="2">
            <div class="form-check">
                <pems-input type="checkbox" id="f-archived" name="IncludeArchived" value="true" checked="@q.IncludeArchived" kind="check" />
                <label class="form-check-label small" for="f-archived">@Localizer["Tm_IncludeArchived"]</label>
            </div>
        </pems-col>
        <input type="hidden" name="Sort" value="@q.Sort" />
        <input type="hidden" name="Descending" value="@(q.Descending ? "true" : "false")" />
        <pems-col span="auto" css="d-flex gap-2">
            <pems-button tone="primary" size="small"><pems-icon name="bi-funnel" aria-hidden="true" /> @Localizer["Tm_Filter"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AllWork">@Localizer["Tm_Reset"]</pems-button>
        </pems-col>
    </pems-row></form>
    <div class="small text-muted mt-2">
        @Localizer["Tm_SortBy"]:
        @foreach (var key in new[] { "updated", "rank", "due", "priority", "created", "key" })
        {
            <a href="@SortLink(key)" class="ms-2 @(q.Sort == key || (q.Sort == null && key == "updated") ? "fw-semibold" : "")">@Localizer["Tm_Sort_" + key]@(q.Sort == key ? (q.Descending ? " ↓" : " ↑") : "")</a>
        }
    </div>
</section>

<section class="vs-panel">
    @if (canEdit)
    {
        <partial name="_BulkBar" />
        <p class="small text-muted mb-2" data-tm-bulk-hint>@(ViewBag.SpaceView != null ? Localizer["Tm_BulkHint"] : Localizer["Tm_BulkHintNoSpace"])</p>
    }
    <div class="small text-muted mb-2">@Localizer["Tm_ResultCount", Model.TotalCount]</div>
    <partial name="_ItemTable" model="Model.Items" view-data="ViewData" />
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "TaskManagerAllWork",
        BaseUrl = Url.Action("AllWork") ?? "",
        ExistingQueryString = existing
    })
</section>

@section Scripts { <script src="~/js/pems-task-manager.js" asp-append-version="true"></script> }
