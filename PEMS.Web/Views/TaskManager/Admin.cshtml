@model List<PEMS.Application.DTOs.WorkSpaceDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var departments = (List<(int Id, string Name)>)ViewBag.Departments;
}
@section Styles { <link rel="stylesheet" href="~/css/pems-task-manager.css" asp-append-version="true" /> }

<section class="vs-panel mb-3">
    <nav aria-label="breadcrumb" class="small mb-1"><a asp-action="Index">@Localizer["Tm_Title"]</a></nav>
    <h2 class="h5 mb-1"><pems-icon name="bi-gear" aria-hidden="true" /> @Localizer["Tm_Admin_Title"]</h2>
    <p class="small text-muted mb-0">@Localizer["Tm_Admin_Hint"]</p>
</section>

<section class="vs-panel mb-3">
    <h3 class="h6">@Localizer["Tm_Spaces"]</h3>
    @if (!Model.Any()) { <div class="vs-empty py-2 small">@Localizer["Tm_NoSpaces"]</div> }
    else
    {
        <pems-table-scroll>
            <pems-table scale="small" css="table-enterprise vs-dense mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Tm_Field_Key"]</pems-table-header><pems-table-header>@Localizer["Tm_Field_Name"]</pems-table-header><pems-table-header>@Localizer["Tm_Field_Department"]</pems-table-header><pems-table-header>@Localizer["Tm_Members"]</pems-table-header><pems-table-header>@Localizer["Tm_OpenItems"]</pems-table-header><pems-table-header>@Localizer["Tm_Field_Active"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var s in Model)
                    {
                        <pems-table-row class="@(s.IsActive ? "" : "text-muted")">
                            <pems-table-cell class="tm-key">@s.Key</pems-table-cell>
                            <pems-table-cell>@TaskManagerUi.Name(s.Name, s.NameFa)</pems-table-cell>
                            <pems-table-cell class="small">@(s.OwnerDepartmentName ?? "—")</pems-table-cell>
                            <pems-table-cell>@s.MemberCount</pems-table-cell>
                            <pems-table-cell>@s.OpenItemCount</pems-table-cell>
                            <pems-table-cell>@(s.IsActive ? Localizer["Tm_Yes"] : Localizer["Tm_No"])</pems-table-cell>
                            <pems-table-cell><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AdminSpace" asp-route-id="@s.Id">@Localizer["Tm_Configure"]</pems-button></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    }
</section>

<section class="vs-panel" aria-labelledby="newSpaceTitle">
    <h3 class="h6" id="newSpaceTitle">@Localizer["Tm_Admin_CreateSpace"]</h3>
    <pems-form asp-action="SaveSpace" method="post"><pems-row gap="2">
        <input type="hidden" name="IsActive" value="true" />
        <pems-col md="2">
            <pems-label css="small" for="ns-key">@Localizer["Tm_Field_Key"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
            <pems-input scale="small" css="text-uppercase" id="ns-key" name="Key" required pattern="[A-Za-z][A-Za-z0-9]{1,9}" maxlength="10" aria-describedby="ns-key-help" />
            <pems-help-text id="ns-key-help">@Localizer["Tm_KeyHelp"]</pems-help-text>
        </pems-col>
        <pems-col md="3">
            <pems-label css="small" for="ns-name">@Localizer["Tm_Field_Name"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
            <pems-input scale="small" id="ns-name" name="Name" required maxlength="150" />
        </pems-col>
        <pems-col md="3">
            <pems-label css="small" for="ns-namefa">@Localizer["Tm_Field_NameFa"]</pems-label>
            <pems-input scale="small" id="ns-namefa" name="NameFa" maxlength="150" dir="rtl" />
        </pems-col>
        <pems-col md="4">
            <pems-label css="small" for="ns-dept">@Localizer["Tm_Field_Department"]</pems-label>
            <pems-select scale="small" id="ns-dept" name="OwnerDepartmentId" aria-describedby="ns-dept-help">
                <option value="">@Localizer["Tm_NoDepartment"]</option>
                @foreach (var d in departments) { <option value="@d.Id">@d.Name</option> }
            </pems-select>
            <pems-help-text id="ns-dept-help">@Localizer["Tm_DepartmentHelp"]</pems-help-text>
        </pems-col>
        <pems-col md="10">
            <pems-label css="small" for="ns-desc">@Localizer["Tm_Field_Description"]</pems-label>
            <pems-input scale="small" id="ns-desc" name="Description" maxlength="1000" />
        </pems-col>
        <pems-col md="2" css="d-flex align-items-end"><pems-button tone="primary" size="small" css="w-100">@Localizer["Tm_Create"]</pems-button></pems-col>
    </pems-row></pems-form>
</section>
