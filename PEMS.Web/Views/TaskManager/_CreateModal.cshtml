@model PEMS.Application.DTOs.WorkSpaceViewDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var assignees = ViewBag.Assignees as PEMS.Application.DTOs.AssigneeResolutionDto ?? new PEMS.Application.DTOs.AssigneeResolutionDto();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var cleanReturn = System.Text.RegularExpressions.Regex.Replace(returnUrl, @"([?&])create=1&?", "$1").TrimEnd('?', '&');
}
@if (Model.CanCreate)
{
<pems-modal size="large" id="tmCreateModal" tabindex="-1" aria-labelledby="tmCreateTitle" aria-hidden="true" data-tm-autoopen="@(Context.Request.Query["create"].ToString() == "1" ? "1" : "0")"><form asp-controller="TaskManager" asp-action="Create" method="post" data-tm-dirty-guard data-tm-ctrl-enter>
            <div class="modal-header">
                <h3 class="modal-title h6" id="tmCreateTitle">@Localizer["Tm_Create"] · <span class="tm-key">@Model.Space.Key</span></h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Tm_Close"]"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="WorkSpaceId" value="@Model.Space.Id" />
                <input type="hidden" name="returnUrl" value="@cleanReturn" />
                <div class="row g-2">
                    <div class="col-md-8">
                        <pems-label css="small" for="tmc-title">@Localizer["Tm_Field_Title"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
                        <pems-input scale="small" id="tmc-title" name="Title" required maxlength="300" autocomplete="off" />
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-type">@Localizer["Tm_Field_Type"]</pems-label>
                        <pems-select scale="small" id="tmc-type" name="TypeId">
                            @foreach (var t in Model.Types.Where(t => !t.IsSubtask))
                            { <option value="@t.Id">@TaskManagerUi.Name(t.Name, t.NameFa)</option> }
                        </pems-select>
                    </div>
                    <div class="col-12">
                        <pems-label css="small" for="tmc-desc">@Localizer["Tm_Field_Description"]</pems-label>
                        <pems-textarea scale="small" id="tmc-desc" name="Description" rows="4" maxlength="8000"></pems-textarea>
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-assignee">@Localizer["Tm_Field_Assignee"]</pems-label>
                        <pems-select scale="small" id="tmc-assignee" name="AssigneeEmployeeId" aria-describedby="tmc-assignee-help">
                            <option value="">@Localizer["Tm_Unassigned"]</option>
                            @foreach (var e in assignees.Candidates) { <option value="@e.EmployeeId">@e.Name</option> }
                        </pems-select>
                        @if (assignees.State != "RESOLVED")
                        {
                            <div id="tmc-assignee-help" class="form-text text-warning"><pems-icon name="bi-info-circle" aria-hidden="true" /> @Localizer["Tm_Diag_" + assignees.State]</div>
                        }
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-priority">@Localizer["Tm_Field_Priority"]</pems-label>
                        <pems-select scale="small" id="tmc-priority" name="Priority">
                            @foreach (var p in PEMS.Domain.Entities.TaskItemPriorities.All)
                            { <option value="@p" selected="@(p == "Normal")">@TaskManagerUi.Priority(Localizer, p)</option> }
                        </pems-select>
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-sprint">@Localizer["Tm_Field_Sprint"]</pems-label>
                        <pems-select scale="small" id="tmc-sprint" name="SprintId">
                            <option value="">@Localizer["Tm_Backlog"]</option>
                            @foreach (var s in Model.Sprints) { <option value="@s.Id">@s.Name</option> }
                        </pems-select>
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-start">@Localizer["Tm_Field_StartDate"]</pems-label>
                        <pems-date id="tmc-start" name="StartDate" scale="small" />
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-due">@Localizer["Tm_Field_DueDate"]</pems-label>
                        <pems-date id="tmc-due" name="DueDate" scale="small" />
                    </div>
                    <div class="col-md-4">
                        <pems-label css="small" for="tmc-points">@Localizer["Tm_Field_StoryPoints"]</pems-label>
                        <pems-input scale="small" id="tmc-points" name="StoryPoints" type="number" min="0" max="1000" step="0.5" />
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <pems-input kind="check" type="checkbox" name="createAnother" value="true" id="tmc-another" />
                    <label class="form-check-label small" for="tmc-another">@Localizer["Tm_CreateAnother"]</label>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="small text-muted d-none d-md-inline">@Localizer["Tm_CtrlEnterHint"]</span>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Tm_Cancel"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Tm_Create"]</pems-button>
                </div>
            </div>
        </form></pems-modal>
}
