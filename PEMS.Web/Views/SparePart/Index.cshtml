@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.SparePartListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var q = (string?)ViewBag.SearchTerm;
    var lowStockOnly = (bool)ViewBag.LowStockOnly;
    bool? low = lowStockOnly ? true : null;
    var filterCount = lowStockOnly ? 1 : 0;

    var qsParts = new List<string>();
    if (lowStockOnly) qsParts.Add("lowStockOnly=true");
    if (!string.IsNullOrEmpty(q)) qsParts.Add($"q={Uri.EscapeDataString(q)}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The low-stock card became a KPI chip, "low stock only" a
   filter; create and edit stay modals. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Sp_Title"]" total="@Model.TotalCount">
            <pems-list-search id="spSearchForm" action="@Url.Action("Index")" input-id="spQuickSearch" name="q" value="@q"
                              placeholder="@Localizer["Sp_SearchPlaceholder"]">
                @if (lowStockOnly) { <input type="hidden" name="lowStockOnly" value="true" /> }
            </pems-list-search>

            <pems-list-tools search-for="spSearchForm">
                <pems-list-filters form-id="spFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { q })">
                    <input type="hidden" name="q" value="@q" />
                    <div class="form-check form-switch mb-0">
                        <pems-input type="checkbox" role="switch" name="lowStockOnly" value="true" id="lowStockOnly" checked="@lowStockOnly" kind="check" />
                        <label class="form-check-label small" for="lowStockOnly">@Localizer["Sp_LowStockOnly"]</label>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="spKpis" storage-key="pems.sparepart.kpis" />
                <pems-list-reset-columns grid-key="SparePart" />
                <pems-list-new modal="createPartModal" text="@Localizer["Sp_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="spKpis">
            <a class="vs-chip text-decoration-none @(((int?)ViewBag.LowStockCount ?? 0) > 0 ? "vs-chip--danger" : "")" href="@Url.Action("Index", new { lowStockOnly = true })"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Sp_LowStockCount"] <strong>@ViewBag.LowStockCount</strong></a>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q))
            { <pems-list-chip label="@Localizer["Search"]" value="@q" remove-href="@Url.Action("Index", new { lowStockOnly = low })" /> }
            @if (lowStockOnly)
            { <pems-list-chip label="@Localizer["Sp_LowStockOnly"]" remove-href="@Url.Action("Index", new { q })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="SparePart" empty="@(!Model.Items.Any())" empty-text="@Localizer["Sp_Empty"]"
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(q))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="partNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Sp_PartNo"]</th>
                        <th data-col-key="name" data-resizable="true" data-min-width="140" data-max-width="320" style="width:220px">@Localizer["Eq_Name"]</th>
                        <th data-col-key="mfr" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Sp_Manufacturer"]</th>
                        <th data-col-key="location" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Sp_Location"]</th>
                        <th data-col-key="qty" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px">@Localizer["Sp_Stock"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:90px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@p.PartNumber</span></td>
                            <td><span class="vs-title-cell" title="@p.PartName">@p.PartName</span></td>
                            <td class="small vs-hide-md">@p.Manufacturer</td>
                            <td class="small vs-hide-md">@p.StorageLocation</td>
                            <td>
                                @if (p.IsLowStock)
                                { <span class="vs-pill vs-pill--icon vs-pill--danger" title="@Localizer["Sp_BelowReorder"]"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @p.QuantityOnHand @p.Unit</span> }
                                else
                                { <span class="vs-pill vs-pill--success">@p.QuantityOnHand @p.Unit</span> }
                            </td>
                            <td class="lp-actions">
                                <button type="button" class="lp-act lp-act--always" data-bs-toggle="modal" data-bs-target="#editPartModal" data-fill-sparepartid="@p.SparePartId" data-fill-partnumber="@p.PartNumber" data-fill-partname="@p.PartName" data-fill-manufacturer="@p.Manufacturer" data-fill-model="@p.Model" data-fill-unit="@p.Unit" data-fill-storagelocation="@p.StorageLocation" data-fill-quantityonhand="@p.QuantityOnHand" data-fill-minstocklevel="@p.MinStockLevel" data-fill-reorderpoint="@p.ReorderPoint" data-fill-description="@p.Description" title="@Localizer["Edit"]" aria-label="@Localizer["Edit"]">
                                    <pems-icon name="bi-pencil" aria-hidden="true" />
                                </button>
                                <form asp-action="Deactivate" method="post" class="d-inline">
                                    <input type="hidden" name="sparePartId" value="@p.SparePartId" />
                                    <button type="submit" class="lp-act lp-act--always" title="@Localizer["Sp_Deactivate"]" aria-label="@Localizer["Sp_Deactivate"]"><pems-icon name="bi-slash-circle" aria-hidden="true" /></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "SparePart",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createPartModal" tabindex="-1">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["Sp_New"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><pems-label>@Localizer["Part Number"]</pems-label><pems-input name="partNumber" required /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Part Name"]</pems-label><pems-input name="partName" required /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input name="manufacturer" /></div>
                        <div class="col-md-6"><pems-label>@Localizer["Model"]</pems-label><pems-input name="model" /></div>
                        <div class="col-md-4"><pems-label>@Localizer["Unit"]</pems-label><pems-input name="unit" placeholder="PCS, SET, KG..." /></div>
                        <div class="col-md-4"><pems-label>@Localizer["Storage Location"]</pems-label><pems-input name="storageLocation" placeholder="Warehouse-A-Rack3" /></div>
                        <div class="col-md-4"></div>
                        <div class="col-md-4"><pems-label>@Localizer["Quantity On Hand"]</pems-label><pems-input name="quantityOnHand" type="number" step="0.01" value="0" required /></div>
                        <div class="col-md-4"><pems-label>@Localizer["Min Stock Level"]</pems-label><pems-input name="minStockLevel" type="number" step="0.01" /></div>
                        <div class="col-md-4"><pems-label>@Localizer["Reorder Point"]</pems-label><pems-input name="reorderPoint" type="number" step="0.01" /></div>
                        <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </pems-modal>

@if (Model.Items.Any())
{
    <pems-modal id="editPartModal" tabindex="-1">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="sparePartId" value="" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["Sp_Edit"]</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6"><pems-label>@Localizer["Part Number"]</pems-label><pems-input name="partNumber" required /></div>
                            <div class="col-md-6"><pems-label>@Localizer["Part Name"]</pems-label><pems-input name="partName" required /></div>
                            <div class="col-md-6"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input name="manufacturer" /></div>
                            <div class="col-md-6"><pems-label>@Localizer["Model"]</pems-label><pems-input name="model" /></div>
                            <div class="col-md-4"><pems-label>@Localizer["Unit"]</pems-label><pems-input name="unit" /></div>
                            <div class="col-md-8"><pems-label>@Localizer["Storage Location"]</pems-label><pems-input name="storageLocation" /></div>
                            <div class="col-md-4"><pems-label>@Localizer["Quantity On Hand"]</pems-label><pems-input name="quantityOnHand" type="number" step="0.01" required /></div>
                            <div class="col-md-4"><pems-label>@Localizer["Min Stock Level"]</pems-label><pems-input name="minStockLevel" type="number" step="0.01" /></div>
                            <div class="col-md-4"><pems-label>@Localizer["Reorder Point"]</pems-label><pems-input name="reorderPoint" type="number" step="0.01" /></div>
                            <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="2"></pems-textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                    </div>
                </form>
            </pems-modal>
}

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
