@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.SparePartListDto>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-danger">@ViewBag.LowStockCount</div>
            <div class="text-muted small"><i class="bi bi-exclamation-triangle"></i> قطعات با موجودی کم</div>
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-5"><input name="q" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search part number or name..." /></div>
        <div class="col-md-3">
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly" checked="@((bool)ViewBag.LowStockOnly)" onchange="this.form.submit()" />
                <label class="form-check-label small" for="lowStockOnly">فقط موجودی کم</label>
            </div>
        </div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-search"></i> Search</button></div>
        <div class="col-md-2 text-end">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#createPartModal">
                <i class="bi bi-plus-lg"></i> New Part
            </button>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('SparePart')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="SparePart">
            <thead>
                <tr>
                    <th data-col-key="partNo" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Part No</th>
                    <th data-col-key="name" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">Name</th>
                    <th data-col-key="mfr" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Manufacturer</th>
                    <th data-col-key="location" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">Location</th>
                    <th data-col-key="qty" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px">موجودی</th>
                    <th data-col-key="actions" data-resizable="false" style="width:90px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td>@p.PartNumber</td>
                        <td>@p.PartName</td>
                        <td class="small">@p.Manufacturer</td>
                        <td class="small">@p.StorageLocation</td>
                        <td>
                            <span class="badge @(p.IsLowStock ? "bg-danger" : "bg-success")">@p.QuantityOnHand @p.Unit</span>
                            @if (p.IsLowStock) { <i class="bi bi-exclamation-triangle text-danger" title="زیر نقطه‌ی سفارش مجدد"></i> }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editPartModal_@p.SparePartId">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form asp-action="Deactivate" method="post" class="d-inline">
                                <input type="hidden" name="sparePartId" value="@p.SparePartId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-slash-circle"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No spare parts found.</p> }

    @{
        var qsParts = new List<string>();
        if ((bool)ViewBag.LowStockOnly) qsParts.Add("lowStockOnly=true");
        if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.SearchTerm)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "SparePart",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('SparePart');
        });
    </script>
}

<div class="modal fade" id="createPartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Spare Part</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Part Number</label><input name="partNumber" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Part Name</label><input name="partName" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Manufacturer</label><input name="manufacturer" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Model</label><input name="model" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Unit</label><input name="unit" class="form-control" placeholder="PCS, SET, KG..." /></div>
                        <div class="col-md-4"><label class="form-label">Storage Location</label><input name="storageLocation" class="form-control" placeholder="Warehouse-A-Rack3" /></div>
                        <div class="col-md-4"></div>
                        <div class="col-md-4"><label class="form-label">Quantity On Hand</label><input name="quantityOnHand" type="number" step="0.01" value="0" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label">Min Stock Level</label><input name="minStockLevel" type="number" step="0.01" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Reorder Point</label><input name="reorderPoint" type="number" step="0.01" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pems-solid">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var p in Model.Items)
{
    <div class="modal fade" id="editPartModal_@p.SparePartId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="sparePartId" value="@p.SparePartId" />
                    <div class="modal-header"><h6 class="modal-title">Edit Spare Part</h6></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Part Number</label><input name="partNumber" value="@p.PartNumber" class="form-control" required /></div>
                            <div class="col-md-6"><label class="form-label">Part Name</label><input name="partName" value="@p.PartName" class="form-control" required /></div>
                            <div class="col-md-6"><label class="form-label">Manufacturer</label><input name="manufacturer" value="@p.Manufacturer" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">Model</label><input name="model" value="@p.Model" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Unit</label><input name="unit" value="@p.Unit" class="form-control" /></div>
                            <div class="col-md-8"><label class="form-label">Storage Location</label><input name="storageLocation" value="@p.StorageLocation" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Quantity On Hand</label><input name="quantityOnHand" type="number" step="0.01" value="@p.QuantityOnHand" class="form-control" required /></div>
                            <div class="col-md-4"><label class="form-label">Min Stock Level</label><input name="minStockLevel" type="number" step="0.01" value="@p.MinStockLevel" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Reorder Point</label><input name="reorderPoint" type="number" step="0.01" value="@p.ReorderPoint" class="form-control" /></div>
                            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2">@p.Description</textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-pems-solid">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
