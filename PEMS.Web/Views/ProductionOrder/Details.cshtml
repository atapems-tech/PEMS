@model PEMS.Application.DTOs.ProductionOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="3">
        <div>
            <pems-flex align="center" gap="2" wrap="true">
                <pems-heading level="4" class="mb-0">@Model.OrderNumber</pems-heading>
                <pems-badge tone="neutral">@Model.Status</pems-badge>
            </pems-flex>
            <div class="text-muted">@Model.MaterialCode - @Model.MaterialDescription</div>
            <div class="text-muted small mt-1">
                Planned: @Model.PlannedQuantity.ToString("N3") @Model.UomCode &middot;
                Work Center: @Model.WorkCenterName (@Model.WorkCenterCode)
                @if (!string.IsNullOrEmpty(Model.EquipmentTagNumber)) { <text>&middot; Equipment: @Model.EquipmentTagNumber</text> }
                @if (!string.IsNullOrEmpty(Model.ResponsibleEmployeeName)) { <text>&middot; Responsible: @Model.ResponsibleEmployeeName</text> }
            </div>
            <div class="text-muted small">
                Planned: @(PemsDates.Date(Model.PlannedStartDate)) &rarr; @(PemsDates.Date(Model.PlannedFinishDate))
                @if (Model.ActualStartDate.HasValue) { <text> &middot; Actual start: @PemsDates.Date(Model.ActualStartDate)</text> }
                @if (Model.ActualFinishDate.HasValue) { <text> &middot; Actual finish: @PemsDates.Date(Model.ActualFinishDate)</text> }
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes)) { <div class="mt-1">@Model.Notes</div> }
            @if (Model.Status == "OnHold" && !string.IsNullOrEmpty(Model.HoldReason)) { <div class="text-warning small mt-1"><pems-icon name="bi-pause-circle" /> Held: @Model.HoldReason</div> }
            @if (Model.Status == "Cancelled" && !string.IsNullOrEmpty(Model.CancellationReason)) { <div class="text-danger small mt-1"><pems-icon name="bi-x-circle" /> Cancelled: @Model.CancellationReason</div> }
        </div>
        <pems-flex dir="column" gap="1" css="pems-s-66dbd5d0">
            @if (Model.Status == "Draft")
            {
                <pems-form action="/a/production-order-plan" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" /><pems-button tone="primary" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-calendar-check" /> Plan</pems-button></pems-form>
            }
            @if (Model.Status == "Planned")
            {
                <pems-form action="/a/production-order-release" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" /><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-send-check" /> Release</pems-button></pems-form>
            }
            @if (Model.Status == "Released" || Model.Status == "InProgress")
            {
                <pems-button tone="warning" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#holdOrderModal"><pems-icon name="bi-pause-circle" /> @Localizer["Hold"]</pems-button>
            }
            @if (Model.Status == "OnHold")
            {
                <pems-form action="/a/production-order-resume" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" /><pems-button tone="success" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-play-circle" /> Resume</pems-button></pems-form>
            }
            @if (Model.Status is "Draft" or "Planned" or "Released" or "OnHold")
            {
                <pems-button tone="danger" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelOrderModal"><pems-icon name="bi-x-circle" /> @Localizer["Cancel"]</pems-button>
            }
            @if (Model.Status == "InProgress")
            {
                <pems-form action="/a/production-order-complete" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" /><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-check2-circle" /> Complete</pems-button></pems-form>
            }
            @if (Model.Status == "Completed")
            {
                <pems-form action="/a/production-order-close" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" /><pems-button tone="neutral" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-lock" /> Close</pems-button></pems-form>
            }
            @if (Model.Status is "Released" or "InProgress")
            {
                <pems-button tone="primary" size="small" outline="true" css="w-100" as="a" asp-controller="ProductionRun" asp-action="Create" asp-route-productionOrderId="@Model.ProductionOrderId"><pems-icon name="bi-plus-lg" /> New Run</pems-button>
            }
        </pems-flex>
    </pems-flex>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-2">Production Runs</pems-heading>
    <div class="table-scroll-area pems-s-7bf38d03">
        <pems-data-table data="@(DataRows.Of(Model.Runs, c_ => c_.Add("Run #", r => (object?)(r.RunNumber)).Add(((Localizer["Status"])?.ToString() ?? ""), r => (object?)(DataCell.Badge("neutral", r.Status))).Add(((Localizer["Start"])?.ToString() ?? ""), r => (object?)((PemsDates.DateTime(r.StartDate))), css: "small").Add(((Localizer["End"])?.ToString() ?? ""), r => (object?)((PemsDates.DateTime(r.EndDate))), css: "small").Add("Output Qty", r => (object?)((r.TotalOutputQuantity.ToString("N3")))).Add("Loss Qty", r => (object?)((r.TotalLossQuantity.ToString("N3")))).Add("", r => (object?)(DataCell.ButtonLink(Url.Action("Details", "ProductionRun", new { id = r.ProductionRunId }), "primary", "small", true, null, "Open")), css: "text-end")))" />
    </div>
    @if (!Model.Runs.Any()) { <pems-text class="text-muted text-center py-3">No runs yet.</pems-text> }
</pems-content-card>

<pems-modal id="holdOrderModal" tabindex="-1">
        <pems-form action="/a/production-order-hold" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" />
            <pems-modal-header close="true">Hold Production Order</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="warning" type="submit">@Localizer["Hold"]</pems-button></pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="cancelOrderModal" tabindex="-1">
        <pems-form action="/a/production-order-cancel" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId" />
            <pems-modal-header close="true">Cancel Production Order</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="danger" type="submit">Cancel Order</pems-button></pems-modal-footer>
        </pems-form>
    </pems-modal>
