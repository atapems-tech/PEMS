@model PEMS.Application.DTOs.ProductionOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="3">
        <div>
            <pems-flex align="center" gap="2" wrap="true">
                <h4 class="mb-0">@Model.OrderNumber</h4>
                <pems-badge tone="neutral">@Model.Status</pems-badge>
            </pems-flex>
            <div class="text-muted">@Model.MaterialCode - @Model.MaterialDescription</div>
            <div class="text-muted small mt-1">
                Planned: @Model.PlannedQuantity.ToString("N3") @Model.UomCode &middot;
                Work Center: @Model.WorkCenterName (@Model.WorkCenterCode)
                @if (!string.IsNullOrEmpty(Model.EquipmentTagNumber)) { <text>&middot; Equipment: @Model.EquipmentTagNumber</text> }
                @if (!string.IsNullOrEmpty(Model.ResponsibleEmployeeName)) { <text>&middot; Responsible: @Model.ResponsibleEmployeeName</text> }
            </div>
            <div class="text-muted small">
                Planned: @(Model.PlannedStartDate?.ToString("yyyy-MM-dd")) &rarr; @(Model.PlannedFinishDate?.ToString("yyyy-MM-dd"))
                @if (Model.ActualStartDate.HasValue) { <text> &middot; Actual start: @Model.ActualStartDate?.ToString("yyyy-MM-dd")</text> }
                @if (Model.ActualFinishDate.HasValue) { <text> &middot; Actual finish: @Model.ActualFinishDate?.ToString("yyyy-MM-dd")</text> }
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes)) { <div class="mt-1">@Model.Notes</div> }
            @if (Model.Status == "OnHold" && !string.IsNullOrEmpty(Model.HoldReason)) { <div class="text-warning small mt-1"><pems-icon name="bi-pause-circle" /> Held: @Model.HoldReason</div> }
            @if (Model.Status == "Cancelled" && !string.IsNullOrEmpty(Model.CancellationReason)) { <div class="text-danger small mt-1"><pems-icon name="bi-x-circle" /> Cancelled: @Model.CancellationReason</div> }
        </div>
        <pems-flex dir="column" gap="1" css="pems-s-66dbd5d0">
            @if (Model.Status == "Draft")
            {
                <form asp-action="Plan" asp-route-id="@Model.ProductionOrderId" method="post"><pems-button tone="primary" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-calendar-check" /> Plan</pems-button></form>
            }
            @if (Model.Status == "Planned")
            {
                <form asp-action="Release" asp-route-id="@Model.ProductionOrderId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-send-check" /> Release</pems-button></form>
            }
            @if (Model.Status == "Released" || Model.Status == "InProgress")
            {
                <pems-button tone="warning" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#holdOrderModal"><pems-icon name="bi-pause-circle" /> @Localizer["Hold"]</pems-button>
            }
            @if (Model.Status == "OnHold")
            {
                <form asp-action="Resume" asp-route-id="@Model.ProductionOrderId" method="post"><pems-button tone="success" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-play-circle" /> Resume</pems-button></form>
            }
            @if (Model.Status is "Draft" or "Planned" or "Released" or "OnHold")
            {
                <pems-button tone="danger" size="small" outline="true" css="w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelOrderModal"><pems-icon name="bi-x-circle" /> @Localizer["Cancel"]</pems-button>
            }
            @if (Model.Status == "InProgress")
            {
                <form asp-action="Complete" asp-route-id="@Model.ProductionOrderId" method="post"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-check2-circle" /> Complete</pems-button></form>
            }
            @if (Model.Status == "Completed")
            {
                <form asp-action="Close" asp-route-id="@Model.ProductionOrderId" method="post"><pems-button tone="neutral" size="small" outline="true" css="w-100" type="submit"><pems-icon name="bi-lock" /> Close</pems-button></form>
            }
            @if (Model.Status is "Released" or "InProgress")
            {
                <pems-button tone="primary" size="small" outline="true" css="w-100" as="a" asp-controller="ProductionRun" asp-action="Create" asp-route-productionOrderId="@Model.ProductionOrderId"><pems-icon name="bi-plus-lg" /> New Run</pems-button>
            }
        </pems-flex>
    </pems-flex>
</pems-content-card>

<pems-content-card>
    <h6 class="mb-2">Production Runs</h6>
    <div class="table-scroll-area pems-s-7bf38d03">
        <pems-table kind="enterprise">
            <thead><tr><th>Run #</th><th>@Localizer["Status"]</th><th>@Localizer["Start"]</th><th>@Localizer["End"]</th><th>Output Qty</th><th>Loss Qty</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr>
                        <td>@r.RunNumber</td>
                        <td><pems-badge tone="neutral">@r.Status</pems-badge></td>
                        <td class="small">@(r.StartDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td class="small">@(r.EndDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td>@r.TotalOutputQuantity.ToString("N3")</td>
                        <td>@r.TotalLossQuantity.ToString("N3")</td>
                        <td class="text-end"><pems-button tone="primary" size="small" outline="true" as="a" asp-controller="ProductionRun" asp-action="Details" asp-route-id="@r.ProductionRunId">Open</pems-button></td>
                    </tr>
                }
            </tbody>
        </pems-table>
    </div>
    @if (!Model.Runs.Any()) { <p class="text-muted text-center py-3">No runs yet.</p> }
</pems-content-card>

<pems-modal id="holdOrderModal" tabindex="-1">
        <form asp-action="Hold" asp-route-id="@Model.ProductionOrderId" method="post">
            <pems-modal-header close="true">Hold Production Order</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="warning" type="submit">@Localizer["Hold"]</pems-button></pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="cancelOrderModal" tabindex="-1">
        <form asp-action="Cancel" asp-route-id="@Model.ProductionOrderId" method="post">
            <pems-modal-header close="true">Cancel Production Order</pems-modal-header>
            <pems-modal-body><pems-label>@Localizer["Reason"]</pems-label><pems-textarea name="reason" required></pems-textarea></pems-modal-body>
            <pems-modal-footer><pems-button tone="danger" type="submit">Cancel Order</pems-button></pems-modal-footer>
        </form>
    </pems-modal>
