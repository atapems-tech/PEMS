@model PEMS.Application.DTOs.ProductionOrderDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h4 class="mb-0">@Model.OrderNumber</h4>
                <pems-badge tone="neutral">@Model.Status</pems-badge>
            </div>
            <div class="text-muted">@Model.MaterialCode - @Model.MaterialDescription</div>
            <div class="text-muted small mt-1">
                Planned: @Model.PlannedQuantity.ToString("N3") @Model.UomCode &middot;
                Work Center: @Model.WorkCenterName (@Model.WorkCenterCode)
                @if (!string.IsNullOrEmpty(Model.EquipmentTagNumber)) { <text>&middot; Equipment: @Model.EquipmentTagNumber</text> }
                @if (!string.IsNullOrEmpty(Model.ResponsibleEmployeeName)) { <text>&middot; Responsible: @Model.ResponsibleEmployeeName</text> }
            </div>
            <div class="text-muted small">
                Planned: @(Model.PlannedStartDate?.ToString("yyyy-MM-dd")) &rarr; @(Model.PlannedFinishDate?.ToString("yyyy-MM-dd"))
                @if (Model.ActualStartDate.HasValue) { <text> &middot; Actual start: @Model.ActualStartDate?.ToString("yyyy-MM-dd")</text> }
                @if (Model.ActualFinishDate.HasValue) { <text> &middot; Actual finish: @Model.ActualFinishDate?.ToString("yyyy-MM-dd")</text> }
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes)) { <div class="mt-1">@Model.Notes</div> }
            @if (Model.Status == "OnHold" && !string.IsNullOrEmpty(Model.HoldReason)) { <div class="text-warning small mt-1"><i class="bi bi-pause-circle"></i> Held: @Model.HoldReason</div> }
            @if (Model.Status == "Cancelled" && !string.IsNullOrEmpty(Model.CancellationReason)) { <div class="text-danger small mt-1"><i class="bi bi-x-circle"></i> Cancelled: @Model.CancellationReason</div> }
        </div>
        <div class="d-flex flex-column gap-1" style="min-width:180px">
            @if (Model.Status == "Draft")
            {
                <form asp-action="Plan" asp-route-id="@Model.ProductionOrderId" method="post"><button class="btn btn-sm btn-outline-primary w-100" type="submit"><i class="bi bi-calendar-check"></i> Plan</button></form>
            }
            @if (Model.Status == "Planned")
            {
                <form asp-action="Release" asp-route-id="@Model.ProductionOrderId" method="post"><button class="btn btn-sm btn-pems-solid w-100" type="submit"><i class="bi bi-send-check"></i> Release</button></form>
            }
            @if (Model.Status == "Released" || Model.Status == "InProgress")
            {
                <button class="btn btn-sm btn-outline-warning w-100" type="button" data-bs-toggle="modal" data-bs-target="#holdOrderModal"><i class="bi bi-pause-circle"></i> @Localizer["Hold"]</button>
            }
            @if (Model.Status == "OnHold")
            {
                <form asp-action="Resume" asp-route-id="@Model.ProductionOrderId" method="post"><button class="btn btn-sm btn-outline-success w-100" type="submit"><i class="bi bi-play-circle"></i> Resume</button></form>
            }
            @if (Model.Status is "Draft" or "Planned" or "Released" or "OnHold")
            {
                <button class="btn btn-sm btn-outline-danger w-100" type="button" data-bs-toggle="modal" data-bs-target="#cancelOrderModal"><i class="bi bi-x-circle"></i> @Localizer["Cancel"]</button>
            }
            @if (Model.Status == "InProgress")
            {
                <form asp-action="Complete" asp-route-id="@Model.ProductionOrderId" method="post"><button class="btn btn-sm btn-pems-solid w-100" type="submit"><i class="bi bi-check2-circle"></i> Complete</button></form>
            }
            @if (Model.Status == "Completed")
            {
                <form asp-action="Close" asp-route-id="@Model.ProductionOrderId" method="post"><button class="btn btn-sm btn-outline-secondary w-100" type="submit"><i class="bi bi-lock"></i> Close</button></form>
            }
            @if (Model.Status is "Released" or "InProgress")
            {
                <a asp-controller="ProductionRun" asp-action="Create" asp-route-productionOrderId="@Model.ProductionOrderId" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus-lg"></i> New Run</a>
            }
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-2">Production Runs</h6>
    <div class="table-scroll-area" style="max-height:50vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>Run #</th><th>@Localizer["Status"]</th><th>@Localizer["Start"]</th><th>@Localizer["End"]</th><th>Output Qty</th><th>Loss Qty</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Runs)
                {
                    <tr>
                        <td>@r.RunNumber</td>
                        <td><pems-badge tone="neutral">@r.Status</pems-badge></td>
                        <td class="small">@(r.StartDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td class="small">@(r.EndDate?.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td>@r.TotalOutputQuantity.ToString("N3")</td>
                        <td>@r.TotalLossQuantity.ToString("N3")</td>
                        <td class="text-end"><a asp-controller="ProductionRun" asp-action="Details" asp-route-id="@r.ProductionRunId" class="btn btn-sm btn-outline-primary">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Runs.Any()) { <p class="text-muted text-center py-3">No runs yet.</p> }
</div>

<div class="modal fade" id="holdOrderModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Hold" asp-route-id="@Model.ProductionOrderId" method="post">
            <div class="modal-header"><h6 class="modal-title">Hold Production Order</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><button type="submit" class="btn btn-warning">@Localizer["Hold"]</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="cancelOrderModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Cancel" asp-route-id="@Model.ProductionOrderId" method="post">
            <div class="modal-header"><h6 class="modal-title">Cancel Production Order</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label">@Localizer["Reason"]</label><textarea name="reason" class="form-control" required></textarea></div>
            <div class="modal-footer"><button type="submit" class="btn btn-danger">Cancel Order</button></div>
        </form>
    </div></div>
</div>
