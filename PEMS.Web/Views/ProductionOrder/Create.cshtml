@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="content-card" style="max-width:720px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-8">
                <pems-label>Product / Material</pems-label>
                <pems-select name="materialItemId" required onchange="fillUom(this)">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var m in ViewBag.MaterialItems)
                    {
                        <option value="@m.MaterialItemId" data-uom="@m.UomId">@m.MaterialCode - @m.Description</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-4">
                <pems-label>@Localizer["UOM"]</pems-label>
                <pems-select name="uomId" id="uomSelect">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var u in ViewBag.Uoms)
                    {
                        <option value="@u.MaterialUOMId">@u.Code</option>
                    }
                </pems-select>
            </div>

            <div class="col-md-6">
                <pems-label>Planned Quantity</pems-label>
                <pems-input type="number" step="0.001" min="0.001" name="plannedQuantity" required />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Work Center"]</pems-label>
                <pems-select name="productionWorkCenterId" required>
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var w in ViewBag.WorkCenters)
                    {
                        <option value="@w.ProductionWorkCenterId">@w.Code - @w.Name</option>
                    }
                </pems-select>
            </div>

            <div class="col-md-6">
                <pems-label>@Localizer["Planned Start"]</pems-label>
                <input type="date" name="plannedStartDate" class="form-control" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Planned Finish"]</pems-label>
                <input type="date" name="plannedFinishDate" class="form-control" />
            </div>

            <div class="col-md-6">
                <pems-label>Primary Equipment (optional)</pems-label>
                <pems-select name="equipmentId">
                    <option value="">-- none / from work center --</option>
                    @foreach (var e in ViewBag.Equipments)
                    {
                        <option value="@e.EquipmentId">@e.TagNumber - @e.Name</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>Responsible Employee (optional)</pems-label>
                <pems-select name="responsibleEmployeeId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var emp in ViewBag.Employees)
                    {
                        <option value="@emp.EmployeeId">@emp.Name</option>
                    }
                </pems-select>
            </div>

            <div class="col-12">
                <pems-label>@Localizer["Notes"]</pems-label>
                <pems-textarea name="notes" rows="2"></pems-textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <pems-button tone="primary" type="submit"><i class="bi bi-check-lg"></i> Create (Draft)</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function fillUom(select) {
            var opt = select.options[select.selectedIndex];
            var uomId = opt.getAttribute('data-uom');
            if (uomId) document.getElementById('uomSelect').value = uomId;
        }
    </script>
}
