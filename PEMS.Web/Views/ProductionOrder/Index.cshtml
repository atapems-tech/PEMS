@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProductionOrderListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width:160px">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in new[] { "Draft", "Planned", "Released", "InProgress", "OnHold", "Completed", "Closed", "Cancelled" })
                {
                    <option value="@s" selected="@(ViewBag.StatusFilter == s)">@s</option>
                }
            </select>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Order # or material..." style="width:220px" />
            <pems-button tone="neutral" size="small" outline="true" type="submit"><i class="bi bi-search"></i></pems-button>
        </form>
        <pems-button tone="primary" size="small" as="a" asp-action="Create"><i class="bi bi-plus-lg"></i> New Production Order</pems-button>
    </div>

    <div class="table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr>
                    <th>Order #</th><th>@Localizer["Material"]</th><th>Planned Qty</th><th>@Localizer["Status"]</th><th>@Localizer["Work Center"]</th>
                    <th>@Localizer["Planned Start"]</th><th>@Localizer["Planned Finish"]</th><th>Runs</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@o.ProductionOrderId">@o.OrderNumber</a></td>
                        <td>@o.MaterialCode <div class="text-muted small">@o.MaterialDescription</div></td>
                        <td>@o.PlannedQuantity.ToString("N3") @o.UomCode</td>
                        <td><pems-badge tone="neutral">@o.Status</pems-badge></td>
                        <td>@o.WorkCenterCode</td>
                        <td class="small">@(o.PlannedStartDate?.ToString("yyyy-MM-dd"))</td>
                        <td class="small">@(o.PlannedFinishDate?.ToString("yyyy-MM-dd"))</td>
                        <td>@o.RunCount</td>
                        <td class="text-end"><pems-button tone="primary" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@o.ProductionOrderId">Open</pems-button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No production orders yet.</p> }

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "ProductionOrder",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = $"status={ViewBag.StatusFilter}&search={ViewBag.Search}"
    })
</div>
