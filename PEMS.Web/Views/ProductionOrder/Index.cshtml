@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProductionOrderListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = ViewBag.StatusFilter as string;
    var search = ViewBag.Search as string;
    var statuses = new[] { "Draft", "Planned", "Released", "InProgress", "OnHold", "Completed", "Closed", "Cancelled" };
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component (status filter, search, chips, paging in the footer). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="Production Orders" total="@Model.TotalCount">
            <pems-list-search id="poSearch" action="@Url.Action("Index")" input-id="poQ" name="search" value="@search" placeholder="Order # or material...">
                <input type="hidden" name="status" value="@status" />
            </pems-list-search>
            <pems-list-tools search-for="poSearch">
                <pems-list-filters form-id="poFilter" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index", new { search })">
                    <input type="hidden" name="search" value="@search" />
                    <pems-list-filter-select id="poStatus" name="status" label="@Localizer["Status"]" value="@status"
                                             all-text="@Localizer["All statuses"]" items="@statuses.Select(s => new SelectListItem(s, s))" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="ProductionOrder" />
                <pems-list-new href="@Url.Action("Create")" text="New Production Order" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(status)) { <pems-list-chip label="@Localizer["Status"]" value="@status" remove-href="@Url.Action("Index", new { search })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="ProductionOrder" empty="@(!Model.Items.Any())" empty-text="No production orders yet."
                             filtered="@(filterCount > 0 || !string.IsNullOrEmpty(search))" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th>Order #</th><th>@Localizer["Material"]</th><th>Planned Qty</th><th>@Localizer["Status"]</th><th>@Localizer["Work Center"]</th>
                        <th>@Localizer["Planned Start"]</th><th>@Localizer["Planned Finish"]</th><th>Runs</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@o.ProductionOrderId" class="lp-subject">@o.OrderNumber</a></td>
                            <td>@o.MaterialCode <div class="text-muted small">@o.MaterialDescription</div></td>
                            <td>@o.PlannedQuantity.ToString("N3") @o.UomCode</td>
                            <td><pems-badge tone="neutral">@o.Status</pems-badge></td>
                            <td>@o.WorkCenterCode</td>
                            <td class="small">@(o.PlannedStartDate?.ToString("yyyy-MM-dd"))</td>
                            <td class="small">@(o.PlannedFinishDate?.ToString("yyyy-MM-dd"))</td>
                            <td>@o.RunCount</td>
                            <td class="text-end"><pems-button tone="primary" size="small" outline="true" as="a" asp-action="Details" asp-route-id="@o.ProductionOrderId">Open</pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "ProductionOrder",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = $"status={status}&search={search}"
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
