@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var ncrPatterns = (List<PEMS.Application.DTOs.RecurringNcrPatternDto>)ViewBag.NcrPatterns;
    var delay = (PEMS.Application.DTOs.DelayRootCauseAnalysisDto)ViewBag.DelayAnalysis;
}

<pems-flex justify="end" align="center" css="mb-2">
</pems-flex>
<p class="text-muted small">
    این صفحه از روی داده‌ی واقعی سیستم (نه فرضی) ساخته می‌شه - هر عدد این‌جا مستقیم از
    دیتابیس محاسبه شده. فقط خلاصه‌ی روایی پایین با کمک هوش مصنوعی محلی (Ollama) نوشته می‌شه،
    بدون اینکه هیچ عددی از خودش بسازه.
</p>

<pems-content-card css="mb-3">
    <h6 class="mb-3"><pems-icon name="bi-arrow-repeat" /> @Localizer["الگوهای تکراری NCR - پیشنهاد بررسی MOC"]</h6>
    <p class="text-muted small">تجهیزاتی که در ۱۸۰ روز اخیر حداقل ۳ بار NCR گرفتن.</p>

    @if (ncrPatterns.Any())
    {
        <pems-table kind="enterprise" css="mb-0">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Equipment"]</pems-table-header><pems-table-header>@Localizer["تعداد NCR"]</pems-table-header><pems-table-header>@Localizer["دیسیپلین غالب"]</pems-table-header><pems-table-header>@Localizer["وضعیت MOC"]</pems-table-header><pems-table-header>@Localizer["پیشنهاد"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var p in ncrPatterns)
                {
                    <pems-table-row>
                        <pems-table-cell><a asp-controller="Equipment" asp-action="Details" asp-route-id="@p.EquipmentId">@p.EquipmentTagNumber</a></pems-table-cell>
                        <pems-table-cell><pems-badge tone="danger">@p.NcrCount</pems-badge></pems-table-cell>
                        <pems-table-cell class="small">@p.DominantQCDiscipline</pems-table-cell>
                        <pems-table-cell>
                            @if (p.HasOpenMOC)
                            {
                                <pems-badge tone="info">@Localizer["MOC باز دارد"]</pems-badge>
                            }
                            else
                            {
                                <pems-badge tone="warning">@Localizer["بدون MOC"]</pems-badge>
                            }
                        </pems-table-cell>
                        <pems-table-cell class="small">@p.Suggestion</pems-table-cell>
                        <pems-table-cell>
                            @if (!p.HasOpenMOC)
                            {
                                <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="MOC" asp-action="Raise" asp-route-relatedEquipmentId="@p.EquipmentId">
                                    <pems-icon name="bi-plus-lg" /> ثبت MOC
                                </pems-button>
                            }
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    }
    else
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["الگوی تکراری قابل‌توجهی پیدا نشد."]</p>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3"><pems-icon name="bi-graph-down-arrow" /> @Localizer["تحلیل ریشه‌ای تاخیر مدارک"]</h6>

    <pems-row gap="3" css="mb-3">
        <pems-col md="6">
            <pems-kpi-tile label="@Localizer["کل مدارک با تاخیر"]">@delay.TotalDelayedDocuments</pems-kpi-tile>
        </pems-col>
        <pems-col md="6">
            <pems-kpi-tile tone="danger" label="@Localizer["میانگین روز تاخیر"]">@delay.AverageDelayDays</pems-kpi-tile>
        </pems-col>
    </pems-row>

    @if (!string.IsNullOrWhiteSpace(delay.NarrativeSummary))
    {
        <pems-alert tone="info" css="small">
            <pems-icon name="bi-stars" /> <strong>خلاصه‌ی هوش مصنوعی:</strong> @delay.NarrativeSummary
        </pems-alert>
    }
    else if (delay.TotalDelayedDocuments > 0)
    {
        <p class="text-muted small">خلاصه‌ی روایی در دسترس نیست (Ollama در دسترس نبود) - جدول‌های زیر مستقیم از دیتابیسه.</p>
    }

    @if (delay.TotalDelayedDocuments > 0)
    {
        <pems-row gap="3">
            <pems-col md="4">
                <h6 class="small fw-bold">@Localizer["به تفکیک دیسیپلین"]</h6>
                <pems-data-table data="@(DataRows.Of(delay.ByDiscipline, c_ => c_.Add(((Localizer["دیسیپلین"])?.ToString() ?? ""), d => (object?)(d.GroupName), css: "small").Add(((Localizer["تعداد"])?.ToString() ?? ""), d => (object?)(d.Count)).Add(((Localizer["میانگین"])?.ToString() ?? ""), d => (object?)(d.AvgDelayDays))))" enterprise="false" dense="true" />
            </pems-col>
            <pems-col md="4">
                <h6 class="small fw-bold">@Localizer["به تفکیک وضعیت"]</h6>
                <pems-data-table data="@(DataRows.Of(delay.ByStage, c_ => c_.Add(((Localizer["وضعیت"])?.ToString() ?? ""), d => (object?)(d.GroupName), css: "small").Add(((Localizer["تعداد"])?.ToString() ?? ""), d => (object?)(d.Count)).Add(((Localizer["میانگین"])?.ToString() ?? ""), d => (object?)(d.AvgDelayDays))))" enterprise="false" dense="true" />
            </pems-col>
            <pems-col md="4">
                <h6 class="small fw-bold">به تفکیک وندور (VDR)</h6>
                @if (delay.ByVendor.Any())
                {
                    <pems-data-table data="@(DataRows.Of(delay.ByVendor, c_ => c_.Add(((Localizer["وندور"])?.ToString() ?? ""), d => (object?)(d.GroupName), css: "small").Add(((Localizer["تعداد"])?.ToString() ?? ""), d => (object?)(d.Count)).Add(((Localizer["میانگین"])?.ToString() ?? ""), d => (object?)(d.AvgDelayDays))))" enterprise="false" dense="true" />
                }
                else
                {
                    <p class="text-muted small">@Localizer["موردی نیست."]</p>
                }
            </pems-col>
        </pems-row>
    }
</pems-content-card>
