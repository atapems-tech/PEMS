@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var ncrPatterns = (List<PEMS.Application.DTOs.RecurringNcrPatternDto>)ViewBag.NcrPatterns;
    var delay = (PEMS.Application.DTOs.DelayRootCauseAnalysisDto)ViewBag.DelayAnalysis;
}

<div class="d-flex justify-content-end align-items-center mb-2">
</div>
<p class="text-muted small">
    این صفحه از روی داده‌ی واقعی سیستم (نه فرضی) ساخته می‌شه - هر عدد این‌جا مستقیم از
    دیتابیس محاسبه شده. فقط خلاصه‌ی روایی پایین با کمک هوش مصنوعی محلی (Ollama) نوشته می‌شه،
    بدون اینکه هیچ عددی از خودش بسازه.
</p>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-arrow-repeat"></i> @Localizer["الگوهای تکراری NCR - پیشنهاد بررسی MOC"]</h6>
    <p class="text-muted small">تجهیزاتی که در ۱۸۰ روز اخیر حداقل ۳ بار NCR گرفتن.</p>

    @if (ncrPatterns.Any())
    {
        <table class="table table-enterprise mb-0">
            <thead><tr><th>@Localizer["Equipment"]</th><th>@Localizer["تعداد NCR"]</th><th>@Localizer["دیسیپلین غالب"]</th><th>@Localizer["وضعیت MOC"]</th><th>@Localizer["پیشنهاد"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in ncrPatterns)
                {
                    <tr>
                        <td><a asp-controller="Equipment" asp-action="Details" asp-route-id="@p.EquipmentId">@p.EquipmentTagNumber</a></td>
                        <td><pems-badge tone="danger">@p.NcrCount</pems-badge></td>
                        <td class="small">@p.DominantQCDiscipline</td>
                        <td>
                            @if (p.HasOpenMOC)
                            {
                                <pems-badge tone="info">@Localizer["MOC باز دارد"]</pems-badge>
                            }
                            else
                            {
                                <pems-badge tone="warning">@Localizer["بدون MOC"]</pems-badge>
                            }
                        </td>
                        <td class="small">@p.Suggestion</td>
                        <td>
                            @if (!p.HasOpenMOC)
                            {
                                <pems-button tone="primary" size="small" outline="true" as="a" asp-controller="MOC" asp-action="Raise" asp-route-relatedEquipmentId="@p.EquipmentId">
                                    <i class="bi bi-plus-lg"></i> ثبت MOC
                                </pems-button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted text-center py-3 mb-0">@Localizer["الگوی تکراری قابل‌توجهی پیدا نشد."]</p>
    }
</div>

<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-graph-down-arrow"></i> @Localizer["تحلیل ریشه‌ای تاخیر مدارک"]</h6>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="text-center border rounded p-2">
                <div class="fs-3 fw-bold">@delay.TotalDelayedDocuments</div>
                <div class="text-muted small">@Localizer["کل مدارک با تاخیر"]</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="text-center border rounded p-2">
                <div class="fs-3 fw-bold text-danger">@delay.AverageDelayDays</div>
                <div class="text-muted small">@Localizer["میانگین روز تاخیر"]</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(delay.NarrativeSummary))
    {
        <pems-alert tone="info" css="small">
            <i class="bi bi-stars"></i> <strong>خلاصه‌ی هوش مصنوعی:</strong> @delay.NarrativeSummary
        </pems-alert>
    }
    else if (delay.TotalDelayedDocuments > 0)
    {
        <p class="text-muted small">خلاصه‌ی روایی در دسترس نیست (Ollama در دسترس نبود) - جدول‌های زیر مستقیم از دیتابیسه.</p>
    }

    @if (delay.TotalDelayedDocuments > 0)
    {
        <div class="row g-3">
            <div class="col-md-4">
                <h6 class="small fw-bold">@Localizer["به تفکیک دیسیپلین"]</h6>
                <table class="table table-sm">
                    <thead><tr><th>@Localizer["دیسیپلین"]</th><th>@Localizer["تعداد"]</th><th>@Localizer["میانگین"]</th></tr></thead>
                    <tbody>
                        @foreach (var d in delay.ByDiscipline)
                        {
                            <tr><td class="small">@d.GroupName</td><td>@d.Count</td><td>@d.AvgDelayDays</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-md-4">
                <h6 class="small fw-bold">@Localizer["به تفکیک وضعیت"]</h6>
                <table class="table table-sm">
                    <thead><tr><th>@Localizer["وضعیت"]</th><th>@Localizer["تعداد"]</th><th>@Localizer["میانگین"]</th></tr></thead>
                    <tbody>
                        @foreach (var d in delay.ByStage)
                        {
                            <tr><td class="small">@d.GroupName</td><td>@d.Count</td><td>@d.AvgDelayDays</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-md-4">
                <h6 class="small fw-bold">به تفکیک وندور (VDR)</h6>
                @if (delay.ByVendor.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>@Localizer["وندور"]</th><th>@Localizer["تعداد"]</th><th>@Localizer["میانگین"]</th></tr></thead>
                        <tbody>
                            @foreach (var d in delay.ByVendor)
                            {
                                <tr><td class="small">@d.GroupName</td><td>@d.Count</td><td>@d.AvgDelayDays</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted small">@Localizer["موردی نیست."]</p>
                }
            </div>
        </div>
    }
</div>
