@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaintenanceBacklogItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = (string?)ViewBag.Status;
    var priority = (string?)ViewBag.Priority;
    var overdueOnly = (bool)ViewBag.OverdueOnly;
    var overdueValue = overdueOnly ? "true" : null;
    var filterCount = (string.IsNullOrEmpty(status) ? 0 : 1) + (string.IsNullOrEmpty(priority) ? 0 : 1) + (overdueOnly ? 1 : 0);
    var statuses = new[] { ("Open", "Open"), ("Assigned", "Assigned"), ("InProgress", "In Progress"), ("OnHold", "On Hold") };
    var priorities = new[] { "Critical", "High", "Medium", "Low" };

    string PriorityBadge(string p) => p switch
    {
        "Critical" => "danger",
        "High" => "warning",
        "Medium" => "info",
        _ => "neutral"
    };
}

@section Styles { <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" /> }

@* SCRUM-337: built from the PEMS.UI list-page component; the three filters moved into the filters dropdown, the note is the heading tooltip. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Maintenance Backlog"]" total="@Model.TotalCount"
                           heading-title="طبق «PEMS Phase 8» بند ۲۲: WorkOrder های واقعی در وضعیت غیرنهایی (Open/Assigned/InProgress/OnHold)، صفحه‌بندی‌شده. AgeDays و Overdue فقط از تاریخ‌های واقعی مشتق می‌شوند.">
            <pems-list-tools>
                <pems-list-filters form-id="blFilter" action="@Url.Action("Backlog")" count="@filterCount" reset-href="@Url.Action("Backlog")">
                    <pems-list-filter-select id="blStatus" name="status" label="@Localizer["Status"]" value="@status"
                                             all-text="Open Backlog (all non-final)" items="@statuses.Select(s => new SelectListItem(s.Item2, s.Item1))" />
                    <pems-list-filter-select id="blPriority" name="priority" label="@Localizer["Priority"]" value="@priority"
                                             all-text="@Localizer["All"]" items="@priorities.Select(p => new SelectListItem(p, p))" />
                    <pems-list-filter-select id="blOverdue" name="overdueOnly" label="@Localizer["Overdue"]" value="@overdueValue"
                                             all-text="@Localizer["All"]" items="@(new[] { new SelectListItem(Localizer["Overdue only"].Value, "true") })" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="CmmsOperationsBacklog" />
                <pems-list-menu id="blMoreBtn" icon="bi-three-dots" label="@Localizer["Lp_More"]">
                    <li><a class="dropdown-item" asp-action="Dashboard"><pems-icon name="bi-arrow-left-short" aria-hidden="true" /> @Localizer["← Dashboard"]</a></li>
                </pems-list-menu>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Backlog")">
            @if (!string.IsNullOrEmpty(status)) { <pems-list-chip label="@Localizer["Status"]" value="@status" remove-href="@Url.Action("Backlog", new { priority, overdueOnly = overdueValue })" /> }
            @if (!string.IsNullOrEmpty(priority)) { <pems-list-chip label="@Localizer["Priority"]" value="@priority" remove-href="@Url.Action("Backlog", new { status, overdueOnly = overdueValue })" /> }
            @if (overdueOnly) { <pems-list-chip label="@Localizer["Overdue"]" value="@Localizer["Overdue only"]" remove-href="@Url.Action("Backlog", new { status, priority })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="CmmsOperationsBacklog" empty="@(!Model.Items.Any())" empty-text="@Localizer["هیچ WorkOrder ای در Backlog با این فیلتر نیست."]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Backlog")">
                <thead>
                    <tr>
                        <th>@Localizer["WO Number"]</th>
                        <th>@Localizer["Equipment"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Priority"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Due Date"]</th>
                        <th class="text-end">@Localizer["Age (days)"]</th>
                        <th>@Localizer["Assigned"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wo in Model.Items)
                    {
                        <tr class="@(wo.IsOverdue ? "lp-row table-danger" : "lp-row")">
                            <td class="lp-no">@wo.WorkOrderNumber</td>
                            <td>@wo.EquipmentTagNumber <span class="text-muted small">@wo.EquipmentDescription</span></td>
                            <td>@wo.WorkOrderType</td>
                            <td><pems-badge tone="@PriorityBadge(wo.Priority)">@wo.Priority</pems-badge></td>
                            <td>@wo.Status</td>
                            <td>
                                @if (wo.DueDate.HasValue)
                                {
                                    @wo.DueDate.Value.ToString("yyyy-MM-dd")
                                    @if (wo.IsOverdue) { <pems-badge tone="danger" css="ms-1">@Localizer["Overdue"]</pems-badge> }
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td class="text-end">@wo.AgeDays</td>
                            <td class="small">@(wo.AssignedEmployeeName ?? wo.AssignedTeamName ?? "—")</td>
                            <td><pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="WorkOrder" asp-action="Details" asp-route-id="@wo.WorkOrderId">Open</pems-button></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
            <pems-list-footer>
                @{
                    var qsParts = new List<string>();
                    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
                    if (!string.IsNullOrEmpty(priority)) qsParts.Add($"priority={Uri.EscapeDataString(priority)}");
                    if (overdueOnly) qsParts.Add("overdueOnly=true");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "CmmsOperationsBacklog",
                    BaseUrl = Url.Action("Backlog") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts { <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script> }
