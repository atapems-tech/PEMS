@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaintenanceBacklogItemDto>
@{
    var status = (string?)ViewBag.Status;
    var priority = (string?)ViewBag.Priority;
    var overdueOnly = (bool)ViewBag.OverdueOnly;

    string PriorityBadge(string p) => p switch
    {
        "Critical" => "text-bg-danger",
        "High" => "text-bg-warning",
        "Medium" => "text-bg-info",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-list-task"></i> Maintenance Backlog</h5>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 8» بند ۲۲: WorkOrder های واقعی در وضعیت غیرنهایی (Open/Assigned/InProgress/
    OnHold)، صفحه‌بندی‌شده. AgeDays و Overdue فقط از تاریخ‌های واقعی مشتق می‌شوند.
</p>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small mb-0">Status</label>
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Open Backlog (all non-final)</option>
            <option value="Open" selected="@(status == "Open")">Open</option>
            <option value="Assigned" selected="@(status == "Assigned")">Assigned</option>
            <option value="InProgress" selected="@(status == "InProgress")">In Progress</option>
            <option value="OnHold" selected="@(status == "OnHold")">On Hold</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Priority</label>
        <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Critical" selected="@(priority == "Critical")">Critical</option>
            <option value="High" selected="@(priority == "High")">High</option>
            <option value="Medium" selected="@(priority == "Medium")">Medium</option>
            <option value="Low" selected="@(priority == "Low")">Low</option>
        </select>
    </div>
    <div class="col-auto form-check mb-1">
        <input type="checkbox" class="form-check-input" name="overdueOnly" value="true" id="overdueOnly" @(overdueOnly ? "checked" : "") onchange="this.form.submit()" />
        <label class="form-check-label small" for="overdueOnly">Overdue only</label>
    </div>
</form>

<div class="content-card">
    <div class="table-scroll-area" style="overflow-x:auto;">
    <table class="table table-enterprise table-sm mb-0">
        <thead>
            <tr>
                <th>WO Number</th>
                <th>Equipment</th>
                <th>Type</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Due Date</th>
                <th class="text-end">Age (days)</th>
                <th>Assigned</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wo in Model.Items)
            {
                <tr class="@(wo.IsOverdue ? "table-danger" : "")">
                    <td class="fw-bold">@wo.WorkOrderNumber</td>
                    <td>@wo.EquipmentTagNumber <span class="text-muted small">@wo.EquipmentDescription</span></td>
                    <td>@wo.WorkOrderType</td>
                    <td><span class="badge @PriorityBadge(wo.Priority)">@wo.Priority</span></td>
                    <td>@wo.Status</td>
                    <td>
                        @if (wo.DueDate.HasValue)
                        {
                            @wo.DueDate.Value.ToString("yyyy-MM-dd")
                            @if (wo.IsOverdue) { <span class="badge text-bg-danger ms-1">Overdue</span> }
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                    <td class="text-end">@wo.AgeDays</td>
                    <td class="small">@(wo.AssignedEmployeeName ?? wo.AssignedTeamName ?? "—")</td>
                    <td><a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@wo.WorkOrderId" class="btn btn-sm btn-outline-secondary">Open</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">هیچ WorkOrder ای در Backlog با این فیلتر نیست.</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
        if (!string.IsNullOrEmpty(priority)) qsParts.Add($"priority={Uri.EscapeDataString(priority)}");
        if (overdueOnly) qsParts.Add("overdueOnly=true");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "CmmsOperationsBacklog",
        BaseUrl = Url.Action("Backlog") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>
