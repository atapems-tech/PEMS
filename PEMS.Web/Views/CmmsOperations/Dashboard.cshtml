@model PEMS.Application.DTOs.CmmsOperationsDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Backlog"><i class="bi bi-list-task"></i> @Localizer["Maintenance Backlog"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="WorkRequest" asp-action="Index">@Localizer["Work Requests"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="WorkOrder" asp-action="Index">@Localizer["Work Orders"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Reliability" asp-action="Intelligence">@Localizer["Maintenance Intelligence"]</pems-button>
    </div>
</div>
<p class="text-muted small">
    طبق «PEMS Phase 8» بند ۲۱: تجمیع فقط‌خواندنی وضعیت WorkRequest/WorkOrder موجود - هیچ عددی
    محاسبه/جعل نمی‌شود، فقط COUNT روی داده‌ی واقعی. Generated @Model.GeneratedAt.ToString("yyyy-MM-dd HH:mm").
</p>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@Model.WorkRequestTotal.ToString("N0")</div>
            <div class="text-muted small">Work Requests (total active)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold @(Model.WorkRequestPendingAction > 0 ? "text-warning" : "")">@Model.WorkRequestPendingAction.ToString("N0")</div>
            <div class="text-muted small">WR Pending Action (Submitted/UnderReview/Approved)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold">@Model.WorkOrderTotal.ToString("N0")</div>
            <div class="text-muted small">Work Orders (total active)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card h-100 text-center">
            <div class="fs-4 fw-bold @(Model.WorkOrderOverdue > 0 ? "text-danger" : "")">@Model.WorkOrderOverdue.ToString("N0")</div>
            <div class="text-muted small">Work Orders Overdue (DueDate passed)</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="content-card">
            <h6 class="mb-2">Work Request — by Status</h6>
            <table class="table table-enterprise table-sm mb-0">
                <tbody>
                    <tr><td>@Localizer["Draft"]</td><td class="text-end">@Model.WorkRequestDraft.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Submitted"]</td><td class="text-end">@Model.WorkRequestSubmitted.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Under Review"]</td><td class="text-end">@Model.WorkRequestUnderReview.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Approved"]</td><td class="text-end">@Model.WorkRequestApproved.ToString("N0")</td></tr>
                    <tr><td>Planned (ready to convert)</td><td class="text-end">@Model.WorkRequestPlanned.ToString("N0")</td></tr>
                    <tr><td>Converted</td><td class="text-end">@Model.WorkRequestConverted.ToString("N0")</td></tr>
                    <tr><td class="text-muted">@Localizer["Rejected"]</td><td class="text-end text-muted">@Model.WorkRequestRejected.ToString("N0")</td></tr>
                    <tr><td class="text-muted">@Localizer["Cancelled"]</td><td class="text-end text-muted">@Model.WorkRequestCancelled.ToString("N0")</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-card">
            <h6 class="mb-2">Work Order — by Status</h6>
            <table class="table table-enterprise table-sm mb-0">
                <tbody>
                    <tr><td>@Localizer["Open"]</td><td class="text-end">@Model.WorkOrderOpen.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Assigned"]</td><td class="text-end">@Model.WorkOrderAssigned.ToString("N0")</td></tr>
                    <tr><td>@Localizer["In Progress"]</td><td class="text-end">@Model.WorkOrderInProgress.ToString("N0")</td></tr>
                    <tr><td>@Localizer["On Hold"]</td><td class="text-end">@Model.WorkOrderOnHold.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Completed"]</td><td class="text-end">@Model.WorkOrderCompleted.ToString("N0")</td></tr>
                    <tr><td>@Localizer["Closed"]</td><td class="text-end">@Model.WorkOrderClosed.ToString("N0")</td></tr>
                    <tr><td class="text-muted">@Localizer["Cancelled"]</td><td class="text-end text-muted">@Model.WorkOrderCancelled.ToString("N0")</td></tr>
                    <tr><td class="text-muted">@Localizer["Rejected"]</td><td class="text-end text-muted">@Model.WorkOrderRejected.ToString("N0")</td></tr>
                    <tr><td class="fw-bold">Critical &amp; Open</td><td class="text-end fw-bold">@Model.WorkOrderCriticalOpen.ToString("N0")</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ===================== Phase 7 Reuse: PM Compliance / Type Breakdown ===================== *@
<div class="row g-3">
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-2">PM Compliance <span class="text-muted small">@Localizer["(از IReliabilityIntelligenceService)"]</span></h6>
            @if (Model.PmCompliance is { } pm)
            {
                <span class="badge @(pm.DataStatus == "READY" ? "text-bg-success" : pm.DataStatus == "PARTIAL" ? "text-bg-warning" : "text-bg-secondary") mb-2">@pm.DataStatus</span>
                @if (pm.CompliancePercent.HasValue)
                {
                    <div class="fs-4 fw-bold">@pm.CompliancePercent.Value.ToString("N1")%</div>
                }
                else
                {
                    <div class="text-muted">N/A</div>
                }
                <table class="table table-enterprise table-sm mb-0 mt-2">
                    <tbody>
                        <tr><td>@Localizer["Compliant"]</td><td class="text-end">@pm.CompliantCount</td></tr>
                        <tr><td>@Localizer["Completed Late"]</td><td class="text-end">@pm.CompletedLateCount</td></tr>
                        <tr><td>@Localizer["Overdue"]</td><td class="text-end">@pm.OverdueCount</td></tr>
                        <tr><td>@Localizer["Not Yet Due"]</td><td class="text-end">@pm.NotYetDueCount</td></tr>
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-card h-100">
            <h6 class="mb-2">Maintenance Type Breakdown <span class="text-muted small">@Localizer["(از IReliabilityIntelligenceService)"]</span></h6>
            @if (Model.MaintenanceTypeBreakdown is { } tb)
            {
                <span class="badge @(tb.DataStatus == "READY" ? "text-bg-success" : "text-bg-secondary") mb-2">@tb.DataStatus</span>
                <table class="table table-enterprise table-sm mb-0">
                    <tbody>
                        @foreach (var item in tb.Items)
                        {
                            <tr><td>@item.TypeName</td><td class="text-end">@item.Count</td></tr>
                        }
                    </tbody>
                </table>
                @if (tb.EmergencyWorkRatioPercent.HasValue)
                {
                    <p class="text-muted small mt-2 mb-0">Emergency work ratio: @tb.EmergencyWorkRatioPercent.Value.ToString("N1")%</p>
                }
            }
        </div>
    </div>
</div>
