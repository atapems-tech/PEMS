@model PEMS.Domain.Entities.MOC
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var sb = Model.Status switch { "Closed" => "bg-success", "Rejected" => "bg-dark", _ => "bg-info text-dark" };
    var workflowRunning = (bool)(ViewBag.WorkflowRunning ?? false);
    var currentStageName = (string?)ViewBag.CurrentStageName;
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">@Model.MOCNumber</h5>
            <span class="text-muted small">@Model.Project?.ProjectName &middot; @Model.Discipline?.Name &middot; @Model.ChangeType</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(Model.RiskLevel == "High" ? "bg-danger" : Model.RiskLevel == "Medium" ? "bg-warning text-dark" : "bg-secondary") fs-6">Risk: @Model.RiskLevel</span>
            <span class="badge @sb fs-6">@Model.Status</span>
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <div class="row g-3">
        <div class="col-12"><strong>Title:</strong> @Model.Title</div>
        <div class="col-12"><strong>@Localizer["Description:"]</strong> @Model.Description</div>
        <div class="col-12"><strong>Reason:</strong> @Model.Reason</div>
        @if (Model.RelatedDocument != null)
        {
            <div class="col-md-6">
                <strong>@Localizer["Related Document:"]</strong>
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.RelatedDocumentId">@Model.RelatedDocument.DocumentNo</a>
            </div>
        }
        @if (Model.RelatedEquipment != null)
        {
            <div class="col-md-6">
                <strong>@Localizer["Related Equipment:"]</strong>
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.RelatedEquipmentId">@Model.RelatedEquipment.TagNumber</a>
            </div>
        }
        @if (Model.ChangeType == "Temporary")
        {
            <div class="col-md-6"><strong>Temporary Expiry:</strong> @(Model.TemporaryExpiryDate?.ToString("yyyy-MM-dd"))</div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.RiskAssessmentText))
{
    <div class="content-card mb-3">
        <h6 class="mb-2"><i class="bi bi-shield-exclamation"></i> Risk Assessment</h6>
        <p class="mb-0">@Model.RiskAssessmentText</p>
    </div>
}

@if (Model.Status == "Rejected")
{
    <div class="content-card mb-3 border-danger">
        <h6 class="mb-2 text-danger"><i class="bi bi-x-circle"></i> @Localizer["Rejected"]</h6>
        <p class="mb-0">@Model.RejectionReason</p>
    </div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-paperclip"></i> Attachments <pems-badge tone="neutral">@Model.Attachments.Count</pems-badge></h6>
    @if (Model.Attachments.Any())
    {
        <ul class="list-unstyled mb-3">
            @foreach (var a in Model.Attachments.Where(x => x.IsActive))
            {
                <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                    <a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><i class="bi bi-file-earmark"></i> @a.FileName</a>
                    <span class="text-muted small">@a.UploadDate.ToString("yyyy-MM-dd")</span>
                </li>
            }
        </ul>
    }
    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-2">
        <input type="hidden" name="mocId" value="@Model.MOCId" />
        <input type="file" name="file" class="form-control form-control-sm" required />
        <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><i class="bi bi-upload"></i> افزودن</pems-button>
    </form>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-signpost-split"></i> Workflow</h6>

    @if (!workflowRunning)
    {
        <p class="text-muted small mb-0">این MOC گردش‌کار فعالی ندارد (بسته/رد شده یا هنوز شروع نشده).</p>
    }
    else if (currentStageName == "RiskAssessment")
    {
        <p class="text-muted small">در انتظار ارزیابی ریسک توسط دیسیپلین <strong>@Model.Discipline?.Name</strong></p>
        @if (myDisciplineId == Model.DisciplineId)
        {
            <form asp-action="AssessRisk" method="post">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <textarea name="riskAssessmentText" class="form-control mb-2" rows="3" placeholder="متن ارزیابی ریسک..." required></textarea>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت ارزیابی"]</pems-button>
            </form>
        }
    }
    else if (currentStageName == "Approval" || currentStageName == "SeniorApproval")
    {
        <p class="text-muted small">
            در انتظار @(currentStageName == "SeniorApproval" ? "تایید ارشد (چون ریسک بالاست)" : "تایید")
        </p>
        <div class="d-flex gap-2">
            <form asp-action="Approve" method="post">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <pems-button tone="success" size="small" type="submit"><i class="bi bi-check-lg"></i> @Localizer["Approve"]</pems-button>
            </form>
            <pems-button tone="danger" size="small" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <i class="bi bi-x-lg"></i> @Localizer["Reject"]
            </pems-button>
        </div>

        <div class="modal fade" id="rejectModal" tabindex="-1">
            <div class="modal-dialog"><div class="modal-content">
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="mocId" value="@Model.MOCId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["دلیل رد"]</h6></div>
                    <div class="modal-body"><textarea name="reason" class="form-control" rows="3" required></textarea></div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                        <pems-button tone="danger" size="small" type="submit">@Localizer["رد کن"]</pems-button>
                    </div>
                </form>
            </div></div>
        </div>
    }
    else if (currentStageName == "Closure")
    {
        <p class="text-muted small mb-3">تایید نهایی شده - قبل از بستن، چک‌لیست زیر باید کامل بشه.</p>

        @if (string.IsNullOrEmpty(Model.ImplementationPlan))
        {
            <form asp-action="RecordImplementation" method="post" class="mb-3">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <label class="form-label small">Implementation Plan / نحوه‌ی اجرا</label>
                <textarea name="implementationPlan" class="form-control form-control-sm mb-2" rows="2" required></textarea>
                <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["ثبت اجرا"]</pems-button>
            </form>
        }
        else
        {
            <p class="small"><strong>Implementation:</strong> @Model.ImplementationPlan</p>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <div class="border rounded p-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small"><i class="bi bi-file-earmark-check"></i> به‌روزرسانی مدارک متاثر</span>
                        @if (Model.DocumentsUpdated)
                        {
                            <pems-badge tone="success">@Localizer["تکمیل‌شده"]</pems-badge>
                        }
                        else
                        {
                            <form asp-action="MarkDocumentsUpdated" method="post" class="d-flex gap-1">
                                <input type="hidden" name="mocId" value="@Model.MOCId" />
                                <input type="text" name="note" class="form-control form-control-sm" placeholder="@Localizer["یادداشت (اختیاری)"]" style="max-width:150px;" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["تکمیل شد"]</pems-button>
                            </form>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small"><i class="bi bi-mortarboard"></i> آموزش @(Model.TrainingRequired ? "" : "(نیاز ندارد)")</span>
                        @if (!Model.TrainingRequired || Model.TrainingCompleted)
                        {
                            <pems-badge tone="success">@(Model.TrainingRequired ? "تکمیل‌شده" : "نامرتبط")</pems-badge>
                        }
                        else
                        {
                            <form asp-action="MarkTrainingCompleted" method="post">
                                <input type="hidden" name="mocId" value="@Model.MOCId" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["تکمیل شد"]</pems-button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Close" method="post" class="mt-3">
            <input type="hidden" name="mocId" value="@Model.MOCId" />
            <pems-button tone="primary" size="small" type="submit"><i class="bi bi-check-circle"></i> بستن نهایی MOC</pems-button>
        </form>
    }
</div>
