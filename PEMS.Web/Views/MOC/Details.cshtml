@model PEMS.Domain.Entities.MOC
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var sb = Model.Status switch { "Closed" => "success", "Rejected" => "dark", _ => "info" };
    var workflowRunning = (bool)(ViewBag.WorkflowRunning ?? false);
    var currentStageName = (string?)ViewBag.CurrentStageName;
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <div>
            <h5 class="mb-0">@Model.MOCNumber</h5>
            <span class="text-muted small">@Model.Project?.ProjectName &middot; @Model.Discipline?.Name &middot; @Model.ChangeType</span>
        </div>
        <pems-flex align="center" gap="2">
            <pems-badge tone="@(Model.RiskLevel == "High" ? "danger" : Model.RiskLevel == "Medium" ? "warning" : "neutral")" css="fs-6">Risk: @Model.RiskLevel</pems-badge>
            <pems-badge tone="@sb" css="fs-6">@Model.Status</pems-badge>
        </pems-flex>
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col span="12"><strong>Title:</strong> @Model.Title</pems-col>
        <pems-col span="12"><strong>@Localizer["Description:"]</strong> @Model.Description</pems-col>
        <pems-col span="12"><strong>Reason:</strong> @Model.Reason</pems-col>
        @if (Model.RelatedDocument != null)
        {
            <pems-col md="6">
                <strong>@Localizer["Related Document:"]</strong>
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.RelatedDocumentId">@Model.RelatedDocument.DocumentNo</a>
            </pems-col>
        }
        @if (Model.RelatedEquipment != null)
        {
            <pems-col md="6">
                <strong>@Localizer["Related Equipment:"]</strong>
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.RelatedEquipmentId">@Model.RelatedEquipment.TagNumber</a>
            </pems-col>
        }
        @if (Model.ChangeType == "Temporary")
        {
            <pems-col md="6"><strong>Temporary Expiry:</strong> @(Model.TemporaryExpiryDate?.ToString("yyyy-MM-dd"))</pems-col>
        }
    </pems-row>
</pems-content-card>

@if (!string.IsNullOrEmpty(Model.RiskAssessmentText))
{
    <pems-content-card css="mb-3">
        <h6 class="mb-2"><pems-icon name="bi-shield-exclamation" /> Risk Assessment</h6>
        <p class="mb-0">@Model.RiskAssessmentText</p>
    </pems-content-card>
}

@if (Model.Status == "Rejected")
{
    <pems-content-card css="mb-3 border-danger">
        <h6 class="mb-2 text-danger"><pems-icon name="bi-x-circle" /> @Localizer["Rejected"]</h6>
        <p class="mb-0">@Model.RejectionReason</p>
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <h6 class="mb-3"><pems-icon name="bi-paperclip" /> Attachments <pems-badge tone="neutral">@Model.Attachments.Count</pems-badge></h6>
    @if (Model.Attachments.Any())
    {
        <ul class="list-unstyled mb-3">
            @foreach (var a in Model.Attachments.Where(x => x.IsActive))
            {
                <pems-flex as="li" justify="between" align="center" css="border-bottom py-1">
                    <a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><pems-icon name="bi-file-earmark" /> @a.FileName</a>
                    <span class="text-muted small">@a.UploadDate.ToString("yyyy-MM-dd")</span>
                </pems-flex>
            }
        </ul>
    }
    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data"><pems-flex gap="2">
        <input type="hidden" name="mocId" value="@Model.MOCId" />
        <pems-input scale="small" type="file" name="file" required />
        <pems-button tone="primary" size="small" outline="true" css="text-nowrap" type="submit"><pems-icon name="bi-upload" /> افزودن</pems-button>
    </pems-flex></form>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3"><pems-icon name="bi-signpost-split" /> Workflow</h6>

    @if (!workflowRunning)
    {
        <p class="text-muted small mb-0">این MOC گردش‌کار فعالی ندارد (بسته/رد شده یا هنوز شروع نشده).</p>
    }
    else if (currentStageName == "RiskAssessment")
    {
        <p class="text-muted small">در انتظار ارزیابی ریسک توسط دیسیپلین <strong>@Model.Discipline?.Name</strong></p>
        @if (myDisciplineId == Model.DisciplineId)
        {
            <form asp-action="AssessRisk" method="post">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <pems-textarea css="mb-2" name="riskAssessmentText" rows="3" placeholder="متن ارزیابی ریسک..." required></pems-textarea>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت ارزیابی"]</pems-button>
            </form>
        }
    }
    else if (currentStageName == "Approval" || currentStageName == "SeniorApproval")
    {
        <p class="text-muted small">
            در انتظار @(currentStageName == "SeniorApproval" ? "تایید ارشد (چون ریسک بالاست)" : "تایید")
        </p>
        <pems-flex gap="2">
            <form asp-action="Approve" method="post">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> @Localizer["Approve"]</pems-button>
            </form>
            <pems-button tone="danger" size="small" type="button" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <pems-icon name="bi-x-lg" /> @Localizer["Reject"]
            </pems-button>
        </pems-flex>

        <pems-modal id="rejectModal" tabindex="-1">
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="mocId" value="@Model.MOCId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["دلیل رد"]</h6></div>
                    <div class="modal-body"><pems-textarea name="reason" rows="3" required></pems-textarea></div>
                    <div class="modal-footer">
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                        <pems-button tone="danger" size="small" type="submit">@Localizer["رد کن"]</pems-button>
                    </div>
                </form>
            </pems-modal>
    }
    else if (currentStageName == "Closure")
    {
        <p class="text-muted small mb-3">تایید نهایی شده - قبل از بستن، چک‌لیست زیر باید کامل بشه.</p>

        @if (string.IsNullOrEmpty(Model.ImplementationPlan))
        {
            <form asp-action="RecordImplementation" method="post" class="mb-3">
                <input type="hidden" name="mocId" value="@Model.MOCId" />
                <pems-label css="small">Implementation Plan / نحوه‌ی اجرا</pems-label>
                <pems-textarea scale="small" css="mb-2" name="implementationPlan" rows="2" required></pems-textarea>
                <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["ثبت اجرا"]</pems-button>
            </form>
        }
        else
        {
            <p class="small"><strong>Implementation:</strong> @Model.ImplementationPlan</p>
        }

        <pems-row gap="3">
            <pems-col md="6">
                <div class="border rounded p-2">
                    <pems-flex justify="between" align="center">
                        <span class="small"><pems-icon name="bi-file-earmark-check" /> به‌روزرسانی مدارک متاثر</span>
                        @if (Model.DocumentsUpdated)
                        {
                            <pems-badge tone="success">@Localizer["تکمیل‌شده"]</pems-badge>
                        }
                        else
                        {
                            <form asp-action="MarkDocumentsUpdated" method="post"><pems-flex gap="1">
                                <input type="hidden" name="mocId" value="@Model.MOCId" />
                                <pems-input class="pems-maxw-150" scale="small" type="text" name="note" placeholder="@Localizer["یادداشت (اختیاری)"]" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["تکمیل شد"]</pems-button>
                            </pems-flex></form>
                        }
                    </pems-flex>
                </div>
            </pems-col>
            <pems-col md="6">
                <div class="border rounded p-2">
                    <pems-flex justify="between" align="center">
                        <span class="small"><pems-icon name="bi-mortarboard" /> آموزش @(Model.TrainingRequired ? "" : "(نیاز ندارد)")</span>
                        @if (!Model.TrainingRequired || Model.TrainingCompleted)
                        {
                            <pems-badge tone="success">@(Model.TrainingRequired ? "تکمیل‌شده" : "نامرتبط")</pems-badge>
                        }
                        else
                        {
                            <form asp-action="MarkTrainingCompleted" method="post">
                                <input type="hidden" name="mocId" value="@Model.MOCId" />
                                <pems-button tone="success" size="small" outline="true" type="submit">@Localizer["تکمیل شد"]</pems-button>
                            </form>
                        }
                    </pems-flex>
                </div>
            </pems-col>
        </pems-row>

        <form asp-action="Close" method="post" class="mt-3">
            <input type="hidden" name="mocId" value="@Model.MOCId" />
            <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-check-circle" /> بستن نهایی MOC</pems-button>
        </form>
    }
</pems-content-card>
