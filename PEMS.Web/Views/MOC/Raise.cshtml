@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="content-card pems-s-3f7efa5f">
    <h6 class="mb-3"><pems-icon name="bi-arrow-repeat" /> New MOC (Management of Change)</h6>

    <form asp-action="Raise" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>Requesting Discipline</pems-label>
                <pems-select name="disciplineId" required>
                    @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </pems-select>
            </div>

            <div class="col-12"><pems-label>@Localizer["Title"]</pems-label><pems-input name="title" required /></div>
            <div class="col-12"><pems-label>@Localizer["Description"]</pems-label><pems-textarea name="description" rows="3" required></pems-textarea></div>
            <div class="col-12"><pems-label>Reason / Justification</pems-label><pems-textarea name="reason" rows="2"></pems-textarea></div>

            <div class="col-md-4">
                <pems-label>Change Type</pems-label>
                <pems-select name="changeType" id="changeTypeSelect" onchange="document.getElementById('tempExpiryWrap').style.display = this.value === 'Temporary' ? '' : 'none';">
                    <option value="Permanent">Permanent</option>
                    <option value="Temporary">Temporary</option>
                </pems-select>
            </div>
            <div class="col-md-4" id="tempExpiryWrap" style="display:none;">
                <pems-label>Temporary Expiry Date</pems-label>
                <pems-date name="temporaryExpiryDate" />
            </div>
            <div class="col-md-4">
                <pems-label>@Localizer["Risk Level"]</pems-label>
                <pems-select name="riskLevel" required>
                    <option value="Low">@Localizer["Low"]</option>
                    <option value="Medium">@Localizer["Medium"]</option>
                    <option value="High">High <span>(نیاز به تایید ارشد اضافه)</span></option>
                </pems-select>
            </div>

            <div class="col-md-6">
                <pems-label><pems-icon name="bi-file-earmark-text" /> مدرک مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی شماره مدرک، عنوان..."]" data-pems-search data-search-type="EngineeringDocument" data-search-hidden="#relatedDocumentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedDocumentId" id="relatedDocumentIdHidden" />
            </div>
            <div class="col-md-6">
                <pems-label><pems-icon name="bi-gear" /> تجهیز مرتبط <span class="text-muted small">@Localizer["(اختیاری)"]</span></pems-label>
                <pems-input type="text" placeholder="@Localizer["جستجوی تگ، نام..."]" value="@ViewBag.PreselectedEquipmentLabel" data-pems-search data-search-type="Equipment" data-search-hidden="#relatedEquipmentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedEquipmentId" id="relatedEquipmentIdHidden" value="@ViewBag.PreselectedEquipmentId" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <pems-input kind="check" type="checkbox" name="trainingRequired" value="true" id="trainingRequiredCheck" />
                    <label class="form-check-label" for="trainingRequiredCheck">این تغییر نیاز به آموزش دارد (قبل از بستن نهایی باید تکمیل بشه)</label>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Submit"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>
