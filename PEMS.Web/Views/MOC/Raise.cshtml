<div class="content-card" style="max-width:800px;">
    <h6 class="mb-3"><i class="bi bi-arrow-repeat"></i> New MOC (Management of Change)</h6>

    <form asp-action="Raise" method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Project</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Requesting Discipline</label>
                <select name="disciplineId" class="form-select" required>
                    @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </select>
            </div>

            <div class="col-12"><label class="form-label">Title</label><input name="title" class="form-control" required /></div>
            <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3" required></textarea></div>
            <div class="col-12"><label class="form-label">Reason / Justification</label><textarea name="reason" class="form-control" rows="2"></textarea></div>

            <div class="col-md-4">
                <label class="form-label">Change Type</label>
                <select name="changeType" class="form-select" id="changeTypeSelect" onchange="document.getElementById('tempExpiryWrap').style.display = this.value === 'Temporary' ? '' : 'none';">
                    <option value="Permanent">Permanent</option>
                    <option value="Temporary">Temporary</option>
                </select>
            </div>
            <div class="col-md-4" id="tempExpiryWrap" style="display:none;">
                <label class="form-label">Temporary Expiry Date</label>
                <input name="temporaryExpiryDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Risk Level</label>
                <select name="riskLevel" class="form-select" required>
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High <span>(نیاز به تایید ارشد اضافه)</span></option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-file-earmark-text"></i> مدرک مرتبط <span class="text-muted small">(اختیاری)</span></label>
                <input type="text" class="form-control" placeholder="جستجوی شماره مدرک، عنوان..."
                       data-pems-search data-search-type="EngineeringDocument" data-search-hidden="#relatedDocumentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedDocumentId" id="relatedDocumentIdHidden" />
            </div>
            <div class="col-md-6">
                <label class="form-label"><i class="bi bi-gear"></i> تجهیز مرتبط <span class="text-muted small">(اختیاری)</span></label>
                <input type="text" class="form-control" placeholder="جستجوی تگ، نام..."
                       value="@ViewBag.PreselectedEquipmentLabel"
                       data-pems-search data-search-type="Equipment" data-search-hidden="#relatedEquipmentIdHidden" autocomplete="off" />
                <input type="hidden" name="relatedEquipmentId" id="relatedEquipmentIdHidden" value="@ViewBag.PreselectedEquipmentId" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="trainingRequired" value="true" id="trainingRequiredCheck" />
                    <label class="form-check-label" for="trainingRequiredCheck">این تغییر نیاز به آموزش دارد (قبل از بستن نهایی باید تکمیل بشه)</label>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">Submit</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
