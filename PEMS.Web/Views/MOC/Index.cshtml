@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MOCListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = ((IEnumerable<dynamic>)ViewBag.Projects).ToList();
    var riskLevel = (string?)ViewBag.SelectedRiskLevel;
    var status = (string?)ViewBag.SelectedStatus;
    var projectId = (int?)ViewBag.SelectedProjectId;
    string? projectName = null;
    foreach (var p in projects) { if (p.ProjectId == projectId) { projectName = p.ProjectName; } }

    var riskLevels = new[] { "Low", "Medium", "High" };
    var statuses = new[] { "PendingRiskAssessment", "PendingApproval", "PendingSeniorApproval", "Approved", "PendingClosure", "Closed", "Rejected" };
    var filterCount = (string.IsNullOrEmpty(riskLevel) ? 0 : 1) + (string.IsNullOrEmpty(status) ? 0 : 1) + (projectId.HasValue ? 1 : 0);

    // display texts; stored values never change (no key => the raw value)
    string StatusText(string? s) => VdrUi.Loc(Localizer, "Moc_St_", s);
    string RiskText(string? r) => VdrUi.Loc(Localizer, "Moc_Risk_", r);
    string StatusTone(string? s) => s == "Closed" ? "vs-pill--success" : s == "Rejected" ? "vs-pill--danger" : s == "Approved" ? "vs-pill--current" : "vs-pill--info";
    string RiskTone(string? r) => r == "High" ? "vs-pill--danger" : r == "Medium" ? "vs-pill--warning" : "vs-pill--neutral";
    var highRiskOpen = (int?)ViewBag.HighRiskOpenCount ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W1: built from the PEMS.UI list-page component; the page keeps its filters (risk, status, project), its counts and columns. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Moc_Title"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="mocFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="mocFilterRisk">@Localizer["Moc_Risk"]</label>
                        <select id="mocFilterRisk" name="riskLevel" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var r in riskLevels)
                            { <option value="@r" selected="@(r == riskLevel)">@RiskText(r)</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="mocFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="mocFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                    <div>
                        <label class="lp-lbl" for="mocFilterProject">@Localizer["Project"]</label>
                        <select id="mocFilterProject" name="projectId" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var p in projects)
                            { <option value="@p.ProjectId" selected="@(p.ProjectId == projectId)">@p.ProjectName</option> }
                        </select>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="mocKpis" storage-key="pems.moc.kpis" />
                <pems-list-reset-columns grid-key="MOC" />
                <pems-list-new href="@Url.Action("Raise")" text="@Localizer["Moc_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="mocKpis">
            <span class="vs-chip">@Localizer["Lp_Total"] <strong>@Model.TotalCount</strong></span>
            <span class="vs-chip">@Localizer["Moc_OpenCount"] <strong>@ViewBag.OpenCount</strong></span>
            <span class="vs-chip @(highRiskOpen > 0 ? "vs-chip--danger" : "")"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Moc_HighRiskOpen"] <strong>@highRiskOpen</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(riskLevel))
            { <pems-list-chip label="@Localizer["Moc_Risk"]" value="@RiskText(riskLevel)" remove-href="@Url.Action("Index", new { status, projectId })" /> }
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { riskLevel, projectId })" /> }
            @if (projectId.HasValue)
            { <pems-list-chip label="@Localizer["Project"]" value="@projectName" remove-href="@Url.Action("Index", new { riskLevel, status })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="MOC" empty="@(!Model.Items.Any())" empty-text="@Localizer["Moc_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Moc_Number"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="180" data-max-width="500" style="width:320px">@Localizer["Ed_Title"]</th>
                        <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px" class="vs-hide-md">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Ed_Type"]</th>
                        <th data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Moc_Risk"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="110" data-max-width="240" style="width:170px">@Localizer["Ed_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@m.MOCId" class="lp-subject" title="@m.MOCNumber">@m.MOCNumber</a></td>
                            <td><span class="vs-title-cell" title="@m.Title">@m.Title</span></td>
                            <td class="vs-hide-md small" title="@m.DisciplineName">@m.DisciplineName</td>
                            <td class="vs-hide-md small">@m.ChangeType</td>
                            <td><span class="vs-pill @RiskTone(m.RiskLevel)">@RiskText(m.RiskLevel)</span></td>
                            <td><span class="vs-pill @StatusTone(m.Status)">@StatusText(m.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @{
                    var mocQsParts = new List<string>();
                    if (!string.IsNullOrEmpty(riskLevel)) mocQsParts.Add($"riskLevel={Uri.EscapeDataString(riskLevel)}");
                    if (!string.IsNullOrEmpty(status)) mocQsParts.Add($"status={Uri.EscapeDataString(status)}");
                    if (projectId.HasValue) mocQsParts.Add($"projectId={projectId}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "MOC",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", mocQsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
