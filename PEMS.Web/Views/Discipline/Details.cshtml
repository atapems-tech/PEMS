@model PEMS.Application.DTOs.DisciplineWorkspaceDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var employees = (IEnumerable<dynamic>)ViewBag.Employees;
    var s = Model.Summary;
}


<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@s.Code &mdash; @s.Name Workspace</h5>
        <form method="get" class="d-flex gap-2">
            <select name="projectId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-file-earmark-text"></i></div><div><div class="kpi-value">@s.DocumentsCount</div><div class="kpi-label">@Localizer["Documents"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-hourglass-split"></i></div><div><div class="kpi-value">@s.PendingDocumentsCount</div><div class="kpi-label">@Localizer["Pending"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-gear"></i></div><div><div class="kpi-value">@s.EquipmentCount</div><div class="kpi-label">@Localizer["Equipment"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-journal-check"></i></div><div><div class="kpi-value">@s.VDRItemsCount</div><div class="kpi-label">@Localizer["VDR Items"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-list-task"></i></div><div><div class="kpi-value">@s.OpenTasksCount</div><div class="kpi-label">@Localizer["Open Tasks"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-red"><i class="bi bi-exclamation-triangle"></i></div><div><div class="kpi-value">@s.OverdueTasksCount</div><div class="kpi-label">Overdue Tasks</div></div></div></div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Tasks / Activities / Deliverables</h6>
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Type"]</th><th>@Localizer["Title"]</th><th>@Localizer["Project"]</th><th>@Localizer["Responsible"]</th><th>@Localizer["Due"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Model.Tasks)
            {
                <tr class="@(t.IsOverdue ? "table-danger" : "")">
                    <td><pems-badge tone="neutral">@t.Type</pems-badge></td>
                    <td>@t.Title</td>
                    <td>@t.ProjectName</td>
                    <td>@t.ResponsibleName</td>
                    <td>@(t.DueDate?.ToString("yyyy-MM-dd"))</td>
                    <td>
                        <form asp-action="SetTaskStatus" method="post" class="d-inline">
                            <input type="hidden" name="disciplineId" value="@s.DisciplineId" />
                            <input type="hidden" name="taskId" value="@t.DisciplineTaskId" />
                            <select name="status" class="form-select form-select-sm" style="width:120px;" onchange="this.form.submit()">
                                @foreach (var opt in new[] { "Open", "InProgress", "Completed" })
                                { <option value="@opt" selected="@(opt == t.Status)">@opt</option> }
                            </select>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Tasks.Any()) { <p class="text-muted">No tasks yet.</p> }

    <form asp-action="AddTask" method="post" class="row g-2 mt-2">
        <input type="hidden" name="disciplineId" value="@s.DisciplineId" />
        <div class="col-md-2">
            <select name="type" class="form-select form-select-sm">
                <option>Task</option><option>@Localizer["Activity"]</option><option>Deliverable</option>
            </select>
        </div>
        <div class="col-md-3"><input name="title" class="form-control form-control-sm" placeholder="@Localizer["Title"]" required /></div>
        <div class="col-md-2">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">-- Project --</option>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="responsibleEmployeeId" class="form-select form-select-sm">
                <option value="">-- Responsible --</option>
                @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
        <div class="col-md-1"><pems-button tone="primary" size="small" css="w-100"><i class="bi bi-plus-lg"></i></pems-button></div>
    </form>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["Documents"]</h6>
            <div class="table-scroll-area" style="max-height:340px; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Doc No"]</th><th>@Localizer["Title"]</th><th>@Localizer["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Documents)
                        {
                            <tr><td><a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId">@d.DocumentNo</a></td><td>@d.Title</td><td><span class="badge badge-status-@d.Status">@d.Status</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Documents.Any()) { <p class="text-muted small">No documents.</p> }
        </div>

        <div class="content-card">
            <h6 class="mb-3">@Localizer["Equipment"]</h6>
            <div class="table-scroll-area" style="max-height:340px; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Tag"]</th><th>@Localizer["Name"]</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Equipment)
                        {
                            <tr><td><a asp-controller="Equipment" asp-action="Details" asp-route-id="@e.EquipmentId">@e.TagNumber</a></td><td>@e.Name</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Equipment.Any()) { <p class="text-muted small">No equipment.</p> }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["VDR Items"]</h6>
            <div class="table-scroll-area" style="max-height:340px; overflow-y:auto;">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Doc No"]</th><th>@Localizer["Vendor"]</th><th>@Localizer["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.VDRItems)
                        {
                            <tr><td><a asp-controller="VDR" asp-action="Details" asp-route-id="@v.VDRItemId">@v.DocumentNumber</a></td><td>@v.VendorName</td><td><pems-badge tone="neutral">@v.WorkflowStatus</pems-badge></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.VDRItems.Any()) { <p class="text-muted small">No VDR items.</p> }
        </div>

        <div class="content-card">
            <h6 class="mb-3">MR / MRQ</h6>
            <table class="table table-enterprise">
                <thead><tr><th>MR No</th><th>@Localizer["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MRs)
                    {
                        <tr><td>@m.MRNumber</td><td><pems-badge tone="neutral">@m.Status</pems-badge></td></tr>
                    }
                </tbody>
            </table>
            @if (!Model.MRs.Any()) { <p class="text-muted small">No MR/MRQ.</p> }
        </div>
    </div>
</div>
