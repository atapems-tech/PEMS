@model List<PEMS.Application.DTOs.DisciplineSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    @if (ViewBag.CanManageMaster == true)
    {
        <div class="mb-3"><pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Manage"><i class="bi bi-sliders"></i> @Localizer["Manage disciplines"]</pems-button></div>
    }
    <p class="text-muted">
        هر دیسیپلین یک Workspace اختصاصی دارد (Equipment, Documents, VDR, MR/MRQ, Tasks, KPI) —
        دیتابیس مشترک است، فقط نما فیلترشده است.
    </p>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr><th>@Localizer["Code"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Documents"]</th><th>@Localizer["Pending"]</th><th>@Localizer["Equipment"]</th><th>@Localizer["VDR"]</th><th>@Localizer["Open Tasks"]</th><th>@Localizer["Overdue"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Code</td>
                        <td>@d.Name</td>
                        <td><pems-badge tone="neutral">@d.DocumentsCount</pems-badge></td>
                        <td><pems-badge tone="warning">@d.PendingDocumentsCount</pems-badge></td>
                        <td><pems-badge tone="neutral">@d.EquipmentCount</pems-badge></td>
                        <td><pems-badge tone="neutral">@d.VDRItemsCount</pems-badge></td>
                        <td><pems-badge tone="info">@d.OpenTasksCount</pems-badge></td>
                        <td>
                            @if (d.OverdueTasksCount > 0)
                            { <pems-badge tone="danger">@d.OverdueTasksCount</pems-badge> }
                            else
                            { <pems-badge tone="success">0</pems-badge> }
                        </td>
                        <td><pems-button tone="primary" size="small" as="a" asp-action="Details" asp-route-id="@d.DisciplineId"><i class="bi bi-box-arrow-in-right"></i> Open Workspace</pems-button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted text-center py-4">No disciplines configured yet.</p> }
    </div>
</div>
