@model List<PEMS.Application.DTOs.DisciplineSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component. The page note became the tool tip of the title; "Manage
   disciplines" is a toolbar tool for who may manage them; each row opens its workspace. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["DsL_Title"]" heading-title="@Localizer["DsL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                @if (ViewBag.CanManageMaster == true)
                {
                    <a class="lp-icon-btn" asp-action="Manage" title="@Localizer["Manage disciplines"]" aria-label="@Localizer["Manage disciplines"]"><i class="bi bi-sliders" aria-hidden="true"></i></a>
                }
                <pems-list-reset-columns grid-key="Discipline" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="Discipline" empty="@(!Model.Any())" empty-text="@Localizer["DsL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="code" data-resizable="true" data-min-width="70" data-max-width="140" style="width:90px">@Localizer["MiL_Code"]</th>
                        <th data-col-key="name" data-resizable="true" data-min-width="120" data-max-width="320">@Localizer["Ed_Discipline"]</th>
                        <th data-col-key="documents" data-resizable="true" data-min-width="70" data-max-width="130" style="width:100px" class="text-end">@Localizer["Ed_Documents"]</th>
                        <th data-col-key="pending" data-resizable="true" data-min-width="70" data-max-width="130" style="width:100px" class="text-end">@Localizer["Ed_Pending"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="70" data-max-width="130" style="width:100px" class="text-end vs-hide-md">@Localizer["PcRpt_Kpi_Equipment"]</th>
                        <th data-col-key="vdr" data-resizable="true" data-min-width="60" data-max-width="120" style="width:80px" class="text-end vs-hide-md">@Localizer["DsL_Vdr"]</th>
                        <th data-col-key="openTasks" data-resizable="true" data-min-width="70" data-max-width="130" style="width:100px" class="text-end">@Localizer["DsL_OpenTasks"]</th>
                        <th data-col-key="overdue" data-resizable="true" data-min-width="70" data-max-width="130" style="width:100px" class="text-end">@Localizer["Overdue"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><span class="vs-num">@d.Code</span></td>
                            <td><a asp-action="Details" asp-route-id="@d.DisciplineId" class="lp-subject" title="@d.Name">@d.Name</a></td>
                            <td class="text-end"><span class="vs-num">@d.DocumentsCount</span></td>
                            <td class="text-end">@if (d.PendingDocumentsCount > 0) { <span class="vs-pill vs-pill--warning">@d.PendingDocumentsCount</span> } else { <span class="vs-num">0</span> }</td>
                            <td class="text-end vs-hide-md"><span class="vs-num">@d.EquipmentCount</span></td>
                            <td class="text-end vs-hide-md"><span class="vs-num">@d.VDRItemsCount</span></td>
                            <td class="text-end"><span class="vs-num">@d.OpenTasksCount</span></td>
                            <td class="text-end">@if (d.OverdueTasksCount > 0) { <span class="vs-pill vs-pill--danger">@d.OverdueTasksCount</span> } else { <span class="vs-num">0</span> }</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@d.DisciplineId" class="lp-act lp-act--always" title="@Localizer["DsL_OpenWorkspace"]" aria-label="@Localizer["DsL_OpenWorkspace"] @d.Name"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
