@model List<PEMS.Application.DTOs.DisciplineSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card">
    <p class="text-muted">
        هر دیسیپلین یک Workspace اختصاصی دارد (Equipment, Documents, VDR, MR/MRQ, Tasks, KPI) —
        دیتابیس مشترک است، فقط نما فیلترشده است.
    </p>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead>
                <tr><th>@Localizer["Code"]</th><th>@Localizer["Discipline"]</th><th>@Localizer["Documents"]</th><th>@Localizer["Pending"]</th><th>@Localizer["Equipment"]</th><th>@Localizer["VDR"]</th><th>@Localizer["Open Tasks"]</th><th>@Localizer["Overdue"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Code</td>
                        <td>@d.Name</td>
                        <td><span class="badge bg-secondary">@d.DocumentsCount</span></td>
                        <td><span class="badge bg-warning text-dark">@d.PendingDocumentsCount</span></td>
                        <td><span class="badge bg-secondary">@d.EquipmentCount</span></td>
                        <td><span class="badge bg-secondary">@d.VDRItemsCount</span></td>
                        <td><span class="badge bg-info text-dark">@d.OpenTasksCount</span></td>
                        <td>
                            @if (d.OverdueTasksCount > 0)
                            { <span class="badge bg-danger">@d.OverdueTasksCount</span> }
                            else
                            { <span class="badge bg-success">0</span> }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@d.DisciplineId" class="btn btn-sm btn-pems-solid"><i class="bi bi-box-arrow-in-right"></i> Open Workspace</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted text-center py-4">No disciplines configured yet.</p> }
    </div>
</div>
