@model List<PEMS.Application.Interfaces.DisciplineRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (TempData["Message"] != null) { <div class="alert alert-success py-2 small" role="status">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2 small" role="alert">@TempData["Error"]</div> }

<div class="content-card mb-3">
    <p class="text-muted small mb-2">@Localizer["Disc_Manage_Note"]</p>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> @Localizer["Discipline Workspaces"]</a>

    <form method="get" class="d-flex gap-2 mb-3 flex-wrap">
        <input name="q" value="@ViewBag.Query" class="form-control form-control-sm" style="max-width:260px" placeholder="@Localizer["Org_Positions_Search"]" aria-label="@Localizer["Org_Positions_Search"]" />
        <select name="status" class="form-select form-select-sm" style="max-width:180px" aria-label="@Localizer["Org_Filter_Status"]">
            <option value="" selected="@((string)ViewBag.Status == "")">@Localizer["Org_Filter_All"]</option>
            <option value="active" selected="@((string)ViewBag.Status == "active")">@Localizer["Org_Filter_Active"]</option>
            <option value="inactive" selected="@((string)ViewBag.Status == "inactive")">@Localizer["Org_Inactive"]</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-funnel"></i> @Localizer["Org_Filter_Apply"]</button>
    </form>

    <form asp-action="CreateDiscipline" method="post" class="row g-2 align-items-end mb-3">
        <div class="col-md-2"><label class="form-label">@Localizer["Code"]</label><input name="code" class="form-control form-control-sm" maxlength="20" required /></div>
        <div class="col-md-3"><label class="form-label">@Localizer["Name"]</label><input name="name" class="form-control form-control-sm" maxlength="150" required /></div>
        <div class="col-md-3"><label class="form-label">@Localizer["Description"]</label><input name="description" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><label class="form-label">@Localizer["Import aliases"]</label><input name="importAliases" class="form-control form-control-sm" placeholder="PR, PROC" /></div>
        <div class="col-md-1"><label class="form-label">@Localizer["Transmittal code"]</label><input name="transmittalCode" class="form-control form-control-sm" maxlength="1" /></div>
        <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i></button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-enterprise table-sm align-middle">
            <thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Name"]</th><th>@Localizer["Description"]</th><th>@Localizer["Import aliases"]</th><th>@Localizer["Transmittal code"]</th><th>@Localizer["Employees"]</th><th>@Localizer["Documents"]</th><th>@Localizer["Active"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr class="@(d.IsActive ? "" : "text-muted")">
                    <td colspan="7" class="p-1">
                        <form asp-action="EditDiscipline" method="post" class="row g-1 align-items-center">
                            <input type="hidden" name="disciplineId" value="@d.DisciplineId" />
                            <div class="col-md-1"><input name="code" value="@d.Code" class="form-control form-control-sm" maxlength="20" required aria-label="@Localizer["Code"]" /></div>
                            <div class="col-md-3"><input name="name" value="@d.Name" class="form-control form-control-sm" maxlength="150" required aria-label="@Localizer["Name"]" /></div>
                            <div class="col-md-3"><input name="description" value="@d.Description" class="form-control form-control-sm" aria-label="@Localizer["Description"]" /></div>
                            <div class="col-md-2"><input name="importAliases" value="@d.ImportAliases" class="form-control form-control-sm" aria-label="@Localizer["Import aliases"]" /></div>
                            <div class="col-md-1"><input name="transmittalCode" value="@d.TransmittalCode" class="form-control form-control-sm" maxlength="1" aria-label="@Localizer["Transmittal code"]" /></div>
                            <div class="col-md-1"><span class="badge bg-secondary">@d.EmployeeCount</span> <span class="badge bg-secondary">@d.DocumentCount</span></div>
                            <div class="col-md-1"><button class="btn btn-sm btn-outline-secondary" title="@Localizer["Save"]" aria-label="@Localizer["Save"]"><i class="bi bi-save"></i></button></div>
                        </form>
                    </td>
                    <td colspan="2" class="text-end">
                        <form asp-action="SetDisciplineActive" method="post" class="d-inline">
                            <input type="hidden" name="disciplineId" value="@d.DisciplineId" /><input type="hidden" name="isActive" value="@((!d.IsActive).ToString().ToLowerInvariant())" />
                            <button class="btn btn-sm @(d.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(d.IsActive ? Localizer["Deactivate"] : Localizer["Reactivate"])</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="text-muted text-center py-3">@Localizer["No disciplines configured yet."]</p> }
    </div>
</div>
