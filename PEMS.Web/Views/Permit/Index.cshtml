@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.PermitListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var status = (string?)ViewBag.SelectedStatus;
    var pendingMyApproval = (bool)ViewBag.PendingMyApproval;
    var pendingTasksByPermitId = pendingMyApproval
        ? (Dictionary<int, PEMS.WorkflowPlatform.Dtos.PendingTaskDto>)ViewBag.PendingTasksByPermitId
        : null;
    var statuses = new[] { "Draft", "Submitted", "UnderReview", "Approved", "Issued", "Active", "Suspended", "Closed", "Cancelled", "Rejected", "Revoked" };
    var filterCount = (string.IsNullOrEmpty(status) ? 0 : 1) + (pendingMyApproval ? 1 : 0);
    bool? pending = pendingMyApproval ? true : null;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(status)) qsParts.Add($"status={Uri.EscapeDataString(status)}");
    if (pendingMyApproval) qsParts.Add("pendingMyApproval=true");

    string StatusText(string? s) => VdrUi.Loc(Localizer, "Pt_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Active" => "vs-pill--success",
        "Closed" => "vs-pill--neutral",
        "Rejected" or "Cancelled" or "Revoked" => "vs-pill--danger",
        "Suspended" => "vs-pill--warning",
        "Approved" or "Issued" => "vs-pill--current",
        _ => "vs-pill--info"
    };
    string WaitingSince(DateTime since)
    {
        var span = DateTime.Now - since;
        if (span.TotalDays >= 1) return string.Format(Localizer["Pt_WaitingDays"].Value, (int)span.TotalDays, span.Hours);
        if (span.TotalHours >= 1) return string.Format(Localizer["Pt_WaitingHours"].Value, (int)span.TotalHours, span.Minutes);
        return Localizer["Pt_WaitingUnderHour"].Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2: built from the PEMS.UI list-page component. The status button row became the status filter plus the
   "pending my approval" switch (which keeps its own columns: current stage and waiting since). The lifecycle note became
   the tool tip of the title. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Pt_Title"]" heading-title="@Localizer["Pt_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="ptFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <div>
                        <label class="lp-lbl" for="ptFilterStatus">@Localizer["Ed_Status"]</label>
                        <select id="ptFilterStatus" name="status" class="form-select form-select-sm">
                            <option value="">@Localizer["Ed_All"]</option>
                            @foreach (var s in statuses)
                            { <option value="@s" selected="@(s == status)">@StatusText(s)</option> }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" name="pendingMyApproval" value="true" id="ptPendingMine" checked="@pendingMyApproval" />
                        <label class="form-check-label small" for="ptPendingMine">@Localizer["Pt_PendingMine"]</label>
                    </div>
                </pems-list-filters>
                <pems-list-reset-columns grid-key="Permit" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["Pt_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(status))
            { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index", new { pendingMyApproval = pending })" /> }
            @if (pendingMyApproval)
            { <pems-list-chip label="@Localizer["Pt_PendingMine"]" remove-href="@Url.Action("Index", new { status })" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="Permit" empty="@(!Model.Items.Any())" empty-text="@(pendingMyApproval ? Localizer["Pt_EmptyPending"] : Localizer["Pt_Empty"])"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <thead>
                    <tr>
                        <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Pt_Number"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Cm_Type"]</th>
                        <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="360" style="width:220px">@Localizer["Cm_Title"]</th>
                        <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px">@Localizer["Equipment"]</th>
                        <th data-col-key="workOrder" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Cm_LinkedWo"]</th>
                        <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Cm_Priority"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160" style="width:120px">@Localizer["Ed_Status"]</th>
                        @if (pendingMyApproval)
                        {
                            <th data-col-key="stage" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Pt_CurrentStage"]</th>
                            <th data-col-key="waitingSince" data-resizable="true" data-min-width="140" data-max-width="260" style="width:200px">@Localizer["Pt_WaitingSince"]</th>
                        }
                        else
                        {
                            <th data-col-key="issuer" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Pt_Issuer"]</th>
                            <th data-col-key="receiver" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["Pt_Receiver"]</th>
                            <th data-col-key="valid" data-resizable="true" data-min-width="140" data-max-width="260" style="width:190px">@Localizer["Pt_Valid"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no"><a asp-action="Details" asp-route-id="@p.PermitId" class="lp-subject" title="@p.PermitNumber">@p.PermitNumber</a></td>
                            <td class="small">@p.PermitType</td>
                            <td><span class="vs-title-cell" title="@p.Title">@p.Title</span></td>
                            <td class="small"><span class="vs-num">@(p.EquipmentTagNumber ?? "-")</span></td>
                            <td class="small vs-hide-md"><span class="vs-num">@(p.WorkOrderNumber ?? "-")</span></td>
                            <td class="small">@VdrUi.Loc(Localizer, "Pri_", p.Priority)</td>
                            <td><span class="vs-pill @StatusTone(p.Status)">@StatusText(p.Status)</span></td>
                            @if (pendingMyApproval)
                            {
                                var task = pendingTasksByPermitId != null && pendingTasksByPermitId.TryGetValue(p.PermitId, out var t) ? t : null;
                                <td class="small">@(task?.StageName ?? "-")</td>
                                <td class="small">
                                    @if (task != null)
                                    {
                                        <span class="vs-num">@task.AssignedDate.ToString("yyyy-MM-dd HH:mm")</span> <span class="text-muted">(@WaitingSince(task.AssignedDate))</span>
                                    }
                                    else { <text>-</text> }
                                </td>
                            }
                            else
                            {
                                <td class="small vs-hide-md">@(p.IssuerName ?? "-")</td>
                                <td class="small vs-hide-md">@(p.ReceiverName ?? "-")</td>
                                <td class="small"><span class="vs-num">@(p.ValidFrom?.ToString("yyyy-MM-dd") ?? "-") / @(p.ValidTo?.ToString("yyyy-MM-dd") ?? "-")</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "Permit",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
