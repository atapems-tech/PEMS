@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.PermitListDto>
@{
    var pendingMyApproval = (bool)ViewBag.PendingMyApproval;
    var pendingTasksByPermitId = pendingMyApproval
        ? (Dictionary<int, PEMS.WorkflowPlatform.Dtos.PendingTaskDto>)ViewBag.PendingTasksByPermitId
        : null;
    string WaitingSince(DateTime since)
    {
        var span = DateTime.Now - since;
        if (span.TotalDays >= 1) return $"waiting {(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"waiting {(int)span.TotalHours}h {span.Minutes}m";
        return "waiting <1h";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Permits</h5>
    <a asp-action="Create" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New Permit</a>
</div>
<p class="text-muted small">
    طبق CMMS-10a Execution Baseline: Core Permit Lifecycle -
    Draft → Submitted → UnderReview → Approved → Issued → Active → Suspended/Closed.
    Approval Matrix، LOTO/Gas Test/SIMOPS و Execution Gate در صفحه‌ی Details هر Permit فعال هستند.
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="btn-group btn-group-sm flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == null && !pendingMyApproval ? "active" : "")">All</a>
        @foreach (var s in new[] { "Draft", "Submitted", "UnderReview", "Approved", "Issued", "Active", "Suspended", "Closed", "Cancelled", "Rejected", "Revoked" })
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-outline-secondary @(ViewBag.SelectedStatus == s && !pendingMyApproval ? "active" : "")">@s</a>
        }
        <a asp-action="Index" asp-route-pendingMyApproval="true" class="btn btn-outline-danger @(pendingMyApproval ? "active" : "")">
            <i class="bi bi-person-check"></i> Pending My Approval
        </a>
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('Permit')">
            <i class="bi bi-arrow-counterclockwise"></i> Reset columns
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="Permit">
        <thead>
            <tr>
                <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200">Number</th>
                <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="160">Type</th>
                <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="360">Title</th>
                <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="200">Equipment</th>
                <th data-col-key="workOrder" data-resizable="true" data-min-width="100" data-max-width="200">Work Order</th>
                <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="140">Priority</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">Status</th>
                @if (pendingMyApproval)
                {
                    <th data-col-key="stage" data-resizable="true" data-min-width="100" data-max-width="220">Current Stage</th>
                    <th data-col-key="waitingSince" data-resizable="true" data-min-width="140" data-max-width="260">Waiting Since</th>
                }
                else
                {
                    <th data-col-key="issuer" data-resizable="true" data-min-width="100" data-max-width="220">Issuer</th>
                    <th data-col-key="receiver" data-resizable="true" data-min-width="100" data-max-width="220">Receiver</th>
                    <th data-col-key="valid" data-resizable="true" data-min-width="140" data-max-width="260">Valid</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                var badgeClass = p.Status switch
                {
                    "Active" => "bg-success",
                    "Closed" => "bg-secondary",
                    "Rejected" or "Cancelled" or "Revoked" => "bg-danger",
                    "Suspended" => "bg-warning text-dark",
                    "Approved" or "Issued" => "bg-info text-dark",
                    _ => "bg-primary"
                };
                <tr>
                    <td class="small fw-bold"><a asp-action="Details" asp-route-id="@p.PermitId">@p.PermitNumber</a></td>
                    <td class="small">@p.PermitType</td>
                    <td class="small">@p.Title</td>
                    <td class="small">@(p.EquipmentTagNumber ?? "-")</td>
                    <td class="small">@(p.WorkOrderNumber ?? "-")</td>
                    <td class="small">@p.Priority</td>
                    <td><span class="badge @badgeClass">@p.Status</span></td>
                    @if (pendingMyApproval)
                    {
                        var task = pendingTasksByPermitId != null && pendingTasksByPermitId.TryGetValue(p.PermitId, out var t) ? t : null;
                        <td class="small">@(task?.StageName ?? "-")</td>
                        <td class="small">
                            @if (task != null)
                            {
                                <text>@task.AssignedDate.ToString("yyyy-MM-dd HH:mm") <span class="text-muted">(@WaitingSince(task.AssignedDate))</span></text>
                            }
                            else { <text>-</text> }
                        </td>
                    }
                    else
                    {
                        <td class="small">@(p.IssuerName ?? "-")</td>
                        <td class="small">@(p.ReceiverName ?? "-")</td>
                        <td class="small">@(p.ValidFrom?.ToString("yyyy-MM-dd") ?? "-") / @(p.ValidTo?.ToString("yyyy-MM-dd") ?? "-")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any())
    {
        <p class="text-muted text-center py-4 mb-0">
            @(pendingMyApproval ? "No Permits are currently waiting for your approval." : "هنوز Permit ای ثبت نشده.")
        </p>
    }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (pendingMyApproval) qsParts.Add("pendingMyApproval=true");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Permit",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('Permit');
        });
    </script>
}
