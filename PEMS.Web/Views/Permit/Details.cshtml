@model PEMS.Application.DTOs.PermitDetailDto
@using PEMS.WorkflowPlatform.Dtos
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var nextStatus = (string?)ViewBag.NextStatus;
    var approvalInstance = (WorkflowInstanceDto?)ViewBag.ApprovalInstance;
    var approvalHistory = (IReadOnlyList<WorkflowHistoryDto>?)ViewBag.ApprovalHistory;
    var currentUserRoles = ((IEnumerable<string>)ViewBag.CurrentUserRoles).ToList();
    var isolationPoints = (List<PEMS.Application.DTOs.IsolationPointListDto>)ViewBag.IsolationPoints;
    var isolationEnergyTypes = PEMS.Persistence.Services.IsolationService.ValidEnergyTypes;
    var gasTests = (List<PEMS.Application.DTOs.GasTestListDto>)ViewBag.GasTests;
    var gasRequiredParameters = PEMS.Persistence.Services.GasTestService.RequiredParameters;
    var simopsCandidates = (List<PEMS.Application.DTOs.SimopsCandidateDto>)ViewBag.SimopsCandidates;
    var simopsCandidateWorkOrders = (List<PEMS.Application.DTOs.SimopsCandidateWorkOrderDto>)ViewBag.SimopsCandidateWorkOrders;
    var simopsConflicts = (List<PEMS.Application.DTOs.SimopsConflictListDto>)ViewBag.SimopsConflicts;
    bool RoleMatchesMe(string? assignedToRole) =>
        assignedToRole != null && assignedToRole.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(currentUserRoles.Contains);
    string WaitingSince(DateTime since)
    {
        var span = DateTime.Now - since;
        if (span.TotalDays >= 1) return $"waiting {(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"waiting {(int)span.TotalHours}h {span.Minutes}m";
        return "waiting <1h";
    }

    var badgeClass = Model.Status switch
    {
        "Active" => "success",
        "Closed" => "neutral",
        "Rejected" or "Cancelled" or "Revoked" => "danger",
        "Suspended" => "warning",
        "Approved" or "Issued" => "info",
        _ => "primary"
    };

    // طبق PEMS-UI-01 (UI01-003): یک‌بار خوانده می‌شوند تا هم در بنر بالای صفحه (fallback عمومی)
    // و هم درون کارت مربوطه (وقتی ErrorArea مشخص شده) قابل استفاده باشند.
    var pageMessage = TempData["Message"] as string;
    var pageError = TempData["Error"] as string;
    var errorArea = TempData["ErrorArea"] as string;
    var passkeyMissingMarker = "هیچ Passkey";

    var eg = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.ExecutionGate;
    var approveElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.ApproveEligibility;
    var rejectElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.RejectEligibility;
    var closeElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.CloseEligibility;
    var lotoVerifyElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.LotoVerifyEligibility;
    var simopsConfirmElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.SimopsConfirmEligibility;
    var simopsResolveElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.SimopsResolveEligibility;
    var simopsAcceptRiskElig = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.SimopsAcceptRiskEligibility;

    // طبق PEMS-UI-01 (UI01-006، نسخه‌ی سبک): به‌جای چیدمان مجدد کل کارت‌ها، یک خلاصه‌ی کوتاه
    // «چه چیزی نیاز به اقدام شما دارد» با لینک لنگر به کارت مربوطه - داده‌اش از همون
    // ViewBag/متغیرهای محلی موجود است، بدون Query جدید.
    var actionItems = new List<(string Text, string Anchor)>();
    if (approvalInstance is { Status: "Running" } && approvalInstance.PendingStages.Any(p => RoleMatchesMe(p.AssignedToRole)))
    {
        actionItems.Add(("Approval decision pending your review", "#approval"));
    }
    var awaitingVerify = isolationPoints.Count(p => p.Status == "Isolated");
    if (awaitingVerify > 0) { actionItems.Add(($"{awaitingVerify} isolation point(s) awaiting Verify", "#loto")); }
    var awaitingConfirm = simopsConflicts.Count(c => c.Status == "Potential");
    if (awaitingConfirm > 0) { actionItems.Add(($"{awaitingConfirm} SIMOPS conflict(s) awaiting Confirm", "#simops")); }
    var awaitingResolve = simopsConflicts.Count(c => c.Status == "Confirmed");
    if (awaitingResolve > 0) { actionItems.Add(($"{awaitingResolve} SIMOPS conflict(s) awaiting Resolve", "#simops")); }
    if (eg is { Result: "Eligible" }) { actionItems.Add(("Execution Gate is ready - Start Work available", "#executiongate")); }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="3" wrap="true" css="mb-2">
        <div class="kpi-icon bg-icon-blue pems-s-792bd2d6"><pems-icon name="bi-shield-check" /></div>
        <div>
            <h5 class="mb-0">@Model.PermitNumber &mdash; @Model.Title <pems-badge tone="@badgeClass">@Model.Status</pems-badge></h5>
            <span class="text-muted small">@Model.PermitType - Requested by @Model.RequestedByName on @Model.CreatedDate.ToString("yyyy-MM-dd")</span>
        </div>
    </pems-flex>
    <pems-info-grid class="mt-2">
        <pems-info-item label="@Localizer["Equipment"]" num>@Model.EquipmentTagNumber</pems-info-item>
        <pems-info-item label="@Localizer["Functional Location"]">@Model.FunctionalLocationBreadcrumb</pems-info-item>
        <pems-info-item label="@Localizer["Work Order"]" num>@if (Model.WorkOrderId.HasValue) { <a asp-controller="WorkOrder" asp-action="Details" asp-route-id="@Model.WorkOrderId">@Model.WorkOrderNumber</a> }</pems-info-item>
        <pems-info-item label="@Localizer["Priority"]">@Model.Priority</pems-info-item>
        <pems-info-item label="@Localizer["Info_PermitIssuer"]">@Model.IssuerName</pems-info-item>
        <pems-info-item label="@Localizer["Info_PermitReceiver"]">
            @Model.ReceiverName
            @if (!string.IsNullOrWhiteSpace(Model.ReceiverPersonnelType) && Model.ReceiverPersonnelType != "Internal")
            {
                <pems-badge tone="light">@Model.ReceiverPersonnelType @(Model.ReceiverVendorName != null ? $"- {Model.ReceiverVendorName}" : "")</pems-badge>
            }
        </pems-info-item>
        <pems-info-item label="@Localizer["Info_ValidFrom"]" num>@Model.ValidFrom?.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Info_ValidTo"]" num>@Model.ValidTo?.ToString("yyyy-MM-dd")</pems-info-item>
        <pems-info-item label="@Localizer["Description"]" wide>@Model.Description</pems-info-item>
    </pems-info-grid>

    @if (Model.Status == "Cancelled" && !string.IsNullOrWhiteSpace(Model.CancellationReason))
    {
        <pems-alert tone="secondary" css="py-2 px-3 small mt-2 mb-0"><strong>Cancellation Reason:</strong> @Model.CancellationReason</pems-alert>
    }
    @if (Model.Status == "Revoked" && !string.IsNullOrWhiteSpace(Model.RevocationReason))
    {
        <pems-alert tone="danger" css="py-2 px-3 small mt-2 mb-0"><strong>Revocation Reason:</strong> @Model.RevocationReason</pems-alert>
    }
    @if (Model.ClosedDate.HasValue)
    {
        <pems-alert tone="success" css="py-2 px-3 small mt-2 mb-0">Closed on @Model.ClosedDate.Value.ToString("yyyy-MM-dd HH:mm")</pems-alert>
    }
</pems-content-card>

@if (actionItems.Any())
{
    <pems-content-card css="mb-3 border-start border-4 border-warning">
        <h6 class="mb-2"><pems-icon name="bi-exclamation-circle" css="text-warning" /> Action Required</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var item in actionItems)
            {
                <li class="py-1"><a href="@item.Anchor">@item.Text</a></li>
            }
        </ul>
    </pems-content-card>
}

@* طبق UI01-003: بنر عمومی فقط وقتی نمایش داده می‌شود که ErrorArea تعیین نشده باشد - در غیر این
   صورت پیام همان‌جایی که اقدام مربوطه انجام شد نمایش داده می‌شود (پایین‌تر در این فایل). *@
@if (pageMessage != null && errorArea == null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@pageMessage</pems-alert>
}
@if (pageError != null && errorArea == null)
{
    @if (pageError.Contains(passkeyMissingMarker))
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
    }
    else
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@pageError</pems-alert>
    }
}

<pems-content-card css="mb-3" id="actions">
    <h6 class="mb-3">@Localizer["Actions"]</h6>
    @if (errorArea == "Actions" && (pageMessage != null || pageError != null))
    {
        @if (pageError != null && pageError.Contains(passkeyMissingMarker))
        {
            <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
        }
        else
        {
            <pems-alert tone="@(pageError != null ? "danger" : "success")" css="py-2 px-3 small">@(pageError ?? pageMessage)</pems-alert>
        }
    }
    @if (closeElig != null && closeElig.Result != "Eligible")
    {
        <div class="mb-2">
            <pems-badge tone="danger">Not Eligible to Close</pems-badge>
            <ul class="small text-muted mb-0 mt-1">
                @foreach (var c in closeElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }
            </ul>
        </div>
    }
    <pems-flex wrap="true" gap="2">
        @if (nextStatus != null && nextStatus != "Active")
        {
            <pems-form asp-action="AdvanceStatus" method="post"><pems-flex gap="2">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-button tone="primary" size="small" type="submit">Advance to @nextStatus</pems-button>
            </pems-flex></pems-form>
        }
        @if (Model.Status == "Submitted" && approvalInstance == null)
        {
            <pems-form asp-action="SubmitForApproval" method="post"><pems-flex gap="2">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-signpost-split" /> Submit for Approval</pems-button>
            </pems-flex></pems-form>
        }
        @if (Model.Status == "Active")
        {
            <pems-form asp-action="Suspend" method="post"><pems-flex wrap="true" gap="2">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-input class="pems-minw-160 pems-maxw-280" scale="small" css="flex-grow-1" type="text" name="reason" placeholder="Suspend reason" />
                <pems-button tone="warning" size="small" outline="true" type="submit">Suspend</pems-button>
            </pems-flex></pems-form>
            <pems-form asp-action="Close" method="post">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-button tone="neutral" size="small" outline="true" type="button" disabled="@(closeElig != null && closeElig.Result != "Eligible")" data-pems-confirm="این Permit بسته شود؟" onclick="pemsSubmitWithStepUp(this)">Close</pems-button>
            </pems-form>
        }
        @if (Model.Status is "Draft" or "Submitted")
        {
            <pems-form asp-action="Cancel" method="post">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این Permit لغو شود؟">@Localizer["Cancel"]</pems-button>
            </pems-form>
        }
        @if (Model.Status is "Approved" or "Issued" or "Active")
        {
            <pems-form asp-action="Revoke" method="post"><pems-flex wrap="true" gap="2">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-input class="pems-minw-160 pems-maxw-280" scale="small" css="flex-grow-1" type="text" name="reason" placeholder="Revocation reason" />
                <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="این Permit ابطال شود؟">@Localizer["Revoke"]</pems-button>
            </pems-flex></pems-form>
        }
        @if (nextStatus == null && Model.Status is not ("Active" or "Draft" or "Submitted" or "Approved" or "Issued"))
        {
            <span class="text-muted small">@Localizer["No further actions available."]</span>
        }
    </pems-flex>
</pems-content-card>

@{
    var executionGate = (PEMS.Application.DTOs.ExecutionGateResultDto?)ViewBag.ExecutionGate;
    var executionGateDecisions = (List<PEMS.Application.DTOs.ExecutionGateDecisionDto>)ViewBag.ExecutionGateDecisions;
    bool canEmergencyOverride = ViewBag.CanEmergencyOverride;
}
@if (executionGate != null)
{
    var gateBadge = executionGate.Result == "Eligible" ? "success" : "danger";
    <pems-content-card css="mb-3" id="executiongate">
        <h6 class="mb-3">
            <pems-icon name="bi-door-open" /> Execution Gate
            <pems-badge tone="@gateBadge">@executionGate.Result.ToUpper()</pems-badge>
        </h6>
        @if (errorArea == "ExecutionGate" && pageError != null && pageError.Contains(passkeyMissingMarker))
        {
            <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
        }
        else if (errorArea == "ExecutionGate" && (pageMessage != null || pageError != null))
        {
            <pems-alert tone="@(pageError != null ? "danger" : "success")" css="py-2 px-3 small">@(pageError ?? pageMessage)</pems-alert>
        }
        <ul class="list-unstyled mb-2">
            @foreach (var c in executionGate.Checks)
            {
                <pems-flex as="li" align="center" gap="2" css="py-1">
                    @if (c.Passed) { <pems-icon name="bi-check-circle-fill" css="text-success" /> } else { <pems-icon name="bi-x-circle-fill" css="text-danger" /> }
                    <span class="small"><strong>[@c.Category]</strong> @c.Name — @c.Detail</span>
                </pems-flex>
            }
        </ul>
        @if (executionGate.AdvisoryNotes.Any())
        {
            <p class="small text-muted mb-2">Advisory (does not block):</p>
            <ul class="list-unstyled mb-2">
                @foreach (var a in executionGate.AdvisoryNotes)
                {
                    <pems-flex as="li" align="center" gap="2" css="py-1"><pems-icon name="bi-info-circle" css="text-warning" /> <span class="small">@a.Name — @a.Detail</span></pems-flex>
                }
            </ul>
        }
        <pems-flex gap="2" wrap="true" css="border-top pt-3">
            <pems-form asp-controller="ExecutionGate" asp-action="StartWork" method="post" class="d-inline">
                <input type="hidden" name="permitId" value="@Model.PermitId" />
                <pems-button tone="primary" size="small" type="button" disabled="@(executionGate.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this)">
                    <pems-icon name="bi-play-circle" /> Start Work
                </pems-button>
            </pems-form>
            @if (canEmergencyOverride)
            {
                <pems-form asp-controller="ExecutionGate" asp-action="EmergencyOverride" method="post"><pems-flex wrap="true" gap="2">
                    <input type="hidden" name="permitId" value="@Model.PermitId" />
                    <pems-input class="pems-minw-160 pems-maxw-280" scale="small" css="flex-grow-1" type="text" name="reason" placeholder="Emergency reason (required)" required />
                    <pems-button tone="danger" size="small" outline="true" type="button"
                            data-pems-confirm="Emergency Override یک اقدام واقعاً استثنایی است. مطمئن هستید؟" onclick="pemsSubmitWithStepUp(this)">
                        <pems-icon name="bi-exclamation-triangle" /> Emergency Override
                    </pems-button>
                </pems-flex></pems-form>
            }
        </pems-flex>
        @if (executionGateDecisions.Any())
        {
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["From"]</pems-table-header><pems-table-header>To</pems-table-header><pems-table-header>@Localizer["Result"]</pems-table-header><pems-table-header>By</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Emergency"]</pems-table-header><pems-table-header>@Localizer["Detail"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var d in executionGateDecisions)
                    {
                        <pems-table-row>
                            <pems-table-cell class="small">@d.FromStatus</pems-table-cell>
                            <pems-table-cell class="small">@d.ToStatus</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@(d.Result == "Eligible" ? "success" : "danger")">@d.Result</pems-badge></pems-table-cell>
                            <pems-table-cell class="small">@(d.ActorName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@d.DecisionDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                            <pems-table-cell>@(d.IsEmergencyOverride ? "Yes" : "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(d.IsEmergencyOverride ? d.EmergencyReason : d.BlockingReasonsSummary)</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
        }
    </pems-content-card>
}

@if (approvalInstance != null)
{
    <pems-content-card css="mb-3" id="approval">
        <h6 class="mb-3"><pems-icon name="bi-diagram-3" /> Approval Progress <pems-badge tone="@(approvalInstance.Status == "Completed" ? "success" : approvalInstance.Status == "Rejected" ? "danger" : "primary")">@approvalInstance.Status</pems-badge></h6>
        @if (errorArea == "Approval" && pageError != null && pageError.Contains(passkeyMissingMarker))
        {
            <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
        }
        else if (errorArea == "Approval" && (pageMessage != null || pageError != null))
        {
            <pems-alert tone="@(pageError != null ? "danger" : "success")" css="py-2 px-3 small">@(pageError ?? pageMessage)</pems-alert>
        }

        @{
            // ترتیب ثابت طبق PermitApprovalWorkflowSeeder (تنها WorkflowDefinition ماژول Permit):
            // HSEReview → MaintenanceApproval → OperationsApproval. "Permit Issuer" یک
            // RoleModuleAction جداست، نه مرحله‌ی چهارم این زنجیره - عمداً این‌جا نیست.
            var stageOrder = new[] { "HSEReview", "MaintenanceApproval", "OperationsApproval" };
            var completedStages = (approvalHistory ?? new List<WorkflowHistoryDto>())
                .Where(h => h.FromStageName != null && h.Decision != null)
                .ToList();
        }
        <ul class="list-unstyled mb-3">
            @foreach (var stageName in stageOrder)
            {
                var completedEntry = completedStages.FirstOrDefault(h => h.FromStageName == stageName);
                var isCurrent = approvalInstance.CurrentStageName == stageName;
                <pems-flex as="li" align="center" gap="2" css="py-1">
                    @if (completedEntry != null)
                    {
                        <pems-icon name="bi-check-circle-fill" css="text-success" />
                        <span>@stageName - <strong>@completedEntry.Decision</strong> @(completedEntry.Role != null ? $"({completedEntry.Role})" : "") @completedEntry.ActionDate.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    else if (isCurrent)
                    {
                        var stageWaitSince = approvalInstance.PendingStages.Any() ? approvalInstance.PendingStages.Min(p => p.AssignedDate) : (DateTime?)null;
                        <pems-icon name="bi-record-circle" css="text-primary" />
                        <span>@stageName - <span class="text-muted">در انتظار: @string.Join(" / ", approvalInstance.PendingStages.Select(p => p.AssignedToRole)) @(stageWaitSince.HasValue ? $"({WaitingSince(stageWaitSince.Value)})" : "")</span></span>
                    }
                    else
                    {
                        <pems-icon name="bi-circle" css="text-muted" />
                        <span class="text-muted">@stageName</span>
                    }
                </pems-flex>
            }
        </ul>

        @if (approvalInstance.Status == "Running" && approvalInstance.PendingStages.Any(p => RoleMatchesMe(p.AssignedToRole)))
        {
            @if ((approveElig != null && approveElig.Result != "Eligible") || (rejectElig != null && rejectElig.Result != "Eligible"))
            {
                <div class="border-top pt-3 mb-0">
                    @if (approveElig != null && approveElig.Result != "Eligible")
                    {
                        <div class="mb-1"><pems-badge tone="danger">Not Eligible to Approve</pems-badge>
                            <ul class="small text-muted mb-0 mt-1">@foreach (var c in approveElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
                        </div>
                    }
                    @if (rejectElig != null && rejectElig.Result != "Eligible")
                    {
                        <div class="mb-1"><pems-badge tone="danger">Not Eligible to Reject</pems-badge>
                            <ul class="small text-muted mb-0 mt-1">@foreach (var c in rejectElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
                        </div>
                    }
                </div>
            }
            <pems-form class="@(approveElig == null && rejectElig == null ? "border-top pt-3" : "")" asp-action="RespondApproval" method="post"><pems-flex wrap="true" gap="2" align="center">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-input class="pems-minw-160 pems-maxw-280" scale="small" css="flex-grow-1" type="text" name="comment" placeholder="@Localizer["Comment (optional)"]" />
                <pems-button tone="success" size="small" type="button" disabled="@(approveElig != null && approveElig.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this, 'decision', 'Approve')">Approve</pems-button>
                <pems-button tone="danger" size="small" outline="true" type="button" disabled="@(rejectElig != null && rejectElig.Result != "Eligible")" data-pems-confirm="این مرحله رد شود؟ کل زنجیره‌ی تایید با نتیجه‌ی Rejected بسته می‌شود." onclick="pemsSubmitWithStepUp(this, 'decision', 'Reject')">Reject</pems-button>
            </pems-flex></pems-form>
            <pems-form class="mt-2" asp-action="ReturnForRework" method="post"><pems-flex wrap="true" gap="2" align="center">
                <input type="hidden" name="id" value="@Model.PermitId" />
                <pems-input class="pems-minw-160 pems-maxw-280" scale="small" css="flex-grow-1" type="text" name="comment" placeholder="Rework instructions" />
                <pems-button tone="warning" size="small" outline="true" type="submit" data-pems-confirm="Permit برای اصلاح به Draft برگردد؟">Return for Rework</pems-button>
            </pems-flex></pems-form>
        }
        else if (approvalInstance.Status == "Running")
        {
            <p class="text-muted small mb-0">شما نقش لازم برای اقدام روی مرحله‌ی جاری این زنجیره را ندارید.</p>
        }

        @if (approvalHistory != null && approvalHistory.Any())
        {
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["From"]</pems-table-header><pems-table-header>To</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header><pems-table-header>By Role</pems-table-header><pems-table-header>@Localizer["Comment"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var h in approvalHistory.OrderByDescending(h => h.ActionDate))
                    {
                        <pems-table-row>
                            <pems-table-cell class="small">@(h.FromStageName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@(h.ToStageName ?? "-")</pems-table-cell>
                            <pems-table-cell class="small">@h.ActionType</pems-table-cell>
                            <pems-table-cell class="small">@(h.Role ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@h.Comment</pems-table-cell>
                            <pems-table-cell class="small">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
        }
    </pems-content-card>
}

@{
    var verifiedCount = isolationPoints.Count(p => p.Status is "Verified" or "Deisolated");
    var unverifiedCount = isolationPoints.Count(p => p.Status is "Requested" or "Isolated");
}
<pems-content-card css="mb-3" id="loto">
    <h6 class="mb-3">
        <pems-icon name="bi-lock" /> Isolation Points (LOTO)
        @if (isolationPoints.Any())
        {
            <pems-badge tone="@(unverifiedCount == 0 ? "success" : "warning")">@verifiedCount / @isolationPoints.Count Verified</pems-badge>
        }
    </h6>
    @if (errorArea == "LOTO" && pageError != null && pageError.Contains(passkeyMissingMarker))
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
    }
    else if (errorArea == "LOTO" && (pageMessage != null || pageError != null))
    {
        <pems-alert tone="@(pageError != null ? "danger" : "success")" css="py-2 px-3 small">@(pageError ?? pageMessage)</pems-alert>
    }
    @if (lotoVerifyElig != null && lotoVerifyElig.Result != "Eligible")
    {
        <div class="mb-2"><pems-badge tone="danger">Not Eligible to Verify</pems-badge>
            <ul class="small text-muted mb-0 mt-1">@foreach (var c in lotoVerifyElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
        </div>
    }

    <pems-related-table>
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Energy Type"]</pems-table-header><pems-table-header>@Localizer["Location"]</pems-table-header><pems-table-header>Lock/Tag</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>Isolated By</pems-table-header><pems-table-header>Verified By</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var p in isolationPoints)
            {
                var isoBadge = p.Status switch
                {
                    "Verified" => "success",
                    "Deisolated" => "neutral",
                    "Cancelled" => "danger",
                    "Isolated" => "warning",
                    _ => "primary"
                };
                <pems-table-row>
                    <pems-table-cell class="small">@p.EnergyType</pems-table-cell>
                    <pems-table-cell class="small">@p.Location @(p.EquipmentTagNumber != null ? $"({p.EquipmentTagNumber})" : "")</pems-table-cell>
                    <pems-table-cell class="small">@(p.LockNumber ?? "-") / @(p.TagNumber ?? "-")</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@isoBadge">@p.Status</pems-badge></pems-table-cell>
                    <pems-table-cell class="small">@(p.IsolatedByName ?? "-")</pems-table-cell>
                    <pems-table-cell class="small">@(p.VerifiedByName ?? "-")</pems-table-cell>
                    <pems-table-cell class="text-nowrap">
                        @if (p.Status == "Requested")
                        {
                            <pems-form asp-controller="Isolation" asp-action="MarkIsolated" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.IsolationPointId" />
                                <input type="hidden" name="permitId" value="@Model.PermitId" />
                                <pems-input class="pems-w-90" scale="small" css="d-inline-block" type="text" name="lockNumber" placeholder="Lock #" />
                                <pems-input class="pems-w-90" scale="small" css="d-inline-block" type="text" name="tagNumber" placeholder="Tag #" />
                                <pems-button tone="warning" size="small" outline="true" type="submit"><pems-icon name="bi-lock-fill" /> Isolate</pems-button>
                            </pems-form>
                            <pems-form asp-controller="Isolation" asp-action="Cancel" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.IsolationPointId" />
                                <input type="hidden" name="permitId" value="@Model.PermitId" />
                                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این نقطه لغو شود؟">@Localizer["Cancel"]</pems-button>
                            </pems-form>
                        }
                        @if (p.Status == "Isolated")
                        {
                            <pems-form asp-controller="Isolation" asp-action="Verify" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.IsolationPointId" />
                                <input type="hidden" name="permitId" value="@Model.PermitId" />
                                <pems-button tone="success" size="small" outline="true" type="button" disabled="@(lotoVerifyElig != null && lotoVerifyElig.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this)"><pems-icon name="bi-check-circle" /> Verify</pems-button>
                            </pems-form>
                        }
                        @if (p.Status == "Verified")
                        {
                            <pems-form asp-controller="Isolation" asp-action="Deisolate" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.IsolationPointId" />
                                <input type="hidden" name="permitId" value="@Model.PermitId" />
                                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این ایزوله‌سازی برداشته شود (De-isolation)؟">De-isolate</pems-button>
                            </pems-form>
                        }
                    </pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    @if (!isolationPoints.Any()) { <p class="text-muted small mb-3">هنوز هیچ نقطه‌ی ایزوله‌سازی‌ای ثبت نشده.</p> }

    @if (Model.Status is not ("Closed" or "Cancelled" or "Rejected" or "Revoked"))
    {
        <pems-form asp-controller="Isolation" asp-action="Create" method="post"><pems-row gap="2" css="align-items-end border-top pt-3">
            <input type="hidden" name="permitId" value="@Model.PermitId" />
            <pems-col md="2">
                <pems-label css="small">@Localizer["Energy Type"]</pems-label>
                <pems-select scale="small" name="energyType" required>
                    @foreach (var t in isolationEnergyTypes) { <option value="@t">@t</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-label css="small">@Localizer["Location"]</pems-label><pems-input scale="small" name="location" required /></pems-col>
            <pems-col md="2"><pems-label css="small">Normal State</pems-label><pems-input scale="small" name="normalState" /></pems-col>
            <pems-col md="2"><pems-label css="small">Required Isolation State</pems-label><pems-input scale="small" name="requiredIsolationState" /></pems-col>
            <pems-col md="2"><pems-label css="small">Method</pems-label><pems-input scale="small" name="isolationMethod" /></pems-col>
            <pems-col md="1"><pems-button tone="primary" size="small" css="w-100" type="submit">@Localizer["Add"]</pems-button></pems-col>
        </pems-row></pems-form>
    }
</pems-content-card>

@{
    var passedGasTests = gasTests.Count(g => g.Status == "Passed" && !g.IsExpired);
}
<pems-content-card css="mb-3">
    <h6 class="mb-3">
        <pems-icon name="bi-clouds" /> Gas Testing
        @if (gasTests.Any())
        {
            <pems-badge tone="@(passedGasTests > 0 ? "success" : "warning")">@passedGasTests / @gasTests.Count Valid</pems-badge>
        }
    </h6>

    @foreach (var g in gasTests)
    {
        var gasBadge = g.Status switch
        {
            "Passed" => g.IsExpired ? "neutral" : "success",
            "Failed" => "danger",
            "Invalidated" => "dark",
            _ => "primary"
        };
        var calBadge = g.InstrumentCalibrationStatus switch
        {
            "Overdue" => "danger",
            "DueSoon" => "warning",
            "OK" => "success",
            _ => "neutral"
        };
        <div class="border rounded p-2 mb-2">
            <pems-flex wrap="true" align="center" gap="2" css="mb-2">
                <pems-badge tone="@gasBadge">@g.Status</pems-badge>
                @if (g.IsExpired && g.Status != "Invalidated") { <pems-badge tone="neutral">Expired</pems-badge> }
                <span class="small">@g.Location</span>
                <span class="small text-muted">Tested by @(g.TesterName ?? "-") @g.TestedAt.ToString("yyyy-MM-dd HH:mm")</span>
                @if (g.ValidUntil.HasValue) { <span class="small text-muted">Valid Until @g.ValidUntil.Value.ToString("yyyy-MM-dd HH:mm")</span> }
                @if (!string.IsNullOrWhiteSpace(g.InstrumentTag))
                {
                    <span class="small text-muted">Instrument: @g.InstrumentTag <pems-badge tone="@calBadge">@g.InstrumentCalibrationStatus</pems-badge></span>
                }
            </pems-flex>
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>Parameter</pems-table-header><pems-table-header>@Localizer["Value"]</pems-table-header><pems-table-header>@Localizer["Unit"]</pems-table-header><pems-table-header>@Localizer["Result"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var r in g.Readings)
                    {
                        var resultBadge = r.Result switch { "Pass" => "success", "Fail" => "danger", _ => "neutral" };
                        <pems-table-row>
                            <pems-table-cell class="small">@r.Parameter</pems-table-cell>
                            <pems-table-cell class="small">@r.Value</pems-table-cell>
                            <pems-table-cell class="small">@r.Unit</pems-table-cell>
                            <pems-table-cell><pems-badge tone="@resultBadge">@r.Result</pems-badge></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
            @if (g.Status != "Invalidated")
            {
                @if (!string.IsNullOrWhiteSpace(g.InvalidationReason)) { <p class="small text-muted mb-2">Invalidation reason: @g.InvalidationReason</p> }
                <pems-form asp-controller="GasTest" asp-action="Invalidate" method="post"><pems-flex gap="2" align="center">
                    <input type="hidden" name="id" value="@g.GasTestId" />
                    <input type="hidden" name="permitId" value="@Model.PermitId" />
                    <pems-input class="pems-maxw-260" scale="small" type="text" name="reason" placeholder="Invalidation reason" required />
                    <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="این تست گاز باطل شود؟">Invalidate</pems-button>
                </pems-flex></pems-form>
            }
            else
            {
                <p class="small text-muted mb-0">Invalidated: @g.InvalidationReason</p>
            }
        </div>
    }
    @if (!gasTests.Any()) { <p class="text-muted small mb-3">هنوز هیچ تست گازی ثبت نشده.</p> }

    @if (Model.Status is not ("Closed" or "Cancelled" or "Rejected" or "Revoked"))
    {
        <pems-form asp-controller="GasTest" asp-action="Create" method="post"><pems-row gap="2" css="align-items-end border-top pt-3">
            <input type="hidden" name="permitId" value="@Model.PermitId" />
            <pems-col md="3"><pems-label css="small">@Localizer["Location"]</pems-label><pems-input scale="small" name="location" required /></pems-col>
            <pems-col md="2"><pems-label css="small">Tested At</pems-label><pems-input type="datetime-local" name="testedAt" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required scale="small" /></pems-col>
            <pems-col md="2"><pems-label css="small">Instrument Tag</pems-label><pems-input scale="small" name="instrumentTag" /></pems-col>
            <pems-col md="2"><pems-label css="small">Instrument Cal. Due</pems-label><pems-date name="instrumentCalibrationDueDate" scale="small" /></pems-col>
            @foreach (var p in gasRequiredParameters)
            {
                <input type="hidden" name="parameter" value="@p" />
                <pems-col md="1">
                    <pems-label css="small">@p</pems-label>
                    <pems-input scale="small" type="number" step="0.01" name="value" required />
                </pems-col>
                <input type="hidden" name="unit" value="@(p == "O2" ? "%VOL" : p == "LEL" ? "%LEL" : "PPM")" />
            }
            <pems-col md="1"><pems-label css="small">@Localizer["Other"]</pems-label><pems-input scale="small" type="number" step="0.01" name="otherValue" /></pems-col>
            <pems-col md="1"><pems-label css="small">@Localizer["Unit"]</pems-label><pems-input scale="small" type="text" name="otherUnit" placeholder="e.g. PPM" /></pems-col>
            <pems-col md="1"><pems-button tone="primary" size="small" css="w-100" type="submit">Record</pems-button></pems-col>
        </pems-row></pems-form>
    }
</pems-content-card>

@{
    var handoverBacklinks = (IEnumerable<dynamic>)ViewBag.HandoverBacklinks;
    var unresolvedSimopsCount = simopsConflicts.Count(c => c.Status is "Potential" or "Confirmed");
}
<pems-content-card css="mb-3" id="simops">
    <h6 class="mb-3">
        <pems-icon name="bi-arrows-angle-contract" /> SIMOPS
        @if (simopsConflicts.Any())
        {
            <pems-badge tone="@(unresolvedSimopsCount == 0 ? "success" : "warning")">@unresolvedSimopsCount unresolved</pems-badge>
        }
    </h6>
    @if (errorArea == "Simops" && pageError != null && pageError.Contains(passkeyMissingMarker))
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@pageError <a asp-controller="Account" asp-action="ManagePasskeys" class="alert-link">Manage Passkeys &rarr;</a></pems-alert>
    }
    else if (errorArea == "Simops" && (pageMessage != null || pageError != null))
    {
        <pems-alert tone="@(pageError != null ? "danger" : "success")" css="py-2 px-3 small">@(pageError ?? pageMessage)</pems-alert>
    }
    @if ((simopsConfirmElig != null && simopsConfirmElig.Result != "Eligible") || (simopsResolveElig != null && simopsResolveElig.Result != "Eligible") || (simopsAcceptRiskElig != null && simopsAcceptRiskElig.Result != "Eligible"))
    {
        <div class="mb-2">
            @if (simopsConfirmElig != null && simopsConfirmElig.Result != "Eligible")
            {
                <div class="mb-1"><pems-badge tone="danger">Not Eligible to Confirm</pems-badge>
                    <ul class="small text-muted mb-0 mt-1">@foreach (var c in simopsConfirmElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
                </div>
            }
            @if (simopsResolveElig != null && simopsResolveElig.Result != "Eligible")
            {
                <div class="mb-1"><pems-badge tone="danger">Not Eligible to Resolve</pems-badge>
                    <ul class="small text-muted mb-0 mt-1">@foreach (var c in simopsResolveElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
                </div>
            }
            @if (simopsAcceptRiskElig != null && simopsAcceptRiskElig.Result != "Eligible")
            {
                <div class="mb-1"><pems-badge tone="danger">Not Eligible to Accept Risk</pems-badge>
                    <ul class="small text-muted mb-0 mt-1">@foreach (var c in simopsAcceptRiskElig.Checks.Where(c => !c.Passed)) { <li>@c.Detail</li> }</ul>
                </div>
            }
        </div>
    }

    @if (simopsConflicts.Any())
    {
        <pems-related-table>
            <pems-table-head><pems-table-row><pems-table-header>Other Permit</pems-table-header><pems-table-header>@Localizer["Basis"]</pems-table-header><pems-table-header>@Localizer["Severity"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Detail"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var c in simopsConflicts)
                {
                    var otherPermitId = c.PermitAId == Model.PermitId ? c.PermitBId : c.PermitAId;
                    var otherPermitNumber = c.PermitAId == Model.PermitId ? c.PermitBNumber : c.PermitANumber;
                    var simopsBadge = c.Status switch
                    {
                        "Resolved" => "success",
                        "AcceptedRisk" => "neutral",
                        "Confirmed" => "warning",
                        _ => "danger"
                    };
                    var sevBadge = c.Severity switch { "High" => "danger", "Medium" => "warning", "Low" => "info", _ => "neutral" };
                    <pems-table-row>
                        <pems-table-cell class="small"><a asp-action="Details" asp-route-id="@otherPermitId">@otherPermitNumber</a></pems-table-cell>
                        <pems-table-cell class="small">@c.ConflictBasis</pems-table-cell>
                        <pems-table-cell><pems-badge tone="@sevBadge">@c.Severity</pems-badge></pems-table-cell>
                        <pems-table-cell><pems-badge tone="@simopsBadge">@c.Status</pems-badge></pems-table-cell>
                        <pems-table-cell class="small text-muted">
                            @if (c.Status == "Resolved") { <text>@c.ResolutionNotes</text> }
                            else if (c.Status == "AcceptedRisk") { <text>@c.AcceptanceJustification</text> }
                            else { <text>Raised by @c.RaisedByName</text> }
                        </pems-table-cell>
                        <pems-table-cell class="text-nowrap">
                            @if (c.Status == "Potential")
                            {
                                <pems-form asp-controller="Simops" asp-action="Confirm" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.SimopsConflictId" />
                                    <input type="hidden" name="permitId" value="@Model.PermitId" />
                                    <pems-button tone="warning" size="small" outline="true" type="button" disabled="@(simopsConfirmElig != null && simopsConfirmElig.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this)">Confirm</pems-button>
                                </pems-form>
                            }
                            @if (c.Status is "Potential" or "Confirmed")
                            {
                                <pems-form asp-controller="Simops" asp-action="AcceptRisk" method="post"><pems-flex inline="true" wrap="true" gap="1" align="center">
                                    <input type="hidden" name="id" value="@c.SimopsConflictId" />
                                    <input type="hidden" name="permitId" value="@Model.PermitId" />
                                    <pems-input class="pems-minw-110 pems-maxw-180" scale="small" type="text" name="justification" placeholder="Justification" required />
                                    <pems-button tone="neutral" size="small" outline="true" type="button" disabled="@(simopsAcceptRiskElig != null && simopsAcceptRiskElig.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this)">Accept Risk</pems-button>
                                </pems-flex></pems-form>
                            }
                            @if (c.Status == "Confirmed")
                            {
                                <pems-form asp-controller="Simops" asp-action="Resolve" method="post"><pems-flex inline="true" wrap="true" gap="1" align="center">
                                    <input type="hidden" name="id" value="@c.SimopsConflictId" />
                                    <input type="hidden" name="permitId" value="@Model.PermitId" />
                                    <pems-input class="pems-minw-110 pems-maxw-180" scale="small" type="text" name="resolutionNotes" placeholder="Resolution notes" required />
                                    <pems-button tone="success" size="small" outline="true" type="button" disabled="@(simopsResolveElig != null && simopsResolveElig.Result != "Eligible")" onclick="pemsSubmitWithStepUp(this)">Resolve</pems-button>
                                </pems-flex></pems-form>
                            }
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
    }

    @if (simopsCandidates.Any(x => x.ExistingConflictId == null))
    {
        <p class="small text-muted mb-1">Other active Permits sharing equipment/location:</p>
        <pems-related-table>
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Permit"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Basis"]</pems-table-header><pems-table-header>Time Overlap</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var cand in simopsCandidates.Where(x => x.ExistingConflictId == null))
                {
                    <pems-table-row>
                        <pems-table-cell class="small"><a asp-action="Details" asp-route-id="@cand.PermitId">@cand.PermitNumber</a> - @cand.Title</pems-table-cell>
                        <pems-table-cell class="small">@cand.PermitType</pems-table-cell>
                        <pems-table-cell class="small">@cand.MatchBasis</pems-table-cell>
                        <pems-table-cell class="small">@(!cand.TimeWindowKnown ? "Unknown" : cand.TimeOverlapConfirmed ? "Yes" : "No")</pems-table-cell>
                        <pems-table-cell>
                            <pems-form asp-controller="Simops" asp-action="Create" method="post" class="d-inline">
                                <input type="hidden" name="permitId" value="@Model.PermitId" />
                                <input type="hidden" name="otherPermitId" value="@cand.PermitId" />
                                <pems-button tone="danger" size="small" outline="true" type="submit">Raise Conflict</pems-button>
                            </pems-form>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
    }
    @if (simopsCandidateWorkOrders.Any())
    {
        <p class="small text-muted mb-1">Work Orders on this Equipment with no linked Permit (verify manually):</p>
        <ul class="small text-muted mb-0">
            @foreach (var wo in simopsCandidateWorkOrders)
            {
                <li>@wo.WorkOrderNumber (@wo.EquipmentTagNumber) — @wo.StartDate?.ToString("yyyy-MM-dd") to @(wo.CompletionDate?.ToString("yyyy-MM-dd") ?? "ongoing")</li>
            }
        </ul>
    }
    @if (!simopsConflicts.Any() && !simopsCandidates.Any() && !simopsCandidateWorkOrders.Any())
    {
        <p class="text-muted small mb-0">هیچ تعارض یا هم‌پوشانی احتمالی شناسایی نشد.</p>
    }

    @if (handoverBacklinks.Any())
    {
        <p class="small text-muted mt-2 mb-0">
            @foreach (var b in handoverBacklinks)
            {
                <span>Included in <a asp-controller="ShiftHandover" asp-action="Details" asp-route-id="@b.ShiftHandoverId">Handover #@b.ShiftHandoverId</a> (@b.Status)</span>
                <br />
            }
        </p>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Status History"]</h6>
    <pems-related-table>
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["From"]</pems-table-header><pems-table-header>To</pems-table-header><pems-table-header>By</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Reason"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var h in Model.StatusHistory)
            {
                <pems-table-row>
                    <pems-table-cell class="small">@h.FromStatus</pems-table-cell>
                    <pems-table-cell class="small">@h.ToStatus</pems-table-cell>
                    <pems-table-cell class="small">@(h.ChangedByName ?? "-")</pems-table-cell>
                    <pems-table-cell class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell class="small text-muted">@h.Reason</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    @if (!Model.StatusHistory.Any()) { <p class="text-muted text-center py-3 mb-0">@Localizer["هنوز تغییر وضعیتی ثبت نشده."]</p> }
</pems-content-card>

<script src="~/js/webauthn.js"></script>
