@model PEMS.Application.DTOs.LetterTemplateDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string? error = ViewBag.Error;
}

<div class="content-card" style="max-width:800px;">
    @if (!string.IsNullOrEmpty(error))
    {
        <pems-alert tone="danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @error</pems-alert>
    }
    <p class="text-muted small">@Localizer["LtT_PrefillNote"]</p>

    <details class="small mb-3">
        <summary>@Localizer["LtT_PlaceholdersTitle"]</summary>
        <p class="text-muted mt-2 mb-1">@Localizer["LtT_PlaceholdersHelp"]</p>
        <ul class="mb-1">
            @foreach (var token in PEMS.Application.Common.LetterTemplatePlaceholders.General)
            {
                <li><code dir="ltr">{{@token}}</code> - @Localizer["LtT_Token_" + token]</li>
            }
        </ul>
        <p class="text-muted mb-1">@Localizer["LtT_PlaceholdersReply"]</p>
        <ul class="mb-0">
            @foreach (var token in PEMS.Application.Common.LetterTemplatePlaceholders.Reply)
            {
                <li><code dir="ltr">{{@token}}</code> - @Localizer["LtT_Token_" + token]</li>
            }
        </ul>
    </details>

    <form asp-action="Save" method="post">
        <input type="hidden" name="LetterTemplateId" value="@Model.LetterTemplateId" />

        <div class="row g-3">
            <div class="col-md-8">
                <pems-label for="tplName">@Localizer["LtT_Name"]</pems-label>
                <pems-input name="Name" id="tplName" value="@Model.Name" maxlength="150" required />
            </div>
            <div class="col-md-4">
                <pems-label for="tplType">@Localizer["Type"]</pems-label>
                <pems-select name="LetterType" id="tplType">
                    <option value="" selected="@(Model.LetterType == null)">@Localizer["LtT_AllTypes"]</option>
                    @foreach (var type in new[] { "Incoming", "Outgoing", "Internal" })
                    {
                        <option value="@type" selected="@(Model.LetterType == type)">@type</option>
                    }
                </pems-select>
            </div>
            <div class="col-12">
                <pems-label for="tplSubject">@Localizer["Lt_Subject"]</pems-label>
                <pems-input name="Subject" id="tplSubject" value="@Model.Subject" maxlength="300" required />
            </div>
            <div class="col-12">
                <pems-label for="tplBodyEditor">@Localizer["Lt_Body"]</pems-label>
                <pems-textarea name="Body" id="tplBodyEditor" rows="8">@Model.Body</pems-textarea>
            </div>
            <div class="col-md-6">
                <pems-label for="tplPriority">@Localizer["Lt_Priority"]</pems-label>
                <pems-select name="Priority" id="tplPriority">
                    @foreach (var p in new[] { "Normal", "Low", "High", "Urgent" })
                    {
                        <option value="@p" selected="@(Model.Priority == p)">@Localizer["Lt_P_" + p]</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label for="tplConf">@Localizer["Lt_Confidentiality"]</pems-label>
                <pems-select name="ConfidentialityLevel" id="tplConf">
                    @foreach (var c in new[] { "Internal", "Public", "Confidential", "Restricted", "HighlyConfidential" })
                    {
                        <option value="@c" selected="@(Model.ConfidentialityLevel == c)">@c</option>
                    }
                </pems-select>
            </div>
        </div>

        <div class="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </div>
    </form>
</div>

@await Html.PartialAsync("_RichTextEditorScripts", "tplBodyEditor")
