<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5c1408ea-985c-4be8-9658-aad724c11fec</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Areas\Admin\Controllers\" />
    <Folder Include="Areas\Admin\Views\" />
    <Folder Include="Helpers\" />
    <Folder Include="Extensions\" />
    <Folder Include="Middleware\" />
    <Folder Include="Filters\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Views\Equipment\" />
    <Folder Include="Views\Document\" />
    <Folder Include="Views\User\" />
    <Folder Include="Views\Tag\" />
    <Folder Include="wwwroot\css\site\" />
    <Folder Include="wwwroot\css\themes\" />
    <Folder Include="wwwroot\js\common\" />
    <Folder Include="wwwroot\images\" />
    <Folder Include="wwwroot\DTOs\" />
    <Folder Include="wwwroot\js\site\" />
    <Folder Include="wwwroot\icons\" />
    <Folder Include="wwwroot\uploads\dwg\" />
    <Folder Include="wwwroot\uploads\excel\" />
    <Folder Include="wwwroot\uploads\images\" />
    <Folder Include="wwwroot\uploads\documents\" />
    <Folder Include="wwwroot\uploads\pdf\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Background Jobs: طبق سند - جایگزین Task.Run بدون Persistence/Retry برای پردازش AI -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />

    <!-- Structured Logging: طبق سند - جایگزین Logging پیش‌فرض برای عیب‌یابی و ممیزی بهتر در Production -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PEMS.AI\PEMS.AI.csproj" />
    <ProjectReference Include="..\PEMS.Application\PEMS.Application.csproj" />
    <ProjectReference Include="..\PEMS.Infrastructure\PEMS.Infrastructure.csproj" />
    <ProjectReference Include="..\PEMS.Licensing\PEMS.Licensing.csproj" />
    <ProjectReference Include="..\PEMS.Persistence\PEMS.Persistence.csproj" />
    <ProjectReference Include="..\PEMS.Migrations\PEMS.Migrations.csproj" />
    <ProjectReference Include="..\PEMS.Shared\PEMS.Shared.csproj" />
    <ProjectReference Include="..\PEMS.UI\PEMS.UI.csproj" />
    <ProjectReference Include="..\PEMS.WorkflowPlatform\PEMS.WorkflowPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- قالب چاپ فرم INWH-PLA-FO-001 (Rev.3) - داخل Assembly تا به مسیر Deploy وابسته نباشد -->
    <EmbeddedResource Include="Templates\PartCatalogue\INWH-PLA-FO-001.xlsx" LogicalName="PEMS.Templates.INWH-PLA-FO-001.xlsx" />
  </ItemGroup>

  <!-- Smaller deployment package (env publishes only: dotnet publish -p:PemsEnv=<name>): no debug symbols, and only the UI languages' satellite resources
       (the self-contained build otherwise ships ~14 MB of zh/ja/ko/... resource folders of third-party libraries). -->
  <PropertyGroup Condition="'$(PemsEnv)' != ''">
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Runtime user uploads are data, not part of a release: never ship whatever is in wwwroot/uploads on the build machine. -->
  <ItemGroup>
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The hosts run 64-bit Windows only: leave the x86 native libraries of Tesseract/SQL client out of an environment package. -->
  <Target Name="PemsPruneX86FromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PemsEnv)' != '' And '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_PemsX86 Include="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(RelativePath)').StartsWith('x86'))" />
      <ResolvedFileToPublish Remove="@(_PemsX86)" />
    </ItemGroup>
  </Target>


  <ItemGroup>
    <!-- Non-secret settings of ONE environment ship with a publish: dotnet publish -p:PemsEnv=demo (env/demo.env -> publish/env/).
         Secret files (env/*.secrets.env) are never packaged; they are placed on the server separately. -->
    <Content Include="..\env\$(PemsEnv).env" Link="env\$(PemsEnv).env" Condition="'$(PemsEnv)' != ''"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
