@model List<PEMS.Application.DTOs.RolePermissionDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var roles = (string[])ViewBag.Roles;
    var modules = (string[])ViewBag.Modules;
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>Configure module-level permissions. Changes are saved per role and module.</p></div>
        </div>
    </div>
    <div class="content-card">
        <div class="permission-intro"><i class="bi bi-info-circle me-1"></i> <strong>SystemAdmin</strong> has full access and is intentionally excluded. All other roles follow deny-by-default when no permission record exists.</div>
        <div class="permission-role-jump mb-3">
            @foreach (var role in roles.Where(r => r != "SystemAdmin"))
            {
                var count = Model.Count(x => x.RoleName == role && (x.CanView || x.CanCreate || x.CanEdit || x.CanDelete || x.CanApprove || x.CanManualNumber || x.CanFreeze || x.CanUnfreeze || x.CanHold || x.CanReleaseHold));
                <a href="#role-@role" class="badge text-decoration-none @(count == 0 ? "text-bg-secondary" : "text-bg-light border")">@role <span class="opacity-75">(@count)</span></a>
            }
        </div>
        @foreach (var role in roles.Where(r => r != "SystemAdmin"))
        {
            var configuredCount = Model.Count(x => x.RoleName == role && (x.CanView || x.CanCreate || x.CanEdit || x.CanDelete || x.CanApprove || x.CanManualNumber || x.CanFreeze || x.CanUnfreeze || x.CanHold || x.CanReleaseHold));
            <details class="permission-role" id="role-@role" open>
                <summary class="permission-role-title"><span><i class="bi bi-person-badge me-1"></i>@role</span><span class="text-body-secondary small">@(configuredCount == 0 ? Localizer["No permissions configured"] : $"{configuredCount}/{modules.Length} " + Localizer["modules configured"])</span></summary>
                <form asp-action="SetRole" method="post">
                    <input type="hidden" name="roleName" value="@role" />
                    <div class="permission-grid">
                        <table class="table table-enterprise">
                            <thead><tr><th>@Localizer["Module"]</th><th>@Localizer["View"]</th><th>@Localizer["Create"]</th><th>@Localizer["Edit"]</th><th>@Localizer["Delete"]</th><th>@Localizer["Approve"]</th><th>@Localizer["Manual #"]</th><th>@Localizer["Freeze"]</th><th>@Localizer["Unfreeze"]</th><th>@Localizer["Hold"]</th><th>@Localizer["Release Hold"]</th></tr></thead>
                            <tbody>
                            @for (int i = 0; i < modules.Length; i++)
                            {
                                var module = modules[i];
                                var existing = Model.FirstOrDefault(x => x.RoleName == role && x.ModuleName == module);
                                <tr>
                                    <td><span class="row-primary">@module</span><input type="hidden" name="permissions[@i].ModuleName" value="@module" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanView" value="true" checked="@(existing?.CanView ?? false)" aria-label="View @module" /><input type="hidden" name="permissions[@i].CanView" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanCreate" value="true" checked="@(existing?.CanCreate ?? false)" aria-label="Create @module" /><input type="hidden" name="permissions[@i].CanCreate" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanEdit" value="true" checked="@(existing?.CanEdit ?? false)" aria-label="Edit @module" /><input type="hidden" name="permissions[@i].CanEdit" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanDelete" value="true" checked="@(existing?.CanDelete ?? false)" aria-label="Delete @module" /><input type="hidden" name="permissions[@i].CanDelete" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanApprove" value="true" checked="@(existing?.CanApprove ?? false)" aria-label="Approve @module" /><input type="hidden" name="permissions[@i].CanApprove" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanManualNumber" value="true" checked="@(existing?.CanManualNumber ?? false)" aria-label="Manual numbering @module" /><input type="hidden" name="permissions[@i].CanManualNumber" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanFreeze" value="true" checked="@(existing?.CanFreeze ?? false)" aria-label="Freeze @module" /><input type="hidden" name="permissions[@i].CanFreeze" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanUnfreeze" value="true" checked="@(existing?.CanUnfreeze ?? false)" aria-label="Unfreeze @module" /><input type="hidden" name="permissions[@i].CanUnfreeze" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanHold" value="true" checked="@(existing?.CanHold ?? false)" aria-label="Hold @module" /><input type="hidden" name="permissions[@i].CanHold" value="false" /></td>
                                    <td><input class="form-check-input" type="checkbox" name="permissions[@i].CanReleaseHold" value="true" checked="@(existing?.CanReleaseHold ?? false)" aria-label="Release Hold @module" /><input type="hidden" name="permissions[@i].CanReleaseHold" value="false" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end mt-2">
                        <button type="submit" class="btn btn-sm btn-pems-solid permission-save"><i class="bi bi-check2 me-1"></i> @Localizer["Save"] @role @Localizer["permissions"]</button>
                    </div>
                </form>
            </details>
        }
        <div class="admin-footer mt-3"><span>&nbsp;</span><span>@(roles.Count(r => r != "SystemAdmin")) roles · @modules.Length modules</span></div>
    </div>
</div>
