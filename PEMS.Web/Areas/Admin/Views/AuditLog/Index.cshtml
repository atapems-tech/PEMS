@model PEMS.Application.DTOs.PagedResult<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var entityNames = (List<string>)ViewBag.EntityNames;
    var entity = (string?)ViewBag.SelectedEntityName;
    var user = (string?)ViewBag.SelectedUserName;
    var filterCount = (string.IsNullOrEmpty(entity) ? 0 : 1) + (string.IsNullOrEmpty(user) ? 0 : 1);
    string Query(string? skip)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(entity) && skip != "entity") parts.Add($"entityName={Uri.EscapeDataString(entity)}");
        if (!string.IsNullOrEmpty(user) && skip != "user") parts.Add($"userName={Uri.EscapeDataString(user)}");
        return string.Join("&", parts);
    }
    string Without(string key) { var s = Query(key); return Url.Action("Index") + (s.Length > 0 ? "?" + s : ""); }
    string ActionTone(string? a) => a switch { "Insert" => "vs-pill--success", "Delete" => "vs-pill--danger", _ => "vs-pill--info" };
    string ActionText(string? a) => VdrUi.Loc(Localizer, "AlL_Act_", a);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component; entity and user are filters with chips; paging keeps them. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["AlL_Title"]" heading-title="@Localizer["AlL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="alFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="alFilterEntity" name="entityName" label="@Localizer["AlL_Entity"]" value="@entity"
                                             all-text="@Localizer["AlL_AllEntities"]" items="@entityNames.Select(e => new SelectListItem(e, e))" />
                    <div>
                        <label class="lp-lbl" for="alFilterUser">@Localizer["AlL_User"]</label>
                        <input type="search" id="alFilterUser" name="userName" value="@user" class="form-control" placeholder="@Localizer["Username"]" />
                    </div>
                </pems-list-filters>
                <pems-list-reset-columns grid-key="AuditLogs" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(entity)) { <pems-list-chip label="@Localizer["AlL_Entity"]" value="@entity" remove-href="@Without("entity")" /> }
            @if (!string.IsNullOrEmpty(user)) { <pems-list-chip label="@Localizer["AlL_User"]" value="@user" remove-href="@Without("user")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="AuditLogs" empty="@(Model.Items.Count == 0)" empty-text="@Localizer["AlL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="time" data-resizable="true" data-min-width="130" data-max-width="220" style="width:160px">@Localizer["AlL_Time"]</th>
                        <th data-col-key="user" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["AlL_User"]</th>
                        <th data-col-key="entity" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["AlL_Entity"]</th>
                        <th data-col-key="key" data-resizable="true" data-min-width="80" data-max-width="200" style="width:110px" class="vs-hide-md">@Localizer["AlL_Key"]</th>
                        <th data-col-key="action" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Cm_Action"]</th>
                        <th data-col-key="changedFields" data-resizable="true" data-min-width="180" data-max-width="600">@Localizer["AlL_ChangedFields"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="small"><span class="vs-num">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span></td>
                            <td class="small"><span class="vs-cell-strong">@(log.UserName ?? "system")</span></td>
                            <td class="small" title="@log.EntityName">@log.EntityName</td>
                            <td class="small vs-hide-md"><span class="vs-num" title="@log.EntityKeyValue">@log.EntityKeyValue</span></td>
                            <td><span class="vs-pill @ActionTone(log.Action)">@ActionText(log.Action)</span></td>
                            <td class="small text-muted"><span class="vs-title-cell" title="@log.ChangedFieldsSummary">@log.ChangedFieldsSummary</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "AuditLogs",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
