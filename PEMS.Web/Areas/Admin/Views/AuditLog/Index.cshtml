@model PEMS.Application.DTOs.PagedResult<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var entityNames = (List<string>)ViewBag.EntityNames;
    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedEntityName)) qsParts.Add($"entityName={Uri.EscapeDataString((string)ViewBag.SelectedEntityName)}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedUserName)) qsParts.Add($"userName={Uri.EscapeDataString((string)ViewBag.SelectedUserName)}");
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3"><div><p>Trace administrative changes with user, entity, action and timestamp context.</p></div></div>
    </div>
    <div class="content-card">
        <form method="get" class="admin-toolbar">
            <div class="admin-toolbar-main">
                <div><label class="form-label small mb-1">@Localizer["Entity"]</label><select name="entityName" class="form-select form-select-sm"><option value="">@Localizer["All entities"]</option>@foreach(var e in entityNames){<option value="@e" selected="@(e == (string?)ViewBag.SelectedEntityName)">@e</option>}</select></div>
                <div><label class="form-label small mb-1">@Localizer["User"]</label><input type="search" name="userName" value="@ViewBag.SelectedUserName" class="form-control form-control-sm" placeholder="@Localizer["Username"]" /></div>
            </div>
            <div class="admin-toolbar-actions">
                <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-funnel me-1"></i> @Localizer["Apply filters"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Reset"]</a>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="PemsDataGrid.resetColumns('AuditLogs')"><i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]</button>
            </div>
        </form>
        <div class="table-responsive pems-grid-scroll">
            <table class="table table-enterprise pems-grid-table" data-grid-key="AuditLogs">
                <thead>
                    <tr>
                        <th data-col-key="time" data-resizable="true" data-min-width="130" data-max-width="220" style="width:160px">@Localizer["Time"]</th>
                        <th data-col-key="user" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["User"]</th>
                        <th data-col-key="entity" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Entity"]</th>
                        <th data-col-key="key" data-resizable="true" data-min-width="80" data-max-width="200" style="width:120px">Key</th>
                        <th data-col-key="action" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px">@Localizer["Action"]</th>
                        <th data-col-key="changedFields" data-resizable="true" data-min-width="180" data-max-width="500" style="width:400px">@Localizer["Changed Fields"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Items)
                    {
                        var ab = log.Action switch { "Insert" => "active", "Delete" => "locked", _ => "inactive" };
                        <tr>
                            <td class="row-secondary">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="row-primary" title="@(log.UserName ?? "system")">@(log.UserName ?? "system")</td>
                            <td title="@log.EntityName">@log.EntityName</td>
                            <td class="row-secondary" title="@log.EntityKeyValue">@log.EntityKeyValue</td>
                            <td><span class="admin-status @ab">@log.Action</span></td>
                            <td class="row-secondary" title="@log.ChangedFieldsSummary">@log.ChangedFieldsSummary</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Items.Count == 0) { <div class="admin-empty"><i class="bi bi-journal-check"></i><strong>No audit entries found</strong><div>Try changing the filters or date range.</div></div> }
        </div>
        @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            PageSize = Model.PageSize,
            GridKey = "AuditLogs",
            BaseUrl = Url.Action("Index") ?? "",
            ExistingQueryString = string.Join("&", qsParts)
        })
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('AuditLogs');
        });
    </script>
}
