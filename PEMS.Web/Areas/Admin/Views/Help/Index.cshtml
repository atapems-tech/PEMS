@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["HidePageTitle"] = true;
    var articles = (IReadOnlyList<PEMS.Application.DTOs.HelpArticleSummaryDto>)ViewBag.Articles;
    var categories = (IEnumerable<dynamic>)ViewBag.Categories;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-life-preserver"></i> @Localizer["Help Administration"]</h5>
        <a asp-action="Create" class="btn btn-sm btn-pems-solid"><i class="bi bi-plus-lg"></i> @Localizer["New Article"]</a>
    </div>
    <form method="get" class="row g-2 mt-2">
        <div class="col-md-3">
            <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">@Localizer["All Categories"]</option>
                @foreach (var c in categories) { <option value="@c.HelpCategoryId" selected="@(c.HelpCategoryId == (int?)ViewBag.SelectedCategoryId)">@c.NameEn</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="isPublished" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">@Localizer["All statuses"]</option>
                <option value="true" selected="@((bool?)ViewBag.SelectedIsPublished == true)">Published</option>
                <option value="false" selected="@((bool?)ViewBag.SelectedIsPublished == false)">Draft</option>
            </select>
        </div>
    </form>
</div>

<div class="content-card">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Category"]</th><th>@Localizer["Type"]</th><th>@Localizer["Title (EN)"]</th><th>@Localizer["Help Key"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in articles)
            {
                <tr>
                    <td class="small font-monospace">@a.Code</td>
                    <td class="small">@a.CategoryName</td>
                    <td><span class="badge bg-light text-dark border">@a.ArticleType</span></td>
                    <td><a asp-action="Edit" asp-route-id="@a.HelpArticleId">@a.Title</a></td>
                    <td class="small text-muted">@(a.HelpKey ?? "—")</td>
                    <td><span class="badge @(a.IsPublished ? "bg-success" : "bg-secondary")">@(a.IsPublished ? "Published" : "Draft")</span></td>
                    <td class="text-end">
                        <form asp-action="SetPublished" asp-route-id="@a.HelpArticleId" method="post" class="d-inline">
                            <input type="hidden" name="isPublished" value="@(!a.IsPublished)" />
                            <button type="submit" class="btn btn-sm btn-outline-@(a.IsPublished ? "secondary" : "success")">
                                @(a.IsPublished ? "Unpublish" : "Publish")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@a.HelpArticleId" method="post" class="d-inline" onsubmit="return confirm('Delete this Help article permanently?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!articles.Any()) { <p class="text-muted text-center py-4">No Help articles match this filter.</p> }
</div>
