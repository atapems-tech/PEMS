@model IReadOnlyList<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<pems-content-card>
    <pems-flex justify="between" align="center" css="mb-3">
        <pems-heading level="5" class="mb-0"><pems-icon name="bi-clock-history" /> @Localizer["Change History"]</pems-heading>
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Edit" asp-route-id="@ViewBag.HelpArticleId">Back to article</pems-button>
    </pems-flex>
    @if (!Model.Any())
    {
        <pems-text class="text-muted text-center py-4">No recorded changes yet.</pems-text>
    }
    else
    {
        <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["When"])?.ToString() ?? ""), log => (object?)((log.Timestamp.ToString("yyyy-MM-dd HH:mm"))), css: "small text-muted").Add(((Localizer["Action"])?.ToString() ?? ""), log => (object?)(DataCell.Badge("light", log.Action))).Add("By", log => (object?)((log.UserName ?? "—")), css: "small").Add(((Localizer["Changed Fields"])?.ToString() ?? ""), log => (object?)(DataCell.Span("mb-0 small", log.ChangedFieldsSummary).WithTag("pre")), css: "small")))" />
    }
</pems-content-card>
