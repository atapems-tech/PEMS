@model IReadOnlyList<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<pems-content-card>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><pems-icon name="bi-clock-history" /> @Localizer["Change History"]</h5>
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Edit" asp-route-id="@ViewBag.HelpArticleId">Back to article</pems-button>
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">No recorded changes yet.</p>
    }
    else
    {
        <pems-table kind="enterprise">
            <thead><tr><th>@Localizer["When"]</th><th>@Localizer["Action"]</th><th>By</th><th>@Localizer["Changed Fields"]</th></tr></thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><pems-badge tone="light">@log.Action</pems-badge></td>
                        <td class="small">@(log.UserName ?? "—")</td>
                        <td class="small"><pre class="mb-0 small">@log.ChangedFieldsSummary</pre></td>
                    </tr>
                }
            </tbody>
        </pems-table>
    }
</pems-content-card>
