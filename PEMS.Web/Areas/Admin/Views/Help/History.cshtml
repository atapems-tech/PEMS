@model IReadOnlyList<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<pems-content-card>
    <pems-flex justify="between" align="center" css="mb-3">
        <h5 class="mb-0"><pems-icon name="bi-clock-history" /> @Localizer["Change History"]</h5>
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Edit" asp-route-id="@ViewBag.HelpArticleId">Back to article</pems-button>
    </pems-flex>
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">No recorded changes yet.</p>
    }
    else
    {
        <pems-table kind="enterprise">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["When"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header><pems-table-header>By</pems-table-header><pems-table-header>@Localizer["Changed Fields"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var log in Model)
                {
                    <pems-table-row>
                        <pems-table-cell class="small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        <pems-table-cell><pems-badge tone="light">@log.Action</pems-badge></pems-table-cell>
                        <pems-table-cell class="small">@(log.UserName ?? "—")</pems-table-cell>
                        <pems-table-cell class="small"><pre class="mb-0 small">@log.ChangedFieldsSummary</pre></pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    }
</pems-content-card>
