@model PEMS.Application.DTOs.HelpArticleAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = (IEnumerable<dynamic>)ViewBag.Categories;
    var allArticles = (IEnumerable<dynamic>)ViewBag.AllArticlesForRelated;
    var articleTypes = new[] { "Module", "Page", "Field", "Action", "Workflow", "Faq", "Glossary", "Troubleshooting", "RoleGuide", "Concept", "DisciplineGuide" };
    @* StandardReference is intentionally NOT in this list - it requires the structured metadata
       (Identifier/IssuingOrganization/ApplicabilityStatus/...) that only the dedicated
       Standard Create/Edit form on this page collects; creating one here would leave that
       required row missing. *@
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Code <span class="text-danger">*</span></label>
        <input asp-for="Code" class="form-control" required placeholder="e.g. engineering-documents-overview" />
        <div class="form-text">Stable, unique, URL-safe identifier. Never changes once published.</div>
    </div>
    <div class="col-md-3">
        <label class="form-label">Category <span class="text-danger">*</span></label>
        <select asp-for="HelpCategoryId" class="form-select" required>
            @foreach (var c in categories) { <option value="@c.HelpCategoryId">@c.NameEn</option> }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">@Localizer["Article Type"]</label>
        <select asp-for="ArticleType" class="form-select">
            @foreach (var t in articleTypes) { <option value="@t">@t</option> }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">@Localizer["Display Order"]</label>
        <input asp-for="DisplayOrder" type="number" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Context Help Key (optional)</label>
        <input asp-for="HelpKey" class="form-control" placeholder="e.g. EngineeringDocuments.Details" />
        <div class="form-text">If set, this article appears in the contextual Help drawer on the matching page.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label">Relevant Roles (optional, comma-separated)</label>
        <input asp-for="RelevantRoles" class="form-control" placeholder="e.g. EngineeringManager,DocumentController" />
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsPublished" type="checkbox" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">@Localizer["Published (visible to all users)"]</label>
        </div>
    </div>

    <div class="col-12"><hr /></div>

    <div class="col-12">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-en" type="button">@Localizer["English"]</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fa" type="button">@Localizer["فارسی"]</button></li>
        </ul>
        <div class="tab-content border border-top-0 p-3">
            <div class="tab-pane fade show active" id="tab-en">
                <div class="mb-2">
                    <label class="form-label">Title (EN) <span class="text-danger">*</span></label>
                    <input asp-for="TitleEn" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Summary (EN) <span class="text-danger">*</span></label>
                    <textarea asp-for="SummaryEn" class="form-control" rows="2" required></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">Content (EN, HTML) <span class="text-danger">*</span></label>
                    <textarea asp-for="ContentEn" class="form-control" rows="10" required></textarea>
                    <div class="form-text">Basic HTML (headings, paragraphs, lists, tables, links) - sanitized automatically on save.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label">@Localizer["Search Keywords (EN)"]</label>
                    <input asp-for="SearchKeywordsEn" class="form-control" />
                </div>
            </div>
            <div class="tab-pane fade" id="tab-fa" dir="rtl">
                <div class="mb-2">
                    <label class="form-label">عنوان (فارسی) <span class="text-danger">*</span></label>
                    <input asp-for="TitleFa" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">خلاصه (فارسی) <span class="text-danger">*</span></label>
                    <textarea asp-for="SummaryFa" class="form-control" rows="2" required></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">متن (فارسی، HTML) <span class="text-danger">*</span></label>
                    <textarea asp-for="ContentFa" class="form-control" rows="10" required></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">@Localizer["کلیدواژه‌های جستجو (فارسی)"]</label>
                    <input asp-for="SearchKeywordsFa" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-12"><hr /></div>

    <div class="col-12">
        <label class="form-label">Related Articles</label>
        <select name="RelatedArticleIds" class="form-select" multiple size="6">
            @foreach (var a in allArticles)
            {
                var selected = Model.RelatedArticleIds.Contains((int)a.HelpArticleId);
                <option value="@a.HelpArticleId" selected="@selected">@a.Title (@a.Code)</option>
            }
        </select>
        <div class="form-text">Ctrl/Cmd+click to select multiple.</div>
    </div>
</div>
