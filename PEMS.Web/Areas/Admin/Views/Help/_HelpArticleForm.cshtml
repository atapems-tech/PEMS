@model PEMS.Application.DTOs.HelpArticleAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = (IEnumerable<dynamic>)ViewBag.Categories;
    var allArticles = (IEnumerable<dynamic>)ViewBag.AllArticlesForRelated;
    var articleTypes = new[] { "Module", "Page", "Field", "Action", "Workflow", "Faq", "Glossary", "Troubleshooting", "RoleGuide", "Concept", "DisciplineGuide" };
    @* StandardReference is intentionally NOT in this list - it requires the structured metadata
       (Identifier/IssuingOrganization/ApplicabilityStatus/...) that only the dedicated
       Standard Create/Edit form on this page collects; creating one here would leave that
       required row missing. *@
}

@if (!ViewData.ModelState.IsValid)
{
    <pems-alert tone="danger">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </pems-alert>
}

<pems-row gap="3">
    <pems-col md="3">
        <pems-label>Code <span class="text-danger">*</span></pems-label>
        <pems-input asp-for="Code" required placeholder="e.g. engineering-documents-overview" />
        <div class="form-text">Stable, unique, URL-safe identifier. Never changes once published.</div>
    </pems-col>
    <pems-col md="3">
        <pems-label>Category <span class="text-danger">*</span></pems-label>
        <pems-select asp-for="HelpCategoryId" required>
            @foreach (var c in categories) { <option value="@c.HelpCategoryId">@c.NameEn</option> }
        </pems-select>
    </pems-col>
    <pems-col md="3">
        <pems-label>@Localizer["Article Type"]</pems-label>
        <pems-select asp-for="ArticleType">
            @foreach (var t in articleTypes) { <option value="@t">@t</option> }
        </pems-select>
    </pems-col>
    <pems-col md="3">
        <pems-label>@Localizer["Display Order"]</pems-label>
        <pems-input asp-for="DisplayOrder" type="number" />
    </pems-col>

    <pems-col md="6">
        <pems-label>Context Help Key (optional)</pems-label>
        <pems-input asp-for="HelpKey" placeholder="e.g. EngineeringDocuments.Details" />
        <div class="form-text">If set, this article appears in the contextual Help drawer on the matching page.</div>
    </pems-col>
    <pems-col md="6">
        <pems-label>Relevant Roles (optional, comma-separated)</pems-label>
        <pems-input asp-for="RelevantRoles" placeholder="e.g. EngineeringManager,DocumentController" />
    </pems-col>

    <pems-col span="12">
        <div class="form-check">
            <pems-input kind="check" asp-for="IsPublished" type="checkbox" />
            <label asp-for="IsPublished" class="form-check-label">@Localizer["Published (visible to all users)"]</label>
        </div>
    </pems-col>

    <pems-col span="12"><hr /></pems-col>

    <pems-col span="12">
        <pems-nav role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-en" type="button">@Localizer["English"]</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fa" type="button">@Localizer["فارسی"]</button></li>
        </pems-nav>
        <div class="tab-content border border-top-0 p-3">
            <div class="tab-pane fade show active" id="tab-en">
                <div class="mb-2">
                    <pems-label>Title (EN) <span class="text-danger">*</span></pems-label>
                    <pems-input asp-for="TitleEn" required />
                </div>
                <div class="mb-2">
                    <pems-label>Summary (EN) <span class="text-danger">*</span></pems-label>
                    <pems-textarea asp-for="SummaryEn" rows="2" required></pems-textarea>
                </div>
                <div class="mb-2">
                    <pems-label>Content (EN, HTML) <span class="text-danger">*</span></pems-label>
                    <pems-textarea asp-for="ContentEn" rows="10" required></pems-textarea>
                    <div class="form-text">Basic HTML (headings, paragraphs, lists, tables, links) - sanitized automatically on save.</div>
                </div>
                <div class="mb-2">
                    <pems-label>@Localizer["Search Keywords (EN)"]</pems-label>
                    <pems-input asp-for="SearchKeywordsEn" />
                </div>
            </div>
            <div class="tab-pane fade" id="tab-fa" dir="rtl">
                <div class="mb-2">
                    <pems-label>عنوان (فارسی) <span class="text-danger">*</span></pems-label>
                    <pems-input asp-for="TitleFa" required />
                </div>
                <div class="mb-2">
                    <pems-label>خلاصه (فارسی) <span class="text-danger">*</span></pems-label>
                    <pems-textarea asp-for="SummaryFa" rows="2" required></pems-textarea>
                </div>
                <div class="mb-2">
                    <pems-label>متن (فارسی، HTML) <span class="text-danger">*</span></pems-label>
                    <pems-textarea asp-for="ContentFa" rows="10" required></pems-textarea>
                </div>
                <div class="mb-2">
                    <pems-label>@Localizer["کلیدواژه‌های جستجو (فارسی)"]</pems-label>
                    <pems-input asp-for="SearchKeywordsFa" />
                </div>
            </div>
        </div>
    </pems-col>

    <pems-col span="12"><hr /></pems-col>

    <pems-col span="12">
        <pems-label>Related Articles</pems-label>
        <pems-select name="RelatedArticleIds" multiple size="6">
            @foreach (var a in allArticles)
            {
                var selected = Model.RelatedArticleIds.Contains((int)a.HelpArticleId);
                <option value="@a.HelpArticleId" selected="@selected">@a.Title (@a.Code)</option>
            }
        </pems-select>
        <div class="form-text">Ctrl/Cmd+click to select multiple.</div>
    </pems-col>
</pems-row>
