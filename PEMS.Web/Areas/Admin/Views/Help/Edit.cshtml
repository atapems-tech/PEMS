@model PEMS.Application.DTOs.HelpArticleAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<pems-content-card>
    <pems-flex justify="between" align="center" css="mb-3">
        <h5 class="mb-0"><pems-icon name="bi-pencil" /> @Localizer["Edit Help Article"]</h5>
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="History" asp-route-id="@Model.HelpArticleId">
            <pems-icon name="bi-clock-history" /> @Localizer["Change History"]
        </pems-button>
    </pems-flex>
    <pems-form asp-action="Edit" asp-route-id="@Model.HelpArticleId" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_HelpArticleForm", Model)
        <pems-flex gap="2" css="mt-3">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button as="a" tone="neutral" outline="true" asp-action="Index">Back to list</pems-button>
        </pems-flex>
    </pems-form>
</pems-content-card>

@{
    var visuals = (IReadOnlyList<PEMS.Application.DTOs.HelpVisualAdminEditDto>)(ViewBag.Visuals ?? new List<PEMS.Application.DTOs.HelpVisualAdminEditDto>());
}

<pems-content-card css="mt-3">
    <pems-flex justify="between" align="center" css="mb-3">
        <h6 class="mb-0"><pems-icon name="bi-diagram-2" /> Visual Content (Phase 3)</h6>
        <pems-button as="a" tone="primary" size="small" asp-action="VisualCreate" asp-route-articleId="@Model.HelpArticleId">
            <pems-icon name="bi-plus-lg" /> Add Visual
        </pems-button>
    </pems-flex>
    @if (!visuals.Any())
    {
        <p class="text-muted small text-center py-3 mb-0">No visual content yet for this article.</p>
    }
    else
    {
        <pems-table kind="enterprise">
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>Caption (EN)</pems-table-header><pems-table-header>@Localizer["Source"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var v in visuals)
                {
                    <pems-table-row>
                        <pems-table-cell><pems-badge tone="light">@v.VisualType</pems-badge></pems-table-cell>
                        <pems-table-cell><a asp-action="VisualEdit" asp-route-id="@v.HelpVisualId">@v.CaptionEn</a></pems-table-cell>
                        <pems-table-cell class="small text-muted">
                            @(v.VisualType == "WorkflowDiagram" ? $"{v.SourceWorkflowModule}/{v.SourceWorkflowCategory}" : "Manual")
                        </pems-table-cell>
                        <pems-table-cell><pems-badge tone="none" css="@(v.IsPublished ? "bg-success" : "bg-secondary")">@(v.IsPublished ? "Published" : "Draft")</pems-badge></pems-table-cell>
                        <pems-table-cell class="text-end">
                            <pems-form asp-action="VisualSetPublished" asp-route-id="@v.HelpVisualId" asp-route-articleId="@Model.HelpArticleId" method="post" class="d-inline">
                                <input type="hidden" name="isPublished" value="@(!v.IsPublished)" />
                                <pems-button tone="none" size="small" css="btn-outline-@(v.IsPublished ? "secondary" : "success")" type="submit">
                                    @(v.IsPublished ? "Unpublish" : "Publish")
                                </pems-button>
                            </pems-form>
                            <pems-form asp-action="VisualDelete" asp-route-id="@v.HelpVisualId" asp-route-articleId="@Model.HelpArticleId" method="post" class="d-inline" data-pems-confirm="Delete this visual?">
                                <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-trash" /></pems-button>
                            </pems-form>
                        </pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-table>
    }
</pems-content-card>
