@model PEMS.Application.DTOs.HelpArticleAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-pencil"></i> @Localizer["Edit Help Article"]</h5>
        <a asp-action="History" asp-route-id="@Model.HelpArticleId" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-clock-history"></i> @Localizer["Change History"]
        </a>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.HelpArticleId" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_HelpArticleForm", Model)
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        </div>
    </form>
</div>

@{
    var visuals = (IReadOnlyList<PEMS.Application.DTOs.HelpVisualAdminEditDto>)(ViewBag.Visuals ?? new List<PEMS.Application.DTOs.HelpVisualAdminEditDto>());
}

<div class="content-card mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><i class="bi bi-diagram-2"></i> Visual Content (Phase 3)</h6>
        <a asp-action="VisualCreate" asp-route-articleId="@Model.HelpArticleId" class="btn btn-sm btn-pems-solid">
            <i class="bi bi-plus-lg"></i> Add Visual
        </a>
    </div>
    @if (!visuals.Any())
    {
        <p class="text-muted small text-center py-3 mb-0">No visual content yet for this article.</p>
    }
    else
    {
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Type"]</th><th>Caption (EN)</th><th>@Localizer["Source"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in visuals)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@v.VisualType</span></td>
                        <td><a asp-action="VisualEdit" asp-route-id="@v.HelpVisualId">@v.CaptionEn</a></td>
                        <td class="small text-muted">
                            @(v.VisualType == "WorkflowDiagram" ? $"{v.SourceWorkflowModule}/{v.SourceWorkflowCategory}" : "Manual")
                        </td>
                        <td><span class="badge @(v.IsPublished ? "bg-success" : "bg-secondary")">@(v.IsPublished ? "Published" : "Draft")</span></td>
                        <td class="text-end">
                            <form asp-action="VisualSetPublished" asp-route-id="@v.HelpVisualId" asp-route-articleId="@Model.HelpArticleId" method="post" class="d-inline">
                                <input type="hidden" name="isPublished" value="@(!v.IsPublished)" />
                                <button type="submit" class="btn btn-sm btn-outline-@(v.IsPublished ? "secondary" : "success")">
                                    @(v.IsPublished ? "Unpublish" : "Publish")
                                </button>
                            </form>
                            <form asp-action="VisualDelete" asp-route-id="@v.HelpVisualId" asp-route-articleId="@Model.HelpArticleId" method="post" class="d-inline" onsubmit="return confirm('Delete this visual?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
