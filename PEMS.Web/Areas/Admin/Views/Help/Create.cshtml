@model PEMS.Application.DTOs.HelpArticleAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<div class="content-card">
    <h5 class="mb-3"><i class="bi bi-plus-circle"></i> @Localizer["New Help Article"]</h5>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_HelpArticleForm", Model)
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Create"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
