@model IReadOnlyList<PEMS.Application.DTOs.HelpStandardReferenceMatrixRowDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["HidePageTitle"] = true;
}

<pems-content-card>
    <pems-flex justify="between" align="center" css="mb-3">
        <h5 class="mb-0"><pems-icon name="bi-journal-bookmark" /> @Localizer["Standards Matrix"]</h5>
        <pems-button as="a" tone="primary" size="small" asp-action="StandardCreate"><pems-icon name="bi-plus-lg" /> @Localizer["Add Standard"]</pems-button>
    </pems-flex>

    @if (!Model.Any())
    {
        <p class="text-muted small text-center py-4 mb-0">No standard references yet.</p>
    }
    else
    {
        <pems-table-scroll>
            <pems-table kind="enterprise">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["Identifier"]</pems-table-header><pems-table-header>@Localizer["Title"]</pems-table-header><pems-table-header>@Localizer["Issuer"]</pems-table-header><pems-table-header>@Localizer["Related Module"]</pems-table-header>
                        <pems-table-header>@Localizer["Applicability"]</pems-table-header><pems-table-header>@Localizer["Verification"]</pems-table-header><pems-table-header>@Localizer["PEMS Status"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var s in Model)
                    {
                        <pems-table-row>
                            <pems-table-cell><strong>@s.Identifier</strong></pems-table-cell>
                            <pems-table-cell><a asp-action="StandardEdit" asp-route-id="@s.HelpStandardReferenceId">@s.TitleEn</a></pems-table-cell>
                            <pems-table-cell class="small text-muted">@s.IssuingOrganization</pems-table-cell>
                            <pems-table-cell class="small text-muted">@s.RelatedModule</pems-table-cell>
                            <pems-table-cell><pems-badge tone="light">@s.ApplicabilityStatus</pems-badge></pems-table-cell>
                            <pems-table-cell><pems-badge tone="light">@s.VerificationStatus</pems-badge></pems-table-cell>
                            <pems-table-cell>
                                <pems-badge tone="none" css="@(s.PEMSImplementationStatus == "ComplianceEvidenceAvailable" ? "bg-success" : "bg-secondary")">
                                    @s.PEMSImplementationStatus
                                </pems-badge>
                            </pems-table-cell>
                            <pems-table-cell><pems-badge tone="none" css="@(s.IsPublished ? "bg-success" : "bg-secondary")">@(s.IsPublished ? "Published" : "Draft")</pems-badge></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="StandardSetPublished" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline">
                                    <input type="hidden" name="isPublished" value="@(!s.IsPublished)" />
                                    <pems-button tone="none" size="small" css="btn-outline-@(s.IsPublished ? "secondary" : "success")" type="submit">
                                        @(s.IsPublished ? "Unpublish" : "Publish")
                                    </pems-button>
                                </form>
                                <form asp-action="StandardDelete" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline" data-pems-confirm="Delete this standard reference?">
                                    <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-trash" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    }
</pems-content-card>
