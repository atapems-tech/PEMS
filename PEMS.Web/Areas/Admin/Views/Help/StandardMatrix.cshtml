@model IReadOnlyList<PEMS.Application.DTOs.HelpStandardReferenceMatrixRowDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["HidePageTitle"] = true;
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-journal-bookmark"></i> @Localizer["Standards Matrix"]</h5>
        <a asp-action="StandardCreate" class="btn btn-sm btn-pems-solid"><i class="bi bi-plus-lg"></i> @Localizer["Add Standard"]</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted small text-center py-4 mb-0">No standard references yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead>
                    <tr>
                        <th>@Localizer["Identifier"]</th><th>@Localizer["Title"]</th><th>@Localizer["Issuer"]</th><th>@Localizer["Related Module"]</th>
                        <th>@Localizer["Applicability"]</th><th>@Localizer["Verification"]</th><th>@Localizer["PEMS Status"]</th><th>@Localizer["Status"]</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.Identifier</strong></td>
                            <td><a asp-action="StandardEdit" asp-route-id="@s.HelpStandardReferenceId">@s.TitleEn</a></td>
                            <td class="small text-muted">@s.IssuingOrganization</td>
                            <td class="small text-muted">@s.RelatedModule</td>
                            <td><span class="badge bg-light text-dark border">@s.ApplicabilityStatus</span></td>
                            <td><span class="badge bg-light text-dark border">@s.VerificationStatus</span></td>
                            <td>
                                <span class="badge @(s.PEMSImplementationStatus == "ComplianceEvidenceAvailable" ? "bg-success" : "bg-secondary")">
                                    @s.PEMSImplementationStatus
                                </span>
                            </td>
                            <td><span class="badge @(s.IsPublished ? "bg-success" : "bg-secondary")">@(s.IsPublished ? "Published" : "Draft")</span></td>
                            <td class="text-end">
                                <form asp-action="StandardSetPublished" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline">
                                    <input type="hidden" name="isPublished" value="@(!s.IsPublished)" />
                                    <button type="submit" class="btn btn-sm btn-outline-@(s.IsPublished ? "secondary" : "success")">
                                        @(s.IsPublished ? "Unpublish" : "Publish")
                                    </button>
                                </form>
                                <form asp-action="StandardDelete" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline" onsubmit="return confirm('Delete this standard reference?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
