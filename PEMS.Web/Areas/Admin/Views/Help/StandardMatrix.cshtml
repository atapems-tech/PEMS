@model IReadOnlyList<PEMS.Application.DTOs.HelpStandardReferenceMatrixRowDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["HidePageTitle"] = true;
}

<pems-content-card>
    <pems-flex justify="between" align="center" css="mb-3">
        <pems-heading level="5" class="mb-0"><pems-icon name="bi-journal-bookmark" /> @Localizer["Standards Matrix"]</pems-heading>
        <pems-button as="a" tone="primary" size="small" asp-action="StandardCreate"><pems-icon name="bi-plus-lg" /> @Localizer["Add Standard"]</pems-button>
    </pems-flex>

    @if (!Model.Any())
    {
        <pems-text class="text-muted small text-center py-4 mb-0">No standard references yet.</pems-text>
    }
    else
    {
        <pems-table-scroll>
            @{
                var rows_3 = Model;
                var cell_3_8 = DataCell.Template(rows_3, @<text>@{ var s = item; }
                                <pems-form asp-action="StandardSetPublished" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline">
                                    <input type="hidden" name="isPublished" value="@(!s.IsPublished)" />
                                    <pems-button tone="none" size="small" css="btn-outline-@(s.IsPublished ? "secondary" : "success")" type="submit">
                                        @(s.IsPublished ? "Unpublish" : "Publish")
                                    </pems-button>
                                </pems-form>
                                <pems-form asp-action="StandardDelete" asp-route-id="@s.HelpStandardReferenceId" method="post" class="d-inline" data-pems-confirm="Delete this standard reference?">
                                    <pems-button tone="danger" size="small" outline="true" type="submit"><pems-icon name="bi-trash" /></pems-button>
                                </pems-form>
                            </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_3, c_ => c_.Add(((Localizer["Identifier"])?.ToString() ?? ""), s => (object?)(DataCell.Span(null, s.Identifier).WithTag("strong"))).Add(((Localizer["Title"])?.ToString() ?? ""), s => (object?)(DataCell.Link(Url.Action("StandardEdit", null, new { id = s.HelpStandardReferenceId }), s.TitleEn))).Add(((Localizer["Issuer"])?.ToString() ?? ""), s => (object?)(s.IssuingOrganization), css: "small text-muted").Add(((Localizer["Related Module"])?.ToString() ?? ""), s => (object?)(s.RelatedModule), css: "small text-muted").Add(((Localizer["Applicability"])?.ToString() ?? ""), s => (object?)(DataCell.Badge("light", s.ApplicabilityStatus))).Add(((Localizer["Verification"])?.ToString() ?? ""), s => (object?)(DataCell.Badge("light", s.VerificationStatus))).Add(((Localizer["PEMS Status"])?.ToString() ?? ""), s => (object?)(DataCell.Badge("none", s.PEMSImplementationStatus, (s.PEMSImplementationStatus == "ComplianceEvidenceAvailable" ? "bg-success" : "bg-secondary")))).Add(((Localizer["Status"])?.ToString() ?? ""), s => (object?)(DataCell.Badge("none", (s.IsPublished ? "Published" : "Draft"), (s.IsPublished ? "bg-success" : "bg-secondary")))).Add("", s => (object?)cell_3_8(s), css: "text-end")))" />
        </pems-table-scroll>
    }
</pems-content-card>
