@model PEMS.Application.DTOs.HelpVisualAdminEditDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["HidePageTitle"] = true;
    var isEdit = Model.HelpVisualId > 0;
    var workflowSources = (IReadOnlyList<(string Module, string Category, string Name)>)ViewBag.WorkflowSources;
    var visualTypes = new[] { "WorkflowDiagram", "ProcessFlowchart", "LifecycleDiagram", "DecisionTree", "StepGuide", "EntityRelationship" };
}

<div class="content-card">
    <h5 class="mb-3"><i class="bi bi-diagram-2"></i> @(isEdit ? "Edit" : "New") Help Visual</h5>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="@(isEdit ? "VisualEdit" : "VisualCreate")" asp-route-id="@(isEdit ? Model.HelpVisualId : (int?)null)" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HelpArticleId" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">@Localizer["Visual Type"]</label>
                <select asp-for="VisualType" class="form-select" onchange="toggleSourceFields(this.value)">
                    @foreach (var t in visualTypes) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Display Order"]</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" />
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="IsPublished" type="checkbox" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label">@Localizer["Published"]</label>
                </div>
            </div>

            <div class="col-12" id="workflowSourceFields">
                <label class="form-label">Real Workflow Source (Module / Category)</label>
                <p class="form-text mt-0">
                    Only actual workflows registered in the engine are listed - the diagram is generated live from
                    their real stages/transitions and can never go out of sync.
                </p>
                <select id="workflowSourcePicker" class="form-select mb-2" onchange="applyWorkflowSource(this.value)">
                    <option value="">-- select a real workflow --</option>
                    @foreach (var s in workflowSources)
                    {
                        var value = s.Module + "|" + s.Category;
                        var selected = s.Module == Model.SourceWorkflowModule && s.Category == Model.SourceWorkflowCategory;
                        <option value="@value" selected="@selected">@s.Module / @s.Category (@s.Name)</option>
                    }
                </select>
                <input asp-for="SourceWorkflowModule" class="form-control form-control-sm mb-1" readonly placeholder="@Localizer["Module"]" />
                <input asp-for="SourceWorkflowCategory" class="form-control form-control-sm" readonly placeholder="@Localizer["Category"]" />
            </div>

            <div class="col-12" id="manualDefinitionField">
                <label class="form-label">Diagram Definition (structured text, not raw HTML/script)</label>
                <p class="form-text mt-0">
                    One line per item. Format:<br />
                    <code>NODE|id|Label (EN)|Label (FA)|optional-bootstrap-icon-class</code><br />
                    <code>EDGE|fromId|toIdOrEmptyForEnd|Label (EN)|Label (FA)|normal|reject|decision</code>
                </p>
                <textarea asp-for="ManualDefinitionText" class="form-control" rows="8" style="font-family:monospace;"></textarea>
            </div>

            <div class="col-12"><hr /></div>

            <div class="col-md-6">
                <label class="form-label">Caption (EN) <span class="text-danger">*</span></label>
                <input asp-for="CaptionEn" class="form-control" required />
            </div>
            <div class="col-md-6" dir="rtl">
                <label class="form-label">عنوان کوتاه (فارسی) <span class="text-danger">*</span></label>
                <input asp-for="CaptionFa" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Legend (EN, optional)</label>
                <input asp-for="LegendEn" class="form-control" />
            </div>
            <div class="col-md-6" dir="rtl">
                <label class="form-label">@Localizer["راهنمای علائم (فارسی، اختیاری)"]</label>
                <input asp-for="LegendFa" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Accessibility Description (EN) <span class="text-danger">*</span></label>
                <textarea asp-for="AccessibilityDescriptionEn" class="form-control" rows="2" required></textarea>
                <div class="form-text">Full text description for screen readers - the only way non-visual users understand this diagram.</div>
            </div>
            <div class="col-md-6" dir="rtl">
                <label class="form-label">توضیح دسترس‌پذیری (فارسی) <span class="text-danger">*</span></label>
                <textarea asp-for="AccessibilityDescriptionFa" class="form-control" rows="2" required></textarea>
            </div>

            <div class="col-md-6">
                <label class="form-label">Related Help Key (optional)</label>
                <input asp-for="RelatedHelpKey" class="form-control" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
            <a asp-action="Edit" asp-route-id="@Model.HelpArticleId" class="btn btn-outline-secondary">Back to article</a>
        </div>
    </form>
</div>

<script>
    function toggleSourceFields(type) {
        var isWorkflow = type === 'WorkflowDiagram';
        document.getElementById('workflowSourceFields').style.display = isWorkflow ? '' : 'none';
        document.getElementById('manualDefinitionField').style.display = isWorkflow ? 'none' : '';
    }
    function applyWorkflowSource(value) {
        var parts = value.split('|');
        document.querySelector('[name="SourceWorkflowModule"]').value = parts[0] || '';
        document.querySelector('[name="SourceWorkflowCategory"]').value = parts[1] || '';
    }
    document.addEventListener('DOMContentLoaded', function () {
        toggleSourceFields(document.querySelector('[name="VisualType"]').value);
    });
</script>
