@model PEMS.Web.Areas.Admin.Models.EffectiveRoleVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["See what a Role can do, read live from the authorization engine."]</p></div>
        </div>
    </div>
    <div class="content-card">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><a class="nav-link active" asp-action="EffectiveRole">@Localizer["By Role"]</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="EffectiveUser">@Localizer["By User"]</a></li>
        </ul>

        <form method="get" class="d-flex gap-2 align-items-end mb-3" style="max-width:420px;">
            <div class="flex-grow-1">
                <label class="form-label">@Localizer["Role"]</label>
                <select name="roleName" class="form-select" onchange="this.form.submit()">
                    <option value="">@Localizer["— select a role —"]</option>
                    @foreach (var r in Model.AllRoles)
                    {
                        <option value="@r" selected="@(r == Model.SelectedRole)">@r</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-pems-solid">@Localizer["View"]</button>
        </form>

        @if (Model.SelectedRole == null)
        {
            <div class="admin-empty"><i class="bi bi-eye"></i><strong>@Localizer["Choose a role above"]</strong></div>
        }
        else if (Model.SelectedRole == "SystemAdmin")
        {
            <div class="permission-intro"><i class="bi bi-infinity me-1"></i> @Localizer["SystemAdmin bypasses this matrix by design."]</div>
        }
        else
        {
            <div class="admin-toolbar mb-2"><div class="admin-toolbar-main"><span class="text-body-secondary small">@Model.AllowedCount / @Model.Rows.Count @Localizer["permissions allowed"] - <strong>@Model.SelectedRole</strong></span></div></div>
            <div class="table-responsive">
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th><th>@Localizer["Destructive"]</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows.Where(r => r.Allowed))
                    {
                        <tr>
                            <td>@row.ResourceName</td>
                            <td>@row.ActionName</td>
                            <td><code>@row.PermissionName</code></td>
                            <td><span class="admin-status active"><i class="bi bi-check2-circle"></i> @Localizer["Allowed"]</span></td>
                            <td>@if (row.IsDestructive) { <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> @Localizer["Yes"]</span> } else { <span class="text-body-secondary">—</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <details class="mt-3">
                <summary class="text-body-secondary small">@Localizer["Show not-granted permissions"] (@(Model.Rows.Count - Model.AllowedCount))</summary>
                <div class="table-responsive mt-2">
                    <table class="table table-enterprise">
                        <thead><tr><th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows.Where(r => !r.Allowed))
                        {
                            <tr class="text-body-secondary">
                                <td>@row.ResourceName</td>
                                <td>@row.ActionName</td>
                                <td><code>@row.PermissionName</code></td>
                                <td><span class="admin-status inactive"><i class="bi bi-dash-circle"></i> @Localizer["Not granted"]</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>
</div>
