@model PEMS.Web.Areas.Admin.Models.EffectiveRoleVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" gap="3">
            <div><p>@Localizer["See what a Role can do, read live from the authorization engine."]</p></div>
        </pems-flex>
    </pems-page-hero>
    <pems-content-card>
        <pems-nav css="mb-3">
            <pems-nav-link active="true" asp-action="EffectiveRole">@Localizer["By Role"]</pems-nav-link>
            <pems-nav-link asp-action="EffectiveUser">@Localizer["By User"]</pems-nav-link>
        </pems-nav>

        <pems-form class="mb-3 pems-s-0fd8744d" method="get"><pems-flex gap="2" align="end">
            <div class="flex-grow-1">
                <pems-label>@Localizer["Role"]</pems-label>
                <pems-select name="roleName" data-pems-change="submit-form">
                    <option value="">@Localizer["— select a role —"]</option>
                    @foreach (var r in Model.AllRoles)
                    {
                        <option value="@r" selected="@(r == Model.SelectedRole)">@r</option>
                    }
                </pems-select>
            </div>
            <pems-button tone="primary" type="submit">@Localizer["View"]</pems-button>
        </pems-flex></pems-form>

        @if (Model.SelectedRole == null)
        {
            <div class="admin-empty"><pems-icon name="bi-eye" /><strong>@Localizer["Choose a role above"]</strong></div>
        }
        else if (Model.SelectedRole == "SystemAdmin")
        {
            <div class="permission-intro"><pems-icon name="bi-infinity" css="me-1" /> @Localizer["SystemAdmin bypasses this matrix by design."]</div>
        }
        else
        {
            <div class="admin-toolbar mb-2"><div class="admin-toolbar-main"><span class="text-body-secondary small">@Model.AllowedCount / @Model.Rows.Count @Localizer["permissions allowed"] - <strong>@Model.SelectedRole</strong></span></div></div>
            <pems-table-scroll>
                <pems-data-table data="@(DataRows.Of(Model.Rows.Where(r => r.Allowed), c_ => c_.Add(((Localizer["Resource"])?.ToString() ?? ""), row => (object?)(row.ResourceName)).Add(((Localizer["Action"])?.ToString() ?? ""), row => (object?)(row.ActionName)).Add(((Localizer["Permission"])?.ToString() ?? ""), row => (object?)(DataCell.Code(row.PermissionName))).Add(((Localizer["Status"])?.ToString() ?? ""), row => (object?)(DataCell.Span("admin-status active", DataCell.Icon("bi-check2-circle"), " ", Localizer["Allowed"]))).Add(((Localizer["Destructive"])?.ToString() ?? ""), row => (object?)((row.IsDestructive ? (object?)DataCell.Span("text-danger", DataCell.Icon("bi-exclamation-triangle"), " ", Localizer["Yes"]) : DataCell.Span("text-body-secondary", "—"))))))" />
            </pems-table-scroll>
            <details class="mt-3">
                <summary class="text-body-secondary small">@Localizer["Show not-granted permissions"] (@(Model.Rows.Count - Model.AllowedCount))</summary>
                <pems-table-scroll css="mt-2">
                    <pems-data-table data="@(DataRows.Of(Model.Rows.Where(r => !r.Allowed), c_ => c_.Add(((Localizer["Resource"])?.ToString() ?? ""), row => (object?)(row.ResourceName)).Add(((Localizer["Action"])?.ToString() ?? ""), row => (object?)(row.ActionName)).Add(((Localizer["Permission"])?.ToString() ?? ""), row => (object?)(DataCell.Code(row.PermissionName))).Add(((Localizer["Status"])?.ToString() ?? ""), row => (object?)(DataCell.Span("admin-status inactive", DataCell.Icon("bi-dash-circle"), " ", Localizer["Not granted"]))), rowClass: row => "text-body-secondary"))" />
                </pems-table-scroll>
            </details>
        }
    </pems-content-card>
</pems-page-shell>
