@model PEMS.Web.Areas.Admin.Models.EffectiveRoleVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<pems-page-shell kind="admin">
    <div class="admin-hero">
        <pems-flex align="center" gap="3">
            <div><p>@Localizer["See what a Role can do, read live from the authorization engine."]</p></div>
        </pems-flex>
    </div>
    <pems-content-card>
        <pems-nav css="mb-3">
            <li class="nav-item"><a class="nav-link active" asp-action="EffectiveRole">@Localizer["By Role"]</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="EffectiveUser">@Localizer["By User"]</a></li>
        </pems-nav>

        <form class="mb-3 pems-s-0fd8744d" method="get"><pems-flex gap="2" align="end">
            <div class="flex-grow-1">
                <pems-label>@Localizer["Role"]</pems-label>
                <pems-select name="roleName" onchange="this.form.submit()">
                    <option value="">@Localizer["— select a role —"]</option>
                    @foreach (var r in Model.AllRoles)
                    {
                        <option value="@r" selected="@(r == Model.SelectedRole)">@r</option>
                    }
                </pems-select>
            </div>
            <pems-button tone="primary" type="submit">@Localizer["View"]</pems-button>
        </pems-flex></form>

        @if (Model.SelectedRole == null)
        {
            <div class="admin-empty"><pems-icon name="bi-eye" /><strong>@Localizer["Choose a role above"]</strong></div>
        }
        else if (Model.SelectedRole == "SystemAdmin")
        {
            <div class="permission-intro"><pems-icon name="bi-infinity" css="me-1" /> @Localizer["SystemAdmin bypasses this matrix by design."]</div>
        }
        else
        {
            <div class="admin-toolbar mb-2"><div class="admin-toolbar-main"><span class="text-body-secondary small">@Model.AllowedCount / @Model.Rows.Count @Localizer["permissions allowed"] - <strong>@Model.SelectedRole</strong></span></div></div>
            <div class="table-responsive">
                <pems-table kind="enterprise">
                    <thead><tr><th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th><th>@Localizer["Destructive"]</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows.Where(r => r.Allowed))
                    {
                        <tr>
                            <td>@row.ResourceName</td>
                            <td>@row.ActionName</td>
                            <td><code>@row.PermissionName</code></td>
                            <td><span class="admin-status active"><pems-icon name="bi-check2-circle" /> @Localizer["Allowed"]</span></td>
                            <td>@if (row.IsDestructive) { <span class="text-danger"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Yes"]</span> } else { <span class="text-body-secondary">—</span> }</td>
                        </tr>
                    }
                    </tbody>
                </pems-table>
            </div>
            <details class="mt-3">
                <summary class="text-body-secondary small">@Localizer["Show not-granted permissions"] (@(Model.Rows.Count - Model.AllowedCount))</summary>
                <div class="table-responsive mt-2">
                    <pems-table kind="enterprise">
                        <thead><tr><th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows.Where(r => !r.Allowed))
                        {
                            <tr class="text-body-secondary">
                                <td>@row.ResourceName</td>
                                <td>@row.ActionName</td>
                                <td><code>@row.PermissionName</code></td>
                                <td><span class="admin-status inactive"><pems-icon name="bi-dash-circle" /> @Localizer["Not granted"]</span></td>
                            </tr>
                        }
                        </tbody>
                    </pems-table>
                </div>
            </details>
        }
    </pems-content-card>
</pems-page-shell>
