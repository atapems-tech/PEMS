@model PEMS.Web.Areas.Admin.Models.SimulateFormVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["Run a real authorization decision for a hypothetical user and action."]</p></div>
        </div>
    </div>
    <div class="content-card">
        <form class="pems-s-b12974cb" asp-action="Simulate" method="post"><pems-row gap="3">
            <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="ModelOnly" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></pems-alert>

            <pems-col md="6">
                <pems-label>@Localizer["User"]</pems-label>
                <pems-select asp-for="UserId">
                    <option value="">@Localizer["— select —"]</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.UserId)">@u.Display</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Permission"]</pems-label>
                <pems-input list="permNames" id="permPicker" />
                <datalist id="permNames">
                    @foreach (var p in Model.AllPermissionNames)
                    {
                        <option value="@p"></option>
                    }
                </datalist>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Resource"]</pems-label>
                <pems-input asp-for="ResourceName" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Action"]</pems-label>
                <pems-input asp-for="ActionName" />
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Resource ID (optional)"]</pems-label>
                <pems-input asp-for="ResourceId" />
            </pems-col>
            <pems-col span="12">
                <pems-button tone="primary" type="submit"><pems-icon name="bi-play-circle" css="me-1" /> @Localizer["Run"]</pems-button>
            </pems-col>
        </pems-row></form>

        @if (Model.Result != null)
        {
            var r = Model.Result;
            <div class="permission-role mt-4">
                <div class="permission-role-title">
                    <span>
                        @if (r.Allowed) { <span class="admin-status active fs-6"><pems-icon name="bi-check2-circle" /> @Localizer["ALLOW"]</span> }
                        else { <span class="admin-status inactive fs-6"><pems-icon name="bi-x-circle" /> @Localizer["DENY"]</span> }
                    </span>
                </div>
                <div class="p-3">
                    <pems-info-grid layout="rows" class="mb-0">
    <pems-info-item label="@Localizer["Reason"]"><code>@r.Reason</code></pems-info-item>
    <pems-info-item label="@Localizer["Detail"]">@(string.IsNullOrWhiteSpace(r.Detail) ? "—" : r.Detail)</pems-info-item>
    <pems-info-item label="@Localizer["Matched Role"]">@(r.MatchedRoleName ?? "—")</pems-info-item>
    <pems-info-item label="@Localizer["Matched Scope"]">@(r.MatchedScopeType == null ? "—" : $"{r.MatchedScopeType} = {r.MatchedScopeValue}")</pems-info-item>
</pems-info-grid>
                </div>
            </div>
            <p class="text-body-secondary small mt-2"><pems-icon name="bi-info-circle" /> @Localizer["This was recorded in the Authorization Audit log."]</p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/views/admin-authorization-simulate.js" asp-append-version="true"></script>
}
