@model PEMS.Web.Areas.Admin.Models.SimulateFormVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["Run a real authorization decision for a hypothetical user and action."]</p></div>
        </div>
    </div>
    <div class="content-card">
        <form asp-action="Simulate" method="post" class="row g-3" style="max-width:720px;">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

            <div class="col-md-6">
                <pems-label>@Localizer["User"]</pems-label>
                <pems-select asp-for="UserId">
                    <option value="">@Localizer["— select —"]</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.UserId)">@u.Display</option>
                    }
                </pems-select>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Permission"]</pems-label>
                <pems-input list="permNames" id="permPicker" />
                <datalist id="permNames">
                    @foreach (var p in Model.AllPermissionNames)
                    {
                        <option value="@p"></option>
                    }
                </datalist>
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Resource"]</pems-label>
                <pems-input asp-for="ResourceName" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Action"]</pems-label>
                <pems-input asp-for="ActionName" />
            </div>
            <div class="col-md-6">
                <pems-label>@Localizer["Resource ID (optional)"]</pems-label>
                <pems-input asp-for="ResourceId" />
            </div>
            <div class="col-12">
                <pems-button tone="primary" type="submit"><i class="bi bi-play-circle me-1"></i> @Localizer["Run"]</pems-button>
            </div>
        </form>

        @if (Model.Result != null)
        {
            var r = Model.Result;
            <div class="permission-role mt-4">
                <div class="permission-role-title">
                    <span>
                        @if (r.Allowed) { <span class="admin-status active fs-6"><i class="bi bi-check2-circle"></i> @Localizer["ALLOW"]</span> }
                        else { <span class="admin-status inactive fs-6"><i class="bi bi-x-circle"></i> @Localizer["DENY"]</span> }
                    </span>
                </div>
                <div class="p-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">@Localizer["Reason"]</dt><dd class="col-sm-9"><code>@r.Reason</code></dd>
                        <dt class="col-sm-3">@Localizer["Detail"]</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(r.Detail) ? "—" : r.Detail)</dd>
                        <dt class="col-sm-3">@Localizer["Matched Role"]</dt><dd class="col-sm-9">@(r.MatchedRoleName ?? "—")</dd>
                        <dt class="col-sm-3">@Localizer["Matched Scope"]</dt><dd class="col-sm-9">@(r.MatchedScopeType == null ? "—" : $"{r.MatchedScopeType} = {r.MatchedScopeValue}")</dd>
                    </dl>
                </div>
            </div>
            <p class="text-body-secondary small mt-2"><i class="bi bi-info-circle"></i> @Localizer["This was recorded in the Authorization Audit log."]</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('permPicker').addEventListener('change', function (e) {
            var v = e.target.value || '';
            var dot = v.indexOf('.');
            if (dot > 0) {
                document.querySelector('[name="ResourceName"]').value = v.substring(0, dot);
                document.querySelector('[name="ActionName"]').value = v.substring(dot + 1);
            }
        });
    </script>
}
