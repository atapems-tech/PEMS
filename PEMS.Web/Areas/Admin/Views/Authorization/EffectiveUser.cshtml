@model PEMS.Web.Areas.Admin.Models.EffectiveUserVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" gap="3">
            <div><pems-text>@Localizer["See what a User can do, and which Role/Scope grants it."]</pems-text></div>
        </pems-flex>
    </pems-page-hero>
    <pems-content-card>
        <pems-nav css="mb-3">
            <pems-nav-link asp-action="EffectiveRole">@Localizer["By Role"]</pems-nav-link>
            <pems-nav-link active="true" asp-action="EffectiveUser">@Localizer["By User"]</pems-nav-link>
        </pems-nav>

        <pems-form class="mb-3 pems-s-0fd8744d" method="get"><pems-flex gap="2" align="end">
            <div class="flex-grow-1">
                <pems-label>@Localizer["User"]</pems-label>
                <pems-select name="userId" data-pems-change="submit-form">
                    <option value="">@Localizer["— select a user —"]</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.SelectedUserId)">@u.Display</option>
                    }
                </pems-select>
            </div>
            <pems-button tone="primary" type="submit">@Localizer["View"]</pems-button>
        </pems-flex></pems-form>

        @if (Model.SelectedUserId == null)
        {
            <div class="admin-empty"><pems-icon name="bi-eye" /><strong>@Localizer["Choose a user above"]</strong></div>
        }
        else
        {
            <pems-form-group css="mb-3">
                <div class="text-body-secondary small mb-1">@Localizer["Roles and scope"]</div>
                @if (Model.Assignments.Count == 0)
                {
                    <span class="admin-status inactive"><pems-icon name="bi-exclamation-triangle" /> @Localizer["No roles assigned"]</span>
                }
                else
                {
                    <pems-table-scroll>
                        <pems-data-table data="@(DataRows.Of(Model.Assignments, c_ => c_.Add(((Localizer["Role"])?.ToString() ?? ""), a => (object?)(a.RoleName)).Add(((Localizer["Scope"])?.ToString() ?? ""), a => (object?)(DataCell.Group(a.ScopeType, (string.IsNullOrEmpty(a.ScopeValue) ? "" : $" = {a.ScopeValue}")))).Add(((Localizer["Type"])?.ToString() ?? ""), a => (object?)(a.AssignmentType)).Add(((Localizer["Effective"])?.ToString() ?? ""), a => (object?)((a.EffectiveFrom == null && a.EffectiveTo == null ? (object?)DataCell.Span("text-body-secondary", Localizer["Always"]) : DataCell.Span(null, (a.EffectiveFrom?.ToString("yyyy-MM-dd")), " – ", (a.EffectiveTo?.ToString("yyyy-MM-dd") ?? Localizer["Open"])))))))" dense="true" />
                    </pems-table-scroll>
                }
            </pems-form-group>

            @if (Model.RoleNames.Contains("SystemAdmin"))
            {
                <div class="permission-intro"><pems-icon name="bi-infinity" css="me-1" /> @Localizer["This user holds SystemAdmin and bypasses the permission matrix by design."]</div>
            }
            else
            {
                <div class="admin-toolbar mb-2"><div class="admin-toolbar-main"><span class="text-body-secondary small">@Model.AllowedCount / @Model.Rows.Count @Localizer["permissions allowed, via role membership"]</span></div></div>
                <pems-table-scroll>
                    <pems-data-table data="@(DataRows.Of(Model.Rows.Where(r => r.Allowed), c_ => c_.Add(((Localizer["Resource"])?.ToString() ?? ""), row => (object?)(row.ResourceName)).Add(((Localizer["Action"])?.ToString() ?? ""), row => (object?)(row.ActionName)).Add(((Localizer["Permission"])?.ToString() ?? ""), row => (object?)(DataCell.Code(row.PermissionName))).Add(((Localizer["Status"])?.ToString() ?? ""), row => (object?)(DataCell.Span("admin-status active", DataCell.Icon("bi-check2-circle"), " ", Localizer["Allowed"])))))" />
                </pems-table-scroll>
            }
        }
    </pems-content-card>
</pems-page-shell>
