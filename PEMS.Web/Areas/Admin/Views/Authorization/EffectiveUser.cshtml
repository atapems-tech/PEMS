@model PEMS.Web.Areas.Admin.Models.EffectiveUserVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" gap="3">
            <div><p>@Localizer["See what a User can do, and which Role/Scope grants it."]</p></div>
        </pems-flex>
    </pems-page-hero>
    <pems-content-card>
        <pems-nav css="mb-3">
            <li class="nav-item"><a class="nav-link" asp-action="EffectiveRole">@Localizer["By Role"]</a></li>
            <li class="nav-item"><a class="nav-link active" asp-action="EffectiveUser">@Localizer["By User"]</a></li>
        </pems-nav>

        <form class="mb-3 pems-s-0fd8744d" method="get"><pems-flex gap="2" align="end">
            <div class="flex-grow-1">
                <pems-label>@Localizer["User"]</pems-label>
                <pems-select name="userId" onchange="this.form.submit()">
                    <option value="">@Localizer["— select a user —"]</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.SelectedUserId)">@u.Display</option>
                    }
                </pems-select>
            </div>
            <pems-button tone="primary" type="submit">@Localizer["View"]</pems-button>
        </pems-flex></form>

        @if (Model.SelectedUserId == null)
        {
            <div class="admin-empty"><pems-icon name="bi-eye" /><strong>@Localizer["Choose a user above"]</strong></div>
        }
        else
        {
            <div class="mb-3">
                <div class="text-body-secondary small mb-1">@Localizer["Roles and scope"]</div>
                @if (Model.Assignments.Count == 0)
                {
                    <span class="admin-status inactive"><pems-icon name="bi-exclamation-triangle" /> @Localizer["No roles assigned"]</span>
                }
                else
                {
                    <pems-table-scroll>
                        <pems-table kind="enterprise" scale="small">
                            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Role"]</pems-table-header><pems-table-header>@Localizer["Scope"]</pems-table-header><pems-table-header>@Localizer["Type"]</pems-table-header><pems-table-header>@Localizer["Effective"]</pems-table-header></pems-table-row></pems-table-head>
                            <pems-table-body>
                            @foreach (var a in Model.Assignments)
                            {
                                <pems-table-row>
                                    <pems-table-cell>@a.RoleName</pems-table-cell>
                                    <pems-table-cell>@a.ScopeType@(string.IsNullOrEmpty(a.ScopeValue) ? "" : $" = {a.ScopeValue}")</pems-table-cell>
                                    <pems-table-cell>@a.AssignmentType</pems-table-cell>
                                    <pems-table-cell>
                                        @if (a.EffectiveFrom == null && a.EffectiveTo == null) { <span class="text-body-secondary">@Localizer["Always"]</span> }
                                        else { <span>@a.EffectiveFrom?.ToString("yyyy-MM-dd") &ndash; @(a.EffectiveTo?.ToString("yyyy-MM-dd") ?? Localizer["Open"])</span> }
                                    </pems-table-cell>
                                </pems-table-row>
                            }
                            </pems-table-body>
                        </pems-table>
                    </pems-table-scroll>
                }
            </div>

            @if (Model.RoleNames.Contains("SystemAdmin"))
            {
                <div class="permission-intro"><pems-icon name="bi-infinity" css="me-1" /> @Localizer["This user holds SystemAdmin and bypasses the permission matrix by design."]</div>
            }
            else
            {
                <div class="admin-toolbar mb-2"><div class="admin-toolbar-main"><span class="text-body-secondary small">@Model.AllowedCount / @Model.Rows.Count @Localizer["permissions allowed, via role membership"]</span></div></div>
                <pems-table-scroll>
                    <pems-table kind="enterprise">
                        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Resource"]</pems-table-header><pems-table-header>@Localizer["Action"]</pems-table-header><pems-table-header>@Localizer["Permission"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header></pems-table-row></pems-table-head>
                        <pems-table-body>
                        @foreach (var row in Model.Rows.Where(r => r.Allowed))
                        {
                            <pems-table-row>
                                <pems-table-cell>@row.ResourceName</pems-table-cell>
                                <pems-table-cell>@row.ActionName</pems-table-cell>
                                <pems-table-cell><code>@row.PermissionName</code></pems-table-cell>
                                <pems-table-cell><span class="admin-status active"><pems-icon name="bi-check2-circle" /> @Localizer["Allowed"]</span></pems-table-cell>
                            </pems-table-row>
                        }
                        </pems-table-body>
                    </pems-table>
                </pems-table-scroll>
            }
        }
    </pems-content-card>
</pems-page-shell>
