@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.SecurityEventDto>
@using Microsoft.Extensions.Localization
@using PEMS.Application.Common
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@functions {
    // برچسب روش بازیابی از کلیدهای ثابت (تا تست پوشش ترجمه همه را ببیند)
    string MethodLabel(string method) => method switch
    {
        RecoveryMethods.SecondAdminReset => Localizer["Reset by another administrator"].Value,
        RecoveryMethods.RecoveryCode => Localizer["Recovery code"].Value,
        RecoveryMethods.BreakGlass => Localizer["Server break-glass"].Value,
        RecoveryMethods.VendorToken => Localizer["Vendor token"].Value,
        RecoveryMethods.AdminConsole => Localizer["User edit in the admin panel"].Value,
        _ => method
    };
}
@{
    var selMethod = (string?)ViewBag.Method;
    var selResult = (string?)ViewBag.Result;
    var filterCount = (string.IsNullOrEmpty(selMethod) ? 0 : 1) + (string.IsNullOrEmpty(selResult) ? 0 : 1);
    string Query(string? skip)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(selMethod) && skip != "method") parts.Add($"method={Uri.EscapeDataString(selMethod)}");
        if (!string.IsNullOrEmpty(selResult) && skip != "result") parts.Add($"result={Uri.EscapeDataString(selResult)}");
        return string.Join("&", parts);
    }
    string Without(string key) { var s = Query(key); return Url.Action("Index") + (s.Length > 0 ? "?" + s : ""); }
    string ResultText(string? r) => r == RecoveryResults.Success ? Localizer["Success"].Value : r == RecoveryResults.Failure ? Localizer["Failure"].Value : r ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component; method and result are filters with chips; the records are
   append-only, so the page has no actions. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SeL_Title"]" heading-title="@Localizer["Admin account recovery attempts: who, which method, from where, and whether it succeeded. Records are append-only."]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="seFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="seMethod" name="method" label="@Localizer["Method"]" value="@selMethod"
                                             all-text="@Localizer["All methods"]" items="@RecoveryMethods.All.Select(m => new SelectListItem(MethodLabel(m), m))" />
                    <pems-list-filter-select id="seResult" name="result" label="@Localizer["Result"]" value="@selResult"
                                             all-text="@Localizer["All results"]" items="@(new[] { new SelectListItem(Localizer["Success"].Value, RecoveryResults.Success), new SelectListItem(Localizer["Failure"].Value, RecoveryResults.Failure) })" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="SecurityEvents" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(selMethod)) { <pems-list-chip label="@Localizer["Method"]" value="@MethodLabel(selMethod)" remove-href="@Without("method")" /> }
            @if (!string.IsNullOrEmpty(selResult)) { <pems-list-chip label="@Localizer["Result"]" value="@ResultText(selResult)" remove-href="@Without("result")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="SecurityEvents" empty="@(Model.Items.Count == 0)" empty-text="@Localizer["No admin recovery has been attempted, or the filters match nothing."]">
                <thead>
                    <tr>
                        <th data-col-key="time" data-resizable="true" data-min-width="130" data-max-width="220" style="width:160px">@Localizer["AlL_Time"] (UTC)</th>
                        <th data-col-key="method" data-resizable="true" data-min-width="120" data-max-width="260" style="width:180px">@Localizer["Method"]</th>
                        <th data-col-key="result" data-resizable="true" data-min-width="100" data-max-width="360">@Localizer["Result"]</th>
                        <th data-col-key="actor" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Actor"]</th>
                        <th data-col-key="target" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Target"]</th>
                        <th data-col-key="ip" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px" class="vs-hide-md">@Localizer["IP address"]</th>
                        <th data-col-key="siem" data-resizable="true" data-min-width="70" data-max-width="140" style="width:90px" class="vs-hide-md">SIEM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="small" dir="ltr"><span class="vs-num">@e.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</span></td>
                            <td class="small" title="@e.Method">@MethodLabel(e.Method)</td>
                            <td>
                                @if (e.Result == RecoveryResults.Success) { <span class="vs-pill vs-pill--icon vs-pill--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @Localizer["Success"]</span> }
                                else { <span class="vs-pill vs-pill--icon vs-pill--danger" title="@e.FailureReason"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> @Localizer["Failure"]</span> @if (!string.IsNullOrEmpty(e.FailureReason)) { <span class="vs-sub">@e.FailureReason</span> } }
                            </td>
                            <td class="small"><span class="vs-cell-strong">@(e.ActorUserName ?? "—")</span></td>
                            <td class="small"><span class="vs-cell-strong">@(e.TargetUserName ?? "—")</span></td>
                            <td class="small vs-hide-md" dir="ltr"><span class="vs-num">@(e.IpAddress ?? "—")</span></td>
                            <td class="small vs-hide-md">@(e.Forwarded ? Localizer["Forwarded"] : Localizer["Pending"])</td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "SecurityEvents",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
