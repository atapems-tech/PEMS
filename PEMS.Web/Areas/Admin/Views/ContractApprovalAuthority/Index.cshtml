@model List<PEMS.Domain.Entities.ContractApprovalAuthorityRule>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var roles = (string[])ViewBag.Roles;
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div>
                <p>@Localizer["Contract approval authority by value range and criticality. No thresholds are pre-configured - approval uses the existing role-based gate until at least one rule is added here."]</p>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="content-card">
        <div class="admin-toolbar"><div><strong>@Localizer["Approval Authority Rules"]</strong></div></div>
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr>
                    <th>@Localizer["Priority"]</th><th>@Localizer["Min Value"]</th><th>@Localizer["Max Value"]</th>
                    <th>@Localizer["Criticality"]</th><th>@Localizer["Required Role"]</th><th>@Localizer["Description"]</th>
                    <th>@Localizer["Status"]</th><th></th>
                </tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var formId = $"rule_{r.ContractApprovalAuthorityRuleId}";
                        <tr class="@(r.IsActive ? "" : "text-muted")">
                            <td>
                                <form id="@formId" asp-action="Edit" method="post" class="d-none">
                                    <input type="hidden" name="ruleId" value="@r.ContractApprovalAuthorityRuleId" />
                                </form>
                                <input form="@formId" type="number" name="priority" class="form-control form-control-sm" value="@r.Priority" style="width:80px" />
                            </td>
                            <td><input form="@formId" type="number" step="0.01" name="minValue" class="form-control form-control-sm" value="@r.MinValue" style="width:120px" /></td>
                            <td><input form="@formId" type="number" step="0.01" name="maxValue" class="form-control form-control-sm" value="@r.MaxValue" style="width:120px" /></td>
                            <td><input form="@formId" type="text" name="criticalityClass" class="form-control form-control-sm" value="@r.CriticalityClass" placeholder="@Localizer["Any"]" style="width:80px" /></td>
                            <td>
                                <select form="@formId" name="requiredApproverRole" class="form-select form-select-sm">
                                    @foreach (var role in roles) { <option value="@role" selected="@(role == r.RequiredApproverRole)">@role</option> }
                                </select>
                            </td>
                            <td><input form="@formId" type="text" name="description" class="form-control form-control-sm" value="@r.Description" /></td>
                            <td><span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">@(r.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td>
                            <td class="d-flex gap-1">
                                <button type="submit" form="@formId" class="btn btn-sm btn-outline-primary">@Localizer["Save"]</button>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="ruleId" value="@r.ContractApprovalAuthorityRuleId" />
                                    <input type="hidden" name="isActive" value="@(!r.IsActive)" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(r.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0)
        {
            <div class="admin-empty"><i class="bi bi-shield-check"></i><strong>@Localizer["No approval authority rules configured - existing role-based approval applies"]</strong></div>
        }
    </div>

    <div class="content-card admin-form-card mt-3">
        <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-plus-circle text-primary"></i><h6 class="mb-0">@Localizer["Add Rule"]</h6></div>
        <form asp-action="Create" method="post" class="row g-3 align-items-end">
            <div class="col-md-2"><label class="form-label">@Localizer["Priority"]</label><input type="number" name="priority" class="form-control" value="0" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Min Value"]</label><input type="number" step="0.01" name="minValue" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Max Value"]</label><input type="number" step="0.01" name="maxValue" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">@Localizer["Criticality"]</label><input type="text" name="criticalityClass" class="form-control" placeholder="@Localizer["Any"]" /></div>
            <div class="col-md-2">
                <label class="form-label">@Localizer["Required Role"]</label>
                <select name="requiredApproverRole" class="form-select" required>
                    @foreach (var role in roles) { <option value="@role">@role</option> }
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-pems-solid w-100">@Localizer["Add Rule"]</button></div>
            <div class="col-12"><label class="form-label">@Localizer["Description"]</label><input type="text" name="description" class="form-control" /></div>
        </form>
    </div>
</div>
