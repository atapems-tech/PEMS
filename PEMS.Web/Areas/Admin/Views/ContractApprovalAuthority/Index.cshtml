@model List<PEMS.Domain.Entities.ContractApprovalAuthorityRule>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var roles = (string[])ViewBag.Roles;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 RelatedList: each rule is edited in place (pems-related-row-form / pems-related-save); the add form is under
   the table (pems-related-add). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["Approval Authority Rules"]" heading-title="@Localizer["Contract approval authority by value range and criticality. No thresholds are pre-configured - approval uses the existing role-based gate until at least one rule is added here."]" total="@Model.Count" />

        @if (Model.Count > 0)
        {
            <pems-related-table>
                <thead>
                    <tr>
                        <th class="pems-w-90">@Localizer["Priority"]</th>
                        <th class="pems-w-130">@Localizer["Min Value"]</th>
                        <th class="pems-w-130">@Localizer["Max Value"]</th>
                        <th class="pems-w-100">@Localizer["Criticality"]</th>
                        <th class="pems-w-190">@Localizer["Required Role"]</th>
                        <th>@Localizer["Ed_Description"]</th>
                        <th class="pems-w-100">@Localizer["Ed_Status"]</th>
                        <th class="pems-w-80"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var formId = $"rule_{r.ContractApprovalAuthorityRuleId}";
                        <tr class="@(r.IsActive ? "" : "text-muted")">
                            <td>
                                <pems-related-row-form id="@formId" action="@Url.Action("Edit")">
                                    <input type="hidden" name="ruleId" value="@r.ContractApprovalAuthorityRuleId" />
                                </pems-related-row-form>
                                <pems-input scale="small" form="@formId" type="number" name="priority" value="@r.Priority" aria-label="@Localizer["Priority"]" />
                            </td>
                            <td><pems-input scale="small" form="@formId" type="number" step="0.01" name="minValue" value="@r.MinValue" aria-label="@Localizer["Min Value"]" /></td>
                            <td><pems-input scale="small" form="@formId" type="number" step="0.01" name="maxValue" value="@r.MaxValue" aria-label="@Localizer["Max Value"]" /></td>
                            <td><pems-input scale="small" form="@formId" type="text" name="criticalityClass" value="@r.CriticalityClass" placeholder="@Localizer["Any"]" aria-label="@Localizer["Criticality"]" /></td>
                            <td>
                                <pems-select scale="small" form="@formId" name="requiredApproverRole" aria-label="@Localizer["Required Role"]">
                                    @foreach (var role in roles) { <option value="@role" selected="@(role == r.RequiredApproverRole)">@role</option> }
                                </pems-select>
                            </td>
                            <td><pems-input scale="small" form="@formId" type="text" name="description" value="@r.Description" aria-label="@Localizer["Ed_Description"]" /></td>
                            <td><span class="vs-pill @(r.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@(r.IsActive ? Localizer["Active"] : Localizer["Inactive"])</span></td>
                            <td class="text-end text-nowrap">
                                <pems-related-save form-id="@formId" label="@Localizer["Save"]" />
                                <form asp-action="ToggleActive" method="post" class="lp-rel-inline">
                                    <input type="hidden" name="ruleId" value="@r.ContractApprovalAuthorityRuleId" />
                                    <input type="hidden" name="isActive" value="@(!r.IsActive)" />
                                    <button type="submit" class="lp-act lp-act--always" title="@(r.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])" aria-label="@(r.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])"><pems-icon css="@(r.IsActive ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true" /></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-related-table>
        }
        else
        {
            <p class="lp-rel-empty">@Localizer["No approval authority rules configured - existing role-based approval applies"]</p>
        }

        <pems-related-add action="@Url.Action("Create")" submit-label="@Localizer["Add Rule"]">
            <div class="pems-s-bc0bbd8e"><label class="lp-lbl" for="carPriority">@Localizer["Priority"]</label><pems-input scale="small" id="carPriority" type="number" name="priority" value="0" /></div>
            <div><label class="lp-lbl" for="carMin">@Localizer["Min Value"]</label><pems-input scale="small" id="carMin" type="number" step="0.01" name="minValue" /></div>
            <div><label class="lp-lbl" for="carMax">@Localizer["Max Value"]</label><pems-input scale="small" id="carMax" type="number" step="0.01" name="maxValue" /></div>
            <div><label class="lp-lbl" for="carCrit">@Localizer["Criticality"]</label><pems-input scale="small" id="carCrit" type="text" name="criticalityClass" placeholder="@Localizer["Any"]" /></div>
            <pems-list-filter-select id="carRole" name="requiredApproverRole" label="@Localizer["Required Role"]" items="@roles.Select(role => new SelectListItem(role, role))" />
            <div class="pems-s-8eb047ce"><label class="lp-lbl" for="carDesc">@Localizer["Ed_Description"]</label><pems-input scale="small" id="carDesc" type="text" name="description" /></div>
        </pems-related-add>
    </pems-list-panel>
</pems-list-page>
