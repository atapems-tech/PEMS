@model PEMS.Application.DTOs.PagedResult<PEMS.Domain.Entities.AuthorizationAuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var resourceNames = (List<string>)ViewBag.ResourceNames;
    var decisions = (List<string>)ViewBag.Decisions;
    var userNames = (Dictionary<int, string>)ViewBag.UserNames;
    var qsParts = new List<string>();
    if (ViewBag.SelectedUserId != null) qsParts.Add($"userId={ViewBag.SelectedUserId}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedResourceName)) qsParts.Add($"resourceName={Uri.EscapeDataString((string)ViewBag.SelectedResourceName)}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedActionName)) qsParts.Add($"actionName={Uri.EscapeDataString((string)ViewBag.SelectedActionName)}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedDecision)) qsParts.Add($"decision={Uri.EscapeDataString((string)ViewBag.SelectedDecision)}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedResourceId)) qsParts.Add($"resourceId={Uri.EscapeDataString((string)ViewBag.SelectedResourceId)}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedFromDate)) qsParts.Add($"fromDate={ViewBag.SelectedFromDate}");
    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedToDate)) qsParts.Add($"toDate={ViewBag.SelectedToDate}");
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3"><div><p>@Localizer["Every authorization decision - who, what, why."]</p></div></div>
    </div>
    <div class="content-card">
        <form method="get" class="admin-toolbar flex-wrap">
            <div class="admin-toolbar-main flex-wrap">
                <div><label class="form-label small mb-1">@Localizer["Resource"]</label><select name="resourceName" class="form-select form-select-sm"><option value="">@Localizer["All"]</option>@foreach(var r in resourceNames){<option value="@r" selected="@(r == (string?)ViewBag.SelectedResourceName)">@r</option>}</select></div>
                <div><label class="form-label small mb-1">@Localizer["Action"]</label><input type="search" name="actionName" value="@ViewBag.SelectedActionName" class="form-control form-control-sm" style="width:120px" /></div>
                <div><label class="form-label small mb-1">@Localizer["Decision"]</label><select name="decision" class="form-select form-select-sm"><option value="">@Localizer["All"]</option>@foreach(var d in decisions){<option value="@d" selected="@(d == (string?)ViewBag.SelectedDecision)">@d</option>}</select></div>
                <div><label class="form-label small mb-1">@Localizer["Resource ID"]</label><input type="search" name="resourceId" value="@ViewBag.SelectedResourceId" class="form-control form-control-sm" style="width:100px" /></div>
                <div><label class="form-label small mb-1">@Localizer["From"]</label><input type="date" name="fromDate" value="@ViewBag.SelectedFromDate" class="form-control form-control-sm" /></div>
                <div><label class="form-label small mb-1">@Localizer["To"]</label><input type="date" name="toDate" value="@ViewBag.SelectedToDate" class="form-control form-control-sm" /></div>
            </div>
            <div class="admin-toolbar-actions">
                <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-funnel me-1"></i> @Localizer["Apply filters"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Reset"]</a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Time"]</th><th>@Localizer["User"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Resource ID"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Reason"]</th><th>@Localizer["Scope"]</th></tr></thead>
                <tbody>
                @foreach (var log in Model.Items)
                {
                    var badge = log.Decision == "Allow" ? "active" : "locked";
                    <tr>
                        <td class="row-secondary">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(log.UserId.HasValue && userNames.TryGetValue(log.UserId.Value, out var un) ? un : (log.UserId?.ToString() ?? "—"))</td>
                        <td><code>@($"{log.ResourceName}.{log.ActionName}")</code></td>
                        <td class="row-secondary">@(log.ResourceId ?? "—")</td>
                        <td><span class="admin-status @badge">@log.Decision</span></td>
                        <td class="row-secondary" title="@log.Reason">@log.Reason</td>
                        <td class="row-secondary">@(log.ScopeType == null ? "—" : $"{log.ScopeType}={log.ScopeValue}")</td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.Items.Count == 0) { <div class="admin-empty"><i class="bi bi-journal-check"></i><strong>@Localizer["No authorization events found"]</strong></div> }
        </div>
        @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            PageSize = Model.PageSize,
            GridKey = "AuthorizationAudit",
            BaseUrl = Url.Action("Index") ?? "",
            ExistingQueryString = string.Join("&", qsParts)
        })
    </div>
</div>
