@model List<PEMS.Web.Security.NavigationModuleNode>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Security
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS Phase 6 — Hierarchical Role/Discipline Visibility Correction»: این صفحه همیشه
    // از روی سلسله‌مراتب واقعی ناوبری (Module -> [Subgroup ->] Item -> Role/Discipline) رندر
    // می‌شود - هیچ Permission هرگز همشأن یک آیتم ناوبری ظاهر نمی‌شود؛ فقط به‌صورت یک خط Metadata
    // («Capability: X.View») زیر همان آیتم. عمداً بدون Local Function/Partial حاوی Tag Helper
    // (asp-action و امثالش فقط در Scope مستقیم صفحه قابل‌اتکا کامپایل می‌شوند) - برای امنیت
    // کامپایل، مارک‌آپ آیتم دوبار (برای module.Items و subgroup.Items) عیناً تکرار شده، نه از
    // طریق یک تابع محلی مشترک.

    string RoleIcon(NavigationRoleAccess r) => r.EffectiveVisible ? "bi-check-lg text-success" : "bi-dash text-body-tertiary";
    var setOverrideUrl = Url.Action("SetOverride");
    var clearOverrideUrl = Url.Action("ClearOverride");
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["Choose which sidebar sections a Role sees. This never changes what a Role is allowed to do - only what it sees by default."]</p></div>
        </div>
    </div>
    <div class="content-card">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><a class="nav-link active" asp-action="Index">@Localizer["By Role"]</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="EffectiveUser">@Localizer["By User"]</a></li>
        </ul>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2">@TempData["Success"]</div>
        }

        <div class="permission-intro mb-3">
            <i class="bi bi-diagram-3 me-1"></i>
            @Localizer["This tree mirrors the real sidebar. Expand a section to see its items; expand an item to see which roles see it and why."]
        </div>

        @foreach (var module in Model)
        {
            <details class="navvis-module mb-2">
                <summary class="navvis-module-summary">
                    <span class="navvis-title">@Localizer[module.DisplayLocalizationKey]</span>
                    @if (!module.HasDrillDown)
                    {
                        var visibleCount = module.RoleAccess.Count(r => r.EffectiveVisible);
                        <span class="badge @(visibleCount > 0 ? "text-bg-success" : "text-bg-secondary") ms-2">@visibleCount / @module.RoleAccess.Count @Localizer["Roles"]</span>
                    }
                </summary>

                @if (!module.HasDrillDown)
                {
                    <div class="navvis-role-grid" id="node-@(module.ModuleKey)-">
                        @foreach (var r in module.RoleAccess)
                        {
                            <div class="navvis-role-pill">
                                <i class="bi @RoleIcon(r)"></i>
                                <span>@r.RoleName</span>
                                @if (r.HasOverride)
                                {
                                    <span class="text-body-tertiary" title="@Localizer["Manual override"]"><i class="bi bi-pencil-fill" style="font-size:10px"></i></span>
                                }
                                <form method="post" action="@setOverrideUrl">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roleId" value="@r.RoleId" />
                                    <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                    <input type="hidden" name="isVisible" value="true" />
                                    <button type="submit" title="@Localizer["Force visible for this role"]"><i class="bi bi-eye"></i></button>
                                </form>
                                <form method="post" action="@setOverrideUrl">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roleId" value="@r.RoleId" />
                                    <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                    <input type="hidden" name="isVisible" value="false" />
                                    <button type="submit" title="@Localizer["Force hidden for this role"]"><i class="bi bi-eye-slash"></i></button>
                                </form>
                                @if (r.HasOverride)
                                {
                                    <form method="post" action="@clearOverrideUrl">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roleId" value="@r.RoleId" />
                                        <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                        <button type="submit" title="@Localizer["Clear override - back to default"]"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="navvis-children">
                        @foreach (var item in module.Items)
                        {
                            <details class="navvis-item" id="node-@(module.ModuleKey)-@(item.ItemKey)">
                                <summary class="navvis-item-summary">
                                    <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                    <span class="badge @(item.AnyRoleVisible ? "text-bg-success" : "text-bg-secondary")">@item.RoleAccess.Count(r => r.EffectiveVisible) / @item.RoleAccess.Count @Localizer["Roles"]</span>
                                    <span class="navvis-capability">@Localizer["Capability"]: @(item.Capability ?? Localizer["None - not permission-gated"].Value)</span>
                                </summary>
                                <div class="navvis-role-grid">
                                    @foreach (var r in item.RoleAccess)
                                    {
                                        <div class="navvis-role-pill">
                                            <i class="bi @RoleIcon(r)"></i>
                                            <span>@r.RoleName</span>
                                            @if (r.HasOverride)
                                            {
                                                <span class="text-body-tertiary" title="@Localizer["Manual override"]"><i class="bi bi-pencil-fill" style="font-size:10px"></i></span>
                                            }
                                            <form method="post" action="@setOverrideUrl">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="roleId" value="@r.RoleId" />
                                                <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                <input type="hidden" name="isVisible" value="true" />
                                                <button type="submit" title="@Localizer["Force visible for this role"]"><i class="bi bi-eye"></i></button>
                                            </form>
                                            <form method="post" action="@setOverrideUrl">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="roleId" value="@r.RoleId" />
                                                <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                <input type="hidden" name="isVisible" value="false" />
                                                <button type="submit" title="@Localizer["Force hidden for this role"]"><i class="bi bi-eye-slash"></i></button>
                                            </form>
                                            @if (r.HasOverride)
                                            {
                                                <form method="post" action="@clearOverrideUrl">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="roleId" value="@r.RoleId" />
                                                    <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                    <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                    <button type="submit" title="@Localizer["Clear override - back to default"]"><i class="bi bi-arrow-counterclockwise"></i></button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                        @foreach (var subgroup in module.Subgroups)
                        {
                            <details class="navvis-subgroup" open="@(subgroup.AnyRoleVisible ? "open" : null)">
                                <summary class="navvis-subgroup-summary">@Localizer[subgroup.Label]</summary>
                                <div class="navvis-children">
                                    @foreach (var item in subgroup.Items)
                                    {
                                        <details class="navvis-item" id="node-@(module.ModuleKey)-@(item.ItemKey)">
                                            <summary class="navvis-item-summary">
                                                <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                                <span class="badge @(item.AnyRoleVisible ? "text-bg-success" : "text-bg-secondary")">@item.RoleAccess.Count(r => r.EffectiveVisible) / @item.RoleAccess.Count @Localizer["Roles"]</span>
                                                <span class="navvis-capability">@Localizer["Capability"]: @(item.Capability ?? Localizer["None - not permission-gated"].Value)</span>
                                            </summary>
                                            <div class="navvis-role-grid">
                                                @foreach (var r in item.RoleAccess)
                                                {
                                                    <div class="navvis-role-pill">
                                                        <i class="bi @RoleIcon(r)"></i>
                                                        <span>@r.RoleName</span>
                                                        @if (r.HasOverride)
                                                        {
                                                            <span class="text-body-tertiary" title="@Localizer["Manual override"]"><i class="bi bi-pencil-fill" style="font-size:10px"></i></span>
                                                        }
                                                        <form method="post" action="@setOverrideUrl">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="roleId" value="@r.RoleId" />
                                                            <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                            <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                            <input type="hidden" name="isVisible" value="true" />
                                                            <button type="submit" title="@Localizer["Force visible for this role"]"><i class="bi bi-eye"></i></button>
                                                        </form>
                                                        <form method="post" action="@setOverrideUrl">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="roleId" value="@r.RoleId" />
                                                            <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                            <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                            <input type="hidden" name="isVisible" value="false" />
                                                            <button type="submit" title="@Localizer["Force hidden for this role"]"><i class="bi bi-eye-slash"></i></button>
                                                        </form>
                                                        @if (r.HasOverride)
                                                        {
                                                            <form method="post" action="@clearOverrideUrl">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="roleId" value="@r.RoleId" />
                                                                <input type="hidden" name="moduleKey" value="@module.ModuleKey" />
                                                                <input type="hidden" name="itemKey" value="@item.ItemKey" />
                                                                <button type="submit" title="@Localizer["Clear override - back to default"]"><i class="bi bi-arrow-counterclockwise"></i></button>
                                                            </form>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
            </details>
        }
    </div>
</div>

<style>
    .navvis-module { border: 1px solid var(--bs-border-color); border-radius: 8px; padding: 2px 12px; background: var(--bs-body-bg); }
    .navvis-module-summary { cursor: pointer; padding: 10px 4px; font-weight: 600; display: flex; align-items: center; }
    .navvis-title { flex: 1 1 auto; }
    .navvis-subgroup { margin: 6px 0 6px 18px; border-left: 2px solid var(--bs-border-color); padding-left: 12px; }
    .navvis-subgroup-summary { cursor: pointer; font-weight: 500; padding: 6px 0; color: var(--bs-secondary-color); }
    .navvis-children { padding: 2px 0 10px 18px; }
    .navvis-item { border-top: 1px dashed var(--bs-border-color); padding: 8px 0; }
    .navvis-item:first-child { border-top: none; }
    .navvis-item-summary { cursor: pointer; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .navvis-item-name { font-weight: 500; }
    .navvis-capability { font-family: var(--bs-font-monospace); font-size: 11.5px; color: var(--bs-secondary-color); }
    .navvis-role-grid { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 0 6px; }
    .navvis-role-pill { display: flex; align-items: center; gap: 6px; border: 1px solid var(--bs-border-color); border-radius: 999px; padding: 3px 6px 3px 10px; font-size: 12.5px; }
    .navvis-role-pill form { display: inline-flex; }
    .navvis-role-pill button { border: none; background: transparent; padding: 2px 4px; line-height: 1; border-radius: 50%; }
    .navvis-role-pill button:hover { background: var(--bs-secondary-bg); }
</style>
