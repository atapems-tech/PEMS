@model PEMS.Web.Areas.Admin.Models.NavigationVisibilityUserVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS Phase 6 — Hierarchical Role/Discipline Visibility Correction» بند ۹: همان
    // سلسله‌مراتب ناوبری‌محور Index.cshtml، این‌بار برای یک کاربر مشخص (نه شبکه‌ی چندنقشی - فقط
    // یک ✓/✕ نهایی برای هر گره، چون نتیجه‌ی Union همه‌ی نقش‌های همین کاربر از پیش محاسبه شده).
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["See exactly what a specific user's sidebar looks like right now - a read-only preview, never a real sign-in as that user."]</p></div>
        </div>
    </div>
    <div class="content-card">
        <pems-nav css="mb-3">
            <li class="nav-item"><a class="nav-link" asp-action="Index">@Localizer["By Role"]</a></li>
            <li class="nav-item"><a class="nav-link active" asp-action="EffectiveUser">@Localizer["By User"]</a></li>
        </pems-nav>

        <form method="get" class="d-flex gap-2 align-items-end mb-3 pems-s-0fd8744d">
            <div class="flex-grow-1">
                <pems-label>@Localizer["User"]</pems-label>
                <pems-select name="userId" onchange="this.form.submit()">
                    <option value="">@Localizer["— select a user —"]</option>
                    @foreach (var u in Model.AllUsers)
                    {
                        <option value="@u.Id" selected="@(u.Id == Model.SelectedUserId)">@u.Display</option>
                    }
                </pems-select>
            </div>
            <pems-button tone="primary" type="submit">@Localizer["Preview"]</pems-button>
        </form>

        @if (Model.SelectedUserId == null)
        {
            <div class="admin-empty"><pems-icon name="bi-person-badge" /><strong>@Localizer["Choose a user above"]</strong></div>
        }
        else
        {
            <div class="permission-intro mb-3">
                <pems-icon name="bi-info-circle" css="me-1" />
                @Localizer["Roles"]: <strong>@string.Join(", ", Model.RoleNames)</strong>
                <div class="text-body-secondary small mt-1">@Localizer["This is a visualization only - it does not sign in as this user, and hidden items may still be reachable by direct URL if the user is actually authorized (Hidden is not the same as Unauthorized)."]</div>
            </div>

            @foreach (var module in Model.Tree)
            {
                <details class="navvis-module mb-2" open="@(module.Visible ? "open" : null)">
                    <summary class="navvis-module-summary">
                        @if (module.Visible)
                        {
                            <pems-icon name="bi-check-lg" css="text-success" />
                        }
                        else
                        {
                            <pems-icon name="bi-dash" css="text-body-tertiary" />
                        }
                        <span class="navvis-title">@Localizer[module.DisplayLocalizationKey]</span>
                    </summary>

                    @if (module.Visible && module.HasDrillDown)
                    {
                        <div class="navvis-children">
                            @foreach (var item in module.Items)
                            {
                                <div class="navvis-item navvis-item-flat">
                                    @if (item.Visible)
                                    {
                                        <pems-icon name="bi-check-lg" css="text-success" />
                                    }
                                    else
                                    {
                                        <pems-icon name="bi-dash" css="text-body-tertiary" />
                                    }
                                    <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                    <span class="navvis-capability">@Localizer["Capability"]: @(item.Capability ?? Localizer["None - not permission-gated"].Value)</span>
                                </div>
                            }
                            @foreach (var subgroup in module.Subgroups)
                            {
                                <details class="navvis-subgroup" open="@(subgroup.AnyVisible ? "open" : null)">
                                    <summary class="navvis-subgroup-summary">@Localizer[subgroup.Label]</summary>
                                    <div class="navvis-children">
                                        @foreach (var item in subgroup.Items)
                                        {
                                            <div class="navvis-item navvis-item-flat">
                                                @if (item.Visible)
                                                {
                                                    <pems-icon name="bi-check-lg" css="text-success" />
                                                }
                                                else
                                                {
                                                    <pems-icon name="bi-dash" css="text-body-tertiary" />
                                                }
                                                <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                                <span class="navvis-capability">@Localizer["Capability"]: @(item.Capability ?? Localizer["None - not permission-gated"].Value)</span>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                </details>
            }
        }
    </div>
</div>

@section Styles { <link rel="stylesheet" href="~/css/pems-navvis-effective-user.css" asp-append-version="true" /> }
