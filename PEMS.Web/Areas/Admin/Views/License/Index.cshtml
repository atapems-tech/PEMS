@model PEMS.Web.Licensing.LicensePageModel
@using Microsoft.Extensions.Localization
@using PEMS.Licensing.Evaluation
@using PEMS.Licensing.Formats
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Status;
    var badge = s.State switch
    {
        LicenseState.Active => "bg-success",
        LicenseState.ActiveWarning => "bg-warning text-dark",
        LicenseState.NotEnforced => "bg-secondary",
        _ => "bg-danger"
    };
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div><p>@Localizer["Lic_Intro"]</p></div>
    </div>

    @if (message != null) { <pems-alert tone="success">@Localizer[message]</pems-alert> }
    @if (error != null) { <pems-alert tone="danger">@Localizer[error]</pems-alert> }
    @if (!Model.Enforce)
    {
        <pems-alert tone="info">@Localizer["Lic_EnforceOff"]</pems-alert>
    }

    <div class="content-card mb-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <pems-badge tone="none" css="fs-6 @badge">@Localizer["Lic_State_" + s.State]</pems-badge>
            @foreach (var r in s.Reasons) { <pems-badge tone="light">@Localizer["Lic_Reason_" + r]</pems-badge> }
        </div>
        <pems-row gap="3" css="mt-2">
            <pems-col md="4" span="12"><div class="small fw-bold"><code>@(s.InstallId ?? "-")</code></div><div class="text-muted small">@Localizer["Lic_InstallId"]</div></pems-col>
            <pems-col md="2" span="6"><div class="small fw-bold"><code>@(s.FingerprintShort ?? "-")</code></div><div class="text-muted small">@Localizer["Lic_Fingerprint"]</div></pems-col>
            <pems-col md="2" span="6"><div class="small fw-bold">@(s.LicenceType ?? "-")</div><div class="text-muted small">@Localizer["Lic_Type"]</div></pems-col>
            <pems-col md="2" span="6"><div class="small fw-bold">@(s.ExpiresUtc is null ? Localizer["Lic_NoExpiry"].Value : LicenseDates.ToJalaliString(s.ExpiresUtc.Value.AddSeconds(-1)))</div><div class="text-muted small">@Localizer["Lic_ValidUntil"]</div></pems-col>
            <pems-col md="2" span="6"><div class="small fw-bold">@(s.UpdatesUntil is null ? "-" : LicenseDates.ToJalaliString(s.UpdatesUntil.Value.AddSeconds(-1)))</div><div class="text-muted small">@Localizer["Lic_UpdatesUntil"]</div></pems-col>
        </pems-row>
    </div>

    <div class="content-card mb-3">
        <h6>@Localizer["Lic_RequestTitle"]</h6>
        <p class="text-muted small">@Localizer["Lic_RequestHelp"]</p>
        <form asp-action="Request" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <pems-col md="3" span="12">
                <pems-label for="requestType">@Localizer["Lic_RequestType"]</pems-label>
                <pems-select id="requestType" name="requestType">
                    @foreach (var t in RequestTypes.All) { <option value="@t">@Localizer["Lic_Req_" + t]</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3" span="6">
                <pems-label for="customerRef">@Localizer["Lic_CustomerRef"]</pems-label>
                <pems-input id="customerRef" name="customerRef" maxlength="64" required />
            </pems-col>
            <pems-col md="3" span="6">
                <pems-label for="orderRef">@Localizer["Lic_OrderRef"]</pems-label>
                <pems-input id="orderRef" name="orderRef" maxlength="64" />
            </pems-col>
            <pems-col md="3" span="12">
                <pems-label for="reason">@Localizer["Lic_Reason"]</pems-label>
                <pems-input id="reason" name="reason" maxlength="500" />
            </pems-col>
            <pems-col span="12"><pems-button tone="primary" type="submit"><pems-icon name="bi-download" css="me-1" /> @Localizer["Lic_DownloadRequest"]</pems-button></pems-col>
        </form>
    </div>

    <div class="content-card">
        <h6>@Localizer["Lic_UploadTitle"]</h6>
        <p class="text-muted small">@Localizer["Lic_UploadHelp"]</p>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-3 flex-wrap">
            @Html.AntiForgeryToken()
            <pems-input css="w-auto" type="file" name="file" accept=".pemslic,.zip" required aria-label="@Localizer["Lic_UploadTitle"]" />
            <pems-button tone="primary" type="submit"><pems-icon name="bi-upload" css="me-1" /> @Localizer["Lic_Upload"]</pems-button>
        </form>
    </div>
</div>
