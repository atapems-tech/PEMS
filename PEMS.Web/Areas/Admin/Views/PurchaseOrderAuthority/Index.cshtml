@model IReadOnlyList<PEMS.Application.Interfaces.PoAuthorityRuleView>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-470: the PO authority table (separate from the contract rules)
    var roles = (IEnumerable<string>)ViewBag.Roles;
}

@if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div> }

<div class="content-card mb-3">
    <h5 class="mb-1"><i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["Po_AuthorityTitle"]</h5>
    <p class="small text-muted mb-0">@Localizer["Po_AuthorityHint"]</p>
</div>

<div class="content-card mb-3">
    @if (Model.Count == 0)
    {
        <p class="small text-muted mb-0">@Localizer["Po_NoRules"]</p>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-enterprise table-sm align-middle mb-0">
            <thead><tr><th>@Localizer["Po_Level"]</th><th>@Localizer["Po_Currency"]</th><th class="text-end">@Localizer["Po_From"]</th><th class="text-end">@Localizer["Po_To"]</th><th>@Localizer["Po_ApproverRole"]</th><th>@Localizer["Description"]</th><th>@Localizer["Status"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td dir="ltr">@r.Level</td>
                    <td dir="ltr">@r.Currency</td>
                    <td class="text-end" dir="ltr">@r.MinAmount.ToString("N0")</td>
                    <td class="text-end" dir="ltr">@(r.MaxAmount?.ToString("N0") ?? "∞")</td>
                    <td dir="ltr">@r.ApproverRole</td>
                    <td class="small">@r.Description</td>
                    <td><span class="vs-pill @(r.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@Localizer[r.IsActive ? "Po_Active" : "Po_Inactive"]</span></td>
                    <td class="text-end">
                        <form asp-action="Save" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="level" value="@r.Level" />
                            <input type="hidden" name="minAmount" value="@r.MinAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="maxAmount" value="@r.MaxAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="currency" value="@r.Currency" /><input type="hidden" name="approverRole" value="@r.ApproverRole" />
                            <input type="hidden" name="description" value="@r.Description" /><input type="hidden" name="isActive" value="@((!r.IsActive).ToString().ToLowerInvariant())" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer[r.IsActive ? "Po_Deactivate" : "Po_Activate"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }
</div>

<form asp-action="Save" method="post" class="content-card">
    <h6 class="mb-2"><i class="bi bi-plus-circle" aria-hidden="true"></i> @Localizer["Po_NewRule"]</h6>
    <div class="row g-2 align-items-end small">
        <div class="col-md-1"><label class="form-label" for="rLevel">@Localizer["Po_Level"]</label><input id="rLevel" name="level" type="number" min="1" value="1" class="form-control form-control-sm" dir="ltr" required /></div>
        <div class="col-md-1"><label class="form-label" for="rCurrency">@Localizer["Po_Currency"]</label><input id="rCurrency" name="currency" value="IRR" maxlength="10" class="form-control form-control-sm" dir="ltr" required /></div>
        <div class="col-md-2"><label class="form-label" for="rMin">@Localizer["Po_From"]</label><input id="rMin" name="minAmount" type="number" min="0" step="any" value="0" class="form-control form-control-sm" dir="ltr" required /></div>
        <div class="col-md-2"><label class="form-label" for="rMax">@Localizer["Po_To"]</label><input id="rMax" name="maxAmount" type="number" min="0" step="any" class="form-control form-control-sm" dir="ltr" placeholder="∞" /></div>
        <div class="col-md-2"><label class="form-label" for="rRole">@Localizer["Po_ApproverRole"]</label>
            <select id="rRole" name="approverRole" class="form-select form-select-sm" required><option value="">—</option>@foreach (var role in roles) { <option value="@role">@role</option> }</select></div>
        <div class="col-md-2"><label class="form-label" for="rDesc">@Localizer["Description"]</label><input id="rDesc" name="description" class="form-control form-control-sm" /></div>
        <div class="col-md-1"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="isActive" value="true" id="rActive" checked /><label class="form-check-label" for="rActive">@Localizer["Po_Active"]</label></div></div>
        <div class="col-md-auto"><button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @Localizer["Po_SaveRule"]</button></div>
    </div>
</form>
