@model IReadOnlyList<PEMS.Application.Interfaces.PoAuthorityRuleView>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-470: the PO authority table (separate from the contract rules)
    var roles = (IEnumerable<string>)ViewBag.Roles;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component. The rule form opens from the toolbar ("New rule",
   pems-list-popover); activate / deactivate stays on each rule. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Po_AuthorityTitle"]" heading-title="@Localizer["Po_AuthorityHint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-popover id="poRuleNew" icon="bi-plus-lg" label="@Localizer["Po_NewRule"]" primary="true">
                    <form asp-action="Save" method="post">
                        <div>
                            <label class="lp-lbl" for="rLevel">@Localizer["Po_Level"]</label>
                            <pems-input id="rLevel" name="level" type="number" min="1" value="1" dir="ltr" required />
                        </div>
                        <div>
                            <label class="lp-lbl" for="rCurrency">@Localizer["Po_Currency"]</label>
                            <pems-input id="rCurrency" name="currency" value="IRR" maxlength="10" dir="ltr" required />
                        </div>
                        <div>
                            <label class="lp-lbl" for="rMin">@Localizer["Po_From"]</label>
                            <pems-input id="rMin" name="minAmount" type="number" min="0" step="any" value="0" dir="ltr" required />
                        </div>
                        <div>
                            <label class="lp-lbl" for="rMax">@Localizer["Po_To"]</label>
                            <pems-input id="rMax" name="maxAmount" type="number" min="0" step="any" dir="ltr" placeholder="∞" />
                        </div>
                        <pems-list-filter-select id="rRole" name="approverRole" label="@Localizer["Po_ApproverRole"]" all-text="—" items="@roles.Select(r => new SelectListItem(r, r))" />
                        <div>
                            <label class="lp-lbl" for="rDesc">@Localizer["Ed_Description"]</label>
                            <pems-input id="rDesc" name="description" />
                        </div>
                        <pems-check-row css="small">
                            <pems-input kind="check" type="checkbox" name="isActive" value="true" id="rActive" checked />
                            <label class="form-check-label" for="rActive">@Localizer["Po_Active"]</label>
                        </pems-check-row>
                        <div class="lp-fp-foot px-0 pb-0">
                            <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-check2" aria-hidden="true" /> @Localizer["Po_SaveRule"]</pems-button>
                        </div>
                    </form>
                </pems-list-popover>
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["Po_NoRules"]">
                <thead>
                    <tr>
                        <th class="pems-w-70">@Localizer["Po_Level"]</th>
                        <th class="pems-w-90">@Localizer["Po_Currency"]</th>
                        <th class="text-end pems-w-140">@Localizer["Po_From"]</th>
                        <th class="text-end pems-w-140">@Localizer["Po_To"]</th>
                        <th class="pems-w-170">@Localizer["Po_ApproverRole"]</th>
                        <th>@Localizer["Ed_Description"]</th>
                        <th class="pems-w-110">@Localizer["Ed_Status"]</th>
                        <th class="pems-w-60"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr class="lp-row">
                        <td dir="ltr"><span class="vs-num">@r.Level</span></td>
                        <td dir="ltr"><span class="vs-num">@r.Currency</span></td>
                        <td class="text-end" dir="ltr"><span class="vs-num">@r.MinAmount.ToString("N0")</span></td>
                        <td class="text-end" dir="ltr"><span class="vs-num">@(r.MaxAmount?.ToString("N0") ?? "∞")</span></td>
                        <td dir="ltr" class="small">@r.ApproverRole</td>
                        <td class="small"><span class="vs-title-cell" title="@r.Description">@r.Description</span></td>
                        <td><span class="vs-pill @(r.IsActive ? "vs-pill--success" : "vs-pill--neutral")">@Localizer[r.IsActive ? "Po_Active" : "Po_Inactive"]</span></td>
                        <td class="text-end">
                            <form asp-action="Save" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="level" value="@r.Level" />
                                <input type="hidden" name="minAmount" value="@r.MinAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="maxAmount" value="@r.MaxAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="currency" value="@r.Currency" /><input type="hidden" name="approverRole" value="@r.ApproverRole" />
                                <input type="hidden" name="description" value="@r.Description" /><input type="hidden" name="isActive" value="@((!r.IsActive).ToString().ToLowerInvariant())" />
                                <button type="submit" class="lp-act lp-act--always" title="@Localizer[r.IsActive ? "Po_Deactivate" : "Po_Activate"]" aria-label="@Localizer[r.IsActive ? "Po_Deactivate" : "Po_Activate"]"><pems-icon css="@(r.IsActive ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true" /></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
