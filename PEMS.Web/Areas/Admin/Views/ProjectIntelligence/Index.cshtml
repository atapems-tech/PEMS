@model PEMS.Web.Areas.Admin.Models.ProjectIntelligenceReport
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var reportMissing = ViewBag.ReportMissing != null && (bool)ViewBag.ReportMissing;
    var parseError = ViewBag.ParseError != null && (bool)ViewBag.ParseError;
    var sorted = Model.Modules.OrderBy(m => m.EvidenceCoveragePct).ThenBy(m => m.Module).ToList();
}

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" gap="3">
            <div>
                <p>Evidence-based module scan - not a manually estimated progress number. Every bar below is computed from source, DbContext, migrations, views, sidebar nav, tests, docs and git history.</p>
            </div>
        </pems-flex>
        <pems-form asp-action="Refresh" method="post" id="refreshForm">
            <pems-button tone="primary" type="submit" id="refreshBtn">
                <pems-icon name="bi-arrow-clockwise" /> @Localizer["Refresh scan"]
            </pems-button>
        </pems-form>
    </pems-page-hero>

    @if (TempData["Message"] != null)
    {
        <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
    }
    @if (TempData["Error"] != null)
    {
        <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
    }

    @if (reportMissing)
    {
        <pems-content-card>
            <div class="admin-empty">
                <pems-icon name="bi-clipboard-x" />
                <strong>No report found yet</strong>
                <div class="mt-2">
                    @if (parseError)
                    {
                        <p class="text-danger">A report file exists at this path but could not be parsed as JSON. Click "Refresh scan" above to regenerate it.</p>
                    }
                    <p>Click "Refresh scan" above, or run the generator manually from the repository root:</p>
                    <code>powershell -File scripts/project-intelligence/Generate-ProjectIntelligence.ps1</code>
                    <p class="text-body-secondary small mt-2">Expected file: <code>@ViewBag.ReportPath</code></p>
                </div>
            </div>
        </pems-content-card>
    }
    else
    {
        <pems-content-card css="mb-3">
            <pems-stat-grid>
                <pems-stat label="Modules scanned">@Model.ModuleCount</pems-stat>
                <pems-stat label="Redirect shims">@Model.StubShimCount</pems-stat>
                <pems-stat label="No Razor views found">@Model.NoUiCount</pems-stat>
                <pems-stat label="Not in sidebar nav">@Model.NotInNavCount</pems-stat>
            </pems-stat-grid>
            <div class="admin-footer">
                <span>Branch <strong>@Model.Branch</strong> - last commit <code>@Model.LastCommit</code></span>
                <span>Generated @(Model.GeneratedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-") UTC - @Model.NoTestCount / @Model.ModuleCount modules have no reference found in PEMS.Tests</span>
            </div>
        </pems-content-card>

        <pems-content-card css="mb-3">
            <div class="admin-toolbar">
                <div class="admin-toolbar-main">
                    <div class="input-group admin-search">
                        <span class="input-group-text"><pems-icon name="bi-search" /></span>
                        <pems-input type="search" id="moduleSearch" placeholder="Filter by module name..." autocomplete="off" />
                    </div>
                    <span class="text-body-secondary small">Sorted by evidence coverage, lowest (needs the most attention) first.</span>
                </div>
            </div>
        </pems-content-card>

        <pems-row gap="3" id="moduleGrid">
            @foreach (var m in sorted)
            {
                var presentPct = m.EvidenceTotal == 0 ? 0 : (int)Math.Round(100.0 * m.EvidencePresent / m.EvidenceTotal);
                var unknownPct = m.EvidenceTotal == 0 ? 0 : (int)Math.Round(100.0 * m.EvidenceUnknown / m.EvidenceTotal);
                var missingPct = Math.Max(0, 100 - presentPct - unknownPct);
                var barColor = presentPct >= 75 ? "success" : (presentPct >= 45 ? "warning" : "danger");

                <pems-col md="6" xl="4" css="module-card" data-module="@m.Module.ToLower()">
                    <pems-content-card css="h-100 p-3">
                        <pems-flex justify="between" align="start" css="mb-2">
                            <div>
                                <div class="row-primary">
                                    @m.Module
                                    @if (!string.IsNullOrEmpty(m.Area))
                                    {
                                        <span class="admin-role-badge ms-1">@m.Area</span>
                                    }
                                    @if (m.IsRedirectShim)
                                    {
                                        <span class="admin-status inactive ms-1">redirect shim</span>
                                    }
                                </div>
                                <div class="row-secondary">@m.ControllerPath</div>
                            </div>
                            <span class="fw-bold">@m.EvidenceCoveragePct%</span>
                        </pems-flex>

                        <pems-progress value="@presentPct" tone="@barColor" height="8px" css="mb-2" title="@m.EvidencePresent present / @m.EvidenceUnknown unknown / @(m.EvidenceTotal - m.EvidencePresent - m.EvidenceUnknown) missing (of @m.EvidenceTotal signals)">
                            <pems-progress-segment value="@unknownPct" tone="neutral" />
                            <pems-progress-segment value="@missingPct" tone="danger" />
                        </pems-progress>

                        <pems-flex wrap="true" gap="2" css="small text-body-secondary mb-2">
                            <span><pems-icon name="bi-signpost" /> @m.ActionCount actions</span>
                            <span><pems-icon name="bi-file-earmark-richtext" /> @m.ViewCount views</span>
                            <span><i class="@(m.InSidebarNav ? "bi bi-list-check text-success" : "bi bi-list text-danger")"></i> nav</span>
                            <span><i class="@(m.InTests ? "bi bi-check2-square text-success" : "bi bi-square text-danger")"></i> tests</span>
                            <span><i class="@(m.InDocs ? "bi bi-book text-success" : "bi bi-book text-danger")"></i> docs</span>
                        </pems-flex>

                        <details>
                            <summary class="small text-primary pems-s-3b6a3a65">@Localizer["Evidence checklist"]</summary>
                            <pems-table scale="small" css="mb-0 mt-2">
                                <pems-table-body>
                                @foreach (var kv in m.Evidence)
                                {
                                    var valClass = kv.Value == "Present" || kv.Value == "Yes" ? "text-success" : (kv.Value == "Unknown" ? "text-body-secondary" : "text-danger");
                                    <pems-table-row><pems-table-cell class="row-secondary py-1">@kv.Key</pems-table-cell><pems-table-cell class="py-1 @valClass">@kv.Value</pems-table-cell></pems-table-row>
                                }
                                </pems-table-body>
                            </pems-table>
                            <div class="row-secondary small mt-1">
                                Services: @(m.InjectedServices.Count > 0 ? string.Join(", ", m.InjectedServices) : "(none detected)")<br />
                                Views checked: <code>@m.ViewsPath</code><br />
                                Git: last touched @(m.GitLastTouched ?? "unknown"), @m.GitCommitCount commit(s)<br />
                                Graphify connectivity: @m.GraphConnectivity edge(s)
                            </div>
                        </details>
                    </pems-content-card>
                </pems-col>
            }
        </pems-row>
    }
</pems-page-shell>

@section Scripts {
<pems-script-templates set="project-intelligence"></pems-script-templates>
<script src="~/js/views/admin-projectintelligence-index.js" asp-append-version="true"></script>
}
