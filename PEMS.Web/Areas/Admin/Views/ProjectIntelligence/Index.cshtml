@model PEMS.Web.Areas.Admin.Models.ProjectIntelligenceReport
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var reportMissing = ViewBag.ReportMissing != null && (bool)ViewBag.ReportMissing;
    var parseError = ViewBag.ParseError != null && (bool)ViewBag.ParseError;
    var sorted = Model.Modules.OrderBy(m => m.EvidenceCoveragePct).ThenBy(m => m.Module).ToList();
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div>
                <p>Evidence-based module scan - not a manually estimated progress number. Every bar below is computed from source, DbContext, migrations, views, sidebar nav, tests, docs and git history.</p>
            </div>
        </div>
        <form asp-action="Refresh" method="post" id="refreshForm">
            <button type="submit" class="btn btn-pems-solid" id="refreshBtn">
                <i class="bi bi-arrow-clockwise"></i> @Localizer["Refresh scan"]
            </button>
        </form>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
    }

    @if (reportMissing)
    {
        <div class="content-card">
            <div class="admin-empty">
                <i class="bi bi-clipboard-x"></i>
                <strong>No report found yet</strong>
                <div class="mt-2">
                    @if (parseError)
                    {
                        <p class="text-danger">A report file exists at this path but could not be parsed as JSON. Click "Refresh scan" above to regenerate it.</p>
                    }
                    <p>Click "Refresh scan" above, or run the generator manually from the repository root:</p>
                    <code>powershell -File scripts/project-intelligence/Generate-ProjectIntelligence.ps1</code>
                    <p class="text-body-secondary small mt-2">Expected file: <code>@ViewBag.ReportPath</code></p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="content-card mb-3">
            <div class="admin-kpi-grid">
                <div class="admin-kpi"><div class="admin-kpi-label">Modules scanned</div><div class="admin-kpi-value">@Model.ModuleCount</div></div>
                <div class="admin-kpi"><div class="admin-kpi-label">Redirect shims</div><div class="admin-kpi-value">@Model.StubShimCount</div></div>
                <div class="admin-kpi"><div class="admin-kpi-label">No Razor views found</div><div class="admin-kpi-value">@Model.NoUiCount</div></div>
                <div class="admin-kpi"><div class="admin-kpi-label">Not in sidebar nav</div><div class="admin-kpi-value">@Model.NotInNavCount</div></div>
            </div>
            <div class="admin-footer">
                <span>Branch <strong>@Model.Branch</strong> - last commit <code>@Model.LastCommit</code></span>
                <span>Generated @(Model.GeneratedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-") UTC - @Model.NoTestCount / @Model.ModuleCount modules have no reference found in PEMS.Tests</span>
            </div>
        </div>

        <div class="content-card mb-3">
            <div class="admin-toolbar">
                <div class="admin-toolbar-main">
                    <div class="input-group admin-search">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="search" id="moduleSearch" class="form-control" placeholder="Filter by module name..." autocomplete="off" />
                    </div>
                    <span class="text-body-secondary small">Sorted by evidence coverage, lowest (needs the most attention) first.</span>
                </div>
            </div>
        </div>

        <div class="row g-3" id="moduleGrid">
            @foreach (var m in sorted)
            {
                var presentPct = m.EvidenceTotal == 0 ? 0 : (int)Math.Round(100.0 * m.EvidencePresent / m.EvidenceTotal);
                var unknownPct = m.EvidenceTotal == 0 ? 0 : (int)Math.Round(100.0 * m.EvidenceUnknown / m.EvidenceTotal);
                var missingPct = Math.Max(0, 100 - presentPct - unknownPct);
                var barColor = presentPct >= 75 ? "bg-success" : (presentPct >= 45 ? "bg-warning" : "bg-danger");

                <div class="col-md-6 col-xl-4 module-card" data-module="@m.Module.ToLower()">
                    <div class="content-card h-100 p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="row-primary">
                                    @m.Module
                                    @if (!string.IsNullOrEmpty(m.Area))
                                    {
                                        <span class="admin-role-badge ms-1">@m.Area</span>
                                    }
                                    @if (m.IsRedirectShim)
                                    {
                                        <span class="admin-status inactive ms-1">redirect shim</span>
                                    }
                                </div>
                                <div class="row-secondary">@m.ControllerPath</div>
                            </div>
                            <span class="fw-bold">@m.EvidenceCoveragePct%</span>
                        </div>

                        <div class="progress mb-2" style="height:8px;" title="@m.EvidencePresent present / @m.EvidenceUnknown unknown / @(m.EvidenceTotal - m.EvidencePresent - m.EvidenceUnknown) missing (of @m.EvidenceTotal signals)">
                            <div class="progress-bar @barColor" style="width:@(presentPct)%"></div>
                            <div class="progress-bar bg-secondary" style="width:@(unknownPct)%"></div>
                            <div class="progress-bar bg-danger" style="width:@(missingPct)%"></div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 small text-body-secondary mb-2">
                            <span><i class="bi bi-signpost"></i> @m.ActionCount actions</span>
                            <span><i class="bi bi-file-earmark-richtext"></i> @m.ViewCount views</span>
                            <span><i class="@(m.InSidebarNav ? "bi bi-list-check text-success" : "bi bi-list text-danger")"></i> nav</span>
                            <span><i class="@(m.InTests ? "bi bi-check2-square text-success" : "bi bi-square text-danger")"></i> tests</span>
                            <span><i class="@(m.InDocs ? "bi bi-book text-success" : "bi bi-book text-danger")"></i> docs</span>
                        </div>

                        <details>
                            <summary class="small text-primary" style="cursor:pointer;">@Localizer["Evidence checklist"]</summary>
                            <table class="table table-sm mb-0 mt-2">
                                <tbody>
                                @foreach (var kv in m.Evidence)
                                {
                                    var valClass = kv.Value == "Present" || kv.Value == "Yes" ? "text-success" : (kv.Value == "Unknown" ? "text-body-secondary" : "text-danger");
                                    <tr><td class="row-secondary py-1">@kv.Key</td><td class="py-1 @valClass">@kv.Value</td></tr>
                                }
                                </tbody>
                            </table>
                            <div class="row-secondary small mt-1">
                                Services: @(m.InjectedServices.Count > 0 ? string.Join(", ", m.InjectedServices) : "(none detected)")<br />
                                Views checked: <code>@m.ViewsPath</code><br />
                                Git: last touched @(m.GitLastTouched ?? "unknown"), @m.GitCommitCount commit(s)<br />
                                Graphify connectivity: @m.GraphConnectivity edge(s)
                            </div>
                        </details>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    var form = document.getElementById('refreshForm');
    var btn = document.getElementById('refreshBtn');
    form && form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Scanning...';
    });
})();
(function () {
    var input = document.getElementById('moduleSearch');
    var cards = [].slice.call(document.querySelectorAll('.module-card'));
    input && input.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        cards.forEach(function (c) {
            var show = !q || c.getAttribute('data-module').indexOf(q) !== -1;
            c.style.display = show ? '' : 'none';
        });
    });
})();
</script>
}
