@model PEMS.Application.DTOs.PagedResult<PEMS.Web.Areas.Admin.Models.UserListItemViewModel>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var search = (string?)ViewBag.SearchTerm;
    var qs = string.IsNullOrEmpty(search) ? "" : $"search={Uri.EscapeDataString(search)}";
    int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var currentUserId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component. The search opens over the title and is a chip; Export and
   New are toolbar tools; the row actions (access, edit, reset administrator, activate / deactivate) stay. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["UsL_Title"]" heading-title="@Localizer["UsL_Hint"]" total="@Model.TotalCount">
            <pems-list-search id="usSearch" action="@Url.Action("Index")" input-id="usQ" name="search" value="@search" placeholder="@Localizer["UsL_SearchPlaceholder"]" />
            <pems-list-tools search-for="usSearch">
                <pems-list-export href="@Url.Action("Export")" />
                <pems-list-reset-columns grid-key="AdminUsers" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["UsL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (!string.IsNullOrEmpty(search)) { <pems-list-chip label="@Localizer["Ed_Search"]" value="@search" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="AdminUsers" empty="@(Model.Items.Count == 0)" empty-text="@Localizer["UsL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header data-col-key="account" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["UsL_Account"]</pems-table-header>
                        <pems-table-header data-col-key="contact" data-resizable="true" data-min-width="140" data-max-width="320" class="vs-hide-md">@Localizer["UsL_Contact"]</pems-table-header>
                        <pems-table-header data-col-key="roles" data-resizable="true" data-min-width="120" data-max-width="360">@Localizer["UsL_Roles"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header data-col-key="lastLogin" data-resizable="true" data-min-width="120" data-max-width="220" class="vs-hide-md pems-w-140">@Localizer["UsL_LastLogin"]</pems-table-header>
                        <pems-table-header class="pems-w-150" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var u in Model.Items)
                {
                    <pems-table-row class="lp-row">
                        <pems-table-cell>
                            <a asp-action="Details" asp-route-id="@u.Id" class="lp-subject" title="@u.UserName">@u.UserName</a>
                            <div class="vs-sub">@u.FullName</div>
                        </pems-table-cell>
                        <pems-table-cell class="small vs-hide-md">@u.Email</pems-table-cell>
                        <pems-table-cell>@foreach (var r in u.Roles) { <span class="admin-role-badge">@r</span> }</pems-table-cell>
                        <pems-table-cell>
                            @if (u.IsActive) { <span class="vs-pill vs-pill--icon vs-pill--success"><pems-icon name="bi-check-circle-fill" aria-hidden="true" /> @Localizer["UsL_Active"]</span> }
                            else { <span class="vs-pill vs-pill--icon vs-pill--neutral"><pems-icon name="bi-dash-circle-fill" aria-hidden="true" /> @Localizer["UsL_Inactive"]</span> }
                            @if (u.LockedOut) { <span class="vs-pill vs-pill--icon vs-pill--danger ms-1"><pems-icon name="bi-lock-fill" aria-hidden="true" /> @Localizer["UsL_Locked"]</span> }
                        </pems-table-cell>
                        <pems-table-cell class="small vs-hide-md"><span class="vs-num">@(u.LastLoginDate?.ToString("yyyy-MM-dd HH:mm") ?? Localizer["UsL_Never"].Value)</span></pems-table-cell>
                        <pems-table-cell class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@u.Id" class="lp-act lp-act--always" title="@Localizer["Access & Authorization"]" aria-label="@Localizer["Access & Authorization"] @u.UserName"><pems-icon name="bi-shield-lock" aria-hidden="true" /></a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="lp-act lp-act--always" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"] @u.UserName"><pems-icon name="bi-pencil" aria-hidden="true" /></a>
                            @if (u.Roles.Contains("SystemAdmin") && u.Id != currentUserId)
                            {
                                <a asp-action="ResetAdmin" asp-route-id="@u.Id" class="lp-act lp-act--always text-danger" title="@Localizer["Reset administrator account"]" aria-label="@Localizer["Reset administrator account"] @u.UserName"><pems-icon name="bi-key" aria-hidden="true" /></a>
                            }
                            <pems-form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline" data-pems-confirm="@Localizer[u.IsActive ? "UsL_ConfirmDeactivate" : "UsL_ConfirmActivate", u.UserName]">
                                <button type="submit" class="lp-act lp-act--always" title="@Localizer["UsL_ToggleActive"]" aria-label="@Localizer["UsL_ToggleActive"] @u.UserName"><pems-icon name="bi-power" aria-hidden="true" /></button>
                            </pems-form>
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page, TotalPages = Model.TotalPages, TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize, GridKey = "AdminUsers",
                    BaseUrl = Url.Action("Index") ?? "", ExistingQueryString = qs
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
