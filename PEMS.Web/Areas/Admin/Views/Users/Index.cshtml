@model PEMS.Application.DTOs.PagedResult<PEMS.Web.Areas.Admin.Models.UserListItemViewModel>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var qs = string.IsNullOrEmpty((string?)ViewBag.SearchTerm) ? "" : $"search={Uri.EscapeDataString((string)ViewBag.SearchTerm)}";
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div>
                <p>Manage accounts, roles, access status and sign-in activity.</p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-person-plus me-1"></i> @Localizer["New User"]</a>
    </div>

    <div class="content-card">
        <form method="get" class="admin-toolbar">
            <div class="admin-toolbar-main">
                <div class="input-group admin-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search username, name, email or role..." autocomplete="off" />
                </div>
                <span class="text-body-secondary small"><strong>@Model.TotalCount</strong> users</span>
            </div>
            <div class="admin-toolbar-actions">
                <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-funnel me-1"></i> @Localizer["Search"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Reset"]</a>
                <a asp-action="Export" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i> @Localizer["Export"]</a>
            </div>
        </form>

        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('AdminUsers')">
                <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
            </button>
        </div>
        <div class="table-responsive pems-grid-scroll">
            <table class="table table-enterprise pems-grid-table" id="usersTable" data-grid-key="AdminUsers">
                <thead>
                    <tr>
                        <th data-col-key="account" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["Account"]</th>
                        <th data-col-key="contact" data-resizable="true" data-min-width="140" data-max-width="320">@Localizer["Contact"]</th>
                        <th data-col-key="roles" data-resizable="true" data-min-width="120" data-max-width="320">@Localizer["Roles"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="220">@Localizer["Status"]</th>
                        <th data-col-key="lastLogin" data-resizable="true" data-min-width="120" data-max-width="220">@Localizer["Last Login"]</th>
                        <th data-col-key="actions" data-resizable="false" class="text-end" style="width:110px">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td><div class="row-primary">@u.UserName</div><div class="row-secondary">@u.FullName</div></td>
                        <td><div>@u.Email</div></td>
                        <td>@foreach (var r in u.Roles){<span class="admin-role-badge">@r</span>}</td>
                        <td>
                            @if (u.IsActive){<span class="admin-status active"><i class="bi bi-check-circle-fill"></i> @Localizer["Active"]</span>}
                            else{<span class="admin-status inactive"><i class="bi bi-dash-circle-fill"></i> Inactive</span>}
                            @if (u.LockedOut){<span class="admin-status locked ms-1"><i class="bi bi-lock-fill"></i> Locked</span>}
                        </td>
                        <td class="row-secondary">@(u.LastLoginDate?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                        <td><div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["Edit"]" aria-label="Edit @u.UserName"><i class="bi bi-pencil"></i></a>
                            <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('@(u.IsActive ? "Deactivate" : "Activate") user @u.UserName?')"><button class="btn btn-sm btn-outline-warning" title="Activate / Deactivate" aria-label="Toggle active status for @u.UserName"><i class="bi bi-power"></i></button></form>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.Items.Count == 0){<div class="admin-empty"><i class="bi bi-people"></i><strong>No users found</strong><div>Create the first user to get started.</div></div>}

            @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
            {
                Page = Model.Page, TotalPages = Model.TotalPages, TotalCount = Model.TotalCount,
                PageSize = Model.PageSize, GridKey = "AdminUsers",
                BaseUrl = Url.Action("Index"), ExistingQueryString = qs
            })
        </div>
        <div class="admin-footer"><span></span><span>Page @Model.Page of @Math.Max(Model.TotalPages, 1)</span></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('AdminUsers');
        });
    </script>
}
