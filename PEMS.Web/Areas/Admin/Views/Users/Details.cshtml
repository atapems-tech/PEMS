@model PEMS.Web.Areas.Admin.Models.UserWorkspaceVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS — Enterprise User-Centric Authorization Workspace Consolidation»: تنها صفحه‌ای که
    // پنج دیدگاه مجوزدهیِ قبلاً پراکنده (Permission Matrix/Effective Permissions/Permission
    // Simulator/Separation of Duties/Navigation Visibility) را زیر Context یک کاربر واحد نشان
    // می‌دهد. الگوی بصری عیناً همان .vs-* «Workspace Design System» است که Equipment/Details،
    // EngineeringDocuments/Details و VDR/Details استفاده می‌کنند - نه یک زبان تصویری تازه.
    // Tab های کلاینت-ساید واقعی (data-bs-toggle="tab") - نه ناوبری سمت-سرور مثل EffectiveRole
    // قدیمی. Edit موجود دست‌نخورده می‌ماند و تنها مسیر تخصیص نقش است؛ تب Effective علاوه بر نمایش،
    // مجوزها را (با ذخیره‌ی خودکار) روی Grant نقش‌های کاربر فعال/غیرفعال می‌کند - نه مجوز به‌ازای کاربر.
    var statusPill = Model.LockedOut
        ? ("vs-pill--danger", "bi-lock", (string)Localizer["Locked"])
        : Model.IsActive
            ? ("vs-pill--success", "bi-check-circle", (string)Localizer["Active"])
            : ("vs-pill--neutral", "bi-dash-circle", (string)Localizer["Inactive"]);

    var activeAccessTab = ViewData["ActiveAccessTab"] as string;

    // تب Effective قابل ویرایش است مگر این‌که کاربر SystemAdmin باشد (Bypass سراسری دارد و Grant چیزی را
    // عوض نمی‌کند) یا هیچ نقشی نداشته باشد. هر ردیف جداگانه هم می‌تواند قفل باشد (NonEditablePermissions).
    var canEditPermissions = Model.RoleNames.Count > 0 && !Model.RoleNames.Contains(PEMS.Persistence.Identity.SystemRoles.SystemAdmin);
    string? RowLock(PEMS.Application.DTOs.EffectivePermissionDto r) =>
        Model.NonEditablePermissions.TryGetValue(r.PermissionName, out var why) ? why : null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" /> <link rel="stylesheet" href="~/css/pems-user-details.css" asp-append-version="true" /> 
}

@section Scripts {
    <script type="application/json" id="permAdminI18n">
        @Json.Serialize(new Dictionary<string, string>
        {
            ["saving"] = Localizer["PermAdmin_Saving"].Value,
            ["saved"] = Localizer["PermAdmin_Saved"].Value,
            ["rowSaved"] = Localizer["PermAdmin_RowSaved"].Value,
            ["noChange"] = Localizer["PermAdmin_NoChange"].Value,
            ["someSkipped"] = Localizer["PermAdmin_SomeSkipped"].Value,
            ["failed"] = Localizer["PermAdmin_Failed"].Value,
            ["confirmBatch"] = Localizer["PermAdmin_ConfirmBatch"].Value,
            ["nothingSelected"] = Localizer["PermAdmin_NothingSelected"].Value,
            ["selectedCount"] = Localizer["PermAdmin_SelectedCount"].Value,
            ["allowed"] = Localizer["Allowed"].Value,
            ["notGranted"] = Localizer["Not granted"].Value,
            ["SystemAdmin"] = Localizer["PermAdmin_Locked_SystemAdmin"].Value,
            ["NoRoles"] = Localizer["PermAdmin_Locked_NoRoles"].Value,
            ["OutsideMatrix"] = Localizer["PermAdmin_Locked_OutsideMatrix"].Value,
            ["RoleModuleAction"] = Localizer["PermAdmin_Locked_RoleModuleAction"].Value,
            ["Unknown"] = Localizer["PermAdmin_Reason_Unknown"].Value,
            ["NoChangeReason"] = Localizer["PermAdmin_Reason_NoChange"].Value,
            ["TargetRoleRequired"] = Localizer["PermAdmin_Reason_TargetRoleRequired"].Value
        })
    </script>
    <script src="~/js/pems-user-permissions.js" asp-append-version="true"></script>
}

<div class="vs-page">
<div class="vs-section">
    <div class="vs-doc-head">
        <div class="vs-doc-identity">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="vs-doc-number vs-num">@Model.FullName</h2>
                <span class="vs-pill vs-pill--icon @statusPill.Item1"><pems-icon css="@statusPill.Item2" aria-hidden="true" /> @statusPill.Item3</span>
            </div>
            <div class="vs-doc-title">&#64;@Model.UserName</div>
            <div class="vs-doc-meta">
                @(Model.DepartmentName ?? Localizer["N/A"])
                @if (!string.IsNullOrWhiteSpace(Model.DisciplineName)) { <text> &middot; @Model.DisciplineName</text> }
                @if (!string.IsNullOrWhiteSpace(Model.Position)) { <text> &middot; @Model.Position</text> }
            </div>
        </div>
        <div class="vs-doc-actions">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="vs-btn"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</a>
            <a asp-action="Index" class="vs-btn"><pems-icon name="bi-arrow-left" /> @Localizer["Users"]</a>
        </div>
    </div>
    <pems-info-grid>
        <pems-info-item label="@Localizer["Roles"]" num>@Model.RoleNames.Count</pems-info-item>
        <pems-info-item label="@Localizer["Effective Permissions"]" num><span id="permInfoAllowed">@Model.AllowedCount</span> <span class="text-muted small">/ @Model.EffectivePermissions.Count</span></pems-info-item>
        <pems-info-item label="@Localizer["Potential SoD conflicts"]" num>@Model.SoDExposureCount</pems-info-item>
        <pems-info-item label="@Localizer["Employee link"]">@(Model.HasLinkedEmployee ? Localizer["Linked"] : Localizer["Not linked"])</pems-info-item>
        <pems-info-item label="@Localizer["Last Login"]" num>@(Model.LastLoginDate?.ToString("yyyy-MM-dd HH:mm") ?? Localizer["Never"].Value)</pems-info-item>
    </pems-info-grid>
</div>

<pems-nav css="mb-3" id="userTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button"><pems-icon name="bi-info-circle" /> @Localizer["Overview"]</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-organization" type="button"><pems-icon name="bi-building" /> @Localizer["Organization"]</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-roles" type="button"><pems-icon name="bi-people" /> @Localizer["Roles"] <pems-badge tone="neutral">@Model.RoleNames.Count</pems-badge></button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeAccessTab != null ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-access" type="button"><pems-icon name="bi-shield-lock" /> @Localizer["Access & Authorization"]</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-audit" type="button"><pems-icon name="bi-clock-history" /> @Localizer["Audit"] <pems-badge tone="neutral">@Model.RecentAuditLogs.Count</pems-badge></button>
    </li>
</pems-nav>

<div class="tab-content">

    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        <div class="content-card">
            <pems-info-grid>
                <pems-info-item label="@Localizer["Username"]" num>@Model.UserName</pems-info-item>
                <pems-info-item label="@Localizer["Full Name"]">@Model.FullName</pems-info-item>
                <pems-info-item label="@Localizer["Email"]">@(Model.Email ?? Localizer["N/A"].Value)</pems-info-item>
                <pems-info-item label="@Localizer["Status"]">@statusPill.Item3</pems-info-item>
            </pems-info-grid>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-organization" role="tabpanel">
        <div class="content-card">
            @if (!Model.HasLinkedEmployee)
            {
                <pems-alert tone="warning" css="py-2 px-3 small">@Localizer["This user has no linked employee - discipline-based document visibility, letter referrals, and task assignment will not work correctly for them until this is set."]</pems-alert>
            }
            <pems-info-grid>
                <pems-info-item label="@Localizer["Department"]">@(Model.DepartmentName ?? Localizer["N/A"].Value)</pems-info-item>
                <pems-info-item label="@Localizer["Discipline"]">@(Model.DisciplineName ?? Localizer["N/A"].Value)</pems-info-item>
                <pems-info-item label="@Localizer["Position / Title"]">@(Model.Position ?? Localizer["N/A"].Value)</pems-info-item>
            </pems-info-grid>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-roles" role="tabpanel">
        <div class="content-card">
            @if (Model.RoleNames.Count == 0)
            {
                <div class="admin-empty"><pems-icon name="bi-people" /><strong>@Localizer["No roles assigned"]</strong></div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var r in Model.RoleNames)
                    {
                        <span class="vs-chip vs-num">@r</span>
                    }
                </div>
            }
            <p class="text-body-secondary small mt-3 mb-0">@Localizer["Role assignment itself is changed from the Edit page."] <a asp-action="Edit" asp-route-id="@Model.UserId">@Localizer["Edit"]</a></p>
        </div>
    </div>

    <div class="tab-pane fade @(activeAccessTab != null ? "show active" : "")" id="tab-access" role="tabpanel">

        <pems-nav css="mb-3" id="accessTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeAccessTab is null or "effective" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#access-effective" type="button">
                    <pems-icon name="bi-eye" /> @Localizer["Effective"] <pems-badge tone="neutral" id="permTabBadge">@Model.AllowedCount</pems-badge>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#access-matrix" type="button">
                    <pems-icon name="bi-sliders" /> @Localizer["Matrix"] <pems-badge tone="neutral">@Model.RoleNames.Count</pems-badge>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeAccessTab == "simulator" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#access-simulator" type="button">
                    <pems-icon name="bi-play-circle" /> @Localizer["Permission Simulator"]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#access-sod" type="button">
                    <pems-icon name="bi-shuffle" /> @Localizer["Separation of Duties"]
                    @if (Model.SoDExposureCount > 0) { <pems-badge tone="warning">@Model.SoDExposureCount</pems-badge> }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#access-navigation" type="button">
                    <pems-icon name="bi-layout-sidebar" /> @Localizer["Navigation Visibility"] <pems-badge tone="neutral">@Model.VisibleModuleCount</pems-badge>
                </button>
            </li>
        </pems-nav>

        <div class="tab-content">

            <div class="tab-pane fade @(activeAccessTab is null or "effective" ? "show active" : "")" id="access-effective" role="tabpanel">
                <div class="content-card" id="permAdmin"
                     data-url="@Url.Action("SetPermissionAccess", "Users", new { area = "Admin", id = Model.UserId })"
                     data-editable="@(canEditPermissions ? "1" : "0")">
                    @Html.AntiForgeryToken()

                    @if (canEditPermissions)
                    {
                        <pems-alert tone="info" css="py-2 small mb-2">
                            <pems-icon name="bi-info-circle" /> @Localizer["PermAdmin_RoleScopeNote"]
                            <strong>@string.Join(", ", Model.RoleUserCounts.Select(kv => string.Format(Localizer["PermAdmin_RoleUsersFormat"].Value, kv.Key, kv.Value)))</strong>
                        </pems-alert>
                    }
                    else
                    {
                        <pems-alert tone="secondary" css="py-2 small mb-2">
                            <pems-icon name="bi-lock" /> @(Model.RoleNames.Count == 0 ? Localizer["PermAdmin_Locked_NoRoles"] : Localizer["PermAdmin_Locked_SystemAdmin"])
                        </pems-alert>
                    }

                    <div class="admin-toolbar mb-2 flex-wrap gap-2">
                        <div class="admin-toolbar-main">
                            <span class="text-body-secondary small"><span id="permAllowedCount">@Model.AllowedCount</span> / <span id="permTotalCount">@Model.EffectivePermissions.Count</span> @Localizer["permissions allowed"]</span>
                        </div>
                        @if (canEditPermissions)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2" id="permToolbar">
                                @if (Model.RoleNames.Count > 1)
                                {
                                    <label class="small text-body-secondary mb-0" for="permTargetRole">@Localizer["PermAdmin_TargetRole"]</label>
                                    <pems-select scale="small" css="w-auto" id="permTargetRole">
                                        @foreach (var roleName in Model.RoleNames)
                                        {
                                            <option value="@roleName">@roleName</option>
                                        }
                                    </pems-select>
                                }
                                <div class="btn-group btn-group-sm" role="group">
                                    <pems-button tone="neutral" outline="true" type="button" id="permSelectAll"><pems-icon name="bi-check2-square" /> @Localizer["PermAdmin_SelectAll"]</pems-button>
                                    <pems-button tone="neutral" outline="true" type="button" id="permDeselectAll"><pems-icon name="bi-square" /> @Localizer["PermAdmin_DeselectAll"]</pems-button>
                                </div>
                                <div class="btn-group btn-group-sm" role="group">
                                    <pems-button tone="success" outline="true" type="button" id="permEnableSelected" disabled="true"><pems-icon name="bi-toggle-on" /> @Localizer["PermAdmin_EnableSelected"]</pems-button>
                                    <pems-button tone="danger" outline="true" type="button" id="permDisableSelected" disabled="true"><pems-icon name="bi-toggle-off" /> @Localizer["PermAdmin_DisableSelected"]</pems-button>
                                </div>
                                <span class="small text-body-secondary" id="permSelectedCount" aria-live="polite"></span>
                                <pems-spinner size="small" tone="neutral" css="d-none" id="permBusy" aria-label="@Localizer["PermAdmin_Saving"]"></pems-spinner>
                            </div>
                        }
                    </div>

                    <pems-alert tone="none" css="d-none py-2 small" id="permAlert" role="status" aria-live="polite"></pems-alert>

                    <div class="table-responsive">
                        <pems-table kind="enterprise" id="permTableAllowed">
                            <thead><tr>
                                <th class="perm-select-cell"><pems-input type="checkbox" kind="check" css="perm-select-all" disabled="@(!canEditPermissions)" aria-label="@Localizer["PermAdmin_SelectAllInTable"]" /></th>
                                <th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th><th>@Localizer["Destructive"]</th>
                            </tr></thead>
                            <tbody>
                            @foreach (var row in Model.EffectivePermissions.Where(r => r.Allowed))
                            {
                                <partial name="_EffectivePermissionRow" model="new PEMS.Web.Areas.Admin.Models.UserEffectivePermissionRowVm { Row = row, LockedReason = canEditPermissions ? RowLock(row) : (Model.RoleNames.Count == 0 ? PEMS.Application.DTOs.PermissionChangeReasons.NoRoles : PEMS.Application.DTOs.PermissionChangeReasons.SystemAdmin) }" />
                            }
                            </tbody>
                        </pems-table>
                    </div>
                    <details class="mt-3">
                        <summary class="text-body-secondary small">@Localizer["Show not-granted permissions"] (<span id="permNotGrantedCount">@(Model.EffectivePermissions.Count - Model.AllowedCount)</span>)</summary>
                        <div class="table-responsive mt-2">
                            <pems-table kind="enterprise" id="permTableDenied">
                                <thead><tr>
                                    <th class="perm-select-cell"><pems-input type="checkbox" kind="check" css="perm-select-all" disabled="@(!canEditPermissions)" aria-label="@Localizer["PermAdmin_SelectAllInTable"]" /></th>
                                    <th>@Localizer["Resource"]</th><th>@Localizer["Action"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Status"]</th><th>@Localizer["Destructive"]</th>
                                </tr></thead>
                                <tbody>
                                @foreach (var row in Model.EffectivePermissions.Where(r => !r.Allowed))
                                {
                                    <partial name="_EffectivePermissionRow" model="new PEMS.Web.Areas.Admin.Models.UserEffectivePermissionRowVm { Row = row, LockedReason = canEditPermissions ? RowLock(row) : (Model.RoleNames.Count == 0 ? PEMS.Application.DTOs.PermissionChangeReasons.NoRoles : PEMS.Application.DTOs.PermissionChangeReasons.SystemAdmin) }" />
                                }
                                </tbody>
                            </pems-table>
                        </div>
                    </details>
                </div>
            </div>

            <div class="tab-pane fade" id="access-matrix" role="tabpanel">
                <div class="content-card">
                    @if (Model.MatrixRows.Count == 0)
                    {
                        <div class="admin-empty"><pems-icon name="bi-sliders" /><strong>@Localizer["No matrix rows for this user's roles"]</strong></div>
                    }
                    else
                    {
                        <p class="text-body-secondary small">@Localizer["Rows for this user's own role(s) only, from the same matrix maintained on the full Permission Matrix page."] <a asp-controller="PermissionMatrix" asp-action="Index">@Localizer["Open full matrix"]</a></p>
                        <div class="table-responsive">
                            <pems-table kind="enterprise">
                                <thead><tr><th>@Localizer["Role"]</th><th>@Localizer["Module"]</th><th>@Localizer["View"]</th><th>@Localizer["Create"]</th><th>@Localizer["Edit"]</th><th>@Localizer["Delete"]</th><th>@Localizer["Approve"]</th></tr></thead>
                                <tbody>
                                @foreach (var m in Model.MatrixRows.OrderBy(r => r.RoleName).ThenBy(r => r.ModuleName))
                                {
                                    <tr>
                                        <td>@m.RoleName</td>
                                        <td>@m.ModuleName</td>
                                        <td>@(m.CanView ? "✓" : "")</td>
                                        <td>@(m.CanCreate ? "✓" : "")</td>
                                        <td>@(m.CanEdit ? "✓" : "")</td>
                                        <td>@(m.CanDelete ? "✓" : "")</td>
                                        <td>@(m.CanApprove ? "✓" : "")</td>
                                    </tr>
                                }
                                </tbody>
                            </pems-table>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade @(activeAccessTab == "simulator" ? "show active" : "")" id="access-simulator" role="tabpanel">
                <div class="content-card">
                    <form method="post" asp-action="Simulate" asp-route-id="@Model.UserId" class="row g-3 pems-s-e2b01b0d">
                        @Html.AntiForgeryToken()
                        <pems-col md="6">
                            <pems-label>@Localizer["Resource"]</pems-label>
                            <pems-input type="text" name="resourceName" value="@Model.Simulator.ResourceName" list="permissionResourceList" required />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Action"]</pems-label>
                            <pems-input type="text" name="actionName" value="@Model.Simulator.ActionName" required />
                        </pems-col>
                        <pems-col md="6">
                            <pems-label>@Localizer["Resource ID (optional)"]</pems-label>
                            <pems-input type="text" name="resourceId" value="@Model.Simulator.ResourceId" />
                        </pems-col>
                        <pems-col span="12">
                            <pems-button tone="primary" type="submit">@Localizer["Run"]</pems-button>
                        </pems-col>
                    </form>
                    <datalist id="permissionResourceList">
                        @foreach (var name in Model.Simulator.AllPermissionNames)
                        {
                            <option value="@name"></option>
                        }
                    </datalist>

                    @if (Model.Simulator.Result != null)
                    {
                        var r = Model.Simulator.Result;
                        <div class="mt-4 permission-intro @(r.Allowed ? "border-success" : "border-danger")">
                            <span class="admin-status @(r.Allowed ? "active" : "inactive")">
                                <pems-icon css="@(r.Allowed ? "bi-check2-circle" : "bi-x-circle")" /> @(r.Allowed ? Localizer["ALLOW"] : Localizer["DENY"])
                            </span>
                            <p class="mb-1 mt-2"><strong>@Localizer["Reason"]:</strong> @r.Reason</p>
                            @if (!string.IsNullOrWhiteSpace(r.Detail)) { <p class="mb-1 text-body-secondary small">@r.Detail</p> }
                            @if (!string.IsNullOrWhiteSpace(r.MatchedRoleName)) { <p class="mb-1 text-body-secondary small">@Localizer["Source"]: @Localizer["Role"]: @r.MatchedRoleName @(r.MatchedScopeType != null ? $"(Scope: {r.MatchedScopeType})" : "")</p> }
                        </div>
                    }
                    <p class="text-body-secondary small mt-3 mb-0">@Localizer["This runs the real authorization engine for this user - it never writes or changes any permission."]</p>
                </div>
            </div>

            <div class="tab-pane fade" id="access-sod" role="tabpanel">
                <div class="content-card">
                    <div class="permission-intro mb-3"><pems-icon name="bi-info-circle" css="me-1" /> @Localizer["Separation of Duties in PEMS is checked dynamically, per record, at the moment of a real action - not as a standing status. The rows below show structural exposure only: this user's roles grant both permissions of an active policy. This is not the same as an actual violation, which can only happen on a specific record."]</div>
                    @if (Model.SoDExposure.Count == 0)
                    {
                        <div class="admin-empty"><pems-icon name="bi-shuffle" /><strong>@Localizer["No active SoD policies apply to this user's permissions"]</strong></div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <pems-table kind="enterprise">
                                <thead><tr><th>@Localizer["Permission A"]</th><th>@Localizer["Permission B"]</th><th>@Localizer["Description"]</th><th>@Localizer["Status"]</th></tr></thead>
                                <tbody>
                                @foreach (var s in Model.SoDExposure)
                                {
                                    <tr>
                                        <td><code>@s.PermissionAName</code></td>
                                        <td><code>@s.PermissionBName</code></td>
                                        <td class="text-body-secondary small">@(s.PolicyDescription ?? "")</td>
                                        <td>
                                            @if (s.UserHoldsBoth)
                                            {
                                                <span class="admin-status inactive"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Potential exposure"]</span>
                                            }
                                            else
                                            {
                                                <span class="admin-status active"><pems-icon name="bi-check2-circle" /> @Localizer["Not exposed"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </pems-table>
                        </div>
                    }
                    <p class="text-body-secondary small mt-3 mb-0"><a asp-controller="SoDPolicy" asp-action="Index">@Localizer["Manage SoD policies"]</a></p>
                </div>
            </div>

            <div class="tab-pane fade" id="access-navigation" role="tabpanel">
                <div class="content-card">
                    <div class="permission-intro mb-3"><pems-icon name="bi-diagram-3" css="me-1" /> @Localizer["This is a visualization only - it does not sign in as this user, and hidden items may still be reachable by direct URL if the user is actually authorized (Hidden is not the same as Unauthorized)."]</div>
                    @foreach (var module in Model.NavigationTree)
                    {
                        <details class="navvis-module mb-2" open="@(module.Visible ? "open" : null)">
                            <summary class="navvis-module-summary">
                                @if (module.Visible) { <i class="bi bi-check-lg text-success"></i> } else { <i class="bi bi-dash text-body-tertiary"></i> }
                                <span class="navvis-title">@Localizer[module.DisplayLocalizationKey]</span>
                            </summary>
                            @if (module.Visible && module.HasDrillDown)
                            {
                                <div class="navvis-children">
                                    @foreach (var item in module.Items)
                                    {
                                        <div class="navvis-item navvis-item-flat">
                                            @if (item.Visible) { <i class="bi bi-check-lg text-success"></i> } else { <i class="bi bi-dash text-body-tertiary"></i> }
                                            <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                        </div>
                                    }
                                    @foreach (var subgroup in module.Subgroups)
                                    {
                                        <details class="navvis-subgroup" open="@(subgroup.AnyVisible ? "open" : null)">
                                            <summary class="navvis-subgroup-summary">@Localizer[subgroup.Label]</summary>
                                            <div class="navvis-children">
                                                @foreach (var item in subgroup.Items)
                                                {
                                                    <div class="navvis-item navvis-item-flat">
                                                        @if (item.Visible) { <i class="bi bi-check-lg text-success"></i> } else { <i class="bi bi-dash text-body-tertiary"></i> }
                                                        <span class="navvis-item-name">@Localizer[item.DisplayLocalizationKey]</span>
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            }
                        </details>
                    }
                    <p class="text-body-secondary small mt-3 mb-0"><a asp-controller="NavigationVisibility" asp-action="Index">@Localizer["Manage navigation visibility by role"]</a></p>
                </div>
            </div>

        </div>
    </div>

    <div class="tab-pane fade" id="tab-audit" role="tabpanel">
        <div class="content-card">
            @if (Model.RecentAuditLogs.Count == 0)
            {
                <div class="admin-empty"><pems-icon name="bi-clock-history" /><strong>@Localizer["No authorization decisions recorded yet"]</strong></div>
            }
            else
            {
                <div class="table-responsive">
                    <pems-table kind="enterprise">
                        <thead><tr><th>@Localizer["Timestamp"]</th><th>@Localizer["Permission"]</th><th>@Localizer["Resource ID"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Reason"]</th></tr></thead>
                        <tbody>
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td class="vs-num">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><code>@($"{log.ResourceName}.{log.ActionName}")</code></td>
                                <td class="text-body-secondary small">@(log.ResourceId ?? "")</td>
                                <td>
                                    @if (log.Decision == "Allow")
                                    {
                                        <span class="admin-status active"><pems-icon name="bi-check2-circle" /> @log.Decision</span>
                                    }
                                    else
                                    {
                                        <span class="admin-status inactive"><pems-icon name="bi-x-circle" /> @log.Decision</span>
                                    }
                                </td>
                                <td class="text-body-secondary small">@(log.Reason ?? "")</td>
                            </tr>
                        }
                        </tbody>
                    </pems-table>
                </div>
            }
            <p class="text-body-secondary small mt-3 mb-0"><a asp-controller="AuthorizationAudit" asp-action="Index" asp-route-userId="@Model.UserId">@Localizer["Open full audit log for this user"]</a></p>
        </div>
    </div>

</div>
</div>

