@model PEMS.Web.Areas.Admin.Models.UserFormViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* شناسه‌های تکراری چک‌باکس نقش، عیناً بین Create.cshtml و Edit.cshtml مشترک بود. *@
<div class="mb-3">
    <label class="form-label d-block">@Localizer["Roles"]</label>
    <div class="small text-muted mb-1">@Localizer["مسئول (approval / oversight authority)"]</div>
    @foreach (var role in Model.AllRoles.Where(r => new[] { "SystemAdmin", "EngineeringManager", "EngineeringSupervisor", "DocumentController", "ContractManager" }.Contains(r)))
    {
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                   id="role_@role" checked="@(Model.SelectedRoles.Contains(role))" />
            <label class="form-check-label" for="role_@role">@role</label>
        </div>
    }
    <div class="small text-muted mb-1 mt-2">@Localizer["کارشناس (day-to-day execution, no approval authority)"]</div>
    @{ var knownRoles = new[] { "SystemAdmin", "EngineeringManager", "EngineeringSupervisor", "DocumentController", "ContractManager", "DisciplineEngineer", "MaintenanceEngineer", "Viewer" }; }
    @foreach (var role in Model.AllRoles.Where(r => new[] { "DisciplineEngineer", "MaintenanceEngineer", "Viewer" }.Contains(r)))
    {
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                   id="role_@role" checked="@(Model.SelectedRoles.Contains(role))" />
            <label class="form-check-label" for="role_@role">@role</label>
        </div>
    }
    @if (Model.AllRoles.Any(r => !knownRoles.Contains(r)))
    {
        <div class="small text-muted mb-1 mt-2">@Localizer["سایر نقش‌های سفارشی"]</div>
        @foreach (var role in Model.AllRoles.Where(r => !knownRoles.Contains(r)))
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                       id="role_@role" checked="@(Model.SelectedRoles.Contains(role))" />
                <label class="form-check-label" for="role_@role">@role</label>
            </div>
        }
    }
</div>
