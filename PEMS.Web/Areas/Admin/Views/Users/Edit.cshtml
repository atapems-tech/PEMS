@model PEMS.Web.Areas.Admin.Models.UserFormViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="pems-s-e2b01b0d">

    <pems-alert tone="danger" css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-alert>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <pems-label>@Localizer["Username"]</pems-label>
            <pems-input asp-for="UserName" readonly />
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Full Name"]</pems-label>
            <pems-input asp-for="FullName" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Email"]</pems-label>
            <pems-input asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <pems-label>New Password <span class="text-muted small">(leave empty to keep current password)</span></pems-label>
            <pems-input asp-for="Password" type="password" />
        </div>

        <hr />
        <h6 class="mb-2">@Localizer["Employee link"]</h6>
        @if (!Model.ExistingEmployeeId.HasValue)
        {
            <pems-alert tone="warning" css="py-2 px-3 small">
                This user has no linked employee - discipline-based document visibility, letter
                referrals, and task assignment will not work correctly for them until this is set.
            </pems-alert>
        }

        <div class="mb-3">
            <pems-label>@Localizer["Link to existing employee"]</pems-label>
            <pems-select name="ExistingEmployeeId" id="existingEmployeeSelect">
                <option value="">@Localizer["-- create a new employee record instead --"]</option>
                @foreach (var e in Model.AllEmployees)
                {
                    <option value="@e.Id" selected="@(Model.ExistingEmployeeId == e.Id)">@e.Name</option>
                }
            </pems-select>
        </div>

        <pems-row gap="3" css="mb-3" id="newEmployeeFields">
            <pems-col md="6">
                <pems-label>@Localizer["Department"]</pems-label>
                <pems-select name="DepartmentId">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var d in Model.AllDepartments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Discipline"]</pems-label>
                <pems-select name="DisciplineId">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var d in Model.AllDisciplines)
                    {
                        <option value="@d.Id" selected="@(Model.DisciplineId == d.Id)">@d.Name</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col span="12">
                <pems-label>@Localizer["Organizational position"]</pems-label>
                <pems-select name="PositionId">
                    <option value="">@Localizer["-- none (assign later) --"]</option>
                    @foreach (var p in Model.AllPositions)
                    {
                        <option value="@p.Id" selected="@(Model.PositionId == p.Id)">@p.Name</option>
                    }
                </pems-select>
                <div class="form-text">@Localizer["Only vacant active positions are listed. The assignment is created through the organization structure."]</div>
            </pems-col>
        </pems-row>

        <hr />
        <partial name="_RoleSelect" model="Model" />

        <div class="form-check mb-4">
            <pems-input kind="check" asp-for="IsActive" />
            <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
        </div>

        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>

    </form>

</pems-content-card>

@section Styles {
    <link rel="stylesheet" href="~/css/pems-multiselect.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pems-multiselect.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/views/admin-users-edit.js" asp-append-version="true"></script>
}
