@model PEMS.Web.Areas.Admin.Models.UserFormViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="content-card" style="max-width:640px;">

    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">@Localizer["Username"]</label>
            <input asp-for="UserName" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Full Name"]</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Email"]</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">New Password <span class="text-muted small">(leave empty to keep current password)</span></label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>

        <hr />
        <h6 class="mb-2">@Localizer["Employee link"]</h6>
        @if (!Model.ExistingEmployeeId.HasValue)
        {
            <div class="alert alert-warning py-2 px-3 small">
                This user has no linked employee - discipline-based document visibility, letter
                referrals, and task assignment will not work correctly for them until this is set.
            </div>
        }

        <div class="mb-3">
            <label class="form-label">@Localizer["Link to existing employee"]</label>
            <select name="ExistingEmployeeId" class="form-select" id="existingEmployeeSelect">
                <option value="">@Localizer["-- create a new employee record instead --"]</option>
                @foreach (var e in Model.AllEmployees)
                {
                    <option value="@e.Id" selected="@(Model.ExistingEmployeeId == e.Id)">@e.Name</option>
                }
            </select>
        </div>

        <div id="newEmployeeFields" class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["Department"]</label>
                <select name="DepartmentId" class="form-select">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var d in Model.AllDepartments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Discipline"]</label>
                <select name="DisciplineId" class="form-select">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var d in Model.AllDisciplines)
                    {
                        <option value="@d.Id" selected="@(Model.DisciplineId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">@Localizer["Organizational position"]</label>
                <select name="PositionId" class="form-select">
                    <option value="">@Localizer["-- none (assign later) --"]</option>
                    @foreach (var p in Model.AllPositions)
                    {
                        <option value="@p.Id" selected="@(Model.PositionId == p.Id)">@p.Name</option>
                    }
                </select>
                <div class="form-text">@Localizer["Only vacant active positions are listed. The assignment is created through the organization structure."]</div>
            </div>
        </div>

        <hr />
        <partial name="_RoleSelect" model="Model" />

        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
        </div>

        <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>

    </form>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pems-multiselect.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pems-multiselect.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        var existingSelect = document.getElementById('existingEmployeeSelect');
        var newFields = document.getElementById('newEmployeeFields');

        function toggleNewEmployeeFields() {
            newFields.style.display = existingSelect.value ? 'none' : '';
        }

        existingSelect.addEventListener('change', toggleNewEmployeeFields);
        toggleNewEmployeeFields();
    </script>
}
