@model List<PEMS.Web.Areas.Admin.Models.RoleListItemViewModel>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>Define role boundaries and review how many users are assigned to each role.</p></div>
        </div>
        <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-plus-lg me-1"></i> @Localizer["New Role"]</a>
    </div>
    <div class="content-card">
        <div class="admin-toolbar"><div class="admin-toolbar-main"><span class="text-body-secondary small"><strong>@Model.Count</strong> roles configured</span></div></div>
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Role"]</th><th>@Localizer["Description"]</th><th>@Localizer["Users"]</th><th>@Localizer["Authorization"]</th><th>@Localizer["Type"]</th><th class="text-end">@Localizer["Actions"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><div class="row-primary">@r.DisplayName</div><div class="row-secondary">@r.Name</div></td>
                        <td>@r.Description</td>
                        <td><span class="admin-role-badge"><i class="bi bi-people me-1"></i>@r.UserCount</span></td>
                        <td>
                            @* طبق «PEMS Authorization Architecture Completion» فاز ۴ بند ۹/۱۴: وضعیت پیکربندی مجوز -
                               نه رنگ‌فقط (آیکون + متن)، و صفر به‌صراحت «پیکربندی‌نشده» است، نه یک خطا. *@
                            @if (r.PermissionCount < 0)
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" })" class="admin-status active" title="@Localizer["SystemAdmin bypasses the permission matrix by design"]"><i class="bi bi-infinity"></i> @Localizer["Unrestricted"]</a>
                            }
                            else if (r.PermissionCount == 0)
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" }, $"role-{r.Name}")" class="admin-status inactive" title="@Localizer["No permissions configured for this role yet - every action is denied by default"]"><i class="bi bi-exclamation-triangle"></i> @Localizer["Not configured"]</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" }, $"role-{r.Name}")" class="admin-status active"><i class="bi bi-check2-circle"></i> @r.PermissionCount @Localizer["permissions"]</a>
                            }
                        </td>
                        <td>@if(r.IsSystemRole){<span class="admin-status active"><i class="bi bi-shield-check"></i> @Localizer["System"]</span>}else{<span class="admin-status inactive">Custom</span>}</td>
                        <td><div class="admin-actions">
                            @if (!r.IsSystemRole){<form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this role?')"><button class="btn btn-sm btn-outline-danger" title="@Localizer["Delete"]"><i class="bi bi-trash"></i></button></form>}
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.Count == 0){<div class="admin-empty"><i class="bi bi-shield"></i><strong>No roles configured</strong></div>}
        </div>
        <div class="admin-footer"><span></span><span>System roles are protected</span></div>
    </div>
</div>
