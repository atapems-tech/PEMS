@model List<PEMS.Web.Areas.Admin.Models.RoleListItemViewModel>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    // نام/توضیح بومی‌سازی‌شده از کاتالوگ؛ نقش سفارشی (کلید ندارد) به DisplayName/Name برمی‌گردد
    string Loc(string key, string? fallback) { var l = Localizer[key]; return l.ResourceNotFound ? (fallback ?? "") : l.Value; }
    // فقط نقش‌های دقیقاً-کاتالوگی بومی‌سازی می‌شوند؛ نقش سفارشی با نامی مثل «MNT_Manager» (که کلید منبع را تقلید می‌کند)
    // هرگز نام/توضیح یک نقش پایه را قرض نمی‌گیرد.
    bool IsCatalog(PEMS.Web.Areas.Admin.Models.RoleListItemViewModel r) => PEMS.Persistence.Identity.RoleCatalog.Find(r.Name) != null;
    string RoleName(PEMS.Web.Areas.Admin.Models.RoleListItemViewModel r)
    {
        var fb = string.IsNullOrWhiteSpace(r.DisplayName) ? r.Name : r.DisplayName;
        return IsCatalog(r) ? Loc("Role_" + r.Name.Replace('.', '_') + "_Name", fb) : fb;
    }
    string RoleDesc(PEMS.Web.Areas.Admin.Models.RoleListItemViewModel r) =>
        IsCatalog(r) ? Loc("Role_" + r.Name.Replace('.', '_') + "_Desc", r.Description) : (r.Description ?? "");
    var duplicates = (List<(string Custom, string Baseline)>?)ViewBag.PossibleDuplicates ?? new();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4: built from the PEMS.UI list-page component. The page note is the tool tip of the title; the possible
   duplicates warning stays above the list; delete stays for custom roles only. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }
    @if (duplicates.Any())
    {
        <pems-alert tone="warning" css="small">
            <strong>@Localizer["Role_PossibleDuplicates"]</strong>
            @foreach (var d in duplicates) { <div>@d.Custom &rarr; @d.Baseline</div> }
        </pems-alert>
    }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["RoL_Title"]" heading-title="@Localizer["RoL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-reset-columns grid-key="AdminRoles" />
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["RoL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table grid-key="AdminRoles" empty="@(Model.Count == 0)" empty-text="@Localizer["RoL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="role" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">@Localizer["Role"]</th>
                        <th data-col-key="domain" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px" class="vs-hide-md">@Localizer["Role_Domain"]</th>
                        <th data-col-key="category" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px" class="vs-hide-md">@Localizer["Role_Category"]</th>
                        <th data-col-key="description" data-resizable="true" data-min-width="160" data-max-width="520">@Localizer["Ed_Description"]</th>
                        <th data-col-key="users" data-resizable="true" data-min-width="70" data-max-width="120" style="width:90px" class="text-end">@Localizer["RoL_Users"]</th>
                        <th data-col-key="authorization" data-resizable="true" data-min-width="120" data-max-width="240" style="width:170px">@Localizer["RoL_Authorization"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">@Localizer["Ed_Type"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr class="lp-row">
                        <td><span class="vs-cell-strong">@RoleName(r)</span><div class="vs-sub vs-mono">@r.Name</div></td>
                        <td class="small vs-hide-md">@(string.IsNullOrEmpty(r.Domain) ? "" : Loc("RoleDomain_" + r.Domain, r.Domain))</td>
                        <td class="small vs-hide-md">@(string.IsNullOrEmpty(r.Category) ? "" : Loc("RoleCategory_" + r.Category, r.Category))</td>
                        <td class="small"><span class="vs-title-cell" title="@RoleDesc(r)">@RoleDesc(r)</span></td>
                        <td class="text-end"><span class="vs-num">@r.UserCount</span></td>
                        <td>
                            @* طبق «PEMS Authorization Architecture Completion» فاز ۴ بند ۹/۱۴: وضعیت پیکربندی مجوز -
                               نه رنگ‌فقط (آیکون + متن)، و صفر به‌صراحت «پیکربندی‌نشده» است، نه یک خطا. *@
                            @if (r.PermissionCount < 0)
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" })" class="vs-pill vs-pill--icon vs-pill--success" title="@Localizer["SystemAdmin bypasses the permission matrix by design"]"><i class="bi bi-infinity" aria-hidden="true"></i> @Localizer["Unrestricted"]</a>
                            }
                            else if (r.PermissionCount == 0)
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" }, $"role-{r.Name}")" class="vs-pill vs-pill--icon vs-pill--warning" title="@Localizer["No permissions configured for this role yet - every action is denied by default"]"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Not configured"]</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", "PermissionMatrix", new { area = "Admin" }, $"role-{r.Name}")" class="vs-pill vs-pill--icon vs-pill--info"><i class="bi bi-check2-circle" aria-hidden="true"></i> @r.PermissionCount @Localizer["permissions"]</a>
                            }
                        </td>
                        <td>
                            @if (r.IsSystemRole) { <span class="vs-pill vs-pill--icon vs-pill--info"><i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["System"]</span> }
                            else { <span class="vs-pill vs-pill--neutral">@Localizer["RoL_Custom"]</span> }
                        </td>
                        <td class="text-end">
                            @if (!r.IsSystemRole)
                            {
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm(this.dataset.confirm)" data-confirm="@Localizer["RoL_ConfirmDelete"]">
                                    <button type="submit" class="lp-act lp-act--always text-danger" title="@Localizer["Ed_Delete"]" aria-label="@Localizer["Ed_Delete"] @r.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
