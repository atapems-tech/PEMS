@model PEMS.Web.Areas.Admin.Models.RoleFormViewModel

<div class="content-card" style="max-width:520px;">

    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label class="form-label">Role Name (English, no spaces)</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. QualityInspector" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Display Name</label>
            <input asp-for="DisplayName" class="form-control" placeholder="e.g. Quality Inspector" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-pems-solid">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
