@model PEMS.Web.Areas.Admin.Models.RoleFormViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="pems-s-04391f08">

    <pems-validation-summary css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-validation-summary>

    <pems-form asp-action="Create" method="post">

        <div class="mb-3">
            <pems-label>Role Name (English, no spaces)</pems-label>
            <pems-input asp-for="Name" placeholder="e.g. QualityInspector" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Display Name"]</pems-label>
            <pems-input asp-for="DisplayName" placeholder="e.g. Quality Inspector" />
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Description"]</pems-label>
            <pems-textarea asp-for="Description" rows="3"></pems-textarea>
        </div>

        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>

    </pems-form>

</pems-content-card>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
