@model PEMS.Application.DTOs.StorageProviderUpsertRequest

<div class="admin-page-shell">
    <div class="admin-hero"><div class="d-flex align-items-center gap-3"><div><p>@Model.Name</p></div></div></div>
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <form asp-action="Edit" asp-route-id="@ViewBag.StorageProviderId" method="post">
        @await Html.PartialAsync("_Form", Model)
    </form>
</div>
