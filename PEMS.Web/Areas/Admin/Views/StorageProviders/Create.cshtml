@model PEMS.Application.DTOs.StorageProviderUpsertRequest

<pems-page-shell kind="admin">
    <div class="admin-hero"><pems-flex align="center" gap="3"><div><p>Configure a new Local / Network Share / FTP / SFTP destination.</p></div></pems-flex></div>
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }
    <form asp-action="Create" method="post">
        @await Html.PartialAsync("_Form", Model)
    </form>
</pems-page-shell>
