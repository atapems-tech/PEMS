@model PEMS.Application.DTOs.StorageProviderUpsertRequest
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var providerTypes = (string[])ViewBag.ProviderTypes;
    var hasPassword = ViewBag.HasPassword as bool? ?? false;
    var isEdit = ViewBag.StorageProviderId != null;
}

<div class="content-card admin-form-card">
    <div class="row g-3">
        <div class="col-md-6">
            <pems-label>@Localizer["Name"]</pems-label>
            <pems-input asp-for="Name" required />
        </div>
        <div class="col-md-6">
            <pems-label>Code <span class="text-muted small">(unique, used in routing)</span></pems-label>
            <pems-input asp-for="Code" required />
        </div>
        <div class="col-md-6">
            <pems-label>@Localizer["Provider Type"]</pems-label>
            <pems-select asp-for="ProviderType" id="providerTypeSelect" onchange="pemsToggleStorageFields()">
                @foreach (var t in providerTypes) { <option value="@t" selected="@(t == Model.ProviderType)">@t</option> }
            </pems-select>
        </div>
        <div class="col-md-6 network-field">
            <pems-label>@Localizer["Host"]</pems-label>
            <pems-input asp-for="Host" placeholder="e.g. ftp.example.com or \\SERVER01" />
        </div>
        <div class="col-md-3 ftp-sftp-field">
            <pems-label>@Localizer["Port"]</pems-label>
            <pems-input asp-for="Port" type="number" />
        </div>
        <div class="col-md-4 network-field">
            <pems-label>@Localizer["Username"]</pems-label>
            <pems-input asp-for="Username" autocomplete="off" />
        </div>
        <div class="col-md-5 network-field">
            <pems-label>Password @if (isEdit && hasPassword) { <pems-badge tone="none" css="bg-secondary-subtle text-secondary">Currently set</pems-badge> }</pems-label>
            <pems-input asp-for="Password" type="password" autocomplete="new-password" placeholder="@(isEdit ? "Leave blank to keep current password" : "")" />
        </div>
        <div class="col-md-8">
            <pems-label>Root Path <span class="text-muted small">(local folder, UNC path, or server-side root)</span></pems-label>
            <pems-input asp-for="RootPath" required placeholder="D:\PEMS\Storage or \\SERVER01\PEMS\Documents or /remote/root" />
        </div>
        <div class="col-md-4">
            <pems-label>Base URL <span class="text-muted small">(optional, future direct-URL providers)</span></pems-label>
            <pems-input asp-for="BaseUrl" />
        </div>
        <div class="col-md-3 ftp-field">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="UseSsl" /><label class="form-check-label" asp-for="UseSsl">Use SSL/TLS</label></div>
        </div>
        <div class="col-md-3 ftp-field">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="UsePassiveMode" /><label class="form-check-label" asp-for="UsePassiveMode">@Localizer["Passive Mode"]</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="AllowRead" /><label class="form-check-label" asp-for="AllowRead">@Localizer["Allow Read"]</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="AllowWrite" /><label class="form-check-label" asp-for="AllowWrite">Allow Write</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="AllowDelete" /><label class="form-check-label" asp-for="AllowDelete">Allow Delete</label></div>
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4"><pems-input kind="check" asp-for="IsEnabled" /><label class="form-check-label" asp-for="IsEnabled">@Localizer["Enabled"]</label></div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <pems-button tone="primary" type="submit"><pems-icon name="bi-check2" css="me-1" /> @Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
    </div>
</div>

<script>
    function pemsToggleStorageFields() {
        var type = document.getElementById('providerTypeSelect').value;
        var isNetwork = (type === 'NetworkShare' || type === 'Ftp' || type === 'Sftp');
        var isFtpSftp = (type === 'Ftp' || type === 'Sftp');
        var isFtp = (type === 'Ftp');
        document.querySelectorAll('.network-field').forEach(function (el) { el.style.display = isNetwork ? '' : 'none'; });
        document.querySelectorAll('.ftp-sftp-field').forEach(function (el) { el.style.display = isFtpSftp ? '' : 'none'; });
        document.querySelectorAll('.ftp-field').forEach(function (el) { el.style.display = isFtp ? '' : 'none'; });
    }
    document.addEventListener('DOMContentLoaded', pemsToggleStorageFields);
</script>
