@model PEMS.Application.DTOs.StorageProviderUpsertRequest
@{
    var providerTypes = (string[])ViewBag.ProviderTypes;
    var hasPassword = ViewBag.HasPassword as bool? ?? false;
    var isEdit = ViewBag.StorageProviderId != null;
}

<div class="content-card admin-form-card">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Code <span class="text-muted small">(unique, used in routing)</span></label>
            <input asp-for="Code" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Provider Type</label>
            <select asp-for="ProviderType" class="form-select" id="providerTypeSelect" onchange="pemsToggleStorageFields()">
                @foreach (var t in providerTypes) { <option value="@t" selected="@(t == Model.ProviderType)">@t</option> }
            </select>
        </div>
        <div class="col-md-6 network-field">
            <label class="form-label">Host</label>
            <input asp-for="Host" class="form-control" placeholder="e.g. ftp.example.com or \\SERVER01" />
        </div>
        <div class="col-md-3 ftp-sftp-field">
            <label class="form-label">Port</label>
            <input asp-for="Port" type="number" class="form-control" />
        </div>
        <div class="col-md-4 network-field">
            <label class="form-label">Username</label>
            <input asp-for="Username" class="form-control" autocomplete="off" />
        </div>
        <div class="col-md-5 network-field">
            <label class="form-label">Password @if (isEdit && hasPassword) { <span class="badge bg-secondary-subtle text-secondary">Currently set</span> }</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="@(isEdit ? "Leave blank to keep current password" : "")" />
        </div>
        <div class="col-md-8">
            <label class="form-label">Root Path <span class="text-muted small">(local folder, UNC path, or server-side root)</span></label>
            <input asp-for="RootPath" class="form-control" required placeholder="D:\PEMS\Storage or \\SERVER01\PEMS\Documents or /remote/root" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Base URL <span class="text-muted small">(optional, future direct-URL providers)</span></label>
            <input asp-for="BaseUrl" class="form-control" />
        </div>
        <div class="col-md-3 ftp-field">
            <div class="form-check mt-4"><input asp-for="UseSsl" class="form-check-input" /><label class="form-check-label" asp-for="UseSsl">Use SSL/TLS</label></div>
        </div>
        <div class="col-md-3 ftp-field">
            <div class="form-check mt-4"><input asp-for="UsePassiveMode" class="form-check-input" /><label class="form-check-label" asp-for="UsePassiveMode">Passive Mode</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><input asp-for="AllowRead" class="form-check-input" /><label class="form-check-label" asp-for="AllowRead">Allow Read</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><input asp-for="AllowWrite" class="form-check-input" /><label class="form-check-label" asp-for="AllowWrite">Allow Write</label></div>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4"><input asp-for="AllowDelete" class="form-check-input" /><label class="form-check-label" asp-for="AllowDelete">Allow Delete</label></div>
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4"><input asp-for="IsEnabled" class="form-check-input" /><label class="form-check-label" asp-for="IsEnabled">Enabled</label></div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check2 me-1"></i> Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>

<script>
    function pemsToggleStorageFields() {
        var type = document.getElementById('providerTypeSelect').value;
        var isNetwork = (type === 'NetworkShare' || type === 'Ftp' || type === 'Sftp');
        var isFtpSftp = (type === 'Ftp' || type === 'Sftp');
        var isFtp = (type === 'Ftp');
        document.querySelectorAll('.network-field').forEach(function (el) { el.style.display = isNetwork ? '' : 'none'; });
        document.querySelectorAll('.ftp-sftp-field').forEach(function (el) { el.style.display = isFtpSftp ? '' : 'none'; });
        document.querySelectorAll('.ftp-field').forEach(function (el) { el.style.display = isFtp ? '' : 'none'; });
    }
    document.addEventListener('DOMContentLoaded', pemsToggleStorageFields);
</script>
