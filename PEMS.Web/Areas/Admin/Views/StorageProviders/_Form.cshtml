@model PEMS.Application.DTOs.StorageProviderUpsertRequest
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var providerTypes = (string[])ViewBag.ProviderTypes;
    var hasPassword = ViewBag.HasPassword as bool? ?? false;
    var isEdit = ViewBag.StorageProviderId != null;
}

<pems-content-card css="admin-form-card">
    <pems-row gap="3">
        <pems-col md="6">
            <pems-label>@Localizer["Name"]</pems-label>
            <pems-input asp-for="Name" required />
        </pems-col>
        <pems-col md="6">
            <pems-label>Code <span class="text-muted small">(unique, used in routing)</span></pems-label>
            <pems-input asp-for="Code" required />
        </pems-col>
        <pems-col md="6">
            <pems-label>@Localizer["Provider Type"]</pems-label>
            <pems-select asp-for="ProviderType" id="providerTypeSelect" onchange="pemsToggleStorageFields()">
                @foreach (var t in providerTypes) { <option value="@t" selected="@(t == Model.ProviderType)">@t</option> }
            </pems-select>
        </pems-col>
        <pems-col md="6" css="network-field">
            <pems-label>@Localizer["Host"]</pems-label>
            <pems-input asp-for="Host" placeholder="e.g. ftp.example.com or \\SERVER01" />
        </pems-col>
        <pems-col md="3" css="ftp-sftp-field">
            <pems-label>@Localizer["Port"]</pems-label>
            <pems-input asp-for="Port" type="number" />
        </pems-col>
        <pems-col md="4" css="network-field">
            <pems-label>@Localizer["Username"]</pems-label>
            <pems-input asp-for="Username" autocomplete="off" />
        </pems-col>
        <pems-col md="5" css="network-field">
            <pems-label>Password @if (isEdit && hasPassword) { <pems-badge tone="none" css="bg-secondary-subtle text-secondary">Currently set</pems-badge> }</pems-label>
            <pems-input asp-for="Password" type="password" autocomplete="new-password" placeholder="@(isEdit ? "Leave blank to keep current password" : "")" />
        </pems-col>
        <pems-col md="8">
            <pems-label>Root Path <span class="text-muted small">(local folder, UNC path, or server-side root)</span></pems-label>
            <pems-input asp-for="RootPath" required placeholder="D:\PEMS\Storage or \\SERVER01\PEMS\Documents or /remote/root" />
        </pems-col>
        <pems-col md="4">
            <pems-label>Base URL <span class="text-muted small">(optional, future direct-URL providers)</span></pems-label>
            <pems-input asp-for="BaseUrl" />
        </pems-col>
        <pems-col md="3" css="ftp-field">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="UseSsl" /><label class="form-check-label" asp-for="UseSsl">Use SSL/TLS</label></pems-check-row>
        </pems-col>
        <pems-col md="3" css="ftp-field">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="UsePassiveMode" /><label class="form-check-label" asp-for="UsePassiveMode">@Localizer["Passive Mode"]</label></pems-check-row>
        </pems-col>
        <pems-col md="2">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="AllowRead" /><label class="form-check-label" asp-for="AllowRead">@Localizer["Allow Read"]</label></pems-check-row>
        </pems-col>
        <pems-col md="2">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="AllowWrite" /><label class="form-check-label" asp-for="AllowWrite">Allow Write</label></pems-check-row>
        </pems-col>
        <pems-col md="2">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="AllowDelete" /><label class="form-check-label" asp-for="AllowDelete">Allow Delete</label></pems-check-row>
        </pems-col>
        <pems-col md="3">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="IsEnabled" /><label class="form-check-label" asp-for="IsEnabled">@Localizer["Enabled"]</label></pems-check-row>
        </pems-col>
    </pems-row>
    <pems-flex gap="2" css="mt-4">
        <pems-button tone="primary" type="submit"><pems-icon name="bi-check2" css="me-1" /> @Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
    </pems-flex>
</pems-content-card>

<script src="~/js/views/admin-storageproviders-form.js" asp-append-version="true"></script>
