@model List<PEMS.Application.DTOs.StorageProviderDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var online = Model.Count(x => x.LastHealthStatus == "Online");
    var offline = Model.Count(x => x.LastHealthStatus == "Offline" || x.LastHealthStatus == "AuthenticationFailed" || x.LastHealthStatus == "PermissionDenied");
    var enabled = Model.Count(x => x.IsEnabled);
    var totalRoutes = Model.Sum(x => x.ActiveRouteCount);
    string HealthTone(string? s) => s switch { "Online" => "vs-pill--success", "Offline" or "AuthenticationFailed" => "vs-pill--danger", "PermissionDenied" => "vs-pill--warning", _ => "vs-pill--neutral" };
    string HealthText(string? s) => VdrUi.Loc(Localizer, "StpL_Health_", s);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component. The six count cards are the KPI row (shown first); the row
   actions (edit, test connection, set default, enable / disable, delete when unused) stay. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["StpL_Title"]" heading-title="@Localizer["StpL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-kpi-toggle target="stpKpis" storage-key="pems.storageProviders.kpis" open="true" />
                <a class="lp-icon-btn" asp-controller="StorageRouting" asp-action="Index" title="@Localizer["SrtL_Title"]" aria-label="@Localizer["SrtL_Title"]"><i class="bi bi-signpost-2" aria-hidden="true"></i></a>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["StpL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="stpKpis" open="true">
            <span class="vs-chip">@Localizer["Configured"] <strong>@Model.Count</strong></span>
            <span class="vs-chip">@Localizer["Online"] <strong>@online</strong></span>
            <span class="vs-chip @(offline > 0 ? "vs-chip--danger" : "")">@Localizer["Offline / Failed"] <strong>@offline</strong></span>
            <span class="vs-chip">@Localizer["Enabled"] <strong>@enabled</strong></span>
            <span class="vs-chip">@Localizer["Default"] <strong>@Model.Count(x => x.IsDefault)</strong></span>
            <span class="vs-chip">@Localizer["Total Routes"] <strong>@totalRoutes</strong></span>
        </pems-list-kpis>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["StpL_Empty"]">
                <thead>
                    <tr>
                        <th style="width:180px">@Localizer["DpL_Name"]</th>
                        <th style="width:110px">@Localizer["MiL_Code"]</th>
                        <th style="width:110px">@Localizer["Ed_Type"]</th>
                        <th class="vs-hide-md">@Localizer["Host / Root"]</th>
                        <th style="width:80px" class="text-end">@Localizer["StpL_Routes"]</th>
                        <th style="width:150px">@Localizer["StpL_Health"]</th>
                        <th style="width:110px">@Localizer["Ed_Status"]</th>
                        <th style="width:70px">@Localizer["Default"]</th>
                        <th style="width:170px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr class="lp-row">
                        <td><a asp-action="Edit" asp-route-id="@p.StorageProviderId" class="lp-subject">@p.Name</a></td>
                        <td><code>@p.Code</code></td>
                        <td><span class="vs-pill vs-pill--neutral">@p.ProviderType</span></td>
                        <td class="small text-muted vs-hide-md"><span class="vs-num">@(string.IsNullOrEmpty(p.Host) ? p.RootPath : $"{p.Host}:{p.Port} → {p.RootPath}")</span></td>
                        <td class="text-end"><span class="vs-num">@p.ActiveRouteCount</span></td>
                        <td>
                            <span class="vs-pill @HealthTone(p.LastHealthStatus)">@HealthText(p.LastHealthStatus)</span>
                            @if (p.LastHealthCheckAt.HasValue) { <div class="vs-sub"><span class="vs-num">@p.LastHealthCheckAt.Value.ToString("yyyy-MM-dd HH:mm")</span></div> }
                        </td>
                        <td><span class="vs-pill @(p.IsEnabled ? "vs-pill--success" : "vs-pill--neutral")">@(p.IsEnabled ? Localizer["Enabled"] : Localizer["Disabled"])</span></td>
                        <td>@if (p.IsDefault) { <i class="bi bi-star-fill text-warning" title="@Localizer["Default"]" aria-label="@Localizer["Default"]"></i> }</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.StorageProviderId" class="lp-act lp-act--always" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"] @p.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form asp-action="TestConnection" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                <button type="submit" class="lp-act lp-act--always" title="@Localizer["StpL_Test"]" aria-label="@Localizer["StpL_Test"] @p.Name"><i class="bi bi-broadcast" aria-hidden="true"></i></button>
                            </form>
                            @if (!p.IsDefault)
                            {
                                <form asp-action="SetDefault" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                    <button type="submit" class="lp-act lp-act--always" title="@Localizer["StpL_SetDefault"]" aria-label="@Localizer["StpL_SetDefault"] @p.Name"><i class="bi bi-star" aria-hidden="true"></i></button>
                                </form>
                            }
                            <form asp-action="SetEnabled" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                <input type="hidden" name="enabled" value="@(!p.IsEnabled)" />
                                <button type="submit" class="lp-act lp-act--always" title="@(p.IsEnabled ? Localizer["Disable"] : Localizer["Enable"])" aria-label="@(p.IsEnabled ? Localizer["Disable"] : Localizer["Enable"]) @p.Name"><i class="bi @(p.IsEnabled ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true"></i></button>
                            </form>
                            @if (p.ActiveRouteCount == 0 && !p.IsDefault)
                            {
                                <form asp-action="Delete" asp-route-id="@p.StorageProviderId" method="post" class="d-inline" onsubmit="return confirm(this.dataset.confirm)" data-confirm="@Localizer["StpL_ConfirmDelete"]">
                                    <button type="submit" class="lp-act lp-act--always text-danger" title="@Localizer["Ed_Delete"]" aria-label="@Localizer["Ed_Delete"] @p.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
