@model List<PEMS.Application.DTOs.StorageProviderDto>
@{
    var total = Model.Count;
    var online = Model.Count(x => x.LastHealthStatus == "Online");
    var offline = Model.Count(x => x.LastHealthStatus == "Offline" || x.LastHealthStatus == "AuthenticationFailed" || x.LastHealthStatus == "PermissionDenied");
    var enabled = Model.Count(x => x.IsEnabled);
    var totalRoutes = Model.Sum(x => x.ActiveRouteCount);
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon"><i class="bi bi-hdd-network-fill"></i></div>
            <div><h2>Storage Providers</h2><p>Admin-configurable Local / Network Share / FTP / SFTP storage destinations.</p></div>
        </div>
        <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-plus-lg me-1"></i> New Provider</a>
    </div>

    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="row g-3 mb-3">
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold">@total</div><div class="text-muted small">Configured</div></div></div>
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold text-success">@online</div><div class="text-muted small">Online</div></div></div>
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold text-danger">@offline</div><div class="text-muted small">Offline / Failed</div></div></div>
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold">@enabled</div><div class="text-muted small">Enabled</div></div></div>
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold">@Model.Count(x => x.IsDefault)</div><div class="text-muted small">Default</div></div></div>
        <div class="col-md-2 col-sm-4"><div class="content-card text-center py-3"><div class="fs-4 fw-bold">@totalRoutes</div><div class="text-muted small">Total Routes</div></div></div>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr><th>Name</th><th>Code</th><th>Type</th><th>Host / Root</th><th>Routes</th><th>Health</th><th>Status</th><th>Default</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><span class="row-primary">@p.Name</span></td>
                        <td><code>@p.Code</code></td>
                        <td><span class="badge bg-secondary">@p.ProviderType</span></td>
                        <td class="small text-muted">@(string.IsNullOrEmpty(p.Host) ? p.RootPath : $"{p.Host}:{p.Port} → {p.RootPath}")</td>
                        <td>@p.ActiveRouteCount</td>
                        <td>
                            @{
                                var badgeClass = p.LastHealthStatus switch { "Online" => "bg-success", "Offline" => "bg-danger", "AuthenticationFailed" => "bg-danger", "PermissionDenied" => "bg-warning text-dark", "Disabled" => "bg-secondary", _ => "bg-secondary" };
                            }
                            <span class="badge @badgeClass">@p.LastHealthStatus</span>
                            @if (p.LastHealthCheckAt.HasValue) { <div class="text-muted" style="font-size:.7rem">@p.LastHealthCheckAt.Value.ToString("yyyy-MM-dd HH:mm")</div> }
                        </td>
                        <td>
                            @if (p.IsEnabled) { <span class="badge bg-success-subtle text-success">Enabled</span> } else { <span class="badge bg-secondary-subtle text-secondary">Disabled</span> }
                        </td>
                        <td>@if (p.IsDefault) { <i class="bi bi-star-fill text-warning" title="Default"></i> }</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-action="Edit" asp-route-id="@p.StorageProviderId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="TestConnection" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Test Connection"><i class="bi bi-broadcast"></i></button>
                                </form>
                                @if (!p.IsDefault)
                                {
                                    <form asp-action="SetDefault" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Set as Default"><i class="bi bi-star"></i></button>
                                    </form>
                                }
                                <form asp-action="SetEnabled" asp-route-id="@p.StorageProviderId" method="post" class="d-inline">
                                    <input type="hidden" name="enabled" value="@(!p.IsEnabled)" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(p.IsEnabled ? "Disable" : "Enable")"><i class="bi @(p.IsEnabled ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                                </form>
                                @if (p.ActiveRouteCount == 0 && !p.IsDefault)
                                {
                                    <form asp-action="Delete" asp-route-id="@p.StorageProviderId" method="post" class="d-inline" onsubmit="return confirm('Delete this Storage Provider? This cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0) { <div class="admin-empty"><i class="bi bi-hdd-network"></i><strong>No Storage Providers configured yet</strong></div> }
    </div>
</div>
