@model IReadOnlyList<PEMS.Application.Interfaces.NumberingSchemeView>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using PEMS.Domain.Entities
@using PEMS.Application.Numbering
@inject IStringLocalizer<SharedResource> Localizer
@* SCRUM-40: numbering patterns of the procurement documents. Live preview: ~/js/admin-numbering.js
   SCRUM-337 RelatedList: list-page frame; each row is edited in place (pems-related-row-form / pems-related-save). *@

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] is string msg) { <pems-alert tone="success" css="py-2 px-3 small">@Localizer[msg]</pems-alert> }
    @if (TempData["Error"] is string err) { <pems-alert tone="danger" css="py-2 px-3 small">@Localizer[err]</pems-alert> }

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["NumL_Title"]" heading-title="@Localizer["Num_Intro"]" total="@Model.Count" />

        <div class="small text-muted px-3 py-2">@Localizer["Num_Tokens"] @foreach (var t in NumberingPattern.Tokens) { <code class="me-1">@t</code> }</div>

        <pems-related-table id="numberingTable" data-preview-url="@Url.Action("Preview")" data-err-network="@Localizer["Num_Err_Network"]">
            <thead>
                <tr>
                    <th>@Localizer["Num_DocumentType"]</th>
                    <th>@Localizer["Num_Pattern"]</th>
                    <th style="width:90px">@Localizer["Num_Pad"]</th>
                    <th style="width:130px">@Localizer["Num_Calendar"]</th>
                    <th style="width:130px">@Localizer["Num_Reset"]</th>
                    <th style="width:70px">@Localizer["Active"]</th>
                    <th style="width:90px">@Localizer["Num_AllowManual"]</th>
                    <th>@Localizer["Num_Preview"]</th>
                    <th style="width:90px">@Localizer["Num_Version"]</th>
                    <th style="width:50px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var formId = "num_" + s.DocumentType;
                    <tr data-numbering-row>
                        <td>
                            <strong>@Localizer["Num_Doc_" + s.DocumentType]</strong>
                            <pems-related-row-form id="@formId" action="@Url.Action("Save")">
                                <input type="hidden" name="DocumentType" value="@s.DocumentType" />
                                <input type="hidden" name="RowVersion" value="@s.RowVersion" />
                            </pems-related-row-form>
                        </td>
                        <td><input form="@formId" name="Pattern" value="@s.Pattern" class="form-control form-control-sm font-monospace" maxlength="@NumberingPattern.MaxPatternLength" required aria-label="@Localizer["Num_Pattern"]" data-num-input /></td>
                        <td><input form="@formId" type="number" name="PadWidth" value="@s.PadWidth" min="@NumberingPattern.MinPad" max="@NumberingPattern.MaxPad" class="form-control form-control-sm" aria-label="@Localizer["Num_Pad"]" data-num-input /></td>
                        <td>
                            <select form="@formId" name="Calendar" class="form-select form-select-sm" aria-label="@Localizer["Num_Calendar"]" data-num-input>
                                @foreach (var c in NumberingCalendars.All) { <option value="@c" selected="@(c == s.Calendar)">@Localizer["Num_Cal_" + c]</option> }
                            </select>
                        </td>
                        <td>
                            <select form="@formId" name="ResetPeriod" class="form-select form-select-sm" aria-label="@Localizer["Num_Reset"]" data-num-input>
                                @foreach (var r in NumberingResetPeriods.All) { <option value="@r" selected="@(r == s.ResetPeriod)">@Localizer["Num_Reset_" + r]</option> }
                            </select>
                        </td>
                        <td><input form="@formId" type="checkbox" name="IsActive" value="true" class="form-check-input" checked="@s.IsActive" aria-label="@Localizer["Active"]" /></td>
                        <td><input form="@formId" type="checkbox" name="AllowManualEntry" value="true" class="form-check-input" checked="@s.AllowManualEntry" aria-label="@Localizer["Num_AllowManual"]" /></td>
                        <td><code data-num-preview aria-live="polite">@s.Preview</code><div class="small text-danger" data-num-error></div></td>
                        <td>
                            <span class="vs-num">@(s.Version == 0 ? "-" : s.Version.ToString())</span>
                            @if (s.ModifiedBy != null) { <div class="vs-sub">@s.ModifiedBy</div> }
                        </td>
                        <td class="text-end"><pems-related-save form-id="@formId" label="@Localizer["Save"]" /></td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
        <p class="small text-muted px-3 py-2 mb-0">@Localizer["Num_Footnote"]</p>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/js/admin-numbering.js" asp-append-version="true"></script>
}
