@model PEMS.Web.Areas.Admin.Models.NavigationMenuCreateViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var input = Model.Input;
}

<pems-page-shell kind="admin">
    <pems-content-card css="pems-s-71e17938">
        <h2 class="h5 mb-1">@Localizer["Nav_Admin_AddLink"]</h2>
        <p class="small text-body-tertiary mb-3">@Localizer["Nav_AddLinkIntro"]</p>

        <div asp-validation-summary="All" class="text-danger small mb-2" role="alert"></div>

        <pems-form method="post" asp-action="Create">
            <div class="mb-3">
                <pems-label for="ParentKey">@Localizer["Nav_Field_Parent"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
                <pems-select id="ParentKey" name="ParentKey" required>
                    @foreach (var (key, title) in Model.Parents)
                    {
                        <option value="@key" selected="@(input.ParentKey == key)">@title</option>
                    }
                </pems-select>
            </div>

            <pems-row gap="3" css="mb-3">
                <pems-col md="6">
                    <pems-label for="TitleFa">@Localizer["Nav_Field_TitleFa"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
                    <pems-input id="TitleFa" name="TitleFa" value="@input.TitleFa" maxlength="200" dir="rtl" required />
                </pems-col>
                <pems-col md="6">
                    <pems-label for="TitleEn">@Localizer["Nav_Field_TitleEn"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
                    <pems-input id="TitleEn" name="TitleEn" value="@input.TitleEn" maxlength="200" dir="ltr" required />
                </pems-col>
            </pems-row>

            <fieldset class="mb-3">
                <pems-label as="legend" css="fs-6">@Localizer["Nav_Field_Route"] <span class="text-danger" aria-hidden="true">*</span></pems-label>
                <pems-row gap="2" dir="ltr">
                    <pems-col md="4">
                        <pems-label css="small" for="Area">@Localizer["Nav_Field_Area"]</pems-label>
                        <pems-input id="Area" name="Area" value="@input.Area" maxlength="100" />
                    </pems-col>
                    <pems-col md="4">
                        <pems-label css="small" for="Controller">@Localizer["Nav_Field_Controller"]</pems-label>
                        <pems-input id="Controller" name="Controller" value="@input.Controller" maxlength="100" required />
                    </pems-col>
                    <pems-col md="4">
                        <pems-label css="small" for="Action">@Localizer["Nav_Field_Action"]</pems-label>
                        <pems-input id="Action" name="Action" value="@input.Action" maxlength="100" required />
                    </pems-col>
                </pems-row>
                <pems-help-text>@Localizer["Nav_RouteHelp"]</pems-help-text>
            </fieldset>

            <div class="mb-3">
                <pems-label for="RequiredPermission">@Localizer["Nav_Field_Permission"]</pems-label>
                <pems-select id="RequiredPermission" name="RequiredPermission" aria-describedby="permHelp" dir="ltr">
                    <option value="">@Localizer["Nav_NoPermission"]</option>
                    @foreach (var p in Model.Permissions)
                    {
                        <option value="@p" selected="@(input.RequiredPermission == p)">@p</option>
                    }
                </pems-select>
                <pems-help-text id="permHelp">@Localizer["Nav_PermissionHelp"]</pems-help-text>
            </div>

            <div class="mb-4">
                <pems-label for="Icon">@Localizer["Nav_Field_Icon"]</pems-label>
                <pems-input id="Icon" name="Icon" value="@input.Icon" maxlength="60" dir="ltr" pattern="bi-[a-z0-9-]{1,50}" placeholder="bi-link-45deg" />
            </div>

            <pems-flex gap="2">
                <pems-button tone="none" css="btn-primary" type="submit">@Localizer["Save"]</pems-button>
                <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
            </pems-flex>
        </pems-form>
    </pems-content-card>
</pems-page-shell>
