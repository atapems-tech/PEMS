@model PEMS.Web.Areas.Admin.Models.NavigationMenuEditViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Navigation
@using PEMS.Domain.Entities
@inject IStringLocalizer<SharedResource> Localizer
@{
    var i = Model.Item;
    var input = Model.Input;
}

<pems-page-shell kind="admin">
    <pems-content-card css="pems-s-71e17938">
        <h2 class="h5 mb-1">@Localizer["Nav_Admin_Edit"]</h2>
        <p class="small text-body-tertiary mb-3" dir="ltr">@i.Key · @i.VisibilityRule</p>

        <div asp-validation-summary="All" class="text-danger small mb-2" role="alert"></div>

        <form method="post" asp-action="Edit">
            <input type="hidden" name="Key" value="@i.Key" />
            <input type="hidden" name="RowVersion" value="@input.RowVersion" />

            <div class="mb-3">
                <pems-label for="ParentKey">@Localizer["Nav_Field_Parent"]</pems-label>
                <pems-select id="ParentKey" name="ParentKey" disabled="@(i.Kind == NavigationMenuItemKinds.Section)">
                    @if (i.Kind != NavigationMenuItemKinds.Subheading)
                    {
                        <option value="" selected="@(input.ParentKey == null)">@Localizer["Nav_TopLevel"]</option>
                    }
                    @foreach (var (key, title) in Model.Parents)
                    {
                        <option value="@key" selected="@(input.ParentKey == key)">@title</option>
                    }
                </pems-select>
                @if (i.Kind == NavigationMenuItemKinds.Section)
                {
                    <pems-help-text>@Localizer["Nav_SectionTopLevelOnly"]</pems-help-text>
                }
            </div>

            <pems-row gap="3" css="mb-3">
                <pems-col md="6">
                    <pems-label for="TitleFa">@Localizer["Nav_Field_TitleFa"]</pems-label>
                    <pems-input id="TitleFa" name="TitleFa" value="@input.TitleFa" maxlength="200" dir="rtl" placeholder="@Model.DefaultTitle" aria-describedby="titleHelp" />
                </pems-col>
                <pems-col md="6">
                    <pems-label for="TitleEn">@Localizer["Nav_Field_TitleEn"]</pems-label>
                    <pems-input id="TitleEn" name="TitleEn" value="@input.TitleEn" maxlength="200" dir="ltr" placeholder="@Model.DefaultTitle" aria-describedby="titleHelp" />
                </pems-col>
                <pems-help-text id="titleHelp">@Localizer["Nav_TitleHelp"]</pems-help-text>
            </pems-row>

            <div class="mb-3">
                <pems-label for="Icon">@Localizer["Nav_Field_Icon"]</pems-label>
                <div class="input-group">
                    <span class="input-group-text"><pems-icon css="@input.Icon" id="iconPreview" aria-hidden="true" /></span>
                    <pems-input id="Icon" name="Icon" value="@input.Icon" maxlength="60" dir="ltr" pattern="bi-[a-z0-9-]{1,50}" aria-describedby="iconHelp" />
                </div>
                <pems-help-text id="iconHelp">@Localizer["Nav_IconHelp"]</pems-help-text>
            </div>

            @if (i.Kind == NavigationMenuItemKinds.Link)
            {
                <div class="mb-3">
                    <pems-label for="BadgeKey">@Localizer["Nav_Field_Badge"]</pems-label>
                    <pems-select id="BadgeKey" name="BadgeKey" aria-describedby="badgeHelp">
                        <option value="">@Localizer["Nav_NoBadge"]</option>
                        @foreach (var b in NavigationBadges.All)
                        {
                            <option value="@b.Key" selected="@(input.BadgeKey == b.Key)">@Localizer[b.TitleKey]</option>
                        }
                    </pems-select>
                    <pems-help-text id="badgeHelp">@Localizer["Nav_BadgeHelp"]</pems-help-text>
                </div>
            }

            <pems-check-row switch css="mb-4">
                <pems-input type="checkbox" id="IsActive" name="IsActive" value="true" checked="@input.IsActive" kind="check" />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label" for="IsActive">@Localizer["Nav_Field_Visible"]</label>
            </pems-check-row>

            <pems-flex gap="2">
                <pems-button tone="none" css="btn-primary" type="submit">@Localizer["Save"]</pems-button>
                <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
            </pems-flex>
        </form>
    </pems-content-card>
</pems-page-shell>

<script src="~/js/views/admin-navigationmenu-edit.js" asp-append-version="true"></script>
