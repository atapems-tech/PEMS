@model List<PEMS.Web.Areas.Admin.Models.NavigationMenuAdminRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Navigation
@using PEMS.Domain.Entities
@inject IStringLocalizer<SharedResource> Localizer

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" justify="between" gap="3" wrap="true">
            <p class="mb-0">@Localizer["Nav_Admin_Intro"]</p>
            <pems-button as="a" tone="none" size="small" css="btn-primary" asp-action="Create"><pems-icon name="bi-plus-lg" css="me-1" />@Localizer["Nav_Admin_AddLink"]</pems-button>
        </pems-flex>
    </pems-page-hero>

    <pems-content-card>
        @if (TempData["Success"] != null)
        {
            <pems-alert tone="success" css="py-2">@TempData["Success"]</pems-alert>
        }
        @if (TempData["Error"] != null)
        {
            <pems-alert tone="danger" css="py-2">@TempData["Error"]</pems-alert>
        }

        <div class="permission-intro mb-3">
            <pems-icon name="bi-info-circle" css="me-1" />@Localizer["Nav_Admin_RuleNote"]
        </div>

        <pems-table-scroll>
            <pems-table scale="small" css="align-middle">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header scope="col">@Localizer["Nav_Col_Item"]</pems-table-header>
                        <pems-table-header scope="col">@Localizer["Nav_Col_Route"]</pems-table-header>
                        <pems-table-header scope="col">@Localizer["Nav_Col_Rule"]</pems-table-header>
                        <pems-table-header scope="col">@Localizer["Nav_Col_Badge"]</pems-table-header>
                        <pems-table-header scope="col">@Localizer["Nav_Col_Status"]</pems-table-header>
                        <pems-table-header scope="col" class="text-end">@Localizer["Nav_Col_Actions"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var row in Model)
                    {
                        var i = row.Item;
                        var badge = NavigationBadges.Find(i.BadgeKey);
                        <pems-table-row id="row-@i.Key" class="@(i.IsActive ? "" : "text-body-tertiary")">
                            <pems-table-cell>
                                <pems-flex align="center" gap="2" css="pems-indent-@Math.Min(row.Depth, 8)">
                                    @if (!string.IsNullOrEmpty(i.Icon))
                                    {
                                        <pems-icon css="@i.Icon" aria-hidden="true" />
                                    }
                                    <span class="@(i.Kind == NavigationMenuItemKinds.Link ? "" : "fw-semibold")">@row.Title</span>
                                    <pems-badge tone="light">@Localizer["Nav_Kind_" + i.Kind]</pems-badge>
                                    @if (!i.IsSystem)
                                    {
                                        <pems-badge tone="info">@Localizer["Nav_Custom"]</pems-badge>
                                    }
                                </pems-flex>
                                <div class="small text-body-tertiary pems-indent-@Math.Min(row.Depth, 8)" dir="ltr">@i.Key</div>
                            </pems-table-cell>
                            <pems-table-cell class="small" dir="ltr">@row.Route</pems-table-cell>
                            <pems-table-cell class="small">
                                <code dir="ltr">@i.VisibilityRule</code>
                                @if (row.NoPermissionSignal)
                                {
                                    <div><pems-badge tone="warning">@Localizer["Nav_NoPermissionSignal"]</pems-badge></div>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="small">@(badge != null ? Localizer[badge.TitleKey].Value : "")</pems-table-cell>
                            <pems-table-cell>
                                @if (i.IsActive)
                                {
                                    <pems-badge tone="success">@Localizer["Nav_Visible"]</pems-badge>
                                }
                                else
                                {
                                    <pems-badge tone="neutral">@Localizer["Nav_Hidden"]</pems-badge>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="text-end text-nowrap">
                                <form method="post" asp-action="Move" class="d-inline">
                                    <input type="hidden" name="key" value="@i.Key" />
                                    <input type="hidden" name="up" value="true" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" disabled="@row.IsFirst" aria-label="@Localizer["Nav_MoveUp"]: @row.Title" title="@Localizer["Nav_MoveUp"]"><pems-icon name="bi-arrow-up" /></pems-button>
                                </form>
                                <form method="post" asp-action="Move" class="d-inline">
                                    <input type="hidden" name="key" value="@i.Key" />
                                    <input type="hidden" name="up" value="false" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" disabled="@row.IsLast" aria-label="@Localizer["Nav_MoveDown"]: @row.Title" title="@Localizer["Nav_MoveDown"]"><pems-icon name="bi-arrow-down" /></pems-button>
                                </form>
                                <pems-button as="a" tone="primary" size="small" outline="true" asp-action="Edit" asp-route-key="@i.Key" aria-label="@Localizer["Edit"]: @row.Title"><pems-icon name="bi-pencil" /></pems-button>
                                @if (!i.IsSystem)
                                {
                                    <form method="post" asp-action="Delete" class="d-inline" data-pems-confirm="@Localizer["Nav_ConfirmDelete"]">
                                        <input type="hidden" name="key" value="@i.Key" />
                                        <pems-button tone="danger" size="small" outline="true" type="submit" aria-label="@Localizer["Delete"]: @row.Title"><pems-icon name="bi-trash" /></pems-button>
                                    </form>
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    </pems-content-card>
</pems-page-shell>
