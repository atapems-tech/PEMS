@model PEMS.Application.DTOs.StorageRouteUpsertRequest
@{
    var providers = (List<PEMS.Application.DTOs.StorageProviderDto>)ViewBag.Providers;
}

<div class="content-card admin-form-card">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Module <span class="text-muted small">e.g. EngineeringDocuments, VDR, Contracts</span></label>
            <input asp-for="Module" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Document Type <span class="text-muted small">(optional — leave blank for module-wide default)</span></label>
            <input asp-for="DocumentType" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Storage Provider</label>
            <select asp-for="StorageProviderId" class="form-select" required>
                <option value="">-- select --</option>
                @foreach (var p in providers) { <option value="@p.StorageProviderId" selected="@(p.StorageProviderId == Model.StorageProviderId)">@p.Name (@p.ProviderType)</option> }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Relative Root Path <span class="text-muted small">(optional subfolder inside the provider's root)</span></label>
            <input asp-for="RelativeRootPath" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Priority <span class="text-muted small">(higher wins among overlapping routes)</span></label>
            <input asp-for="Priority" type="number" class="form-control" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4"><input asp-for="IsEnabled" class="form-check-input" /><label class="form-check-label" asp-for="IsEnabled">Enabled</label></div>
            <div class="form-check"><input asp-for="IsDefault" class="form-check-input" /><label class="form-check-label" asp-for="IsDefault">Module Default</label></div>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check2 me-1"></i> Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>
