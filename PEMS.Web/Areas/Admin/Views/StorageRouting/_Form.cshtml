@model PEMS.Application.DTOs.StorageRouteUpsertRequest
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var providers = (List<PEMS.Application.DTOs.StorageProviderDto>)ViewBag.Providers;
}

<pems-content-card css="admin-form-card">
    <pems-row gap="3">
        <pems-col md="4">
            <pems-label>Module <span class="text-muted small">e.g. EngineeringDocuments, VDR, Contracts</span></pems-label>
            <pems-input asp-for="Module" required />
        </pems-col>
        <pems-col md="4">
            <pems-label>Document Type <span class="text-muted small">(optional — leave blank for module-wide default)</span></pems-label>
            <pems-input asp-for="DocumentType" />
        </pems-col>
        <pems-col md="4">
            <pems-label>@Localizer["Storage Provider"]</pems-label>
            <pems-select asp-for="StorageProviderId" required>
                <option value="">@Localizer["-- select --"]</option>
                @foreach (var p in providers) { <option value="@p.StorageProviderId" selected="@(p.StorageProviderId == Model.StorageProviderId)">@p.Name (@p.ProviderType)</option> }
            </pems-select>
        </pems-col>
        <pems-col md="6">
            <pems-label>Relative Root Path <span class="text-muted small">(optional subfolder inside the provider's root)</span></pems-label>
            <pems-input asp-for="RelativeRootPath" />
        </pems-col>
        <pems-col md="3">
            <pems-label>Priority <span class="text-muted small">(higher wins among overlapping routes)</span></pems-label>
            <pems-input asp-for="Priority" type="number" />
        </pems-col>
        <pems-col md="3">
            <pems-check-row css="mt-4"><pems-input kind="check" asp-for="IsEnabled" /><label class="form-check-label" asp-for="IsEnabled">@Localizer["Enabled"]</label></pems-check-row>
            <pems-check-row><pems-input kind="check" asp-for="IsDefault" /><label class="form-check-label" asp-for="IsDefault">@Localizer["Module Default"]</label></pems-check-row>
        </pems-col>
    </pems-row>
    <pems-flex gap="2" css="mt-4">
        <pems-button tone="primary" type="submit"><pems-icon name="bi-check2" css="me-1" /> @Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
    </pems-flex>
</pems-content-card>
