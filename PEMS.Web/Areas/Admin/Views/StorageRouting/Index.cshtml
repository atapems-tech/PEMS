@model List<PEMS.Application.DTOs.StorageRouteDto>

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon"><i class="bi bi-signpost-2-fill"></i></div>
            <div><h2>Storage Routing</h2><p>Which module / document type is saved to which Storage Provider.</p></div>
        </div>
        <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-plus-lg me-1"></i> New Route</a>
    </div>

    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr><th>Module</th><th>Document Type</th><th>Storage Provider</th><th>Relative Root</th><th>Priority</th><th>Default</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><span class="row-primary">@r.Module</span></td>
                        <td>@(r.DocumentType ?? "(any)")</td>
                        <td>@r.StorageProviderName</td>
                        <td class="text-muted small">@r.RelativeRootPath</td>
                        <td>@r.Priority</td>
                        <td>@if (r.IsDefault) { <i class="bi bi-star-fill text-warning"></i> }</td>
                        <td>@if (r.IsEnabled) { <span class="badge bg-success-subtle text-success">Enabled</span> } else { <span class="badge bg-secondary-subtle text-secondary">Disabled</span> }</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@r.StorageRouteId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@r.StorageRouteId" method="post" class="d-inline" onsubmit="return confirm('Delete this storage route?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0) { <div class="admin-empty"><i class="bi bi-signpost-2"></i><strong>No storage routes configured — uploads fall back to the global default Storage Provider</strong></div> }
    </div>
</div>
