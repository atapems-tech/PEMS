@model List<PEMS.Application.DTOs.StorageRouteDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component; edit and delete stay on each route. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SrtL_Title"]" heading-title="@Localizer["SrtL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <a class="lp-icon-btn" asp-controller="StorageProviders" asp-action="Index" title="@Localizer["StpL_Title"]" aria-label="@Localizer["StpL_Title"]"><i class="bi bi-hdd-network" aria-hidden="true"></i></a>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["SrtL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["SrtL_Empty"]">
                <thead>
                    <tr>
                        <th style="width:150px">@Localizer["Module"]</th>
                        <th style="width:150px">@Localizer["Document Type"]</th>
                        <th style="width:180px">@Localizer["Storage Provider"]</th>
                        <th class="vs-hide-md">@Localizer["Relative Root"]</th>
                        <th style="width:80px" class="text-end">@Localizer["Priority"]</th>
                        <th style="width:80px">@Localizer["Default"]</th>
                        <th style="width:110px">@Localizer["Ed_Status"]</th>
                        <th style="width:90px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr class="lp-row">
                        <td><a asp-action="Edit" asp-route-id="@r.StorageRouteId" class="lp-subject">@r.Module</a></td>
                        <td class="small">@(r.DocumentType ?? Localizer["SrtL_Any"].Value)</td>
                        <td class="small">@r.StorageProviderName</td>
                        <td class="small text-muted vs-hide-md"><span class="vs-num">@r.RelativeRootPath</span></td>
                        <td class="text-end"><span class="vs-num">@r.Priority</span></td>
                        <td>@if (r.IsDefault) { <i class="bi bi-star-fill text-warning" title="@Localizer["Default"]" aria-label="@Localizer["Default"]"></i> }</td>
                        <td><span class="vs-pill @(r.IsEnabled ? "vs-pill--success" : "vs-pill--neutral")">@(r.IsEnabled ? Localizer["Enabled"] : Localizer["Disabled"])</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@r.StorageRouteId" class="lp-act lp-act--always" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <form asp-action="Delete" asp-route-id="@r.StorageRouteId" method="post" class="d-inline" onsubmit="return confirm(this.dataset.confirm)" data-confirm="@Localizer["SrtL_ConfirmDelete"]">
                                <button type="submit" class="lp-act lp-act--always text-danger" title="@Localizer["Ed_Delete"]" aria-label="@Localizer["Ed_Delete"]"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
