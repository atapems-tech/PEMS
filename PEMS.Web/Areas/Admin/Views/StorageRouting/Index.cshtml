@model List<PEMS.Application.DTOs.StorageRouteDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component; edit and delete stay on each route. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SrtL_Title"]" heading-title="@Localizer["SrtL_Hint"]" total="@Model.Count">
            <pems-list-tools>
                <a class="lp-icon-btn" asp-controller="StorageProviders" asp-action="Index" title="@Localizer["StpL_Title"]" aria-label="@Localizer["StpL_Title"]"><pems-icon name="bi-hdd-network" aria-hidden="true" /></a>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["SrtL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["SrtL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-150">@Localizer["Module"]</pems-table-header>
                        <pems-table-header class="pems-w-150">@Localizer["Document Type"]</pems-table-header>
                        <pems-table-header class="pems-w-180">@Localizer["Storage Provider"]</pems-table-header>
                        <pems-table-header class="vs-hide-md">@Localizer["Relative Root"]</pems-table-header>
                        <pems-table-header class="text-end pems-w-80">@Localizer["Priority"]</pems-table-header>
                        <pems-table-header class="pems-w-80">@Localizer["Default"]</pems-table-header>
                        <pems-table-header class="pems-w-110">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-90"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var r in Model)
                {
                    <pems-table-row class="lp-row">
                        <pems-table-cell><a asp-action="Edit" asp-route-id="@r.StorageRouteId" class="lp-subject">@r.Module</a></pems-table-cell>
                        <pems-table-cell class="small">@(r.DocumentType ?? Localizer["SrtL_Any"].Value)</pems-table-cell>
                        <pems-table-cell class="small">@r.StorageProviderName</pems-table-cell>
                        <pems-table-cell class="small text-muted vs-hide-md"><span class="vs-num">@r.RelativeRootPath</span></pems-table-cell>
                        <pems-table-cell class="text-end"><span class="vs-num">@r.Priority</span></pems-table-cell>
                        <pems-table-cell>@if (r.IsDefault) { <pems-icon name="bi-star-fill" css="text-warning" title="@Localizer["Default"]" aria-label="@Localizer["Default"]" /> }</pems-table-cell>
                        <pems-table-cell><span class="vs-pill @(r.IsEnabled ? "vs-pill--success" : "vs-pill--neutral")">@(r.IsEnabled ? Localizer["Enabled"] : Localizer["Disabled"])</span></pems-table-cell>
                        <pems-table-cell class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@r.StorageRouteId" class="lp-act lp-act--always" title="@Localizer["Ed_Edit"]" aria-label="@Localizer["Ed_Edit"]"><pems-icon name="bi-pencil" aria-hidden="true" /></a>
                            <pems-form asp-action="Delete" asp-route-id="@r.StorageRouteId" method="post" class="d-inline" data-pems-confirm="@Localizer["SrtL_ConfirmDelete"]">
                                <pems-button tone="bare" type="submit" css="lp-act lp-act--always text-danger" title="@Localizer["Ed_Delete"]" aria-label="@Localizer["Ed_Delete"]"><pems-icon name="bi-trash" aria-hidden="true" /></pems-button>
                            </pems-form>
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
