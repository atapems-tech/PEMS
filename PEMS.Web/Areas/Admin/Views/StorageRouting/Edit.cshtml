@model PEMS.Application.DTOs.StorageRouteUpsertRequest

<pems-page-shell kind="admin">
    <div class="admin-hero"><pems-flex align="center" gap="3"><div><p>@Model.Module</p></div></pems-flex></div>
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }
    <form asp-action="Edit" asp-route-id="@ViewBag.StorageRouteId" method="post">
        @await Html.PartialAsync("_Form", Model)
    </form>
</pems-page-shell>
