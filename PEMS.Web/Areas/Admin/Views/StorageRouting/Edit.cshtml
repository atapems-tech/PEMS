@model PEMS.Application.DTOs.StorageRouteUpsertRequest

<div class="admin-page-shell">
    <div class="admin-hero"><div class="d-flex align-items-center gap-3"><div class="admin-hero-icon"><i class="bi bi-signpost-2-fill"></i></div><div><h2>Edit Storage Route</h2><p>@Model.Module</p></div></div></div>
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <form asp-action="Edit" asp-route-id="@ViewBag.StorageRouteId" method="post">
        @await Html.PartialAsync("_Form", Model)
    </form>
</div>
