@model PEMS.Application.DTOs.StorageRouteUpsertRequest

<pems-page-shell kind="admin">
    <div class="admin-hero"><div class="d-flex align-items-center gap-3"><div><p>Route a module (and optionally a document type) to a Storage Provider.</p></div></div></div>
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }
    <form asp-action="Create" method="post">
        @await Html.PartialAsync("_Form", Model)
    </form>
</pems-page-shell>
