@model List<PEMS.Application.DTOs.RoutingRuleDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var confidence = (PEMS.Application.DTOs.AIConfidenceSettingsDto)ViewBag.Confidence;
    var modules = (string[])ViewBag.Modules;
}

<div class="admin-page-shell">
    <div class="admin-hero"><div class="d-flex align-items-center gap-3"><div><p>Control AI confidence gates and automatic document routing into PEMS modules.</p></div></div></div>
    <div class="content-card admin-form-card">
        <div class="d-flex align-items-center gap-2 mb-3"><i class="bi bi-speedometer2 text-warning"></i><div><h6 class="mb-0">@Localizer["Confidence Gates"]</h6><span class="text-body-secondary small">Values must remain between 0 and 1.</span></div></div>
        <form asp-action="SetConfidence" method="post" class="row g-3 align-items-end">
            <div class="col-md-4"><label class="form-label">@Localizer["High threshold"]</label><input name="highThreshold" type="number" step="0.01" min="0" max="1" class="form-control" value="@confidence.HighThreshold" /><div class="form-text">Above this value, processing may be automatic.</div></div>
            <div class="col-md-4"><label class="form-label">@Localizer["Medium threshold"]</label><input name="mediumThreshold" type="number" step="0.01" min="0" max="1" class="form-control" value="@confidence.MediumThreshold" /><div class="form-text">Above this value, engineering review is expected.</div></div>
            <div class="col-md-4"><button class="btn btn-pems-solid"><i class="bi bi-check2 me-1"></i> @Localizer["Save thresholds"]</button></div>
        </form>
    </div>
    <div class="content-card">
        <div class="admin-toolbar"><div><strong>Document Routing</strong><div class="text-body-secondary small">Category → target module and high-confidence auto-routing.</div></div></div>
        <div class="table-responsive"><table class="table table-enterprise"><thead><tr><th>@Localizer["Category"]</th><th>@Localizer["Target Module"]</th><th>@Localizer["Auto Route"]</th><th>@Localizer["Description"]</th><th>@Localizer["Action"]</th></tr></thead><tbody>
        @foreach(var r in Model){var formId=$"rule_{r.RoutingRuleId}";<tr><td><span class="row-primary">@r.DocumentCategory</span><form id="@formId" asp-action="SetRule" method="post" class="d-none"><input type="hidden" name="category" value="@r.DocumentCategory" /></form></td><td><select form="@formId" name="targetModule" class="form-select form-select-sm">@foreach(var m in modules){<option value="@m" selected="@(m==r.TargetModule)">@m</option>}</select></td><td class="text-center"><input form="@formId" class="form-check-input" type="checkbox" name="allowAutoRouting" value="true" checked="@r.AllowAutoRouting" /></td><td><input form="@formId" name="description" class="form-control form-control-sm" value="@r.Description" /></td><td><button type="submit" form="@formId" class="btn btn-sm btn-outline-primary"><i class="bi bi-check2 me-1"></i>@Localizer["Save"]</button></td></tr>}
        </tbody></table></div>
        @if(Model.Count == 0){<div class="admin-empty"><i class="bi bi-signpost"></i><strong>No routing rules configured</strong></div>}
    </div>
</div>
