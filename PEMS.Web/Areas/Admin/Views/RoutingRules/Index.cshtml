@model List<PEMS.Application.DTOs.RoutingRuleDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var confidence = (PEMS.Application.DTOs.AIConfidenceSettingsDto)ViewBag.Confidence;
    var modules = (string[])ViewBag.Modules;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 RelatedList: the confidence gates are a related section with their form; each routing rule is edited in place
   (pems-related-row-form / pems-related-save). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-related-list id="rrConfidence" icon="bi-speedometer2" title="@Localizer["Confidence Gates"]">
        <pems-related-add action="@Url.Action("SetConfidence")" submit-label="@Localizer["Save thresholds"]">
            <div>
                <label class="lp-lbl" for="rrHigh">@Localizer["High threshold"]</label>
                <pems-input scale="small" id="rrHigh" name="highThreshold" type="number" step="0.01" min="0" max="1" value="@confidence.HighThreshold" />
                <pems-help-text>@Localizer["RrL_HighHelp"]</pems-help-text>
            </div>
            <div>
                <label class="lp-lbl" for="rrMedium">@Localizer["Medium threshold"]</label>
                <pems-input scale="small" id="rrMedium" name="mediumThreshold" type="number" step="0.01" min="0" max="1" value="@confidence.MediumThreshold" />
                <pems-help-text>@Localizer["RrL_MediumHelp"]</pems-help-text>
            </div>
        </pems-related-add>
    </pems-related-list>

    <pems-list-panel>
        <pems-list-toolbar heading="@Localizer["RrL_Title"]" heading-title="@Localizer["RrL_Hint"]" total="@Model.Count" />
        <pems-related-table>
            <pems-table-head>
                <pems-table-row>
                    <pems-table-header class="pems-w-200">@Localizer["MiL_Category"]</pems-table-header>
                    <pems-table-header class="pems-w-200">@Localizer["Target Module"]</pems-table-header>
                    <pems-table-header class="text-center pems-w-110">@Localizer["Auto Route"]</pems-table-header>
                    <pems-table-header>@Localizer["Ed_Description"]</pems-table-header>
                    <pems-table-header class="pems-w-50"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                </pems-table-row>
            </pems-table-head>
            <pems-table-body>
                @foreach (var r in Model)
                {
                    var formId = $"rule_{r.RoutingRuleId}";
                    <pems-table-row>
                        <pems-table-cell>
                            <span class="vs-cell-strong">@r.DocumentCategory</span>
                            <pems-related-row-form id="@formId" action="@Url.Action("SetRule")">
                                <input type="hidden" name="category" value="@r.DocumentCategory" />
                            </pems-related-row-form>
                        </pems-table-cell>
                        <pems-table-cell>
                            <pems-select scale="small" form="@formId" name="targetModule" aria-label="@Localizer["Target Module"]">
                                @foreach (var m in modules) { <option value="@m" selected="@(m == r.TargetModule)">@m</option> }
                            </pems-select>
                        </pems-table-cell>
                        <pems-table-cell class="text-center"><pems-input form="@formId" type="checkbox" name="allowAutoRouting" value="true" checked="@r.AllowAutoRouting" aria-label="@Localizer["Auto Route"]" kind="check" /></pems-table-cell>
                        <pems-table-cell><pems-input scale="small" form="@formId" name="description" value="@r.Description" aria-label="@Localizer["Ed_Description"]" /></pems-table-cell>
                        <pems-table-cell class="text-end"><pems-related-save form-id="@formId" label="@Localizer["Save"]" /></pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
        @if (Model.Count == 0) { <p class="lp-rel-empty">@Localizer["RrL_Empty"]</p> }
    </pems-list-panel>
</pems-list-page>
