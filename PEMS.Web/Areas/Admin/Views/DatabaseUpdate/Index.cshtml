@model PEMS.Application.DTOs.DatabaseUpdateStatusDto
@using Microsoft.Extensions.Localization
@using PEMS.Application.DTOs
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var (badge, label) = Model.State switch
    {
        DatabaseSetupState.UpToDate => ("bg-success", "Up to date"),
        DatabaseSetupState.UpdateAvailable => ("bg-warning text-dark", "Update available"),
        DatabaseSetupState.FirstRun => ("bg-info text-dark", "First run (install)"),
        DatabaseSetupState.UnmanagedSchema => ("bg-danger", "Unmanaged schema"),
        DatabaseSetupState.DatabaseNewerThanApplication => ("bg-danger", "Database newer than application"),
        _ => ("bg-danger", "Unreachable")
    };
    var applyText = Model.State == DatabaseSetupState.FirstRun ? "Install database" : "Apply updates";
}

<pems-page-shell kind="admin">
    <div class="admin-hero">
        <div><p>@Localizer["Database install and update: the schema is built and upgraded from code (migrations). Check the state, then apply."]</p></div>
    </div>

    @if (TempData["Message"] != null) { <pems-alert tone="success">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }

    <pems-content-card css="mb-3">
        <pems-flex align="center" gap="3" wrap="true">
            <pems-badge tone="none" css="fs-6 @badge">@Localizer[label]</pems-badge>
            <span>@Model.Summary</span>
        </pems-flex>
        <pems-row gap="3" css="mt-2">
            <pems-col md="3" span="6"><div class="fs-4 fw-bold">@Model.AppliedMigrationCount / @Model.KnownMigrationCount</div><div class="text-muted small">@Localizer["Migrations applied"]</div></pems-col>
            <pems-col md="4" span="12"><div class="small fw-bold">@(Model.LastAppliedMigration ?? "-")</div><div class="text-muted small">@Localizer["Last applied"]</div></pems-col>
            <pems-col md="5" span="12"><div class="small fw-bold">@(Model.LatestKnownMigration ?? "-")</div><div class="text-muted small">@Localizer["Latest in this application"]</div></pems-col>
        </pems-row>
    </pems-content-card>

    @if (Model.CanApply)
    {
        <pems-content-card css="mb-3">
            <h6>@Localizer["Pending migrations"] (@Model.PendingMigrations.Count)</h6>
            <ul class="small text-muted pems-s-4cd5c0a7">
                @foreach (var m in Model.PendingMigrations) { <li><code>@m</code></li> }
            </ul>
            <form asp-action="Apply" method="post"><pems-flex align="center" gap="3" wrap="true">
                @Html.AntiForgeryToken()
                @if (Model.BackupBeforeUpdate && Model.State == DatabaseSetupState.UpdateAvailable)
                {
                    @* SCRUM-280: the service takes the backup itself and refuses to update without it *@
                    <input type="hidden" name="backupConfirmed" value="true" />
                    <span class="small text-muted" data-auto-backup><pems-icon name="bi-shield-check" css="me-1" />@Localizer["A backup is taken automatically before the update; the update stops if it fails."]</span>
                }
                else
                {
                    <pems-check-row>
                        <pems-input kind="check" type="checkbox" name="backupConfirmed" value="true" id="backupConfirmed" />
                        <label class="form-check-label" for="backupConfirmed">@Localizer["A database backup has been taken"]</label>
                    </pems-check-row>
                }
                <pems-button tone="primary" type="submit"><pems-icon name="bi-database-up" css="me-1" /> @Localizer[applyText]</pems-button>
            </pems-flex></form>
        </pems-content-card>
    }

    <pems-content-card>
        <h6>@Localizer["Recent runs"]</h6>
        @if (!Model.RecentRuns.Any())
        {
            <div class="text-muted small">@Localizer["No runs recorded yet."]</div>
        }
        else
        {
            <pems-table-scroll>
                <pems-table kind="enterprise">
                    <thead><tr><th>@Localizer["Started (UTC)"]</th><th>@Localizer["Trigger"]</th><th>@Localizer["Mode"]</th><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["Applied"]</th><th>@Localizer["Seconds"]</th><th>@Localizer["Result"]</th><th>@Localizer["By"]</th><th>@Localizer["Backup file"]</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.RecentRuns)
                    {
                        <tr>
                            <td class="small">@r.StartedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@r.Trigger</td>
                            <td>@r.Mode</td>
                            <td class="small"><code>@(r.FromMigration ?? "-")</code></td>
                            <td class="small"><code>@(r.ToMigration ?? "-")</code></td>
                            <td>@r.MigrationsApplied</td>
                            <td>@r.DurationSeconds.ToString("0.0")</td>
                            <td>
                                @if (r.Succeeded) { <pems-badge tone="success">@Localizer["Succeeded"]</pems-badge> }
                                else { <pems-badge tone="danger" title="@r.Error">@Localizer["Failed"]</pems-badge> }
                            </td>
                            <td class="small">@(r.PerformedBy ?? "-")</td>
                            <td class="small"><code>@(r.BackupFile ?? "-")</code></td>
                        </tr>
                    }
                    </tbody>
                </pems-table>
            </pems-table-scroll>
        }
    </pems-content-card>
</pems-page-shell>
