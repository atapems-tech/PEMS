@model List<PEMS.Application.Organization.OrganizationPositionRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var employees = (List<(int EmployeeId, string Label)>)ViewBag.Employees;
    var byParent = Model.Where(r => r.ParentPositionId.HasValue).GroupBy(r => r.ParentPositionId!.Value).ToDictionary(g => g.Key, g => g.OrderBy(x => x.Title).ToList());
    var ids = Model.Select(r => r.PositionId).ToHashSet();
    // ریشه‌ها: بدون والد یا والدِ ناموجود
    var roots = Model.Where(r => !r.ParentPositionId.HasValue || !ids.Contains(r.ParentPositionId.Value)).OrderBy(r => r.Title).ToList();
    string Label(PEMS.Application.Organization.OrganizationPositionRow r) => string.IsNullOrWhiteSpace(r.PositionCode) ? r.Title : r.Title + " [" + r.PositionCode + "]";
}

<pems-page-shell kind="admin">
    <pems-page-hero>
        <p>@Localizer["Org_Intro"]</p>
        <p class="small text-muted mb-0">@Localizer["Org_Team_Not_Manager"]</p>
    </pems-page-hero>

    @if (TempData["Message"] != null) { <pems-alert tone="success">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }

    <pems-flex gap="2" wrap="true" css="mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Chart"><pems-icon name="bi-diagram-3" /> @Localizer["Org_Chart_Title"]</a>
        <a class="vs-btn vs-btn--sm" asp-action="Diagnostics"><pems-icon name="bi-heart-pulse" /> @Localizer["Org_Diag_Title"]</a>
        <a class="vs-btn vs-btn--sm" asp-area="Admin" asp-controller="OrganizationImport" asp-action="Index"><pems-icon name="bi-file-earmark-arrow-up" /> @Localizer["Org_Imp_Title"]</a>
    </pems-flex>

    <pems-nav css="mb-3" role="tablist">
        <li class="nav-item"><pems-button tone="bare" css="nav-link active" data-bs-toggle="tab" data-bs-target="#orgTabPositions" type="button" role="tab">@Localizer["Org_Tab_Positions"] <pems-badge tone="neutral">@Model.Count</pems-badge></pems-button></li>
        <li class="nav-item"><pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#orgTabTree" type="button" role="tab">@Localizer["Org_Tab_Tree"]</pems-button></li>
    </pems-nav>

    <pems-tab-content>
        <pems-tab-pane fade="true" active="true" id="orgTabPositions" role="tabpanel">
            <pems-table-scroll>
                <pems-table scale="small" css="table-enterprise align-middle">
                    <pems-table-head>
                        <pems-table-row>
                            <pems-table-header>@Localizer["Org_Col_Position"]</pems-table-header>
                            <pems-table-header>@Localizer["Org_Col_Department"]</pems-table-header>
                            <pems-table-header>@Localizer["Org_Col_Code"] / @Localizer["Org_Col_Parent"]</pems-table-header>
                            <pems-table-header>@Localizer["Org_Col_Holder"]</pems-table-header>
                            <pems-table-header></pems-table-header>
                        </pems-table-row>
                    </pems-table-head>
                    <pems-table-body>
                    @foreach (var r in Model)
                    {
                        <pems-table-row class="@(r.IsActive ? "" : "text-muted")">
                            <pems-table-cell>
                                <strong>@r.Title</strong>
                                @if (!r.IsActive) { <pems-badge tone="neutral">@Localizer["Org_Inactive"]</pems-badge> }
                                @if (r.IsActive && r.IsVacant) { <pems-badge tone="warning">@Localizer["Org_Vacant"]</pems-badge> }
                                @if (r.IssueCount > 0) { <a asp-action="Diagnostics" class="text-decoration-none"><pems-badge tone="danger">@r.IssueCount</pems-badge></a> }
                            </pems-table-cell>
                            <pems-table-cell class="small">@r.DepartmentName</pems-table-cell>
                            <pems-table-cell class="pems-s-bec7b1d5">
                                <pems-form asp-action="SetHierarchy" method="post"><pems-flex gap="1">
                                    <input type="hidden" name="positionId" value="@r.PositionId" />
                                    <pems-input class="pems-w-90" scale="small" name="positionCode" value="@r.PositionCode" maxlength="50" placeholder="@Localizer["Org_Col_Code"]" aria-label="@Localizer["Org_Col_Code"]" />
                                    <pems-select scale="small" name="parentPositionId" aria-label="@Localizer["Org_Col_Parent"]">
                                        <option value="">@Localizer["Org_NoParent_Root"]</option>
                                        @foreach (var p in Model.Where(p => p.PositionId != r.PositionId && p.IsActive))
                                        {
                                            <option value="@p.PositionId" selected="@(r.ParentPositionId == p.PositionId)">@Label(p)</option>
                                        }
                                    </pems-select>
                                    <pems-button tone="bare" css="vs-btn vs-btn--sm" title="@Localizer["Org_Btn_Save"]" aria-label="@Localizer["Org_Btn_Save"]"><pems-icon name="bi-save" /></pems-button>
                                </pems-flex></pems-form>
                            </pems-table-cell>
                            <pems-table-cell class="pems-s-de413461">
                                @if (r.AssignmentId.HasValue)
                                {
                                    <pems-form asp-action="UpdateAssignment" method="post"><pems-flex gap="1" align="center" wrap="true">
                                        <input type="hidden" name="assignmentId" value="@r.AssignmentId" />
                                        <span class="small me-1">@r.HolderName</span>
                                        <label class="small"><pems-input kind="bare" type="checkbox" name="isPrimary" value="true" checked="@r.HolderIsPrimary" /> @Localizer["Org_Primary"]</label>
                                        <input type="hidden" name="isPrimary" value="false" />
                                        <pems-date class="pems-w-130" name="startDate" value="@r.StartDate?.ToString("yyyy-MM-dd")" aria-label="@Localizer["Org_EffectiveFrom"]" required scale="small" />
                                        <pems-date class="pems-w-130" name="endDate" value="@r.EndDate?.ToString("yyyy-MM-dd")" aria-label="@Localizer["Org_EffectiveTo"]" scale="small" />
                                        <pems-button tone="bare" css="vs-btn vs-btn--sm" title="@Localizer["Org_Btn_Save"]" aria-label="@Localizer["Org_Btn_Save"]"><pems-icon name="bi-save" /></pems-button>
                                    </pems-flex></pems-form>
                                }
                                else if (r.IsActive)
                                {
                                    <pems-form asp-action="Assign" method="post"><pems-flex gap="1" align="center" wrap="true">
                                        <input type="hidden" name="positionId" value="@r.PositionId" />
                                        <pems-select class="pems-w-200" scale="small" name="employeeId" aria-label="@Localizer["Org_Col_Holder"]" required>
                                            <option value="">@Localizer["Org_SelectEmployee"]</option>
                                            @foreach (var e in employees) { <option value="@e.EmployeeId">@e.Label</option> }
                                        </pems-select>
                                        <label class="small"><pems-input kind="bare" type="checkbox" name="isPrimary" value="true"="true" /> @Localizer["Org_Primary"]</label>
                                        <input type="hidden" name="isPrimary" value="false" />
                                        <pems-date class="pems-w-130" name="startDate" scale="small" aria-label="@Localizer["Org_EffectiveFrom"]" />
                                        <pems-date class="pems-w-130" name="endDate" scale="small" aria-label="@Localizer["Org_EffectiveTo"]" />
                                        <pems-button tone="bare" css="vs-btn vs-btn--sm vs-btn--primary" title="@Localizer["Org_Btn_Assign"]" aria-label="@Localizer["Org_Btn_Assign"]"><pems-icon name="bi-person-plus" /></pems-button>
                                    </pems-flex></pems-form>
                                }
                            </pems-table-cell>
                            <pems-table-cell class="text-end">
                                @if (r.AssignmentId.HasValue)
                                {
                                    <pems-form asp-action="EndAssignment" method="post" class="d-inline" data-pems-confirm="@Localizer["Org_Confirm_End"]">
                                        <input type="hidden" name="assignmentId" value="@r.AssignmentId" />
                                        <pems-button tone="bare" css="vs-icon-btn" title="@Localizer["Org_Btn_End"]" aria-label="@Localizer["Org_Btn_End"]"><pems-icon name="bi-person-dash" /></pems-button>
                                    </pems-form>
                                }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                    </pems-table-body>
                </pems-table>
            </pems-table-scroll>
            @if (!Model.Any()) { <div class="vs-empty">@Localizer["Org_Empty"]</div> }
        </pems-tab-pane>

        <pems-tab-pane fade="true" id="orgTabTree" role="tabpanel">
            @{
                async Task RenderNode(PEMS.Application.Organization.OrganizationPositionRow n, int depth, HashSet<int> seen)
                {
                    if (!seen.Add(n.PositionId) || depth > 30) { return; }
                    @* SCRUM-337 TreeView: a keyboard-navigable tree, branches open and close, remembered per browser *@
                    <pems-tree-item label="@Label(n)" key="@n.PositionId.ToString()">
                        <pems-tree-label>
                            <span class="@(n.IsActive ? "" : "text-muted")">@Label(n)</span>
                            @if (n.IsVacant) { <pems-badge tone="warning">@Localizer["Org_Vacant"]</pems-badge> }
                            else { <span class="small text-muted"> — @n.HolderName</span> }
                        </pems-tree-label>
                        @if (byParent.TryGetValue(n.PositionId, out var kids))
                        {
                            @foreach (var k in kids) { await RenderNode(k, depth + 1, seen); }
                        }
                    </pems-tree-item>
                }
            }
            <pems-tree label="@Localizer["Org_Tab_Tree"]" toggle-label="@Localizer["Ct_ToggleBranch"]" remember-key="pems.admin.orgTreeCollapsed">
                @{ var seenNodes = new HashSet<int>(); }
                @foreach (var root in roots) { await RenderNode(root, 0, seenNodes); }
            </pems-tree>
            @if (!Model.Any()) { <div class="vs-empty">@Localizer["Org_Empty"]</div> }
        </pems-tab-pane>
    </pems-tab-content>
</pems-page-shell>
