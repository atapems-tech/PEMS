@model List<PEMS.Application.Organization.OrganizationPositionRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var departments = (List<(int DepartmentId, string Name)>)ViewBag.Departments;
    string status = (string?)ViewBag.Status ?? "";
}

<pems-page-shell kind="admin">
    <div class="admin-hero">
        <p>@Localizer["Org_Positions_Intro"]</p>
    </div>

    @if (TempData["Message"] != null) { <pems-alert tone="success">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }

    <pems-flex gap="2" wrap="true" css="mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><pems-icon name="bi-diagram-3" /> @Localizer["Org_Title"]</a>
        <a class="vs-btn vs-btn--sm" asp-action="Chart"><pems-icon name="bi-diagram-2" /> @Localizer["Org_Chart_Title"]</a>
        <a class="vs-btn vs-btn--sm" asp-controller="Discipline" asp-action="Manage" asp-area=""><pems-icon name="bi-sliders" /> @Localizer["Disc_Master_Nav"]</a>
    </pems-flex>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><pems-icon name="bi-plus-circle" /> @Localizer["Org_Positions_New"]</h2>
        <form asp-action="CreatePosition" method="post"><pems-row gap="2" css="align-items-end">
            <pems-col md="3"><pems-label for="npTitle">@Localizer["Org_Col_Position"]</pems-label><pems-input scale="small" id="npTitle" name="title" maxlength="150" required /></pems-col>
            <pems-col md="2"><pems-label for="npCode">@Localizer["Org_Col_Code"]</pems-label><pems-input scale="small" id="npCode" name="positionCode" maxlength="50" /></pems-col>
            <pems-col md="3">
                <pems-label for="npDept">@Localizer["Org_Col_Department"]</pems-label>
                <pems-select scale="small" id="npDept" name="departmentId">
                    <option value="">@Localizer["Org_NoDepartment"]</option>
                    @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3">
                <pems-label for="npParent">@Localizer["Org_Col_Parent"]</pems-label>
                <pems-select scale="small" id="npParent" name="parentPositionId">
                    <option value="">@Localizer["Org_NoParent_Root"]</option>
                    @foreach (var p in Model.Where(p => p.IsActive)) { <option value="@p.PositionId">@(string.IsNullOrWhiteSpace(p.PositionCode) ? p.Title : p.Title + " [" + p.PositionCode + "]")</option> }
                </pems-select>
            </pems-col>
            <pems-col md="1"><button class="vs-btn vs-btn--primary vs-btn--sm w-100" aria-label="@Localizer["Org_Positions_New"]"><pems-icon name="bi-plus-lg" /></button></pems-col>
            <pems-col span="12"><pems-input scale="small" name="description" maxlength="500" placeholder="@Localizer["Description"]" aria-label="@Localizer["Description"]" /></pems-col>
        </pems-row></form>
        <p class="small text-muted mt-2 mb-0">@Localizer["Org_Positions_Note"]</p>
    </section>

    <form class="mb-3" method="get"><pems-flex gap="2" wrap="true">
        <pems-input class="pems-maxw-260" scale="small" name="q" value="@ViewBag.Query" placeholder="@Localizer["Org_Positions_Search"]" aria-label="@Localizer["Org_Positions_Search"]" />
        <pems-select class="pems-maxw-180" scale="small" name="status" aria-label="@Localizer["Org_Filter_Status"]">
            <option value="" selected="@(status == "")">@Localizer["Org_Filter_All"]</option>
            <option value="active" selected="@(status == "active")">@Localizer["Org_Filter_Active"]</option>
            <option value="vacant" selected="@(status == "vacant")">@Localizer["Org_Vacant"]</option>
            <option value="inactive" selected="@(status == "inactive")">@Localizer["Org_Inactive"]</option>
        </pems-select>
        <button class="vs-btn vs-btn--sm"><pems-icon name="bi-funnel" /> @Localizer["Org_Filter_Apply"]</button>
    </pems-flex></form>

    <pems-table-scroll>
        <pems-table scale="small" css="table-enterprise align-middle">
            <thead><tr><th>@Localizer["Org_Col_Code"]</th><th>@Localizer["Org_Col_Position"]</th><th>@Localizer["Org_Col_Department"]</th><th>@Localizer["Org_Col_Parent"]</th><th>@Localizer["Org_Col_Holder"]</th><th>@Localizer["Org_Col_Lifecycle"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr class="@(r.IsActive ? "" : "text-muted")">
                    <td colspan="3" class="p-1">
                        <form asp-action="EditPosition" method="post"><pems-row gap="1" css="align-items-center">
                            <input type="hidden" name="positionId" value="@r.PositionId" />
                            <pems-col md="3"><pems-input scale="small" name="positionCode" value="@r.PositionCode" maxlength="50" aria-label="@Localizer["Org_Col_Code"]" /></pems-col>
                            <pems-col md="5"><pems-input scale="small" name="title" value="@r.Title" maxlength="150" required aria-label="@Localizer["Org_Col_Position"]" /></pems-col>
                            <pems-col md="3">
                                <pems-select scale="small" name="departmentId" aria-label="@Localizer["Org_Col_Department"]">
                                    <option value="">@Localizer["Org_NoDepartment"]</option>
                                    @foreach (var d in departments) { <option value="@d.DepartmentId" selected="@(r.DepartmentId == d.DepartmentId)">@d.Name</option> }
                                    @if (r.DepartmentId.HasValue && !departments.Any(d => d.DepartmentId == r.DepartmentId)) { <option value="@r.DepartmentId" selected>@r.DepartmentName (@Localizer["Org_Inactive"])</option> }
                                </pems-select>
                            </pems-col>
                            <input type="hidden" name="description" value="@r.Description" />
                            <pems-col md="1"><button class="vs-btn vs-btn--sm" title="@Localizer["Org_Btn_Save"]" aria-label="@Localizer["Org_Btn_Save"]"><pems-icon name="bi-save" /></button></pems-col>
                        </pems-row></form>
                    </td>
                    <td class="small">@(r.ParentLabel ?? "—")</td>
                    <td class="small">@(r.IsVacant ? "—" : r.HolderName)</td>
                    <td><pems-badge tone="none" css="@(r.Lifecycle == "OCCUPIED" ? "bg-success" : r.Lifecycle == "VACANT" ? "bg-warning text-dark" : "bg-secondary")">@r.Lifecycle</pems-badge></td>
                    <td class="text-end">
                        <form asp-action="SetPositionActive" method="post" class="d-inline">
                            <input type="hidden" name="positionId" value="@r.PositionId" /><input type="hidden" name="isActive" value="@((!r.IsActive).ToString().ToLowerInvariant())" />
                            <pems-button tone="none" size="small" css="@(r.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(r.IsActive ? Localizer["Deactivate"] : Localizer["Reactivate"])</pems-button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </pems-table>
        @if (!Model.Any()) { <div class="vs-empty">@Localizer["Org_Empty"]</div> }
    </pems-table-scroll>
</pems-page-shell>
