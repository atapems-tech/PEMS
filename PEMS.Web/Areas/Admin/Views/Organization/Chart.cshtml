@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@section Styles {
    <link rel="stylesheet" href="~/css/pems-org-position-chart.css" asp-append-version="true" />
}

<div class="admin-page-shell" id="pemsOpcRoot"
     data-url="@Url.Action("ChartData", "Organization", new { area = "Admin" })"
     data-manage-url="@Url.Action("Index", "Organization", new { area = "Admin" })"
     data-t-container="@Localizer["Org_Chart_Container"]" data-t-vacant="@Localizer["Org_Vacant"]" data-t-position="@Localizer["Org_Col_Position"]"
     data-t-employee="@Localizer["Org_Col_Holder"]" data-t-secondary="@Localizer["Org_Chart_Secondary"]" data-t-assignment="@Localizer["Org_Chart_Assignment"]"
     data-t-unit="@Localizer["Org_Col_Department"]" data-t-team="@Localizer["Org_Chart_Team"]" data-t-parent="@Localizer["Org_Col_Parent"]"
     data-t-reports="@Localizer["Org_Chart_Reports"]" data-t-issues="@Localizer["Org_Diag_Issues"]" data-t-manage="@Localizer["Org_Chart_Manage"]"
     data-t-validRoot="@Localizer["Org_Chart_ValidRoot"]" data-t-orphan="@Localizer["Org_Chart_Orphan"]" data-t-cycle="@Localizer["Org_Chart_Cycle"]" data-t-issue="@Localizer["Org_Chart_Issue"]"
     data-t-select="@Localizer["Org_Chart_Select"]" data-t-empty="@Localizer["Org_Empty"]" data-t-loading="@Localizer["Org_Chart_Loading"]" data-t-error="@Localizer["Org_Chart_Error"]">

    <div class="admin-hero"><p>@Localizer["Org_Chart_Intro"]</p></div>

    <div class="pems-opc-toolbar">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><i class="bi bi-arrow-left"></i> @Localizer["Org_Title"]</a>
        <button type="button" class="vs-btn vs-btn--sm" id="pemsOpcFit" title="@Localizer["Org_Chart_Fit"]" aria-label="@Localizer["Org_Chart_Fit"]"><i class="bi bi-fullscreen"></i></button>
        <button type="button" class="vs-btn vs-btn--sm" id="pemsOpcZoomIn" title="@Localizer["Org_Chart_ZoomIn"]" aria-label="@Localizer["Org_Chart_ZoomIn"]"><i class="bi bi-zoom-in"></i></button>
        <button type="button" class="vs-btn vs-btn--sm" id="pemsOpcZoomOut" title="@Localizer["Org_Chart_ZoomOut"]" aria-label="@Localizer["Org_Chart_ZoomOut"]"><i class="bi bi-zoom-out"></i></button>
        <button type="button" class="vs-btn vs-btn--sm" id="pemsOpcExpand"><i class="bi bi-arrows-expand"></i> @Localizer["Org_Chart_ExpandAll"]</button>
        <button type="button" class="vs-btn vs-btn--sm" id="pemsOpcCollapse"><i class="bi bi-arrows-collapse"></i> @Localizer["Org_Chart_CollapseAll"]</button>
        <input type="search" id="pemsOpcSearch" class="form-control form-control-sm" placeholder="@Localizer["Org_Chart_Search"]" aria-label="@Localizer["Org_Chart_Search"]" />
    </div>
    <div class="alert alert-warning small py-1" id="pemsOpcWarnings" role="status" hidden></div>

    <div class="pems-opc-layout">
        <div class="pems-opc-card">
            <div class="pems-opc-state" id="pemsOpcState" role="status"></div>
            <div class="pems-opc-canvas" id="pemsOpcCanvas" hidden></div>
        </div>
        <aside class="pems-opc-panel" id="pemsOpcPanel" aria-live="polite"><p class="text-muted small mb-0">@Localizer["Org_Chart_Select"]</p></aside>
    </div>
</div>

@section Scripts {
    <script src="~/lib/d3-org-chart/d3.min.js"></script>
    <script src="~/lib/d3-org-chart/d3-flextree.min.js"></script>
    <script src="~/lib/d3-org-chart/d3-org-chart.min.js"></script>
    <script src="~/js/pems-org-position-chart.js" asp-append-version="true"></script>
}
