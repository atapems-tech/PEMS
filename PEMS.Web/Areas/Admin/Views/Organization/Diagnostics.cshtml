@model IReadOnlyList<PEMS.Application.Organization.OrganizationIssue>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var blocked = (List<PEMS.Application.Organization.OrganizationBlockedRequest>)ViewBag.Blocked;
    var rd = (PEMS.Application.Organization.OrganizationReadiness)ViewBag.Readiness;
    var dc = (IReadOnlyList<PEMS.Application.Organization.EmployeeDepartmentConsistencyRow>)ViewBag.DeptConsistency;
    var lp = (IReadOnlyList<PEMS.Application.Organization.LegacyPositionRow>)ViewBag.LegacyPositions;
    string Sev(string s) => s switch { "P1" => "bg-danger", "P2" => "bg-warning text-dark", _ => "bg-secondary" };
}

<div class="admin-page-shell">
    <div class="admin-hero">
        <p>@Localizer["Org_Diag_Intro"]</p>
    </div>
    <div class="d-flex gap-2 mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><i class="bi bi-arrow-left"></i> @Localizer["Org_Title"]</a>
    </div>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><i class="bi bi-clipboard-data"></i> @Localizer["Org_Ready_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Ready_Note"]</p>
        <dl class="row mb-0 small">
            <dt class="col-sm-5">@Localizer["Org_Ready_ActivePositions"]</dt><dd class="col-sm-7">@rd.ActivePositions</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_WithParent"]</dt><dd class="col-sm-7">@rd.PositionsWithParent</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_Roots"]</dt><dd class="col-sm-7">@rd.RootPositions</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_Vacant"]</dt><dd class="col-sm-7">@rd.VacantPositions</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_NoDept"]</dt><dd class="col-sm-7">@rd.ActivePositionsWithoutDepartment</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_ActiveEmployees"]</dt><dd class="col-sm-7">@rd.ActiveEmployees</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_WithPrimary"]</dt><dd class="col-sm-7">@rd.ActiveEmployeesWithPrimaryPosition</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_NoPersonnelCode"]</dt><dd class="col-sm-7">@rd.ActiveEmployeesWithoutPersonnelCode</dd>
            <dt class="col-sm-5">@Localizer["Org_Ready_UsersNoPrimary"]</dt><dd class="col-sm-7">@rd.ActiveUsersWithoutPrimaryPosition</dd>
        </dl>
    </section>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><i class="bi bi-intersect"></i> @Localizer["Org_Cons_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Cons_Note"]</p>
        <p class="small mb-1">
            @foreach (var g in dc.GroupBy(r => r.Status).OrderBy(g => g.Key)) { <span class="badge bg-secondary me-1">@g.Key: @g.Count()</span> }
            @if (!dc.Any()) { <span class="text-muted">@Localizer["Org_Cons_None"]</span> }
        </p>
        @if (dc.Any(r => r.Status != "CONSISTENT"))
        {
            <div class="table-responsive"><table class="table table-sm table-enterprise">
                <thead><tr><th>@Localizer["Org_Col_Holder"]</th><th>@Localizer["Org_Cons_EmpDept"]</th><th>@Localizer["Org_Col_Position"]</th><th>@Localizer["Org_Cons_PosDept"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in dc.Where(r => r.Status != "CONSISTENT").Take(50))
                {
                    <tr><td>@r.EmployeeName</td><td>@(r.EmployeeDepartment ?? "—")</td><td>@r.PrimaryPositionTitle</td><td>@(r.PositionDepartment ?? "—")</td><td><code>@r.Status</code></td></tr>
                }
                </tbody></table></div>
        }
        <h3 class="h6 mt-3">@Localizer["Org_Cons_Legacy"]</h3>
        <p class="small mb-1">
            @foreach (var g in lp.GroupBy(r => r.Status).OrderBy(g => g.Key)) { <span class="badge bg-secondary me-1">@g.Key: @g.Count()</span> }
            @if (!lp.Any()) { <span class="text-muted">NO_CONFLICT (@Localizer["Org_Cons_LegacyNone"])</span> }
        </p>
    </section>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><i class="bi bi-hourglass-split"></i> @Localizer["Org_Diag_Blocked"] <span class="badge bg-secondary">@blocked.Count</span></h2>
        @if (blocked.Count == 0) { <div class="vs-empty py-2">@Localizer["Org_Diag_NoBlocked"]</div> }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-enterprise">
                    <thead><tr><th>@Localizer["Org_Diag_Request"]</th><th>@Localizer["Org_Diag_Requester"]</th><th>@Localizer["Org_Diag_Reason"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var b in blocked)
                    {
                        <tr>
                            <td>@b.Module · @b.RequestNumber</td>
                            <td>@b.RequesterName</td>
                            <td><code>@b.Reason</code> <span class="small text-muted">@(b.Reason == null ? "" : Localizer["Org_Issue_" + b.Reason].Value)</span></td>
                            <td class="text-end"><a class="vs-btn vs-btn--sm" asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Details" asp-route-id="@b.RequestId">@Localizer["Org_Diag_Open"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="vs-panel">
        <h2 class="vs-section__title"><i class="bi bi-heart-pulse"></i> @Localizer["Org_Diag_Issues"] <span class="badge bg-secondary">@Model.Count</span></h2>
        @if (Model.Count == 0) { <div class="vs-empty py-2">@Localizer["Org_Diag_NoIssues"]</div> }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-enterprise">
                    <thead><tr><th></th><th>@Localizer["Org_Diag_Code"]</th><th>@Localizer["Org_Diag_Subject"]</th><th>@Localizer["Org_Diag_Message"]</th></tr></thead>
                    <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td><span class="badge @Sev(i.Severity)">@i.Severity</span></td>
                            <td><code>@i.Code</code></td>
                            <td>@i.Subject</td>
                            <td class="small">@i.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
