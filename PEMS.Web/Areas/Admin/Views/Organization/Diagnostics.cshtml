@model IReadOnlyList<PEMS.Application.Organization.OrganizationIssue>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var blocked = (List<PEMS.Application.Organization.OrganizationBlockedRequest>)ViewBag.Blocked;
    var rd = (PEMS.Application.Organization.OrganizationReadiness)ViewBag.Readiness;
    var dc = (IReadOnlyList<PEMS.Application.Organization.EmployeeDepartmentConsistencyRow>)ViewBag.DeptConsistency;
    var lp = (IReadOnlyList<PEMS.Application.Organization.LegacyPositionRow>)ViewBag.LegacyPositions;
    string Sev(string s) => s switch { "P1" => "bg-danger", "P2" => "bg-warning text-dark", _ => "bg-secondary" };
}

<pems-page-shell kind="admin">
    <pems-page-hero>
        <p>@Localizer["Org_Diag_Intro"]</p>
    </pems-page-hero>
    <pems-flex gap="2" css="mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Org_Title"]</a>
    </pems-flex>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><pems-icon name="bi-clipboard-data" /> @Localizer["Org_Ready_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Ready_Note"]</p>
        <pems-info-grid layout="rows" class="mb-0 small">
    <pems-info-item label="@Localizer["Org_Ready_ActivePositions"]">@rd.ActivePositions</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_WithParent"]">@rd.PositionsWithParent</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_Roots"]">@rd.RootPositions</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_Vacant"]">@rd.VacantPositions</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_NoDept"]">@rd.ActivePositionsWithoutDepartment</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_ActiveEmployees"]">@rd.ActiveEmployees</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_WithPrimary"]">@rd.ActiveEmployeesWithPrimaryPosition</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_NoPersonnelCode"]">@rd.ActiveEmployeesWithoutPersonnelCode</pems-info-item>
    <pems-info-item label="@Localizer["Org_Ready_UsersNoPrimary"]">@rd.ActiveUsersWithoutPrimaryPosition</pems-info-item>
</pems-info-grid>
    </section>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><pems-icon name="bi-intersect" /> @Localizer["Org_Cons_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Cons_Note"]</p>
        <p class="small mb-1">
            @foreach (var g in dc.GroupBy(r => r.Status).OrderBy(g => g.Key)) { <pems-badge tone="neutral" css="me-1">@g.Key: @g.Count()</pems-badge> }
            @if (!dc.Any()) { <span class="text-muted">@Localizer["Org_Cons_None"]</span> }
        </p>
        @if (dc.Any(r => r.Status != "CONSISTENT"))
        {
            <pems-table-scroll><pems-data-table data="@(DataRows.Of(dc.Where(r => r.Status != "CONSISTENT").Take(50), c_ => c_.Add(((Localizer["Org_Col_Holder"])?.ToString() ?? ""), r => (object?)(r.EmployeeName)).Add(((Localizer["Org_Cons_EmpDept"])?.ToString() ?? ""), r => (object?)(r.EmployeeDepartment ?? "—")).Add(((Localizer["Org_Col_Position"])?.ToString() ?? ""), r => (object?)(r.PrimaryPositionTitle)).Add(((Localizer["Org_Cons_PosDept"])?.ToString() ?? ""), r => (object?)(r.PositionDepartment ?? "—")).Add("", r => (object?)(r.Status), kind: DataCellKind.Code)))" enterprise="false" dense="true" css="table-enterprise" /></pems-table-scroll>
        }
        <h3 class="h6 mt-3">@Localizer["Org_Cons_Legacy"]</h3>
        <p class="small mb-1">
            @foreach (var g in lp.GroupBy(r => r.Status).OrderBy(g => g.Key)) { <pems-badge tone="neutral" css="me-1">@g.Key: @g.Count()</pems-badge> }
            @if (!lp.Any()) { <span class="text-muted">NO_CONFLICT (@Localizer["Org_Cons_LegacyNone"])</span> }
        </p>
    </section>

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><pems-icon name="bi-hourglass-split" /> @Localizer["Org_Diag_Blocked"] <pems-badge tone="neutral">@blocked.Count</pems-badge></h2>
        @if (blocked.Count == 0) { <div class="vs-empty py-2">@Localizer["Org_Diag_NoBlocked"]</div> }
        else
        {
            <pems-table-scroll>
                <pems-table scale="small" css="table-enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>@Localizer["Org_Diag_Request"]</pems-table-header><pems-table-header>@Localizer["Org_Diag_Requester"]</pems-table-header><pems-table-header>@Localizer["Org_Diag_Reason"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                    @foreach (var b in blocked)
                    {
                        <pems-table-row>
                            <pems-table-cell>@b.Module · @b.RequestNumber</pems-table-cell>
                            <pems-table-cell>@b.RequesterName</pems-table-cell>
                            <pems-table-cell><code>@b.Reason</code> <span class="small text-muted">@(b.Reason == null ? "" : Localizer["Org_Issue_" + b.Reason].Value)</span></pems-table-cell>
                            <pems-table-cell class="text-end"><a class="vs-btn vs-btn--sm" asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Details" asp-route-id="@b.RequestId">@Localizer["Org_Diag_Open"]</a></pems-table-cell>
                        </pems-table-row>
                    }
                    </pems-table-body>
                </pems-table>
            </pems-table-scroll>
        }
    </section>

    <section class="vs-panel">
        <h2 class="vs-section__title"><pems-icon name="bi-heart-pulse" /> @Localizer["Org_Diag_Issues"] <pems-badge tone="neutral">@Model.Count</pems-badge></h2>
        @if (Model.Count == 0) { <div class="vs-empty py-2">@Localizer["Org_Diag_NoIssues"]</div> }
        else
        {
            <pems-table-scroll>
                <pems-table scale="small" css="table-enterprise">
                    <pems-table-head><pems-table-row><pems-table-header></pems-table-header><pems-table-header>@Localizer["Org_Diag_Code"]</pems-table-header><pems-table-header>@Localizer["Org_Diag_Subject"]</pems-table-header><pems-table-header>@Localizer["Org_Diag_Message"]</pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                    @foreach (var i in Model)
                    {
                        <pems-table-row>
                            <pems-table-cell><pems-badge tone="none" css="@Sev(i.Severity)">@i.Severity</pems-badge></pems-table-cell>
                            <pems-table-cell><code>@i.Code</code></pems-table-cell>
                            <pems-table-cell>@i.Subject</pems-table-cell>
                            <pems-table-cell class="small">@i.Message</pems-table-cell>
                        </pems-table-row>
                    }
                    </pems-table-body>
                </pems-table>
            </pems-table-scroll>
        }
    </section>
</pems-page-shell>
