@model List<PEMS.Web.Areas.Admin.Models.SoDPolicyListItemVm>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="admin-page-shell">
    <div class="admin-hero">
        <div class="d-flex align-items-center gap-3">
            <div><p>@Localizer["A user who does the first action on a record cannot also do the second on the same record."]</p></div>
        </div>
        <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-plus-lg me-1"></i> @Localizer["New Policy"]</a>
    </div>
    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-enterprise">
                <thead><tr><th>@Localizer["Cannot follow"]</th><th></th><th>@Localizer["With"]</th><th>@Localizer["Why"]</th><th>@Localizer["Status"]</th><th class="text-end">@Localizer["Actions"]</th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><code>@p.PermissionA</code></td>
                        <td class="text-body-secondary"><i class="bi bi-arrow-right"></i></td>
                        <td><code>@p.PermissionB</code></td>
                        <td>@p.Description</td>
                        <td>@if(p.IsActive){<span class="admin-status active"><i class="bi bi-check2-circle"></i> @Localizer["Active"]</span>}else{<span class="admin-status inactive"><i class="bi bi-pause-circle"></i> @Localizer["Disabled"]</span>}</td>
                        <td class="text-end">
                            <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? Localizer["Disable"] : Localizer["Enable"])</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.Count == 0){<div class="admin-empty"><i class="bi bi-shuffle"></i><strong>@Localizer["No SoD policies configured"]</strong></div>}
        </div>
    </div>
</div>
