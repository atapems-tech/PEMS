@model List<PEMS.Web.Areas.Admin.Models.SoDPolicyListItemVm>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component; the rule text is the tool tip of the title. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SodL_Title"]" heading-title="@Localizer["A user who does the first action on a record cannot also do the second on the same record."]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["SodL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No SoD policies configured"]">
                <thead>
                    <tr>
                        <th style="width:240px">@Localizer["Cannot follow"]</th>
                        <th style="width:40px"><span class="visually-hidden">→</span></th>
                        <th style="width:240px">@Localizer["With"]</th>
                        <th>@Localizer["Why"]</th>
                        <th style="width:120px">@Localizer["Ed_Status"]</th>
                        <th style="width:110px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr class="lp-row">
                        <td><code>@p.PermissionA</code></td>
                        <td class="text-body-secondary"><i class="bi bi-arrow-right" aria-hidden="true"></i></td>
                        <td><code>@p.PermissionB</code></td>
                        <td class="small"><span class="vs-title-cell" title="@p.Description">@p.Description</span></td>
                        <td>
                            @if (p.IsActive) { <span class="vs-pill vs-pill--icon vs-pill--success"><i class="bi bi-check2-circle" aria-hidden="true"></i> @Localizer["UsL_Active"]</span> }
                            else { <span class="vs-pill vs-pill--icon vs-pill--neutral"><i class="bi bi-pause-circle" aria-hidden="true"></i> @Localizer["Disabled"]</span> }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                <button type="submit" class="lp-act lp-act--always" title="@(p.IsActive ? Localizer["Disable"] : Localizer["Enable"])" aria-label="@(p.IsActive ? Localizer["Disable"] : Localizer["Enable"])"><i class="bi @(p.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
