@model List<PEMS.Web.Areas.Admin.Models.SoDPolicyListItemVm>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W4b: built from the PEMS.UI list-page component; the rule text is the tool tip of the title. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SodL_Title"]" heading-title="@Localizer["A user who does the first action on a record cannot also do the second on the same record."]" total="@Model.Count">
            <pems-list-tools>
                <pems-list-new href="@Url.Action("Create")" text="@Localizer["SodL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-grid>
            <pems-list-table empty="@(Model.Count == 0)" empty-text="@Localizer["No SoD policies configured"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-240">@Localizer["Cannot follow"]</pems-table-header>
                        <pems-table-header class="pems-w-40"><span class="visually-hidden">→</span></pems-table-header>
                        <pems-table-header class="pems-w-240">@Localizer["With"]</pems-table-header>
                        <pems-table-header>@Localizer["Why"]</pems-table-header>
                        <pems-table-header class="pems-w-120">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-110"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                @foreach (var p in Model)
                {
                    <pems-table-row class="lp-row">
                        <pems-table-cell><code>@p.PermissionA</code></pems-table-cell>
                        <pems-table-cell class="text-body-secondary"><pems-icon name="bi-arrow-right" aria-hidden="true" /></pems-table-cell>
                        <pems-table-cell><code>@p.PermissionB</code></pems-table-cell>
                        <pems-table-cell class="small"><span class="vs-title-cell" title="@p.Description">@p.Description</span></pems-table-cell>
                        <pems-table-cell>
                            @if (p.IsActive) { <span class="vs-pill vs-pill--icon vs-pill--success"><pems-icon name="bi-check2-circle" aria-hidden="true" /> @Localizer["UsL_Active"]</span> }
                            else { <span class="vs-pill vs-pill--icon vs-pill--neutral"><pems-icon name="bi-pause-circle" aria-hidden="true" /> @Localizer["Disabled"]</span> }
                        </pems-table-cell>
                        <pems-table-cell class="text-end">
                            <pems-form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                <button type="submit" class="lp-act lp-act--always" title="@(p.IsActive ? Localizer["Disable"] : Localizer["Enable"])" aria-label="@(p.IsActive ? Localizer["Disable"] : Localizer["Enable"])"><pems-icon css="@(p.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true" /></button>
                            </pems-form>
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
