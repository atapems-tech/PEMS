@model PEMS.Web.Areas.Admin.Models.SoDPolicyFormVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="content-card" style="max-width:560px;">
    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <pems-label>@Localizer["First permission"]</pems-label>
            <pems-select asp-for="PermissionAId">
                <option value="">@Localizer["— select —"]</option>
                @foreach (var p in Model.AllPermissions)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PermissionAId)">@p.Name</option>
                }
            </pems-select>
            <span asp-validation-for="PermissionAId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Conflicts with"]</pems-label>
            <pems-select asp-for="PermissionBId">
                <option value="">@Localizer["— select —"]</option>
                @foreach (var p in Model.AllPermissions)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PermissionBId)">@p.Name</option>
                }
            </pems-select>
            <span asp-validation-for="PermissionBId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <pems-label>@Localizer["Why"]</pems-label>
            <pems-textarea asp-for="Description" rows="2"></pems-textarea>
        </div>

        <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
        <pems-button as="a" tone="neutral" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
