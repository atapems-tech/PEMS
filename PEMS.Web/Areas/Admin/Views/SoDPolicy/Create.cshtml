@model PEMS.Web.Areas.Admin.Models.SoDPolicyFormVm
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ }

<div class="content-card" style="max-width:560px;">
    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">@Localizer["First permission"]</label>
            <select asp-for="PermissionAId" class="form-select">
                <option value="">@Localizer["— select —"]</option>
                @foreach (var p in Model.AllPermissions)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PermissionAId)">@p.Name</option>
                }
            </select>
            <span asp-validation-for="PermissionAId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Conflicts with"]</label>
            <select asp-for="PermissionBId" class="form-select">
                <option value="">@Localizer["— select —"]</option>
                @foreach (var p in Model.AllPermissions)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.PermissionBId)">@p.Name</option>
                }
            </select>
            <span asp-validation-for="PermissionBId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Why"]</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
