@model List<PEMS.Application.DTOs.WorkflowBindingRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-page-shell kind="admin">
    <pems-content-card>
        <pems-flex justify="between" align="center" css="mb-2">
            <span class="small text-muted">@Localizer["Explicit bindings resolve which published version new workflow instances use."]</span>
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Workflow Management"]</pems-button>
        </pems-flex>
        <pems-table-scroll>
            <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["Module"])?.ToString() ?? ""), b => (object?)(b.Module)).Add(((Localizer["Process type"])?.ToString() ?? ""), b => (object?)(b.EntityType)).Add(((Localizer["Context"])?.ToString() ?? ""), b => (object?)(b.Context)).Add(((Localizer["Workflow"])?.ToString() ?? ""), b => (object?)(b.DefinitionName)).Add(((Localizer["Bound version"])?.ToString() ?? ""), b => (object?)((b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"].Value))).Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("none", Localizer[b.IsActive ? "Active" : "Inactive"], (b.IsActive ? "bg-success" : "bg-secondary")))).Add(((Localizer["Access"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("none", Localizer[b.Editable ? "Editable" : "View Only"], (b.Editable ? "bg-primary" : "bg-secondary")))).Add("", b => (object?)(DataCell.ButtonLink(Url.Action("Details", null, new { id = b.DefinitionId }), "primary", "small", true, null, Localizer["Open"])), css: "text-end")))" css="align-middle" />
        </pems-table-scroll>
    </pems-content-card>
</pems-page-shell>
