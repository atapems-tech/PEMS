@model List<PEMS.Application.DTOs.WorkflowBindingRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="admin-page-shell">
    <div class="content-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-muted">@Localizer["Explicit bindings resolve which published version new workflow instances use."]</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> @Localizer["Workflow Management"]</a>
        </div>
        <div class="table-responsive">
            <table class="table table-enterprise align-middle">
                <thead><tr><th>@Localizer["Module"]</th><th>@Localizer["Process type"]</th><th>@Localizer["Context"]</th><th>@Localizer["Workflow"]</th><th>@Localizer["Bound version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Access"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Module</td><td>@b.EntityType</td><td>@b.Context</td><td>@b.DefinitionName</td>
                        <td>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"].Value)</td>
                        <td><span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">@Localizer[b.IsActive ? "Active" : "Inactive"]</span></td>
                        <td><span class="badge @(b.Editable ? "bg-primary" : "bg-secondary")">@Localizer[b.Editable ? "Editable" : "View Only"]</span></td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@b.DefinitionId" class="btn btn-sm btn-outline-primary">@Localizer["Open"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
