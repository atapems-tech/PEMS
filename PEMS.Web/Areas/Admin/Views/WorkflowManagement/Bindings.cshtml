@model List<PEMS.Application.DTOs.WorkflowBindingRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-page-shell kind="admin">
    <pems-content-card>
        <pems-flex justify="between" align="center" css="mb-2">
            <span class="small text-muted">@Localizer["Explicit bindings resolve which published version new workflow instances use."]</span>
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Workflow Management"]</pems-button>
        </pems-flex>
        <pems-table-scroll>
            <pems-table kind="enterprise" css="align-middle">
                <thead><tr><th>@Localizer["Module"]</th><th>@Localizer["Process type"]</th><th>@Localizer["Context"]</th><th>@Localizer["Workflow"]</th><th>@Localizer["Bound version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Access"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Module</td><td>@b.EntityType</td><td>@b.Context</td><td>@b.DefinitionName</td>
                        <td>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"].Value)</td>
                        <td><pems-badge tone="none" css="@(b.IsActive ? "bg-success" : "bg-secondary")">@Localizer[b.IsActive ? "Active" : "Inactive"]</pems-badge></td>
                        <td><pems-badge tone="none" css="@(b.Editable ? "bg-primary" : "bg-secondary")">@Localizer[b.Editable ? "Editable" : "View Only"]</pems-badge></td>
                        <td class="text-end"><pems-button as="a" tone="primary" size="small" outline="true" asp-action="Details" asp-route-id="@b.DefinitionId">@Localizer["Open"]</pems-button></td>
                    </tr>
                }
                </tbody>
            </pems-table>
        </pems-table-scroll>
    </pems-content-card>
</pems-page-shell>
