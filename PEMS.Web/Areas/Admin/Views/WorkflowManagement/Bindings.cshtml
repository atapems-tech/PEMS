@model List<PEMS.Application.DTOs.WorkflowBindingRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-page-shell kind="admin">
    <pems-content-card>
        <pems-flex justify="between" align="center" css="mb-2">
            <span class="small text-muted">@Localizer["Explicit bindings resolve which published version new workflow instances use."]</span>
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Workflow Management"]</pems-button>
        </pems-flex>
        <pems-table-scroll>
            <pems-table kind="enterprise" css="align-middle">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Module"]</pems-table-header><pems-table-header>@Localizer["Process type"]</pems-table-header><pems-table-header>@Localizer["Context"]</pems-table-header><pems-table-header>@Localizer["Workflow"]</pems-table-header><pems-table-header>@Localizer["Bound version"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Access"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                @foreach (var b in Model)
                {
                    <pems-table-row>
                        <pems-table-cell>@b.Module</pems-table-cell><pems-table-cell>@b.EntityType</pems-table-cell><pems-table-cell>@b.Context</pems-table-cell><pems-table-cell>@b.DefinitionName</pems-table-cell>
                        <pems-table-cell>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"].Value)</pems-table-cell>
                        <pems-table-cell><pems-badge tone="none" css="@(b.IsActive ? "bg-success" : "bg-secondary")">@Localizer[b.IsActive ? "Active" : "Inactive"]</pems-badge></pems-table-cell>
                        <pems-table-cell><pems-badge tone="none" css="@(b.Editable ? "bg-primary" : "bg-secondary")">@Localizer[b.Editable ? "Editable" : "View Only"]</pems-badge></pems-table-cell>
                        <pems-table-cell class="text-end"><pems-button as="a" tone="primary" size="small" outline="true" asp-action="Details" asp-route-id="@b.DefinitionId">@Localizer["Open"]</pems-button></pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-table>
        </pems-table-scroll>
    </pems-content-card>
</pems-page-shell>
