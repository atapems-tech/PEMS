@model PEMS.Application.DTOs.WorkflowBindingImpact
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var targetId = (int)ViewBag.TargetVersionId;
}
<div class="admin-page-shell">
    <div class="content-card">
        <h6>@Model.Definition</h6>
        <pems-table scale="small" css="w-auto">
            <tr><th>@Localizer["Current version"]</th><td>@(Model.CurrentVersion.HasValue ? "v" + Model.CurrentVersion : "—")</td></tr>
            <tr><th>@Localizer["Target version"]</th><td><strong>v@(Model.TargetVersion)</strong></td></tr>
            <tr><th>@Localizer["Running instances (unchanged)"]</th><td>@Model.RunningInstances @if (Model.RunningByVersion.Count > 0) { <span class="text-muted small">(@string.Join(", ", Model.RunningByVersion.Select(u => u.Running + " × v" + u.VersionNumber)))</span> }</td></tr>
        </pems-table>
        <pems-alert tone="info" css="small"><i class="bi bi-pin-angle"></i> @Localizer["Only new instances will use the target version. Existing running instances stay pinned to the version they started with; nothing is rewritten. The change is audited."]</pems-alert>
        <form asp-action="ChangeBinding" method="post" class="d-flex flex-column gap-2">
            <input type="hidden" name="bindingId" value="@Model.BindingId" /><input type="hidden" name="targetVersionId" value="@targetId" /><input type="hidden" name="definitionId" value="@Model.DefinitionId" />
            <div class="form-check"><pems-input kind="check" type="checkbox" name="confirmed" value="true" id="cfm" /><input type="hidden" name="confirmed" value="false" /><label class="form-check-label" for="cfm">@Localizer["I understand and confirm the binding change."]</label></div>
            <div><pems-button tone="primary" size="small">@Localizer["Change binding"]</pems-button> <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index">@Localizer["Cancel"]</pems-button></div>
        </form>
    </div>
</div>
