@model List<PEMS.Application.DTOs.WorkflowDefinitionRow>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
<div class="admin-page-shell">
    <div class="content-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <span class="text-body-secondary small"><strong>@Model.Count</strong> @Localizer["workflow definitions"] · @Localizer["Editable"]: <strong>@Model.Count(x => x.Editable)</strong> · @Localizer["View Only"]: <strong>@Model.Count(x => !x.Editable)</strong></span>
            <a asp-action="Bindings" class="btn btn-sm btn-outline-secondary"><i class="bi bi-link-45deg"></i> @Localizer["Bindings"]</a>
        </div>
        <div class="table-responsive">
            <table class="table table-enterprise align-middle" id="wfDefinitions">
                <thead>
                    <tr>
                        <th>@Localizer["Workflow"]</th><th>@Localizer["Module"] / @Localizer["Process type"]</th><th>@Localizer["Published version"]</th><th>@Localizer["Open draft"]</th>
                        <th>@Localizer["Binding"]</th><th>@Localizer["Access"]</th><th>@Localizer["Last modified"]</th><th>@Localizer["Last published"]</th><th>@Localizer["Created by"]</th><th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var display = fa && !string.IsNullOrWhiteSpace(r.NameFa) ? r.NameFa : r.Name;
                    <tr>
                        <td>
                            <div class="row-primary">@display</div>
                            @if (fa && string.IsNullOrWhiteSpace(r.NameFa)) { <div class="row-secondary text-muted small">@Localizer["No Persian name"]</div> }
                            else if (!fa && !string.IsNullOrWhiteSpace(r.NameFa)) { <div class="row-secondary small" dir="rtl">@r.NameFa</div> }
                            @if (!r.IsActive) { <span class="badge bg-secondary">@Localizer["Archived"]</span> }
                        </td>
                        <td>@r.Module<div class="row-secondary small">@r.Category</div></td>
                        <td>@(r.PublishedVersion.HasValue ? "v" + r.PublishedVersion : "-")</td>
                        <td>@if (r.OpenDraftVersion.HasValue) { <span class="badge bg-warning text-dark">v@(r.OpenDraftVersion) · @Localizer[r.OpenDraftStatus!]</span> } else { <span class="text-muted">-</span> }</td>
                        <td>@if (r.ActiveBindings > 0) { <span class="badge bg-success">@Localizer["Bound"] @r.BindingSummary</span> } else { <span class="badge bg-light text-dark border">@Localizer["No active binding"]</span> }</td>
                        <td><span class="badge @(r.Editable ? "bg-primary" : "bg-secondary")" title="@r.EditableReason">@Localizer[r.Editable ? "Editable" : "View Only"]</span></td>
                        <td class="small text-nowrap">@r.LastModified?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="small text-nowrap">@(r.LastPublished?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td class="small">@(r.CreatedBy ?? "-")</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@r.DefinitionId" class="btn btn-sm btn-outline-primary">@Localizer["Open"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="small text-muted mb-0"><i class="bi bi-info-circle"></i> @Localizer["Workflow versions are immutable once published. Editing a workflow means cloning a version into a draft; running instances stay on the version they started with."]</p>
    </div>
</div>
