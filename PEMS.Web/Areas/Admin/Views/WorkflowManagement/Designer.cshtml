@model PEMS.Application.DTOs.WorkflowDesignerModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Application.DTOs
@inject IStringLocalizer<SharedResource> Localizer
@{
    var perms = (Dictionary<string, bool>)ViewBag.Perms;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var selStage = (int?)ViewBag.SelectedStage;
    var selTr = (int?)ViewBag.SelectedTransition;
    var addStage = (bool)ViewBag.AddStage;
    var addTr = (bool)ViewBag.AddTransition;
    var edit = Model.CanEditStructure && perms["Edit"];
    var validation = ViewBag.Validation as List<PEMS.Web.Areas.Admin.Controllers.WorkflowManagementController.ValidationRow>;
    var g = Model.Graph;
    var stageById = Model.Stages.ToDictionary(s => s.StageId);
    string SName(int? id) => id.HasValue && stageById.TryGetValue(id.Value, out var s) ? (fa && !string.IsNullOrWhiteSpace(s.NameFa) ? s.NameFa! : s.Name) : "—";
    string Trunc(string s, int n) => s.Length <= n ? s : s[..(n - 1)] + "…";
    string Fmt(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    string EdgeLabel(WorkflowGraphEdge e) => fa && !string.IsNullOrWhiteSpace(e.LabelFa) ? e.LabelFa! : (!string.IsNullOrWhiteSpace(e.Label) ? e.Label! : e.ActionType);
    var stageObj = selStage.HasValue ? Model.Stages.FirstOrDefault(s => s.StageId == selStage) : null;
    var trObj = selTr.HasValue ? Model.Transitions.FirstOrDefault(t => t.TransitionId == selTr) : null;
    string StatusBadge(string s) => s switch { "Published" => "bg-success", "Validated" => "bg-info text-dark", "Draft" => "bg-warning text-dark", "Retired" => "bg-secondary", _ => "bg-light text-dark border" };
    var displayName = fa && !string.IsNullOrWhiteSpace(Model.DefinitionNameFa) ? Model.DefinitionNameFa : Model.DefinitionName;
    var employeeMap = Model.Employees;
}
<div class="admin-page-shell">
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold">@displayName</span> · <pems-badge tone="none" css="@StatusBadge(Model.Status)">v@(Model.VersionNumber) @Localizer[Model.Status]</pems-badge>
                @if (!string.IsNullOrEmpty(Model.LastEditor) && Model.CanEditStructure) { <span class="small text-muted ms-2">@Localizer["Last editor"]: @Model.LastEditor</span> }
                @if (Model.RunningInstances > 0) { <span class="small text-muted ms-2">@Localizer["Running instances"]: @Model.RunningInstances</span> }
            </div>
            <div class="d-flex gap-1 flex-wrap">
                <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Details" asp-route-id="@Model.DefinitionId"><pems-icon name="bi-arrow-left" /> @Localizer["Back"]</pems-button>
                @if (Model.CanEditStructure && perms["Validate"])
                {
                    <form asp-action="Validate" method="post" class="d-inline"><input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><pems-button tone="primary" size="small" outline="true"><pems-icon name="bi-check2-square" /> @Localizer["Validate"]</pems-button></form>
                }
                @if (Model.CanEditStructure && perms["Publish"])
                {
                    <form asp-action="Publish" method="post" class="d-inline" data-pems-confirm="@Localizer["Publish this version? Published versions are immutable."]">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="definitionId" value="@Model.DefinitionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <pems-button tone="primary" size="small" disabled="@(Model.Status != "Validated")" title="@(Model.Status != "Validated" ? Localizer["Validate the draft first."] : "")"><pems-icon name="bi-rocket-takeoff" /> @Localizer["Publish"]</pems-button>
                    </form>
                }
                @if (Model.CanEditStructure && perms["Edit"])
                {
                    <form asp-action="DiscardDraft" method="post" class="d-inline" data-pems-confirm="@Localizer["Discard this draft? Its structure is kept for audit but it can no longer be edited."]">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="definitionId" value="@Model.DefinitionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <pems-button tone="danger" size="small" outline="true"><pems-icon name="bi-x-octagon" /> @Localizer["Discard draft"]</pems-button>
                    </form>
                }
            </div>
        </div>
        @if (!Model.CanEditStructure)
        {
            <pems-alert tone="secondary" css="small mt-2 mb-0">
                <pems-icon name="bi-lock" />
                @if (!Model.DefinitionEditable) { @Localizer["View only:"] <span> @Model.DefinitionEditableReason</span> }
                else { @Localizer["This version is {0} and immutable. To change the workflow, clone a published version into a draft.", Localizer[Model.Status].Value] }
            </pems-alert>
        }
        else
        {
            <div class="small text-muted mt-2"><pems-icon name="bi-people" /> @Localizer["Four-eyes control: the last editor of this draft cannot publish it."]</div>
            @* SCRUM-103: what the module code needs from this definition (checked on Validate/Publish) *@
            <div class="small text-muted mt-1" data-contract-summary><pems-icon name="bi-shield-lock" /> @Model.DefinitionEditableReason</div>
        }
    </div>

    @if (validation != null && validation.Count > 0)
    {
        <div class="content-card mb-3">
            <h6 class="mb-2">@Localizer["Validation"]: <span class="text-danger">@validation.Count(v => v.Severity == "Error") @Localizer["errors"]</span>, <span class="text-warning">@validation.Count(v => v.Severity == "Warning") @Localizer["warnings"]</span></h6>
            <ul class="list-unstyled small mb-0">
                @foreach (var v in validation)
                {
                    <li class="mb-1"><pems-badge tone="none" css="@(v.Severity == "Error" ? "bg-danger" : "bg-warning text-dark")">@v.Severity</pems-badge> <code>@v.Code</code> @v.Message
                        @if (v.StageId.HasValue) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@v.StageId">@Localizer["Stage"]: @SName(v.StageId)</a> }
                        @if (v.TransitionId.HasValue) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@v.TransitionId">@Localizer["Transition"] #@v.TransitionId</a> }
                    </li>
                }
            </ul>
        </div>
    }

    <pems-row gap="3">
        <pems-col xl="8">
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h6 class="mb-0">@Localizer["Workflow graph"] <span class="small text-muted">(@Model.Stages.Count @Localizer["stage(s)"], @Model.Transitions.Count @Localizer["transition(s)"])</span></h6>
                    <div class="small text-muted">
                        <span class="pems-s-91d6b758">▬</span> @Localizer["Start"] &nbsp; <span class="pems-s-fb79543c">▬</span> @Localizer["forward"] &nbsp; <span class="pems-s-e34256e5">┅</span> @Localizer["return"] &nbsp; <span class="pems-s-4a8717b3">▬</span> @Localizer["End"]
                    </div>
                </div>
                <div class="wf-canvas" dir="ltr" id="wfCanvas" role="img" aria-label="@Localizer["Workflow graph"]">
                    <svg id="wfSvg" width="@Fmt(g.Width)" height="@Fmt(g.Height)" viewBox="0 0 @Fmt(g.Width) @Fmt(g.Height)" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="wfArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#6c7a8d" /></marker>
                        </defs>
                        @foreach (var e in g.Edges)
                        {
                            var cls = "wf-edge " + e.Kind.ToLowerInvariant() + (selTr == e.TransitionId ? " sel" : "");
                            <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@e.TransitionId" class="@cls" aria-label="@EdgeLabel(e)">
                                <title>@EdgeLabel(e) (@e.ActionType)@(string.IsNullOrEmpty(e.RequiredPermission) ? "" : " · " + e.RequiredPermission)</title>
                                <path d="@e.Path" marker-end="url(#wfArrow)" />
                                <path d="@e.Path" stroke="transparent" stroke-width="12" marker-end="" />
                                <text x="@Fmt(e.LabelX)" y="@Fmt(e.LabelY)">@Trunc(EdgeLabel(e), 22)</text>
                            </a>
                        }
                        @foreach (var n in g.Nodes)
                        {
                            var nm = fa && !string.IsNullOrWhiteSpace(n.NameFa) ? n.NameFa! : n.Name;
                            <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@n.StageId" class="wf-node@(selStage == n.StageId ? " sel" : "")@(n.IsStart ? " start" : "")" aria-label="@nm">
                                <title>@nm@(string.IsNullOrEmpty(n.BusinessStatus) ? "" : " · " + n.BusinessStatus)</title>
                                <rect x="@Fmt(n.X)" y="@Fmt(n.Y)" width="@Fmt(n.W)" height="@Fmt(n.H)" />
                                <text x="@Fmt(n.X + n.W / 2)" y="@Fmt(n.Y + 21)" text-anchor="middle">@Trunc(nm, 25)</text>
                                <text class="sub" x="@Fmt(n.X + n.W / 2)" y="@Fmt(n.Y + 38)" text-anchor="middle">@(string.IsNullOrEmpty(n.BusinessStatus) ? "" : n.BusinessStatus)</text>
                            </a>
                        }
                    </svg>
                </div>
                @if (g.Nodes.Count == 0) { <p class="small text-muted mt-2 mb-0">@Localizer["This version has no stages yet."]</p> }
            </div>

            <div class="content-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">@Localizer["Stages"]</h6>
                    @if (edit) { <pems-button as="a" tone="primary" size="small" outline="true" asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-addStage="true"><pems-icon name="bi-plus-lg" /> @Localizer["Add stage"]</pems-button> }
                </div>
                <div class="table-responsive"><pems-table scale="small" css="align-middle mb-0">
                    <thead><tr><th>#</th><th>@Localizer["Name"]</th><th>@Localizer["Persian name"]</th><th>@Localizer["Business status"]</th><th>@Localizer["Responsible role"]</th><th>@Localizer["Responsible employee"]</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Stages)
                    {
                        <tr class="@(selStage == s.StageId ? "table-primary" : "")">
                            <td>@s.StageOrder</td>
                            <td><a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@s.StageId">@s.Name</a></td>
                            <td dir="rtl">@s.NameFa</td><td>@s.BusinessStatus</td><td class="small text-break pems-s-f1a31497">@s.ResponsibleRole</td>
                            <td class="small">@(s.ResponsibleEmployeeId.HasValue ? (employeeMap.FirstOrDefault(e => e.Id == s.ResponsibleEmployeeId).Name ?? "#" + s.ResponsibleEmployeeId) : "")</td>
                        </tr>
                    }
                    </tbody></pems-table></div>
            </div>

            <div class="content-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">@Localizer["Transitions"]</h6>
                    @if (edit) { <pems-button as="a" tone="primary" size="small" outline="true" asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-addTransition="true"><pems-icon name="bi-plus-lg" /> @Localizer["Add transition"]</pems-button> }
                </div>
                <div class="table-responsive"><pems-table scale="small" css="align-middle mb-0">
                    <thead><tr><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["Action"]</th><th>@Localizer["Label"]</th><th>@Localizer["Required permission"]</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Transitions)
                    {
                        <tr class="@(selTr == t.TransitionId ? "table-primary" : "")">
                            <td>@(t.FromStageId.HasValue ? SName(t.FromStageId) : Localizer["(start)"].Value)</td>
                            <td>@(t.ToStageId.HasValue ? SName(t.ToStageId) : Localizer["(end)"].Value)</td>
                            <td><a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@t.TransitionId">@t.ActionType</a></td>
                            <td class="small">@(fa && !string.IsNullOrWhiteSpace(t.LabelFa) ? t.LabelFa : t.Label)</td>
                            <td class="small">@t.RequiredPermission</td>
                        </tr>
                    }
                    </tbody></pems-table></div>
            </div>
        </pems-col>

        <pems-col xl="4">
            @{
                var stageForm = stageObj ?? (addStage ? new WorkflowStageEditModel { StageOrder = 0 } : null);
                var trForm = trObj ?? (addTr ? new WorkflowTransitionEditModel { Priority = 1, ActionType = "Approve" } : null);
            }
            @if (stageForm != null)
            {
                <div class="content-card wf-panel">
                    <h6>@(stageForm.StageId == 0 ? Localizer["Add stage"] : Localizer["Stage"])</h6>
                    <form asp-action="SaveStage" method="post"><pems-row gap="2">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="stage.StageId" value="@stageForm.StageId" />
                        <fieldset class="m-0 p-0 border-0" disabled="@(!edit)"><pems-row gap="2">
                            <pems-col span="12"><label>@Localizer["Name"]</label><pems-input scale="small" name="stage.Name" value="@stageForm.Name" required maxlength="200" /></pems-col>
                            <pems-col span="12"><label>@Localizer["Persian name"]</label><pems-input scale="small" name="stage.NameFa" dir="rtl" value="@stageForm.NameFa" maxlength="200" /></pems-col>
                            <pems-col span="6"><label>@Localizer["Business status"]</label><pems-input scale="small" name="stage.BusinessStatus" value="@stageForm.BusinessStatus" maxlength="50" /></pems-col>
                            <pems-col span="6"><label>@Localizer["Order"]</label><pems-input scale="small" name="stage.StageOrder" type="number" value="@stageForm.StageOrder" /></pems-col>
                            <pems-col span="12"><label>@Localizer["Responsible role"]</label>
                                <pems-input scale="small" name="stage.ResponsibleRole" list="wfRoles" value="@stageForm.ResponsibleRole" placeholder="@Localizer["Role name or Permission:Resource.Action"]" />
                                <datalist id="wfRoles">@foreach (var r in Model.Roles) { <option value="@r"></option> }@foreach (var p in Model.Permissions) { <option value="Permission:@p"></option> }</datalist></pems-col>
                            <pems-col span="12"><label>@Localizer["Responsible employee"]</label>
                                <pems-select scale="small" name="stage.ResponsibleEmployeeId"><option value="">—</option>
                                    @foreach (var e in Model.Employees) { <option value="@e.Id" selected="@(stageForm.ResponsibleEmployeeId == e.Id)">@e.Name</option> }
                                </pems-select></pems-col>
                            <pems-col span="6"><label>@Localizer["Stage type"]</label>
                                <pems-select scale="small" name="stage.StageType">@foreach (var o in new[] { "Sequential", "Parallel" }) { <option value="@o" selected="@(stageForm.StageType == o)">@o</option> }</pems-select></pems-col>
                            <pems-col span="6"><label>@Localizer["Approval strategy"]</label>
                                <pems-select scale="small" name="stage.ApprovalStrategy">@foreach (var o in new[] { "AllApprovalsRequired", "MandatoryRolesOnly", "MinimumCount", "FirstResponse" }) { <option value="@o" selected="@(stageForm.ApprovalStrategy == o)">@o</option> }</pems-select></pems-col>
                            <pems-col span="6"><label>@Localizer["Minimum approvals"]</label><pems-input scale="small" name="stage.MinimumApprovalCount" type="number" min="1" value="@stageForm.MinimumApprovalCount" /></pems-col>
                            <pems-col span="6"><label>@Localizer["Timeout (hours)"]</label><pems-input scale="small" name="stage.TimeoutHours" type="number" min="1" value="@stageForm.TimeoutHours" /></pems-col>
                            <pems-col span="12"><div class="form-check"><pems-input type="checkbox" name="stage.IsMandatory" value="true" checked="@stageForm.IsMandatory" id="stMand" kind="check" /><input type="hidden" name="stage.IsMandatory" value="false" /><label class="form-check-label" for="stMand">@Localizer["Mandatory"]</label></div></pems-col>
                            <pems-col span="12"><label>@Localizer["Description"]</label><pems-input scale="small" name="stage.Description" value="@stageForm.Description" /></pems-col>
                        </pems-row></fieldset>
                        @if (edit) { <pems-col span="12"><pems-button tone="primary" size="small">@Localizer["Save stage"]</pems-button></pems-col> }
                    </pems-row></form>
                    @if (edit && stageForm.StageId != 0)
                    {
                        <form asp-action="DeleteStage" method="post" class="mt-2" data-pems-confirm="@Localizer["Remove this stage and its transitions?"]">
                            <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="stageId" value="@stageForm.StageId" />
                            <pems-button tone="danger" size="small" outline="true">@Localizer["Remove stage"]</pems-button>
                        </form>
                    }
                </div>
            }
            else if (trForm != null)
            {
                <div class="content-card wf-panel">
                    <h6>@(trForm.TransitionId == 0 ? Localizer["Add transition"] : Localizer["Transition"])</h6>
                    <form asp-action="SaveTransition" method="post"><pems-row gap="2">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="transition.TransitionId" value="@trForm.TransitionId" />
                        <fieldset class="m-0 p-0 border-0" disabled="@(!edit)"><pems-row gap="2">
                            <pems-col span="6"><label>@Localizer["From"]</label>
                                <pems-select scale="small" name="transition.FromStageId"><option value="">@Localizer["(start)"]</option>@foreach (var s in Model.Stages) { <option value="@s.StageId" selected="@(trForm.FromStageId == s.StageId)">@s.Name</option> }</pems-select></pems-col>
                            <pems-col span="6"><label>@Localizer["To"]</label>
                                <pems-select scale="small" name="transition.ToStageId"><option value="">@Localizer["(end)"]</option>@foreach (var s in Model.Stages) { <option value="@s.StageId" selected="@(trForm.ToStageId == s.StageId)">@s.Name</option> }</pems-select></pems-col>
                            <pems-col span="6"><label>@Localizer["Action"]</label>
                                <pems-input scale="small" name="transition.ActionType" list="wfActions" value="@trForm.ActionType" required maxlength="100" />
                                <datalist id="wfActions">@foreach (var a in Model.ActionTypes) { <option value="@a"></option> }</datalist></pems-col>
                            <pems-col span="6"><label>@Localizer["Priority"]</label><pems-input scale="small" name="transition.Priority" type="number" value="@trForm.Priority" /></pems-col>
                            <pems-col span="12"><label>@Localizer["Label"]</label><pems-input scale="small" name="transition.Label" value="@trForm.Label" maxlength="100" /></pems-col>
                            <pems-col span="12"><label>@Localizer["Persian label"]</label><pems-input scale="small" name="transition.LabelFa" dir="rtl" value="@trForm.LabelFa" maxlength="100" /></pems-col>
                            <pems-col span="12"><label>@Localizer["Required permission"]</label>
                                <pems-input scale="small" name="transition.RequiredPermission" list="wfPerms" value="@trForm.RequiredPermission" placeholder="Resource.Action" />
                                <datalist id="wfPerms">@foreach (var p in Model.Permissions) { <option value="@p"></option> }</datalist></pems-col>
                            <pems-col span="12"><label>@Localizer["Condition"]</label><pems-input scale="small" name="transition.ConditionExpression" value="@trForm.ConditionExpression" /></pems-col>
                            <pems-col span="12"><div class="form-check"><pems-input type="checkbox" name="transition.ForbidInitiator" value="true" checked="@trForm.ForbidInitiator" id="trForbid" kind="check" /><input type="hidden" name="transition.ForbidInitiator" value="false" /><label class="form-check-label" for="trForbid">@Localizer["Initiator cannot perform this action"]</label></div></pems-col>
                        </pems-row></fieldset>
                        @if (edit) { <pems-col span="12"><pems-button tone="primary" size="small">@Localizer["Save transition"]</pems-button></pems-col> }
                    </pems-row></form>
                    @if (edit && trForm.TransitionId != 0)
                    {
                        <form asp-action="DeleteTransition" method="post" class="mt-2" data-pems-confirm="@Localizer["Remove this transition?"]">
                            <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="transitionId" value="@trForm.TransitionId" />
                            <pems-button tone="danger" size="small" outline="true">@Localizer["Remove transition"]</pems-button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="content-card">
                    <p class="small text-muted mb-0"><pems-icon name="bi-cursor" /> @Localizer["Select a stage or a transition in the graph or the tables to inspect or edit it."]</p>
                </div>
            }
            <div class="content-card mt-3">
                <h6>@Localizer["Recent changes"]</h6>
                <ul class="list-unstyled small mb-0 pems-s-80c1414f">
                    @foreach (var a in Model.Audit) { <li class="mb-1"><span class="text-muted">@a.Timestamp.ToString("MM-dd HH:mm")</span> · @a.Action · @a.Actor @if (!string.IsNullOrEmpty(a.Details)) { <span class="text-muted">· @a.Details</span> }</li> }
                </ul>
            </div>
        </pems-col>
    </pems-row>
</div>

@section Styles { <link rel="stylesheet" href="~/css/pems-workflow-designer.css" asp-append-version="true" /> }
