@model PEMS.Application.DTOs.WorkflowDefinitionDetails
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Definition;
    var perms = (Dictionary<string, bool>)ViewBag.Perms;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var display = fa && !string.IsNullOrWhiteSpace(d.NameFa) ? d.NameFa : d.Name;
    var openDraft = Model.Versions.FirstOrDefault(v => v.Status is "Draft" or "Validated");
    var published = Model.Versions.Where(v => v.Status == "Published").ToList();
    string StatusBadge(string s) => s switch { "Published" => "bg-success", "Validated" => "bg-info text-dark", "Draft" => "bg-warning text-dark", "Retired" => "bg-secondary", _ => "bg-light text-dark border" };
}
<div class="admin-page-shell">
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h5 class="mb-1">@display</h5>
                <div class="small text-muted">@d.Module · @d.Category @if (!d.IsActive) { <span class="badge bg-secondary">@Localizer["Archived"]</span> }</div>
                <div class="mt-1">
                    <span class="badge @(d.Editable ? "bg-primary" : "bg-secondary")">@Localizer[d.Editable ? "Editable" : "View Only"]</span>
                    <span class="small text-muted">@d.EditableReason</span>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> @Localizer["Workflow Management"]</a>
        </div>
        <div class="alert alert-info small mt-3 mb-0"><i class="bi bi-pin-angle"></i> @Localizer["Editing or publishing a new workflow version does not alter existing pinned workflow instances."]</div>
    </div>

    @if (d.Editable && perms["Edit"])
    {
        <div class="content-card mb-3">
            <h6>@Localizer["Definition details"] <span class="small text-muted">(@Localizer["shared by all versions"])</span></h6>
            <form asp-action="UpdateDefinition" method="post" class="row g-2">
                <input type="hidden" name="id" value="@d.DefinitionId" />
                <div class="col-md-4"><label class="form-label small">@Localizer["Name"]</label><input name="name" class="form-control form-control-sm" value="@d.Name" required maxlength="200" /></div>
                <div class="col-md-4"><label class="form-label small">@Localizer["Persian name"]</label><input name="nameFa" class="form-control form-control-sm" dir="rtl" value="@d.NameFa" maxlength="200" /></div>
                <div class="col-md-4"><label class="form-label small">@Localizer["Description"]</label><input name="description" class="form-control form-control-sm" value="@Model.Description" /></div>
                <div class="col-12"><button class="btn btn-sm btn-pems-solid">@Localizer["Save"]</button></div>
            </form>
        </div>
    }

    <div class="content-card mb-3">
        <h6>@Localizer["Versions"]</h6>
        <div class="table-responsive">
            <table class="table table-enterprise align-middle">
                <thead><tr><th>@Localizer["Version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Stages"]</th><th>@Localizer["Transitions"]</th><th>@Localizer["Published"]</th><th>@Localizer["Running instances"]</th><th>@Localizer["Change summary"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var v in Model.Versions)
                {
                    <tr>
                        <td>v@(v.VersionNumber) @if (v.ClonedFromVersion.HasValue) { <span class="small text-muted">(← v@(v.ClonedFromVersion))</span> } @if (v.IsBound) { <span class="badge bg-success">@Localizer["Bound"]</span> }</td>
                        <td><span class="badge @StatusBadge(v.Status)">@Localizer[v.Status]</span></td>
                        <td>@v.Stages</td><td>@v.Transitions</td>
                        <td class="small text-nowrap">@(v.PublishedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>@v.RunningInstances / @v.TotalInstances</td>
                        <td class="small">@v.ChangeSummary</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Designer" asp-route-versionId="@v.VersionId" class="btn btn-sm btn-outline-primary">@Localizer[v.Status is "Draft" or "Validated" ? "Open" : "View"]</a>
                            @if (d.Editable && perms["Edit"] && v.Status is "Published" or "Retired" && openDraft == null)
                            {
                                <form asp-action="CloneVersion" method="post" class="d-inline">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <button class="btn btn-sm btn-outline-secondary" title="@Localizer["Clone into a new draft"]"><i class="bi bi-files"></i> @Localizer["Clone"]</button>
                                </form>
                            }
                            @if (d.Editable && perms["Retire"] && v.Status == "Published" && !v.IsBound)
                            {
                                <form asp-action="Retire" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Retire this version? Running instances keep using it."]');">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <button class="btn btn-sm btn-outline-danger">@Localizer["Retire"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (openDraft != null) { <p class="small text-muted mb-0"><i class="bi bi-info-circle"></i> @Localizer["One open draft per workflow: finish or discard v{0} before cloning again.", openDraft.VersionNumber]</p> }
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="content-card h-100">
                <h6>@Localizer["Binding"]</h6>
                @if (Model.Bindings.Count == 0 || Model.Bindings.All(b => !b.IsActive))
                {
                    <p class="mb-0"><span class="badge bg-light text-dark border">@Localizer["No active binding"]</span> <span class="small text-muted">@Localizer["Valid state: legacy modules resolve this definition directly."]</span></p>
                }
                @foreach (var b in Model.Bindings.Where(x => x.IsActive))
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="small"><strong>@b.Module</strong> / @b.EntityType / @b.Context → <strong>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"])</strong></div>
                        @if (d.Editable && perms["Bind"] && published.Any(p => p.VersionId != b.PinnedVersionId))
                        {
                            <form asp-action="BindingImpact" method="get" class="d-flex gap-2 mt-2 align-items-center">
                                <input type="hidden" name="bindingId" value="@b.BindingId" />
                                <select name="targetVersionId" class="form-select form-select-sm w-auto">
                                    @foreach (var p in published.Where(p => p.VersionId != b.PinnedVersionId)) { <option value="@p.VersionId">v@(p.VersionNumber)</option> }
                                </select>
                                <button class="btn btn-sm btn-outline-primary">@Localizer["Review binding change"]</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="content-card h-100">
                <h6>@Localizer["Usage"]</h6>
                @if (Model.TotalInstances == 0) { <p class="small text-muted mb-0">@Localizer["No instances have used this workflow."]</p> }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>@Localizer["Version"]</th><th>@Localizer["Running"]</th><th>@Localizer["Completed"]</th><th>@Localizer["Cancelled"]</th><th>@Localizer["Rejected"]</th></tr></thead>
                        <tbody>@foreach (var u in Model.Usage) { <tr><td>v@(u.VersionNumber)</td><td>@u.Running</td><td>@u.Completed</td><td>@u.Cancelled</td><td>@u.Rejected</td></tr> }</tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="content-card mt-3">
        <h6>@Localizer["Configuration audit"]</h6>
        <div class="table-responsive" style="max-height:340px;overflow:auto">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>@Localizer["Time"]</th><th>@Localizer["Action"]</th><th>@Localizer["Version"]</th><th>@Localizer["By"]</th><th>@Localizer["Change"]</th></tr></thead>
                <tbody>
                @foreach (var a in Model.Audit)
                {
                    <tr>
                        <td class="small text-nowrap">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</td><td class="small">@a.Action</td><td class="small">@(a.VersionNumber.HasValue ? "v" + a.VersionNumber : "-")</td><td class="small">@a.Actor</td>
                        <td class="small">@(string.IsNullOrEmpty(a.Previous) ? "" : a.Previous + " → ")@a.Current @if (!string.IsNullOrEmpty(a.Details)) { <span class="text-muted">· @a.Details</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
