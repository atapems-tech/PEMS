@model PEMS.Application.DTOs.WorkflowDefinitionDetails
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Definition;
    var perms = (Dictionary<string, bool>)ViewBag.Perms;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var display = fa && !string.IsNullOrWhiteSpace(d.NameFa) ? d.NameFa : d.Name;
    var openDraft = Model.Versions.FirstOrDefault(v => v.Status is "Draft" or "Validated");
    var published = Model.Versions.Where(v => v.Status == "Published").ToList();
    string StatusBadge(string s) => s switch { "Published" => "bg-success", "Validated" => "bg-info text-dark", "Draft" => "bg-warning text-dark", "Retired" => "bg-secondary", _ => "bg-light text-dark border" };
}
<pems-page-shell kind="admin">
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="start" wrap="true" gap="2">
            <div>
                <pems-heading level="5" class="mb-1">@display</pems-heading>
                <div class="small text-muted">@d.Module · @d.Category @if (!d.IsActive) { <pems-badge tone="neutral">@Localizer["Archived"]</pems-badge> }</div>
                <div class="mt-1">
                    <pems-badge tone="none" css="@(d.Editable ? "bg-primary" : "bg-secondary")">@Localizer[d.Editable ? "Editable" : "View Only"]</pems-badge>
                    <span class="small text-muted">@d.EditableReason</span>
                </div>
            </div>
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Workflow Management"]</pems-button>
        </pems-flex>
        <pems-alert tone="info" css="small mt-3 mb-0"><pems-icon name="bi-pin-angle" /> @Localizer["Editing or publishing a new workflow version does not alter existing pinned workflow instances."]</pems-alert>
    </pems-content-card>

    @if (d.Editable && perms["Edit"])
    {
        <pems-content-card css="mb-3">
            <pems-heading level="6">@Localizer["Definition details"] <span class="small text-muted">(@Localizer["shared by all versions"])</span></pems-heading>
            <pems-form asp-action="UpdateDefinition" method="post"><pems-row gap="2">
                <input type="hidden" name="id" value="@d.DefinitionId" />
                <pems-col md="4"><pems-label css="small">@Localizer["Name"]</pems-label><pems-input scale="small" name="name" value="@d.Name" required maxlength="200" /></pems-col>
                <pems-col md="4"><pems-label css="small">@Localizer["Persian name"]</pems-label><pems-input scale="small" name="nameFa" dir="rtl" value="@d.NameFa" maxlength="200" /></pems-col>
                <pems-col md="4"><pems-label css="small">@Localizer["Description"]</pems-label><pems-input scale="small" name="description" value="@Model.Description" /></pems-col>
                <pems-col span="12"><pems-button tone="primary" size="small">@Localizer["Save"]</pems-button></pems-col>
            </pems-row></pems-form>
        </pems-content-card>
    }

    <pems-content-card css="mb-3">
        <pems-heading level="6">@Localizer["Versions"]</pems-heading>
        <pems-table-scroll>
            @{
                var rows_7 = Model.Versions;
                var cell_7_1 = DataCell.Template(rows_7, @<text>@{ var v = item; }<pems-badge tone="none" css="@StatusBadge(v.Status)">@Localizer[v.Status]</pems-badge></text>);
                var cell_7_7 = DataCell.Template(rows_7, @<text>@{ var v = item; }
                            <pems-button as="a" tone="primary" size="small" outline="true" asp-action="Designer" asp-route-versionId="@v.VersionId">@Localizer[v.Status is "Draft" or "Validated" ? "Open" : "View"]</pems-button>
                            @if (d.Editable && perms["Edit"] && v.Status is "Published" or "Retired" && openDraft == null)
                            {
                                <pems-form asp-action="CloneVersion" method="post" class="d-inline">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <pems-button tone="neutral" size="small" outline="true" title="@Localizer["Clone into a new draft"]"><pems-icon name="bi-files" /> @Localizer["Clone"]</pems-button>
                                </pems-form>
                            }
                            @if (d.Editable && perms["Retire"] && v.Status == "Published" && !v.IsBound)
                            {
                                <pems-form asp-action="Retire" method="post" class="d-inline" data-pems-confirm="@Localizer["Retire this version? Running instances keep using it."]">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <pems-button tone="danger" size="small" outline="true">@Localizer["Retire"]</pems-button>
                                </pems-form>
                            }
                        </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_7, c_ => c_.Add(((Localizer["Version"])?.ToString() ?? ""), v => (object?)(DataCell.Group("v", v.VersionNumber, " ", (v.ClonedFromVersion.HasValue ? (object?)DataCell.Span("small text-muted", "(← v", v.ClonedFromVersion, ")") : null), " ", (v.IsBound ? (object?)DataCell.Badge("success", Localizer["Bound"]) : null)))).Add(((Localizer["Status"])?.ToString() ?? ""), v => (object?)cell_7_1(v)).Add(((Localizer["Stages"])?.ToString() ?? ""), v => (object?)(v.Stages)).Add(((Localizer["Transitions"])?.ToString() ?? ""), v => (object?)(v.Transitions)).Add(((Localizer["Published"])?.ToString() ?? ""), v => (object?)((PemsDates.DateTime(v.PublishedDate) ?? "-")), css: "small text-nowrap").Add(((Localizer["Running instances"])?.ToString() ?? ""), v => (object?)(DataCell.Group(v.RunningInstances, " / ", v.TotalInstances))).Add(((Localizer["Change summary"])?.ToString() ?? ""), v => (object?)(v.ChangeSummary), css: "small").Add("", v => (object?)cell_7_7(v), css: "text-end text-nowrap")))" css="align-middle" />
        </pems-table-scroll>
        @if (openDraft != null) { <pems-text class="small text-muted mb-0"><pems-icon name="bi-info-circle" /> @Localizer["One open draft per workflow: finish or discard v{0} before cloning again.", openDraft.VersionNumber]</pems-text> }
    </pems-content-card>

    <pems-row gap="3">
        <pems-col lg="6">
            <pems-content-card css="h-100">
                <pems-heading level="6">@Localizer["Binding"]</pems-heading>
                @if (Model.Bindings.Count == 0 || Model.Bindings.All(b => !b.IsActive))
                {
                    <pems-text class="mb-0"><pems-badge tone="light">@Localizer["No active binding"]</pems-badge> <span class="small text-muted">@Localizer["Valid state: legacy modules resolve this definition directly."]</span></pems-text>
                }
                @foreach (var b in Model.Bindings.Where(x => x.IsActive))
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="small"><strong>@b.Module</strong> / @b.EntityType / @b.Context → <strong>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"])</strong></div>
                        @if (d.Editable && perms["Bind"] && published.Any(p => p.VersionId != b.PinnedVersionId))
                        {
                            <pems-form class="mt-2" asp-action="BindingImpact" method="get"><pems-flex gap="2" align="center">
                                <input type="hidden" name="bindingId" value="@b.BindingId" />
                                <pems-select scale="small" css="w-auto" name="targetVersionId">
                                    @foreach (var p in published.Where(p => p.VersionId != b.PinnedVersionId)) { <option value="@p.VersionId">v@(p.VersionNumber)</option> }
                                </pems-select>
                                <pems-button tone="primary" size="small" outline="true">@Localizer["Review binding change"]</pems-button>
                            </pems-flex></pems-form>
                        }
                    </div>
                }
            </pems-content-card>
        </pems-col>
        <pems-col lg="6">
            <pems-content-card css="h-100">
                <pems-heading level="6">@Localizer["Usage"]</pems-heading>
                @if (Model.TotalInstances == 0) { <pems-text class="small text-muted mb-0">@Localizer["No instances have used this workflow."]</pems-text> }
                else
                {
                    <pems-data-table data="@(DataRows.Of(Model.Usage, c_ => c_.Add(((Localizer["Version"])?.ToString() ?? ""), u => DataCell.Join("v", (u.VersionNumber))).Add(((Localizer["Running"])?.ToString() ?? ""), u => (object?)(u.Running)).Add(((Localizer["Completed"])?.ToString() ?? ""), u => (object?)(u.Completed)).Add(((Localizer["Cancelled"])?.ToString() ?? ""), u => (object?)(u.Cancelled)).Add(((Localizer["Rejected"])?.ToString() ?? ""), u => (object?)(u.Rejected))))" enterprise="false" dense="true" css="mb-0" />
                }
            </pems-content-card>
        </pems-col>
    </pems-row>

    <pems-content-card css="mt-3">
        <pems-heading level="6">@Localizer["Configuration audit"]</pems-heading>
        <pems-table-scroll css="pems-s-11017dde">
            <pems-data-table data="@(DataRows.Of(Model.Audit, c_ => c_.Add(((Localizer["Time"])?.ToString() ?? ""), a => (object?)((PemsDates.DateTime(a.Timestamp))), css: "small text-nowrap").Add(((Localizer["Action"])?.ToString() ?? ""), a => (object?)(a.Action), css: "small").Add(((Localizer["Version"])?.ToString() ?? ""), a => (object?)((a.VersionNumber.HasValue ? "v" + a.VersionNumber : "-")), css: "small").Add(((Localizer["By"])?.ToString() ?? ""), a => (object?)(a.Actor), css: "small").Add(((Localizer["Change"])?.ToString() ?? ""), a => (object?)(DataCell.Group((string.IsNullOrEmpty(a.Previous) ? "" : a.Previous + " → "), a.Current, " ", (!string.IsNullOrEmpty(a.Details) ? (object?)DataCell.Span("text-muted", "· ", a.Details) : null))), css: "small")))" dense="true" css="align-middle mb-0" enterprise="false" />
        </pems-table-scroll>
    </pems-content-card>
</pems-page-shell>
