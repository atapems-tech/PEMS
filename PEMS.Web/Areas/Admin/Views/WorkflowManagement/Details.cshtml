@model PEMS.Application.DTOs.WorkflowDefinitionDetails
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Definition;
    var perms = (Dictionary<string, bool>)ViewBag.Perms;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var display = fa && !string.IsNullOrWhiteSpace(d.NameFa) ? d.NameFa : d.Name;
    var openDraft = Model.Versions.FirstOrDefault(v => v.Status is "Draft" or "Validated");
    var published = Model.Versions.Where(v => v.Status == "Published").ToList();
    string StatusBadge(string s) => s switch { "Published" => "bg-success", "Validated" => "bg-info text-dark", "Draft" => "bg-warning text-dark", "Retired" => "bg-secondary", _ => "bg-light text-dark border" };
}
<pems-page-shell kind="admin">
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="start" wrap="true" gap="2">
            <div>
                <h5 class="mb-1">@display</h5>
                <div class="small text-muted">@d.Module · @d.Category @if (!d.IsActive) { <pems-badge tone="neutral">@Localizer["Archived"]</pems-badge> }</div>
                <div class="mt-1">
                    <pems-badge tone="none" css="@(d.Editable ? "bg-primary" : "bg-secondary")">@Localizer[d.Editable ? "Editable" : "View Only"]</pems-badge>
                    <span class="small text-muted">@d.EditableReason</span>
                </div>
            </div>
            <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Workflow Management"]</pems-button>
        </pems-flex>
        <pems-alert tone="info" css="small mt-3 mb-0"><pems-icon name="bi-pin-angle" /> @Localizer["Editing or publishing a new workflow version does not alter existing pinned workflow instances."]</pems-alert>
    </pems-content-card>

    @if (d.Editable && perms["Edit"])
    {
        <pems-content-card css="mb-3">
            <h6>@Localizer["Definition details"] <span class="small text-muted">(@Localizer["shared by all versions"])</span></h6>
            <form asp-action="UpdateDefinition" method="post"><pems-row gap="2">
                <input type="hidden" name="id" value="@d.DefinitionId" />
                <pems-col md="4"><pems-label css="small">@Localizer["Name"]</pems-label><pems-input scale="small" name="name" value="@d.Name" required maxlength="200" /></pems-col>
                <pems-col md="4"><pems-label css="small">@Localizer["Persian name"]</pems-label><pems-input scale="small" name="nameFa" dir="rtl" value="@d.NameFa" maxlength="200" /></pems-col>
                <pems-col md="4"><pems-label css="small">@Localizer["Description"]</pems-label><pems-input scale="small" name="description" value="@Model.Description" /></pems-col>
                <pems-col span="12"><pems-button tone="primary" size="small">@Localizer["Save"]</pems-button></pems-col>
            </pems-row></form>
        </pems-content-card>
    }

    <pems-content-card css="mb-3">
        <h6>@Localizer["Versions"]</h6>
        <div class="table-responsive">
            <pems-table kind="enterprise" css="align-middle">
                <thead><tr><th>@Localizer["Version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Stages"]</th><th>@Localizer["Transitions"]</th><th>@Localizer["Published"]</th><th>@Localizer["Running instances"]</th><th>@Localizer["Change summary"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var v in Model.Versions)
                {
                    <tr>
                        <td>v@(v.VersionNumber) @if (v.ClonedFromVersion.HasValue) { <span class="small text-muted">(← v@(v.ClonedFromVersion))</span> } @if (v.IsBound) { <pems-badge tone="success">@Localizer["Bound"]</pems-badge> }</td>
                        <td><pems-badge tone="none" css="@StatusBadge(v.Status)">@Localizer[v.Status]</pems-badge></td>
                        <td>@v.Stages</td><td>@v.Transitions</td>
                        <td class="small text-nowrap">@(v.PublishedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>@v.RunningInstances / @v.TotalInstances</td>
                        <td class="small">@v.ChangeSummary</td>
                        <td class="text-end text-nowrap">
                            <pems-button as="a" tone="primary" size="small" outline="true" asp-action="Designer" asp-route-versionId="@v.VersionId">@Localizer[v.Status is "Draft" or "Validated" ? "Open" : "View"]</pems-button>
                            @if (d.Editable && perms["Edit"] && v.Status is "Published" or "Retired" && openDraft == null)
                            {
                                <form asp-action="CloneVersion" method="post" class="d-inline">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <pems-button tone="neutral" size="small" outline="true" title="@Localizer["Clone into a new draft"]"><pems-icon name="bi-files" /> @Localizer["Clone"]</pems-button>
                                </form>
                            }
                            @if (d.Editable && perms["Retire"] && v.Status == "Published" && !v.IsBound)
                            {
                                <form asp-action="Retire" method="post" class="d-inline" data-pems-confirm="@Localizer["Retire this version? Running instances keep using it."]">
                                    <input type="hidden" name="versionId" value="@v.VersionId" /><input type="hidden" name="definitionId" value="@d.DefinitionId" />
                                    <pems-button tone="danger" size="small" outline="true">@Localizer["Retire"]</pems-button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </pems-table>
        </div>
        @if (openDraft != null) { <p class="small text-muted mb-0"><pems-icon name="bi-info-circle" /> @Localizer["One open draft per workflow: finish or discard v{0} before cloning again.", openDraft.VersionNumber]</p> }
    </pems-content-card>

    <pems-row gap="3">
        <pems-col lg="6">
            <pems-content-card css="h-100">
                <h6>@Localizer["Binding"]</h6>
                @if (Model.Bindings.Count == 0 || Model.Bindings.All(b => !b.IsActive))
                {
                    <p class="mb-0"><pems-badge tone="light">@Localizer["No active binding"]</pems-badge> <span class="small text-muted">@Localizer["Valid state: legacy modules resolve this definition directly."]</span></p>
                }
                @foreach (var b in Model.Bindings.Where(x => x.IsActive))
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="small"><strong>@b.Module</strong> / @b.EntityType / @b.Context → <strong>@(b.PinnedVersionNumber.HasValue ? "v" + b.PinnedVersionNumber : Localizer["latest published"])</strong></div>
                        @if (d.Editable && perms["Bind"] && published.Any(p => p.VersionId != b.PinnedVersionId))
                        {
                            <form class="mt-2" asp-action="BindingImpact" method="get"><pems-flex gap="2" align="center">
                                <input type="hidden" name="bindingId" value="@b.BindingId" />
                                <pems-select scale="small" css="w-auto" name="targetVersionId">
                                    @foreach (var p in published.Where(p => p.VersionId != b.PinnedVersionId)) { <option value="@p.VersionId">v@(p.VersionNumber)</option> }
                                </pems-select>
                                <pems-button tone="primary" size="small" outline="true">@Localizer["Review binding change"]</pems-button>
                            </pems-flex></form>
                        }
                    </div>
                }
            </pems-content-card>
        </pems-col>
        <pems-col lg="6">
            <pems-content-card css="h-100">
                <h6>@Localizer["Usage"]</h6>
                @if (Model.TotalInstances == 0) { <p class="small text-muted mb-0">@Localizer["No instances have used this workflow."]</p> }
                else
                {
                    <pems-table scale="small" css="mb-0">
                        <thead><tr><th>@Localizer["Version"]</th><th>@Localizer["Running"]</th><th>@Localizer["Completed"]</th><th>@Localizer["Cancelled"]</th><th>@Localizer["Rejected"]</th></tr></thead>
                        <tbody>@foreach (var u in Model.Usage) { <tr><td>v@(u.VersionNumber)</td><td>@u.Running</td><td>@u.Completed</td><td>@u.Cancelled</td><td>@u.Rejected</td></tr> }</tbody>
                    </pems-table>
                }
            </pems-content-card>
        </pems-col>
    </pems-row>

    <pems-content-card css="mt-3">
        <h6>@Localizer["Configuration audit"]</h6>
        <div class="table-responsive pems-s-11017dde">
            <pems-table scale="small" css="align-middle mb-0">
                <thead><tr><th>@Localizer["Time"]</th><th>@Localizer["Action"]</th><th>@Localizer["Version"]</th><th>@Localizer["By"]</th><th>@Localizer["Change"]</th></tr></thead>
                <tbody>
                @foreach (var a in Model.Audit)
                {
                    <tr>
                        <td class="small text-nowrap">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</td><td class="small">@a.Action</td><td class="small">@(a.VersionNumber.HasValue ? "v" + a.VersionNumber : "-")</td><td class="small">@a.Actor</td>
                        <td class="small">@(string.IsNullOrEmpty(a.Previous) ? "" : a.Previous + " → ")@a.Current @if (!string.IsNullOrEmpty(a.Details)) { <span class="text-muted">· @a.Details</span> }</td>
                    </tr>
                }
                </tbody>
            </pems-table>
        </div>
    </pems-content-card>
</pems-page-shell>
