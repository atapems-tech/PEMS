@model PEMS.Application.Organization.OrganizationImportResult
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var token = ViewBag.Token as string;
    var committed = Model.Committed;
}

<div class="admin-page-shell">
    <div class="d-flex gap-2 mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><i class="bi bi-arrow-left"></i> @Localizer["Org_Imp_Title"]</a>
    </div>

    @if (committed) { <pems-alert tone="success">@Localizer["Org_Imp_Committed"]</pems-alert> }
    else if (Model.Errors.Count > 0) { <pems-alert tone="danger">@Localizer["Org_Imp_Rejected"]</pems-alert> }
    else { <pems-alert tone="info">@Localizer["Org_Imp_ValidOk"]</pems-alert> }

    <section class="vs-panel mb-3">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Localizer["Org_Imp_PosCreated"]</dt><dd class="col-sm-9">@Model.PositionsCreated</dd>
            <dt class="col-sm-3">@Localizer["Org_Imp_PosUpdated"]</dt><dd class="col-sm-9">@Model.PositionsUpdated</dd>
            <dt class="col-sm-3">@Localizer["Org_Imp_AsgCreated"]</dt><dd class="col-sm-9">@Model.AssignmentsCreated</dd>
            <dt class="col-sm-3">@Localizer["Org_Imp_AsgUpdated"]</dt><dd class="col-sm-9">@Model.AssignmentsUpdated</dd>
            <dt class="col-sm-3">@Localizer["Org_Imp_Unchanged"]</dt><dd class="col-sm-9">@Model.Unchanged</dd>
        </dl>
    </section>

    @if (Model.Errors.Count > 0)
    {
        <section class="vs-panel mb-3">
            <h2 class="vs-section__title text-danger"><i class="bi bi-x-octagon"></i> @Localizer["Org_Imp_Errors"] (@Model.Errors.Count)</h2>
            <ul class="small mb-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
        </section>
    }
    @if (Model.Warnings.Count > 0)
    {
        <section class="vs-panel mb-3">
            <h2 class="vs-section__title"><i class="bi bi-exclamation-triangle"></i> @Localizer["Org_Imp_Warnings"]</h2>
            <ul class="small mb-0">@foreach (var w in Model.Warnings) { <li>@w</li> }</ul>
        </section>
    }

    @if (!string.IsNullOrEmpty(token) && Model.Errors.Count == 0 && !committed)
    {
        <form asp-action="Confirm" method="post" data-pems-confirm="@Localizer["Org_Imp_ConfirmPrompt"]">
            <input type="hidden" name="token" value="@token" />
            <button class="vs-btn vs-btn--primary"><i class="bi bi-check-lg"></i> @Localizer["Org_Imp_Confirm"]</button>
        </form>
    }
    @if (committed)
    {
        <a class="vs-btn vs-btn--primary" asp-controller="Organization" asp-action="Index"><i class="bi bi-diagram-3"></i> @Localizer["Org_Title"]</a>
    }
</div>
