@model PEMS.Application.Organization.OrganizationImportResult
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var token = ViewBag.Token as string;
    var committed = Model.Committed;
}

<pems-page-shell kind="admin">
    <pems-flex gap="2" css="mb-3">
        <a class="vs-btn vs-btn--sm" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Org_Imp_Title"]</a>
    </pems-flex>

    @if (committed) { <pems-alert tone="success">@Localizer["Org_Imp_Committed"]</pems-alert> }
    else if (Model.Errors.Count > 0) { <pems-alert tone="danger">@Localizer["Org_Imp_Rejected"]</pems-alert> }
    else { <pems-alert tone="info">@Localizer["Org_Imp_ValidOk"]</pems-alert> }

    <section class="vs-panel mb-3">
        <pems-info-grid layout="rows" class="mb-0">
    <pems-info-item label="@Localizer["Org_Imp_PosCreated"]">@Model.PositionsCreated</pems-info-item>
    <pems-info-item label="@Localizer["Org_Imp_PosUpdated"]">@Model.PositionsUpdated</pems-info-item>
    <pems-info-item label="@Localizer["Org_Imp_AsgCreated"]">@Model.AssignmentsCreated</pems-info-item>
    <pems-info-item label="@Localizer["Org_Imp_AsgUpdated"]">@Model.AssignmentsUpdated</pems-info-item>
    <pems-info-item label="@Localizer["Org_Imp_Unchanged"]">@Model.Unchanged</pems-info-item>
</pems-info-grid>
    </section>

    @if (Model.Errors.Count > 0)
    {
        <section class="vs-panel mb-3">
            <h2 class="vs-section__title text-danger"><pems-icon name="bi-x-octagon" /> @Localizer["Org_Imp_Errors"] (@Model.Errors.Count)</h2>
            <ul class="small mb-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
        </section>
    }
    @if (Model.Warnings.Count > 0)
    {
        <section class="vs-panel mb-3">
            <h2 class="vs-section__title"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Org_Imp_Warnings"]</h2>
            <ul class="small mb-0">@foreach (var w in Model.Warnings) { <li>@w</li> }</ul>
        </section>
    }

    @if (!string.IsNullOrEmpty(token) && Model.Errors.Count == 0 && !committed)
    {
        <form asp-action="Confirm" method="post" data-pems-confirm="@Localizer["Org_Imp_ConfirmPrompt"]">
            <input type="hidden" name="token" value="@token" />
            <button class="vs-btn vs-btn--primary"><pems-icon name="bi-check-lg" /> @Localizer["Org_Imp_Confirm"]</button>
        </form>
    }
    @if (committed)
    {
        <a class="vs-btn vs-btn--primary" asp-controller="Organization" asp-action="Index"><pems-icon name="bi-diagram-3" /> @Localizer["Org_Title"]</a>
    }
</pems-page-shell>
