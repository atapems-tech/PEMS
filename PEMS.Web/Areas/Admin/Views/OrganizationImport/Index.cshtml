@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-page-shell kind="admin">
    <div class="admin-hero">
        <p>@Localizer["Org_Imp_Intro"]</p>
    </div>
    @if (TempData["Message"] != null) { <pems-alert tone="success">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger">@TempData["Error"]</pems-alert> }

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><pems-icon name="bi-file-earmark-arrow-up" /> @Localizer["Org_Imp_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Imp_Columns"]</p>
        <p class="small"><code>Department, Position, PositionCode, PositionTitle, ParentPositionCode, EmployeePersonnelCode, IsPrimary, AssignmentType, EffectiveFrom, EffectiveTo</code></p>
        <form asp-action="Validate" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
            <pems-col md="6">
                <pems-label for="orgImpFile">@Localizer["IC_ChooseFile"]</pems-label>
                <pems-input scale="small" id="orgImpFile" type="file" name="file" accept=".xlsx" required />
            </pems-col>
            <pems-col span="auto"><button class="vs-btn vs-btn--primary vs-btn--sm"><pems-icon name="bi-check2-circle" /> @Localizer["Org_Imp_Validate"]</button></pems-col>
            <pems-col span="auto"><a class="vs-btn vs-btn--sm" asp-action="Template"><pems-icon name="bi-download" /> @Localizer["Org_Imp_Template"]</a></pems-col>
        </pems-row></form>
        <p class="small text-muted mt-2 mb-0">@Localizer["Org_Imp_Rules"]</p>
    </section>
</pems-page-shell>
