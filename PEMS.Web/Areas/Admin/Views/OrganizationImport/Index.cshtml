@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="admin-page-shell">
    <div class="admin-hero">
        <p>@Localizer["Org_Imp_Intro"]</p>
    </div>
    @if (TempData["Message"] != null) { <div class="alert alert-success" role="status">@TempData["Message"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }

    <section class="vs-panel mb-3">
        <h2 class="vs-section__title"><i class="bi bi-file-earmark-arrow-up"></i> @Localizer["Org_Imp_Title"]</h2>
        <p class="small text-muted">@Localizer["Org_Imp_Columns"]</p>
        <p class="small"><code>Department, Position, PositionCode, PositionTitle, ParentPositionCode, EmployeePersonnelCode, IsPrimary, AssignmentType, EffectiveFrom, EffectiveTo</code></p>
        <form asp-action="Validate" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="orgImpFile">@Localizer["IC_ChooseFile"]</label>
                <input id="orgImpFile" type="file" name="file" class="form-control form-control-sm" accept=".xlsx" required />
            </div>
            <div class="col-auto"><button class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-check2-circle"></i> @Localizer["Org_Imp_Validate"]</button></div>
            <div class="col-auto"><a class="vs-btn vs-btn--sm" asp-action="Template"><i class="bi bi-download"></i> @Localizer["Org_Imp_Template"]</a></div>
        </form>
        <p class="small text-muted mt-2 mb-0">@Localizer["Org_Imp_Rules"]</p>
    </section>
</div>
