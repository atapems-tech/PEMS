@model PcAdminViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var ov = Model.Overview;
    var empUrl = "/Warehouse/PartCatalogueAdmin/Employees";
    var allConds = PEMS.Domain.Entities.PartCatalogueConditions.All;
    var poolSteps = ov.Steps.Where(s => s.Source == "AssignedPool").ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
}

<pems-page-shell kind="workspace" css="pc-page" data-pc-lookup-base="/Warehouse/PartCatalogueLookup" data-txt-no-results="@Localizer["Pc_Lookup_NoResults"]" data-txt-search="@Localizer["Pc_Lookup_Search"]">
    <nav class="vs-subnav" aria-label="@Localizer["Pc_Menu"]">
        <a asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Index">@Localizer["Pc_Menu"]</a>
        <a asp-area="Warehouse" asp-controller="PartCatalogueAdmin" asp-action="Index" class="active" aria-current="page">@Localizer["Pc_Title_Admin"]</a>
    </nav>

    @* ---------------------------------------------------- Part No generation (فاز ۱: فقط پرچم تنظیمات) *@
    <section class="vs-panel pc-card" id="pc-partno-settings">
        <h2 class="vs-section__title"><pems-icon name="bi-hash" /> @Localizer["Pc_Adm_PartNoTitle"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_PartNoHint"]</p>
        <form asp-action="SaveSettings" method="post"><pems-row gap="3" css="align-items-start">
            @if (Model.Settings.RowVersion != null) { <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.Settings.RowVersion)" /> }
            <pems-col md="4">
                <pems-label for="pc_partNoMethod">@Localizer["Pc_Adm_PartNoMethod"]</pems-label>
                <pems-select scale="small" id="pc_partNoMethod" name="partNoGenerationMethod">
                    <option value="MANUAL" selected="@(Model.Settings.PartNoGenerationMethod == "MANUAL")">@Localizer["Pc_Adm_PartNoManual"]</option>
                    <option value="API" selected="@(Model.Settings.PartNoGenerationMethod == "API")">@Localizer["Pc_Adm_PartNoApi"]</option>
                </pems-select>
            </pems-col>
            <pems-col md="4">
                <pems-label for="pc_partNoFormat">@Localizer["Pc_Adm_PartNoFormat"]</pems-label>
                <pems-input scale="small" id="pc_partNoFormat" name="partNoFormat" maxlength="50" autocomplete="off" value="@Model.Settings.PartNoFormat" placeholder="PCR-YYYY-NNNN" />
                <pems-help-text>@Localizer["Pc_Adm_PartNoFormatHelp"]</pems-help-text>
            </pems-col>
            <pems-col span="auto" css="pt-md-4">
                <button type="submit" class="vs-btn vs-btn--sm vs-btn--primary mt-md-1"><pems-icon name="bi-check2" /> @Localizer["Save"]</button>
            </pems-col>
        </pems-row></form>
        <pems-alert tone="info" css="small py-2 mt-3 mb-0"><pems-icon name="bi-info-circle" /> @Localizer["Pc_Adm_PartNoNote"]</pems-alert>
        @if (Model.Settings.IsPersisted && Model.Settings.ModifiedDate.HasValue)
        {
            <div class="small text-muted mt-2">@Localizer["Pc_Adm_PartNoModified"]: @Model.Settings.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(Model.Settings.ModifiedBy) ? "" : " · " + Model.Settings.ModifiedBy)</div>
        }
    </section>

    @* ---------------------------------------------------- Import *@
    <section class="vs-panel pc-card">
        <h2 class="vs-section__title"><pems-icon name="bi-cloud-arrow-up" /> @Localizer["Pc_Adm_Import"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_ImportHint"]</p>
        <pems-row gap="3">
            @foreach (var kind in new[] { "TechnicalClass", "CommodityGroup", "ProductFamily", "Manufacturer", "Supplier" })
            {
                <pems-col md="6" xl="4">
                    <form asp-action="Import" method="post" enctype="multipart/form-data" class="border rounded p-2 h-100">
                        <input type="hidden" name="kind" value="@kind" />
                        <pems-flex justify="between"><strong>@Localizer["Pc_Imp_" + kind]</strong><span class="vs-pill vs-pill--neutral">@(ov.Counts.TryGetValue(kind, out var c) ? c : 0)</span></pems-flex>
                        <pems-input scale="small" css="my-2" type="file" name="file" accept=".xlsx" required aria-label="@Localizer["Pc_Imp_" + kind]" />
                        <button type="submit" class="vs-btn vs-btn--sm vs-btn--primary"><pems-icon name="bi-upload" /> @Localizer["Pc_Adm_ImportBtn"]</button>
                    </form>
                </pems-col>
            }
        </pems-row>
    </section>

    @* ---------------------------------------------------- Workflow (PEMS.WorkflowPlatform) *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-signpost-split" /> @Localizer["Pc_Adm_Steps"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_StepsHint"] <a asp-area="Admin" asp-controller="WorkflowManagement" asp-action="Index">@Localizer["Pc_Adm_OpenWorkflowDesigner"]</a></p>
        <div class="pc-table-scroll">
            <pems-data-table data="@(DataRows.Of(ov.WorkflowStages, c_ => c_.Add(((Localizer["Pc_Col_Order"])?.ToString() ?? ""), st => (object?)(st.Order), css: "vs-num").Add(((Localizer["Pc_Col_Step"])?.ToString() ?? ""), st => (object?)(Localizer["Pc_Step_" + st.Name])).Add(((Localizer["Pc_Adm_Responsibility"])?.ToString() ?? ""), st => (object?)(st.ResponsibilityKey), kind: DataCellKind.Code).Add(((Localizer["Pc_Col_Condition"])?.ToString() ?? ""), st => (object?)(string.IsNullOrEmpty(st.EntryCondition) ? Localizer["Pc_Cond_Always"].Value : st.EntryCondition))))" enterprise="false" dense="true" css="table-enterprise vs-dense mb-0" />
            @if (!ov.WorkflowStages.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Adm_NoWorkflow"]</div> }
        </div>
    </section>

    @* ---------------------------------------------------- Data quality *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-clipboard2-pulse" /> @Localizer["Pc_Adm_DataQuality"]</h2>
        <div class="pc-table-scroll">
            <pems-table scale="small" css="table-enterprise vs-dense mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Pc_Adm_Severity"]</pems-table-header><pems-table-header>@Localizer["Pc_Adm_Responsibility"]</pems-table-header><pems-table-header>@Localizer["Pc_Adm_Finding"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                @foreach (var f in ov.Findings.OrderBy(x => x.Severity).ThenBy(x => x.ResponsibilityKey))
                {
                    <pems-table-row>
                        <pems-table-cell><span class="vs-pill @(f.Severity == "P1" ? "vs-pill--danger" : f.Severity == "P2" ? "vs-pill--warning" : "vs-pill--neutral")">@f.Severity</span></pems-table-cell>
                        <pems-table-cell><code>@f.ResponsibilityKey</code></pems-table-cell>
                        <pems-table-cell>@f.Message <span class="text-muted small">(@f.Code)</span></pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-table>
            @if (!ov.Findings.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Adm_NoFindings"]</div> }
        </div>
    </section>

    @* ---------------------------------------------------- Responsibilities *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-person-badge" /> @Localizer["Pc_Adm_Responsibilities"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_ResponsibilitiesHint"]</p>
        <pems-row gap="3">
        @foreach (var r in ov.Responsibilities)
        {
            var fid = "respForm" + r.Id;
            <pems-col xl="6">
                <form id="@fid" asp-action="SaveResponsibility" method="post" class="border rounded p-2 h-100">
                    <input type="hidden" name="Id" value="@r.Id" />
                    <pems-flex justify="between" align="center" css="mb-2">
                        <strong>@Localizer["Pc_Step_" + r.Key] <code class="ms-1">@r.Key</code></strong>
                        <label class="small"><input type="checkbox" name="IsActive" value="true" checked="@r.IsActive" /> @Localizer["Pc_Col_Active"]<input type="hidden" name="IsActive" value="false" /></label>
                    </pems-flex>
                    <pems-row gap="2">
                        <pems-col md="6">
                            <pems-label css="small mb-0" for="@(fid)_kind">@Localizer["Pc_Adm_Kind"]</pems-label>
                            <pems-select scale="small" id="@(fid)_kind" name="Kind">
                                @foreach (var k in new[] { "AssignmentPool", "PositionScope", "RequesterManager", "CommodityPosition" }) { <option value="@k" selected="@(r.Kind == k)">@Localizer["Pc_ResKind_" + k]</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label css="small mb-0" for="@(fid)_act">@Localizer["Pc_Adm_RequiredAction"]</pems-label>
                            <pems-select scale="small" id="@(fid)_act" name="RequiredAction">
                                <option value="" selected="@string.IsNullOrEmpty(r.RequiredAction)"></option>
                                @foreach (var a in new[] { "Review", "Approve" }) { <option value="@a" selected="@(r.RequiredAction == a)">@a</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label css="small mb-0" for="@(fid)_pos">@Localizer["Pc_Adm_Positions"]</pems-label>
                            <pems-select scale="small" id="@(fid)_pos" multiple size="4" data-pc-pos-target="@(fid)_posIds">
                                @foreach (var p in ov.Positions) { <option value="@p.Id" selected="@(r.Positions.Any(x => x.PositionId == p.Id))">@p.Text</option> }
                            </pems-select>
                            <input type="hidden" name="PositionIds" id="@(fid)_posIds" value="@string.Join(",", r.Positions.Select(x => x.PositionId))" />
                            <pems-help-text>@Localizer["Pc_Adm_PositionsHint"]</pems-help-text>
                        </pems-col>
                        <pems-col md="6">
                            <pems-label css="small mb-0" for="@(fid)_role">@Localizer["Pc_Adm_Role"]</pems-label>
                            <pems-select scale="small" id="@(fid)_role" name="RoleName">
                                <option value="" selected="@string.IsNullOrEmpty(r.RoleName)"></option>
                                @foreach (var role in ov.Roles) { <option value="@role" selected="@(string.Equals(r.RoleName, role, StringComparison.OrdinalIgnoreCase))">@role</option> }
                            </pems-select>
                            <pems-label css="small mb-0 mt-1" for="@(fid)_ml">@Localizer["Pc_Adm_ManagerLevel"]</pems-label>
                            <pems-select scale="small" id="@(fid)_ml" name="ManagerLevel">
                                <option value=""></option>
                                <option value="1" selected="@(r.ManagerLevel == 1)">1</option><option value="2" selected="@(r.ManagerLevel == 2)">2</option>
                            </pems-select>
                        </pems-col>
                        <pems-col md="4">
                            <pems-label css="small mb-0" for="@(fid)_st">@Localizer["Pc_Adm_ScopeType"]</pems-label>
                            <pems-select scale="small" id="@(fid)_st" name="ScopeType">
                                @foreach (var st in new[] { "None", "Department", "Discipline", "MaintenanceGroup", "Team" }) { <option value="@st" selected="@(r.ScopeType == st)">@Localizer["Pc_Scope_" + st]</option> }
                            </pems-select>
                        </pems-col>
                        <pems-col md="4">
                            <pems-label css="small mb-0" for="@(fid)_sv">@Localizer["Pc_Adm_ScopeValue"]</pems-label>
                            <pems-input scale="small" id="@(fid)_sv" name="ScopeValue" value="@r.ScopeValue" placeholder="@Localizer["Pc_Adm_ScopeValueHint"]" />
                        </pems-col>
                        <pems-col md="4">
                            <pems-label css="small mb-0" for="@(fid)_sel">@Localizer["Pc_Adm_Strategy"]</pems-label>
                            <pems-select scale="small" id="@(fid)_sel" name="SelectionStrategy">
                                @foreach (var st in new[] { "Queue", "SingleActor" }) { <option value="@st" selected="@(r.Strategy == st)">@Localizer["Pc_Strategy_" + st]</option> }
                            </pems-select>
                        </pems-col>
                    </pems-row>
                    <pems-flex gap="2" css="mt-2">
                        <button type="submit" class="vs-btn vs-btn--sm vs-btn--primary"><pems-icon name="bi-save" /> @Localizer["Pc_Btn_Save"]</button>
                        <button type="button" class="vs-btn vs-btn--sm" data-pc-preview="@r.Key"><pems-icon name="bi-search" /> @Localizer["Pc_Adm_Diagnose"]</button>
                    </pems-flex>
                </form>
            </pems-col>
        }
        </pems-row>

        <h3 class="h6 mt-3">@Localizer["Pc_Adm_Diagnose"]</h3>
        <pems-row gap="2" css="align-items-start">
            <pems-col md="4"><pems-label css="small mb-0" for="pcPrevKey">@Localizer["Pc_Adm_Responsibility"]</pems-label>
                <pems-select scale="small" id="pcPrevKey">@foreach (var r in ov.Responsibilities) { <option value="@r.Key">@Localizer["Pc_Step_" + r.Key]</option> }</pems-select></pems-col>
            <pems-col md="4"><pems-label css="small mb-0" for="pcPrevReq_text">@Localizer["Pc_F_Requester"]</pems-label><div class="pc-lookup" data-url="@empUrl" data-name="requesterEmployeeId" data-input-id="pcPrevReq_text" data-form="pcNoForm" id="pcPrevReqHost"></div></pems-col>
            <pems-col md="4"><pems-label css="small mb-0" for="pcPrevGrp_text">@Localizer["Pc_F_CommodityGroup1Id"]</pems-label><div class="pc-lookup" data-url="/Warehouse/PartCatalogueAdmin/CommodityGroups" data-name="commodityGroupId" data-input-id="pcPrevGrp_text" data-form="pcNoForm" id="pcPrevGrpHost"></div></pems-col>
        </pems-row>
        <div id="pcPreviewOut" class="mt-2" aria-live="polite"></div>
    </section>

    @* ---------------------------------------------------- Commodity responsibility *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-boxes" /> @Localizer["Pc_Adm_CommodityResp"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_CommodityRespHint"]</p>
        <form asp-action="AddCommodityResponsible" method="post"><pems-row gap="2" css="align-items-start mb-2">
            <pems-col md="3"><pems-label css="small mb-0" for="cr_key">@Localizer["Pc_Adm_Responsibility"]</pems-label>
                <pems-select scale="small" id="cr_key" name="responsibilityKey">@foreach (var r in ov.Responsibilities.Where(x => x.Kind == "CommodityPosition")) { <option value="@r.Key">@Localizer["Pc_Step_" + r.Key]</option> }</pems-select></pems-col>
            <pems-col md="3"><pems-label css="small mb-0" for="cr_grp_text">@Localizer["Pc_F_CommodityGroup1Id"]</pems-label><div class="pc-lookup" data-url="/Warehouse/PartCatalogueAdmin/CommodityGroups" data-name="commodityGroupId" data-input-id="cr_grp_text"></div></pems-col>
            <pems-col md="3"><pems-label css="small mb-0" for="cr_pos">@Localizer["Pc_Adm_Position"]</pems-label>
                <pems-select scale="small" id="cr_pos" name="positionId"><option value=""></option>@foreach (var p in ov.Positions) { <option value="@p.Id">@p.Text</option> }</pems-select></pems-col>
            <pems-col md="3"><pems-label css="small mb-0" for="cr_emp_text">@Localizer["Pc_Adm_EmployeeOverride"]</pems-label><div class="pc-lookup" data-url="@empUrl" data-name="employeeId" data-input-id="cr_emp_text"></div></pems-col>
            <pems-col span="12"><button class="vs-btn vs-btn--sm vs-btn--primary"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddGroup"]</button></pems-col>
        </pems-row></form>
        <div class="pc-table-scroll">
            <pems-table scale="small" css="table-enterprise vs-dense mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Pc_Adm_Responsibility"]</pems-table-header><pems-table-header>@Localizer["Pc_F_CommodityGroup1Id"]</pems-table-header><pems-table-header>@Localizer["Pc_Adm_Position"]</pems-table-header><pems-table-header>@Localizer["Pc_Adm_EmployeeOverride"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                @foreach (var c in ov.CommodityResponsibles.Where(x => x.IsActive))
                {
                    <pems-table-row><pems-table-cell><code>@c.ResponsibilityKey</code></pems-table-cell><pems-table-cell>@c.GroupText</pems-table-cell><pems-table-cell>@c.PositionTitle</pems-table-cell><pems-table-cell>@c.EmployeeName</pems-table-cell>
                        <pems-table-cell class="text-end"><form asp-action="RemoveCommodityResponsible" method="post" class="d-inline"><input type="hidden" name="id" value="@c.Id" /><button class="vs-icon-btn" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-trash" /></button></form></pems-table-cell></pems-table-row>
                }
                </pems-table-body>
            </pems-table>
            @if (!ov.CommodityResponsibles.Any(x => x.IsActive)) { <div class="vs-empty py-2">@Localizer["Pc_Adm_NoCommodityResp"]</div> }
        </div>
    </section>

    @* ---------------------------------------------------- Approvers *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-people" /> @Localizer["Pc_Adm_Approvers"] <span class="vs-pill vs-pill--neutral">@Localizer["Pc_Adm_Legacy"]</span></h2>
        <p class="small text-muted">@Localizer["Pc_Adm_ApproversHint"]</p>
        <pems-row gap="3">
            @foreach (var st in poolSteps)
            {
                <pems-col md="6" xl="4">
                    <div class="border rounded p-2 h-100">
                        <strong>@Localizer["Pc_Step_" + st.StepKey]</strong>
                        <ul class="list-unstyled small my-2">
                            @foreach (var ap in st.Approvers)
                            {
                                <pems-flex as="li" justify="between" align="center">@ap.EmployeeName
                                    <form asp-action="RemoveApprover" method="post" class="d-inline"><input type="hidden" name="assignmentId" value="@ap.Id" /><button class="vs-icon-btn" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-x-lg" /></button></form>
                                </pems-flex>
                            }
                            @if (!st.Approvers.Any()) { <li class="text-danger">@Localizer["Pc_Adm_NoApprovers"]</li> }
                        </ul>
                        <form asp-action="AddApprover" method="post"><pems-flex gap="2" align="start">
                            <input type="hidden" name="stepKey" value="@st.StepKey" />
                            <div class="pc-lookup flex-grow-1" data-url="@empUrl" data-name="employeeId" data-input-id="@("emp_" + st.StepKey)"></div>
                            <button class="vs-btn vs-btn--sm"><pems-icon name="bi-plus-lg" /></button>
                        </pems-flex></form>
                    </div>
                </pems-col>
            }
        </pems-row>
    </section>

    @* ---------------------------------------------------- Direct Manager = Organization hierarchy (not module-local) *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-diagram-2" /> @Localizer["Pc_Adm_OrgHierarchyTitle"]</h2>
        <p class="small text-muted mb-2">@Localizer["Pc_Adm_OrgHierarchyBody"]</p>
        <a class="vs-btn vs-btn--sm" asp-area="Admin" asp-controller="Organization" asp-action="Index"><pems-icon name="bi-diagram-3" /> @Localizer["Org_Title"]</a>
        <a class="vs-btn vs-btn--sm" asp-area="Admin" asp-controller="Organization" asp-action="Diagnostics"><pems-icon name="bi-heart-pulse" /> @Localizer["Org_Diag_Title"]</a>
    </section>

    @* ---------------------------------------------------- Sections *@
    <section class="vs-panel pc-card mt-3">
        <h2 class="vs-section__title"><pems-icon name="bi-ui-checks-grid" /> @Localizer["Pc_Adm_Sections"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_SectionsHint"]</p>
        <div class="pc-table-scroll">
            <pems-table scale="small" css="table-enterprise vs-dense mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Pc_F_SectionId"]</pems-table-header><pems-table-header>@Localizer["Pc_Adm_SpareReview"]</pems-table-header><pems-table-header>@Localizer["Pc_Col_Active"]</pems-table-header><pems-table-header></pems-table-header><pems-table-header>@Localizer["Pc_Adm_AllowedGroups"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                @foreach (var s in ov.Sections)
                {
                    var fid = "secForm" + s.SectionId;
                    <pems-table-row>
                        <pems-table-cell>@s.Code @if (!string.IsNullOrEmpty(s.NameFa)) { <span class="text-muted small">(@s.NameFa)</span> } @if (s.RoutingNeedsConfirmation) { <span class="vs-pill vs-pill--warning" title="@Localizer["Pc_Adm_NeedsConfirmation"]">@Localizer["Pc_Adm_NeedsConfirmationShort"]</span> }</pems-table-cell>
                        <pems-table-cell><input form="@fid" type="checkbox" name="requiresSparePartsReview" value="true" checked="@s.RequiresSparePartsReview" aria-label="@Localizer["Pc_Adm_SpareReview"]" /><input form="@fid" type="hidden" name="requiresSparePartsReview" value="false" /></pems-table-cell>
                        <pems-table-cell><input form="@fid" type="checkbox" name="isActive" value="true" checked="@s.IsActive" aria-label="@Localizer["Pc_Col_Active"]" /><input form="@fid" type="hidden" name="isActive" value="false" /></pems-table-cell>
                        <pems-table-cell><form id="@fid" asp-action="SetSection" method="post"><input type="hidden" name="sectionId" value="@s.SectionId" /><button class="vs-btn vs-btn--sm"><pems-icon name="bi-save" /></button></form></pems-table-cell>
                        <pems-table-cell>
                            @foreach (var g in s.Groups)
                            {
                                <form asp-action="RemoveSectionGroup" method="post" class="d-inline"><input type="hidden" name="mapId" value="@g.MapId" />
                                    <button class="vs-pill vs-pill--neutral border-0" title="@Localizer["Pc_Btn_Remove"]">@g.GroupText @if (g.NeedsConfirmation) { <pems-icon name="bi-question-circle" aria-hidden="true" /> } <pems-icon name="bi-x" aria-hidden="true" /></button></form>
                            }
                            @if (!s.Groups.Any()) { <span class="text-muted small">@Localizer["Pc_Adm_AllGroups"]</span> }
                            <form class="ms-2" asp-action="AddSectionGroup" method="post"><pems-flex inline="true" gap="1" align="start">
                                <input type="hidden" name="sectionId" value="@s.SectionId" />
                                <div class="pc-lookup pc-lookup-sm" data-url="/Warehouse/PartCatalogueAdmin/CommodityGroups" data-name="commodityGroupId" data-input-id="@("grp_" + s.SectionId)"></div>
                                <button class="vs-icon-btn" title="@Localizer["Pc_Btn_AddGroup"]" aria-label="@Localizer["Pc_Btn_AddGroup"]"><pems-icon name="bi-plus-lg" /></button>
                            </pems-flex></form>
                        </pems-table-cell>
                    </pems-table-row>
                }
                </pems-table-body>
            </pems-table>
        </div>
    </section>

    @* ---------------------------------------------------- Group1 → Group2 *@
    <section class="vs-panel pc-card mt-3 mb-4">
        <h2 class="vs-section__title"><pems-icon name="bi-diagram-3" /> @Localizer["Pc_Adm_Group2Maps"]</h2>
        <p class="small text-muted">@Localizer["Pc_Adm_Group2Hint"]</p>
        <form asp-action="AddGroupChild" method="post"><pems-row gap="2" css="align-items-start mb-2">
            <pems-col md="5"><pems-label for="g2_parent_text">@Localizer["Pc_F_CommodityGroup1Id"]</pems-label><div class="pc-lookup" data-url="/Warehouse/PartCatalogueAdmin/CommodityGroups" data-name="parentGroupId" data-input-id="g2_parent_text"></div></pems-col>
            <pems-col md="5"><pems-label for="g2_child_text">@Localizer["Pc_F_CommodityGroup2Id"]</pems-label><div class="pc-lookup" data-url="/Warehouse/PartCatalogueAdmin/CommodityGroups" data-name="childGroupId" data-input-id="g2_child_text"></div></pems-col>
            <pems-col md="2" css="pt-4"><button class="vs-btn vs-btn--sm vs-btn--primary"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddGroup"]</button></pems-col>
        </pems-row></form>
        <div class="pc-table-scroll">
            <pems-table scale="small" css="table-enterprise vs-dense mb-0">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Pc_F_CommodityGroup1Id"]</pems-table-header><pems-table-header>@Localizer["Pc_F_CommodityGroup2Id"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                @foreach (var m in ov.Group2Maps)
                {
                    <pems-table-row><pems-table-cell>@m.Parent</pems-table-cell><pems-table-cell>@m.Child</pems-table-cell>
                        <pems-table-cell class="text-end"><form asp-action="RemoveGroupChild" method="post" class="d-inline"><input type="hidden" name="mapId" value="@m.Id" /><button class="vs-icon-btn" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-trash" /></button></form></pems-table-cell></pems-table-row>
                }
                </pems-table-body>
            </pems-table>
            @if (!ov.Group2Maps.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Adm_AllGroups"]</div> }
        </div>
    </section>
</pems-page-shell>

<form id="pcNoForm" onsubmit="return false"></form>

@section Scripts {
    <pems-script-templates set="part-catalogue"></pems-script-templates>
    <script src="~/js/pems-part-catalogue.js" asp-append-version="true"></script>
}
