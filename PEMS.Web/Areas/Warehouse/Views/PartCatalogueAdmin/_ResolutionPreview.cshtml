@model PEMS.Application.ActorResolution.ActorResolutionResult
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="border rounded p-2">
    <pems-form-group css="mb-1">
        <strong>@Localizer["Pc_Adm_ResolutionState"]:</strong>
        <span class="vs-pill @(Model.IsUsable ? "vs-pill--success" : Model.State == "NOT_APPLICABLE" ? "vs-pill--neutral" : "vs-pill--danger")">@Model.State</span>
        <span class="text-muted small ms-2">@Localizer["Pc_Adm_Strategy"]: @Model.Strategy</span>
        @if (!string.IsNullOrEmpty(Model.SkipReason)) { <span class="text-muted small ms-2">(@Model.SkipReason)</span> }
        @if (!string.IsNullOrEmpty(Model.Detail)) { <div class="small text-muted">@Model.Detail</div> }
    </pems-form-group>

    <pems-row gap="2">
        <pems-col md="6">
            <pems-heading level="4" class="h6">@Localizer["Pc_Adm_Eligible"] (@Model.Candidates.Count)</pems-heading>
            <pems-bullet-list class="list-unstyled small mb-0">
                @foreach (var c in Model.Candidates)
                {
                    var selected = Model.SelectedEmployeeIds.Contains(c.EmployeeId);
                    <pems-bullet>@c.EmployeeName <span class="text-muted">- @c.Reason</span> @if (selected) { <pems-icon name="bi-check-circle" css="text-success" aria-hidden="true" /> }</pems-bullet>
                }
                @if (!Model.Candidates.Any()) { <pems-bullet class="text-muted">-</pems-bullet> }
            </pems-bullet-list>
        </pems-col>
        <pems-col md="6">
            <pems-heading level="4" class="h6">@Localizer["Pc_Adm_Excluded"] (@Model.Excluded.Count)</pems-heading>
            <pems-bullet-list class="list-unstyled small mb-0">
                @foreach (var x in Model.Excluded)
                {
                    <pems-bullet>@x.EmployeeName <span class="vs-pill vs-pill--warning">@x.Code</span> <span class="text-muted">@x.Detail</span></pems-bullet>
                }
                @if (!Model.Excluded.Any()) { <pems-bullet class="text-muted">-</pems-bullet> }
            </pems-bullet-list>
        </pems-col>
    </pems-row>
</div>
