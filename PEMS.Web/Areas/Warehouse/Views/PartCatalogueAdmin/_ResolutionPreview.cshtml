@model PEMS.Application.ActorResolution.ActorResolutionResult
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="border rounded p-2">
    <div class="mb-1">
        <strong>@Localizer["Pc_Adm_ResolutionState"]:</strong>
        <span class="vs-pill @(Model.IsUsable ? "vs-pill--success" : Model.State == "NOT_APPLICABLE" ? "vs-pill--neutral" : "vs-pill--danger")">@Model.State</span>
        <span class="text-muted small ms-2">@Localizer["Pc_Adm_Strategy"]: @Model.Strategy</span>
        @if (!string.IsNullOrEmpty(Model.SkipReason)) { <span class="text-muted small ms-2">(@Model.SkipReason)</span> }
        @if (!string.IsNullOrEmpty(Model.Detail)) { <div class="small text-muted">@Model.Detail</div> }
    </div>

    <div class="row g-2">
        <div class="col-md-6">
            <h4 class="h6">@Localizer["Pc_Adm_Eligible"] (@Model.Candidates.Count)</h4>
            <ul class="list-unstyled small mb-0">
                @foreach (var c in Model.Candidates)
                {
                    var selected = Model.SelectedEmployeeIds.Contains(c.EmployeeId);
                    <li>@c.EmployeeName <span class="text-muted">- @c.Reason</span> @if (selected) { <i class="bi bi-check-circle text-success" aria-hidden="true"></i> }</li>
                }
                @if (!Model.Candidates.Any()) { <li class="text-muted">-</li> }
            </ul>
        </div>
        <div class="col-md-6">
            <h4 class="h6">@Localizer["Pc_Adm_Excluded"] (@Model.Excluded.Count)</h4>
            <ul class="list-unstyled small mb-0">
                @foreach (var x in Model.Excluded)
                {
                    <li>@x.EmployeeName <span class="vs-pill vs-pill--warning">@x.Code</span> <span class="text-muted">@x.Detail</span></li>
                }
                @if (!Model.Excluded.Any()) { <li class="text-muted">-</li> }
            </ul>
        </div>
    </div>
</div>
