@model PEMS.Application.Interfaces.PartCatalogueDetailsDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model;
    var f = d.Form;
    var a = d.Actions;
    string L(string key) => Localizer["Pc_F_" + key].Value;
    string Label(string key) => d.Labels.TryGetValue(key, out var v) ? v : "";
    string YesNo(bool v) => v ? Localizer["Pc_Yes"].Value : Localizer["Pc_No"].Value;
    var rowVersion = d.RowVersion is { Length: > 0 } ? Convert.ToBase64String(d.RowVersion) : null;
    var warningTemp = TempData["Warning"] as string;
    const string FftName = "FREE FORMAT TEXT";
    var fft = f.Attributes.FirstOrDefault(x => string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase))?.Value?.Trim();

    string StatusPill(string status) => status switch
    {
        "Draft" => "vs-pill--neutral",
        "InApproval" => "vs-pill--info",
        "Returned" => "vs-pill--warning",
        "OrgResolution" => "vs-pill--warning",
        "Completed" => "vs-pill--success",
        _ => "vs-pill--danger"
    };
    string StepPill(string status) => status switch
    {
        "Approved" => "vs-pill--success",
        "Active" => "vs-pill--info",
        "Skipped" => "vs-pill--neutral",
        _ => "vs-pill--neutral"
    };
    string SkipText(string? reason)
    {
        if (string.IsNullOrEmpty(reason)) return "";
        var key = "Pc_Skip_" + reason.Replace(':', '_');
        var t = Localizer[key];
        return t.ResourceNotFound ? reason : t.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
}

<pems-page-shell kind="workspace" css="pc-page">
    <div class="vs-doc-head">
        <pems-flex wrap="true" align="center" gap="2">
            <h2 class="pems-page-title mb-0">@(string.IsNullOrEmpty(d.RequestNumber) ? "#" + d.Id : d.RequestNumber)</h2>
            <span class="vs-pill vs-pill--info">@Localizer["Pc_Type_" + d.RequestType]</span>
            <span class="vs-pill vs-pill--icon @StatusPill(d.Status)">@Localizer["Pc_Status_" + d.Status]</span>
            @if (f.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Pc_Urgent"]</span> }
            @if (!string.IsNullOrEmpty(d.AssignedPartNumber)) { <span class="vs-pill vs-pill--success">@Localizer["Pc_Col_PartNo"]: @d.AssignedPartNumber</span> }
        </pems-flex>
        <div class="small text-muted mt-1">
            @L("Requester"): @d.RequesterName · @Localizer["Pc_Col_Created"]: @d.CreatedDate.ToString("yyyy-MM-dd")
            @if (d.SubmittedDate.HasValue) { <text> · @Localizer["Pc_Col_Submitted"]: @d.SubmittedDate.Value.ToString("yyyy-MM-dd")</text> }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(warningTemp)) { <pems-alert tone="warning" css="small">@warningTemp</pems-alert> }

    <div class="vs-toolbar">
        <a asp-action="Index" class="vs-btn vs-btn--sm"><pems-icon name="bi-arrow-left" /> @Localizer["Pc_Btn_Back"]</a>
        @if (a.CanEdit) { <a asp-action="Edit" asp-route-id="@d.Id" class="vs-btn vs-btn--primary vs-btn--sm"><pems-icon name="bi-pencil" /> @Localizer["Pc_Btn_Edit"]</a> }
        <div class="vs-toolbar__end">
            <a asp-action="ExportXlsx" asp-route-id="@d.Id" class="vs-btn vs-btn--sm"><pems-icon name="bi-file-earmark-excel" /> @Localizer["Pc_Btn_Export_Xlsx"]</a>
            <a asp-action="ExportPdf" asp-route-id="@d.Id" class="vs-btn vs-btn--sm"><pems-icon name="bi-file-earmark-pdf" /> @Localizer["Pc_Btn_Export_Pdf"]</a>
        </div>
    </div>

    @* ---------------------------------------------------- Organization Resolution Required *@
    @if (a.IsOrganizationBlocked)
    {
        <section class="vs-panel pc-card border-warning" role="alert">
            <h2 class="vs-section__title"><pems-icon name="bi-diagram-3" /> @Localizer["Pc_Org_Blocked_Title"]</h2>
            <p class="mb-1">@Localizer["Pc_Org_Blocked_Body"]</p>
            @if (!string.IsNullOrEmpty(a.OrganizationBlockReason))
            {
                <p class="small text-muted mb-2"><strong>@a.OrganizationBlockReason</strong> — @Localizer["Org_Issue_" + a.OrganizationBlockReason]</p>
            }
            @if (a.CanRetryRouting)
            {
                <pems-form asp-action="RetryRouting" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@d.Id" />
                    @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
                    <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm"><pems-icon name="bi-arrow-repeat" /> @Localizer["Pc_Btn_RetryRouting"]</button>
                </pems-form>
            }
            <pems-help-text>@Localizer["Pc_Org_Blocked_Hint"]</pems-help-text>
        </section>
    }

    @* ---------------------------------------------------- اقدام گام جاری *@
    @if (a.CanApprove || a.CanReturn || a.CanCancel && d.Status == "InApproval")
    {
        <section class="vs-panel pc-card pc-action-panel">
            <h2 class="vs-section__title"><pems-icon name="bi-check2-square" /> @Localizer["Pc_Det_ActionPanel"]
                @if (!string.IsNullOrEmpty(a.ActiveStepKey)) { <span class="vs-pill vs-pill--info ms-2">@Localizer["Pc_Step_" + a.ActiveStepKey]</span> }
            </h2>
            @if (a.IsAdminOverride) { <pems-alert tone="warning" css="small py-1">@Localizer["Pc_Det_AdminOverride"]</pems-alert> }

            <pems-form asp-action="Execute" method="post"><pems-row gap="2" css="align-items-end">
                <input type="hidden" name="id" value="@d.Id" />
                @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
                @if (a.RequiresPartNumber)
                {
                    <pems-col md="3">
                        <pems-label for="pc_partNumber">@L("PartNumber") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-input scale="small" id="pc_partNumber" name="partNumber" maxlength="50" autocomplete="off" />
                        <pems-help-text>@Localizer["Pc_Hint_PartNumber"]</pems-help-text>
                    </pems-col>
                }
                <pems-col span="">
                    <pems-label for="pc_comment">@L("Comment")</pems-label>
                    <pems-input scale="small" id="pc_comment" name="comment" maxlength="2000" />
                    <pems-help-text>@Localizer["Pc_Hint_CommentRequired"]</pems-help-text>
                </pems-col>
                <pems-col span="auto" css="d-flex gap-2">
                    @if (a.CanApprove) { <button type="submit" name="action" value="Approve" class="vs-btn vs-btn--primary vs-btn--sm"><pems-icon name="bi-check-lg" /> @Localizer["Pc_Btn_Approve"]</button> }
                    @if (a.CanReturn) { <button type="submit" name="action" value="Return" class="vs-btn vs-btn--sm"><pems-icon name="bi-arrow-return-left" /> @Localizer["Pc_Btn_Return"]</button> }
                    @if (a.CanCancel) { <button type="submit" name="action" value="Cancel" class="vs-btn vs-btn--sm vs-btn--danger" data-pems-confirm="@Localizer["Pc_Confirm_Cancel"]"><pems-icon name="bi-x-circle" /> @Localizer["Pc_Btn_Cancel"]</button> }
                </pems-col>
            </pems-row></pems-form>
        </section>
    }
    else if (a.CanCancel)
    {
        <pems-form asp-action="Execute" method="post" class="mb-3" data-pems-confirm="@Localizer["Pc_Confirm_Cancel"]">
            <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="action" value="Cancel" />
            @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
            <button type="submit" class="vs-btn vs-btn--sm vs-btn--danger"><pems-icon name="bi-x-circle" /> @Localizer["Pc_Btn_Cancel"]</button>
        </pems-form>
    }

    <pems-row gap="3">
        <pems-col lg="8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-card-checklist" /> @Localizer["Pc_Sec_PartInfo"]</h2>
                <pems-info-grid layout="rows">
                    <pems-info-item label="@L("SectionId")">@Label("SectionId")</pems-info-item>
                    <pems-info-item label="@L("TechnicalClassId")">@Label("TechnicalClassId")</pems-info-item>
                    @* تعریف (Definition) کلاس فنی فقط برای راهنمایی هنگام تکمیل پیش‌نویس است؛ پس از ثبت (در جریان تأیید/برگشتی/تکمیل/لغو) نمایش داده نمی‌شود. *@
                    @if (d.Status == "Draft" && !string.IsNullOrEmpty(d.TechnicalClassLongDescription)) { <pems-info-item label="" value-class="small text-muted">@d.TechnicalClassLongDescription</pems-info-item> }
                    <pems-info-item label="@L("AssetType")">@Localizer["Pc_Asset_" + f.AssetType]</pems-info-item>
                    <pems-info-item label="@L("CommodityGroup1Id")">@Label("CommodityGroup1Id")</pems-info-item>
                    <pems-info-item label="@L("CommodityGroup2Id")">@Label("CommodityGroup2Id")</pems-info-item>
                    <pems-info-item label="@L("ProductFamilyId")">@Label("ProductFamilyId")</pems-info-item>
                    <pems-info-item label="@L("UnitOfMeasureId")">@Label("UnitOfMeasureId")</pems-info-item>
                    <pems-info-item label="@L("ManufacturerId")">@Label("ManufacturerId") @if (f.IsNewManufacturer) { <span class="vs-pill vs-pill--warning">@L("IsNewManufacturer")</span> }</pems-info-item>
                    <pems-info-item label="@L("ManufacturerPartNumber")">@f.ManufacturerPartNumber</pems-info-item>
                    <pems-info-item label="@L("SupplierId")">@Label("SupplierId") @f.SupplierPartNumber</pems-info-item>
                    <pems-info-item label="@L("PartPrice")">@(f.PartPrice.HasValue ? f.PartPrice.Value.ToString("N2") + " " + Label("CurrencyId") : "")</pems-info-item>
                    <pems-info-item label="@L("TypeDesignationId")">@Label("TypeDesignationId")</pems-info-item>
                    <pems-info-item label="@L("IsCritical")">@YesNo(d.IsCritical)</pems-info-item>
                    <pems-info-item label="@L("IsCapital")">@YesNo(d.IsCapital)</pems-info-item>
                    <pems-info-item label="@L("SparePartSerialNo")">@f.SparePartSerialNo</pems-info-item>
                    <pems-info-item label="@L("EquipmentSerialNo")">@f.EquipmentSerialNo</pems-info-item>
                    <pems-info-item label="@L("ManufacturerDrawingNo")">@f.ManufacturerDrawingNo</pems-info-item>
                    <pems-info-item label="@L("DocumentNo")">@f.DocumentNo</pems-info-item>
                    @if (d.RequestType == "Change")
                    {
                        <pems-info-item label="@L("IsRd")">@YesNo(f.IsRd)</pems-info-item>
                        <pems-info-item label="@L("ExistingPartNumber")">@f.ExistingPartNumber</pems-info-item>
                        <pems-info-item label="@L("ChangesMatchInventory")">@(f.ChangesMatchInventory.HasValue ? YesNo(f.ChangesMatchInventory.Value) : "")</pems-info-item>
                    }
                </pems-info-grid>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><pems-icon name="bi-box-seam" /> @Localizer["Pc_Sec_Planning"]</h2>
                <pems-info-grid layout="rows">
                    <pems-info-item label="@L("PlanningMethodId")">@Label("PlanningMethodId")</pems-info-item>
                    <pems-info-item label="@L("MinimumStock")">@f.MinimumStock</pems-info-item>
                    <pems-info-item label="@L("MaxConsumptionRate")">@f.MaxConsumptionRate</pems-info-item>
                    <pems-info-item label="@L("FirstPurchaseQuantity")">@f.FirstPurchaseQuantity</pems-info-item>
                    <pems-info-item label="@L("PrimaryIssuedRequired")">@YesNo(f.PrimaryIssuedRequired)</pems-info-item>
                    <pems-info-item label="@L("IssuedQty")">@f.IssuedQty</pems-info-item>
                    <pems-info-item label="@L("StockGradeId")">@Label("StockGradeId")</pems-info-item>
                    <pems-info-item label="@L("WantedReceiptDate")">@f.WantedReceiptDate?.ToString("yyyy-MM-dd")</pems-info-item>
                    <pems-info-item label="@L("StorageVolume")">@f.StorageVolume</pems-info-item>
                </pems-info-grid>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><pems-icon name="bi-diagram-3" /> @L("Attributes")</h2>
                <pems-info-grid layout="rows">
                    <pems-info-item label="@FftName" value-class="pc-fft-view">@fft</pems-info-item>
                    @foreach (var at in f.Attributes.Where(x => !string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase)))
                    { <pems-info-item label="@at.Name">@at.Value</pems-info-item> }
                </pems-info-grid>
            </section>
        </pems-col>

        <pems-col lg="4">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-signpost-split" /> @Localizer["Pc_Det_Route"]</h2>
                @if (!d.Steps.Any()) { <div class="text-muted small">@Localizer["Pc_Det_NoRoute"]</div> }
                <ol class="pc-route list-unstyled mb-0">
                    @foreach (var st in d.Steps)
                    {
                        <li class="pc-route-step @("pc-step-" + st.Status.ToLowerInvariant())">
                            <span class="vs-pill vs-pill--icon @StepPill(st.Status)">@Localizer["Pc_StepStatus_" + st.Status]</span>
                            <strong>@Localizer["Pc_Step_" + st.StepKey]</strong>
                            @if (!string.IsNullOrEmpty(st.AssignedName)) { <div class="small text-muted">@st.AssignedName</div> }
                            @if (st.Status == "Skipped") { <div class="small text-muted">@SkipText(st.SkipReason)</div> }
                            @if (st.DecidedDate.HasValue) { <div class="small text-muted vs-num">@st.DecidedDate.Value.ToString("yyyy-MM-dd HH:mm")</div> }
                        </li>
                    }
                </ol>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><pems-icon name="bi-gear-wide-connected" /> @Localizer["Pc_Sec_Equipment"]</h2>
                @if (!d.Equipment.Any()) { <div class="text-muted small">@Localizer["Pc_Empty_Equipment"]</div> }
                <ul class="list-unstyled small mb-0">
                    @foreach (var q in d.Equipment) { <li>@q.Text <span class="text-muted">× @q.InstalledQuantity.ToString("0.####")</span></li> }
                </ul>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><pems-icon name="bi-paperclip" /> @L("Attachments")</h2>
                @if (!d.Attachments.Any()) { <div class="text-muted small">@Localizer["Pc_Empty_Attachments"]</div> }
                <ul class="list-unstyled small mb-0">
                    @foreach (var at in d.Attachments)
                    {
                        <pems-flex as="li" justify="between" gap="2" css="border-bottom py-1">
                            <a asp-action="Download" asp-route-id="@d.Id" asp-route-attachmentId="@at.Id" class="text-truncate">@at.FileName</a>
                            <span class="text-muted">@Localizer["Pc_Kind_" + at.Kind]</span>
                        </pems-flex>
                    }
                </ul>
            </section>
        </pems-col>

        <pems-col span="12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-clock-history" /> @Localizer["Pc_Det_History"]</h2>
                <div class="pc-table-scroll">
                    <pems-data-table data="@(DataRows.Of(d.Approvals, c_ => c_.Add(((Localizer["Pc_Col_Date"])?.ToString() ?? ""), h => (object?)(h.ActionDate.ToString("yyyy-MM-dd HH:mm")), css: "vs-num text-nowrap").Add(((Localizer["Pc_Col_Stage"])?.ToString() ?? ""), h => (object?)(string.IsNullOrEmpty(h.StepKey) ? "" : Localizer["Pc_Step_" + h.StepKey].Value)).Add(((Localizer["Pc_Col_Action"])?.ToString() ?? ""), h => (object?)(Localizer["Pc_Action_" + h.Action])).Add(((Localizer["Pc_Col_Person"])?.ToString() ?? ""), h => (object?)(h.ActorName)).Add(((L("Comment"))?.ToString() ?? ""), h => (object?)(h.Comment))))" enterprise="false" dense="true" css="table-enterprise vs-dense mb-0" />
                    @if (!d.Approvals.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_History"]</div> }
                </div>
            </section>
        </pems-col>

        <pems-col span="12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-chat-left-text" /> @L("Notes")</h2>
                <div class="pc-table-scroll mb-2">
                    <pems-data-table data="@(DataRows.Of(d.Notes, c_ => c_.Add(((Localizer["Pc_Col_Date"])?.ToString() ?? ""), n => (object?)(n.CreatedDate.ToString("yyyy-MM-dd HH:mm")), css: "vs-num text-nowrap").Add(((Localizer["Pc_Col_Person"])?.ToString() ?? ""), n => (object?)(n.AuthorName)).Add(((Localizer["Pc_Col_Stage"])?.ToString() ?? ""), n => (object?)(string.IsNullOrEmpty(n.StepKey) ? "" : Localizer["Pc_Step_" + n.StepKey].Value)).Add(((L("Text"))?.ToString() ?? ""), n => (object?)(n.Text))))" enterprise="false" dense="true" css="table-enterprise vs-dense mb-0" />
                    @if (!d.Notes.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Notes"]</div> }
                </div>
                @if (d.Status is "InApproval" or "Draft" or "Returned")
                {
                    <pems-form asp-action="AddNote" method="post"><pems-flex gap="2">
                        <input type="hidden" name="id" value="@d.Id" />
                        <pems-input scale="small" name="text" maxlength="2000" placeholder="@Localizer["Pc_Hint_NoteReply"]" aria-label="@L("Notes")" />
                        <button type="submit" class="vs-btn vs-btn--sm"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddNote"]</button>
                    </pems-flex></pems-form>
                }
            </section>
        </pems-col>
    </pems-row>
</pems-page-shell>
