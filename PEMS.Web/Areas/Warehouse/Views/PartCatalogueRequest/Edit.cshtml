@model PcEditViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Details;
    var f = d.Form;
    var a = d.Actions;
    var isChange = Model.IsChange;
    string L(string key) => Localizer["Pc_F_" + key].Value;
    const string FftName = "FREE FORMAT TEXT";
    string Label(string key) => d.Labels.TryGetValue(key, out var v) ? v : "";
    var rowVersion = d.RowVersion is { Length: > 0 } ? Convert.ToBase64String(d.RowVersion) : null;
    var lookupBase = "/Warehouse/PartCatalogueLookup";
    var fft = f.Attributes.FirstOrDefault(x => string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase));
    var extraAttrs = f.Attributes.Where(x => !string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase)).ToList();
    var warningTemp = TempData["Warning"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<div class="vs-page pc-page"
     data-pc-lookup-base="@lookupBase"
     data-txt-no-results="@Localizer["Pc_Lookup_NoResults"]"
     data-txt-search="@Localizer["Pc_Lookup_Search"]"
     data-txt-local="@Localizer["Pc_Hint_LocalPartNo"]"
     data-txt-yes="@Localizer["Pc_Yes"]"
     data-txt-no="@Localizer["Pc_No"]"
     data-txt-manufacturer-exists="@Localizer["Pc_Err_ManufacturerExists"]"
     data-txt-manufacturer-similar="@Localizer["Pc_Warn_ManufacturerSimilar"]">

    <div class="vs-doc-head">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h2 class="pems-page-title mb-0">@Localizer["Pc_Title_Edit"]</h2>
            <span class="vs-pill vs-pill--info">@Localizer["Pc_Type_" + d.RequestType]</span>
            <span class="vs-pill vs-pill--neutral">@Localizer["Pc_Status_" + d.Status]</span>
            @if (!string.IsNullOrEmpty(d.RequestNumber)) { <span class="vs-num vs-num--strong">@d.RequestNumber</span> }
            @if (f.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @Localizer["Pc_Urgent"]</span> }
        </div>
        <div class="vs-info small text-muted mt-1">@Localizer["Pc_F_Requester"]: @d.RequesterName</div>
    </div>

    @if (Model.Errors.Any())
    {
        <pems-alert tone="danger" css="small">
            <strong>@Localizer["Pc_Msg_FixErrors"]</strong>
            <ul class="mb-0">
                @foreach (var m in PcMessages.FormatAll(Localizer, Model.Errors)) { <li>@m</li> }
            </ul>
        </pems-alert>
    }
    @if (Model.Warnings.Any() || !string.IsNullOrEmpty(warningTemp))
    {
        <pems-alert tone="warning" css="small">
            <ul class="mb-0">
                @foreach (var m in PcMessages.FormatAll(Localizer, Model.Warnings)) { <li>@m</li> }
                @if (!string.IsNullOrEmpty(warningTemp)) { <li>@warningTemp</li> }
            </ul>
        </pems-alert>
    }

    @* فرم اصلی خالی است؛ همه‌ی فیلدها با attribute form="pcForm" به آن وصل‌اند تا فرم‌های فرعی (تجهیز/پیوست/شماره‌دهی) تودرتو نشوند *@
    <form id="pcForm" method="post" asp-action="Edit"></form>
    <input type="hidden" form="pcForm" name="Id" value="@d.Id" />
    <input type="hidden" form="pcForm" name="RequestType" value="@d.RequestType" />
    @if (rowVersion != null) { <input type="hidden" form="pcForm" name="RowVersion" value="@rowVersion" /> }

    <div class="vs-toolbar pc-actionbar">
        <button type="submit" form="pcForm" class="vs-btn vs-btn--sm"><pems-icon name="bi-save" /> @Localizer["Pc_Btn_Save"]</button>
        @if (a.CanSubmit)
        {
            <button type="submit" form="pcForm" name="submitAfterSave" value="true" class="vs-btn vs-btn--primary vs-btn--sm"><pems-icon name="bi-send" /> @Localizer["Pc_Btn_SaveSubmit"]</button>
        }
        else if (a.CanGenerateNumber)
        {
            <span class="small text-muted">@Localizer["Pc_Hint_NumberFirst"]</span>
        }
        <div class="vs-toolbar__end">
            <a asp-action="Index" class="vs-btn vs-btn--sm">@Localizer["Pc_Btn_Back"]</a>
            @if (a.CanCancel)
            {
                <form asp-action="Execute" method="post" class="d-inline" data-pems-confirm="@Localizer["Pc_Confirm_Cancel"]">
                    <input type="hidden" name="id" value="@d.Id" />
                    <input type="hidden" name="action" value="Cancel" />
                    <button type="submit" class="vs-btn vs-btn--sm vs-btn--danger"><pems-icon name="bi-x-circle" /> @Localizer["Pc_Btn_Cancel"]</button>
                </form>
            }
        </div>
    </div>

    <pems-row gap="3">
        @* ------------------------------------------------ Part Info *@
        <pems-col lg="4">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-info-circle" /> @Localizer["Pc_Sec_PartInfo"]</h2>

                <div class="mb-2">
                    <pems-label for="pc_RequestNumber">@L("RequestNumber") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                    <div class="input-group input-group-sm">
                        <pems-input id="pc_RequestNumber" value="@d.RequestNumber" readonly />
                        @if (a.CanGenerateNumber)
                        {
                            <pems-button tone="neutral" outline="true" type="submit" form="pcNumberForm" title="@Localizer["Pc_Btn_GenerateNumber"]"><pems-icon name="bi-123" /> @Localizer["Pc_Btn_GenerateNumber"]</pems-button>
                        }
                    </div>
                </div>

                <div class="mb-2">
                    <pems-label for="pc_Urgent">@L("Urgent") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                    <pems-select scale="small" id="pc_Urgent" form="pcForm" name="Urgent">
                        <option value="false" selected="@(!f.Urgent)">@Localizer["Pc_No"]</option>
                        <option value="true" selected="@f.Urgent">@Localizer["Pc_Yes"]</option>
                    </pems-select>
                </div>

                <div class="mb-2">
                    <pems-label for="pc_SectionId">@L("SectionId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                    <pems-select scale="small" id="pc_SectionId" form="pcForm" name="SectionId" data-pc-section>
                        <option value=""></option>
                        @foreach (var s in Model.Sections) { <option value="@s.Id" selected="@(f.SectionId == s.Id)">@s.Text</option> }
                    </pems-select>
                </div>

                <div class="mb-2"><pems-label as="span" css="d-block">@L("Requester")</pems-label><span>@d.RequesterName</span></div>

                @if (isChange)
                {
                    <div class="pc-change-block mt-3 pt-2 border-top">
                        <div class="mb-2">
                            <pems-label for="pc_IsRd">@L("IsRd")</pems-label>
                            <pems-select scale="small" id="pc_IsRd" form="pcForm" name="IsRd">
                                <option value="false" selected="@(!f.IsRd)">@Localizer["Pc_No"]</option>
                                <option value="true" selected="@f.IsRd">@Localizer["Pc_Yes"]</option>
                            </pems-select>
                        </div>
                        <div class="mb-2">
                            <pems-label for="pc_ExistingPartNumber">@L("ExistingPartNumber") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                            <div class="input-group input-group-sm">
                                <pems-input id="pc_ExistingPartNumber" form="pcForm" name="ExistingPartNumber" value="@f.ExistingPartNumber" maxlength="50" />
                                <pems-button tone="neutral" outline="true" type="submit" form="pcForm" formaction="@Url.Action("LoadPart")"><pems-icon name="bi-box-arrow-in-down" /> @Localizer["Pc_Btn_Load"]</pems-button>
                            </div>
                            <div class="form-text">@Localizer["Pc_Hint_Load"]</div>
                        </div>
                        <div class="mb-2">
                            <pems-label for="pc_ChangesMatchInventory">@L("ChangesMatchInventory") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                            <pems-select scale="small" id="pc_ChangesMatchInventory" form="pcForm" name="ChangesMatchInventory">
                                <option value=""></option>
                                <option value="true" selected="@(f.ChangesMatchInventory == true)">@Localizer["Pc_Yes"]</option>
                                <option value="false" selected="@(f.ChangesMatchInventory == false)">@Localizer["Pc_No"]</option>
                            </pems-select>
                            <div class="form-text">@Localizer["Pc_Hint_ChangesMatch"]</div>
                        </div>
                        @if (!string.IsNullOrEmpty(d.Form.OldManufacturerName) || !string.IsNullOrEmpty(d.Form.OldManufacturerPartNumber))
                        {
                            <div class="small text-muted">@L("OldManufacturerName"): <strong>@d.Form.OldManufacturerName</strong> / @d.Form.OldManufacturerPartNumber</div>
                        }
                    </div>
                }
            </section>
        </pems-col>

        @* ------------------------------------------------ Equipment/Object ID *@
        <pems-col lg="8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-gear-wide-connected" /> @Localizer["Pc_Sec_Equipment"]</h2>
                <div class="form-check mb-2">
                    <pems-input type="checkbox" id="pc_IsNewEquipment" form="pcForm" name="IsNewEquipment" value="true" checked="@f.IsNewEquipment" kind="check" />
                    <input type="hidden" form="pcForm" name="IsNewEquipment" value="false" />
                    <label class="form-check-label" for="pc_IsNewEquipment">@L("IsNewEquipment")</label>
                </div>

                <div class="pc-table-scroll">
                    <pems-related-table>
                        <thead><tr><th>@L("EquipmentId")</th><th class="text-end">@L("InstalledQuantity")</th><th class="pems-w-50"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th></tr></thead>
                        <tbody>
                        @foreach (var q in d.Equipment)
                        {
                            <tr>
                                <td>@q.Text</td>
                                <td class="text-end vs-num">@q.InstalledQuantity.ToString("0.####")</td>
                                <td class="text-end">
                                    <pems-related-remove action="@Url.Action("RemoveEquipment")" key-name="lineId" key-value="@q.Id.ToString()"
                                                         parent-name="id" parent-value="@d.Id.ToString()" label="@Localizer["Pc_Btn_Remove"]" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </pems-related-table>
                    @if (!d.Equipment.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Equipment"]</div> }
                </div>
                <button type="button" class="vs-btn vs-btn--sm" data-bs-toggle="modal" data-bs-target="#pcEquipModal"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddEquipment"]</button>
            </section>

            @* ------------------------------------------------ Class Info *@
            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><pems-icon name="bi-diagram-3" /> @Localizer["Pc_Sec_ClassInfo"]</h2>
                <div class="mb-2">
                    <pems-label for="pc_TechnicalClassId_text">@L("TechnicalClassId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                    <div class="pc-lookup" data-url="@lookupBase/TechnicalClasses" data-detail-url="@lookupBase/TechnicalClass" data-name="TechnicalClassId" data-form="pcForm"
                         data-id="@f.TechnicalClassId" data-text="@Label("TechnicalClassId")" data-input-id="pc_TechnicalClassId_text"></div>
                    <div class="form-text pc-tc-long" id="pc_TechnicalClassLong">@d.TechnicalClassLongDescription</div>
                    <div class="form-text pc-tc-status" id="pc_TcResolveStatus" role="status" aria-live="polite"
                         data-txt-resolved="@Localizer["Pc_Tc_Resolved"]" data-txt-ambiguous="@Localizer["Pc_Tc_Ambiguous"]" data-txt-none="@Localizer["Pc_Tc_None"]"
                         data-txt-mismatch="@Localizer["Pc_Tc_Mismatch"]" data-txt-picked="@Localizer["Pc_Tc_Picked"]"></div>
                </div>

                <pems-label>@L("Attributes") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                <div class="pc-table-scroll">
                    <pems-related-table id="pcAttrTable">
                        <thead><tr><th class="pems-w-34pct">@L("AttributeName")</th><th>@L("AttributeValue")</th><th class="pems-w-40"></th></tr></thead>
                        <tbody>
                            <tr>
                                <td><input type="hidden" form="pcForm" name="Attributes[0].Name" value="@FftName" /><strong>@FftName</strong></td>
                                <td>
                                    <pems-input scale="small" css="pc-fft" type="text" form="pcForm" name="Attributes[0].Value" id="pc_FreeFormatText" value="@(fft?.Value ?? " ")" aria-label="@FftName" autocomplete="off" />
                                </td>
                                <td></td>
                            </tr>
                            @for (var i = 0; i < extraAttrs.Count; i++)
                            {
                                var idx = i + 1;
                                <tr class="pc-attr-row">
                                    <td><pems-input scale="small" type="text" form="pcForm" name="Attributes[@idx].Name" value="@extraAttrs[i].Name" maxlength="100" /></td>
                                    <td><pems-input scale="small" type="text" form="pcForm" name="Attributes[@idx].Value" value="@extraAttrs[i].Value" /></td>
                                    <td><button type="button" class="vs-icon-btn pc-attr-remove" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-x-lg" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </pems-related-table>
                </div>
                <button type="button" class="vs-btn vs-btn--sm" id="pcAddAttr" data-next-index="@(extraAttrs.Count + 1)"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddAttribute"]</button>
                <div class="form-text">@Localizer["Pc_Hint_FreeFormat"]</div>
            </section>
        </pems-col>

        @* ------------------------------------------------ Part Classification *@
        <pems-col lg="8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-tags" /> @Localizer["Pc_Sec_Classification"]</h2>
                <pems-row gap="2">
                    <pems-col md="6">
                        <pems-label for="pc_AssetType">@L("AssetType")</pems-label>
                        <pems-select scale="small" id="pc_AssetType" form="pcForm" name="AssetType">
                            @foreach (var at in new[] { "None", "FixedAsset", "LowValueAsset" })
                            { <option value="@at" selected="@(f.AssetType == at)">@Localizer["Pc_Asset_" + at]</option> }
                        </pems-select>
                        <div class="form-text">@Localizer["Pc_Hint_LowValue"]</div>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_CommodityGroup1Id">@L("CommodityGroup1Id") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_CommodityGroup1Id" form="pcForm" name="CommodityGroup1Id" data-pc-group1>
                            <option value=""></option>
                            @foreach (var g in Model.Group1) { <option value="@g.Id" selected="@(f.CommodityGroup1Id == g.Id)">@g.Text</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_CommodityGroup2Id">@L("CommodityGroup2Id") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_CommodityGroup2Id" form="pcForm" name="CommodityGroup2Id" data-pc-group2>
                            <option value=""></option>
                            @foreach (var g in Model.Group2) { <option value="@g.Id" selected="@(f.CommodityGroup2Id == g.Id)">@g.Text</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_ProductFamilyId">@L("ProductFamilyId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_ProductFamilyId" form="pcForm" name="ProductFamilyId">
                            <option value=""></option>
                            @foreach (var p in Model.ProductFamilies) { <option value="@p.Id" selected="@(f.ProductFamilyId == p.Id)">@p.Text</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_UnitOfMeasureId">@L("UnitOfMeasureId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_UnitOfMeasureId" form="pcForm" name="UnitOfMeasureId">
                            <option value=""></option>
                            @foreach (var u in Model.Units) { <option value="@u.Id" selected="@(f.UnitOfMeasureId == u.Id)">@u.Text@(string.IsNullOrEmpty(u.Extra) ? "" : " - " + u.Extra)</option> }
                        </pems-select>
                        @if (isChange) { <div class="form-text">@Localizer["Pc_Hint_UomLocked"]</div> }
                    </pems-col>

                    <pems-col md="6">
                        <pems-label for="pc_ManufacturerId_text">@L("ManufacturerId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <div class="pc-lookup" data-url="@lookupBase/Manufacturers" data-name="ManufacturerId" data-form="pcForm" data-id="@f.ManufacturerId"
                             data-text="@(f.IsNewManufacturer ? "" : Label("ManufacturerId"))" data-input-id="pc_ManufacturerId_text" data-pc-manufacturer></div>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_NewManufacturerName">@L("IsNewManufacturer")</pems-label>
                        <div class="input-group input-group-sm">
                            <div class="input-group-text">
                                <input type="checkbox" id="pc_IsNewManufacturer" form="pcForm" name="IsNewManufacturer" value="true" checked="@f.IsNewManufacturer" aria-label="@L("IsNewManufacturer")" />
                                <input type="hidden" form="pcForm" name="IsNewManufacturer" value="false" />
                            </div>
                            <pems-input id="pc_NewManufacturerName" form="pcForm" name="NewManufacturerName" value="@f.NewManufacturerName" maxlength="200" placeholder="@Localizer["Pc_Hint_NewManufacturer"]" disabled="@(!f.IsNewManufacturer)" css="text-uppercase" />
                        </div>
                        <div class="form-text" id="pc_ManufacturerCheck"></div>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_ManufacturerPartNumber">@L("ManufacturerPartNumber")@if (isChange) { <span class="pc-req" aria-hidden="true"> *</span> }</pems-label>
                        <pems-input scale="small" id="pc_ManufacturerPartNumber" form="pcForm" name="ManufacturerPartNumber" value="@f.ManufacturerPartNumber" maxlength="100" />
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_SupplierId_text">@L("SupplierId")</pems-label>
                        <div class="pc-lookup" data-url="@lookupBase/Suppliers" data-name="SupplierId" data-form="pcForm" data-id="@f.SupplierId"
                             data-text="@Label("SupplierId")" data-input-id="pc_SupplierId_text"></div>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_SupplierPartNumber">@L("SupplierPartNumber")</pems-label>
                        <pems-input scale="small" id="pc_SupplierPartNumber" form="pcForm" name="SupplierPartNumber" value="@f.SupplierPartNumber" maxlength="100" />
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_PartPrice">@L("PartPrice")</pems-label>
                        <div class="input-group input-group-sm">
                            <pems-input id="pc_PartPrice" form="pcForm" name="PartPrice" type="number" step="0.01" min="0" value="@f.PartPrice" />
                            <pems-select form="pcForm" name="CurrencyId" aria-label="@L("CurrencyId")">
                                <option value=""></option>
                                @foreach (var c in Model.Currencies) { <option value="@c.Id" selected="@(f.CurrencyId == c.Id)">@c.Text@(string.IsNullOrEmpty(c.Extra) ? "" : " - " + c.Extra)</option> }
                            </pems-select>
                        </div>
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_TypeDesignationId">@L("TypeDesignationId")</pems-label>
                        <pems-select scale="small" id="pc_TypeDesignationId" form="pcForm" name="TypeDesignationId" data-pc-type>
                            <option value=""></option>
                            @foreach (var t in Model.TypeDesignations) { <option value="@t.Id" data-flags="@t.Extra" selected="@(f.TypeDesignationId == t.Id)">@t.Text</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label as="span" css="d-block">@L("IsCritical") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <span class="vs-pill vs-pill--neutral" id="pcIsCritical">@(d.IsCritical ? Localizer["Pc_Yes"] : Localizer["Pc_No"])</span>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label as="span" css="d-block">@L("IsCapital")</pems-label>
                        <span class="vs-pill vs-pill--neutral" id="pcIsCapital">@(d.IsCapital ? Localizer["Pc_Yes"] : Localizer["Pc_No"])</span>
                    </pems-col>
                </pems-row>
            </section>
        </pems-col>

        @* ------------------------------------------------ Other Info *@
        <pems-col lg="4">
            <section class="vs-panel pc-card mb-3" id="pcDedup"
                     data-url-existing="/Warehouse/PartCatalogueDedup/ExistingParts"
                     data-url-duplicates="/Warehouse/PartCatalogueDedup/DuplicateCandidates"
                     data-request-id="@d.Id"
                     data-txt-none="@Localizer["Pc_Dedup_None"]"
                     data-txt-ambiguous="@Localizer["Pc_Dedup_Ambiguous"]"
                     data-txt-inflight="@Localizer["Pc_Dedup_InFlight"]"
                     data-txt-error="@Localizer["Pc_Dedup_Error"]">
                <h2 class="vs-section__title"><pems-icon name="bi-search" /> @Localizer["Pc_Dedup_Title"]</h2>
                <p class="form-text">@Localizer["Pc_Dedup_Hint"]</p>
                <pems-label for="pcDedupQuery">@Localizer["Pc_Dedup_SearchLabel"]</pems-label>
                <div class="input-group input-group-sm mb-2">
                    <pems-input id="pcDedupQuery" type="search" maxlength="100" autocomplete="off" />
                    <button type="button" class="vs-btn vs-btn--sm" id="pcDedupSearch">@Localizer["Pc_Dedup_Search"]</button>
                </div>
                <button type="button" class="vs-btn vs-btn--sm mb-2" id="pcDedupCheck">@Localizer["Pc_Dedup_Check"]</button>
                <div id="pcDedupResult" role="status" aria-live="polite" class="small"></div>
            </section>

            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-paperclip" /> @Localizer["Pc_Sec_OtherInfo"]</h2>
                <div class="mb-2"><pems-label for="pc_SparePartSerialNo">@L("SparePartSerialNo")</pems-label><pems-input scale="small" id="pc_SparePartSerialNo" form="pcForm" name="SparePartSerialNo" value="@f.SparePartSerialNo" maxlength="100" /></div>
                <div class="mb-2"><pems-label for="pc_EquipmentSerialNo">@L("EquipmentSerialNo")</pems-label><pems-input scale="small" id="pc_EquipmentSerialNo" form="pcForm" name="EquipmentSerialNo" value="@f.EquipmentSerialNo" maxlength="100" /></div>
                <div class="mb-2"><pems-label for="pc_ManufacturerDrawingNo">@L("ManufacturerDrawingNo")</pems-label><pems-input scale="small" id="pc_ManufacturerDrawingNo" form="pcForm" name="ManufacturerDrawingNo" value="@f.ManufacturerDrawingNo" maxlength="100" /></div>
                <div class="mb-2"><pems-label for="pc_DocumentNo">@L("DocumentNo")</pems-label><pems-input scale="small" id="pc_DocumentNo" form="pcForm" name="DocumentNo" value="@f.DocumentNo" maxlength="100" /></div>

                <pems-label>@L("Attachments")</pems-label>
                <ul class="list-unstyled small mb-2">
                    @foreach (var at in d.Attachments)
                    {
                        <li class="d-flex align-items-center justify-content-between gap-2 border-bottom py-1">
                            <a asp-action="Download" asp-route-id="@d.Id" asp-route-attachmentId="@at.Id" class="text-truncate">@at.FileName</a>
                            <span class="text-muted">@Localizer["Pc_Kind_" + at.Kind]</span>
                            <form asp-action="RemoveAttachment" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="attachmentId" value="@at.Id" />
                                <button class="vs-icon-btn" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-trash" /></button>
                            </form>
                        </li>
                    }
                </ul>
                @if (!d.Attachments.Any()) { <div class="text-muted small mb-2">@Localizer["Pc_Empty_Attachments"]</div> }
                <button type="button" class="vs-btn vs-btn--sm" data-bs-toggle="modal" data-bs-target="#pcAttachModal"><pems-icon name="bi-upload" /> @Localizer["Pc_Btn_Upload"]</button>
                <div class="form-text">@Localizer["Pc_Hint_PosItem"]</div>
            </section>
        </pems-col>

        @* ------------------------------------------------ Inventory Planning *@
        <pems-col span="12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-box-seam" /> @Localizer["Pc_Sec_Planning"]</h2>
                <pems-row gap="2">
                    <pems-col md="3">
                        <pems-label for="pc_PlanningMethodId">@L("PlanningMethodId")</pems-label>
                        <pems-select scale="small" id="pc_PlanningMethodId" form="pcForm" name="PlanningMethodId" data-pc-planning>
                            <option value=""></option>
                            @foreach (var p in Model.PlanningMethods) { <option value="@p.Id" data-code="@p.Code" selected="@(f.PlanningMethodId == p.Id)">@p.Text@(string.IsNullOrEmpty(p.Extra) ? "" : " - " + p.Extra)</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_MinimumStock">@L("MinimumStock") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-input scale="small" id="pc_MinimumStock" form="pcForm" name="MinimumStock" type="number" step="0.0001" min="0" value="@f.MinimumStock" />
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_MaxConsumptionRate">@L("MaxConsumptionRate") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-input scale="small" id="pc_MaxConsumptionRate" form="pcForm" name="MaxConsumptionRate" type="number" step="0.0001" min="0" value="@f.MaxConsumptionRate" />
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_FirstPurchaseQuantity">@L("FirstPurchaseQuantity")</pems-label>
                        <pems-input scale="small" id="pc_FirstPurchaseQuantity" form="pcForm" name="FirstPurchaseQuantity" type="number" step="0.0001" min="0" value="@f.FirstPurchaseQuantity" />
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_PrimaryIssuedRequired">@L("PrimaryIssuedRequired") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_PrimaryIssuedRequired" form="pcForm" name="PrimaryIssuedRequired">
                            <option value="false" selected="@(!f.PrimaryIssuedRequired)">@Localizer["Pc_No"]</option>
                            <option value="true" selected="@f.PrimaryIssuedRequired">@Localizer["Pc_Yes"]</option>
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_IssuedQty">@L("IssuedQty")</pems-label>
                        <pems-input scale="small" id="pc_IssuedQty" form="pcForm" name="IssuedQty" type="number" step="0.0001" min="0" value="@f.IssuedQty" />
                    </pems-col>
                    <pems-col md="6">
                        <pems-label for="pc_StockGradeId">@L("StockGradeId") <span class="pc-req" aria-hidden="true">*</span></pems-label>
                        <pems-select scale="small" id="pc_StockGradeId" form="pcForm" name="StockGradeId">
                            <option value=""></option>
                            @foreach (var g in Model.StockGrades) { <option value="@g.Id" selected="@(f.StockGradeId == g.Id)">@g.Text</option> }
                        </pems-select>
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_WantedReceiptDate">@L("WantedReceiptDate")</pems-label>
                        <pems-date id="pc_WantedReceiptDate" form="pcForm" name="WantedReceiptDate" value="@f.WantedReceiptDate?.ToString("yyyy-MM-dd")" scale="small" />
                    </pems-col>
                    <pems-col md="3">
                        <pems-label for="pc_StorageVolume">@L("StorageVolume")</pems-label>
                        <pems-input scale="small" id="pc_StorageVolume" form="pcForm" name="StorageVolume" value="@f.StorageVolume" maxlength="100" />
                    </pems-col>
                </pems-row>
                <div class="form-text">@Localizer["Pc_Hint_Planning"]</div>
            </section>
        </pems-col>

        @* ------------------------------------------------ Notes *@
        <pems-col span="12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><pems-icon name="bi-chat-left-text" /> @L("Notes")</h2>
                <div class="pc-table-scroll mb-2">
                    <pems-related-table>
                        <thead><tr><th>@Localizer["Pc_Col_Date"]</th><th>@Localizer["Pc_Col_Person"]</th><th>@Localizer["Pc_Col_Stage"]</th><th>@L("Text")</th></tr></thead>
                        <tbody>
                        @foreach (var n in d.Notes)
                        {
                            <tr><td class="vs-num text-nowrap">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td><td>@n.AuthorName</td><td>@(string.IsNullOrEmpty(n.StepKey) ? "" : Localizer["Pc_Step_" + n.StepKey].Value)</td><td>@n.Text</td></tr>
                        }
                        </tbody>
                    </pems-related-table>
                    @if (!d.Notes.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Notes"]</div> }
                </div>
                <form asp-action="AddNote" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="returnTo" value="edit" />
                    <pems-input scale="small" name="text" maxlength="2000" placeholder="@Localizer["Pc_Hint_NoteReply"]" aria-label="@L("Notes")" />
                    <button type="submit" class="vs-btn vs-btn--sm"><pems-icon name="bi-plus-lg" /> @Localizer["Pc_Btn_AddNote"]</button>
                </form>
            </section>
        </pems-col>
    </pems-row>
</div>

@* شماره‌دهی (فرم مستقل - تودرتو نیست) *@
<form id="pcNumberForm" asp-action="GenerateNumber" method="post">
    <input type="hidden" name="id" value="@d.Id" />
    @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
</form>

<pems-modal id="pcEquipModal" tabindex="-1" aria-labelledby="pcEquipModalLabel" aria-hidden="true"><form asp-action="AddEquipment" method="post">
            <input type="hidden" name="id" value="@d.Id" />
            <div class="modal-header"><h5 class="modal-title" id="pcEquipModalLabel">@Localizer["Pc_Btn_AddEquipment"]</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Pc_Btn_Close"]"></button></div>
            <div class="modal-body">
                @if (f.IsNewEquipment)
                {
                    <div class="mb-2"><pems-label for="pc_equipText">@L("EquipmentText")</pems-label><pems-input id="pc_equipText" name="equipmentText" maxlength="300" required /></div>
                }
                else
                {
                    <div class="mb-2">
                        <pems-label for="pc_equipId_text">@L("EquipmentId")</pems-label>
                        <div class="pc-lookup" data-url="@lookupBase/Equipment" data-name="equipmentId" data-input-id="pc_equipId_text"></div>
                    </div>
                }
                <div class="mb-2"><pems-label for="pc_equipQty">@L("InstalledQuantity")</pems-label><pems-input id="pc_equipQty" name="installedQuantity" type="number" step="0.0001" min="0" value="1" required /></div>
                <div class="form-text">@Localizer["Pc_Hint_NewEquipment"]</div>
            </div>
            <div class="modal-footer"><button type="button" class="vs-btn vs-btn--sm" data-bs-dismiss="modal">@Localizer["Pc_Btn_Close"]</button><button type="submit" class="vs-btn vs-btn--primary vs-btn--sm">@Localizer["Pc_Btn_Save"]</button></div>
        </form></pems-modal>

<pems-modal id="pcAttachModal" tabindex="-1" aria-labelledby="pcAttachModalLabel" aria-hidden="true"><form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@d.Id" />
            <div class="modal-header"><h5 class="modal-title" id="pcAttachModalLabel">@Localizer["Pc_Btn_Upload"]</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Pc_Btn_Close"]"></button></div>
            <div class="modal-body">
                <div class="mb-2"><pems-label for="pc_attFile">@L("File")</pems-label><pems-input id="pc_attFile" type="file" name="file" required /></div>
                <div class="mb-2">
                    <pems-label for="pc_attKind">@L("AttachmentKind")</pems-label>
                    <pems-select id="pc_attKind" name="kind">
                        @foreach (var k in new[] { "Document", "Drawing", "Support" }) { <option value="@k">@Localizer["Pc_Kind_" + k]</option> }
                    </pems-select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="vs-btn vs-btn--sm" data-bs-dismiss="modal">@Localizer["Pc_Btn_Close"]</button><button type="submit" class="vs-btn vs-btn--primary vs-btn--sm">@Localizer["Pc_Btn_Upload"]</button></div>
        </form></pems-modal>

<template id="pcAttrTemplate">
    <tr class="pc-attr-row">
        <td><pems-input scale="small" type="text" form="pcForm" name="Attributes[__i__].Name" maxlength="100" /></td>
        <td><pems-input scale="small" type="text" form="pcForm" name="Attributes[__i__].Value" /></td>
        <td><button type="button" class="vs-icon-btn pc-attr-remove" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><pems-icon name="bi-x-lg" /></button></td>
    </tr>
</template>

@section Scripts {
    <pems-script-templates set="part-catalogue"></pems-script-templates>
    <script src="~/js/pems-part-catalogue.js" asp-append-version="true"></script>
    <script src="~/js/pems-part-catalogue-dedup.js" asp-append-version="true"></script>
}
