@model PcEditViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model.Details;
    var f = d.Form;
    var a = d.Actions;
    var isChange = Model.IsChange;
    string L(string key) => Localizer["Pc_F_" + key].Value;
    const string FftName = "FREE FORMAT TEXT";
    string Label(string key) => d.Labels.TryGetValue(key, out var v) ? v : "";
    var rowVersion = d.RowVersion is { Length: > 0 } ? Convert.ToBase64String(d.RowVersion) : null;
    var lookupBase = "/Warehouse/PartCatalogueLookup";
    var fft = f.Attributes.FirstOrDefault(x => string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase));
    var extraAttrs = f.Attributes.Where(x => !string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase)).ToList();
    var warningTemp = TempData["Warning"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<div class="vs-page pc-page"
     data-pc-lookup-base="@lookupBase"
     data-txt-no-results="@Localizer["Pc_Lookup_NoResults"]"
     data-txt-search="@Localizer["Pc_Lookup_Search"]"
     data-txt-local="@Localizer["Pc_Hint_LocalPartNo"]"
     data-txt-yes="@Localizer["Pc_Yes"]"
     data-txt-no="@Localizer["Pc_No"]"
     data-txt-manufacturer-exists="@Localizer["Pc_Err_ManufacturerExists"]"
     data-txt-manufacturer-similar="@Localizer["Pc_Warn_ManufacturerSimilar"]">

    <div class="vs-doc-head">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h2 class="pems-page-title mb-0">@Localizer["Pc_Title_Edit"]</h2>
            <span class="vs-pill vs-pill--info">@Localizer["Pc_Type_" + d.RequestType]</span>
            <span class="vs-pill vs-pill--neutral">@Localizer["Pc_Status_" + d.Status]</span>
            @if (!string.IsNullOrEmpty(d.RequestNumber)) { <span class="vs-num vs-num--strong">@d.RequestNumber</span> }
            @if (f.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Pc_Urgent"]</span> }
        </div>
        <div class="vs-info small text-muted mt-1">@Localizer["Pc_F_Requester"]: @d.RequesterName</div>
    </div>

    @if (Model.Errors.Any())
    {
        <div class="alert alert-danger small" role="alert">
            <strong>@Localizer["Pc_Msg_FixErrors"]</strong>
            <ul class="mb-0">
                @foreach (var m in PcMessages.FormatAll(Localizer, Model.Errors)) { <li>@m</li> }
            </ul>
        </div>
    }
    @if (Model.Warnings.Any() || !string.IsNullOrEmpty(warningTemp))
    {
        <div class="alert alert-warning small" role="status">
            <ul class="mb-0">
                @foreach (var m in PcMessages.FormatAll(Localizer, Model.Warnings)) { <li>@m</li> }
                @if (!string.IsNullOrEmpty(warningTemp)) { <li>@warningTemp</li> }
            </ul>
        </div>
    }

    @* فرم اصلی خالی است؛ همه‌ی فیلدها با attribute form="pcForm" به آن وصل‌اند تا فرم‌های فرعی (تجهیز/پیوست/شماره‌دهی) تودرتو نشوند *@
    <form id="pcForm" method="post" asp-action="Edit"></form>
    <input type="hidden" form="pcForm" name="Id" value="@d.Id" />
    <input type="hidden" form="pcForm" name="RequestType" value="@d.RequestType" />
    @if (rowVersion != null) { <input type="hidden" form="pcForm" name="RowVersion" value="@rowVersion" /> }

    <div class="vs-toolbar pc-actionbar">
        <button type="submit" form="pcForm" class="vs-btn vs-btn--sm"><i class="bi bi-save"></i> @Localizer["Pc_Btn_Save"]</button>
        @if (a.CanSubmit)
        {
            <button type="submit" form="pcForm" name="submitAfterSave" value="true" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-send"></i> @Localizer["Pc_Btn_SaveSubmit"]</button>
        }
        else if (a.CanGenerateNumber)
        {
            <span class="small text-muted">@Localizer["Pc_Hint_NumberFirst"]</span>
        }
        <div class="vs-toolbar__end">
            <a asp-action="Index" class="vs-btn vs-btn--sm">@Localizer["Pc_Btn_Back"]</a>
            @if (a.CanCancel)
            {
                <form asp-action="Execute" method="post" class="d-inline" onsubmit="return confirm(this.dataset.confirm);" data-confirm="@Localizer["Pc_Confirm_Cancel"]">
                    <input type="hidden" name="id" value="@d.Id" />
                    <input type="hidden" name="action" value="Cancel" />
                    <button type="submit" class="vs-btn vs-btn--sm vs-btn--danger"><i class="bi bi-x-circle"></i> @Localizer["Pc_Btn_Cancel"]</button>
                </form>
            }
        </div>
    </div>

    <div class="row g-3">
        @* ------------------------------------------------ Part Info *@
        <div class="col-lg-4">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-info-circle"></i> @Localizer["Pc_Sec_PartInfo"]</h2>

                <div class="mb-2">
                    <label class="form-label" for="pc_RequestNumber">@L("RequestNumber") <span class="pc-req" aria-hidden="true">*</span></label>
                    <div class="input-group input-group-sm">
                        <input id="pc_RequestNumber" class="form-control" value="@d.RequestNumber" readonly />
                        @if (a.CanGenerateNumber)
                        {
                            <button type="submit" form="pcNumberForm" class="btn btn-outline-secondary" title="@Localizer["Pc_Btn_GenerateNumber"]"><i class="bi bi-123"></i> @Localizer["Pc_Btn_GenerateNumber"]</button>
                        }
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label" for="pc_Urgent">@L("Urgent") <span class="pc-req" aria-hidden="true">*</span></label>
                    <select id="pc_Urgent" form="pcForm" name="Urgent" class="form-select form-select-sm">
                        <option value="false" selected="@(!f.Urgent)">@Localizer["Pc_No"]</option>
                        <option value="true" selected="@f.Urgent">@Localizer["Pc_Yes"]</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label" for="pc_SectionId">@L("SectionId") <span class="pc-req" aria-hidden="true">*</span></label>
                    <select id="pc_SectionId" form="pcForm" name="SectionId" class="form-select form-select-sm" data-pc-section>
                        <option value=""></option>
                        @foreach (var s in Model.Sections) { <option value="@s.Id" selected="@(f.SectionId == s.Id)">@s.Text</option> }
                    </select>
                </div>

                <div class="mb-2"><span class="form-label d-block">@L("Requester")</span><span>@d.RequesterName</span></div>

                @if (isChange)
                {
                    <div class="pc-change-block mt-3 pt-2 border-top">
                        <div class="mb-2">
                            <label class="form-label" for="pc_IsRd">@L("IsRd")</label>
                            <select id="pc_IsRd" form="pcForm" name="IsRd" class="form-select form-select-sm">
                                <option value="false" selected="@(!f.IsRd)">@Localizer["Pc_No"]</option>
                                <option value="true" selected="@f.IsRd">@Localizer["Pc_Yes"]</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="pc_ExistingPartNumber">@L("ExistingPartNumber") <span class="pc-req" aria-hidden="true">*</span></label>
                            <div class="input-group input-group-sm">
                                <input id="pc_ExistingPartNumber" form="pcForm" name="ExistingPartNumber" value="@f.ExistingPartNumber" class="form-control" maxlength="50" />
                                <button type="submit" form="pcForm" formaction="@Url.Action("LoadPart")" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-in-down"></i> @Localizer["Pc_Btn_Load"]</button>
                            </div>
                            <div class="form-text">@Localizer["Pc_Hint_Load"]</div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="pc_ChangesMatchInventory">@L("ChangesMatchInventory") <span class="pc-req" aria-hidden="true">*</span></label>
                            <select id="pc_ChangesMatchInventory" form="pcForm" name="ChangesMatchInventory" class="form-select form-select-sm">
                                <option value=""></option>
                                <option value="true" selected="@(f.ChangesMatchInventory == true)">@Localizer["Pc_Yes"]</option>
                                <option value="false" selected="@(f.ChangesMatchInventory == false)">@Localizer["Pc_No"]</option>
                            </select>
                            <div class="form-text">@Localizer["Pc_Hint_ChangesMatch"]</div>
                        </div>
                        @if (!string.IsNullOrEmpty(d.Form.OldManufacturerName) || !string.IsNullOrEmpty(d.Form.OldManufacturerPartNumber))
                        {
                            <div class="small text-muted">@L("OldManufacturerName"): <strong>@d.Form.OldManufacturerName</strong> / @d.Form.OldManufacturerPartNumber</div>
                        }
                    </div>
                }
            </section>
        </div>

        @* ------------------------------------------------ Equipment/Object ID *@
        <div class="col-lg-8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-gear-wide-connected"></i> @Localizer["Pc_Sec_Equipment"]</h2>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="pc_IsNewEquipment" form="pcForm" name="IsNewEquipment" value="true" checked="@f.IsNewEquipment" />
                    <input type="hidden" form="pcForm" name="IsNewEquipment" value="false" />
                    <label class="form-check-label" for="pc_IsNewEquipment">@L("IsNewEquipment")</label>
                </div>

                <div class="pc-table-scroll">
                    <pems-related-table>
                        <thead><tr><th>@L("EquipmentId")</th><th class="text-end">@L("InstalledQuantity")</th><th style="width:50px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th></tr></thead>
                        <tbody>
                        @foreach (var q in d.Equipment)
                        {
                            <tr>
                                <td>@q.Text</td>
                                <td class="text-end vs-num">@q.InstalledQuantity.ToString("0.####")</td>
                                <td class="text-end">
                                    <pems-related-remove action="@Url.Action("RemoveEquipment")" key-name="lineId" key-value="@q.Id.ToString()"
                                                         parent-name="id" parent-value="@d.Id.ToString()" label="@Localizer["Pc_Btn_Remove"]" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </pems-related-table>
                    @if (!d.Equipment.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Equipment"]</div> }
                </div>
                <button type="button" class="vs-btn vs-btn--sm" data-bs-toggle="modal" data-bs-target="#pcEquipModal"><i class="bi bi-plus-lg"></i> @Localizer["Pc_Btn_AddEquipment"]</button>
            </section>

            @* ------------------------------------------------ Class Info *@
            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><i class="bi bi-diagram-3"></i> @Localizer["Pc_Sec_ClassInfo"]</h2>
                <div class="mb-2">
                    <label class="form-label" for="pc_TechnicalClassId_text">@L("TechnicalClassId") <span class="pc-req" aria-hidden="true">*</span></label>
                    <div class="pc-lookup" data-url="@lookupBase/TechnicalClasses" data-detail-url="@lookupBase/TechnicalClass" data-name="TechnicalClassId" data-form="pcForm"
                         data-id="@f.TechnicalClassId" data-text="@Label("TechnicalClassId")" data-input-id="pc_TechnicalClassId_text"></div>
                    <div class="form-text pc-tc-long" id="pc_TechnicalClassLong">@d.TechnicalClassLongDescription</div>
                    <div class="form-text pc-tc-status" id="pc_TcResolveStatus" role="status" aria-live="polite"
                         data-txt-resolved="@Localizer["Pc_Tc_Resolved"]" data-txt-ambiguous="@Localizer["Pc_Tc_Ambiguous"]" data-txt-none="@Localizer["Pc_Tc_None"]"
                         data-txt-mismatch="@Localizer["Pc_Tc_Mismatch"]" data-txt-picked="@Localizer["Pc_Tc_Picked"]"></div>
                </div>

                <label class="form-label">@L("Attributes") <span class="pc-req" aria-hidden="true">*</span></label>
                <div class="pc-table-scroll">
                    <pems-related-table id="pcAttrTable">
                        <thead><tr><th style="width:34%">@L("AttributeName")</th><th>@L("AttributeValue")</th><th style="width:40px"></th></tr></thead>
                        <tbody>
                            <tr>
                                <td><input type="hidden" form="pcForm" name="Attributes[0].Name" value="@FftName" /><strong>@FftName</strong></td>
                                <td>
                                    <input type="text" form="pcForm" name="Attributes[0].Value" id="pc_FreeFormatText" class="form-control form-control-sm pc-fft"
                                           value="@(fft?.Value ?? " ")" aria-label="@FftName" autocomplete="off" />
                                </td>
                                <td></td>
                            </tr>
                            @for (var i = 0; i < extraAttrs.Count; i++)
                            {
                                var idx = i + 1;
                                <tr class="pc-attr-row">
                                    <td><input type="text" form="pcForm" name="Attributes[@idx].Name" value="@extraAttrs[i].Name" class="form-control form-control-sm" maxlength="100" /></td>
                                    <td><input type="text" form="pcForm" name="Attributes[@idx].Value" value="@extraAttrs[i].Value" class="form-control form-control-sm" /></td>
                                    <td><button type="button" class="vs-icon-btn pc-attr-remove" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><i class="bi bi-x-lg"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </pems-related-table>
                </div>
                <button type="button" class="vs-btn vs-btn--sm" id="pcAddAttr" data-next-index="@(extraAttrs.Count + 1)"><i class="bi bi-plus-lg"></i> @Localizer["Pc_Btn_AddAttribute"]</button>
                <div class="form-text">@Localizer["Pc_Hint_FreeFormat"]</div>
            </section>
        </div>

        @* ------------------------------------------------ Part Classification *@
        <div class="col-lg-8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-tags"></i> @Localizer["Pc_Sec_Classification"]</h2>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label" for="pc_AssetType">@L("AssetType")</label>
                        <select id="pc_AssetType" form="pcForm" name="AssetType" class="form-select form-select-sm">
                            @foreach (var at in new[] { "None", "FixedAsset", "LowValueAsset" })
                            { <option value="@at" selected="@(f.AssetType == at)">@Localizer["Pc_Asset_" + at]</option> }
                        </select>
                        <div class="form-text">@Localizer["Pc_Hint_LowValue"]</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_CommodityGroup1Id">@L("CommodityGroup1Id") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_CommodityGroup1Id" form="pcForm" name="CommodityGroup1Id" class="form-select form-select-sm" data-pc-group1>
                            <option value=""></option>
                            @foreach (var g in Model.Group1) { <option value="@g.Id" selected="@(f.CommodityGroup1Id == g.Id)">@g.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_CommodityGroup2Id">@L("CommodityGroup2Id") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_CommodityGroup2Id" form="pcForm" name="CommodityGroup2Id" class="form-select form-select-sm" data-pc-group2>
                            <option value=""></option>
                            @foreach (var g in Model.Group2) { <option value="@g.Id" selected="@(f.CommodityGroup2Id == g.Id)">@g.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_ProductFamilyId">@L("ProductFamilyId") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_ProductFamilyId" form="pcForm" name="ProductFamilyId" class="form-select form-select-sm">
                            <option value=""></option>
                            @foreach (var p in Model.ProductFamilies) { <option value="@p.Id" selected="@(f.ProductFamilyId == p.Id)">@p.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_UnitOfMeasureId">@L("UnitOfMeasureId") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_UnitOfMeasureId" form="pcForm" name="UnitOfMeasureId" class="form-select form-select-sm">
                            <option value=""></option>
                            @foreach (var u in Model.Units) { <option value="@u.Id" selected="@(f.UnitOfMeasureId == u.Id)">@u.Text@(string.IsNullOrEmpty(u.Extra) ? "" : " - " + u.Extra)</option> }
                        </select>
                        @if (isChange) { <div class="form-text">@Localizer["Pc_Hint_UomLocked"]</div> }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="pc_ManufacturerId_text">@L("ManufacturerId") <span class="pc-req" aria-hidden="true">*</span></label>
                        <div class="pc-lookup" data-url="@lookupBase/Manufacturers" data-name="ManufacturerId" data-form="pcForm" data-id="@f.ManufacturerId"
                             data-text="@(f.IsNewManufacturer ? "" : Label("ManufacturerId"))" data-input-id="pc_ManufacturerId_text" data-pc-manufacturer></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_NewManufacturerName">@L("IsNewManufacturer")</label>
                        <div class="input-group input-group-sm">
                            <div class="input-group-text">
                                <input type="checkbox" id="pc_IsNewManufacturer" form="pcForm" name="IsNewManufacturer" value="true" checked="@f.IsNewManufacturer" aria-label="@L("IsNewManufacturer")" />
                                <input type="hidden" form="pcForm" name="IsNewManufacturer" value="false" />
                            </div>
                            <input id="pc_NewManufacturerName" form="pcForm" name="NewManufacturerName" value="@f.NewManufacturerName" class="form-control text-uppercase" maxlength="200"
                                   placeholder="@Localizer["Pc_Hint_NewManufacturer"]" disabled="@(!f.IsNewManufacturer)" />
                        </div>
                        <div class="form-text" id="pc_ManufacturerCheck"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_ManufacturerPartNumber">@L("ManufacturerPartNumber")@if (isChange) { <span class="pc-req" aria-hidden="true"> *</span> }</label>
                        <input id="pc_ManufacturerPartNumber" form="pcForm" name="ManufacturerPartNumber" value="@f.ManufacturerPartNumber" class="form-control form-control-sm" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_SupplierId_text">@L("SupplierId")</label>
                        <div class="pc-lookup" data-url="@lookupBase/Suppliers" data-name="SupplierId" data-form="pcForm" data-id="@f.SupplierId"
                             data-text="@Label("SupplierId")" data-input-id="pc_SupplierId_text"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_SupplierPartNumber">@L("SupplierPartNumber")</label>
                        <input id="pc_SupplierPartNumber" form="pcForm" name="SupplierPartNumber" value="@f.SupplierPartNumber" class="form-control form-control-sm" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_PartPrice">@L("PartPrice")</label>
                        <div class="input-group input-group-sm">
                            <input id="pc_PartPrice" form="pcForm" name="PartPrice" type="number" step="0.01" min="0" value="@f.PartPrice" class="form-control" />
                            <select form="pcForm" name="CurrencyId" class="form-select" aria-label="@L("CurrencyId")">
                                <option value=""></option>
                                @foreach (var c in Model.Currencies) { <option value="@c.Id" selected="@(f.CurrencyId == c.Id)">@c.Text@(string.IsNullOrEmpty(c.Extra) ? "" : " - " + c.Extra)</option> }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_TypeDesignationId">@L("TypeDesignationId")</label>
                        <select id="pc_TypeDesignationId" form="pcForm" name="TypeDesignationId" class="form-select form-select-sm" data-pc-type>
                            <option value=""></option>
                            @foreach (var t in Model.TypeDesignations) { <option value="@t.Id" data-flags="@t.Extra" selected="@(f.TypeDesignationId == t.Id)">@t.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <span class="form-label d-block">@L("IsCritical") <span class="pc-req" aria-hidden="true">*</span></span>
                        <span class="vs-pill vs-pill--neutral" id="pcIsCritical">@(d.IsCritical ? Localizer["Pc_Yes"] : Localizer["Pc_No"])</span>
                    </div>
                    <div class="col-md-3">
                        <span class="form-label d-block">@L("IsCapital")</span>
                        <span class="vs-pill vs-pill--neutral" id="pcIsCapital">@(d.IsCapital ? Localizer["Pc_Yes"] : Localizer["Pc_No"])</span>
                    </div>
                </div>
            </section>
        </div>

        @* ------------------------------------------------ Other Info *@
        <div class="col-lg-4">
            <section class="vs-panel pc-card mb-3" id="pcDedup"
                     data-url-existing="/Warehouse/PartCatalogueDedup/ExistingParts"
                     data-url-duplicates="/Warehouse/PartCatalogueDedup/DuplicateCandidates"
                     data-request-id="@d.Id"
                     data-txt-none="@Localizer["Pc_Dedup_None"]"
                     data-txt-ambiguous="@Localizer["Pc_Dedup_Ambiguous"]"
                     data-txt-inflight="@Localizer["Pc_Dedup_InFlight"]"
                     data-txt-error="@Localizer["Pc_Dedup_Error"]">
                <h2 class="vs-section__title"><i class="bi bi-search"></i> @Localizer["Pc_Dedup_Title"]</h2>
                <p class="form-text">@Localizer["Pc_Dedup_Hint"]</p>
                <label class="form-label" for="pcDedupQuery">@Localizer["Pc_Dedup_SearchLabel"]</label>
                <div class="input-group input-group-sm mb-2">
                    <input id="pcDedupQuery" type="search" class="form-control" maxlength="100" autocomplete="off" />
                    <button type="button" class="vs-btn vs-btn--sm" id="pcDedupSearch">@Localizer["Pc_Dedup_Search"]</button>
                </div>
                <button type="button" class="vs-btn vs-btn--sm mb-2" id="pcDedupCheck">@Localizer["Pc_Dedup_Check"]</button>
                <div id="pcDedupResult" role="status" aria-live="polite" class="small"></div>
            </section>

            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-paperclip"></i> @Localizer["Pc_Sec_OtherInfo"]</h2>
                <div class="mb-2"><label class="form-label" for="pc_SparePartSerialNo">@L("SparePartSerialNo")</label><input id="pc_SparePartSerialNo" form="pcForm" name="SparePartSerialNo" value="@f.SparePartSerialNo" class="form-control form-control-sm" maxlength="100" /></div>
                <div class="mb-2"><label class="form-label" for="pc_EquipmentSerialNo">@L("EquipmentSerialNo")</label><input id="pc_EquipmentSerialNo" form="pcForm" name="EquipmentSerialNo" value="@f.EquipmentSerialNo" class="form-control form-control-sm" maxlength="100" /></div>
                <div class="mb-2"><label class="form-label" for="pc_ManufacturerDrawingNo">@L("ManufacturerDrawingNo")</label><input id="pc_ManufacturerDrawingNo" form="pcForm" name="ManufacturerDrawingNo" value="@f.ManufacturerDrawingNo" class="form-control form-control-sm" maxlength="100" /></div>
                <div class="mb-2"><label class="form-label" for="pc_DocumentNo">@L("DocumentNo")</label><input id="pc_DocumentNo" form="pcForm" name="DocumentNo" value="@f.DocumentNo" class="form-control form-control-sm" maxlength="100" /></div>

                <label class="form-label">@L("Attachments")</label>
                <ul class="list-unstyled small mb-2">
                    @foreach (var at in d.Attachments)
                    {
                        <li class="d-flex align-items-center justify-content-between gap-2 border-bottom py-1">
                            <a asp-action="Download" asp-route-id="@d.Id" asp-route-attachmentId="@at.Id" class="text-truncate">@at.FileName</a>
                            <span class="text-muted">@Localizer["Pc_Kind_" + at.Kind]</span>
                            <form asp-action="RemoveAttachment" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="attachmentId" value="@at.Id" />
                                <button class="vs-icon-btn" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><i class="bi bi-trash"></i></button>
                            </form>
                        </li>
                    }
                </ul>
                @if (!d.Attachments.Any()) { <div class="text-muted small mb-2">@Localizer["Pc_Empty_Attachments"]</div> }
                <button type="button" class="vs-btn vs-btn--sm" data-bs-toggle="modal" data-bs-target="#pcAttachModal"><i class="bi bi-upload"></i> @Localizer["Pc_Btn_Upload"]</button>
                <div class="form-text">@Localizer["Pc_Hint_PosItem"]</div>
            </section>
        </div>

        @* ------------------------------------------------ Inventory Planning *@
        <div class="col-12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-box-seam"></i> @Localizer["Pc_Sec_Planning"]</h2>
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label" for="pc_PlanningMethodId">@L("PlanningMethodId")</label>
                        <select id="pc_PlanningMethodId" form="pcForm" name="PlanningMethodId" class="form-select form-select-sm" data-pc-planning>
                            <option value=""></option>
                            @foreach (var p in Model.PlanningMethods) { <option value="@p.Id" data-code="@p.Code" selected="@(f.PlanningMethodId == p.Id)">@p.Text@(string.IsNullOrEmpty(p.Extra) ? "" : " - " + p.Extra)</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_MinimumStock">@L("MinimumStock") <span class="pc-req" aria-hidden="true">*</span></label>
                        <input id="pc_MinimumStock" form="pcForm" name="MinimumStock" type="number" step="0.0001" min="0" value="@f.MinimumStock" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_MaxConsumptionRate">@L("MaxConsumptionRate") <span class="pc-req" aria-hidden="true">*</span></label>
                        <input id="pc_MaxConsumptionRate" form="pcForm" name="MaxConsumptionRate" type="number" step="0.0001" min="0" value="@f.MaxConsumptionRate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_FirstPurchaseQuantity">@L("FirstPurchaseQuantity")</label>
                        <input id="pc_FirstPurchaseQuantity" form="pcForm" name="FirstPurchaseQuantity" type="number" step="0.0001" min="0" value="@f.FirstPurchaseQuantity" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_PrimaryIssuedRequired">@L("PrimaryIssuedRequired") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_PrimaryIssuedRequired" form="pcForm" name="PrimaryIssuedRequired" class="form-select form-select-sm">
                            <option value="false" selected="@(!f.PrimaryIssuedRequired)">@Localizer["Pc_No"]</option>
                            <option value="true" selected="@f.PrimaryIssuedRequired">@Localizer["Pc_Yes"]</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_IssuedQty">@L("IssuedQty")</label>
                        <input id="pc_IssuedQty" form="pcForm" name="IssuedQty" type="number" step="0.0001" min="0" value="@f.IssuedQty" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="pc_StockGradeId">@L("StockGradeId") <span class="pc-req" aria-hidden="true">*</span></label>
                        <select id="pc_StockGradeId" form="pcForm" name="StockGradeId" class="form-select form-select-sm">
                            <option value=""></option>
                            @foreach (var g in Model.StockGrades) { <option value="@g.Id" selected="@(f.StockGradeId == g.Id)">@g.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_WantedReceiptDate">@L("WantedReceiptDate")</label>
                        <input id="pc_WantedReceiptDate" form="pcForm" name="WantedReceiptDate" type="date" value="@f.WantedReceiptDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="pc_StorageVolume">@L("StorageVolume")</label>
                        <input id="pc_StorageVolume" form="pcForm" name="StorageVolume" value="@f.StorageVolume" class="form-control form-control-sm" maxlength="100" />
                    </div>
                </div>
                <div class="form-text">@Localizer["Pc_Hint_Planning"]</div>
            </section>
        </div>

        @* ------------------------------------------------ Notes *@
        <div class="col-12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-chat-left-text"></i> @L("Notes")</h2>
                <div class="pc-table-scroll mb-2">
                    <pems-related-table>
                        <thead><tr><th>@Localizer["Pc_Col_Date"]</th><th>@Localizer["Pc_Col_Person"]</th><th>@Localizer["Pc_Col_Stage"]</th><th>@L("Text")</th></tr></thead>
                        <tbody>
                        @foreach (var n in d.Notes)
                        {
                            <tr><td class="vs-num text-nowrap">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td><td>@n.AuthorName</td><td>@(string.IsNullOrEmpty(n.StepKey) ? "" : Localizer["Pc_Step_" + n.StepKey].Value)</td><td>@n.Text</td></tr>
                        }
                        </tbody>
                    </pems-related-table>
                    @if (!d.Notes.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Notes"]</div> }
                </div>
                <form asp-action="AddNote" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="returnTo" value="edit" />
                    <input name="text" class="form-control form-control-sm" maxlength="2000" placeholder="@Localizer["Pc_Hint_NoteReply"]" aria-label="@L("Notes")" />
                    <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-plus-lg"></i> @Localizer["Pc_Btn_AddNote"]</button>
                </form>
            </section>
        </div>
    </div>
</div>

@* شماره‌دهی (فرم مستقل - تودرتو نیست) *@
<form id="pcNumberForm" asp-action="GenerateNumber" method="post">
    <input type="hidden" name="id" value="@d.Id" />
    @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
</form>

<div class="modal fade" id="pcEquipModal" tabindex="-1" aria-labelledby="pcEquipModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AddEquipment" method="post" class="modal-content">
            <input type="hidden" name="id" value="@d.Id" />
            <div class="modal-header"><h5 class="modal-title" id="pcEquipModalLabel">@Localizer["Pc_Btn_AddEquipment"]</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Pc_Btn_Close"]"></button></div>
            <div class="modal-body">
                @if (f.IsNewEquipment)
                {
                    <div class="mb-2"><label class="form-label" for="pc_equipText">@L("EquipmentText")</label><input id="pc_equipText" name="equipmentText" class="form-control" maxlength="300" required /></div>
                }
                else
                {
                    <div class="mb-2">
                        <label class="form-label" for="pc_equipId_text">@L("EquipmentId")</label>
                        <div class="pc-lookup" data-url="@lookupBase/Equipment" data-name="equipmentId" data-input-id="pc_equipId_text"></div>
                    </div>
                }
                <div class="mb-2"><label class="form-label" for="pc_equipQty">@L("InstalledQuantity")</label><input id="pc_equipQty" name="installedQuantity" type="number" step="0.0001" min="0" value="1" class="form-control" required /></div>
                <div class="form-text">@Localizer["Pc_Hint_NewEquipment"]</div>
            </div>
            <div class="modal-footer"><button type="button" class="vs-btn vs-btn--sm" data-bs-dismiss="modal">@Localizer["Pc_Btn_Close"]</button><button type="submit" class="vs-btn vs-btn--primary vs-btn--sm">@Localizer["Pc_Btn_Save"]</button></div>
        </form>
    </div>
</div>

<div class="modal fade" id="pcAttachModal" tabindex="-1" aria-labelledby="pcAttachModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="modal-content">
            <input type="hidden" name="id" value="@d.Id" />
            <div class="modal-header"><h5 class="modal-title" id="pcAttachModalLabel">@Localizer["Pc_Btn_Upload"]</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Pc_Btn_Close"]"></button></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label" for="pc_attFile">@L("File")</label><input id="pc_attFile" type="file" name="file" class="form-control" required /></div>
                <div class="mb-2">
                    <label class="form-label" for="pc_attKind">@L("AttachmentKind")</label>
                    <select id="pc_attKind" name="kind" class="form-select">
                        @foreach (var k in new[] { "Document", "Drawing", "Support" }) { <option value="@k">@Localizer["Pc_Kind_" + k]</option> }
                    </select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="vs-btn vs-btn--sm" data-bs-dismiss="modal">@Localizer["Pc_Btn_Close"]</button><button type="submit" class="vs-btn vs-btn--primary vs-btn--sm">@Localizer["Pc_Btn_Upload"]</button></div>
        </form>
    </div>
</div>

<template id="pcAttrTemplate">
    <tr class="pc-attr-row">
        <td><input type="text" form="pcForm" name="Attributes[__i__].Name" class="form-control form-control-sm" maxlength="100" /></td>
        <td><input type="text" form="pcForm" name="Attributes[__i__].Value" class="form-control form-control-sm" /></td>
        <td><button type="button" class="vs-icon-btn pc-attr-remove" title="@Localizer["Pc_Btn_Remove"]" aria-label="@Localizer["Pc_Btn_Remove"]"><i class="bi bi-x-lg"></i></button></td>
    </tr>
</template>

@section Scripts {
    <script src="~/js/pems-part-catalogue.js" asp-append-version="true"></script>
    <script src="~/js/pems-part-catalogue-dedup.js" asp-append-version="true"></script>
}
