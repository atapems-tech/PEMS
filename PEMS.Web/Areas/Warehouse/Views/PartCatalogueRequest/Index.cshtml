@model PcIndexViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var f = Model.Filter;
    var s = Model.Summary;
    var views = new[] { "all", "mine", "awaiting" };
    var statuses = new[] { "Draft", "InApproval", "OrgResolution", "Returned", "Completed", "Cancelled" };
    var filterCount = (f.View != "all" ? 1 : 0) + (string.IsNullOrEmpty(f.Status) ? 0 : 1) + (string.IsNullOrEmpty(f.RequestType) ? 0 : 1)
                      + (f.Urgent.HasValue ? 1 : 0) + (f.SectionId.HasValue ? 1 : 0) + (f.FromDate.HasValue ? 1 : 0) + (f.ToDate.HasValue ? 1 : 0);
    var sectionText = f.SectionId.HasValue ? Model.Sections.FirstOrDefault(x => x.Id == f.SectionId)?.Text ?? f.SectionId.ToString() : null;

    string ViewText(string v) => v switch { "mine" => Localizer["Pc_Tab_Mine"].Value, "awaiting" => Localizer["Pc_Tab_Awaiting"].Value, _ => Localizer["Pc_Tab_All"].Value };
    string StatusPill(string status) => status switch
    {
        "Draft" => "vs-pill--neutral",
        "InApproval" => "vs-pill--info",
        "Returned" => "vs-pill--warning",
        "OrgResolution" => "vs-pill--warning",
        "Completed" => "vs-pill--success",
        _ => "vs-pill--danger"
    };
    string StatusIcon(string status) => status switch
    {
        "Draft" => "bi-pencil",
        "InApproval" => "bi-hourglass-split",
        "Returned" => "bi-arrow-return-left",
        "OrgResolution" => "bi-diagram-3",
        "Completed" => "bi-check-circle",
        _ => "bi-x-circle"
    };

    string Query(string? skip)
    {
        var qs = new List<string>();
        if (!string.IsNullOrEmpty(f.Search) && skip != "search") qs.Add($"Search={Uri.EscapeDataString(f.Search)}");
        if (!string.IsNullOrEmpty(f.Status) && skip != "status") qs.Add($"Status={Uri.EscapeDataString(f.Status)}");
        if (!string.IsNullOrEmpty(f.RequestType) && skip != "type") qs.Add($"RequestType={Uri.EscapeDataString(f.RequestType)}");
        if (f.Urgent.HasValue && skip != "urgent") qs.Add($"Urgent={f.Urgent.Value.ToString().ToLowerInvariant()}");
        if (f.SectionId.HasValue && skip != "section") qs.Add($"SectionId={f.SectionId}");
        if (f.FromDate.HasValue && skip != "from") qs.Add($"FromDate={f.FromDate:yyyy-MM-dd}");
        if (f.ToDate.HasValue && skip != "to") qs.Add($"ToDate={f.ToDate:yyyy-MM-dd}");
        if (skip != "view") qs.Add($"View={f.View}");
        return string.Join("&", qs);
    }
    string Without(string key) { var q = Query(key); return Url.Action("Index") + (q.Length > 0 ? "?" + q : ""); }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

<nav class="vs-subnav" aria-label="@Localizer["Pc_Menu"]">
    <a asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Index" class="active" aria-current="page">@Localizer["Pc_Menu"]</a>
    <a asp-area="Warehouse" asp-controller="PartCatalogueAdmin" asp-action="Index">@Localizer["Pc_Title_Admin"]</a>
</nav>

@* SCRUM-337 W3: built from the PEMS.UI list-page component. The count chips are the KPI row (shown first); the view
   (all / mine / awaiting me) and the filters of the old side panel are in the filters dropdown, each active one a chip;
   the search opens over the title; the two "new request" actions stay in the toolbar. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Pc_Menu"]" heading-title="@Localizer["PcL_Hint"]" total="@Model.Page.TotalCount">
            <pems-list-search id="pcSearch" action="@Url.Action("Index")" input-id="pcQ" name="Search" value="@f.Search" placeholder="@Localizer["Pc_Search_Placeholder"]">
                <input type="hidden" name="View" value="@f.View" />
                @if (!string.IsNullOrEmpty(f.Status)) { <input type="hidden" name="Status" value="@f.Status" /> }
                @if (!string.IsNullOrEmpty(f.RequestType)) { <input type="hidden" name="RequestType" value="@f.RequestType" /> }
                @if (f.Urgent.HasValue) { <input type="hidden" name="Urgent" value="@f.Urgent.Value.ToString().ToLowerInvariant()" /> }
                @if (f.SectionId.HasValue) { <input type="hidden" name="SectionId" value="@f.SectionId" /> }
                @if (f.FromDate.HasValue) { <input type="hidden" name="FromDate" value="@f.FromDate.Value.ToString("yyyy-MM-dd")" /> }
                @if (f.ToDate.HasValue) { <input type="hidden" name="ToDate" value="@f.ToDate.Value.ToString("yyyy-MM-dd")" /> }
            </pems-list-search>
            <pems-list-tools search-for="pcSearch">
                <pems-list-filters form-id="pcFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    @if (!string.IsNullOrEmpty(f.Search)) { <input type="hidden" name="Search" value="@f.Search" /> }
                    <pems-list-filter-select id="pcFView" name="View" label="@Localizer["PcL_View"]" value="@f.View"
                                             items="@views.Select(v => new SelectListItem(ViewText(v), v))" />
                    <pems-list-filter-select id="pcFStatus" name="Status" label="@Localizer["Pc_Col_Status"]" value="@f.Status"
                                             all-text="@Localizer["Pc_Filter_All"]" items="@statuses.Select(st => new SelectListItem(Localizer["Pc_Status_" + st].Value, st))" />
                    <pems-list-filter-select id="pcFType" name="RequestType" label="@Localizer["Pc_Col_Type"]" value="@f.RequestType"
                                             all-text="@Localizer["Pc_Filter_All"]" items="@(new[] { new SelectListItem(Localizer["Pc_Type_Add"].Value, "Add"), new SelectListItem(Localizer["Pc_Type_Change"].Value, "Change") })" />
                    <pems-list-filter-select id="pcFUrgent" name="Urgent" label="@Localizer["Pc_Urgent"]" value="@f.Urgent?.ToString().ToLowerInvariant()"
                                             all-text="@Localizer["Pc_Filter_All"]" items="@(new[] { new SelectListItem(Localizer["Pc_Yes"].Value, "true"), new SelectListItem(Localizer["Pc_No"].Value, "false") })" />
                    <pems-list-filter-select id="pcFSection" name="SectionId" label="@Localizer["Pc_F_SectionId"]" value="@f.SectionId?.ToString()"
                                             all-text="@Localizer["Pc_Filter_All"]" items="@Model.Sections.Select(sec => new SelectListItem(sec.Text, sec.Id.ToString()))" />
                    <div>
                        <label class="lp-lbl" for="pcFFrom">@Localizer["Pc_Filter_From"]</label>
                        <input id="pcFFrom" type="date" name="FromDate" value="@f.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div>
                        <label class="lp-lbl" for="pcFTo">@Localizer["Pc_Filter_To"]</label>
                        <input id="pcFTo" type="date" name="ToDate" value="@f.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="pcKpis" storage-key="pems.partCatalogue.kpis" open="true" />
                <pems-list-reset-columns grid-key="PartCatalogueRequests" />
                @if (Model.CanCreate)
                {
                    <form asp-action="New" method="post" class="d-inline">
                        <input type="hidden" name="type" value="Change" />
                        <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-pencil-square" aria-hidden="true"></i> <span class="lp-compose-label">@Localizer["Pc_Btn_NewChange"]</span></button>
                    </form>
                    <form asp-action="New" method="post" class="d-inline">
                        <input type="hidden" name="type" value="Add" />
                        <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> <span class="lp-compose-label">@Localizer["Pc_Btn_NewAdd"]</span></button>
                    </form>
                }
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="pcKpis" open="true">
            <a class="vs-chip" asp-action="Index" asp-route-View="@f.View">@Localizer["Pc_Chip_Total"] <strong>@s.Total</strong></a>
            <a class="vs-chip" asp-action="Index" asp-route-Status="Draft">@Localizer["Pc_Status_Draft"] <strong>@s.Draft</strong></a>
            <a class="vs-chip" asp-action="Index" asp-route-Status="InApproval">@Localizer["Pc_Status_InApproval"] <strong>@s.InApproval</strong></a>
            <a class="vs-chip" asp-action="Index" asp-route-Status="Returned">@Localizer["Pc_Status_Returned"] <strong>@s.Returned</strong></a>
            <a class="vs-chip" asp-action="Index" asp-route-Status="Completed">@Localizer["Pc_Status_Completed"] <strong>@s.Completed</strong></a>
            <a class="vs-chip" asp-action="Index" asp-route-Status="Cancelled">@Localizer["Pc_Status_Cancelled"] <strong>@s.Cancelled</strong></a>
            <a class="vs-chip @(s.Urgent > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-Urgent="true"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Pc_Urgent"] <strong>@s.Urgent</strong></a>
            <a class="vs-chip @(s.AwaitingMe > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-View="awaiting">@Localizer["Pc_Tab_Awaiting"] <strong>@s.AwaitingMe</strong></a>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(f.Search)) { <pems-list-chip label="@Localizer["Ed_Search"]" value="@f.Search" remove-href="@Without("search")" /> }
            @if (f.View != "all") { <pems-list-chip label="@Localizer["PcL_View"]" value="@ViewText(f.View)" remove-href="@Without("view")" /> }
            @if (!string.IsNullOrEmpty(f.Status)) { <pems-list-chip label="@Localizer["Pc_Col_Status"]" value="@Localizer["Pc_Status_" + f.Status]" remove-href="@Without("status")" /> }
            @if (!string.IsNullOrEmpty(f.RequestType)) { <pems-list-chip label="@Localizer["Pc_Col_Type"]" value="@Localizer["Pc_Type_" + f.RequestType]" remove-href="@Without("type")" /> }
            @if (f.Urgent.HasValue) { <pems-list-chip label="@Localizer["Pc_Urgent"]" value="@(f.Urgent.Value ? Localizer["Pc_Yes"] : Localizer["Pc_No"])" remove-href="@Without("urgent")" /> }
            @if (f.SectionId.HasValue) { <pems-list-chip label="@Localizer["Pc_F_SectionId"]" value="@sectionText" remove-href="@Without("section")" /> }
            @if (f.FromDate.HasValue) { <pems-list-chip label="@Localizer["Pc_Filter_From"]" value="@f.FromDate.Value.ToString("yyyy-MM-dd")" remove-href="@Without("from")" /> }
            @if (f.ToDate.HasValue) { <pems-list-chip label="@Localizer["Pc_Filter_To"]" value="@f.ToDate.Value.ToString("yyyy-MM-dd")" remove-href="@Without("to")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="PartCatalogueRequests" empty="@(!Model.Page.Items.Any())" empty-text="@Localizer["Pc_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="number" data-resizable="true" data-min-width="110" data-max-width="240" style="width:170px">@Localizer["Pc_Col_Number"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="70" data-max-width="140" style="width:90px">@Localizer["Pc_Col_Type"]</th>
                        <th data-col-key="section" data-resizable="true" data-min-width="70" data-max-width="160" style="width:100px" class="vs-hide-md">@Localizer["Pc_F_SectionId"]</th>
                        <th data-col-key="class" data-resizable="true" data-min-width="140" data-max-width="420">@Localizer["Pc_F_TechnicalClassId"]</th>
                        <th data-col-key="requester" data-resizable="true" data-min-width="100" data-max-width="240" style="width:150px" class="vs-hide-md">@Localizer["Pc_Col_Requester"]</th>
                        <th data-col-key="status" data-resizable="true" data-min-width="120" data-max-width="260" style="width:180px">@Localizer["Pc_Col_Status"]</th>
                        <th data-col-key="partNo" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px" class="vs-hide-md">@Localizer["Pc_Col_PartNo"]</th>
                        <th data-col-key="created" data-resizable="true" data-min-width="90" data-max-width="160" style="width:110px" class="vs-hide-md">@Localizer["Pc_Col_Created"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Page.Items)
                    {
                        <tr class="lp-row @(r.Urgent && r.Status is "InApproval" or "Draft" or "Returned" ? "pc-urgent-row" : "")">
                            <td class="lp-no">
                                <a asp-action="@(r.Status is "Draft" or "Returned" ? "Edit" : "Details")" asp-route-id="@r.Id" class="lp-subject">@(r.RequestNumber ?? "#" + r.Id)</a>
                                @if (r.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon ms-1"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Pc_Urgent"]</span> }
                            </td>
                            <td class="small">@Localizer["Pc_Type_" + r.RequestType]</td>
                            <td class="small vs-hide-md">@r.SectionCode</td>
                            <td>
                                <span class="vs-title-cell" title="@r.TechnicalClassDescription">@r.TechnicalClassCode</span>
                                <span class="vs-sub">@r.TechnicalClassDescription</span>
                            </td>
                            <td class="small vs-hide-md">@r.RequesterName</td>
                            <td>
                                <span class="vs-pill vs-pill--icon @StatusPill(r.Status)"><i class="bi @StatusIcon(r.Status)" aria-hidden="true"></i> @Localizer["Pc_Status_" + r.Status]</span>
                                @if (!string.IsNullOrEmpty(r.CurrentStepKey)) { <span class="vs-sub">@Localizer["Pc_Step_" + r.CurrentStepKey]</span> }
                            </td>
                            <td class="small vs-hide-md"><span class="vs-num">@r.AssignedPartNumber</span></td>
                            <td class="small vs-hide-md text-muted"><span class="vs-num">@r.CreatedDate.ToString("yyyy-MM-dd")</span></td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page.Page,
                    TotalPages = Model.Page.TotalPages,
                    TotalCount = Model.Page.TotalCount,
                    PageSize = Model.Page.PageSize,
                    GridKey = "PartCatalogueRequests",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
