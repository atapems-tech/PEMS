@model PcIndexViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var f = Model.Filter;
    var s = Model.Summary;
    var hasAdvanced = !string.IsNullOrEmpty(f.Status) || !string.IsNullOrEmpty(f.RequestType) || f.Urgent.HasValue || f.SectionId.HasValue || f.FromDate.HasValue || f.ToDate.HasValue;

    string StatusPill(string status) => status switch
    {
        "Draft" => "vs-pill--neutral",
        "InApproval" => "vs-pill--info",
        "Returned" => "vs-pill--warning",
        "OrgResolution" => "vs-pill--warning",
        "Completed" => "vs-pill--success",
        _ => "vs-pill--danger"
    };
    string StatusIcon(string status) => status switch
    {
        "Draft" => "bi-pencil",
        "InApproval" => "bi-hourglass-split",
        "Returned" => "bi-arrow-return-left",
        "OrgResolution" => "bi-diagram-3",
        "Completed" => "bi-check-circle",
        _ => "bi-x-circle"
    };

    var qs = new List<string>();
    if (!string.IsNullOrEmpty(f.Search)) qs.Add($"Search={Uri.EscapeDataString(f.Search)}");
    if (!string.IsNullOrEmpty(f.Status)) qs.Add($"Status={Uri.EscapeDataString(f.Status)}");
    if (!string.IsNullOrEmpty(f.RequestType)) qs.Add($"RequestType={Uri.EscapeDataString(f.RequestType)}");
    if (f.Urgent.HasValue) qs.Add($"Urgent={f.Urgent.Value.ToString().ToLowerInvariant()}");
    if (f.SectionId.HasValue) qs.Add($"SectionId={f.SectionId}");
    if (f.FromDate.HasValue) qs.Add($"FromDate={f.FromDate:yyyy-MM-dd}");
    if (f.ToDate.HasValue) qs.Add($"ToDate={f.ToDate:yyyy-MM-dd}");
    qs.Add($"View={f.View}");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
}

<div class="vs-page">

    <nav class="vs-subnav" aria-label="@Localizer["Pc_Menu"]">
        <a asp-area="Warehouse" asp-controller="PartCatalogueRequest" asp-action="Index" class="active" aria-current="page">@Localizer["Pc_Menu"]</a>
        <a asp-area="Warehouse" asp-controller="PartCatalogueAdmin" asp-action="Index">@Localizer["Pc_Title_Admin"]</a>
    </nav>

    <div class="vs-chips">
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-View="@f.View">@Localizer["Pc_Chip_Total"] <strong>@s.Total</strong></a>
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-Status="Draft">@Localizer["Pc_Status_Draft"] <strong>@s.Draft</strong></a>
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-Status="InApproval">@Localizer["Pc_Status_InApproval"] <strong>@s.InApproval</strong></a>
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-Status="Returned">@Localizer["Pc_Status_Returned"] <strong>@s.Returned</strong></a>
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-Status="Completed">@Localizer["Pc_Status_Completed"] <strong>@s.Completed</strong></a>
        <a class="vs-chip text-decoration-none" asp-action="Index" asp-route-Status="Cancelled">@Localizer["Pc_Status_Cancelled"] <strong>@s.Cancelled</strong></a>
        <a class="vs-chip text-decoration-none @(s.Urgent > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-Urgent="true"><i class="bi bi-exclamation-triangle"></i> @Localizer["Pc_Urgent"] <strong>@s.Urgent</strong></a>
        <a class="vs-chip text-decoration-none @(s.AwaitingMe > 0 ? "vs-chip--danger" : "")" asp-action="Index" asp-route-View="awaiting">@Localizer["Pc_Tab_Awaiting"] <strong>@s.AwaitingMe</strong></a>
    </div>

    <div class="vs-toolbar">
        <ul class="nav nav-pills pc-viewtabs" role="tablist">
            <li class="nav-item"><a class="nav-link py-1 @(f.View == "all" ? "active" : "")" asp-action="Index" asp-route-View="all">@Localizer["Pc_Tab_All"]</a></li>
            <li class="nav-item"><a class="nav-link py-1 @(f.View == "mine" ? "active" : "")" asp-action="Index" asp-route-View="mine">@Localizer["Pc_Tab_Mine"]</a></li>
            <li class="nav-item"><a class="nav-link py-1 @(f.View == "awaiting" ? "active" : "")" asp-action="Index" asp-route-View="awaiting">@Localizer["Pc_Tab_Awaiting"]</a></li>
        </ul>

        <form method="get" asp-action="Index" class="pems-search-bar" id="pcSearchForm">
            <i class="bi bi-search pems-search-icon"></i>
            <input type="text" class="form-control" name="Search" value="@f.Search" placeholder="@Localizer["Pc_Search_Placeholder"]" autocomplete="off" aria-label="@Localizer["Pc_Search_Placeholder"]" />
            <input type="hidden" name="View" value="@f.View" />
        </form>

        <button type="button" class="vs-btn vs-btn--sm" data-bs-toggle="offcanvas" data-bs-target="#pcFilters" aria-controls="pcFilters">
            <i class="bi bi-sliders"></i> @Localizer["Pc_Filters"]
        </button>

        @if (Model.CanCreate)
        {
            <div class="vs-toolbar__end">
                <form asp-action="New" method="post" class="d-inline">
                    <input type="hidden" name="type" value="Add" />
                    <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-plus-lg"></i> @Localizer["Pc_Btn_NewAdd"]</button>
                </form>
                <form asp-action="New" method="post" class="d-inline">
                    <input type="hidden" name="type" value="Change" />
                    <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-pencil-square"></i> @Localizer["Pc_Btn_NewChange"]</button>
                </form>
            </div>
        }
    </div>

    @if (hasAdvanced)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (!string.IsNullOrEmpty(f.Status)) { <span class="pems-filter-chip">@Localizer["Pc_Col_Status"]: @Localizer["Pc_Status_" + f.Status]</span> }
            @if (!string.IsNullOrEmpty(f.RequestType)) { <span class="pems-filter-chip">@Localizer["Pc_Col_Type"]: @Localizer["Pc_Type_" + f.RequestType]</span> }
            @if (f.Urgent.HasValue) { <span class="pems-filter-chip">@Localizer["Pc_Urgent"]</span> }
            <a asp-action="Index" asp-route-View="@f.View" class="small text-danger text-decoration-none">@Localizer["Pc_Filter_Reset"]</a>
        </div>
    }

    <div class="offcanvas offcanvas-end" tabindex="-1" id="pcFilters" aria-labelledby="pcFiltersLabel">
        <div class="offcanvas-header">
            <h6 class="offcanvas-title" id="pcFiltersLabel"><i class="bi bi-sliders"></i> @Localizer["Pc_Filters"]</h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Pc_Btn_Close"]"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <form method="get" asp-action="Index" class="flex-grow-1 d-flex flex-column">
                <input type="hidden" name="Search" value="@f.Search" />
                <input type="hidden" name="View" value="@f.View" />
                <div class="mb-3">
                    <label class="form-label" for="pcFStatus">@Localizer["Pc_Col_Status"]</label>
                    <select id="pcFStatus" name="Status" class="form-select form-select-sm">
                        <option value="">@Localizer["Pc_Filter_All"]</option>
                        @foreach (var st in new[] { "Draft", "InApproval", "OrgResolution", "Returned", "Completed", "Cancelled" })
                        { <option value="@st" selected="@(f.Status == st)">@Localizer["Pc_Status_" + st]</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pcFType">@Localizer["Pc_Col_Type"]</label>
                    <select id="pcFType" name="RequestType" class="form-select form-select-sm">
                        <option value="">@Localizer["Pc_Filter_All"]</option>
                        <option value="Add" selected="@(f.RequestType == "Add")">@Localizer["Pc_Type_Add"]</option>
                        <option value="Change" selected="@(f.RequestType == "Change")">@Localizer["Pc_Type_Change"]</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pcFUrgent">@Localizer["Pc_Urgent"]</label>
                    <select id="pcFUrgent" name="Urgent" class="form-select form-select-sm">
                        <option value="">@Localizer["Pc_Filter_All"]</option>
                        <option value="true" selected="@(f.Urgent == true)">@Localizer["Pc_Yes"]</option>
                        <option value="false" selected="@(f.Urgent == false)">@Localizer["Pc_No"]</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pcFSection">@Localizer["Pc_F_SectionId"]</label>
                    <select id="pcFSection" name="SectionId" class="form-select form-select-sm">
                        <option value="">@Localizer["Pc_Filter_All"]</option>
                        @foreach (var sec in Model.Sections)
                        { <option value="@sec.Id" selected="@(f.SectionId == sec.Id)">@sec.Text</option> }
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col"><label class="form-label" for="pcFFrom">@Localizer["Pc_Filter_From"]</label><input id="pcFFrom" type="date" name="FromDate" value="@f.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                    <div class="col"><label class="form-label" for="pcFTo">@Localizer["Pc_Filter_To"]</label><input id="pcFTo" type="date" name="ToDate" value="@f.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                </div>
                <div class="mt-auto d-flex gap-2 border-top pt-3">
                    <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm flex-fill justify-content-center"><i class="bi bi-funnel"></i> @Localizer["Pc_Filter_Apply"]</button>
                    <a asp-action="Index" asp-route-View="@f.View" class="vs-btn vs-btn--sm flex-fill justify-content-center">@Localizer["Pc_Filter_Reset"]</a>
                </div>
            </form>
        </div>
    </div>

    <div class="vs-panel">
        <div class="pems-grid-scroll table-scroll-area">
            <table class="table table-enterprise vs-dense pems-grid-table mb-0" data-grid-key="PartCatalogueRequests">
                <thead>
                    <tr>
                        <th>@Localizer["Pc_Col_Number"]</th>
                        <th>@Localizer["Pc_Col_Type"]</th>
                        <th class="vs-hide-md">@Localizer["Pc_F_SectionId"]</th>
                        <th>@Localizer["Pc_F_TechnicalClassId"]</th>
                        <th class="vs-hide-md">@Localizer["Pc_Col_Requester"]</th>
                        <th>@Localizer["Pc_Col_Status"]</th>
                        <th class="vs-hide-md">@Localizer["Pc_Col_PartNo"]</th>
                        <th class="vs-hide-md">@Localizer["Pc_Col_Created"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Page.Items)
                    {
                        <tr class="@(r.Urgent && r.Status is "InApproval" or "Draft" or "Returned" ? "pc-urgent-row" : "")">
                            <td>
                                <a asp-action="@(r.Status is "Draft" or "Returned" ? "Edit" : "Details")" asp-route-id="@r.Id" class="vs-num vs-num--strong text-decoration-none">@(r.RequestNumber ?? "#" + r.Id)</a>
                                @if (r.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon ms-1"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Pc_Urgent"]</span> }
                            </td>
                            <td>@Localizer["Pc_Type_" + r.RequestType]</td>
                            <td class="vs-hide-md">@r.SectionCode</td>
                            <td>
                                <span class="vs-title-cell" title="@r.TechnicalClassDescription">@r.TechnicalClassCode</span>
                                <span class="vs-sub">@r.TechnicalClassDescription</span>
                            </td>
                            <td class="vs-hide-md">@r.RequesterName</td>
                            <td>
                                <span class="vs-pill vs-pill--icon @StatusPill(r.Status)"><i class="bi @StatusIcon(r.Status)" aria-hidden="true"></i> @Localizer["Pc_Status_" + r.Status]</span>
                                @if (!string.IsNullOrEmpty(r.CurrentStepKey)) { <span class="vs-sub">@Localizer["Pc_Step_" + r.CurrentStepKey]</span> }
                            </td>
                            <td class="vs-hide-md">@r.AssignedPartNumber</td>
                            <td class="vs-hide-md text-muted"><span class="vs-num">@r.CreatedDate.ToString("yyyy-MM-dd")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Page.Items.Any()) { <div class="vs-empty"><i class="bi bi-inbox"></i>@Localizer["Pc_Empty"]</div> }
        </div>

        <div class="vs-panel__foot">
            @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
            {
                Page = Model.Page.Page,
                TotalPages = Model.Page.TotalPages,
                TotalCount = Model.Page.TotalCount,
                PageSize = Model.Page.PageSize,
                GridKey = "PartCatalogueRequests",
                BaseUrl = Url.Action("Index") ?? "",
                ExistingQueryString = string.Join("&", qs)
            })
        </div>
    </div>
</div>
