@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.InventoryTransactionRowDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var warehouses = ((IEnumerable<dynamic>)ViewBag.Warehouses).ToList();
    var types = new[] { "Receipt", "Issue", "Return", "Transfer", "Adjustment", "Reservation", "ReservationRelease" };
    var warehouseId = (int?)ViewBag.WarehouseId;
    var type = (string?)ViewBag.TransactionType;
    var from = (DateTime?)ViewBag.FromDate;
    var to = (DateTime?)ViewBag.ToDate;
    var warehouseCode = warehouseId.HasValue ? (string?)warehouses.FirstOrDefault(w => (int)w.WarehouseId == warehouseId.Value)?.Code : null;
    var filterCount = (warehouseId.HasValue ? 1 : 0) + (string.IsNullOrEmpty(type) ? 0 : 1) + (from.HasValue ? 1 : 0) + (to.HasValue ? 1 : 0);

    string TypeText(string? t) => VdrUi.Loc(Localizer, "ItL_Type_", t);
    string Query(string? skip)
    {
        var parts = new List<string>();
        if (warehouseId.HasValue && skip != "warehouse") parts.Add($"warehouseId={warehouseId}");
        if (!string.IsNullOrEmpty(type) && skip != "type") parts.Add($"transactionType={Uri.EscapeDataString(type)}");
        if (from.HasValue && skip != "from") parts.Add($"fromDate={from:yyyy-MM-dd}");
        if (to.HasValue && skip != "to") parts.Add($"toDate={to:yyyy-MM-dd}");
        return string.Join("&", parts);
    }
    string Without(string key) { var q = Query(key); return Url.Action("Index") + (q.Length > 0 ? "?" + q : ""); }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component. The filter row (warehouse, type, from, to) moved into the
   filters dropdown; every active filter is a chip. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["ItL_Title"]" heading-title="@Localizer["ItL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="itFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="itFilterWarehouse" name="warehouseId" label="@Localizer["ItL_Warehouse"]" value="@warehouseId?.ToString()"
                                             all-text="@Localizer["ItL_AllWarehouses"]" items="@warehouses.Select(w => new SelectListItem((string)w.Code, ((int)w.WarehouseId).ToString()))" />
                    <pems-list-filter-select id="itFilterType" name="transactionType" label="@Localizer["Cm_Type"]" value="@type"
                                             all-text="@Localizer["ItL_AllTypes"]" items="@types.Select(t => new SelectListItem(TypeText(t), t))" />
                    <div>
                        <label class="lp-lbl" for="itFilterFrom">@Localizer["ItL_From"]</label>
                        <input type="date" id="itFilterFrom" name="fromDate" value="@from?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div>
                        <label class="lp-lbl" for="itFilterTo">@Localizer["ItL_To"]</label>
                        <input type="date" id="itFilterTo" name="toDate" value="@to?.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                </pems-list-filters>
                <pems-list-reset-columns grid-key="InventoryTransaction" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (warehouseId.HasValue) { <pems-list-chip label="@Localizer["ItL_Warehouse"]" value="@(warehouseCode ?? warehouseId.ToString())" remove-href="@Without("warehouse")" /> }
            @if (!string.IsNullOrEmpty(type)) { <pems-list-chip label="@Localizer["Cm_Type"]" value="@TypeText(type)" remove-href="@Without("type")" /> }
            @if (from.HasValue) { <pems-list-chip label="@Localizer["ItL_From"]" value="@from.Value.ToString("yyyy-MM-dd")" remove-href="@Without("from")" /> }
            @if (to.HasValue) { <pems-list-chip label="@Localizer["ItL_To"]" value="@to.Value.ToString("yyyy-MM-dd")" remove-href="@Without("to")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="InventoryTransaction" empty="@(!Model.Items.Any())" empty-text="@Localizer["ItL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="date" data-resizable="true" data-min-width="120" data-max-width="200" style="width:140px">@Localizer["Cm_Date"]</th>
                        <th data-col-key="material" data-resizable="true" data-min-width="160" data-max-width="420">@Localizer["ItL_Material"]</th>
                        <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="180" style="width:120px">@Localizer["Cm_Type"]</th>
                        <th data-col-key="warehouse" data-resizable="true" data-min-width="80" data-max-width="160" style="width:100px">@Localizer["ItL_Warehouse"]</th>
                        <th data-col-key="qty" data-resizable="true" data-min-width="70" data-max-width="120" style="width:90px" class="text-end">@Localizer["ItL_Qty"]</th>
                        <th data-col-key="reference" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["ItL_Reference"]</th>
                        <th data-col-key="by" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["ItL_By"]</th>
                        <th data-col-key="reason" data-resizable="true" data-min-width="120" data-max-width="320" class="vs-hide-md">@Localizer["ItL_Reason"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="small"><span class="vs-num">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</span></td>
                            <td class="small"><span class="vs-title-cell" title="@t.MaterialDescription"><span class="vs-num">@t.MaterialCode</span> - @t.MaterialDescription</span></td>
                            <td><span class="vs-pill vs-pill--neutral">@TypeText(t.TransactionType)</span></td>
                            <td class="small"><span class="vs-num">@t.WarehouseCode</span></td>
                            <td class="text-end"><span class="vs-num">@t.Quantity</span></td>
                            <td class="small vs-hide-md">@(t.ReferenceType ?? "-") <span class="vs-num">@(t.ReferenceId?.ToString() ?? "")</span></td>
                            <td class="small vs-hide-md">@(t.EmployeeName ?? "-")</td>
                            <td class="small text-muted vs-hide-md">@(t.Reason ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "InventoryTransaction",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
