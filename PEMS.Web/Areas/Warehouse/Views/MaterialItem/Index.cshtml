@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaterialItemListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = (IEnumerable<dynamic>)ViewBag.Categories;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var uoms = (IEnumerable<dynamic>)ViewBag.Uoms;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="row g-3 text-center">
        <div class="col-md-4"><div class="border rounded p-3"><div class="text-muted small">@Localizer["Total Materials"]</div><div class="fs-4 fw-bold">@Model.TotalCount</div></div></div>
        <div class="col-md-4"><div class="border rounded p-3"><div class="text-muted small">Low Stock (this page)</div><div class="fs-4 fw-bold text-danger">@Model.Items.Count(x => x.IsLowStock)</div></div></div>
        <div class="col-md-4">
            <div class="border rounded p-3 d-flex align-items-center justify-content-center h-100">
                <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createMaterialModal">
                    <i class="bi bi-plus-lg"></i> @Localizer["New Material"]
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content-card">
    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        <input type="search" name="q" value="@ViewBag.SearchTerm" class="form-control form-control-sm" style="max-width:260px;" placeholder="Search code / description..." />
        <select name="categoryId" class="form-select form-select-sm" style="max-width:200px;">
            <option value="">All categories</option>
            @foreach (var c in categories) { <option value="@c.MaterialCategoryId" selected="@(c.MaterialCategoryId == (int?)ViewBag.CategoryId)">@c.Name</option> }
        </select>
        <div class="form-check mt-1">
            <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly" checked="@((bool)ViewBag.LowStockOnly)" onchange="this.form.submit()" />
            <label class="form-check-label small" for="lowStockOnly">@Localizer["فقط موجودی کم"]</label>
        </div>
        <div class="form-check mt-1">
            <input class="form-check-input" type="checkbox" name="criticalOnly" value="true" id="criticalOnly" checked="@((bool)ViewBag.CriticalOnly)" onchange="this.form.submit()" />
            <label class="form-check-label small" for="criticalOnly">@Localizer["فقط Critical"]</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel"></i> @Localizer["Filter"]</button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["Reset"]</a>
    </form>

    <div class="table-scroll-area" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Code"]</th><th>@Localizer["Description"]</th><th>@Localizer["Category"]</th><th>@Localizer["UOM"]</th><th>@Localizer["Manufacturer"]</th><th>@Localizer["On Hand"]</th><th>@Localizer["Available"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@m.MaterialItemId">@m.MaterialCode</a> @if (m.IsCritical) { <i class="bi bi-star-fill text-warning" title="@Localizer["Critical"]"></i> }</td>
                        <td class="small">@m.Description</td>
                        <td class="small">@(m.CategoryName ?? "-")</td>
                        <td class="small">@(m.UomCode ?? "-")</td>
                        <td class="small">@(m.Manufacturer ?? "-")</td>
                        <td>@m.TotalOnHand</td>
                        <td>
                            <span class="badge @(m.IsLowStock ? "bg-danger" : "bg-success")">@m.TotalAvailable</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@m.MaterialItemId" class="btn btn-sm btn-outline-secondary" title="@Localizer["Details"]"><i class="bi bi-card-text"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No materials found.</p> }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-page="@p" asp-route-q="@ViewBag.SearchTerm" asp-route-categoryId="@ViewBag.CategoryId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="createMaterialModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Material"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3 mb-2">
                        <div class="col-md-6"><label class="form-label">@Localizer["Material Code"]</label><input name="materialCode" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Material Type"]</label><input name="materialType" class="form-control" placeholder="Bearing, Valve, Cable..." /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">@Localizer["Description"]</label><input name="description" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">@Localizer["Long Description"]</label><textarea name="longDescription" class="form-control" rows="2"></textarea></div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["Category"]</label>
                            <select name="categoryId" class="form-select">
                                <option value="">--</option>
                                @foreach (var c in categories) { <option value="@c.MaterialCategoryId">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select">
                                <option value="">--</option>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["UOM"]</label>
                            <select name="uomId" class="form-select">
                                <option value="">--</option>
                                @foreach (var u in uoms) { <option value="@u.MaterialUOMId">@u.Code</option> }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6"><label class="form-label">@Localizer["Manufacturer"]</label><input name="manufacturer" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Manufacturer Part No."]</label><input name="manufacturerPartNumber" class="form-control" /></div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Vendor (Supplier)</label>
                            <select name="vendorId" class="form-select">
                                <option value="">--</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Model"]</label><input name="model" class="form-control" /></div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-4"><label class="form-label">@Localizer["Size"]</label><input name="size" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Material Grade"]</label><input name="materialGrade" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Specification"]</label><input name="specification" class="form-control" /></div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="isStockItem" value="true" checked id="isStockItem" /><label class="form-check-label" for="isStockItem">@Localizer["Stock Item"]</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="isCritical" value="true" id="isCritical" /><label class="form-check-label" for="isCritical">@Localizer["Critical Spare"]</label></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
