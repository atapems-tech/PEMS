@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MaterialItemListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = ((IEnumerable<dynamic>)ViewBag.Categories).ToList();
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var uoms = (IEnumerable<dynamic>)ViewBag.Uoms;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var q = (string?)ViewBag.SearchTerm;
    var categoryId = (int?)ViewBag.CategoryId;
    var lowStockOnly = (bool)ViewBag.LowStockOnly;
    var criticalOnly = (bool)ViewBag.CriticalOnly;
    var categoryName = categoryId.HasValue ? (string?)categories.FirstOrDefault(c => (int)c.MaterialCategoryId == categoryId.Value)?.Name : null;
    var filterCount = (categoryId.HasValue ? 1 : 0) + (lowStockOnly ? 1 : 0) + (criticalOnly ? 1 : 0);

    string Query(string? skip)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(q) && skip != "q") parts.Add($"q={Uri.EscapeDataString(q)}");
        if (categoryId.HasValue && skip != "category") parts.Add($"categoryId={categoryId}");
        if (lowStockOnly && skip != "low") parts.Add("lowStockOnly=true");
        if (criticalOnly && skip != "critical") parts.Add("criticalOnly=true");
        return string.Join("&", parts);
    }
    string Without(string key) { var s = Query(key); return Url.Action("Index") + (s.Length > 0 ? "?" + s : ""); }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component. The search opens over the title; category, low stock and
   critical are filters with chips; the two count cards are the KPI row; paging keeps the filters (the old pager lost
   "low stock" and "critical"); the create modal stays (it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["MiL_Title"]" heading-title="@Localizer["MiL_Hint"]" total="@Model.TotalCount">
            <pems-list-search id="miSearch" action="@Url.Action("Index")" input-id="miQ" name="q" value="@q" placeholder="@Localizer["MiL_SearchPlaceholder"]">
                @if (categoryId.HasValue) { <input type="hidden" name="categoryId" value="@categoryId" /> }
                @if (lowStockOnly) { <input type="hidden" name="lowStockOnly" value="true" /> }
                @if (criticalOnly) { <input type="hidden" name="criticalOnly" value="true" /> }
            </pems-list-search>
            <pems-list-tools search-for="miSearch">
                <pems-list-filters form-id="miFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    @if (!string.IsNullOrEmpty(q)) { <input type="hidden" name="q" value="@q" /> }
                    <pems-list-filter-select id="miFilterCategory" name="categoryId" label="@Localizer["MiL_Category"]" value="@categoryId?.ToString()"
                                             all-text="@Localizer["MiL_AllCategories"]" items="@categories.Select(c => new SelectListItem((string)c.Name, ((int)c.MaterialCategoryId).ToString()))" />
                    <div class="form-check small mb-0">
                        <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockOnly" checked="@lowStockOnly" />
                        <label class="form-check-label" for="lowStockOnly">@Localizer["MiL_LowStockOnly"]</label>
                    </div>
                    <div class="form-check small mb-0">
                        <input class="form-check-input" type="checkbox" name="criticalOnly" value="true" id="criticalOnly" checked="@criticalOnly" />
                        <label class="form-check-label" for="criticalOnly">@Localizer["MiL_CriticalOnly"]</label>
                    </div>
                </pems-list-filters>
                <pems-list-kpi-toggle target="miKpis" storage-key="pems.materialItem.kpis" />
                <pems-list-reset-columns grid-key="MaterialItem" />
                <pems-list-new modal="createMaterialModal" text="@Localizer["MiL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="miKpis">
            <span class="vs-chip">@Localizer["MiL_Total"] <strong>@Model.TotalCount</strong></span>
            <a class="vs-chip vs-chip--danger" href="@Url.Action("Index", new { lowStockOnly = true })" title="@Localizer["MiL_LowStockPageHint"]">@Localizer["MiL_LowStockPage"] <strong>@Model.Items.Count(x => x.IsLowStock)</strong></a>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(q)) { <pems-list-chip label="@Localizer["Ed_Search"]" value="@q" remove-href="@Without("q")" /> }
            @if (categoryId.HasValue) { <pems-list-chip label="@Localizer["MiL_Category"]" value="@(categoryName ?? categoryId.ToString())" remove-href="@Without("category")" /> }
            @if (lowStockOnly) { <pems-list-chip label="@Localizer["MiL_LowStockOnly"]" remove-href="@Without("low")" /> }
            @if (criticalOnly) { <pems-list-chip label="@Localizer["MiL_CriticalOnly"]" remove-href="@Without("critical")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="MaterialItem" empty="@(!Model.Items.Any())" empty-text="@Localizer["MiL_Empty"]">
                <thead>
                    <tr>
                        <th data-col-key="code" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["MiL_Code"]</th>
                        <th data-col-key="description" data-resizable="true" data-min-width="160" data-max-width="480">@Localizer["Ed_Description"]</th>
                        <th data-col-key="category" data-resizable="true" data-min-width="90" data-max-width="220" style="width:140px" class="vs-hide-md">@Localizer["MiL_Category"]</th>
                        <th data-col-key="uom" data-resizable="true" data-min-width="60" data-max-width="120" style="width:80px">@Localizer["MiL_Uom"]</th>
                        <th data-col-key="manufacturer" data-resizable="true" data-min-width="100" data-max-width="240" style="width:140px" class="vs-hide-md">@Localizer["MiL_Manufacturer"]</th>
                        <th data-col-key="onHand" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px" class="text-end">@Localizer["MiL_OnHand"]</th>
                        <th data-col-key="available" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px" class="text-end">@Localizer["MiL_Available"]</th>
                        <th data-col-key="actions" data-resizable="false" style="width:60px"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="lp-row">
                            <td class="lp-no">
                                <a asp-action="Details" asp-route-id="@m.MaterialItemId" class="lp-subject" title="@m.MaterialCode">@m.MaterialCode</a>
                                @if (m.IsCritical) { <i class="bi bi-star-fill text-warning" title="@Localizer["MiL_Critical"]" aria-label="@Localizer["MiL_Critical"]"></i> }
                            </td>
                            <td class="small"><span class="vs-title-cell" title="@m.Description">@m.Description</span></td>
                            <td class="small vs-hide-md">@(m.CategoryName ?? "-")</td>
                            <td class="small"><span class="vs-num">@(m.UomCode ?? "-")</span></td>
                            <td class="small vs-hide-md">@(m.Manufacturer ?? "-")</td>
                            <td class="text-end"><span class="vs-num">@m.TotalOnHand</span></td>
                            <td class="text-end"><span class="vs-pill @(m.IsLowStock ? "vs-pill--danger" : "vs-pill--success")">@m.TotalAvailable</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@m.MaterialItemId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><i class="bi bi-card-text" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = Query(null)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<div class="modal fade" id="createMaterialModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">@Localizer["New Material"]</h6></div>
                <div class="modal-body">
                    <div class="row g-3 mb-2">
                        <div class="col-md-6"><label class="form-label">@Localizer["Material Code"]</label><input name="materialCode" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Material Type"]</label><input name="materialType" class="form-control" placeholder="Bearing, Valve, Cable..." /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">@Localizer["Description"]</label><input name="description" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">@Localizer["Long Description"]</label><textarea name="longDescription" class="form-control" rows="2"></textarea></div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["Category"]</label>
                            <select name="categoryId" class="form-select">
                                <option value="">--</option>
                                @foreach (var c in categories) { <option value="@c.MaterialCategoryId">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select">
                                <option value="">--</option>
                                @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Localizer["UOM"]</label>
                            <select name="uomId" class="form-select">
                                <option value="">--</option>
                                @foreach (var u in uoms) { <option value="@u.MaterialUOMId">@u.Code</option> }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6"><label class="form-label">@Localizer["Manufacturer"]</label><input name="manufacturer" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Manufacturer Part No."]</label><input name="manufacturerPartNumber" class="form-control" /></div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Vendor (Supplier)</label>
                            <select name="vendorId" class="form-select">
                                <option value="">--</option>
                                @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Model"]</label><input name="model" class="form-control" /></div>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-4"><label class="form-label">@Localizer["Size"]</label><input name="size" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Material Grade"]</label><input name="materialGrade" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">@Localizer["Specification"]</label><input name="specification" class="form-control" /></div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="isStockItem" value="true" checked id="isStockItem" /><label class="form-check-label" for="isStockItem">@Localizer["Stock Item"]</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" name="isCritical" value="true" id="isCritical" /><label class="form-check-label" for="isCritical">@Localizer["Critical Spare"]</label></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                    <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
