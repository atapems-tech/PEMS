@model PEMS.Application.DTOs.MaterialItemDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start">
        <div>
            <h5 class="mb-1">@Model.MaterialCode @if (Model.IsCritical) { <pems-icon name="bi-star-fill" css="text-warning" title="@Localizer["Critical"]" /> }</h5>
            <div class="text-muted">@Model.Description</div>
        </div>
        <pems-flex gap="2">
            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#editMaterialModal"><pems-icon name="bi-pencil" /> @Localizer["Edit"]</pems-button>
            <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#receiveStockModal"><pems-icon name="bi-box-arrow-in-down" /> Receive Stock</pems-button>
            <pems-form asp-action="ToggleActive" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.MaterialItemId" />
                <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="وضعیت این متریال تغییر کنه؟"><pems-icon name="bi-slash-circle" /></pems-button>
            </pems-form>
        </pems-flex>
    </pems-flex>
    <hr />
    <pems-info-grid>
        <pems-info-item label="@Localizer["Category"]">@Model.CategoryName</pems-info-item>
        <pems-info-item label="@Localizer["Discipline"]">@Model.DisciplineName</pems-info-item>
        <pems-info-item label="@Localizer["UOM"]" num>@Model.UomCode</pems-info-item>
        <pems-info-item label="@Localizer["Manufacturer"]">@Model.Manufacturer</pems-info-item>
        <pems-info-item label="@Localizer["Vendor"]">@Model.VendorName</pems-info-item>
        <pems-info-item label="@Localizer["Model"]">@Model.Model</pems-info-item>
        <pems-info-item label="@Localizer["Size"]">@Model.Size</pems-info-item>
        <pems-info-item label="@Localizer["Material Grade"]">@Model.MaterialGrade</pems-info-item>
    </pems-info-grid>
</pems-content-card>

<pems-nav css="mb-3">
    <li class="nav-item"><pems-button tone="bare" css="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-stock" type="button"><pems-icon name="bi-boxes" /> Stock <pems-badge tone="neutral">@Model.Stocks.Count</pems-badge></pems-button></li>
    <li class="nav-item"><pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-tx" type="button"><pems-icon name="bi-list-ul" /> Recent Transactions</pems-button></li>
    @if (Model.SourceImports.Any())
    {
        <li class="nav-item"><pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-source" type="button"><pems-icon name="bi-file-earmark-excel" /> Source Imports <pems-badge tone="neutral">@Model.SourceImports.Count</pems-badge></pems-button></li>
    }
    <li class="nav-item"><pems-button tone="bare" css="nav-link" data-bs-toggle="tab" data-bs-target="#tab-barcode" type="button"><pems-icon name="bi-upc-scan" /> @Localizer["Barcode"]</pems-button></li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-stock" role="tabpanel">
        <pems-content-card>
            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Warehouse"]</pems-table-header><pems-table-header>@Localizer["Location"]</pems-table-header><pems-table-header>@Localizer["On Hand"]</pems-table-header><pems-table-header>Reserved</pems-table-header><pems-table-header>@Localizer["Available"]</pems-table-header><pems-table-header>@Localizer["Reorder Point"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var s in Model.Stocks)
                    {
                        <pems-table-row class="@(s.IsOutOfStock ? "table-danger" : s.IsLowStock ? "table-warning" : "")">
                            <pems-table-cell>@s.WarehouseCode</pems-table-cell>
                            <pems-table-cell class="small">@(s.StorageLocationCode ?? "-")</pems-table-cell>
                            <pems-table-cell>@s.OnHandQuantity</pems-table-cell>
                            <pems-table-cell>@s.ReservedQuantity</pems-table-cell>
                            <pems-table-cell>@s.AvailableQuantity</pems-table-cell>
                            <pems-table-cell>@(s.ReorderPoint?.ToString() ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <pems-button tone="neutral" size="small" outline="true" css="adjust-stock-btn" type="button" data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-onhand="@s.OnHandQuantity" title="Adjust"><pems-icon name="bi-sliders" /></pems-button>
                                <pems-button tone="neutral" size="small" outline="true" css="transfer-stock-btn" type="button" data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-available="@s.AvailableQuantity" title="Transfer"><pems-icon name="bi-arrow-left-right" /></pems-button>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
            @if (!Model.Stocks.Any()) { <p class="text-muted text-center py-4">هنوز موجودی‌ای در هیچ انباری ثبت نشده.</p> }
        </pems-content-card>
    </pems-tab-pane>

    @if (Model.SourceImports.Any())
    {
        <pems-tab-pane fade="true" id="tab-source" role="tabpanel">
            <pems-content-card>
                <p class="text-muted small">
                    این متریال از این ردیف(های) Excel ساخته/به‌روزرسانی شده - طبق پایه‌ی Metadata، هر بار Import یک رکورد
                    جداگانه می‌ماند (رونویسی نمی‌شود).
                </p>
                <pems-table kind="enterprise">
                    <pems-table-head><pems-table-row><pems-table-header>Source File</pems-table-header><pems-table-header>Import Date</pems-table-header><pems-table-header>@Localizer["MRS No"]</pems-table-header><pems-table-header>@Localizer["Vendor"]</pems-table-header><pems-table-header>PO No</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                    <pems-table-body>
                        @foreach (var s in Model.SourceImports)
                        {
                            <pems-table-row>
                                <pems-table-cell class="small">@s.SourceFileName</pems-table-cell>
                                <pems-table-cell class="small">@s.ImportDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                                <pems-table-cell class="small">@(s.RawMrsNo ?? "-")</pems-table-cell>
                                <pems-table-cell class="small">@(s.RawSupplier ?? "-")</pems-table-cell>
                                <pems-table-cell class="small">@(s.RawPoNo ?? "-")</pems-table-cell>
                                <pems-table-cell class="text-end"><pems-button as="a" tone="neutral" size="small" outline="true" asp-controller="MrsImport" asp-action="Review" asp-route-batchId="@s.MrsImportBatchId">Open Batch</pems-button></pems-table-cell>
                            </pems-table-row>
                        }
                    </pems-table-body>
                </pems-table>
            </pems-content-card>
        </pems-tab-pane>
    }

    <pems-tab-pane fade="true" id="tab-tx" role="tabpanel">
        <pems-content-card>
            <pems-data-table data="@(DataRows.Of(Model.RecentTransactions, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), t => (object?)(t.TransactionDate.ToString("yyyy-MM-dd HH:mm")), css: "small").Add(((Localizer["Type"])?.ToString() ?? ""), t => (object?)(t.TransactionType), kind: DataCellKind.Badge, tone: t => "light").Add(((Localizer["Warehouse"])?.ToString() ?? ""), t => (object?)(t.WarehouseCode)).Add(((Localizer["Qty"])?.ToString() ?? ""), t => (object?)(t.Quantity)).Add(((Localizer["Reference"])?.ToString() ?? ""), t => DataCell.Join((t.ReferenceType ?? "-"), " ", (t.ReferenceId?.ToString() ?? "")), css: "small").Add("By", t => (object?)(t.EmployeeName ?? "-"), css: "small")))" />
            @if (!Model.RecentTransactions.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز تراکنشی ثبت نشده."]</p> }
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-barcode" role="tabpanel">
        <partial name="_BarcodePanel" model="(PEMS.Web.Models.BarcodePanelViewModel)ViewBag.BarcodePanel" />
    </pems-tab-pane>
</pems-tab-content>

<pems-modal id="receiveStockModal" tabindex="-1">
        <pems-form asp-action="ReceiveStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <pems-modal-header>@Localizer["دریافت کالا به انبار"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["اسکن بارکد انبار (اختیاری)"]</pems-label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><pems-icon name="bi-upc-scan" /></span>
                        <pems-input type="text" id="receiveWarehouseScanInput" dir="ltr" placeholder="Scan Warehouse barcode..." />
                        <pems-button tone="neutral" outline="true" type="button" id="receiveWarehouseScanBtn">@Localizer["Resolve"]</pems-button>
                    </div>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["انبار"]</pems-label>
                    <pems-select scale="small" name="warehouseId" id="receiveWarehouseSelect" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">@Localizer["مقدار"]</pems-label><pems-input scale="small" name="quantity" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل / مرجع (اختیاری)"]</pems-label><pems-input scale="small" name="reason" /></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="adjustStockModal" tabindex="-1">
        <pems-form asp-action="AdjustStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="warehouseId" id="adjustWarehouseId" />
            <pems-modal-header>اصلاح موجودی <span id="adjustWarehouseLabel" class="text-muted small"></span></pems-modal-header>
            <pems-modal-body>
                <div class="mb-2"><pems-label css="small">@Localizer["موجودی جدید (On Hand)"]</pems-label><pems-input scale="small" name="newOnHandQuantity" id="adjustNewOnHand" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل"]</pems-label><pems-input scale="small" name="reason" required /></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="transferStockModal" tabindex="-1">
        <pems-form asp-action="TransferStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="fromWarehouseId" id="transferFromWarehouseId" />
            <pems-modal-header>انتقال بین انبارها <span id="transferFromWarehouseLabel" class="text-muted small"></span></pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["انبار مقصد"]</pems-label>
                    <pems-select scale="small" name="toWarehouseId" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">مقدار (حداکثر: <span id="transferAvailable"></span>)</pems-label><pems-input scale="small" name="quantity" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل / مرجع (اختیاری)"]</pems-label><pems-input scale="small" name="reason" /></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal size="large" id="editMaterialModal" tabindex="-1">
        <pems-form asp-action="Edit" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <pems-modal-header>Edit Material</pems-modal-header>
            <pems-modal-body>
                <pems-row gap="3" css="mb-2">
                    <pems-col md="6"><pems-label>@Localizer["Material Code"]</pems-label><pems-input name="materialCode" value="@Model.MaterialCode" required /></pems-col>
                    <pems-col md="6"><pems-label>@Localizer["Material Type"]</pems-label><pems-input name="materialType" value="@Model.MaterialType" /></pems-col>
                </pems-row>
                <div class="mb-2"><pems-label>@Localizer["Description"]</pems-label><pems-input name="description" value="@Model.Description" required /></div>
                <div class="mb-2"><pems-label>@Localizer["Long Description"]</pems-label><pems-textarea name="longDescription" rows="2">@Model.LongDescription</pems-textarea></div>
                <pems-row gap="3" css="mb-2">
                    <pems-col md="6"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input name="manufacturer" value="@Model.Manufacturer" /></pems-col>
                    <pems-col md="6"><pems-label>@Localizer["Manufacturer Part No."]</pems-label><pems-input name="manufacturerPartNumber" value="@Model.ManufacturerPartNumber" /></pems-col>
                </pems-row>
                <pems-row gap="3" css="mb-2">
                    <pems-col md="4"><pems-label>@Localizer["Model"]</pems-label><pems-input name="model" value="@Model.Model" /></pems-col>
                    <pems-col md="4"><pems-label>@Localizer["Size"]</pems-label><pems-input name="size" value="@Model.Size" /></pems-col>
                    <pems-col md="4"><pems-label>@Localizer["Material Grade"]</pems-label><pems-input name="materialGrade" value="@Model.MaterialGrade" /></pems-col>
                </pems-row>
                <pems-flex gap="3">
                    <pems-check-row><pems-input type="checkbox" name="isStockItem" value="true" checked="@Model.IsStockItem" id="editIsStockItem" kind="check" /><label class="form-check-label" for="editIsStockItem">@Localizer["Stock Item"]</label></pems-check-row>
                    <pems-check-row><pems-input type="checkbox" name="isCritical" value="true" checked="@Model.IsCritical" id="editIsCritical" kind="check" /><label class="form-check-label" for="editIsCritical">@Localizer["Critical Spare"]</label></pems-check-row>
                </pems-flex>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

@section Scripts {
<script src="~/js/views/warehouse-materialitem-details.js" asp-append-version="true"></script>
}
