@model PEMS.Application.DTOs.MaterialItemDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-1">@Model.MaterialCode @if (Model.IsCritical) { <i class="bi bi-star-fill text-warning" title="@Localizer["Critical"]"></i> }</h5>
            <div class="text-muted">@Model.Description</div>
        </div>
        <div class="d-flex gap-2">
            <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#editMaterialModal"><i class="bi bi-pencil"></i> @Localizer["Edit"]</pems-button>
            <pems-button tone="primary" size="small" outline="true" type="button" data-bs-toggle="modal" data-bs-target="#receiveStockModal"><i class="bi bi-box-arrow-in-down"></i> Receive Stock</pems-button>
            <form asp-action="ToggleActive" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.MaterialItemId" />
                <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="وضعیت این متریال تغییر کنه؟"><i class="bi bi-slash-circle"></i></pems-button>
            </form>
        </div>
    </div>
    <hr />
    <pems-info-grid>
        <pems-info-item label="@Localizer["Category"]">@Model.CategoryName</pems-info-item>
        <pems-info-item label="@Localizer["Discipline"]">@Model.DisciplineName</pems-info-item>
        <pems-info-item label="@Localizer["UOM"]" num>@Model.UomCode</pems-info-item>
        <pems-info-item label="@Localizer["Manufacturer"]">@Model.Manufacturer</pems-info-item>
        <pems-info-item label="@Localizer["Vendor"]">@Model.VendorName</pems-info-item>
        <pems-info-item label="@Localizer["Model"]">@Model.Model</pems-info-item>
        <pems-info-item label="@Localizer["Size"]">@Model.Size</pems-info-item>
        <pems-info-item label="@Localizer["Material Grade"]">@Model.MaterialGrade</pems-info-item>
    </pems-info-grid>
</div>

<pems-nav css="mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-stock" type="button"><i class="bi bi-boxes"></i> Stock <pems-badge tone="neutral">@Model.Stocks.Count</pems-badge></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-tx" type="button"><i class="bi bi-list-ul"></i> Recent Transactions</button></li>
    @if (Model.SourceImports.Any())
    {
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-source" type="button"><i class="bi bi-file-earmark-excel"></i> Source Imports <pems-badge tone="neutral">@Model.SourceImports.Count</pems-badge></button></li>
    }
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-barcode" type="button"><i class="bi bi-upc-scan"></i> @Localizer["Barcode"]</button></li>
</pems-nav>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-stock" role="tabpanel">
        <div class="content-card">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Warehouse"]</th><th>@Localizer["Location"]</th><th>@Localizer["On Hand"]</th><th>Reserved</th><th>@Localizer["Available"]</th><th>@Localizer["Reorder Point"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Stocks)
                    {
                        <tr class="@(s.IsOutOfStock ? "table-danger" : s.IsLowStock ? "table-warning" : "")">
                            <td>@s.WarehouseCode</td>
                            <td class="small">@(s.StorageLocationCode ?? "-")</td>
                            <td>@s.OnHandQuantity</td>
                            <td>@s.ReservedQuantity</td>
                            <td>@s.AvailableQuantity</td>
                            <td>@(s.ReorderPoint?.ToString() ?? "-")</td>
                            <td class="text-end">
                                <pems-button tone="neutral" size="small" outline="true" css="adjust-stock-btn" type="button" data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-onhand="@s.OnHandQuantity" title="Adjust"><i class="bi bi-sliders"></i></pems-button>
                                <pems-button tone="neutral" size="small" outline="true" css="transfer-stock-btn" type="button" data-warehouse-id="@s.WarehouseId" data-warehouse-code="@s.WarehouseCode" data-available="@s.AvailableQuantity" title="Transfer"><i class="bi bi-arrow-left-right"></i></pems-button>
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!Model.Stocks.Any()) { <p class="text-muted text-center py-4">هنوز موجودی‌ای در هیچ انباری ثبت نشده.</p> }
        </div>
    </div>

    @if (Model.SourceImports.Any())
    {
        <div class="tab-pane fade" id="tab-source" role="tabpanel">
            <div class="content-card">
                <p class="text-muted small">
                    این متریال از این ردیف(های) Excel ساخته/به‌روزرسانی شده - طبق پایه‌ی Metadata، هر بار Import یک رکورد
                    جداگانه می‌ماند (رونویسی نمی‌شود).
                </p>
                <pems-table kind="enterprise">
                    <thead><tr><th>Source File</th><th>Import Date</th><th>@Localizer["MRS No"]</th><th>@Localizer["Vendor"]</th><th>PO No</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.SourceImports)
                        {
                            <tr>
                                <td class="small">@s.SourceFileName</td>
                                <td class="small">@s.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@(s.RawMrsNo ?? "-")</td>
                                <td class="small">@(s.RawSupplier ?? "-")</td>
                                <td class="small">@(s.RawPoNo ?? "-")</td>
                                <td class="text-end"><pems-button as="a" tone="neutral" size="small" outline="true" asp-controller="MrsImport" asp-action="Review" asp-route-batchId="@s.MrsImportBatchId">Open Batch</pems-button></td>
                            </tr>
                        }
                    </tbody>
                </pems-table>
            </div>
        </div>
    }

    <div class="tab-pane fade" id="tab-tx" role="tabpanel">
        <div class="content-card">
            <pems-table kind="enterprise">
                <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Type"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Reference"]</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var t in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><pems-badge tone="light">@t.TransactionType</pems-badge></td>
                            <td>@t.WarehouseCode</td>
                            <td>@t.Quantity</td>
                            <td class="small">@(t.ReferenceType ?? "-") @(t.ReferenceId?.ToString() ?? "")</td>
                            <td class="small">@(t.EmployeeName ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!Model.RecentTransactions.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز تراکنشی ثبت نشده."]</p> }
        </div>
    </div>

    <div class="tab-pane fade" id="tab-barcode" role="tabpanel">
        <partial name="_BarcodePanel" model="(PEMS.Web.Models.BarcodePanelViewModel)ViewBag.BarcodePanel" />
    </div>
</div>

<pems-modal id="receiveStockModal" tabindex="-1">
        <form asp-action="ReceiveStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["دریافت کالا به انبار"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <pems-label css="small">@Localizer["اسکن بارکد انبار (اختیاری)"]</pems-label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                        <pems-input type="text" id="receiveWarehouseScanInput" dir="ltr" placeholder="Scan Warehouse barcode..." />
                        <pems-button tone="neutral" outline="true" type="button" id="receiveWarehouseScanBtn">@Localizer["Resolve"]</pems-button>
                    </div>
                </div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["انبار"]</pems-label>
                    <pems-select scale="small" name="warehouseId" id="receiveWarehouseSelect" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">@Localizer["مقدار"]</pems-label><pems-input scale="small" name="quantity" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل / مرجع (اختیاری)"]</pems-label><pems-input scale="small" name="reason" /></div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </div>
        </form>
    </pems-modal>

<pems-modal id="adjustStockModal" tabindex="-1">
        <form asp-action="AdjustStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="warehouseId" id="adjustWarehouseId" />
            <div class="modal-header"><h6 class="modal-title">اصلاح موجودی <span id="adjustWarehouseLabel" class="text-muted small"></span></h6></div>
            <div class="modal-body">
                <div class="mb-2"><pems-label css="small">@Localizer["موجودی جدید (On Hand)"]</pems-label><pems-input scale="small" name="newOnHandQuantity" id="adjustNewOnHand" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل"]</pems-label><pems-input scale="small" name="reason" required /></div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </div>
        </form>
    </pems-modal>

<pems-modal id="transferStockModal" tabindex="-1">
        <form asp-action="TransferStock" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <input type="hidden" name="fromWarehouseId" id="transferFromWarehouseId" />
            <div class="modal-header"><h6 class="modal-title">انتقال بین انبارها <span id="transferFromWarehouseLabel" class="text-muted small"></span></h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <pems-label css="small">@Localizer["انبار مقصد"]</pems-label>
                    <pems-select scale="small" name="toWarehouseId" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">مقدار (حداکثر: <span id="transferAvailable"></span>)</pems-label><pems-input scale="small" name="quantity" type="number" step="0.001" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["دلیل / مرجع (اختیاری)"]</pems-label><pems-input scale="small" name="reason" /></div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </div>
        </form>
    </pems-modal>

<pems-modal size="large" id="editMaterialModal" tabindex="-1">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="materialItemId" value="@Model.MaterialItemId" />
            <div class="modal-header"><h6 class="modal-title">Edit Material</h6></div>
            <div class="modal-body">
                <div class="row g-3 mb-2">
                    <div class="col-md-6"><pems-label>@Localizer["Material Code"]</pems-label><pems-input name="materialCode" value="@Model.MaterialCode" required /></div>
                    <div class="col-md-6"><pems-label>@Localizer["Material Type"]</pems-label><pems-input name="materialType" value="@Model.MaterialType" /></div>
                </div>
                <div class="mb-2"><pems-label>@Localizer["Description"]</pems-label><pems-input name="description" value="@Model.Description" required /></div>
                <div class="mb-2"><pems-label>@Localizer["Long Description"]</pems-label><pems-textarea name="longDescription" rows="2">@Model.LongDescription</pems-textarea></div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6"><pems-label>@Localizer["Manufacturer"]</pems-label><pems-input name="manufacturer" value="@Model.Manufacturer" /></div>
                    <div class="col-md-6"><pems-label>@Localizer["Manufacturer Part No."]</pems-label><pems-input name="manufacturerPartNumber" value="@Model.ManufacturerPartNumber" /></div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-4"><pems-label>@Localizer["Model"]</pems-label><pems-input name="model" value="@Model.Model" /></div>
                    <div class="col-md-4"><pems-label>@Localizer["Size"]</pems-label><pems-input name="size" value="@Model.Size" /></div>
                    <div class="col-md-4"><pems-label>@Localizer["Material Grade"]</pems-label><pems-input name="materialGrade" value="@Model.MaterialGrade" /></div>
                </div>
                <div class="d-flex gap-3">
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="isStockItem" value="true" checked="@Model.IsStockItem" id="editIsStockItem" /><label class="form-check-label" for="editIsStockItem">@Localizer["Stock Item"]</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="isCritical" value="true" checked="@Model.IsCritical" id="editIsCritical" /><label class="form-check-label" for="editIsCritical">@Localizer["Critical Spare"]</label></div>
                </div>
            </div>
            <div class="modal-footer">
                <pems-button tone="neutral" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            </div>
        </form>
    </pems-modal>

@section Scripts {
<script>
document.querySelectorAll('.adjust-stock-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('adjustWarehouseId').value = btn.dataset.warehouseId;
        document.getElementById('adjustWarehouseLabel').textContent = '(' + btn.dataset.warehouseCode + ')';
        document.getElementById('adjustNewOnHand').value = btn.dataset.onhand;
        new bootstrap.Modal(document.getElementById('adjustStockModal')).show();
    });
});
document.querySelectorAll('.transfer-stock-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.getElementById('transferFromWarehouseId').value = btn.dataset.warehouseId;
        document.getElementById('transferFromWarehouseLabel').textContent = '(' + btn.dataset.warehouseCode + ')';
        document.getElementById('transferAvailable').textContent = btn.dataset.available;
        new bootstrap.Modal(document.getElementById('transferStockModal')).show();
    });
});

// طبق «PEMS — Warehouse and Inventory Barcode Integration»: اسکن فقط <select name="warehouseId">
// موجود را از قبل پر می‌کند - ReceiveStock همون مسیر/سرویس موجود (IMaterialStockService) را طی می‌کند.
document.getElementById('receiveWarehouseScanBtn')?.addEventListener('click', async function () {
    var input = document.getElementById('receiveWarehouseScanInput');
    var select = document.getElementById('receiveWarehouseSelect');
    var code = (input.value || '').trim();
    if (!code) return;

    try {
        var res = await fetch('/Barcode/ResolveJson?code=' + encodeURIComponent(code));
        var data = await res.json();

        if (!data.success) { alert('Barcode not resolved: ' + (data.errorMessage || data.errorCode)); return; }
        if (data.targetType !== 'Warehouse') { alert('This barcode belongs to a ' + data.targetType + ', not a Warehouse.'); return; }

        var matched = false;
        for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value == data.targetId) { select.value = select.options[i].value; matched = true; break; }
        }
        if (!matched) { alert('Resolved to ' + (data.label || ('Warehouse #' + data.targetId)) + ', but it is not in this list.'); return; }

        input.value = '';
    } catch (e) {
        alert('Could not resolve barcode.');
    }
});
</script>
}
