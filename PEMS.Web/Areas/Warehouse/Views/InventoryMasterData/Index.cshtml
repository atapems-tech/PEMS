@model List<PEMS.Domain.Entities.Warehouse>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.Categories;
    var topLevelCategories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.TopLevelCategories;
    var uoms = (List<PEMS.Domain.Entities.MaterialUOM>)ViewBag.Uoms;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-nav css="mb-3" id="imdTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-categories" type="button">
            <pems-icon name="bi-diagram-3" /> Categories <pems-badge tone="neutral">@categories.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-uoms" type="button">
            <pems-icon name="bi-rulers" /> Units of Measure <pems-badge tone="neutral">@uoms.Count</pems-badge>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-warehouses" type="button">
            <pems-icon name="bi-building" /> Warehouses <pems-badge tone="neutral">@Model.Count</pems-badge>
        </button>
    </li>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-categories" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">دسته‌بندی سلسله‌مراتبی متریال - مستقل از Discipline.</p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["دسته‌بندی جدید"]
                </pems-button>
            </pems-flex>
            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["کد"]</pems-table-header><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["والد"]</pems-table-header><pems-table-header>@Localizer["توضیحات"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var c in categories)
                    {
                        <pems-table-row>
                            <pems-table-cell>@c.Code</pems-table-cell>
                            <pems-table-cell>@c.Name</pems-table-cell>
                            <pems-table-cell>@(c.Parent?.Name ?? "-")</pems-table-cell>
                            <pems-table-cell class="small text-muted">@(c.Description ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleCategoryActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.MaterialCategoryId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این دسته‌بندی غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-uoms" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">واحد اندازه‌گیری پایه - مستقل نگه داشته می‌شود تا بین متریال‌های مختلف مشترک باشد.</p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createUomModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["واحد جدید"]
                </pems-button>
            </pems-flex>
            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["کد"]</pems-table-header><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["ضریب تبدیل"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var u in uoms)
                    {
                        <pems-table-row>
                            <pems-table-cell>@u.Code</pems-table-cell>
                            <pems-table-cell>@u.Name</pems-table-cell>
                            <pems-table-cell>@(u.ConversionFactor?.ToString() ?? "-")</pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleUomActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.MaterialUOMId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این واحد غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-warehouses" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <p class="text-muted small mb-0">انبارهای فیزیکی - طبق پیشوندهای واقعی MRS از قبل seed شده‌اند.</p>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createWarehouseModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["انبار جدید"]
                </pems-button>
            </pems-flex>
            <pems-table kind="enterprise">
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["کد"]</pems-table-header><pems-table-header>@Localizer["نام"]</pems-table-header><pems-table-header>@Localizer["محل‌های نگهداری"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var w in Model)
                    {
                        <pems-table-row>
                            <pems-table-cell>@w.Code</pems-table-cell>
                            <pems-table-cell>@w.Name</pems-table-cell>
                            <pems-table-cell>
                                @foreach (var l in w.Locations.Where(x => x.IsActive))
                                {
                                    <pems-badge tone="light" css="me-1">@l.Code</pems-badge>
                                }
                                <pems-button tone="none" size="small" css="btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#addLocationModal" data-fill-warehouseid="@w.WarehouseId" data-fill-warehousecode="@w.Code">+ محل</pems-button>
                            </pems-table-cell>
                            <pems-table-cell class="text-end">
                                <form asp-action="ToggleWarehouseActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@w.WarehouseId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این انبار غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </form>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-tab-pane>
</pems-tab-content>

<pems-modal id="createCategoryModal" tabindex="-1">
        <form asp-action="CreateCategory" method="post">
            <pems-modal-header>@Localizer["دسته‌بندی جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></div>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["والد (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="parentCategoryId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var c in topLevelCategories) { <option value="@c.MaterialCategoryId">@c.Name</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="createUomModal" tabindex="-1">
        <form asp-action="CreateUom" method="post">
            <pems-modal-header>@Localizer["واحد اندازه‌گیری جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="@Localizer["مثلاً KG"]" /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["ضریب تبدیل (اختیاری)"]</pems-label><pems-input scale="small" name="conversionFactor" type="number" step="0.000001" /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

<pems-modal id="createWarehouseModal" tabindex="-1">
        <form asp-action="CreateWarehouse" method="post">
            <pems-modal-header>@Localizer["انبار جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="مثلاً WH-EL" /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></div>
                <div class="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </form>
    </pems-modal>

@if (Model.Any())
{
    <pems-modal id="addLocationModal" tabindex="-1">
            <form asp-action="CreateStorageLocation" method="post">
                <input type="hidden" name="warehouseId" value="" />
                <pems-modal-header>محل نگهداری جدید در <span data-fill-text="warehousecode"></span></pems-modal-header>
                <pems-modal-body>
                    <div class="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="مثلاً RACK-1" /></div>
                    <div class="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></div>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
                </pems-modal-footer>
            </form>
        </pems-modal>
}
