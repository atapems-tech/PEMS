@model List<PEMS.Domain.Entities.Warehouse>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var categories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.Categories;
    var topLevelCategories = (List<PEMS.Domain.Entities.MaterialCategory>)ViewBag.TopLevelCategories;
    var uoms = (List<PEMS.Domain.Entities.MaterialUOM>)ViewBag.Uoms;
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-nav css="mb-3" id="imdTabs" role="tablist">
    <pems-tab target="tab-categories" active="true">
            <pems-icon name="bi-diagram-3" /> Categories <pems-badge tone="neutral">@categories.Count</pems-badge>
        </pems-tab>
    <pems-tab target="tab-uoms">
            <pems-icon name="bi-rulers" /> Units of Measure <pems-badge tone="neutral">@uoms.Count</pems-badge>
        </pems-tab>
    <pems-tab target="tab-warehouses">
            <pems-icon name="bi-building" /> Warehouses <pems-badge tone="neutral">@Model.Count</pems-badge>
        </pems-tab>
</pems-nav>

<pems-tab-content>
    <pems-tab-pane fade="true" active="true" id="tab-categories" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <pems-text class="text-muted small mb-0">دسته‌بندی سلسله‌مراتبی متریال - مستقل از Discipline.</pems-text>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["دسته‌بندی جدید"]
                </pems-button>
            </pems-flex>
            @{
                var rows_8 = categories;
                var cell_8_4 = DataCell.Template(rows_8, @<text>@{ var c = item; }
                                <pems-form asp-action="ToggleCategoryActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@c.MaterialCategoryId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این دسته‌بندی غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </pems-form>
                            </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_8, c_ => c_.Add(((Localizer["کد"])?.ToString() ?? ""), c => (object?)(c.Code)).Add(((Localizer["نام"])?.ToString() ?? ""), c => (object?)(c.Name)).Add(((Localizer["والد"])?.ToString() ?? ""), c => (object?)((c.Parent?.Name ?? "-"))).Add(((Localizer["توضیحات"])?.ToString() ?? ""), c => (object?)((c.Description ?? "-")), css: "small text-muted").Add("", c => (object?)cell_8_4(c), css: "text-end")))" />
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-uoms" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <pems-text class="text-muted small mb-0">واحد اندازه‌گیری پایه - مستقل نگه داشته می‌شود تا بین متریال‌های مختلف مشترک باشد.</pems-text>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createUomModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["واحد جدید"]
                </pems-button>
            </pems-flex>
            @{
                var rows_9 = uoms;
                var cell_9_3 = DataCell.Template(rows_9, @<text>@{ var u = item; }
                                <pems-form asp-action="ToggleUomActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.MaterialUOMId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این واحد غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </pems-form>
                            </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_9, c_ => c_.Add(((Localizer["کد"])?.ToString() ?? ""), u => (object?)(u.Code)).Add(((Localizer["نام"])?.ToString() ?? ""), u => (object?)(u.Name)).Add(((Localizer["ضریب تبدیل"])?.ToString() ?? ""), u => (object?)((u.ConversionFactor?.ToString() ?? "-"))).Add("", u => (object?)cell_9_3(u), css: "text-end")))" />
        </pems-content-card>
    </pems-tab-pane>

    <pems-tab-pane fade="true" id="tab-warehouses" role="tabpanel">
        <pems-content-card>
            <pems-flex justify="between" align="center" css="mb-3">
                <pems-text class="text-muted small mb-0">انبارهای فیزیکی - طبق پیشوندهای واقعی MRS از قبل seed شده‌اند.</pems-text>
                <pems-button tone="primary" size="small" css="text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#createWarehouseModal">
                    <pems-icon name="bi-plus-lg" /> @Localizer["انبار جدید"]
                </pems-button>
            </pems-flex>
            @{
                var rows_10 = Model;
                var cell_10_2 = DataCell.Template(rows_10, @<text>@{ var w = item; }
                                @foreach (var l in w.Locations.Where(x => x.IsActive))
                                {
                                    <pems-badge tone="light" css="me-1">@l.Code</pems-badge>
                                }
                                <pems-button tone="none" size="small" css="btn-link p-0" type="button" data-bs-toggle="modal" data-bs-target="#addLocationModal" data-fill-warehouseid="@w.WarehouseId" data-fill-warehousecode="@w.Code">+ محل</pems-button>
                            </text>);
                var cell_10_3 = DataCell.Template(rows_10, @<text>@{ var w = item; }
                                <pems-form asp-action="ToggleWarehouseActive" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@w.WarehouseId" />
                                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این انبار غیرفعال بشه؟"><pems-icon name="bi-x-circle" /></pems-button>
                                </pems-form>
                            </text>);
            }
            <pems-data-table data="@(DataRows.Of(rows_10, c_ => c_.Add(((Localizer["کد"])?.ToString() ?? ""), w => (object?)(w.Code)).Add(((Localizer["نام"])?.ToString() ?? ""), w => (object?)(w.Name)).Add(((Localizer["محل‌های نگهداری"])?.ToString() ?? ""), w => (object?)cell_10_2(w)).Add("", w => (object?)cell_10_3(w), css: "text-end")))" />
        </pems-content-card>
    </pems-tab-pane>
</pems-tab-content>

<pems-modal id="createCategoryModal" tabindex="-1">
        <pems-form asp-action="CreateCategory" method="post">
            <pems-modal-header>@Localizer["دسته‌بندی جدید"]</pems-modal-header>
            <pems-modal-body>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["والد (اختیاری)"]</pems-label>
                    <pems-select scale="small" name="parentCategoryId">
                        <option value="">@Localizer["-- ندارد --"]</option>
                        @foreach (var c in topLevelCategories) { <option value="@c.MaterialCategoryId">@c.Name</option> }
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></pems-form-group>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="createUomModal" tabindex="-1">
        <pems-form asp-action="CreateUom" method="post">
            <pems-modal-header>@Localizer["واحد اندازه‌گیری جدید"]</pems-modal-header>
            <pems-modal-body>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="@Localizer["مثلاً KG"]" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["ضریب تبدیل (اختیاری)"]</pems-label><pems-input scale="small" name="conversionFactor" type="number" step="0.000001" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></pems-form-group>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

<pems-modal id="createWarehouseModal" tabindex="-1">
        <pems-form asp-action="CreateWarehouse" method="post">
            <pems-modal-header>@Localizer["انبار جدید"]</pems-modal-header>
            <pems-modal-body>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="مثلاً WH-EL" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></pems-form-group>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

@if (Model.Any())
{
    <pems-modal id="addLocationModal" tabindex="-1">
            <pems-form asp-action="CreateStorageLocation" method="post">
                <input type="hidden" name="warehouseId" value="" />
                <pems-modal-header>محل نگهداری جدید در <span data-fill-text="warehousecode"></span></pems-modal-header>
                <pems-modal-body>
                    <pems-form-group css="mb-2"><pems-label css="small">@Localizer["کد"]</pems-label><pems-input scale="small" name="code" required placeholder="مثلاً RACK-1" /></pems-form-group>
                    <pems-form-group css="mb-2"><pems-label css="small">@Localizer["نام"]</pems-label><pems-input scale="small" name="name" required /></pems-form-group>
                </pems-modal-body>
                <pems-modal-footer>
                    <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                    <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
                </pems-modal-footer>
            </pems-form>
        </pems-modal>
}
