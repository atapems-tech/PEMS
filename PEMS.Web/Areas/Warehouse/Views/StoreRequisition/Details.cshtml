@model PEMS.Domain.Entities.StoreRequisition
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var statusHistory = (List<PEMS.Domain.Entities.StoreRequisitionStatusHistory>)ViewBag.StatusHistory;
    var nextStatus = (string?)ViewBag.NextStatus;
    var can = (Dictionary<string, bool>)ViewBag.Can;
    bool Can(string a) => can.TryGetValue(a, out var v) && v;
    bool isRequester = (bool)ViewBag.IsRequester;
    var nextAction = nextStatus switch { "Submitted" => "Submit", "Approved" => "Approve", "Reserved" => "Reserve", "Issued" => "Issue", "Closed" => "Close", _ => "" };
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <h5 class="mb-1">@Model.RequisitionNumber</h5>
            <div class="text-muted small">انبار: @Model.Warehouse?.Code - درخواست‌کننده: @(Model.RequestedBy?.FirstName) @(Model.RequestedBy?.LastName) - @Model.RequestedDate.ToString("yyyy-MM-dd")</div>
            @if (!string.IsNullOrWhiteSpace(Model.Purpose)) { <div class="small mt-1">@Model.Purpose</div> }
        </div>
        <pems-flex gap="2">
            <pems-badge tone="none" css="fs-6 @(Model.Status is "Closed" or "Issued" ? "bg-success" : Model.Status == "PartiallyIssued" ? "bg-info text-dark" : Model.Status is "Rejected" or "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">@Model.Status</pems-badge>
        </pems-flex>
    </pems-flex>
    <hr />
    <pems-flex gap="2" wrap="true">
        @if (nextStatus != null && nextStatus != "Issued" && Can(nextAction) && !(isRequester && nextStatus is "Approved"))
        {
            <pems-form asp-action="AdvanceStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                <pems-button tone="primary" size="small" type="submit" data-pems-confirm="وضعیت به @nextStatus تغییر کنه؟">@Localizer["SR_AdvanceTo"] @nextStatus</pems-button>
            </pems-form>
        }
        @if (Model.Status is "Draft" or "Submitted" or "Approved" && Can("Reject"))
        {
            <pems-form asp-action="Reject" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="این درخواست رد بشه؟">@Localizer["Reject"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "PartiallyIssued" && Can("CloseShort"))
        {
            <pems-form asp-action="CloseShort" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <pems-button tone="warning" size="small" outline="true" type="submit" data-pems-confirm="درخواست با کسری بسته شود و باقی‌مانده‌ی رزرو آزاد شود؟">@Localizer["SR_CloseShort"]</pems-button>
            </pems-form>
        }
        @if (Model.Status is "Draft" or "Submitted" or "Approved" or "Reserved" && Can("Cancel"))
        {
            <pems-form asp-action="Cancel" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="این درخواست لغو بشه؟">@Localizer["Cancel"]</pems-button>
            </pems-form>
        }
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <h6 class="mb-3">Lines</h6>
    @{
        var editApproved = Model.Status == "Submitted" && Can("SetApprovedQuantity") && !isRequester;
        var canIssue = Model.Status is "Reserved" or "PartiallyIssued" && Can("Issue") && !isRequester;
    }
    <pems-form id="srLinesForm" method="post" asp-action="@(editApproved ? "SetApprovedQuantities" : "Issue")">
        <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
        <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
    <pems-table kind="enterprise" scale="small">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["Material"]</pems-table-header><pems-table-header>Requested</pems-table-header><pems-table-header>@Localizer["Approved"]</pems-table-header><pems-table-header>Issued</pems-table-header><pems-table-header>@Localizer["SR_Remaining"]</pems-table-header>@if (editApproved) { <pems-table-header>@Localizer["Approved"]</pems-table-header> } @if (canIssue) { <pems-table-header>@Localizer["SR_IssueNow"]</pems-table-header> }</pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var l in Model.Lines)
            {
                var approvedQty = l.ApprovedQuantity ?? l.RequestedQuantity;
                var remaining = approvedQty - l.IssuedQuantity;
                <pems-table-row>
                    <pems-table-cell class="small">@l.MaterialItem?.MaterialCode - @l.MaterialItem?.Description</pems-table-cell>
                    <pems-table-cell>@l.RequestedQuantity</pems-table-cell>
                    <pems-table-cell>@(l.ApprovedQuantity?.ToString() ?? "-")</pems-table-cell>
                    <pems-table-cell>@l.IssuedQuantity</pems-table-cell>
                    <pems-table-cell>@(remaining < 0 ? 0 : remaining)</pems-table-cell>
                    @if (editApproved) { <pems-table-cell class="pems-s-c6fffdfe"><pems-input scale="small" name="approved[@l.StoreRequisitionLineId]" type="number" step="0.001" min="0" max="@l.RequestedQuantity" value="@approvedQty" aria-label="@Localizer["Approved"]" /></pems-table-cell> }
                    @if (canIssue) { <pems-table-cell class="pems-s-c6fffdfe"><pems-input scale="small" name="qty[@l.StoreRequisitionLineId]" type="number" step="0.001" min="0" max="@(remaining < 0 ? 0 : remaining)" placeholder="0" aria-label="@Localizer["SR_IssueNow"]" /></pems-table-cell> }
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (editApproved) { <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button> }
    @if (canIssue) { <pems-button tone="primary" size="small" type="submit">@Localizer["SR_IssuePartialOrFull"]</pems-button> <span class="small text-muted">@Localizer["SR_IssueHint"]</span> }
    </pems-form>
    @if (!Model.Lines.Any()) { <p class="text-muted text-center py-3">@Localizer["هنوز خطی اضافه نشده."]</p> }

    @if (Model.Status == "Draft")
    {
        <pems-form asp-action="AddLine" method="post"><pems-row gap="2" css="mt-2">
            <input type="hidden" name="storeRequisitionId" value="@Model.StoreRequisitionId" />
            <pems-col md="6">
                <pems-select scale="small" name="materialItemId" required>
                    @foreach (var m in materialItems) { <option value="@m.MaterialItemId">@m.MaterialCode - @m.Description</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-input scale="small" name="requestedQuantity" type="number" step="0.001" placeholder="@Localizer["Quantity"]" required /></pems-col>
            <pems-col md="3"><pems-button tone="primary" size="small" css="w-100"><pems-icon name="bi-plus-lg" /> Add Line</pems-button></pems-col>
        </pems-row></pems-form>
    }
</pems-content-card>

<pems-content-card>
    <h6 class="mb-3">@Localizer["Status History"]</h6>
    <pems-data-table data="@(DataRows.Of(statusHistory, c_ => c_.Add(((Localizer["From"])?.ToString() ?? ""), h => (object?)(h.FromStatus)).Add("To", h => (object?)(h.ToStatus)).Add("By", h => (object?)(h.ChangedBy != null ? h.ChangedBy.FirstName + " " + h.ChangedBy.LastName : "-"), css: "small").Add(((Localizer["Date"])?.ToString() ?? ""), h => (object?)(h.ChangedDate.ToString("yyyy-MM-dd HH:mm")), css: "small").Add(((Localizer["Reason"])?.ToString() ?? ""), h => (object?)(h.Reason ?? "-"), css: "small text-muted")))" dense="true" />
</pems-content-card>
