@model PEMS.Domain.Entities.StoreRequisition
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var statusHistory = (List<PEMS.Domain.Entities.StoreRequisitionStatusHistory>)ViewBag.StatusHistory;
    var nextStatus = (string?)ViewBag.NextStatus;
    var can = (Dictionary<string, bool>)ViewBag.Can;
    bool Can(string a) => can.TryGetValue(a, out var v) && v;
    bool isRequester = (bool)ViewBag.IsRequester;
    var nextAction = nextStatus switch { "Submitted" => "Submit", "Approved" => "Approve", "Reserved" => "Reserve", "Issued" => "Issue", "Closed" => "Close", _ => "" };
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.RequisitionNumber</h5>
            <div class="text-muted small">انبار: @Model.Warehouse?.Code - درخواست‌کننده: @(Model.RequestedBy?.FirstName) @(Model.RequestedBy?.LastName) - @Model.RequestedDate.ToString("yyyy-MM-dd")</div>
            @if (!string.IsNullOrWhiteSpace(Model.Purpose)) { <div class="small mt-1">@Model.Purpose</div> }
        </div>
        <div class="d-flex gap-2">
            <span class="badge fs-6 @(Model.Status is "Closed" or "Issued" ? "bg-success" : Model.Status == "PartiallyIssued" ? "bg-info text-dark" : Model.Status is "Rejected" or "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">@Model.Status</span>
        </div>
    </div>
    <hr />
    <div class="d-flex gap-2 flex-wrap">
        @if (nextStatus != null && nextStatus != "Issued" && Can(nextAction) && !(isRequester && nextStatus is "Approved"))
        {
            <form asp-action="AdvanceStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
                <button type="submit" class="btn btn-sm btn-pems-solid" onclick="return confirm('وضعیت به @nextStatus تغییر کنه؟')">@Localizer["SR_AdvanceTo"] @nextStatus</button>
            </form>
        }
        @if (Model.Status is "Draft" or "Submitted" or "Approved" && Can("Reject"))
        {
            <form asp-action="Reject" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('این درخواست رد بشه؟')">@Localizer["Reject"]</button>
            </form>
        }
        @if (Model.Status == "PartiallyIssued" && Can("CloseShort"))
        {
            <form asp-action="CloseShort" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('درخواست با کسری بسته شود و باقی‌مانده‌ی رزرو آزاد شود؟')">@Localizer["SR_CloseShort"]</button>
            </form>
        }
        @if (Model.Status is "Draft" or "Submitted" or "Approved" or "Reserved" && Can("Cancel"))
        {
            <form asp-action="Cancel" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('این درخواست لغو بشه؟')">@Localizer["Cancel"]</button>
            </form>
        }
    </div>
</div>

<div class="content-card mb-3">
    <h6 class="mb-3">Lines</h6>
    @{
        var editApproved = Model.Status == "Submitted" && Can("SetApprovedQuantity") && !isRequester;
        var canIssue = Model.Status is "Reserved" or "PartiallyIssued" && Can("Issue") && !isRequester;
    }
    <form id="srLinesForm" method="post" asp-action="@(editApproved ? "SetApprovedQuantities" : "Issue")">
        <input type="hidden" name="id" value="@Model.StoreRequisitionId" />
        <input type="hidden" name="requestKey" value="@Guid.NewGuid().ToString("N")" />
    <table class="table table-enterprise table-sm">
        <thead><tr><th>@Localizer["Material"]</th><th>Requested</th><th>@Localizer["Approved"]</th><th>Issued</th><th>@Localizer["SR_Remaining"]</th>@if (editApproved) { <th>@Localizer["Approved"]</th> } @if (canIssue) { <th>@Localizer["SR_IssueNow"]</th> }</tr></thead>
        <tbody>
            @foreach (var l in Model.Lines)
            {
                var approvedQty = l.ApprovedQuantity ?? l.RequestedQuantity;
                var remaining = approvedQty - l.IssuedQuantity;
                <tr>
                    <td class="small">@l.MaterialItem?.MaterialCode - @l.MaterialItem?.Description</td>
                    <td>@l.RequestedQuantity</td>
                    <td>@(l.ApprovedQuantity?.ToString() ?? "-")</td>
                    <td>@l.IssuedQuantity</td>
                    <td>@(remaining < 0 ? 0 : remaining)</td>
                    @if (editApproved) { <td style="width:130px"><input name="approved[@l.StoreRequisitionLineId]" type="number" step="0.001" min="0" max="@l.RequestedQuantity" value="@approvedQty" class="form-control form-control-sm" aria-label="@Localizer["Approved"]" /></td> }
                    @if (canIssue) { <td style="width:130px"><input name="qty[@l.StoreRequisitionLineId]" type="number" step="0.001" min="0" max="@(remaining < 0 ? 0 : remaining)" class="form-control form-control-sm" placeholder="0" aria-label="@Localizer["SR_IssueNow"]" /></td> }
                </tr>
            }
        </tbody>
    </table>
    @if (editApproved) { <button type="submit" class="btn btn-sm btn-pems-solid">@Localizer["Save"]</button> }
    @if (canIssue) { <button type="submit" class="btn btn-sm btn-pems-solid">@Localizer["SR_IssuePartialOrFull"]</button> <span class="small text-muted">@Localizer["SR_IssueHint"]</span> }
    </form>
    @if (!Model.Lines.Any()) { <p class="text-muted text-center py-3">@Localizer["هنوز خطی اضافه نشده."]</p> }

    @if (Model.Status == "Draft")
    {
        <form asp-action="AddLine" method="post" class="row g-2 mt-2">
            <input type="hidden" name="storeRequisitionId" value="@Model.StoreRequisitionId" />
            <div class="col-md-6">
                <select name="materialItemId" class="form-select form-select-sm" required>
                    @foreach (var m in materialItems) { <option value="@m.MaterialItemId">@m.MaterialCode - @m.Description</option> }
                </select>
            </div>
            <div class="col-md-3"><input name="requestedQuantity" type="number" step="0.001" class="form-control form-control-sm" placeholder="@Localizer["Quantity"]" required /></div>
            <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> Add Line</button></div>
        </form>
    }
</div>

<div class="content-card">
    <h6 class="mb-3">@Localizer["Status History"]</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th>@Localizer["From"]</th><th>To</th><th>By</th><th>@Localizer["Date"]</th><th>@Localizer["Reason"]</th></tr></thead>
        <tbody>
            @foreach (var h in statusHistory)
            {
                <tr>
                    <td>@h.FromStatus</td>
                    <td>@h.ToStatus</td>
                    <td class="small">@(h.ChangedBy != null ? h.ChangedBy.FirstName + " " + h.ChangedBy.LastName : "-")</td>
                    <td class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small text-muted">@(h.Reason ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
