@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.StoreRequisitionListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
    var statuses = new[] { "Draft", "Submitted", "Approved", "Reserved", "PartiallyIssued", "Issued", "Closed", "Rejected", "Cancelled" };
    var status = (string?)ViewBag.SelectedStatus;
    var filterCount = string.IsNullOrEmpty(status) ? 0 : 1;
    string StatusText(string? s) => VdrUi.Loc(Localizer, "SrL_St_", s);
    string StatusTone(string? s) => s switch
    {
        "Closed" or "Issued" => "vs-pill--success",
        "Rejected" or "Cancelled" => "vs-pill--danger",
        "Draft" => "vs-pill--neutral",
        _ => "vs-pill--warning"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W3: built from the PEMS.UI list-page component. The status select moved into the filters dropdown; the
   create modal stays (it moves to PemsModal with SCRUM-482). *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    @if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
    @if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["SrL_Title"]" heading-title="@Localizer["SrL_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="srFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="srFilterStatus" name="status" label="@Localizer["Ed_Status"]" value="@status"
                                             all-text="@Localizer["Eq_AllStatuses"]" items="@statuses.Select(s => new SelectListItem(StatusText(s), s))" />
                </pems-list-filters>
                <pems-list-reset-columns grid-key="StoreRequisition" />
                <pems-list-new modal="createRequisitionModal" text="@Localizer["SrL_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-chips>
            @if (!string.IsNullOrEmpty(status)) { <pems-list-chip label="@Localizer["Ed_Status"]" value="@StatusText(status)" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="StoreRequisition" empty="@(!Model.Items.Any())" empty-text="@Localizer["SrL_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["SrL_No"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="warehouse" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["ItL_Warehouse"]</pems-table-header>
                        <pems-table-header data-col-key="requestedBy" data-resizable="true" data-min-width="120" data-max-width="240" class="vs-hide-md pems-w-160">@Localizer["SrL_RequestedBy"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Cm_Date"]</pems-table-header>
                        <pems-table-header data-col-key="purpose" data-resizable="true" data-min-width="140" data-max-width="420">@Localizer["SrL_Purpose"]</pems-table-header>
                        <pems-table-header class="pems-w-130" data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Ed_Status"]</pems-table-header>
                        <pems-table-header class="pems-w-60" data-col-key="actions" data-resizable="false"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var r in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><a asp-action="Details" asp-route-id="@r.StoreRequisitionId" class="lp-subject" title="@r.RequisitionNumber">@r.RequisitionNumber</a></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@r.WarehouseCode</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md">@r.RequestedByName</pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-num">@r.RequestedDate.ToString("yyyy-MM-dd")</span></pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-title-cell" title="@r.Purpose">@(r.Purpose ?? "-")</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @StatusTone(r.Status)">@StatusText(r.Status)</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <a asp-action="Details" asp-route-id="@r.StoreRequisitionId" class="lp-act lp-act--always" title="@Localizer["Ed_View"]" aria-label="@Localizer["Ed_View"]"><pems-icon name="bi-card-text" aria-hidden="true" /></a>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "StoreRequisition",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.IsNullOrEmpty(status) ? "" : $"status={Uri.EscapeDataString(status)}"
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="createRequisitionModal" tabindex="-1">
        <pems-form asp-action="Create" method="post">
            <pems-modal-header>@Localizer["Store Requisition جدید"]</pems-modal-header>
            <pems-modal-body>
                <div class="mb-2">
                    <pems-label css="small">@Localizer["انبار"]</pems-label>
                    <pems-select scale="small" name="warehouseId" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </pems-select>
                </div>
                <div class="mb-2"><pems-label css="small">@Localizer["هدف / دلیل (اختیاری)"]</pems-label><pems-textarea scale="small" name="purpose" rows="2"></pems-textarea></div>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ساخت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
