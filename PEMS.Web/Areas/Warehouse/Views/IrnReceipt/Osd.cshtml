@model PEMS.Application.Interfaces.OsdReport
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* SCRUM-473: OS&D (over, short and damaged) report of one goods receipt, for the vendor. Same print pattern as the passports. *@

<pems-content-card css="mb-3 d-print-none">
    <pems-flex justify="between" align="center" wrap="true" gap="2">
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Details" asp-route-id="@Model.IrnReceiptId"><pems-icon name="bi-arrow-left" /> @Model.IrnNumber</pems-button>
        <pems-button tone="neutral" size="small" outline="true" onclick="window.print()"><pems-icon name="bi-printer" /> @Localizer["Print"]</pems-button>
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <h5 class="mb-1">@Localizer["Rcv_OsdTitle"]</h5>
    <div class="small text-muted mb-3">@Localizer["Rcv_OsdSubtitle"]</div>
    <pems-row gap="2" css="small">
        <pems-col span="6" md="3"><strong>@Localizer["IRN"]:</strong> @Model.IrnNumber (@Model.IrnStatus)</pems-col>
        <pems-col span="6" md="3"><strong>@Localizer["Date"]:</strong> @Model.ReceivingDate.ToString("yyyy-MM-dd")</pems-col>
        <pems-col span="6" md="3"><strong>@Localizer["Vendor"]:</strong> @Model.VendorName</pems-col>
        <pems-col span="6" md="3"><strong>@Localizer["PO"]:</strong> @(Model.PoNumber ?? "-")</pems-col>
        <pems-col span="6" md="3"><strong>@Localizer["Warehouse"]:</strong> @Model.WarehouseCode</pems-col>
        <pems-col span="6" md="3"><strong>@Localizer["Received By"]:</strong> @(Model.ReceivedBy ?? "-")</pems-col>
    </pems-row>
</pems-content-card>

<pems-content-card css="mb-3">
    @if (!Model.HasDiscrepancy)
    {
        <pems-alert tone="success" css="py-2 px-3 small mb-3">@Localizer["Rcv_OsdClean"]</pems-alert>
    }
    <pems-table kind="enterprise" scale="small">
        <pems-table-head>
            <pems-table-row>
                <pems-table-header>@Localizer["Rcv_PoLine"]</pems-table-header>
                <pems-table-header>@Localizer["Material"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_Ordered"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_ReceivedBefore"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_ThisReceipt"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_Over"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_Short"]</pems-table-header>
                <pems-table-header>@Localizer["Accepted"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_RejectedDamaged"]</pems-table-header>
                <pems-table-header>@Localizer["Hold"]</pems-table-header>
                <pems-table-header>@Localizer["Rcv_Decision"]</pems-table-header>
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var l in Model.Lines)
            {
                <pems-table-row>
                    <pems-table-cell>@(l.WithoutPoLine ? Localizer["Rcv_NoPoLine"].Value : l.PoLineNo?.ToString())</pems-table-cell>
                    <pems-table-cell class="small">@l.MaterialCode - @l.Description</pems-table-cell>
                    <pems-table-cell>@(l.WithoutPoLine ? "-" : $"{l.Ordered:0.###}") @l.Unit</pems-table-cell>
                    <pems-table-cell>@(l.WithoutPoLine ? "-" : $"{l.ReceivedBefore:0.###}")</pems-table-cell>
                    <pems-table-cell>@l.ThisReceipt.ToString("0.###")</pems-table-cell>
                    <pems-table-cell class="@(l.Over > 0 ? "text-danger fw-semibold" : "")">@l.Over.ToString("0.###")</pems-table-cell>
                    <pems-table-cell class="@(l.Short > 0 ? "text-warning fw-semibold" : "")">@l.Short.ToString("0.###")</pems-table-cell>
                    <pems-table-cell>@(l.Accepted?.ToString("0.###") ?? "-")</pems-table-cell>
                    <pems-table-cell class="@(l.Rejected > 0 ? "text-danger fw-semibold" : "")">@l.Rejected.ToString("0.###")</pems-table-cell>
                    <pems-table-cell>@l.Hold.ToString("0.###")</pems-table-cell>
                    <pems-table-cell class="small">@(l.Rejected > 0 && !l.WithoutPoLine ? Localizer["Rcv_Action_" + (l.RejectionAction ?? "Replace")].Value : "-")</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    <p class="small text-muted mb-0">@Localizer["Rcv_OsdNote"]</p>
</pems-content-card>
