@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.IrnReceiptListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
    var statuses = new[] { "Draft", "Submitted", "PendingApproval", "Closed", "Cancelled" };
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" style="max-width:180px;" onchange="this.form.submit()">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in statuses) { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </select>
        </form>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createIrnModal">
            <i class="bi bi-plus-lg"></i> @Localizer["New IRN"]
        </button>
    </div>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('IrnReceipt')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="IrnReceipt">
        <thead>
            <tr>
                <th data-col-key="number" data-resizable="true" data-min-width="110" data-max-width="200">@Localizer["IRN No."]</th>
                <th data-col-key="vendor" data-resizable="true" data-min-width="120" data-max-width="260">@Localizer["Vendor"]</th>
                <th data-col-key="warehouse" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Warehouse"]</th>
                <th data-col-key="receivedBy" data-resizable="true" data-min-width="120" data-max-width="240">@Localizer["Received By"]</th>
                <th data-col-key="date" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Receiving Date"]</th>
                <th data-col-key="lines" data-resizable="true" data-min-width="60" data-max-width="100">@Localizer["Lines"]</th>
                <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="160">@Localizer["Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                var badgeClass = r.Status switch
                {
                    "Submitted" => "bg-warning text-dark",
                    "PendingApproval" => "bg-info text-dark",
                    "Closed" => "bg-success",
                    "Cancelled" => "bg-secondary",
                    _ => "bg-light text-dark border"
                };
                <tr>
                    <td class="small fw-bold"><a asp-action="Details" asp-route-id="@r.IrnReceiptId">@r.IrnNumber</a></td>
                    <td class="small">@r.VendorName</td>
                    <td class="small">@r.WarehouseCode</td>
                    <td class="small">@r.ReceivedByName</td>
                    <td class="small">@r.ReceivingDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@r.LineCount</td>
                    <td><span class="badge @badgeClass">@r.Status</span></td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@r.IrnReceiptId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-card-text"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["No incoming receipts found."]</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "IrnReceipt",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>

<div class="modal fade" id="createIrnModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="Create" method="post">
            <div class="modal-header"><h6 class="modal-title">@Localizer["New Incoming Receipt (IRN)"]</h6></div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Vendor"]</label>
                    <select name="vendorId" class="form-select form-select-sm" required>
                        @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Warehouse"]</label>
                    <select name="warehouseId" class="form-select form-select-sm" required>
                        @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code</option> }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Receiving Date"]</label>
                    <input name="receivingDate" type="date" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small">@Localizer["Notes (optional)"]</label>
                    <textarea name="notes" class="form-control form-control-sm" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Create"]</button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('IrnReceipt');
        });
    </script>
}
