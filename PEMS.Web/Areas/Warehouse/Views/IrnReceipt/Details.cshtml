@model PEMS.Domain.Entities.IrnReceipt
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var statusHistory = (List<PEMS.Domain.Entities.IrnReceiptStatusHistory>)ViewBag.StatusHistory;
    var dispositionRecords = (List<PEMS.Domain.Entities.IrnDispositionRecord>)ViewBag.DispositionRecords;
    // SCRUM-473: receiving against PO lines, rejection decision (D6b), Hold resolution (D7)
    var poLines = ViewBag.PoLines as IReadOnlyList<PEMS.Application.Interfaces.PoLineReceivingView>;
    var poLineNo = poLines?.ToDictionary(p => p.PurchaseOrderLineId, p => p.LineNo) ?? new Dictionary<int, int>();
    var canDecideRejection = ViewBag.CanDecideRejection == true;
    var canResolveHold = ViewBag.CanResolveHold == true;
    var anyPoLine = Model.Lines.Any(l => l.PurchaseOrderLineId.HasValue);
    var badgeClass = Model.Status switch
    {
        "Submitted" => "bg-warning text-dark",
        "PendingApproval" => "bg-info text-dark",
        "Closed" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-light text-dark border"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}
@if (TempData["Warning"] != null)
{
    <pems-alert tone="warning" css="py-2 px-3 small"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Warning"]</pems-alert>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.IrnNumber</h5>
            <div class="text-muted small">
                @Localizer["Vendor"]: @Model.Vendor?.Name &middot;
                @Localizer["Warehouse"]: @Model.Warehouse?.Code &middot;
                @Localizer["Received By"]: @(Model.ReceivedBy?.FirstName) @(Model.ReceivedBy?.LastName) &middot;
                @Model.ReceivingDate.ToString("yyyy-MM-dd")
                @if (Model.PurchaseOrder != null) { <text>&middot; @Localizer["PO"]: @Model.PurchaseOrder.PoNumber</text> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="small mt-1">@Model.Notes</div> }
        </div>
        <span class="badge fs-6 @badgeClass">@Model.Status</span>
    </div>
    <hr />
    <div class="d-flex gap-2 flex-wrap align-items-center">
        @if (Model.Status == "Draft")
        {
            <form asp-action="Submit" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <button type="submit" class="btn btn-sm btn-pems-solid" onclick="return confirm('Submit this IRN for inspection?')">
                    <i class="bi bi-send"></i> @Localizer["Submit for Inspection"]
                </button>
            </form>
        }
        @if (Model.Status is "Draft" or "Submitted")
        {
            <form asp-action="Cancel" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Cancel this IRN?')">@Localizer["Cancel IRN"]</button>
            </form>
        }
        @if (Model.Status == "Submitted")
        {
            <span class="small text-muted">@Localizer["Awaiting disposition — see the inspection form below."]</span>
        }
        @if (Model.Status == "PendingApproval")
        {
            <span class="small text-muted">@Localizer["Disposition recorded — awaiting independent QA approval before any accepted quantity is posted to stock."]</span>
            <form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <input type="hidden" name="decision" value="Approve" />
                <button type="submit" class="btn btn-sm btn-pems-solid" onclick="return confirm('Approve this disposition? The accepted quantity will be posted to stock.')">
                    <i class="bi bi-check2-circle"></i> @Localizer["QA Approve"]
                </button>
            </form>
            <form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <input type="hidden" name="decision" value="Reject" />
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this disposition? The inspector will need to re-record it.')">
                    <i class="bi bi-x-circle"></i> @Localizer["QA Reject"]
                </button>
            </form>
        }
        @if (Model.Status == "Closed")
        {
            <span class="small text-success">@Localizer["Disposition approved — accepted quantity is posted to available stock."]</span>
        }
        @if (Model.Status != "Draft" && Model.Lines.Any())
        {
            <a asp-action="Osd" asp-route-id="@Model.IrnReceiptId" target="_blank" class="btn btn-sm btn-outline-secondary ms-auto">
                <i class="bi bi-printer"></i> @Localizer["Rcv_OsdReport"]
            </a>
        }
    </div>
</div>

<pems-related-list id="irnLines" icon="bi-list-ul" title="@Localizer["Lines"]" count="@Model.Lines.Count" empty="@(!Model.Lines.Any())" empty-text="@Localizer["No lines added yet."]">
    @if (Model.Lines.Any())
    {
    <pems-related-table>
        <thead>
            <tr>
                @if (anyPoLine) { <th>@Localizer["Rcv_PoLine"]</th> }
                <th>@Localizer["Material"]</th>
                <th>@Localizer["Received Qty"]</th>
                @if (Model.Status is "PendingApproval" or "Closed")
                {
                    <th>@Localizer["Accepted"]</th>
                    <th>@Localizer["Rejected"]</th>
                    <th>@Localizer["Hold"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lines)
            {
                var rejectedTotal = (l.RejectedQuantity ?? 0) + (l.HoldRejectedQuantity ?? 0);
                <tr>
                    @if (anyPoLine)
                    {
                        <td class="small">@(l.PurchaseOrderLineId.HasValue && poLineNo.TryGetValue(l.PurchaseOrderLineId.Value, out var no) ? no.ToString() : "-")</td>
                    }
                    <td class="small">@l.MaterialItem?.MaterialCode - @l.MaterialItem?.Description</td>
                    <td>@l.ReceivedQuantity</td>
                    @if (Model.Status is "PendingApproval" or "Closed")
                    {
                        <td class="text-success">
                            @(l.AcceptedQuantity ?? 0)
                            @if ((l.HoldAcceptedQuantity ?? 0) > 0) { <span class="small text-muted">+ @l.HoldAcceptedQuantity (@Localizer["Rcv_FromHold"])</span> }
                        </td>
                        <td class="text-danger">
                            @rejectedTotal
                            @if (Model.Status == "Closed" && rejectedTotal > 0 && l.PurchaseOrderLineId.HasValue)
                            {
                                <div class="small text-muted">@Localizer["Rcv_Decision"]: @Localizer["Rcv_Action_" + (l.RejectionAction ?? "Replace")]@(l.RejectionAction == null ? " (" + Localizer["Rcv_Default"].Value + ")" : "")</div>
                                @if (canDecideRejection)
                                {
                                    <form asp-action="DecideRejection" method="post" class="d-flex gap-1 mt-1">
                                        <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                                        <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                                        <select name="action" class="form-select form-select-sm">
                                            @foreach (var a in PEMS.Domain.Entities.IrnRejectionActions.All)
                                            {
                                                <option value="@a" selected="@(a == (l.RejectionAction ?? "Replace"))">@Localizer["Rcv_Action_" + a]</option>
                                            }
                                        </select>
                                        <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                                    </form>
                                }
                            }
                        </td>
                        <td class="text-warning">
                            @(l.HoldQuantity ?? 0)
                            @if (l.HoldResolvedAt != null)
                            {
                                <div class="small text-muted">@Localizer["Rcv_HoldResolvedBy"] @l.HoldResolvedByUserName, @l.HoldResolvedAt?.ToString("yyyy-MM-dd")</div>
                            }
                            else if (Model.Status == "Closed" && l.HasOpenHold && canResolveHold)
                            {
                                <form asp-action="ResolveHold" method="post" class="mt-1">
                                    <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                                    <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                                    <div class="d-flex gap-1">
                                        <input name="accepted" type="number" step="0.001" min="0" class="form-control form-control-sm" value="@l.HoldQuantity" title="@Localizer["Accepted"]" required />
                                        <input name="rejected" type="number" step="0.001" min="0" class="form-control form-control-sm" value="0" title="@Localizer["Rejected"]" required />
                                    </div>
                                    <input name="notes" class="form-control form-control-sm mt-1" placeholder="@Localizer["Notes"]" />
                                    <pems-button tone="primary" size="small" css="mt-1" type="submit" onclick="return confirm(this.dataset.confirm)" data-confirm="@Localizer["Rcv_ConfirmHold"]">@Localizer["Rcv_ResolveHold"]</pems-button>
                                </form>
                            }
                            else if (Model.Status == "Closed" && l.HasOpenHold)
                            {
                                <div class="small text-muted">@Localizer["Rcv_HoldWaits"]</div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </pems-related-table>
    }

    @if (Model.Status == "Draft" && poLines != null)
    {
        <div class="lp-rel-head"><h3>@Localizer["Rcv_ReceiveFromPo"] <span class="vs-num">@Model.PurchaseOrder?.PoNumber</span></h3></div>
        <p class="lp-rel-empty">@Localizer["Rcv_ReceiveHelp"]</p>
        <form asp-action="ReceiveFromPo" method="post">
            <input type="hidden" name="id" value="@Model.IrnReceiptId" />
            <pems-related-table>
                <thead>
                    <tr>
                        <th>#</th><th>@Localizer["Material"]</th><th>@Localizer["Rcv_DeliveryWarehouse"]</th><th>@Localizer["Rcv_Ordered"]</th>
                        <th>@Localizer["Rcv_ReceivedSoFar"]</th><th>@Localizer["Rcv_Open"]</th><th>@Localizer["Rcv_Inspection"]</th><th>@Localizer["Rcv_ReceiveNow"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in poLines)
                    {
                        <tr>
                            <td>@p.LineNo</td>
                            <td class="small">@(p.MaterialCode ?? "-") - @p.Description</td>
                            <td class="small">@(p.WarehouseCode ?? "-")</td>
                            <td>@p.Ordered @p.Unit</td>
                            <td>@p.Received</td>
                            <td>@p.Outstanding</td>
                            <td class="small">
                                @if (!p.InspectionRequired) { <span class="text-muted">-</span> }
                                else if (p.InspectionReleasedAt != null) { <span class="text-success">@Localizer["Rcv_Released"]</span> }
                                else { <span class="text-warning">@Localizer["Rcv_NotReleased"]</span> }
                            </td>
                            <td>
                                @if (p.CanReceive)
                                {
                                    <input type="hidden" name="poLineId" value="@p.PurchaseOrderLineId" />
                                    <input name="quantity" type="number" step="0.001" min="0" class="form-control form-control-sm" value="@p.Outstanding" />
                                }
                                else { <span class="small text-muted">@Localizer["Rcv_NotCatalogued"]</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </pems-related-table>
            <div class="lp-rel-add"><pems-button tone="primary" size="small" type="submit"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> @Localizer["Rcv_AddPoLines"]</pems-button></div>
        </form>
    }

    @if (Model.Status == "Draft")
    {
        <pems-related-add action="@Url.Action("AddLine")" parent-name="irnReceiptId" parent-value="@Model.IrnReceiptId.ToString()" submit-label="@Localizer["Add Line"]">
            <pems-list-filter-select id="irnAddMaterial" name="materialItemId" label="@Localizer["Material"]" items="@(((IEnumerable<dynamic>)materialItems).Select(m => new SelectListItem($"{m.MaterialCode} - {m.Description}", ((int)m.MaterialItemId).ToString())))" />
            <div style="flex:0 0 160px"><label class="lp-lbl" for="irnAddQty">@Localizer["Quantity"]</label><input id="irnAddQty" name="receivedQuantity" type="number" step="0.001" class="form-control form-control-sm" required /></div>
        </pems-related-add>
    }

    @if (Model.Status == "Submitted")
    {
        <div class="lp-rel-head"><h3>@Localizer["Record Disposition"]</h3></div>
        <p class="lp-rel-empty">@Localizer["Received ≠ Available: for each line, split the received quantity into Accepted / Rejected / Hold. The three must sum exactly to the received quantity. Only the Accepted portion will be posted to stock, and only after QA approval."]</p>
        <form asp-action="Disposition" method="post">
            <input type="hidden" name="id" value="@Model.IrnReceiptId" />
            <pems-related-table>
                <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Received"]</th><th>@Localizer["Accepted"]</th><th>@Localizer["Rejected"]</th><th>@Localizer["Hold"]</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr>
                            <td class="small">@l.MaterialItem?.MaterialCode</td>
                            <td>
                                @l.ReceivedQuantity
                                <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                            </td>
                            <td><input name="accepted" type="number" step="0.001" min="0" class="form-control form-control-sm" value="@l.ReceivedQuantity" required /></td>
                            <td><input name="rejected" type="number" step="0.001" min="0" class="form-control form-control-sm" value="0" required /></td>
                            <td><input name="hold" type="number" step="0.001" min="0" class="form-control form-control-sm" value="0" required /></td>
                        </tr>
                    }
                </tbody>
            </pems-related-table>
            <div class="lp-rel-add">
                <div><label class="lp-lbl" for="irnDispNotes">@Localizer["Notes"]</label><textarea id="irnDispNotes" name="notes" class="form-control form-control-sm" rows="2"></textarea></div>
                <pems-button tone="primary" size="small" type="submit" onclick="return confirm(this.dataset.confirm)" data-confirm="@Localizer["IrnD_ConfirmDisposition"]">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i> @Localizer["Record Disposition"]
                </pems-button>
            </div>
        </form>
    }
</pems-related-list>

@if (dispositionRecords.Any())
{
    <pems-related-list id="irnDispositions" icon="bi-clipboard-check" title="@Localizer["Disposition Records"]" count="@dispositionRecords.Count">
        <pems-related-table>
            <thead><tr><th>@Localizer["Result"]</th><th>@Localizer["By"]</th><th>@Localizer["Date"]</th><th>@Localizer["Outcome"]</th><th>@Localizer["Notes"]</th></tr></thead>
            <tbody>
                @foreach (var d in dispositionRecords)
                {
                    <tr>
                        <td>@d.OverallResult</td>
                        <td class="small">@(d.DispositionedBy != null ? d.DispositionedBy.FirstName + " " + d.DispositionedBy.LastName : "-")</td>
                        <td class="small">@d.DispositionedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="small">@d.WorkflowOutcome</td>
                        <td class="small text-muted">@(d.Notes ?? "-")</td>
                    </tr>
                }
            </tbody>
        </pems-related-table>
    </pems-related-list>
}

<pems-related-list id="irnHistory" icon="bi-clock-history" title="@Localizer["Status History"]" count="@statusHistory.Count" empty="@(!statusHistory.Any())" empty-text="@Localizer["No status changes yet."]">
    @if (statusHistory.Any())
    {
    <pems-related-table>
        <thead><tr><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["By"]</th><th>@Localizer["Date"]</th><th>@Localizer["Reason"]</th></tr></thead>
        <tbody>
            @foreach (var h in statusHistory)
            {
                <tr>
                    <td>@h.FromStatus</td>
                    <td>@h.ToStatus</td>
                    <td class="small">@(h.ChangedBy != null ? h.ChangedBy.FirstName + " " + h.ChangedBy.LastName : "-")</td>
                    <td class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small text-muted">@(h.Reason ?? "-")</td>
                </tr>
            }
        </tbody>
    </pems-related-table>
    }
</pems-related-list>
