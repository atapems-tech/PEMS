@model PEMS.Domain.Entities.IrnReceipt
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var statusHistory = (List<PEMS.Domain.Entities.IrnReceiptStatusHistory>)ViewBag.StatusHistory;
    var dispositionRecords = (List<PEMS.Domain.Entities.IrnDispositionRecord>)ViewBag.DispositionRecords;
    // SCRUM-473: receiving against PO lines, rejection decision (D6b), Hold resolution (D7)
    var poLines = ViewBag.PoLines as IReadOnlyList<PEMS.Application.Interfaces.PoLineReceivingView>;
    var poLineNo = poLines?.ToDictionary(p => p.PurchaseOrderLineId, p => p.LineNo) ?? new Dictionary<int, int>();
    var canDecideRejection = ViewBag.CanDecideRejection == true;
    var canResolveHold = ViewBag.CanResolveHold == true;
    var anyPoLine = Model.Lines.Any(l => l.PurchaseOrderLineId.HasValue);
    var badgeClass = Model.Status switch
    {
        "Submitted" => "warning",
        "PendingApproval" => "info",
        "Closed" => "success",
        "Cancelled" => "neutral",
        _ => "light"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}
@if (TempData["Warning"] != null)
{
    <pems-alert tone="warning" css="py-2 px-3 small"><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @TempData["Warning"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <h5 class="mb-1">@Model.IrnNumber</h5>
            <div class="text-muted small">
                @Localizer["Vendor"]: @Model.Vendor?.Name &middot;
                @Localizer["Warehouse"]: @Model.Warehouse?.Code &middot;
                @Localizer["Received By"]: @(Model.ReceivedBy?.FirstName) @(Model.ReceivedBy?.LastName) &middot;
                @Model.ReceivingDate.ToString("yyyy-MM-dd")
                @if (Model.PurchaseOrder != null) { <text>&middot; @Localizer["PO"]: @Model.PurchaseOrder.PoNumber</text> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="small mt-1">@Model.Notes</div> }
        </div>
        <pems-badge tone="@badgeClass" css="fs-6">@Model.Status</pems-badge>
    </pems-flex>
    <hr />
    <pems-flex gap="2" wrap="true" align="center">
        @if (Model.Status == "Draft")
        {
            <pems-form asp-action="Submit" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <pems-button tone="primary" size="small" type="submit" data-pems-confirm="Submit this IRN for inspection?">
                    <pems-icon name="bi-send" /> @Localizer["Submit for Inspection"]
                </pems-button>
            </pems-form>
        }
        @if (Model.Status is "Draft" or "Submitted")
        {
            <pems-form asp-action="Cancel" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="Cancel this IRN?">@Localizer["Cancel IRN"]</pems-button>
            </pems-form>
        }
        @if (Model.Status == "Submitted")
        {
            <span class="small text-muted">@Localizer["Awaiting disposition — see the inspection form below."]</span>
        }
        @if (Model.Status == "PendingApproval")
        {
            <span class="small text-muted">@Localizer["Disposition recorded — awaiting independent QA approval before any accepted quantity is posted to stock."]</span>
            <pems-form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <input type="hidden" name="decision" value="Approve" />
                <pems-button tone="primary" size="small" type="submit" data-pems-confirm="Approve this disposition? The accepted quantity will be posted to stock.">
                    <pems-icon name="bi-check2-circle" /> @Localizer["QA Approve"]
                </pems-button>
            </pems-form>
            <pems-form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                <input type="hidden" name="decision" value="Reject" />
                <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="Reject this disposition? The inspector will need to re-record it.">
                    <pems-icon name="bi-x-circle" /> @Localizer["QA Reject"]
                </pems-button>
            </pems-form>
        }
        @if (Model.Status == "Closed")
        {
            <span class="small text-success">@Localizer["Disposition approved — accepted quantity is posted to available stock."]</span>
        }
        @if (Model.Status != "Draft" && Model.Lines.Any())
        {
            <pems-button as="a" tone="neutral" size="small" outline="true" css="ms-auto" asp-action="Osd" asp-route-id="@Model.IrnReceiptId" target="_blank">
                <pems-icon name="bi-printer" /> @Localizer["Rcv_OsdReport"]
            </pems-button>
        }
    </pems-flex>
</pems-content-card>

<pems-related-list id="irnLines" icon="bi-list-ul" title="@Localizer["Lines"]" count="@Model.Lines.Count" empty="@(!Model.Lines.Any())" empty-text="@Localizer["No lines added yet."]">
    @if (Model.Lines.Any())
    {
    <pems-related-table>
        <pems-table-head>
            <pems-table-row>
                @if (anyPoLine) { <pems-table-header>@Localizer["Rcv_PoLine"]</pems-table-header> }
                <pems-table-header>@Localizer["Material"]</pems-table-header>
                <pems-table-header>@Localizer["Received Qty"]</pems-table-header>
                @if (Model.Status is "PendingApproval" or "Closed")
                {
                    <pems-table-header>@Localizer["Accepted"]</pems-table-header>
                    <pems-table-header>@Localizer["Rejected"]</pems-table-header>
                    <pems-table-header>@Localizer["Hold"]</pems-table-header>
                }
            </pems-table-row>
        </pems-table-head>
        <pems-table-body>
            @foreach (var l in Model.Lines)
            {
                var rejectedTotal = (l.RejectedQuantity ?? 0) + (l.HoldRejectedQuantity ?? 0);
                <pems-table-row>
                    @if (anyPoLine)
                    {
                        <pems-table-cell class="small">@(l.PurchaseOrderLineId.HasValue && poLineNo.TryGetValue(l.PurchaseOrderLineId.Value, out var no) ? no.ToString() : "-")</pems-table-cell>
                    }
                    <pems-table-cell class="small">@l.MaterialItem?.MaterialCode - @l.MaterialItem?.Description</pems-table-cell>
                    <pems-table-cell>@l.ReceivedQuantity</pems-table-cell>
                    @if (Model.Status is "PendingApproval" or "Closed")
                    {
                        <pems-table-cell class="text-success">
                            @(l.AcceptedQuantity ?? 0)
                            @if ((l.HoldAcceptedQuantity ?? 0) > 0) { <span class="small text-muted">+ @l.HoldAcceptedQuantity (@Localizer["Rcv_FromHold"])</span> }
                        </pems-table-cell>
                        <pems-table-cell class="text-danger">
                            @rejectedTotal
                            @if (Model.Status == "Closed" && rejectedTotal > 0 && l.PurchaseOrderLineId.HasValue)
                            {
                                <div class="small text-muted">@Localizer["Rcv_Decision"]: @Localizer["Rcv_Action_" + (l.RejectionAction ?? "Replace")]@(l.RejectionAction == null ? " (" + Localizer["Rcv_Default"].Value + ")" : "")</div>
                                @if (canDecideRejection)
                                {
                                    <pems-form class="mt-1" asp-action="DecideRejection" method="post"><pems-flex gap="1">
                                        <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                                        <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                                        <pems-select scale="small" name="action">
                                            @foreach (var a in PEMS.Domain.Entities.IrnRejectionActions.All)
                                            {
                                                <option value="@a" selected="@(a == (l.RejectionAction ?? "Replace"))">@Localizer["Rcv_Action_" + a]</option>
                                            }
                                        </pems-select>
                                        <pems-button tone="neutral" size="small" outline="true" type="submit">@Localizer["Save"]</pems-button>
                                    </pems-flex></pems-form>
                                }
                            }
                        </pems-table-cell>
                        <pems-table-cell class="text-warning">
                            @(l.HoldQuantity ?? 0)
                            @if (l.HoldResolvedAt != null)
                            {
                                <div class="small text-muted">@Localizer["Rcv_HoldResolvedBy"] @l.HoldResolvedByUserName, @l.HoldResolvedAt?.ToString("yyyy-MM-dd")</div>
                            }
                            else if (Model.Status == "Closed" && l.HasOpenHold && canResolveHold)
                            {
                                <pems-form asp-action="ResolveHold" method="post" class="mt-1">
                                    <input type="hidden" name="id" value="@Model.IrnReceiptId" />
                                    <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                                    <pems-flex gap="1">
                                        <pems-input scale="small" name="accepted" type="number" step="0.001" min="0" value="@l.HoldQuantity" title="@Localizer["Accepted"]" required />
                                        <pems-input scale="small" name="rejected" type="number" step="0.001" min="0" value="0" title="@Localizer["Rejected"]" required />
                                    </pems-flex>
                                    <pems-input scale="small" css="mt-1" name="notes" placeholder="@Localizer["Notes"]" />
                                    <pems-button tone="primary" size="small" css="mt-1" type="submit" data-pems-confirm="@Localizer["Rcv_ConfirmHold"]">@Localizer["Rcv_ResolveHold"]</pems-button>
                                </pems-form>
                            }
                            else if (Model.Status == "Closed" && l.HasOpenHold)
                            {
                                <div class="small text-muted">@Localizer["Rcv_HoldWaits"]</div>
                            }
                        </pems-table-cell>
                    }
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    }

    @if (Model.Status == "Draft" && poLines != null)
    {
        <div class="lp-rel-head"><h3>@Localizer["Rcv_ReceiveFromPo"] <span class="vs-num">@Model.PurchaseOrder?.PoNumber</span></h3></div>
        <p class="lp-rel-empty">@Localizer["Rcv_ReceiveHelp"]</p>
        <pems-form asp-action="ReceiveFromPo" method="post">
            <input type="hidden" name="id" value="@Model.IrnReceiptId" />
            <pems-related-table>
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>#</pems-table-header><pems-table-header>@Localizer["Material"]</pems-table-header><pems-table-header>@Localizer["Rcv_DeliveryWarehouse"]</pems-table-header><pems-table-header>@Localizer["Rcv_Ordered"]</pems-table-header>
                        <pems-table-header>@Localizer["Rcv_ReceivedSoFar"]</pems-table-header><pems-table-header>@Localizer["Rcv_Open"]</pems-table-header><pems-table-header>@Localizer["Rcv_Inspection"]</pems-table-header><pems-table-header>@Localizer["Rcv_ReceiveNow"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var p in poLines)
                    {
                        <pems-table-row>
                            <pems-table-cell>@p.LineNo</pems-table-cell>
                            <pems-table-cell class="small">@(p.MaterialCode ?? "-") - @p.Description</pems-table-cell>
                            <pems-table-cell class="small">@(p.WarehouseCode ?? "-")</pems-table-cell>
                            <pems-table-cell>@p.Ordered @p.Unit</pems-table-cell>
                            <pems-table-cell>@p.Received</pems-table-cell>
                            <pems-table-cell>@p.Outstanding</pems-table-cell>
                            <pems-table-cell class="small">
                                @if (!p.InspectionRequired) { <span class="text-muted">-</span> }
                                else if (p.InspectionReleasedAt != null) { <span class="text-success">@Localizer["Rcv_Released"]</span> }
                                else { <span class="text-warning">@Localizer["Rcv_NotReleased"]</span> }
                            </pems-table-cell>
                            <pems-table-cell>
                                @if (p.CanReceive)
                                {
                                    <input type="hidden" name="poLineId" value="@p.PurchaseOrderLineId" />
                                    <pems-input scale="small" name="quantity" type="number" step="0.001" min="0" value="@p.Outstanding" />
                                }
                                else { <span class="small text-muted">@Localizer["Rcv_NotCatalogued"]</span> }
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
            <div class="lp-rel-add"><pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-box-arrow-in-down" aria-hidden="true" /> @Localizer["Rcv_AddPoLines"]</pems-button></div>
        </pems-form>
    }

    @if (Model.Status == "Draft")
    {
        <pems-related-add action="@Url.Action("AddLine")" parent-name="irnReceiptId" parent-value="@Model.IrnReceiptId.ToString()" submit-label="@Localizer["Add Line"]">
            <pems-list-filter-select id="irnAddMaterial" name="materialItemId" label="@Localizer["Material"]" items="@(((IEnumerable<dynamic>)materialItems).Select(m => new SelectListItem($"{m.MaterialCode} - {m.Description}", ((int)m.MaterialItemId).ToString())))" />
            <div class="pems-s-929aba04"><label class="lp-lbl" for="irnAddQty">@Localizer["Quantity"]</label><pems-input scale="small" id="irnAddQty" name="receivedQuantity" type="number" step="0.001" required /></div>
        </pems-related-add>
    }

    @if (Model.Status == "Submitted")
    {
        <div class="lp-rel-head"><h3>@Localizer["Record Disposition"]</h3></div>
        <p class="lp-rel-empty">@Localizer["Received ≠ Available: for each line, split the received quantity into Accepted / Rejected / Hold. The three must sum exactly to the received quantity. Only the Accepted portion will be posted to stock, and only after QA approval."]</p>
        <pems-form asp-action="Disposition" method="post">
            <input type="hidden" name="id" value="@Model.IrnReceiptId" />
            <pems-related-table>
                <pems-table-head><pems-table-row><pems-table-header>@Localizer["Material"]</pems-table-header><pems-table-header>@Localizer["Received"]</pems-table-header><pems-table-header>@Localizer["Accepted"]</pems-table-header><pems-table-header>@Localizer["Rejected"]</pems-table-header><pems-table-header>@Localizer["Hold"]</pems-table-header></pems-table-row></pems-table-head>
                <pems-table-body>
                    @foreach (var l in Model.Lines)
                    {
                        <pems-table-row>
                            <pems-table-cell class="small">@l.MaterialItem?.MaterialCode</pems-table-cell>
                            <pems-table-cell>
                                @l.ReceivedQuantity
                                <input type="hidden" name="lineId" value="@l.IrnReceiptLineId" />
                            </pems-table-cell>
                            <pems-table-cell><pems-input scale="small" name="accepted" type="number" step="0.001" min="0" value="@l.ReceivedQuantity" required /></pems-table-cell>
                            <pems-table-cell><pems-input scale="small" name="rejected" type="number" step="0.001" min="0" value="0" required /></pems-table-cell>
                            <pems-table-cell><pems-input scale="small" name="hold" type="number" step="0.001" min="0" value="0" required /></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-related-table>
            <div class="lp-rel-add">
                <div><label class="lp-lbl" for="irnDispNotes">@Localizer["Notes"]</label><pems-textarea scale="small" id="irnDispNotes" name="notes" rows="2"></pems-textarea></div>
                <pems-button tone="primary" size="small" type="submit" data-pems-confirm="@Localizer["IrnD_ConfirmDisposition"]">
                    <pems-icon name="bi-clipboard-check" aria-hidden="true" /> @Localizer["Record Disposition"]
                </pems-button>
            </div>
        </pems-form>
    }
</pems-related-list>

@if (dispositionRecords.Any())
{
    <pems-related-list id="irnDispositions" icon="bi-clipboard-check" title="@Localizer["Disposition Records"]" count="@dispositionRecords.Count">
        <pems-related-table>
            <pems-table-head><pems-table-row><pems-table-header>@Localizer["Result"]</pems-table-header><pems-table-header>@Localizer["By"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Outcome"]</pems-table-header><pems-table-header>@Localizer["Notes"]</pems-table-header></pems-table-row></pems-table-head>
            <pems-table-body>
                @foreach (var d in dispositionRecords)
                {
                    <pems-table-row>
                        <pems-table-cell>@d.OverallResult</pems-table-cell>
                        <pems-table-cell class="small">@(d.DispositionedBy != null ? d.DispositionedBy.FirstName + " " + d.DispositionedBy.LastName : "-")</pems-table-cell>
                        <pems-table-cell class="small">@d.DispositionedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                        <pems-table-cell class="small">@d.WorkflowOutcome</pems-table-cell>
                        <pems-table-cell class="small text-muted">@(d.Notes ?? "-")</pems-table-cell>
                    </pems-table-row>
                }
            </pems-table-body>
        </pems-related-table>
    </pems-related-list>
}

<pems-related-list id="irnHistory" icon="bi-clock-history" title="@Localizer["Status History"]" count="@statusHistory.Count" empty="@(!statusHistory.Any())" empty-text="@Localizer["No status changes yet."]">
    @if (statusHistory.Any())
    {
    <pems-related-table>
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["From"]</pems-table-header><pems-table-header>@Localizer["To"]</pems-table-header><pems-table-header>@Localizer["By"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header>@Localizer["Reason"]</pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var h in statusHistory)
            {
                <pems-table-row>
                    <pems-table-cell>@h.FromStatus</pems-table-cell>
                    <pems-table-cell>@h.ToStatus</pems-table-cell>
                    <pems-table-cell class="small">@(h.ChangedBy != null ? h.ChangedBy.FirstName + " " + h.ChangedBy.LastName : "-")</pems-table-cell>
                    <pems-table-cell class="small">@h.ChangedDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell class="small text-muted">@(h.Reason ?? "-")</pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-related-table>
    }
</pems-related-list>
