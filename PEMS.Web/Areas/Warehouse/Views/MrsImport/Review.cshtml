@model PEMS.Application.DTOs.MrsImportBatchDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var rows = Model.Rows.Items;
    var matchStatusFilter = (string?)ViewBag.MatchStatusFilter;
    var filterOptions = new[] { "New", "MatchedExisting", "DuplicateInBatch", "Invalid" };
    string FilterLabel(string s) => s switch
    {
        "New" => Localizer["New"].Value,
        "MatchedExisting" => "Matched",
        "DuplicateInBatch" => "Duplicate",
        "Invalid" => Localizer["Invalid"].Value,
        _ => s
    };
}

<pems-content-card css="mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">
                @Model.Batch.SourceFileName
                @if (!string.IsNullOrWhiteSpace(Model.Batch.SourceFileDownloadUrl))
                {
                    <a href="@Model.Batch.SourceFileDownloadUrl" class="small ms-2"><pems-icon name="bi-download" /> Download original file</a>
                }
            </h5>
            <span class="text-muted small">Batch #@Model.Batch.MrsImportBatchId - شیت @Model.Batch.SourceSheet - @Model.Batch.TotalRows ردیف - @Model.Batch.ImportDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> Back</pems-button>
    </div>
</pems-content-card>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <div class="admin-kpi-grid">
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["New"]</div><div class="admin-kpi-value">@Model.Batch.NewCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Matched Existing</div><div class="admin-kpi-value">@Model.Batch.MatchedCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">Duplicate In Batch</div><div class="admin-kpi-value">@Model.Batch.DuplicateCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["Invalid"]</div><div class="admin-kpi-value">@Model.Batch.InvalidCount</div></div>
        <div class="admin-kpi"><div class="admin-kpi-label">@Localizer["Approved"]</div><div class="admin-kpi-value">@Model.Batch.ApprovedCount</div></div>
    </div>
    <p class="text-muted small mt-2 mb-0">فایل کامل را آپلود کنید - PEMS فایل‌های بزرگ را داخلی و خودکار پردازش می‌کند. این صفحه برای بازبینی، صفحه‌بندی شده است (@Model.Rows.TotalCount ردیف در این فیلتر)؛ همه‌ی ردیف‌ها - نه فقط صفحه‌ی جاری - از طریق فیلتر Match Status زیر و دکمه‌ی «Commit/Reject سراسر Batch» قابل‌دسترسی و قابل‌عمل‌اند.</p>
</pems-content-card>

<form id="bulkCommitForm" asp-action="BulkCommit" method="post">
    <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
</form>
<form id="bulkRejectForm" asp-action="BulkReject" method="post">
    <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
</form>

<pems-content-card css="pems-filter-bar mb-3">
    <span class="pems-filter-label">@Localizer["Filter"]</span>
    <pems-button as="a" tone="none" size="small" css="@(matchStatusFilter == null ? "btn-pems-solid" : "btn-outline-secondary")" asp-action="Review" asp-route-batchId="@Model.Batch.MrsImportBatchId">@Localizer["All"]</pems-button>
    @foreach (var s in filterOptions)
    {
        <pems-button as="a" tone="none" size="small" css="@(matchStatusFilter == s ? "btn-pems-solid" : "btn-outline-secondary")" asp-action="Review" asp-route-batchId="@Model.Batch.MrsImportBatchId" asp-route-matchStatusFilter="@s">@FilterLabel(s)</pems-button>
    }
    @if (!string.IsNullOrEmpty(matchStatusFilter))
    {
        <span class="pems-command-bar-spacer"></span>
        @if (matchStatusFilter != "Invalid")
        {
            <form asp-action="CommitByStatus" method="post" class="d-inline">
                <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
                <input type="hidden" name="matchStatusFilter" value="@matchStatusFilter" />
                <pems-button tone="primary" size="small" type="submit" data-pems-confirm="همه‌ی ردیف‌های Pending با وضعیت «@FilterLabel(matchStatusFilter)» در کل این Batch (نه فقط این صفحه) تایید و به MaterialItem/InventoryTransaction تبدیل شوند؟">
                    <pems-icon name="bi-check2-all" /> Commit ALL "@FilterLabel(matchStatusFilter)" in entire batch
                </pems-button>
            </form>
        }
        <form asp-action="RejectByStatus" method="post" class="d-inline">
            <input type="hidden" name="batchId" value="@Model.Batch.MrsImportBatchId" />
            <input type="hidden" name="matchStatusFilter" value="@matchStatusFilter" />
            <pems-button tone="danger" size="small" outline="true" type="submit" data-pems-confirm="همه‌ی ردیف‌های Pending با وضعیت «@FilterLabel(matchStatusFilter)» در کل این Batch رد شوند؟">
                <pems-icon name="bi-x-circle" /> Reject ALL "@FilterLabel(matchStatusFilter)" in entire batch
            </pems-button>
        </form>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <div class="input-group admin-search pems-s-2f3f7d77">
            <span class="input-group-text"><pems-icon name="bi-search" /></span>
            <pems-input type="search" id="rowSearch" placeholder="Filter this page by description..." autocomplete="off" />
        </div>
        <span class="text-muted small">Manual selection below applies to this page only (@rows.Count of @Model.Rows.TotalCount rows in this filter) - use the batch-wide Commit/Reject buttons above to act on every matching row.</span>
        <pems-button tone="primary" size="small" css="ms-auto" type="submit" form="bulkCommitForm" id="bulkCommitBtn" disabled="true" data-pems-confirm="تعداد {n} ردیف انتخاب‌شده (این صفحه) تایید و به MaterialItem/InventoryTransaction تبدیل شود؟" data-pems-confirm-count="#selectedCount">
            <pems-icon name="bi-check2-circle" /> Commit Selected (<span id="selectedCount">0</span>)
        </pems-button>
        <pems-button tone="danger" size="small" outline="true" type="submit" form="bulkRejectForm" id="bulkRejectBtn" disabled="true" data-pems-confirm="ردیف‌های انتخاب‌شده (این صفحه) رد شوند؟">
            <pems-icon name="bi-x-circle" /> Reject Selected
        </pems-button>
    </div>
</pems-content-card>

<pems-content-card>
    <div class="table-responsive table-scroll-area pems-s-a7ef6ffc">
        <pems-table kind="enterprise" scale="small">
            <thead>
                <tr>
                    <th class="pems-w-30"><input type="checkbox" id="selectAllPending" /></th>
                    <th>@Localizer["MRS No"]</th><th>Item Code</th><th>@Localizer["Description"]</th><th>@Localizer["UOM"]</th><th>@Localizer["Vendor"]</th><th>PO No</th><th>Qty Recv</th><th>Qty Issued</th>
                    <th>@Localizer["Warehouse"]</th><th>Match Status</th><th>Matched Material</th><th>@Localizer["Review"]</th><th class="pems-w-40"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var badgeClass = row.MatchStatus switch
                    {
                        "MatchedExisting" => "info",
                        "DuplicateInBatch" => "warning",
                        "Invalid" => "danger",
                        _ => "primary"
                    };
                    var isSelectable = row.ReviewStatus == "Pending" && row.MatchStatus != "Invalid";
                    var metaRowId = "meta-" + row.MrsImportRowId;

                    <tr class="row-item" data-status="@row.MatchStatus" data-desc="@(row.RawDescription ?? "").ToLower()">
                        <td>
                            @if (isSelectable)
                            {
                                <input type="checkbox" class="row-select" form="bulkCommitForm" name="selectedRowIds" value="@row.MrsImportRowId" />
                                <input type="checkbox" class="row-select-reject d-none" form="bulkRejectForm" name="selectedRowIds" value="@row.MrsImportRowId" />
                            }
                        </td>
                        <td class="small">@(row.RawMrsNo ?? "-")</td>
                        <td class="small">@(row.RawItemCode ?? "-")</td>
                        <td class="small pems-s-55585d51">@(row.RawDescription ?? "-")</td>
                        <td class="small">@(row.RawUom ?? "-")</td>
                        <td class="small">@(row.RawSupplier ?? "-")</td>
                        <td class="small">@(row.RawPoNo ?? "-")</td>
                        <td class="small">@(row.RawQtyReceived?.ToString() ?? "-")</td>
                        <td class="small">@(row.RawQtyIssued?.ToString() ?? "-")</td>
                        <td class="small">@(row.ResolvedWarehouseCode ?? "-")</td>
                        <td><pems-badge tone="@badgeClass">@row.MatchStatus</pems-badge></td>
                        <td class="small">@(row.MatchedMaterialCode != null ? row.MatchedMaterialCode + " - " + row.MatchedMaterialDescription : "-")</td>
                        <td>
                            @if (row.ReviewStatus == "Approved" && !string.IsNullOrWhiteSpace(row.ErrorMessage))
                            {
                                <span class="small text-warning" title="@row.ErrorMessage"><pems-icon name="bi-exclamation-triangle" /> Approved (@row.ErrorMessage)</span>
                            }
                            else if (row.ReviewStatus == "Approved")
                            {
                                <span class="small text-success"><pems-icon name="bi-check-circle" /> @Localizer["Approved"]</span>
                            }
                            else if (row.ReviewStatus == "Rejected")
                            {
                                <span class="small text-muted"><pems-icon name="bi-x-circle" /> @Localizer["Rejected"]</span>
                            }
                            else if (row.MatchStatus == "Invalid")
                            {
                                <span class="small text-danger">@row.ErrorMessage</span>
                            }
                            else
                            {
                                <span class="small text-muted">@Localizer["Pending"]</span>
                            }
                        </td>
                        <td>
                            @if (row.Metadata.Any())
                            {
                                <pems-button tone="neutral" size="small" outline="true" css="meta-toggle" type="button" data-target="@metaRowId" title="Show all Excel columns for this row">
                                    <pems-icon name="bi-list-columns-reverse" /> @row.Metadata.Count
                                </pems-button>
                            }
                        </td>
                    </tr>
                    @if (row.Metadata.Any())
                    {
                        <tr id="@metaRowId" class="d-none">
                            <td></td>
                            <td colspan="12">
                                <div class="p-2 bg-light-subtle border rounded">
                                    <pems-table scale="small" css="table-borderless mb-0">
                                        <thead>
                                            <tr class="text-muted small"><th>Original Excel Header</th><th>Canonical Field</th><th>@Localizer["Value"]</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in row.Metadata)
                                            {
                                                <tr class="small">
                                                    <td>@m.OriginalHeader</td>
                                                    <td>@(m.CanonicalField ?? "-")</td>
                                                    <td>@(m.Value ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </pems-table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </pems-table>
        @if (!rows.Any()) { <p class="text-muted text-center py-4">@Localizer["No rows in this batch."]</p> }
    </div>

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty(matchStatusFilter)) qsParts.Add($"matchStatusFilter={Uri.EscapeDataString(matchStatusFilter)}");
        qsParts.Add($"batchId={Model.Batch.MrsImportBatchId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Rows.Page,
        TotalPages = Model.Rows.TotalPages,
        TotalCount = Model.Rows.TotalCount,
        PageSize = Model.Rows.PageSize,
        GridKey = "MrsImport",
        BaseUrl = Url.Action("Review") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</pems-content-card>

@section Scripts {
<script src="~/js/views/warehouse-mrsimport-review.js" asp-append-version="true"></script>
}
