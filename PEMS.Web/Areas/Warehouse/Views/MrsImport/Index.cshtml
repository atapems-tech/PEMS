@model List<PEMS.Application.DTOs.MrsImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-2"><pems-icon name="bi-file-earmark-excel" /> Upload MRS Excel File</pems-heading>
    <pems-text class="text-muted small">
        فایل خام MRS آپلود می‌شود، بدون هیچ نوشتنی در MaterialItem/InventoryTransaction - فقط بعد از
        بازبینی و تایید در صفحه‌ی Review، ردیف‌ها به کاتالوگ متریال و دفتر تراکنش تبدیل می‌شوند.
    </pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2">
        <pems-col md="6"><pems-input scale="small" type="file" name="file" accept=".xlsx,.xlsm" required /></pems-col>
        <pems-col md="4"><pems-input scale="small" type="text" name="sheetName" placeholder="@Localizer["نام شیت (اختیاری - پیش‌فرض: بزرگ‌ترین شیت)"]" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-upload" /> @Localizer["Stage"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    @{
        var rows_6 = Model;
        var cell_6_0 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.SourceFileName</text>);
        var cell_6_1 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.SourceSheet</text>);
        var cell_6_2 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }<pems-badge tone="@badgeClass">@b.Status</pems-badge></text>);
        var cell_6_3 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.TotalRows</text>);
        var cell_6_4 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.NewCount</text>);
        var cell_6_5 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.MatchedCount</text>);
        var cell_6_6 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.DuplicateCount</text>);
        var cell_6_7 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.InvalidCount</text>);
        var cell_6_8 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@b.ApprovedCount</text>);
        var cell_6_9 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }@PemsDates.DateTime(b.ImportDate)</text>);
        var cell_6_10 = DataCell.Template(rows_6, @<text>@{ var b = item; var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" }; }<pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Review" asp-route-batchId="@b.MrsImportBatchId"><pems-icon name="bi-card-text" /> @Localizer["Review"]</pems-button></text>);
    }
    <pems-data-table data="@(DataRows.Of(rows_6, c_ => c_.Add(((Localizer["File"])?.ToString() ?? ""), b => (object?)cell_6_0(b), css: "small").Add(((Localizer["Sheet"])?.ToString() ?? ""), b => (object?)cell_6_1(b), css: "small").Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)cell_6_2(b)).Add(((Localizer["Total"])?.ToString() ?? ""), b => (object?)cell_6_3(b)).Add(((Localizer["New"])?.ToString() ?? ""), b => (object?)cell_6_4(b)).Add(((Localizer["Matched"])?.ToString() ?? ""), b => (object?)cell_6_5(b)).Add(((Localizer["Duplicate"])?.ToString() ?? ""), b => (object?)cell_6_6(b)).Add(((Localizer["Invalid"])?.ToString() ?? ""), b => (object?)cell_6_7(b), css: "text-danger").Add(((Localizer["Approved"])?.ToString() ?? ""), b => (object?)cell_6_8(b), css: "text-success").Add(((Localizer["Date"])?.ToString() ?? ""), b => (object?)cell_6_9(b), css: "small").Add("", b => (object?)cell_6_10(b), css: "text-end")))" />
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">@Localizer["هنوز فایلی Upload نشده."]</pems-text> }
</pems-content-card>
