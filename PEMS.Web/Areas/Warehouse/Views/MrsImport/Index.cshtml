@model List<PEMS.Application.DTOs.MrsImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <h6 class="mb-2"><pems-icon name="bi-file-earmark-excel" /> Upload MRS Excel File</h6>
    <p class="text-muted small">
        فایل خام MRS آپلود می‌شود، بدون هیچ نوشتنی در MaterialItem/InventoryTransaction - فقط بعد از
        بازبینی و تایید در صفحه‌ی Review، ردیف‌ها به کاتالوگ متریال و دفتر تراکنش تبدیل می‌شوند.
    </p>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2">
        <pems-col md="6"><pems-input scale="small" type="file" name="file" accept=".xlsx,.xlsm" required /></pems-col>
        <pems-col md="4"><pems-input scale="small" type="text" name="sheetName" placeholder="@Localizer["نام شیت (اختیاری - پیش‌فرض: بزرگ‌ترین شیت)"]" /></pems-col>
        <pems-col md="2"><pems-button tone="primary" size="small" css="w-100" type="submit"><pems-icon name="bi-upload" /> @Localizer["Stage"]</pems-button></pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-table kind="enterprise">
        <pems-table-head><pems-table-row><pems-table-header>@Localizer["File"]</pems-table-header><pems-table-header>@Localizer["Sheet"]</pems-table-header><pems-table-header>@Localizer["Status"]</pems-table-header><pems-table-header>@Localizer["Total"]</pems-table-header><pems-table-header>@Localizer["New"]</pems-table-header><pems-table-header>@Localizer["Matched"]</pems-table-header><pems-table-header>@Localizer["Duplicate"]</pems-table-header><pems-table-header>@Localizer["Invalid"]</pems-table-header><pems-table-header>@Localizer["Approved"]</pems-table-header><pems-table-header>@Localizer["Date"]</pems-table-header><pems-table-header></pems-table-header></pems-table-row></pems-table-head>
        <pems-table-body>
            @foreach (var b in Model)
            {
                var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" };
                <pems-table-row>
                    <pems-table-cell class="small">@b.SourceFileName</pems-table-cell>
                    <pems-table-cell class="small">@b.SourceSheet</pems-table-cell>
                    <pems-table-cell><pems-badge tone="@badgeClass">@b.Status</pems-badge></pems-table-cell>
                    <pems-table-cell>@b.TotalRows</pems-table-cell>
                    <pems-table-cell>@b.NewCount</pems-table-cell>
                    <pems-table-cell>@b.MatchedCount</pems-table-cell>
                    <pems-table-cell>@b.DuplicateCount</pems-table-cell>
                    <pems-table-cell class="text-danger">@b.InvalidCount</pems-table-cell>
                    <pems-table-cell class="text-success">@b.ApprovedCount</pems-table-cell>
                    <pems-table-cell class="small">@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</pems-table-cell>
                    <pems-table-cell class="text-end"><pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Review" asp-route-batchId="@b.MrsImportBatchId"><pems-icon name="bi-card-text" /> @Localizer["Review"]</pems-button></pems-table-cell>
                </pems-table-row>
            }
        </pems-table-body>
    </pems-table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز فایلی Upload نشده."]</p> }
</pems-content-card>
