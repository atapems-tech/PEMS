@model List<PEMS.Application.DTOs.MrsImportBatchSummaryDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<div class="content-card mb-3">
    <h6 class="mb-2"><i class="bi bi-file-earmark-excel"></i> Upload MRS Excel File</h6>
    <p class="text-muted small">
        فایل خام MRS آپلود می‌شود، بدون هیچ نوشتنی در MaterialItem/InventoryTransaction - فقط بعد از
        بازبینی و تایید در صفحه‌ی Review، ردیف‌ها به کاتالوگ متریال و دفتر تراکنش تبدیل می‌شوند.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2">
        <div class="col-md-6"><pems-input scale="small" type="file" name="file" accept=".xlsx,.xlsm" required /></div>
        <div class="col-md-4"><pems-input scale="small" type="text" name="sheetName" placeholder="@Localizer["نام شیت (اختیاری - پیش‌فرض: بزرگ‌ترین شیت)"]" /></div>
        <div class="col-md-2"><pems-button tone="primary" size="small" css="w-100" type="submit"><i class="bi bi-upload"></i> @Localizer["Stage"]</pems-button></div>
    </form>
</div>

<div class="content-card">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["File"]</th><th>@Localizer["Sheet"]</th><th>@Localizer["Status"]</th><th>@Localizer["Total"]</th><th>@Localizer["New"]</th><th>@Localizer["Matched"]</th><th>@Localizer["Duplicate"]</th><th>@Localizer["Invalid"]</th><th>@Localizer["Approved"]</th><th>@Localizer["Date"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                var badgeClass = b.Status switch { "Committed" => "success", "InReview" => "info", "Cancelled" => "neutral", _ => "warning" };
                <tr>
                    <td class="small">@b.SourceFileName</td>
                    <td class="small">@b.SourceSheet</td>
                    <td><pems-badge tone="@badgeClass">@b.Status</pems-badge></td>
                    <td>@b.TotalRows</td>
                    <td>@b.NewCount</td>
                    <td>@b.MatchedCount</td>
                    <td>@b.DuplicateCount</td>
                    <td class="text-danger">@b.InvalidCount</td>
                    <td class="text-success">@b.ApprovedCount</td>
                    <td class="small">@b.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end"><pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Review" asp-route-batchId="@b.MrsImportBatchId"><i class="bi bi-card-text"></i> @Localizer["Review"]</pems-button></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted text-center py-4">@Localizer["هنوز فایلی Upload نشده."]</p> }
</div>
