@model PEMS.Application.Replenishment.ReplenishmentDetails
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var s = Model.Summary;
    var canReview = (bool)ViewBag.CanReview;
    var version = Model.RowVersion == null ? "" : Convert.ToBase64String(Model.RowVersion);
    var badge = s.Status switch { "Open" => "bg-warning text-dark", "Dismissed" => "bg-secondary", _ => "bg-light text-dark border" };
}

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}
@if (TempData["Error"] != null)
{
    <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert>
}

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <h5 class="mb-1">@s.MaterialCode <span class="text-muted fw-normal">@s.MaterialDescription</span></h5>
            <div class="small text-muted">
                @Localizer["Warehouse"]: <strong>@s.WarehouseCode</strong> · @Localizer["Repl_Revision"] @s.Revision ·
                @Localizer["Repl_FirstDetected"] @Model.FirstDetectedAt.ToString("yyyy-MM-dd HH:mm") · @Localizer["Repl_Evaluated"] @s.LastEvaluatedAt.ToString("yyyy-MM-dd HH:mm")
            </div>
        </div>
        <div>
            <pems-badge tone="none" css="@badge fs-6">@s.Status</pems-badge>
            @if (!s.IsCurrentlyDefinitive) { <pems-badge tone="danger" css="fs-6">@Localizer["Repl_NotDefinitive"]</pems-badge> }
        </div>
    </pems-flex>

    <pems-alert tone="info" css="py-2 px-3 small mt-3 mb-2"><pems-icon name="bi-info-circle" /> @Localizer["Repl_StockOnlyNote"]</pems-alert>

    @if (!s.IsCurrentlyDefinitive)
    {
        <pems-alert tone="danger" css="py-2 px-3 small mb-2">
            @Localizer["Repl_NotDefinitiveHint"]: <code>@Model.BlockingIssueCodes</code>
        </pems-alert>
    }
    @if (Model.RequiresWarehouseAttribution)
    {
        <pems-alert tone="warning" css="py-2 px-3 small mb-2"><strong>@Localizer["Repl_RequiresAttribution"]</strong> — @Localizer["Repl_RequiresAttributionHelp"]</pems-alert>
    }

    <pems-row gap="3" css="mt-1">
        <pems-col span="6" md="3"><pems-kpi-tile compact label="@Localizer["Repl_Usable"]" sub="@Localizer["Repl_OnHand"] @Model.OnHandQuantity.ToString("0.###") − @Localizer["Repl_Reserved"] @Model.ReservedQuantity.ToString("0.###")">@s.UsableQuantity.ToString("0.###")</pems-kpi-tile></pems-col>
        <pems-col span="6" md="3"><pems-kpi-tile compact label="@Localizer["Repl_GrossDemand"]">@Model.GrossEligibleDemand.ToString("0.###")</pems-kpi-tile></pems-col>
        <pems-col span="6" md="3"><pems-kpi-tile compact label="@Localizer["Repl_Covered"]">@Model.CoveredByReservations.ToString("0.###")</pems-kpi-tile></pems-col>
        <pems-col span="6" md="3"><pems-kpi-tile compact label="@Localizer["Repl_Shortage"]">@s.ShortageQuantity.ToString("0.###")</pems-kpi-tile></pems-col>
    </pems-row>
    <div class="small mt-2">
        <strong>@Localizer["Repl_Freshness"]</strong>:
        @Localizer["Repl_CalculatedAt"] @(Model.LastRunStartedAt?.ToString("yyyy-MM-dd HH:mm") ?? @Localizer["Repl_Unknown"]) → @(Model.LastRunCompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? @Localizer["Repl_Unknown"]) ·
        @Localizer["Repl_StockUpdated"] @(Model.StockLastUpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? @Localizer["Repl_Unknown"]) ·
        @Localizer["Repl_DemandChanged"] @(Model.DemandLastChangedAt?.ToString("yyyy-MM-dd HH:mm") ?? @Localizer["Repl_Unknown"])
        <div class="text-muted">@Localizer["Repl_FreshnessDisclaimer"]</div>
    </div>
    @if (!string.IsNullOrEmpty(Model.NoticeCodes))
    {
        <div class="small text-muted mt-2">@Localizer["Repl_Notices"]: <code>@Model.NoticeCodes</code></div>
    }
    @if (s.Status == "Dismissed")
    {
        <div class="small mt-2">@Localizer["Repl_DismissedAt"] @Model.DismissedAt?.ToString("yyyy-MM-dd HH:mm") — <em>@Model.DismissedReason</em>
            (@Localizer["Repl_ShortageAtDismissal"]: @Model.DismissedShortageQuantity?.ToString("0.###"))</div>
    }
    @if (s.Status == "Closed")
    {
        <div class="small mt-2">@Localizer["Repl_ClosedReason"]: <code>@Model.ClosedReason</code></div>
    }

    @* SCRUM-471: hand the shortage to the pre-procurement queue (the recommendation becomes Converted) *@
    @if (canReview && s.Status == "Open" && s.IsCurrentlyDefinitive)
    {
        <form action="/PreProcurement/SendRecommendation" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="recommendationId" value="@s.Id" />
            <pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-cart-plus" aria-hidden="true" /> @Localizer["Ppr_Send"]</pems-button>
            <span class="small text-muted ms-2">@Localizer["Ppr_SendHint"]</span>
        </form>
    }
    @if (s.Status == "Converted")
    {
        <div class="small mt-3"><pems-icon name="bi-cart-check" aria-hidden="true" /> @Localizer["Ppr_SentNote"] <a href="/PreProcurement?status=">@Localizer["Ppr_Title"]</a></div>
    }
    @if (canReview && s.Status == "Open")
    {
        <form class="mt-3" asp-action="Dismiss" method="post"><pems-flex gap="2" wrap="true" align="end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
            <input type="hidden" name="rowVersion" value="@version" />
            <div class="flex-grow-1 pems-s-04391f08">
                <pems-label css="small mb-1">@Localizer["Repl_Reason"]</pems-label>
                <pems-input scale="small" type="text" name="reason" maxlength="500" required />
            </div>
            <pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-x-circle" /> @Localizer["Repl_Dismiss"]</pems-button>
        </pems-flex></form>
    }
    @if (canReview && s.Status == "Dismissed")
    {
        <form class="mt-3" asp-action="Reopen" method="post"><pems-flex gap="2" wrap="true" align="end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
            <input type="hidden" name="rowVersion" value="@version" />
            <div class="flex-grow-1 pems-s-04391f08">
                <pems-label css="small mb-1">@Localizer["Repl_Note"]</pems-label>
                <pems-input scale="small" type="text" name="note" maxlength="500" />
            </div>
            <pems-button tone="primary" size="small" type="submit"><pems-icon name="bi-arrow-counterclockwise" /> @Localizer["Repl_Reopen"]</pems-button>
        </pems-flex></form>
    }
</pems-content-card>

<pems-content-card css="mb-3">
    <h6>@Localizer["Repl_Sources"]</h6>
    <div class="pems-grid-scroll">
        <pems-table kind="enterprise" css="mb-0">
            <thead><tr><th>@Localizer["Repl_SourceType"]</th><th>@Localizer["Repl_SourceNumber"]</th><th class="text-end">@Localizer["Repl_GrossDemand"]</th><th class="text-end">@Localizer["Repl_Covered"]</th><th class="text-end">@Localizer["Repl_UnreservedDemand"]</th></tr></thead>
            <tbody>
            @foreach (var src in Model.Sources)
            {
                <tr>
                    <td class="small">@(src.SourceType == 1 ? Localizer["Repl_SourceSr"] : Localizer["Repl_SourceWo"])</td>
                    <td class="small">@if (src.IsRestricted) { <span class="text-muted">@Localizer["Repl_Restricted"]</span> } else { <span>@(src.ParentNumber ?? ("#" + src.SourceLineId))</span> }</td>
                    <td class="small text-end">@src.GrossRemainingQuantity.ToString("0.###")</td>
                    <td class="small text-end">@src.CoveredByReservation.ToString("0.###")</td>
                    <td class="small text-end">@src.UnreservedQuantity.ToString("0.###")</td>
                </tr>
            }
            </tbody>
        </pems-table>
    </div>
    @if (!Model.Sources.Any()) { <p class="text-muted text-center py-3 mb-0 small">@Localizer["Repl_NoSources"]</p> }
</pems-content-card>

<pems-content-card>
    <h6>@Localizer["Repl_History"]</h6>
    <div class="pems-grid-scroll">
        <pems-data-table data="@(DataRows.Of(Model.History, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), h => (object?)(h.OccurredAt.ToString("yyyy-MM-dd HH:mm")), css: "small").Add(((Localizer["Repl_Revision"])?.ToString() ?? ""), h => (object?)(h.Revision), css: "small").Add(((Localizer["Repl_Action"])?.ToString() ?? ""), h => (object?)(h.Action), css: "small").Add(((Localizer["Status"])?.ToString() ?? ""), h => DataCell.Join((h.FromStatus == null ? "" : h.FromStatus + " → "), (h.ToStatus)), css: "small").Add(((Localizer["Repl_Shortage"])?.ToString() ?? ""), h => (object?)(h.ShortageQuantity.ToString("0.###")), css: "small text-end", headerCss: "text-end").Add(((Localizer["Repl_By"])?.ToString() ?? ""), h => (object?)(h.ActorName ?? Localizer["Repl_System"]), css: "small").Add(((Localizer["Repl_Note"])?.ToString() ?? ""), h => (object?)(h.Note), css: "small")))" css="mb-0" />
    </div>
</pems-content-card>

<p class="mt-3"><pems-button as="a" tone="neutral" size="small" outline="true" asp-action="Index"><pems-icon name="bi-arrow-left" /> @Localizer["Repl_Back"]</pems-button></p>
