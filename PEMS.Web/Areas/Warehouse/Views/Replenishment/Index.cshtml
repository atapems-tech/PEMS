@model PEMS.Application.DTOs.PagedResult<PEMS.Application.Replenishment.ReplenishmentListItem>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var statuses = new[] { "Open", "Dismissed", "Closed" };
    var last = ViewBag.LastRun as PEMS.Application.Replenishment.ReplenishmentRunSummary;
    var canRun = (bool)ViewBag.CanRun;
    var attribution = (IReadOnlyList<string>)ViewBag.AttributionEntries;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2 px-3 small">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small">@TempData["Error"]</div>
}

<div class="alert alert-info py-2 px-3 small">
    <i class="bi bi-info-circle"></i> @Localizer["Repl_StockOnlyNote"]
</div>

@if (attribution.Count > 0)
{
    <div class="alert alert-warning py-2 px-3 small">
        <i class="bi bi-exclamation-triangle"></i> <strong>@Localizer["Repl_RequiresAttribution"]</strong> — @Localizer["Repl_RequiresAttributionHelp"]
        <ul class="mb-0 mt-1">@foreach (var a in attribution) { <li>@a</li> }</ul>
    </div>
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <form method="get" class="d-flex gap-2 flex-wrap align-items-center">
            <select name="status" class="form-select form-select-sm" style="max-width:160px;" onchange="this.form.submit()">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in statuses) { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option> }
            </select>
            <input type="text" name="q" value="@ViewBag.Search" class="form-control form-control-sm" style="max-width:220px;" placeholder="@Localizer["Repl_SearchPlaceholder"]" />
            <div class="form-check form-check-inline small mb-0">
                <input class="form-check-input" type="checkbox" name="definitiveOnly" value="true" id="defOnly" checked="@((bool)ViewBag.DefinitiveOnly)" onchange="this.form.submit()" />
                <label class="form-check-label" for="defOnly">@Localizer["Repl_DefinitiveOnly"]</label>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
        </form>
        @if (canRun)
        {
            <form asp-action="Run" method="post" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestKey" value="@ViewBag.RequestKey" />
                <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-calculator"></i> @Localizer["Repl_Run"]</button>
            </form>
        }
    </div>
    @if (last != null)
    {
        <div class="small text-muted mt-2">
            @Localizer["Repl_LastRun"]: #@last.RunId · @Localizer["Repl_CalculatedAt"] @last.StartedAt.ToString("yyyy-MM-dd HH:mm") → @(last.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-") · @last.Status ·
            @last.ResultsEvaluated @Localizer["Repl_Evaluated"], @last.Created @Localizer["Repl_New"], @last.Updated @Localizer["Repl_Updated"],
            @last.Closed @Localizer["Repl_ClosedCount"], @last.NotDefinitive @Localizer["Repl_NotDefinitiveCount"]
            <div>@Localizer["Repl_FreshnessDisclaimer"]</div>
            @if (last.NotDefinitiveSummary.Count > 0)
            {
                <details class="mt-1"><summary>@Localizer["Repl_NotRecommended"]</summary>
                    <ul class="mb-0">@foreach (var s in last.NotDefinitiveSummary) { <li>@s</li> }</ul>
                </details>
            }
        </div>
    }
</div>

<div class="content-card">
    <div class="pems-grid-scroll">
    <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="Replenishment">
        <thead>
            <tr>
                <th data-col-key="material" data-resizable="true" data-min-width="140" data-max-width="360">@Localizer["Repl_Material"]</th>
                <th data-col-key="warehouse" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Warehouse"]</th>
                <th data-col-key="usable" class="text-end">@Localizer["Repl_Usable"]</th>
                <th data-col-key="demand" class="text-end">@Localizer["Repl_UnreservedDemand"]</th>
                <th data-col-key="shortage" class="text-end">@Localizer["Repl_Shortage"]</th>
                <th data-col-key="status">@Localizer["Status"]</th>
                <th data-col-key="evaluated">@Localizer["Repl_Evaluated"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                var badge = r.Status switch { "Open" => "bg-warning text-dark", "Dismissed" => "bg-secondary", _ => "bg-light text-dark border" };
                <tr>
                    <td class="small"><a asp-action="Details" asp-route-id="@r.Id"><strong>@r.MaterialCode</strong></a> <span class="text-muted">@r.MaterialDescription</span></td>
                    <td class="small">@r.WarehouseCode</td>
                    <td class="small text-end">@r.UsableQuantity.ToString("0.###")</td>
                    <td class="small text-end">@r.UnreservedDemand.ToString("0.###")</td>
                    <td class="small text-end fw-bold">@r.ShortageQuantity.ToString("0.###")</td>
                    <td>
                        <span class="badge @badge">@r.Status</span>
                        @if (!r.IsCurrentlyDefinitive) { <span class="badge bg-danger" title="@Localizer["Repl_NotDefinitiveHint"]">@Localizer["Repl_NotDefinitive"]</span> }
                    </td>
                    <td class="small">@r.LastEvaluatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-card-text"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["Repl_NoItems"]</p> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) qsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.Search)) qsParts.Add($"q={Uri.EscapeDataString((string)ViewBag.Search)}");
        if ((bool)ViewBag.DefinitiveOnly) qsParts.Add("definitiveOnly=true");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "Replenishment",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</div>
