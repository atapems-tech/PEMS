@model PEMS.Application.Interfaces.WarehouseIntakeDto
@using Microsoft.Extensions.Localization
@using PEMS.Domain.Entities
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // SCRUM-472: warehouse intake of one work order's stock lines
    var canSource = ViewBag.CanSource is true;
    var warehouses = (IEnumerable<dynamic>)ViewBag.Warehouses;
    var stockLines = Model.Lines.Where(l => l.SupplyCode == WorkOrderMaterialSupplyCodes.Stock).ToList();
    var open = stockLines.Where(l => l.UnsourcedQuantity > 0).ToList();
}

@if (TempData["Message"] != null) { <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert> }
@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <div>
            <pems-heading level="5" class="mb-1"><pems-icon name="bi-inboxes" aria-hidden="true" /> @Localizer["Whi_Title"]</pems-heading>
            <div class="small text-muted">
                @Localizer["Work Order"]: <pems-link href="/WorkOrder/Details/@Model.WorkOrderId" dir="ltr">@Model.WorkOrderNumber</pems-link> · @Model.WorkOrderStatus
                @if (Model.RequestedDate.HasValue) { <span> · @Localizer["Whi_RequestedOn"] <span dir="ltr">@Model.RequestedDate.Value.ToString("yyyy-MM-dd HH:mm")</span></span> }
            </div>
        </div>
        <div>
            @if (Model.IsOpen) { <span class="vs-pill vs-pill--warning">@Localizer["Whi_State_Open"]</span> }
            else if (open.Count == 0) { <span class="vs-pill vs-pill--success">@Localizer["Whi_State_Sourced"]</span> }
            else { <span class="vs-pill vs-pill--neutral">@Localizer["Whi_State_NotRequested"]</span> }
        </div>
    </pems-flex>
    <pems-text class="small text-muted mt-2 mb-0"><pems-icon name="bi-info-circle" aria-hidden="true" /> @Localizer["Whi_Hint"]</pems-text>
</pems-content-card>

<pems-form asp-action="Source" method="post"><pems-content-card>
    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
    <pems-table-scroll>
        @{
            var rows_16 = Model.Lines;
            var cell_16_1 = DataCell.Template(rows_16, @<text>@{ var l = item; }<span class="vs-pill @(l.SupplyCode == WorkOrderMaterialSupplyCodes.DirectPurchase ? "vs-pill--warning" : "vs-pill--neutral")">@Localizer["Whi_Supply_" + l.SupplyCode]</span></text>);
            var cell_16_4 = DataCell.Template(rows_16, @<text>@{ var l = item; }
                        @foreach (var r in l.Requisitions)
                        {
                            <div><pems-link href="/Warehouse/StoreRequisition/Details/@r.StoreRequisitionId" dir="ltr">@r.RequisitionNumber</pems-link> · @r.WarehouseCode · @r.Status · <span dir="ltr">@r.Quantity.ToString("0.###")</span></div>
                        }
                        @if (l.SupplyCode == WorkOrderMaterialSupplyCodes.DirectPurchase) { <span class="text-muted">@Localizer["Whi_DirectPurchaseNote"]</span> }
                    </text>);
            var cell_16_5 = DataCell.Template(rows_16, @<text>@{ var l = item; }
                        @if (canSource && l.UnsourcedQuantity > 0)
                        {
                            <pems-input scale="small" css="text-end" type="number" name="quantities[@l.WorkOrderMaterialId]" dir="ltr" min="0" max="@l.UnsourcedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="any" value="@l.UnsourcedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@Localizer["Whi_SourceNow"] @l.MaterialCode" />
                        }
                        else { <span class="text-muted">—</span> }
                    </text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_16, c_ => c_.Add(((Localizer["Material"])?.ToString() ?? ""), l => (object?)(DataCell.Group(DataCell.Span(null, l.MaterialCode).WithDir("ltr"), " - ", l.MaterialDescription)), css: "small").Add(((Localizer["Whi_SupplyCode"])?.ToString() ?? ""), l => (object?)cell_16_1(l)).Add(((Localizer["Required Qty"])?.ToString() ?? ""), l => (object?)(DataCell.Group((l.RequiredQuantity.ToString("0.###")), " ", l.UnitName)), css: "text-end", headerCss: "text-end", dir: "ltr").Add(((Localizer["Whi_Sourced"])?.ToString() ?? ""), l => (object?)((l.SupplyCode == WorkOrderMaterialSupplyCodes.Stock ? l.SourcedQuantity.ToString("0.###") : "—")), css: "text-end", headerCss: "text-end", dir: "ltr").Add(((Localizer["Whi_Requisitions"])?.ToString() ?? ""), l => (object?)cell_16_4(l), css: "small").Add(((Localizer["Whi_SourceNow"])?.ToString() ?? ""), l => (object?)cell_16_5(l), css: "text-end", headerCss: "text-end")))" dense="true" css="align-middle" />
    </pems-table-scroll>

    @if (!canSource)
    {
        <pems-text class="small text-muted mb-0"><pems-icon name="bi-lock" aria-hidden="true" /> @Localizer["Whi_NoPermission"]</pems-text>
    }
    else if (open.Count == 0)
    {
        <pems-text class="small text-muted mb-0">@Localizer["Whi_NothingLeft"]</pems-text>
    }
    else
    {
        <pems-row gap="2" css="align-items-end">
            <pems-col md="5">
                <pems-label css="small" for="whiWarehouse">@Localizer["Whi_Warehouse"]</pems-label>
                <pems-select scale="small" id="whiWarehouse" name="warehouseId" required>
                    <option value="">@Localizer["Whi_PickWarehouse"]</option>
                    @foreach (var w in warehouses) { <option value="@w.WarehouseId">@w.Code - @w.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="auto">
                <pems-button tone="none" size="small" css="btn-primary" type="submit"><pems-icon name="bi-box-arrow-in-down" aria-hidden="true" /> @Localizer["Whi_Source"]</pems-button>
            </pems-col>
            <pems-col span="12" css="small text-muted">@Localizer["Whi_SourceHint"]</pems-col>
        </pems-row>
    }
</pems-content-card></pems-form>
