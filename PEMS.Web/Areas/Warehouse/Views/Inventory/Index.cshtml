@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var lowStockItems = (List<PEMS.Application.DTOs.MaterialStockRowDto>)ViewBag.LowStockItems;
    var recentTransactions = (List<PEMS.Domain.Entities.InventoryTransaction>)ViewBag.RecentTransactions;
}

<pems-row gap="3" css="mb-3">
    <pems-col md="2"><pems-kpi-tile label="@Localizer["Total Materials"]">@ViewBag.TotalMaterialItems</pems-kpi-tile></pems-col>
    <pems-col md="2"><pems-kpi-tile label="Stock Items">@ViewBag.StockItems</pems-kpi-tile></pems-col>
    <pems-col md="2"><pems-kpi-tile tone="warning" label="@Localizer["Critical"]">@ViewBag.CriticalItems</pems-kpi-tile></pems-col>
    <pems-col md="2"><pems-kpi-tile tone="danger" label="Out of Stock">@ViewBag.OutOfStockCount</pems-kpi-tile></pems-col>
    <pems-col md="2"><pems-kpi-tile label="@Localizer["Warehouses"]">@ViewBag.TotalWarehouses</pems-kpi-tile></pems-col>
    <pems-col md="2"><pems-kpi-tile label="Active Reservations">@ViewBag.ActiveReservations</pems-kpi-tile></pems-col>
</pems-row>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-content-card>
            <pems-button as="a" tone="primary" size="small" outline="true" css="w-100 mb-2" asp-controller="MaterialItem" asp-action="Index"><pems-icon name="bi-box-seam" /> @Localizer["Material Master"]</pems-button>
            <pems-button as="a" tone="neutral" size="small" outline="true" css="w-100 mb-2" asp-controller="InventoryMasterData" asp-action="Index"><pems-icon name="bi-diagram-3" /> @Localizer["Master Data"]</pems-button>
            <pems-button as="a" tone="neutral" size="small" outline="true" css="w-100 mb-2" asp-controller="InventoryTransaction" asp-action="Index"><pems-icon name="bi-list-ul" /> @Localizer["Transaction Ledger"]</pems-button>
            <pems-button as="a" tone="neutral" size="small" outline="true" css="w-100 mb-2" asp-controller="StoreRequisition" asp-action="Index"><pems-icon name="bi-clipboard-check" /> @Localizer["Store Requisitions"]</pems-button>
        </pems-content-card>
    </pems-col>
    <pems-col md="8">
        <pems-content-card>
            <h6 class="mb-3"><pems-icon name="bi-exclamation-triangle" css="text-danger" /> Low Stock</h6>
            <pems-table kind="enterprise" scale="small">
                <thead><tr><th>@Localizer["Warehouse"]</th><th>@Localizer["On Hand"]</th><th>@Localizer["Available"]</th><th>@Localizer["Reorder Point"]</th></tr></thead>
                <tbody>
                    @foreach (var s in lowStockItems)
                    {
                        <tr>
                            <td>@s.WarehouseCode</td>
                            <td>@s.OnHandQuantity</td>
                            <td class="text-danger">@s.AvailableQuantity</td>
                            <td>@s.ReorderPoint</td>
                        </tr>
                    }
                </tbody>
            </pems-table>
            @if (!lowStockItems.Any()) { <p class="text-muted text-center py-3">@Localizer["فعلاً موجودی کمی ثبت نشده."]</p> }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card>
    <h6 class="mb-3">Recent Transactions</h6>
    <pems-table kind="enterprise" scale="small">
        <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Material"]</th><th>@Localizer["Type"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Reference"]</th></tr></thead>
        <tbody>
            @foreach (var t in recentTransactions)
            {
                <tr>
                    <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@t.MaterialItem?.MaterialCode</td>
                    <td><pems-badge tone="light">@t.TransactionType</pems-badge></td>
                    <td>@t.Warehouse?.Code</td>
                    <td>@t.Quantity</td>
                    <td class="small">@t.ReferenceType</td>
                </tr>
            }
        </tbody>
    </pems-table>
    @if (!recentTransactions.Any()) { <p class="text-muted text-center py-3">@Localizer["هنوز تراکنشی ثبت نشده."]</p> }
</pems-content-card>
