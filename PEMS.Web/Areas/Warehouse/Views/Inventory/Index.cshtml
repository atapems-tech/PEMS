@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var lowStockItems = (List<PEMS.Application.DTOs.MaterialStockRowDto>)ViewBag.LowStockItems;
    var recentTransactions = (List<PEMS.Domain.Entities.InventoryTransaction>)ViewBag.RecentTransactions;
}

<div class="row g-3 mb-3">
    <div class="col-md-2"><pems-kpi-tile label="@Localizer["Total Materials"]">@ViewBag.TotalMaterialItems</pems-kpi-tile></div>
    <div class="col-md-2"><pems-kpi-tile label="Stock Items">@ViewBag.StockItems</pems-kpi-tile></div>
    <div class="col-md-2"><pems-kpi-tile tone="warning" label="@Localizer["Critical"]">@ViewBag.CriticalItems</pems-kpi-tile></div>
    <div class="col-md-2"><pems-kpi-tile tone="danger" label="Out of Stock">@ViewBag.OutOfStockCount</pems-kpi-tile></div>
    <div class="col-md-2"><pems-kpi-tile label="@Localizer["Warehouses"]">@ViewBag.TotalWarehouses</pems-kpi-tile></div>
    <div class="col-md-2"><pems-kpi-tile label="Active Reservations">@ViewBag.ActiveReservations</pems-kpi-tile></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="content-card">
            <a asp-controller="MaterialItem" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mb-2"><i class="bi bi-box-seam"></i> @Localizer["Material Master"]</a>
            <a asp-controller="InventoryMasterData" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-diagram-3"></i> @Localizer["Master Data"]</a>
            <a asp-controller="InventoryTransaction" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-list-ul"></i> @Localizer["Transaction Ledger"]</a>
            <a asp-controller="StoreRequisition" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 mb-2"><i class="bi bi-clipboard-check"></i> @Localizer["Store Requisitions"]</a>
        </div>
    </div>
    <div class="col-md-8">
        <div class="content-card">
            <h6 class="mb-3"><i class="bi bi-exclamation-triangle text-danger"></i> Low Stock</h6>
            <table class="table table-enterprise table-sm">
                <thead><tr><th>@Localizer["Warehouse"]</th><th>@Localizer["On Hand"]</th><th>@Localizer["Available"]</th><th>@Localizer["Reorder Point"]</th></tr></thead>
                <tbody>
                    @foreach (var s in lowStockItems)
                    {
                        <tr>
                            <td>@s.WarehouseCode</td>
                            <td>@s.OnHandQuantity</td>
                            <td class="text-danger">@s.AvailableQuantity</td>
                            <td>@s.ReorderPoint</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!lowStockItems.Any()) { <p class="text-muted text-center py-3">@Localizer["فعلاً موجودی کمی ثبت نشده."]</p> }
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-3">Recent Transactions</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Material"]</th><th>@Localizer["Type"]</th><th>@Localizer["Warehouse"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Reference"]</th></tr></thead>
        <tbody>
            @foreach (var t in recentTransactions)
            {
                <tr>
                    <td class="small">@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@t.MaterialItem?.MaterialCode</td>
                    <td><span class="badge bg-light text-dark border">@t.TransactionType</span></td>
                    <td>@t.Warehouse?.Code</td>
                    <td>@t.Quantity</td>
                    <td class="small">@t.ReferenceType</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!recentTransactions.Any()) { <p class="text-muted text-center py-3">@Localizer["هنوز تراکنشی ثبت نشده."]</p> }
</div>
