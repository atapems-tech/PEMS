# Settings of the licence vendor tool (plan row #106). Copy to vendor.env on an OWNER computer; never deploy this tool to a server or CI.
# No secret belongs here: signing keys are stored encrypted by the tool and unlocked with a passphrase typed per session.
VendorTool__Mode=true
VendorTool__DataDirectory=./vendor-data
VendorTool__OperatorName=owner
# Transfers per customer before an operator note is required (value to be confirmed by the owner, SCRUM-26 open question).
VendorTool__TransferCap=2
VendorTool__Urls=http://127.0.0.1:5290
