{
  "kind": "action",
  "key": "asset-edit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Edit asset",
    "fa": "ویرایش دارایی"
  },
  "description": {
    "en": "Edit asset",
    "fa": "ویرایش دارایی"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.update",
    "parameters": {
      "entity": "Asset",
      "map": {
        "assetNumber": "AssetNumber",
        "status": "Status",
        "functionalLocationId": "FunctionalLocationId",
        "maintenanceClass": "MaintenanceClass",
        "functionalLocation": "FunctionalLocation",
        "commissioningDate": "CommissioningDate",
        "description": "Description"
      },
      "required": [
        "AssetNumber"
      ],
      "unique": [
        {
          "fields": [
            "AssetNumber"
          ],
          "where": {
            "IsActive": true
          },
          "message": {
            "en": "This asset number is already used.",
            "fa": "این شماره Asset قبلاً استفاده شده است."
          }
        }
      ]
    },
    "success": {
      "en": "Asset updated.",
      "fa": "دارایی به‌روز شد."
    },
    "redirect": "/p/assets"
  }
}