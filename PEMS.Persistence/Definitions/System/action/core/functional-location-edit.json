{
  "kind": "action",
  "key": "functional-location-edit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Edit functional location",
    "fa": "ویرایش محل عملکردی"
  },
  "description": {
    "en": "Edit functional location",
    "fa": "ویرایش محل عملکردی"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.update",
    "parameters": {
      "entity": "FunctionalLocation",
      "map": {
        "code": "Code",
        "name": "Name",
        "parentId": "ParentId",
        "plant": "Plant",
        "area": "Area",
        "unit": "Unit",
        "description": "Description"
      },
      "required": [
        "Code",
        "Name"
      ],
      "unique": [],
      "validate": {
        "model": "FunctionalLocation",
        "action": "Validate",
        "args": {
          "id": "field:id",
          "code": "field:code",
          "parentId": "field:parentId"
        }
      }
    },
    "success": {
      "en": "Functional location updated.",
      "fa": "محل عملکردی به‌روز شد."
    },
    "redirect": "/p/functional-locations"
  }
}