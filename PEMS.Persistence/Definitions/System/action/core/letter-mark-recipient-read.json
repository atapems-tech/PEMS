{
  "kind": "action",
  "key": "letter-mark-recipient-read",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Mark a recipient as read",
    "fa": "علامت خوانده‌شدن گیرنده"
  },
  "description": {
    "en": "Mark a recipient as read",
    "fa": "علامت خوانده‌شدن گیرنده"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
