{
  "kind": "action",
  "key": "mdb-create",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Create an MDB",
    "fa": "ایجاد MDB"
  },
  "description": {
    "en": "Create an MDB",
    "fa": "ایجاد MDB"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Mdb",
      "action": "Create",
