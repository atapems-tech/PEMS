        "projectId": "field:projectId",
        "equipmentId": "field:equipmentId",
        "vendorId": "field:vendorId",
        "poId": "field:poId",
        "plannedFinalIssueDate": "field:plannedFinalIssueDate"
      }
    },
    "success": {
      "en": "MDB created successfully",
      "fa": "MDB با موفقیت ایجاد شد."
    },
    "redirect": "/MDB/Details/{result}"
