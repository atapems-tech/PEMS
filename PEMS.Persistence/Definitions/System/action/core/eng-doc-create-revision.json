{
  "kind": "action",
  "key": "eng-doc-create-revision",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Create a new revision",
    "fa": "ایجاد رویژن جدید"
  },
  "description": {
    "en": "Create a new revision",
    "fa": "ایجاد رویژن جدید"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "EngineeringDocument",
      "action": "CreateRevision",
      "args": {
        "id": "field:id",
        "reason": "field:reason",
        "changeDescription": "field:changeDescription",
        "vendorComment": "field:vendorComment",
        "triggeringCommentId": "field:triggeringCommentId",
        "actorEmployeeId": "context:employeeId"
      }
    },
    "success": {
      "en": "The new revision was created.",
      "fa": "رویژن جدید ایجاد شد."
    },
    "redirect": "/p/eng-doc-details?id={id}"
  }
}