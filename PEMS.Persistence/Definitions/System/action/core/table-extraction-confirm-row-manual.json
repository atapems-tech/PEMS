{
  "kind": "action",
  "key": "table-extraction-confirm-row-manual",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Link a row to an equipment by its tag",
    "fa": "اتصال ردیف به تجهیز با تگ"
  },
  "description": {
    "en": "Link a row to an equipment by its tag",
    "fa": "اتصال ردیف به تجهیز با تگ"
  },
  "payload": {
    "kind": "handler",
