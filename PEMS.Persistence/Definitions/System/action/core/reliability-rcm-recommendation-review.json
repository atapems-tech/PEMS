{
  "kind": "action",
  "key": "reliability-rcm-recommendation-review",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Review RCM recommendation",
    "fa": "بازبینی توصیه RCM"
  },
  "description": {
    "en": "Review RCM recommendation",
    "fa": "بازبینی توصیه RCM"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Reliability",
      "action": "ReviewRcmRecommendation",
      "args": {
        "recommendationId": "field:recommendationId",
        "accept": "field:accept",
        "notes": "field:notes"
      }
    },
    "success": {
      "en": "The recommendation was reviewed.",
      "fa": "توصیه بازبینی شد."
    },
    "redirect": "/Reliability/RcmFeedback"
  }
}