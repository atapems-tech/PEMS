{
  "kind": "action",
  "key": "eng-doc-comment-action",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Set the action status of a comment",
    "fa": "وضعیت اقدام نظر"
  },
  "description": {
    "en": "Set the action status of a comment",
    "fa": "وضعیت اقدام نظر"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "EngineeringDocument",
      "action": "SetCommentAction",
      "args": {
        "commentId": "field:commentId",
        "actionStatus": "field:actionStatus"
      }
    },
    "success": {
      "en": "The comment was updated.",
      "fa": "نظر به‌روز شد."
    },
    "redirect": "/p/eng-doc-details?id={documentId}"
  }
}