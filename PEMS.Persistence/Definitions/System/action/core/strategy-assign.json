{
  "kind": "action",
  "key": "strategy-assign",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Assign the strategy",
    "fa": "تخصیص استراتژی"
  },
  "description": {
    "en": "Assign the strategy",
    "fa": "تخصیص استراتژی"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "StrategyForm",
      "action": "Assign",
      "args": {
        "strategyId": "field:strategyId",
        "equipmentIds": "field:ids",
        "culture": "context:culture"
      }
    },
    "success": {
      "en": "Assigned.",
      "fa": "تخصیص انجام شد."
    },
    "redirect": "/p/strategy-details?id={strategyId}"
  }
}