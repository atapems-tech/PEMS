{
  "kind": "action",
  "key": "letter-archive",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Archive the letter",
    "fa": "بایگانی نامه"
  },
  "description": {
    "en": "Archive the letter",
    "fa": "بایگانی نامه"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Letter",
      "action": "Archive",
      "args": {
        "letterId": "field:letterId"
      }
    },
    "success": {
      "en": "Letter archived.",
      "fa": "نامه بایگانی شد."
    },
    "redirect": "/Letter/Details/{letterId}"
  }
}