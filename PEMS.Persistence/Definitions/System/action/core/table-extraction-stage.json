{
  "kind": "action",
  "key": "table-extraction-stage",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Stage the table for review",
    "fa": "ارسال جدول برای بازبینی"
  },
  "description": {
    "en": "Stage the table for review",
    "fa": "ارسال جدول برای بازبینی"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "TableExtraction",
      "action": "StageForReview",
      "args": {
        "attachmentId": "field:attachmentId",
        "employeeId": "context:employeeId"
      }
    },
    "success": {
      "en": "Done.",
      "fa": "انجام شد."
    },
    "redirect": "/TableExtraction/Review?batchId={result}"
  }
}