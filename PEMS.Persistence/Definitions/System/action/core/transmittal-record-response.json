{
  "kind": "action",
  "key": "transmittal-record-response",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Record the response",
    "fa": "ثبت پاسخ"
  },
  "description": {
    "en": "Record the response",
    "fa": "ثبت پاسخ"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Transmittal",
      "action": "RecordResponse",
      "args": {
        "id": "field:id",
        "responseNote": "field:responseNote"
      }
    },
    "success": {
      "en": "Response recorded",
      "fa": "پاسخ ثبت شد."
    },
    "redirect": "/p/transmittal-details?id={id}"
  }
}