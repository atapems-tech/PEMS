{
  "kind": "action",
  "key": "vdr-import-toggle-row",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Include or exclude a VDR import row",
    "fa": "شامل یا حذف ردیف واردات VDR"
  },
  "description": {
    "en": "Include or exclude a VDR import row",
    "fa": "شامل یا حذف ردیف واردات VDR"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "VdrImport",
      "action": "ToggleRow",
      "args": {
        "rowId": "field:rowId",
        "include": "field:include"
      }
    },
    "success": {
      "en": "Done.",
      "fa": "انجام شد."
    },
    "redirect": "/VDRImport/Review?batchId={batchId}"
  }
}