{
  "kind": "action",
  "key": "equipment-import-commit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Commit the batch",
    "fa": "تأیید دسته"
  },
  "description": {
    "en": "Commit the batch",
    "fa": "تأیید دسته"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "EquipmentImport",
      "action": "Commit",
      "args": {
        "batchId": "field:batchId"
      }
    },
    "success": {
      "en": "Equipment import committed.",
      "fa": "ورود تجهیزات تأیید شد."
    },
    "redirect": "/p/equipments"
  }
}