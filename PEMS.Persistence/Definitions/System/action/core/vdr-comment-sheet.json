{
  "kind": "action",
  "key": "vdr-comment-sheet",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Attach the comment sheet",
    "fa": "پیوست برگه‌ی نظرات"
  },
  "description": {
    "en": "Attach the comment sheet",
    "fa": "پیوست برگه‌ی نظرات"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "VdrFiles",
      "action": "UploadCommentSheet",
      "args": {
        "submissionId": "field:submissionId",
        "file": "file:file"
      },
      "upload": {
        "profile": "attachment",
        "maxFileMb": 25
      }
    },
    "success": {
      "en": "Done.",
      "fa": "انجام شد."
    },
    "redirect": "/VDR/Details/{vdrItemId}"
  }
}