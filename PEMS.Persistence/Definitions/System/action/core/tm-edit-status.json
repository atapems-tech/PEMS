{
  "kind": "action",
  "key": "tm-edit-status",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Edit a status",
    "fa": "ویرایش وضعیت"
  },
  "description": {
    "en": "Edit a status",
    "fa": "ویرایش وضعیت"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "TaskManager",
      "action": "EditStatus",
      "args": {
        "statusId": "field:statusId",
        "name": "field:name",
        "nameFa": "field:nameFa",
        "category": "field:category",
        "sortOrder": "field:sortOrder",
        "isActive": "field:isActive"
      }
    },
    "success": {
      "en": "The change was saved.",
      "fa": "تغییر ذخیره شد."
    },
    "redirect": "/TaskManager/AdminSpace/{workSpaceId}"
  }
}