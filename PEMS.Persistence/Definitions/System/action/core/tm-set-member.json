{
  "kind": "action",
  "key": "tm-set-member",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Change a space member",
    "fa": "تغییر عضو فضا"
  },
  "description": {
    "en": "Change a space member",
    "fa": "تغییر عضو فضا"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "TaskManager",
      "action": "SetMember",
      "args": {
        "memberId": "field:memberId",
        "role": "field:role",
        "isActive": "field:isActive"
      }
    },
    "success": {
      "en": "The change was saved.",
      "fa": "تغییر ذخیره شد."
    },
    "redirect": "/TaskManager/AdminSpace/{workSpaceId}"
  }
}