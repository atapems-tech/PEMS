{
  "kind": "action",
  "key": "rcm-fmea-submit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Submit FMEA for review",
    "fa": "ارسال FMEA برای بازبینی"
  },
  "description": {
    "en": "Submit FMEA for review",
    "fa": "ارسال FMEA برای بازبینی"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "RcmFmea",
      "action": "SubmitFmea",
      "args": {
        "fmeaAnalysisId": "field:fmeaAnalysisId"
      }
    },
    "success": {
      "en": "Submitted for review.",
      "fa": "برای بازبینی ارسال شد."
    },
    "redirect": "/RcmFmea/ClassDetail/{equipmentClassId}"
  }
}