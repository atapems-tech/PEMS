{
  "kind": "action",
  "key": "asset-create",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Create asset",
    "fa": "ایجاد دارایی"
  },
  "description": {
    "en": "Create asset",
    "fa": "ایجاد دارایی"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.create",
    "parameters": {
      "entity": "Asset",
      "map": {
        "assetNumber": "AssetNumber",
        "status": "Status",
        "functionalLocationId": "FunctionalLocationId",
        "maintenanceClass": "MaintenanceClass",
        "functionalLocation": "FunctionalLocation",
        "commissioningDate": "CommissioningDate",
        "description": "Description",
        "equipmentId": "EquipmentId"
      },
      "required": [
        "EquipmentId",
        "AssetNumber"
      ],
      "defaults": {
        "IsActive": true
      },
      "unique": [
        {
          "fields": [
            "EquipmentId"
          ],
          "where": {
            "IsActive": true
          },
          "message": {
            "en": "This equipment already has an asset.",
            "fa": "این تجهیز از قبل یک Asset دارد."
          }
        },
        {
          "fields": [
            "AssetNumber"
          ],
          "where": {
            "IsActive": true
          },
          "message": {
            "en": "This asset number is already used.",
            "fa": "این شماره Asset قبلاً استفاده شده است."
          }
        }
      ]
    },
    "success": {
      "en": "Asset created.",
      "fa": "دارایی ایجاد شد."
    },
    "redirect": "/p/assets"
  }
}