{
  "kind": "action",
  "key": "instrument-edit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Edit instrument",
    "fa": "ویرایش ابزار"
  },
  "description": {
    "en": "Edit instrument",
    "fa": "ویرایش ابزار"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.update",
    "parameters": {
      "entity": "Instrument",
      "map": {
        "instrumentType": "InstrumentType",
        "rangeMin": "RangeMin",
        "rangeMax": "RangeMax",
        "alarmSetpoint": "AlarmSetpoint",
        "tripSetpoint": "TripSetpoint",
        "calibrationInterval": "CalibrationInterval",
        "loopNumber": "LoopNumber",
        "system": "System",
        "signalClass": "SignalClass",
        "unit": "Unit",
        "signalType": "SignalType",
        "processVariable": "ProcessVariable",
        "accuracy": "Accuracy",
        "outputSignal": "OutputSignal",
        "powerSupply": "PowerSupply",
        "communication": "Communication",
        "ipRating": "IPRating",
        "processConnection": "ProcessConnection",
        "electricalConnection": "ElectricalConnection",
        "hazardousArea": "HazardousArea",
        "exProtection": "ExProtection",
        "zone": "Zone",
        "gasGroup": "GasGroup",
        "tempClass": "TempClass",
        "failAction": "FailAction",
        "sil": "SIL",
        "junctionBox": "JunctionBox",
        "marshallingCabinet": "MarshallingCabinet",
        "cableNumber": "CableNumber",
        "barrierRelay": "BarrierRelay",
        "ioCardChannel": "IOCardChannel",
        "systemCabinet": "SystemCabinet"
      },
      "required": [
        "InstrumentType"
      ],
      "unique": []
    },
    "success": {
      "en": "Instrument updated.",
      "fa": "ابزار به‌روزرسانی شد."
    },
    "redirect": "/p/instruments"
  }
}