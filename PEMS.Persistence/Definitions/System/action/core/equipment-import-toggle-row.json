{
  "kind": "action",
  "key": "equipment-import-toggle-row",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Include or exclude a row",
    "fa": "شمول یا حذف ردیف"
  },
  "description": {
    "en": "Include or exclude a row",
    "fa": "شمول یا حذف ردیف"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "EquipmentImport",
      "action": "ToggleRow",
      "args": {
        "rowId": "field:rowId",
        "include": "field:include"
      }
    },
    "success": {
      "en": "The row was updated.",
      "fa": "ردیف به‌روز شد."
    },
    "redirect": "/EquipmentImport/Review?batchId={batchId}"
  }
}