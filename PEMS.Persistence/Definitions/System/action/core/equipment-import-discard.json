{
  "kind": "action",
  "key": "equipment-import-discard",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Discard the batch",
    "fa": "حذف دسته"
  },
  "description": {
    "en": "Discard the batch",
    "fa": "حذف دسته"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "EquipmentImport",
      "action": "Discard",
      "args": {
        "batchId": "field:batchId"
      }
    },
    "success": {
      "en": "The import batch was discarded.",
      "fa": "دسته‌ی ورود داده حذف شد."
    },
    "redirect": "/p/equipment-import"
  }
}