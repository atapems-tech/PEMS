                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "publishedA",
                "header": {
                  "en": "Published A",
                  "fa": "منتشرشده A"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "publishedB",
                "header": {
                  "en": "Published B",
                  "fa": "منتشرشده B"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "publishedC",
                "header": {
                  "en": "Published C",
                  "fa": "منتشرشده C"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "publishedOther",
                "header": {
                  "en": "Published other",
                  "fa": "منتشرشده سایر"
                },
                "width": 130,
                "type": "number"
              },
              {
                "key": "frameworkVersion",
                "header": {
                  "en": "Framework",
                  "fa": "چارچوب"
                },
                "width": 110
              }
            ],
            "pageSize": 5,
            "height": 160
          }
        }
      ]
    },
    "permission": "CriticalityAssessment.View"
  }
