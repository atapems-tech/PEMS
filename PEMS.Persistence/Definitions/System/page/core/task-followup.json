{
  "kind": "page",
  "key": "task-followup",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Follow-up of tasks",
    "fa": "پیگیری وظایف"
  },
  "description": {
    "en": "Follow-up of tasks",
    "fa": "پیگیری وظایف"
  },
  "payload": {
    "layout": "list-page",
    "route": "task-followup",
    "permission": "Task.View",
    "regions": {
      "content": [
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "task-followup-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/task-actions",
                "text": {
                  "en": "Tasks to do",
                  "fa": "اقدام وظایف"
                }
              },
              {
                "type": "link",
                "href": "/TaskManager",
                "text": {
                  "en": "Task manager",
                  "fa": "مدیریت وظایف"
                }
              }
            ]
          }
        },
        {
          "id": "list",
          "component": "def:entity-list",
          "options": {
            "id": "task-followup",
            "url": "/d/task-followup-items",
            "idField": "id",
            "viewsKey": "task-followup",
            "columns": [
              {
                "key": "key",
                "width": 100,
                "header": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "title",
                "width": 260,
                "header": {
                  "en": "Title",
                  "fa": "عنوان"
                }
              },
              {
                "key": "assignedTo",
                "width": 160,
                "header": {
                  "en": "Assigned To",
                  "fa": "تخصیص‌یافته به"
                }
              },
              {
                "key": "due",
                "width": 120,
                "type": "date",
                "header": {
                  "en": "Due",
                  "fa": "سررسید"
                }
              },
              {
                "key": "priority",
                "width": 100,
                "header": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "status",
                "width": 130,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "overdue",
                "width": 90,
                "type": "bool",
                "header": {
                  "en": "Overdue",
                  "fa": "عقب‌افتاده"
                }
              },
              {
                "key": "related",
                "width": 140,
                "header": {
                  "en": "Related",
                  "fa": "مرتبط"
                }
              },
              {
                "key": "completionNote",
                "width": 200,
                "header": {
                  "en": "Completion Note",
                  "fa": "یادداشت تکمیل"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 300,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/Task/Details/{id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  },
                  {
                    "key": "move",
                    "url": "/f/task-update-status?taskItemId={id}",
                    "method": "get",
                    "showWhen": "row.canMove == true",
                    "label": {
                      "en": "Move",
                      "fa": "انتقال"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        }
      ]
    }
  }
}