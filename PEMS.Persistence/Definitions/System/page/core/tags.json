{
  "kind": "page",
  "key": "tags",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Tags",
    "fa": "برچسب‌ها"
  },
  "description": {
    "en": "Tags",
    "fa": "برچسب‌ها"
  },
  "payload": {
    "layout": "list-page",
    "route": "tags",
