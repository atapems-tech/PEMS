              {
                "key": "name",
                "label": {
                  "en": "Equipment class",
                  "fa": "کلاس تجهیز"
                }
              },
              {
                "key": "code",
                "label": {
                  "en": "Code",
                  "fa": "کد"
                }
              },
              {
                "key": "equipmentCount",
                "label": {
                  "en": "Equipment",
                  "fa": "تجهیز"
                }
              },
              {
                "key": "fmeaReadiness",
                "label": {
                  "en": "FMEA readiness",
                  "fa": "آمادگی FMEA"
                }
              },
              {
                "key": "rcmReadiness",
