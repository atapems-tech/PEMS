                }
              },
              {
                "type": "link",
                "href": "/f/rcm-functional-requirement-create?equipmentClassId={{params.id|url}}",
                "text": {
                  "en": "New functional requirement",
                  "fa": "کارکرد الزامی جدید"
                }
              },
              {
                "type": "link",
                "href": "/f/rcm-functional-failure-create?equipmentClassId={{params.id|url}}",
                "text": {
                  "en": "New functional failure",
                  "fa": "خرابی کارکردی جدید"
                }
              },
              {
                "type": "link",
