{
  "kind": "page",
  "key": "work-orders",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Work orders",
    "fa": "دستورکارها"
  },
  "description": {
    "en": "Work orders",
    "fa": "دستورکارها"
  },
  "payload": {
    "layout": "list-page",
    "route": "work-orders",
    "permission": "WorkOrder.View",
    "regions": {
      "content": [
        {
          "id": "counts",
          "component": "data-grid",
          "options": {
            "id": "work-orders-counts",
            "url": "/d/work-order-counts",
            "idField": "id",
            "pageSize": 1,
            "height": 90,
            "columns": [
              {
                "key": "open",
                "width": 110,
                "type": "number",
                "href": "/p/work-orders?status=Open",
                "header": {
                  "en": "Open",
                  "fa": "باز"
                }
              },
              {
                "key": "inProgress",
                "width": 130,
                "type": "number",
                "href": "/p/work-orders?status=InProgress",
                "header": {
                  "en": "In progress",
                  "fa": "در حال انجام"
                }
              },
              {
                "key": "completed",
                "width": 130,
                "type": "number",
                "href": "/p/work-orders?status=Completed",
                "header": {
                  "en": "Completed",
                  "fa": "تکمیل‌شده"
                }
              },
              {
                "key": "criticalOpen",
                "width": 140,
                "type": "number",
                "header": {
                  "en": "Critical open",
                  "fa": "بحرانی باز"
                }
              }
            ]
          }
        },
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "work-orders-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/work-orders-mine",
                "text": {
                  "en": "Work orders assigned to me",
                  "fa": "دستورکارهای من"
                }
              },
              {
                "type": "link",
                "href": "/p/maintenance-calendar",
                "text": {
                  "en": "Maintenance calendar",
                  "fa": "تقویم نگهداری"
                }
              }
            ]
          }
        },
        {
          "id": "list",
          "component": "def:entity-list",
          "options": {
            "id": "work-orders",
            "url": "/d/work-order-list?f.status={{params.status|url}}&f.equipmentId={{params.equipmentId|url}}",
            "idField": "id",
            "viewsKey": "work-orders",
            "columns": [
              {
                "key": "workOrderNumber",
                "width": 150,
                "header": {
                  "en": "Work order number",
                  "fa": "شماره دستور کار"
                }
              },
              {
                "key": "equipmentTag",
                "width": 150
              },
              {
                "key": "workOrderType",
                "width": 120,
                "header": {
                  "en": "Work order type",
                  "fa": "نوع دستور کار"
                }
              },
              {
                "key": "priority",
                "width": 100,
                "header": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "team",
                "width": 150,
                "header": {
                  "en": "Team",
                  "fa": "تیم"
                }
              },
              {
                "key": "employee",
                "width": 160
              },
              {
                "key": "assignedTo",
                "width": 140
              },
              {
                "key": "status",
                "width": 120,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "createdDate",
                "width": 140,
                "type": "date"
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/WorkOrder/Details/{id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ],
            "newUrl": "/f/work-order-create",
            "newLabel": {
              "en": "New work order",
              "fa": "دستورکار جدید"
            }
          }
        }
      ]
    }
  }
}