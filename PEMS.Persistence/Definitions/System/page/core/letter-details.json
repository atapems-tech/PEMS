{
  "kind": "page",
  "key": "letter-details",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Letter",
    "fa": "نامه"
  },
  "description": {
    "en": "Letter",
    "fa": "نامه"
  },
  "payload": {
    "layout": "detail-page",
    "route": "letter-details",
    "regions": {
      "content": [
        {
          "id": "back",
          "component": "button",
          "options": {
            "label": {
              "en": "Back to the list",
              "fa": "بازگشت به فهرست"
            },
            "tone": "neutral",
            "href": "/p/letters"
          }
        },
        {
          "id": "head",
          "component": "record-view",
          "options": {
            "id": "letter-head",
            "fields": [
              {
                "key": "number",
                "label": {
                  "en": "Letter no.",
                  "fa": "شماره نامه"
                }
              },
              {
                "key": "subject",
                "label": {
                  "en": "Subject",
                  "fa": "موضوع"
                },
                "wide": true
              },
              {
                "key": "type",
                "label": {
                  "en": "Type",
                  "fa": "نوع"
                }
              },
              {
                "key": "status",
                "label": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "priority",
                "label": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "confidentiality",
                "label": {
                  "en": "Confidentiality",
                  "fa": "محرمانگی"
                }
              },
              {
                "key": "project",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                }
              },
              {
                "key": "discipline",
                "label": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                }
              },
              {
                "key": "sender",
                "label": {
                  "en": "Sender",
                  "fa": "فرستنده"
                }
              },
              {
                "key": "receiver",
                "label": {
                  "en": "Receiver",
                  "fa": "گیرنده"
                }
              },
              {
                "key": "date",
                "label": {
                  "en": "Date",
                  "fa": "تاریخ"
                },
                "type": "date"
              },
              {
                "key": "reference",
                "label": {
                  "en": "Reference",
                  "fa": "مرجع"
                }
              },
              {
                "key": "category",
                "label": {
                  "en": "Category",
                  "fa": "دسته"
                }
