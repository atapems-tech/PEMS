                "type": "bool"
              },
              {
                "key": "signedBy",
                "label": {
                  "en": "Signed by",
                  "fa": "امضا شده توسط"
                }
              },
              {
                "key": "signedDate",
                "label": {
                  "en": "Signed on",
                  "fa": "تاریخ امضا"
                },
                "type": "date"
              },
              {
                "key": "tags",
                "label": {
                  "en": "Tags",
                  "fa": "برچسب‌ها"
                },
                "wide": true
              },
              {
                "key": "body",
                "label": {
                  "en": "Body",
                  "fa": "متن"
                },
                "type": "html",
                "wide": true
              }
            ]
          },
          "bindings": {
            "record": {
              "source": "/d/letter-head",
              "idField": "id",
              "id": "{{params.id}}"
            }
          }
        },
        {
          "id": "actions",
          "component": "data-grid",
          "options": {
            "id": "letter-actions",
            "url": "/d/letter-head?f.id={{params.id|url}}",
            "idField": "id",
            "pageSize": 1,
            "height": 110,
            "columns": [
              {
                "key": "status",
                "width": 140,
                "sortable": false,
                "filterable": false
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 2200,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "submit",
                    "url": "/a/letter-submit-review",
                    "method": "post",
                    "showWhen": "row.canSubmit == true"
                  },
                  {
                    "key": "approve",
                    "url": "/a/letter-approve",
                    "method": "post",
                    "showWhen": "row.canApprove == true"
                  },
                  {
                    "key": "return",
                    "url": "/f/letter-return-revision?letterId={id}",
                    "method": "get",
                    "showWhen": "row.canApprove == true"
                  },
                  {
                    "key": "reject",
                    "url": "/f/letter-reject?letterId={id}",
                    "method": "get",
                    "showWhen": "row.canApprove == true",
                    "tone": "danger"
                  },
                  {
                    "key": "issue",
                    "url": "/a/letter-issue",
                    "method": "post",
                    "showWhen": "row.canIssue == true"
                  },
                  {
                    "key": "close",
                    "url": "/a/letter-close",
                    "method": "post",
                    "showWhen": "row.canClose == true"
                  },
                  {
                    "key": "send",
                    "url": "/a/letter-send",
                    "method": "post",
                    "showWhen": "row.canSend == true"
                  },
                  {
                    "key": "archive",
                    "url": "/a/letter-archive",
                    "method": "post",
                    "showWhen": "row.canArchive == true"
                  },
                  {
                    "key": "reply",
                    "url": "/LetterCompose/Compose?replyTo={id}",
                    "method": "get",
                    "showWhen": "row.canReplyRefer == true"
                  },
                  {
                    "key": "refer-compose",
                    "url": "/LetterCompose/Compose?referTo={id}",
                    "method": "get",
                    "showWhen": "row.canReplyRefer == true"
                  },
                  {
                    "key": "sign",
                    "url": "/f/letter-sign?letterId={id}",
                    "method": "get",
                    "showWhen": "row.canSign == true"
                  },
                  {
                    "key": "response",
                    "url": "/f/letter-response-due?letterId={id}&responseRequired={raw.responseRequired}&responseDueDate={raw.responseDue}",
                    "method": "get",
                    "showWhen": "row.canResponse == true"
                  },
                  {
                    "key": "refer",
                    "url": "/f/letter-refer?letterId={id}",
                    "method": "get"
                  },
                  {
                    "key": "add-recipient",
                    "url": "/f/letter-add-recipient?letterId={id}",
                    "method": "get"
                  },
                  {
                    "key": "tag",
                    "url": "/f/letter-attach-tag?letterId={id}",
                    "method": "get"
                  },
                  {
                    "key": "upload",
                    "url": "/f/letter-upload-attachment?letterId={id}",
                    "method": "get"
                  },
                  {
                    "key": "pdf",
                    "url": "/Letter/ExportPdf/{id}",
                    "method": "get"
                  },
                  {
                    "key": "history",
                    "url": "/LetterCompose/History/{id}",
                    "method": "get",
                    "showWhen": "row.canAudit == true"
                  }
                ]
              }
            ]
          }
        },
