              {
                "key": "responseDue",
                "label": {
                  "en": "Response due",
                  "fa": "سررسید پاسخ"
                },
                "type": "date"
              },
              {
                "key": "responseAnswered",
                "label": {
                  "en": "Answered",
                  "fa": "پاسخ داده شده"
                },
                "type": "bool"
              },
              {
                "key": "responseOverdue",
                "label": {
                  "en": "Response overdue",
                  "fa": "پاسخ دیرکرد دارد"
