{
  "kind": "page",
  "key": "task-backlog",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Backlog",
    "fa": "بک‌لاگ"
  },
  "description": {
    "en": "Backlog",
    "fa": "بک‌لاگ"
  },
  "payload": {
    "layout": "detail-page",
    "route": "task-backlog",
    "permission": "Task.View",
    "regions": {
      "content": [
        {
          "id": "head",
          "component": "record-view",
          "options": {
            "id": "task-backlog-head",
            "fields": [
              {
                "key": "name",
                "label": {
                  "en": "Space",
                  "fa": "فضا"
                }
              },
              {
                "key": "key",
                "label": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "role",
                "label": {
                  "en": "Role",
                  "fa": "نقش"
                }
              },
              {
                "key": "description",
                "label": {
                  "en": "Description",
                  "fa": "توضیحات"
                },
                "wide": true
              },
              {
                "key": "hint",
                "label": {
                  "en": "Hint",
                  "fa": "راهنما"
                },
                "wide": true
              }
            ]
          },
          "bindings": {
            "record": {
              "source": "/d/task-backlog-head",
              "idField": "key",
              "id": "{{params.key}}"
            }
          }
        },
        {
          "id": "tools",
          "component": "data-grid",
          "options": {
            "id": "task-backlog-tools",
            "url": "/d/task-backlog-head?f.key={{params.key|url}}",
            "idField": "key",
            "pageSize": 1,
            "height": 90,
            "columns": [
              {
                "key": "name",
                "width": 240,
                "sortable": false,
                "filterable": false,
                "header": {
                  "en": "Name",
                  "fa": "نام"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 760,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "board",
                    "url": "/p/task-board?key={raw.key}",
                    "method": "get",
                    "label": {
                      "en": "Board",
                      "fa": "برد"
                    }
                  },
                  {
                    "key": "filter",
                    "url": "/p/task-all-work?spaceKey={raw.key}&statusCategory=NotDone",
                    "method": "get",
                    "label": {
                      "en": "Filter",
                      "fa": "فیلتر"
                    }
                  },
                  {
                    "key": "create",
                    "url": "/f/tm-create-item?workSpaceId={raw.id}",
                    "method": "get",
                    "showWhen": "row.canCreate == true",
                    "label": {
                      "en": "Create",
                      "fa": "ایجاد"
                    }
                  },
                  {
                    "key": "new-sprint",
                    "url": "/f/tm-create-sprint?workSpaceId={raw.id}&key={raw.key}",
                    "method": "get",
                    "showWhen": "row.canManageSprints == true",
                    "label": {
                      "en": "New sprint",
                      "fa": "اسپرینت جدید"
                    }
                  },
                  {
                    "key": "spaces",
                    "url": "/p/task-manager",
                    "method": "get",
                    "label": {
                      "en": "Spaces",
                      "fa": "فضاها"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "sprints",
          "component": "def:related-table",
          "options": {
            "id": "task-backlog-sprints",
            "url": "/d/task-backlog-sprints?f.key={{params.key|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "name",
                "width": 200,
                "header": {
                  "en": "Name",
                  "fa": "نام"
                }
              },
              {
                "key": "state",
                "width": 110,
                "header": {
                  "en": "State",
                  "fa": "حالت"
                }
              },
              {
                "key": "period",
                "width": 200,
                "header": {
                  "en": "Period",
                  "fa": "دوره"
                }
              },
              {
                "key": "counts",
                "width": 220,
                "header": {
                  "en": "Counts",
                  "fa": "تعداد‌ها"
                }
              },
              {
                "key": "goal",
                "width": 300,
                "header": {
                  "en": "Goal",
                  "fa": "هدف"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 360,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "start",
                    "url": "/f/tm-start-sprint?sprintId={id}&key={{params.key}}",
                    "method": "get",
                    "showWhen": "row.canStart == true",
                    "label": {
                      "en": "Start",
                      "fa": "شروع"
                    }
                  },
                  {
                    "key": "complete",
                    "url": "/f/tm-complete-sprint?sprintId={id}&key={{params.key}}",
                    "method": "get",
                    "showWhen": "row.canComplete == true",
                    "label": {
                      "en": "Complete",
                      "fa": "تکمیل"
                    }
                  },
                  {
                    "key": "edit",
                    "url": "/f/tm-update-sprint?sprintId={id}&key={{params.key}}&name={raw.name}&goal={raw.goal}",
                    "method": "get",
                    "showWhen": "row.canManage == true",
                    "label": {
                      "en": "Edit",
                      "fa": "ویرایش"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "items",
          "component": "data-grid",
          "options": {
            "id": "task-backlog-items",
            "url": "/d/task-backlog-items?f.key={{params.key|url}}",
            "idField": "id",
            "viewsKey": "task-backlog-items",
            "selectable": true,
            "columns": [
              {
                "key": "key",
                "width": 110,
                "header": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "title",
                "width": 320,
                "header": {
                  "en": "Title",
                  "fa": "عنوان"
                }
              },
              {
                "key": "type",
                "width": 110,
                "header": {
                  "en": "Type",
                  "fa": "نوع"
                }
              },
              {
                "key": "status",
                "width": 120,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "priority",
                "width": 100,
                "header": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "assignee",
                "width": 160,
                "header": {
                  "en": "Assignee",
                  "fa": "مسئول"
                }
              },
              {
                "key": "dueDate",
                "width": 110,
                "type": "date",
                "header": {
                  "en": "Due date",
                  "fa": "مهلت"
                }
              },
              {
                "key": "overdue",
                "width": 90,
                "type": "bool",
                "header": {
                  "en": "Overdue",
                  "fa": "عقب‌افتاده"
                }
              },
              {
                "key": "points",
                "width": 80,
                "type": "number",
                "header": {
                  "en": "Points",
                  "fa": "امتیاز"
                }
              },
              {
                "key": "sprint",
                "width": 160,
                "header": {
                  "en": "Sprint",
                  "fa": "اسپرینت"
                }
              },
              {
                "key": "archived",
                "width": 90,
                "type": "bool",
                "header": {
                  "en": "Archived",
                  "fa": "بایگانی‌شده"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 360,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/Task/Details/{id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  },
                  {
                    "key": "up",
                    "url": "/a/tm-rank-up",
                    "method": "post",
                    "showWhen": "row.canRank == true",
                    "label": {
                      "en": "Move up",
                      "fa": "بالا"
                    }
                  },
                  {
                    "key": "down",
                    "url": "/a/tm-rank-down",
                    "method": "post",
                    "showWhen": "row.canRank == true",
                    "label": {
                      "en": "Move down",
                      "fa": "پایین"
                    }
                  },
                  {
                    "key": "sprint",
                    "url": "/f/tm-set-sprint?id={id}&key={{params.key}}",
                    "method": "get",
                    "showWhen": "row.canRank == true",
                    "label": {
                      "en": "Sprint",
                      "fa": "اسپرینت"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ],
            "bulkActions": [
              {
                "key": "status",
                "label": {
                  "en": "Change status",
                  "fa": "تغییر وضعیت"
                },
                "formUrl": "/f/tm-bulk-status?key={{params.key|url}}"
              },
              {
                "key": "assign",
                "label": {
                  "en": "Assign",
                  "fa": "تخصیص"
                },
                "formUrl": "/f/tm-bulk-assign?key={{params.key|url}}"
              },
              {
                "key": "sprint",
                "label": {
                  "en": "Move to sprint",
                  "fa": "انتقال به اسپرینت"
                },
                "formUrl": "/f/tm-bulk-sprint?key={{params.key|url}}"
              },
              {
                "key": "archive",
                "label": {
                  "en": "Archive",
                  "fa": "بایگانی"
                },
                "formUrl": "/f/tm-bulk-archive?key={{params.key|url}}"
              }
            ]
          }
        }
      ]
    }
  }
}