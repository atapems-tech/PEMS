{
  "kind": "page",
  "key": "transmittal-details",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Transmittal",
    "fa": "ترنسمیتال"
  },
  "description": {
    "en": "Transmittal",
    "fa": "ترنسمیتال"
  },
  "payload": {
    "layout": "detail-page",
    "route": "transmittal-details",
    "regions": {
      "content": [
        {
          "id": "back",
          "component": "button",
          "options": {
            "label": {
              "en": "Back to the list",
              "fa": "بازگشت به فهرست"
            },
            "tone": "neutral",
            "href": "/p/transmittals"
          }
        },
        {
          "id": "head",
          "component": "record-view",
          "options": {
            "id": "transmittal-head",
            "fields": [
              {
                "key": "no",
                "label": {
                  "en": "Transmittal",
                  "fa": "ترنسمیتال"
                }
              },
              {
                "key": "status",
                "label": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "project",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                }
              },
              {
                "key": "from",
                "label": {
                  "en": "From",
                  "fa": "از"
                }
              },
              {
                "key": "to",
                "label": {
                  "en": "To",
                  "fa": "به"
                }
              },
              {
                "key": "purpose",
                "label": {
                  "en": "Purpose",
                  "fa": "هدف"
                }
              },
              {
                "key": "created",
                "label": {
                  "en": "Created",
                  "fa": "ایجاد"
                },
                "type": "date"
              },
              {
                "key": "sent",
                "label": {
                  "en": "Sent",
                  "fa": "ارسال"
                },
                "type": "date"
              },
              {
                "key": "description",
                "label": {
                  "en": "Description",
                  "fa": "شرح"
                },
                "wide": true
              },
              {
                "key": "reissuedFrom",
                "label": {
                  "en": "Reissued from",
                  "fa": "صدور مجدد از"
                }
              },
              {
                "key": "supersededBy",
                "label": {
                  "en": "Superseded by",
                  "fa": "جایگزین‌شده با"
                }
              },
              {
                "key": "cancelled",
                "label": {
                  "en": "Cancelled",
                  "fa": "لغو"
                },
                "wide": true
              },
              {
                "key": "responseDue",
                "label": {
                  "en": "Response due",
                  "fa": "سررسید پاسخ"
                },
                "type": "date"
              },
              {
                "key": "responseOverdue",
                "label": {
                  "en": "Response overdue",
                  "fa": "پاسخ دیرکرد دارد"
                },
                "type": "bool"
              },
              {
                "key": "responseReceived",
                "label": {
                  "en": "Response received",
                  "fa": "دریافت پاسخ"
                },
                "type": "date"
              },
              {
                "key": "responseNote",
                "label": {
                  "en": "Response note",
                  "fa": "یادداشت پاسخ"
                },
                "wide": true
              }
            ]
          },
          "bindings": {
            "record": {
              "source": "/d/transmittal-head",
              "idField": "id",
              "id": "{{params.id}}"
            }
          }
        },
        {
          "id": "actions",
          "component": "data-grid",
          "options": {
            "id": "transmittal-actions",
            "url": "/d/transmittal-head?f.id={{params.id|url}}",
            "idField": "id",
            "pageSize": 1,
            "height": 110,
            "columns": [
              {
                "key": "status",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 900,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "mark-sent",
                    "url": "/f/transmittal-mark-sent?id={id}",
                    "method": "get",
                    "showWhen": "row.canSend == true",
                    "label": {
                      "en": "Mark as sent",
                      "fa": "علامت ارسال"
                    }
                  },
                  {
                    "key": "cancel",
                    "url": "/f/transmittal-cancel?id={id}",
                    "method": "get",
                    "showWhen": "row.canCancel == true",
                    "tone": "danger",
                    "label": {
                      "en": "Cancel",
                      "fa": "لغو"
                    }
                  },
                  {
                    "key": "record-response",
                    "url": "/f/transmittal-record-response?id={id}",
                    "method": "get",
                    "showWhen": "row.canRecordResponse == true",
                    "label": {
                      "en": "Record the response",
                      "fa": "ثبت پاسخ"
                    }
                  },
                  {
                    "key": "reissue",
                    "url": "/a/transmittal-reissue",
                    "method": "post",
                    "showWhen": "row.canReissue == true",
                    "label": {
                      "en": "Reissue",
                      "fa": "صدور مجدد"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "h-recipients",
          "component": "content-blocks",
          "options": {
            "id": "h-recipients",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Recipients",
                  "fa": "گیرندگان"
                }
              }
            ]
          }
        },
        {
          "id": "recipients",
          "component": "def:related-table",
          "options": {
            "id": "recipients",
            "url": "/d/transmittal-recipients?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "name",
                "width": 200,
                "header": {
                  "en": "Name",
                  "fa": "نام"
                }
              },
              {
                "key": "type",
                "width": 110,
                "header": {
                  "en": "Type",
                  "fa": "نوع"
                }
              },
              {
                "key": "organization",
                "width": 180,
                "header": {
                  "en": "Organization",
                  "fa": "سازمان"
                }
              },
              {
                "key": "responseRequired",
                "width": 130,
                "header": {
                  "en": "Response required",
                  "fa": "نیازمند پاسخ"
                }
              },
              {
                "key": "acknowledgement",
                "width": 280,
                "header": {
                  "en": "Acknowledgement",
                  "fa": "تأیید دریافت"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 180,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "acknowledge",
                    "url": "/f/transmittal-acknowledge?id={{params.id}}&recipientId={id}",
                    "method": "get",
                    "showWhen": "row.canAcknowledge == true",
                    "label": {
                      "en": "Acknowledge",
                      "fa": "تأیید دریافت"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "h-items",
          "component": "content-blocks",
          "options": {
            "id": "h-items",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Included documents",
                  "fa": "مدارک شامل"
                }
              }
            ]
          }
        },
        {
          "id": "items",
          "component": "def:related-table",
          "options": {
            "id": "items",
            "url": "/d/transmittal-items?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "documentNo",
                "width": 160,
                "header": {
                  "en": "Document No",
                  "fa": "شماره مدرک"
                }
              },
              {
                "key": "title",
                "width": 300,
                "header": {
                  "en": "Title",
                  "fa": "عنوان"
                }
              },
              {
                "key": "revision",
                "width": 90,
                "header": {
                  "en": "Revision",
                  "fa": "ویرایش"
                }
              },
              {
                "key": "file",
                "width": 260,
                "header": {
                  "en": "File",
                  "fa": "فایل"
                }
              },
              {
                "key": "remarks",
                "width": 240,
                "header": {
                  "en": "Remarks",
                  "fa": "ملاحظات"
                }
              }
            ]
          }
        }
      ]
    },
    "permission": "Transmittal.View"
  }
}