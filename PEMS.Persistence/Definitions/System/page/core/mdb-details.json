                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "remove",
                    "url": "/a/mdb-remove-document",
                    "method": "post",
                    "tone": "danger"
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "add-b",
          "component": "content-blocks",
          "options": {
            "id": "add-b",
            "blocks": [
              {
                "type": "link",
                "href": "/f/mdb-add-document?mdbId={{params.id|url}}&part=B",
                "text": {
                  "en": "Add a document to part B",
                  "fa": "افزودن مدرک به بخش B"
                }
              }
            ]
          }
        },
        {
          "id": "h-c",
          "component": "content-blocks",
          "options": {
            "id": "h-c",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Part C - Installation / Startup / Commissioning / O&M Manual",
                  "fa": "بخش C - راهنمای نصب، راه‌اندازی، بهره‌برداری و نگهداری"
                }
              }
            ]
          }
        },
        {
          "id": "part-c",
          "component": "def:related-table",
          "options": {
            "id": "part-c",
            "url": "/d/mdb-part-c?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "documentNo",
