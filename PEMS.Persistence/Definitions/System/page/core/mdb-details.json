              },
              {
                "key": "title",
                "width": 280,
                "header": {
                  "en": "Title",
                  "fa": "عنوان"
                }
              },
              {
                "key": "dvdVolume",
                "width": 100,
                "type": "number"
              },
              {
                "key": "notApplicable",
                "width": 120
              },
              {
                "key": "notes",
                "width": 240
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "remove",
                    "url": "/a/mdb-remove-document",
                    "method": "post",
                    "tone": "danger"
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "add-c",
          "component": "content-blocks",
          "options": {
            "id": "add-c",
            "blocks": [
              {
                "type": "link",
                "href": "/f/mdb-add-document?mdbId={{params.id|url}}&part=C",
                "text": {
                  "en": "Add a document to part C",
                  "fa": "افزودن مدرک به بخش C"
                }
              }
            ]
          }
        }
      ]
    },
    "permission": "MDB.View"
  }
}