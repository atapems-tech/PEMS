                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "advance",
                    "label": {
                      "en": "Advance to the next status",
                      "fa": "رفتن به وضعیت بعدی"
                    },
                    "url": "/a/permit-advance",
                    "method": "post",
                    "showWhen": "row.nextStatus != ''"
                  },
                  {
                    "key": "submit",
                    "label": {
                      "en": "Submit for approval",
                      "fa": "ارسال برای تأیید"
                    },
                    "url": "/a/permit-submit-for-approval",
                    "method": "post",
                    "showWhen": "row.canSubmitForApproval == true"
                  },
                  {
                    "key": "respond",
                    "label": {
                      "en": "Respond to the approval step",
                      "fa": "پاسخ به مرحله‌ی تأیید"
                    },
                    "url": "/f/permit-respond-approval?id={id}",
                    "method": "get",
                    "showWhen": "row.canRespond == true"
                  },
                  {
                    "key": "rework",
                    "label": {
                      "en": "Return for rework",
                      "fa": "بازگشت برای اصلاح"
                    },
                    "url": "/f/permit-return-for-rework?id={id}",
                    "method": "get",
                    "showWhen": "row.canRespond == true"
                  },
                  {
                    "key": "start",
                    "label": {
                      "en": "Start work",
                      "fa": "شروع کار"
                    },
                    "url": "/f/execution-gate-start-work?permitId={id}",
                    "method": "get",
                    "showWhen": "row.gateEligible == true"
                  },
                  {
                    "key": "override",
                    "label": {
                      "en": "Emergency override",
                      "fa": "عبور اضطراری"
                    },
                    "url": "/f/execution-gate-emergency-override?permitId={id}",
                    "method": "get",
                    "showWhen": "row.canEmergencyOverride == true",
                    "tone": "danger"
                  },
                  {
                    "key": "suspend",
                    "label": {
                      "en": "Suspend",
                      "fa": "تعلیق"
                    },
                    "url": "/f/permit-suspend?id={id}",
                    "method": "get",
                    "showWhen": "row.status == 'Active'"
                  },
                  {
                    "key": "close",
                    "label": {
                      "en": "Close",
                      "fa": "بستن"
                    },
                    "url": "/f/permit-close?id={id}",
                    "method": "get",
                    "showWhen": "row.status == 'Active'"
