{
  "kind": "page",
  "key": "permit-details",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Permit",
    "fa": "مجوز کار"
  },
  "description": {
    "en": "One permit with its approval chain, isolation, gas tests, SIMOPS and execution gate (page definition)",
    "fa": "یک مجوز کار با زنجیره‌ی تأیید، ایزوله‌سازی، تست گاز، SIMOPS و دروازه‌ی اجرا (تعریف صفحه)"
  },
