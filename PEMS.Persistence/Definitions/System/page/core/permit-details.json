      "header": [
        {
          "id": "back",
          "component": "button",
          "options": {
            "label": "Back to the list",
            "tone": "neutral",
            "href": "/p/permits"
          }
        },
        {
          "id": "add-isolation",
          "component": "button",
          "options": {
            "label": {
              "en": "Add an isolation point",
              "fa": "افزودن نقطه‌ی ایزوله‌سازی"
            },
            "tone": "primary",
            "href": "/f/isolation-create?permitId={{params.id}}"
          }
        },
        {
