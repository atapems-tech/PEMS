{
  "kind": "page",
  "key": "strategy-list",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Maintenance strategies",
    "fa": "استراتژی‌های نگهداری"
  },
  "description": {
    "en": "Maintenance strategies",
    "fa": "استراتژی‌های نگهداری"
  },
  "payload": {
    "layout": "list-page",
    "route": "strategy-list",
    "permission": "MaintenanceStrategy.View",
    "regions": {
      "content": [
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "strategy-list-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/strategy-coverage",
                "text": {
                  "en": "Coverage",
                  "fa": "پوشش"
                }
              },
              {
                "type": "link",
                "href": "/p/failure-mode-catalog",
                "text": {
                  "en": "Failure-mode catalogue",
                  "fa": "کاتالوگ حالت‌های خرابی"
                }
              },
              {
                "type": "link",
                "href": "/MaintenanceStrategy/BulkCreate",
                "text": {
                  "en": "Bulk assignment",
                  "fa": "تخصیص دسته‌جمعی"
                }
              }
            ]
          }
        },
        {
          "id": "list",
          "component": "def:entity-list",
          "options": {
            "id": "strategy-list",
            "url": "/d/strategy-list",
            "idField": "id",
            "viewsKey": "strategy-list",
            "columns": [
              {
                "key": "equipmentClass",
                "width": 170,
                "header": {
                  "en": "Equipment Class",
                  "fa": "کلاس تجهیز"
                }
              },
              {
                "key": "equipmentTag",
                "width": 140,
                "header": {
                  "en": "Equipment Tag",
                  "fa": "تگ تجهیز"
                }
              },
              {
                "key": "strategyType",
                "width": 130,
                "header": {
                  "en": "Strategy Type",
                  "fa": "نوع استراتژی"
                }
              },
              {
                "key": "failureMode",
                "width": 200,
                "header": {
                  "en": "Failure Mode",
                  "fa": "حالت خرابی"
                }
              },
              {
                "key": "consequence",
                "width": 130,
                "header": {
                  "en": "Consequence",
                  "fa": "پیامد"
                }
              },
              {
                "key": "frequency",
                "width": 110,
                "header": {
                  "en": "Frequency",
                  "fa": "تناوب"
                }
              },
              {
                "key": "status",
                "width": 120,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "version",
                "width": 80,
                "type": "number",
                "header": {
                  "en": "Version",
                  "fa": "نسخه"
                }
              },
              {
                "key": "assignedTags",
                "width": 90,
                "type": "number",
                "header": {
                  "en": "Assigned Tags",
                  "fa": "تگ‌های تخصیص‌یافته"
                }
              },
              {
                "key": "reviewOverdue",
                "width": 110,
                "type": "bool",
                "header": {
                  "en": "Review Overdue",
                  "fa": "بازبینی عقب‌افتاده"
                }
              },
              {
                "key": "justification",
                "width": 280,
                "header": {
                  "en": "Justification",
                  "fa": "توجیه"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 180,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/p/strategy-details?id={id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  },
                  {
                    "key": "edit",
                    "url": "/MaintenanceStrategy/Edit/{id}",
                    "method": "get",
                    "showWhen": "row.status != 'Retired'",
                    "label": {
                      "en": "Edit",
                      "fa": "ویرایش"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ],
            "newUrl": "/MaintenanceStrategy/Create",
            "newLabel": {
              "en": "New strategy",
              "fa": "استراتژی جدید"
            }
          }
        }
      ]
    }
  }
}