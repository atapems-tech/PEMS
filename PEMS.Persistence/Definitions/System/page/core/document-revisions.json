{
  "kind": "page",
  "key": "document-revisions",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Document Revision",
    "fa": "Revision مدارک"
  },
  "description": {
    "en": "The revision history of the engineering documents (page definition)",
    "fa": "تاریخچه‌ی Revision مدارک مهندسی (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "document-revisions",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "document-revisions-filters",
            "resetUrl": "/p/document-revisions",
            "fields": [
              {
                "name": "documentId",
                "label": {
                  "en": "Document",
                  "fa": "مدرک"
                },
                "kind": "select",
                "value": "{{params.documentId}}",
                "options": []
              }
            ]
          },
          "bindings": {
            "filterOptions": [
              {
                "field": "documentId",
                "source": "/d/document-revisions-documents",
                "valueField": "value",
                "labelField": "label"
              }
            ]
          }
        },
        {
          "id": "revisions",
          "component": "data-grid",
          "options": {
            "id": "revisions",
            "url": "/d/document-revisions?f.documentId={{params.documentId|url}}",
            "idField": "documentId",
            "columns": [
              {
                "key": "documentNo",
                "header": {
                  "en": "Document",
                  "fa": "مدرک"
                },
                "width": 150
              },
              {
                "key": "revisionNo",
                "header": {
                  "en": "Revision",
                  "fa": "Revision"
                },
                "width": 90
              },
              {
                "key": "previousRevisionNo",
                "header": {
                  "en": "Previous",
                  "fa": "قبلی"
                },
                "width": 90
              },
              {
                "key": "status",
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                },
                "width": 110
              },
              {
                "key": "issuePurpose",
                "header": {
                  "en": "Issue purpose",
                  "fa": "هدف صدور"
                },
                "width": 160
              },
              {
                "key": "revisionDate",
                "header": {
                  "en": "Date",
                  "fa": "تاریخ"
                },
                "width": 120,
                "type": "date"
              },
              {
                "key": "preparedBy",
                "header": {
                  "en": "Prepared by",
                  "fa": "تهیه‌کننده"
                },
                "width": 150
              },
              {
                "key": "checkedBy",
                "header": {
                  "en": "Checked by",
                  "fa": "بررسی‌کننده"
                },
                "width": 150
              },
              {
                "key": "approvedBy",
                "header": {
                  "en": "Approved by",
                  "fa": "تأییدکننده"
                },
                "width": 150
              },
              {
                "key": "_actions",
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                },
                "type": "actions",
                "width": 150,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "label": {
                      "en": "Open the document",
                      "fa": "باز کردن مدرک"
                    },
                    "url": "/EngineeringDocuments/Details/{id}",
                    "method": "get"
                  }
                ]
              }
            ],
            "pageSize": 25,
            "height": 520
          }
        }
      ]
    }
  }
}