{
  "kind": "page",
  "key": "task-actions",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Tasks to do",
    "fa": "اقدام وظایف"
  },
  "description": {
    "en": "Tasks to do",
    "fa": "اقدام وظایف"
  },
  "payload": {
    "layout": "list-page",
    "route": "task-actions",
    "permission": "Task.View",
    "regions": {
      "content": [
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "task-actions-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/task-followup",
                "text": {
                  "en": "Follow-up of the tasks I assigned",
                  "fa": "پیگیری وظایف"
                }
              },
              {
                "type": "link",
                "href": "/TaskManager",
                "text": {
                  "en": "Task manager",
                  "fa": "مدیریت وظایف"
                }
              }
            ]
          }
        },
        {
          "id": "list",
          "component": "def:entity-list",
          "options": {
            "id": "task-actions",
            "url": "/d/task-action-items",
            "idField": "id",
            "viewsKey": "task-actions",
            "columns": [
              {
                "key": "key",
                "width": 100
              },
              {
                "key": "title",
                "width": 260
              },
              {
                "key": "assignedTo",
                "width": 160
              },
              {
                "key": "due",
                "width": 120,
                "type": "date"
              },
              {
                "key": "priority",
                "width": 100
              },
              {
                "key": "status",
                "width": 130
              },
              {
                "key": "overdue",
                "width": 90,
                "type": "bool"
              },
              {
                "key": "related",
                "width": 140
              },
              {
                "key": "completionNote",
                "width": 200
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 300,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/Task/Details/{id}",
                    "method": "get"
                  },
                  {
                    "key": "move",
                    "url": "/f/task-update-status?taskItemId={id}",
                    "method": "get",
                    "showWhen": "row.canMove == true"
                  }
                ]
              }
            ],
            "newUrl": "/f/task-create",
            "newLabel": {
              "en": "New personal task",
              "fa": "وظیفه‌ی شخصی جدید"
            }
          }
        }
      ]
    }
  }
}