{
  "kind": "page",
  "key": "report-engineering",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Engineering documents report",
    "fa": "گزارش مدارک مهندسی"
  },
  "description": {
    "en": "Documents, approvals and revisions (page definition)",
    "fa": "مدارک، تأییدها و بازنگری‌ها (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "report-engineering",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "report-engineering-filters",
            "resetUrl": "/p/report-engineering",
            "fields": [
              {
                "name": "projectId",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                },
                "kind": "select",
                "value": "{{params.projectId}}"
              },
              {
                "name": "disciplineId",
                "label": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                },
                "kind": "select",
                "value": "{{params.disciplineId}}"
              },
              {
                "name": "fromDate",
                "label": {
                  "en": "From",
                  "fa": "از تاریخ"
                },
                "kind": "date",
                "value": "{{params.fromDate}}"
              },
              {
                "name": "toDate",
                "label": {
                  "en": "To",
                  "fa": "تا تاریخ"
                },
                "kind": "date",
                "value": "{{params.toDate}}"
              }
            ]
          },
          "bindings": {
            "filterOptions": [
              {
                "field": "projectId",
                "source": "/d/report-projects",
                "valueField": "value",
                "labelField": "label"
              },
              {
                "field": "disciplineId",
                "source": "/d/report-disciplines",
                "valueField": "value",
                "labelField": "label"
              }
            ]
          }
        },
        {
          "id": "report-engineering-rows",
          "component": "data-grid",
          "options": {
            "id": "report-engineering-rows",
            "url": "/d/report-engineering-grid?f.projectId={{params.projectId|url}}&f.disciplineId={{params.disciplineId|url}}&f.fromDate={{params.fromDate|url}}&f.toDate={{params.toDate|url}}",
            "idField": "name",
            "columns": [
              {
                "key": "section",
                "header": {
                  "en": "Section",
                  "fa": "بخش"
                },
                "width": 260
              },
              {
                "key": "name",
                "header": {
                  "en": "Name",
                  "fa": "نام"
                },
                "width": 320
              },
              {
                "key": "value",
                "header": {
                  "en": "Value",
                  "fa": "مقدار"
                },
                "width": 220
              }
            ],
            "pageSize": 50,
            "height": 520
          }
        }
      ]
    }
  }
}