{
  "kind": "page",
  "key": "dcc",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Document Control Center (DCC)",
    "fa": "مرکز کنترل مدارک (DCC)"
  },
  "description": {
    "en": "Document Control Center (DCC)",
    "fa": "مرکز کنترل مدارک (DCC)"
  },
  "payload": {
    "layout": "list-page",
    "route": "dcc",
    "regions": {
      "content": [
        {
          "id": "actions",
          "component": "content-blocks",
          "options": {
            "id": "actions",
            "blocks": [
              {
                "type": "link",
                "href": "/f/dcc-register-incoming",
                "text": {
                  "en": "Register an incoming letter",
                  "fa": "ثبت مکاتبه‌ی وارده"
                }
              },
              {
                "type": "link",
                "href": "/p/relationship-explorer",
                "text": {
                  "en": "Relationship Explorer",
                  "fa": "Relationship Explorer"
                }
              }
            ]
          }
        },
        {
          "id": "dcc-counts",
          "component": "data-grid",
          "options": {
            "id": "dcc-counts",
            "url": "/d/dcc-counts",
            "idField": "id",
            "pageSize": 1,
            "height": 90,
            "columns": [
              {
                "key": "pendingIssue",
                "width": 200,
                "type": "number",
                "header": {
                  "en": "Pending issue",
                  "fa": "در انتظار صدور"
                }
              },
              {
                "key": "unlinkedIncoming",
                "width": 200,
                "type": "number",
                "header": {
                  "en": "Unlinked incoming",
                  "fa": "وارده‌های بدون پیوند"
                }
              }
            ]
          }
        },
        {
          "id": "h-pending",
          "component": "content-blocks",
          "options": {
            "id": "h-pending",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Documents waiting for issue",
                  "fa": "مدارک منتظر صدور"
                }
              }
            ]
          }
        },
        {
          "id": "pending",
          "component": "def:related-table",
          "options": {
            "id": "pending",
            "url": "/d/dcc-pending-issue",
            "idField": "id",
            "columns": [
              {
                "key": "documentNo",
                "width": 160,
                "href": "/p/eng-doc-details?id={id}",
                "header": {
                  "en": "Document No",
                  "fa": "شماره مدرک"
                }
              },
              {
                "key": "title",
                "width": 320,
                "header": {
                  "en": "Title",
                  "fa": "عنوان"
                }
              },
              {
                "key": "modified",
                "width": 130,
                "type": "date",
                "header": {
                  "en": "Modified",
                  "fa": "ویرایش‌شده"
                }
              }
            ]
          }
        },
        {
          "id": "h-unlinked",
          "component": "content-blocks",
          "options": {
            "id": "h-unlinked",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Unlinked incoming letters",
                  "fa": "مکاتبات وارده‌ی وصل‌نشده"
                }
              }
            ]
          }
        },
        {
          "id": "unlinked",
          "component": "def:related-table",
          "options": {
            "id": "unlinked",
            "url": "/d/dcc-unlinked",
            "idField": "id",
            "columns": [
              {
                "key": "number",
                "width": 160,
                "href": "/Letter/Details/{id}",
                "header": {
                  "en": "Number",
                  "fa": "شماره"
                }
              },
              {
                "key": "sender",
                "width": 200,
                "header": {
                  "en": "Sender",
                  "fa": "فرستنده"
                }
              },
              {
                "key": "subject",
                "width": 320,
                "header": {
                  "en": "Subject",
                  "fa": "موضوع"
                }
              },
              {
                "key": "date",
                "width": 120,
                "type": "date",
                "header": {
                  "en": "Date",
                  "fa": "تاریخ"
                }
              }
            ]
          }
        },
        {
          "id": "h-recent",
          "component": "content-blocks",
          "options": {
            "id": "h-recent",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Latest incoming letters",
                  "fa": "آخرین مکاتبات وارده"
                }
              }
            ]
          }
        },
        {
          "id": "recent",
          "component": "def:related-table",
          "options": {
            "id": "recent",
            "url": "/d/dcc-recent",
            "idField": "id",
            "columns": [
              {
                "key": "number",
                "width": 160,
                "href": "/Letter/Details/{id}",
                "header": {
                  "en": "Number",
                  "fa": "شماره"
                }
              },
              {
                "key": "sender",
                "width": 200,
                "header": {
                  "en": "Sender",
                  "fa": "فرستنده"
                }
              },
              {
                "key": "subject",
                "width": 320,
                "header": {
                  "en": "Subject",
                  "fa": "موضوع"
                }
              },
              {
                "key": "date",
                "width": 120,
                "type": "date",
                "header": {
                  "en": "Date",
                  "fa": "تاریخ"
                }
              },
              {
                "key": "link",
                "width": 120,
                "header": {
                  "en": "Link",
                  "fa": "پیوند"
                }
              }
            ]
          }
        }
      ]
    },
    "permission": "DCC.View"
  }
}