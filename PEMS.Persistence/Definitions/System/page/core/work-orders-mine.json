{
  "kind": "page",
  "key": "work-orders-mine",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "My work orders",
    "fa": "دستورکارهای من"
  },
  "description": {
    "en": "My work orders",
    "fa": "دستورکارهای من"
  },
  "payload": {
    "layout": "list-page",
    "route": "work-orders-mine",
    "permission": "WorkOrder.View",
    "regions": {
      "content": [
        {
          "id": "counts",
          "component": "data-grid",
          "options": {
            "id": "work-orders-mine-counts",
            "url": "/d/work-order-counts",
            "idField": "id",
            "pageSize": 1,
            "height": 90,
            "columns": [
              {
                "key": "open",
                "width": 110,
                "type": "number"
              },
              {
                "key": "inProgress",
                "width": 130,
                "type": "number"
              },
              {
                "key": "completed",
                "width": 130,
                "type": "number"
              },
              {
                "key": "criticalOpen",
                "width": 140,
                "type": "number"
              }
            ]
          }
        },
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "work-orders-mine-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/work-orders",
                "text": {
                  "en": "All work orders",
                  "fa": "همه‌ی دستورکارها"
                }
              },
              {
                "type": "link",
                "href": "/MaintenanceCalendar",
                "text": {
                  "en": "Maintenance calendar",
                  "fa": "تقویم نگهداری"
                }
              }
            ]
          }
        },
        {
          "id": "list",
          "component": "def:entity-list",
          "options": {
            "id": "work-orders-mine",
            "url": "/d/work-order-mine",
            "idField": "id",
            "viewsKey": "work-orders-mine",
            "columns": [
              {
                "key": "workOrderNumber",
                "width": 150
              },
              {
                "key": "equipmentTag",
                "width": 150
              },
              {
                "key": "workOrderType",
                "width": 120
              },
              {
                "key": "priority",
                "width": 100
              },
              {
                "key": "team",
                "width": 150
              },
              {
                "key": "employee",
                "width": 160
              },
              {
                "key": "assignedTo",
                "width": 140
              },
              {
                "key": "status",
                "width": 120
              },
              {
                "key": "createdDate",
                "width": 140,
                "type": "date"
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/WorkOrder/Details/{id}",
                    "method": "get"
                  }
                ]
              }
            ],
            "newUrl": "/f/work-order-create",
            "newLabel": {
              "en": "New work order",
              "fa": "دستورکار جدید"
            }
          }
        }
      ]
    }
  }
}