{
  "kind": "page",
  "key": "task-admin",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Task manager administration",
    "fa": "مدیریت فضاهای کاری"
  },
  "description": {
    "en": "Task manager administration",
    "fa": "مدیریت فضاهای کاری"
  },
  "payload": {
    "layout": "list-page",
    "route": "task-admin",
    "permission": "Task.View",
    "regions": {
      "content": [
        {
          "id": "links",
          "component": "content-blocks",
          "options": {
            "id": "task-admin-links",
            "blocks": [
              {
                "type": "link",
                "href": "/p/task-manager",
                "text": {
                  "en": "Task manager",
                  "fa": "مدیریت وظایف"
                }
              }
            ]
          }
        },
        {
          "id": "spaces",
          "component": "def:entity-list",
          "options": {
            "id": "task-admin-spaces",
            "url": "/d/task-admin-spaces",
            "idField": "id",
            "viewsKey": "task-admin-spaces",
            "columns": [
              {
                "key": "key",
                "width": 100,
                "header": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "name",
                "width": 260,
                "header": {
                  "en": "Name",
                  "fa": "نام"
                }
              },
              {
                "key": "department",
                "width": 200,
                "header": {
                  "en": "Department",
                  "fa": "واحد"
                }
              },
              {
                "key": "members",
                "width": 100,
                "type": "number",
                "header": {
                  "en": "Members",
                  "fa": "اعضا"
                }
              },
              {
                "key": "openItems",
                "width": 110,
                "type": "number",
                "header": {
                  "en": "Open Items",
                  "fa": "اقلام باز"
                }
              },
              {
                "key": "active",
                "width": 90,
                "type": "bool",
                "header": {
                  "en": "Active",
                  "fa": "فعال"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 160,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/p/task-admin-space?id={id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ],
            "newUrl": "/f/tm-create-space",
            "newLabel": {
              "en": "New space",
              "fa": "فضای جدید"
            }
          }
        }
      ]
    }
  }
}