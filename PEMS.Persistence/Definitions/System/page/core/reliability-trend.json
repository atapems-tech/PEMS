{
  "kind": "page",
  "key": "reliability-trend",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Condition monitoring trend",
    "fa": "روند پایش وضعیت"
  },
  "description": {
    "en": "Condition monitoring trend",
    "fa": "روند پایش وضعیت"
  },
  "payload": {
    "layout": "detail-page",
    "route": "reliability-trend",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "trend-filters",
            "resetUrl": "/p/reliability-trend?pointId={{params.pointId}}",
            "fields": [
              {
                "name": "pointId",
                "label": {
                  "en": "Point id",
                  "fa": "شناسه نقطه"
                },
                "kind": "text",
                "value": "{{params.pointId}}"
              },
              {
                "name": "range",
                "label": {
                  "en": "Range (days)",
                  "fa": "بازه (روز)"
                },
                "kind": "select",
                "value": "{{params.range}}",
                "options": [
                  {
                    "value": "7",
                    "label": {
                      "en": "7",
                      "fa": "7"
                    }
                  },
                  {
                    "value": "30",
                    "label": {
                      "en": "30",
                      "fa": "30"
                    }
                  },
                  {
                    "value": "90",
                    "label": {
                      "en": "90",
                      "fa": "90"
                    }
                  },
                  {
                    "value": "365",
                    "label": {
                      "en": "365",
                      "fa": "365"
                    }
                  },
                  {
                    "value": "custom",
                    "label": {
                      "en": "custom",
                      "fa": "custom"
                    }
                  }
                ]
              },
              {
                "name": "from",
                "label": {
                  "en": "From",
                  "fa": "از"
                },
                "kind": "date",
                "value": "{{params.from}}"
              },
              {
                "name": "to",
                "label": {
                  "en": "To",
                  "fa": "تا"
                },
                "kind": "date",
                "value": "{{params.to}}"
              }
            ]
          }
        },
        {
          "id": "head",
          "component": "data-grid",
          "options": {
            "id": "head",
            "url": "/d/rel-trend?f.pointId={{params.pointId|url}}&f.range={{params.range|url}}&f.from={{params.from|url}}&f.to={{params.to|url}}",
            "idField": "variableType",
            "columns": [
              {
                "key": "variableType",
                "header": {
                  "en": "Variable",
                  "fa": "متغیر"
                },
                "width": 120
              },
              {
                "key": "tag",
                "header": {
                  "en": "Tag",
                  "fa": "تگ"
                },
                "width": 130
              },
              {
                "key": "unit",
                "header": {
                  "en": "Unit",
                  "fa": "واحد"
                },
                "width": 70
              },
              {
                "key": "fromDate",
                "header": {
                  "en": "From",
                  "fa": "از"
                },
                "width": 120,
                "type": "date"
              },
              {
                "key": "toDate",
                "header": {
                  "en": "To",
                  "fa": "تا"
                },
                "width": 120,
                "type": "date"
              },
              {
                "key": "totalInRange",
                "header": {
                  "en": "Readings in range",
                  "fa": "قرائت در بازه"
                },
                "width": 140,
                "type": "number"
              },
              {
                "key": "truncated",
                "header": {
                  "en": "Truncated",
                  "fa": "کوتاه‌شده"
                },
                "width": 100,
                "type": "bool"
              }
            ],
            "pageSize": 5,
            "height": 130
          }
        },
        {
          "id": "points",
          "component": "data-grid",
          "options": {
            "id": "points",
            "url": "/d/rel-trend-points?f.pointId={{params.pointId|url}}&f.range={{params.range|url}}&f.from={{params.from|url}}&f.to={{params.to|url}}",
            "idField": "readingDate",
            "columns": [
              {
                "key": "readingDate",
                "header": {
                  "en": "Reading date",
                  "fa": "تاریخ قرائت"
                },
                "width": 160,
                "type": "date"
              },
              {
                "key": "value",
                "header": {
                  "en": "Value",
                  "fa": "مقدار"
                },
                "width": 100,
                "type": "number"
              },
              {
                "key": "evaluationStatus",
                "header": {
                  "en": "Evaluation",
                  "fa": "ارزیابی"
                },
                "width": 120
              },
              {
                "key": "isAlarm",
                "header": {
                  "en": "Alarm",
                  "fa": "آلارم"
                },
                "width": 80,
                "type": "bool"
              }
            ],
            "pageSize": 100,
            "height": 520
          }
        }
      ]
    },
    "permission": "Reliability.View"
  }
}