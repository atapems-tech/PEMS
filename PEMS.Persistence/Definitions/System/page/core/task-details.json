{
  "kind": "page",
  "key": "task-details",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Task",
    "fa": "وظیفه"
  },
  "description": {
    "en": "Task",
    "fa": "وظیفه"
  },
  "payload": {
    "layout": "detail-page",
    "route": "task-details",
    "permission": "Task.View",
    "regions": {
      "content": [
        {
          "id": "head",
          "component": "record-view",
          "options": {
            "id": "task-head",
            "fields": [
              {
                "key": "key",
                "label": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "title",
                "label": {
                  "en": "Title",
                  "fa": "عنوان"
                },
                "wide": true
              },
              {
                "key": "type",
                "label": {
                  "en": "Type",
                  "fa": "نوع"
                }
              },
              {
                "key": "space",
                "label": {
                  "en": "Space",
                  "fa": "فضا"
                }
              },
              {
                "key": "status",
                "label": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "priority",
                "label": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "assignee",
                "label": {
                  "en": "Assignee",
                  "fa": "مسئول"
                }
              },
              {
                "key": "reporter",
                "label": {
                  "en": "Reporter",
                  "fa": "گزارش‌دهنده"
                }
              },
              {
                "key": "assignedBy",
                "label": {
                  "en": "Assigned by",
                  "fa": "ارجاع‌دهنده"
                }
              },
              {
                "key": "sprint",
                "label": {
                  "en": "Sprint",
                  "fa": "اسپرینت"
                }
              },
              {
                "key": "points",
                "label": {
                  "en": "Story points",
                  "fa": "امتیاز"
                },
                "type": "number"
              },
              {
                "key": "startDate",
                "label": {
                  "en": "Start date",
                  "fa": "تاریخ شروع"
                },
                "type": "date"
              },
              {
                "key": "dueDate",
                "label": {
                  "en": "Due date",
                  "fa": "سررسید"
                },
                "type": "date"
              },
              {
                "key": "overdue",
                "label": {
                  "en": "Overdue",
                  "fa": "عقب‌افتاده"
                },
                "type": "bool"
              },
              {
                "key": "archived",
                "label": {
                  "en": "Archived",
                  "fa": "بایگانی‌شده"
                },
                "type": "bool"
              },
              {
                "key": "created",
                "label": {
                  "en": "Created",
                  "fa": "ایجاد"
                },
                "type": "date"
              },
              {
                "key": "completed",
                "label": {
                  "en": "Completed",
                  "fa": "تکمیل"
                },
                "type": "date"
              },
              {
                "key": "related",
                "label": {
                  "en": "Related",
                  "fa": "مرتبط"
                }
              },
              {
                "key": "watchers",
                "label": {
                  "en": "Watchers",
                  "fa": "ناظران"
                },
                "wide": true
              },
              {
                "key": "completionNote",
                "label": {
                  "en": "Completion note",
                  "fa": "یادداشت پایان"
                },
                "wide": true
              },
              {
                "key": "description",
                "label": {
                  "en": "Description",
                  "fa": "توضیحات"
                },
                "wide": true
              }
            ]
          },
          "bindings": {
            "record": {
              "source": "/d/task-head",
              "idField": "id",
              "id": "{{params.id}}"
            }
          }
        },
        {
          "id": "tools",
          "component": "data-grid",
          "options": {
            "id": "task-tools",
            "url": "/d/task-head?f.id={{params.id|url}}",
            "idField": "id",
            "pageSize": 1,
            "height": 110,
            "columns": [
              {
                "key": "key",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "header": {
                  "en": "Key",
                  "fa": "کلید"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 1600,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "edit",
                    "url": "/f/tm-update-item?id={id}&rowVersion={raw.rowVersion}&parentId={raw.parentId}&title={raw.title}&description={raw.description}&typeId={raw.typeId}&priority={raw.priorityCode}&storyPoints={raw.points}&startDate={raw.startDate}&dueDate={raw.dueDate}",
                    "method": "get",
                    "showWhen": "row.canEdit == true",
                    "label": {
                      "en": "Edit",
                      "fa": "ویرایش"
                    }
                  },
                  {
                    "key": "status",
                    "url": "/f/{raw.transitionForm}?id={id}&rowVersion={raw.rowVersion}",
                    "method": "get",
                    "showWhen": "row.canTransition == true",
                    "label": {
                      "en": "Status",
                      "fa": "وضعیت"
                    }
                  },
                  {
                    "key": "assign",
                    "url": "/f/tm-assign?id={id}&rowVersion={raw.rowVersion}&assigneeEmployeeId={raw.assigneeId}",
                    "method": "get",
                    "showWhen": "row.canAssign == true",
                    "label": {
                      "en": "Assign",
                      "fa": "تخصیص"
                    }
                  },
                  {
                    "key": "comment",
                    "url": "/f/tm-comment?id={id}",
                    "method": "get",
                    "showWhen": "row.canComment == true",
                    "label": {
                      "en": "Comment",
                      "fa": "نظر"
                    }
                  },
                  {
                    "key": "link",
                    "url": "/f/tm-add-link?id={id}",
                    "method": "get",
                    "showWhen": "row.canLink == true",
                    "label": {
                      "en": "Link",
                      "fa": "پیوند"
                    }
                  },
                  {
                    "key": "subtask",
                    "url": "/f/tm-create-subtask?parentId={id}&workSpaceId={raw.workSpaceId}&typeId={raw.subtaskTypeId}&sprintId={raw.sprintId}",
                    "method": "get",
                    "showWhen": "row.canCreateSubtask == true",
                    "label": {
                      "en": "Subtask",
                      "fa": "زیروظیفه"
                    }
                  },
                  {
                    "key": "watch",
                    "url": "/f/tm-watch?id={id}&watch={raw.watchNext}",
                    "method": "get",
                    "label": {
                      "en": "Watch",
                      "fa": "پیگیری"
                    }
                  },
                  {
                    "key": "archive",
                    "url": "/f/tm-archive?id={id}&archived={raw.archiveNext}",
                    "method": "get",
                    "showWhen": "row.canArchive == true",
                    "tone": "danger",
                    "label": {
                      "en": "Archive",
                      "fa": "بایگانی"
                    }
                  },
                  {
                    "key": "related",
                    "url": "{raw.relatedUrl}",
                    "method": "get",
                    "showWhen": "row.relatedUrl != null",
                    "label": {
                      "en": "Related",
                      "fa": "مرتبط"
                    }
                  },
                  {
                    "key": "space",
                    "url": "/p/task-backlog?key={raw.spaceKey}",
                    "method": "get",
                    "showWhen": "row.isLegacy == false",
                    "label": {
                      "en": "Space",
                      "fa": "فضا"
                    }
                  },
                  {
                    "key": "list",
                    "url": "/p/task-actions",
                    "method": "get",
                    "showWhen": "row.isLegacy == true",
                    "label": {
                      "en": "List",
                      "fa": "فهرست"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "h-subtasks",
          "component": "content-blocks",
          "options": {
            "id": "h-subtasks",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Subtasks",
                  "fa": "زیروظیفه‌ها"
                }
              }
            ]
          }
        },
        {
          "id": "task-subtasks",
          "component": "def:related-table",
          "options": {
            "id": "task-subtasks",
            "url": "/d/task-subtasks?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "key",
