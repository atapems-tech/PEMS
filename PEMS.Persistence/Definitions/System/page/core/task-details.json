              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 240,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/p/task-details?id={raw.otherId}",
                    "method": "get",
                    "showWhen": "row.visible == true",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  },
                  {
                    "key": "remove",
                    "url": "/f/tm-remove-link?id={{params.id}}&linkId={id}",
                    "method": "get",
                    "showWhen": "row.canRemove == true",
                    "tone": "danger",
                    "label": {
                      "en": "Remove",
                      "fa": "حذف"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "h-comments",
          "component": "content-blocks",
          "options": {
            "id": "h-comments",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Comments",
                  "fa": "نظرها"
                }
              }
