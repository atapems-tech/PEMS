                  "en": "Type",
                  "fa": "نوع"
                }
              },
              {
                "key": "status",
                "width": 120,
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "priority",
                "width": 100,
                "header": {
                  "en": "Priority",
                  "fa": "اولویت"
                }
              },
              {
                "key": "assignee",
                "width": 160,
                "header": {
                  "en": "Assignee",
                  "fa": "مسئول"
                }
              },
              {
                "key": "dueDate",
                "width": 110,
                "type": "date",
                "header": {
                  "en": "Due date",
                  "fa": "مهلت"
                }
              },
              {
                "key": "points",
                "width": 80,
                "type": "number",
                "header": {
                  "en": "Points",
                  "fa": "امتیاز"
                }
              },
              {
                "key": "_actions",
                "type": "actions",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "url": "/p/task-details?id={id}",
                    "method": "get",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    }
                  }
                ],
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                }
              }
            ]
          }
        },
        {
          "id": "h-links",
          "component": "content-blocks",
          "options": {
            "id": "h-links",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Links",
                  "fa": "پیوندها"
                }
              }
            ]
          }
        },
        {
          "id": "task-links",
