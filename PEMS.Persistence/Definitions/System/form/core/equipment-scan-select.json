        "kind": "select",
        "required": true,
        "messages": {
          "required": {
            "en": "This field is required.",
            "fa": "این فیلد الزامی است."
          }
        },
        "optionsFrom": "equipment-scan-disciplines-opts"
      },
      {
        "name": "tags",
        "label": {
          "en": "Tags (this is a best-effort scan: names and types are placeholders to edit afterwards)",
          "fa": "تگ‌ها (اسکن بهترین‌تلاش است: نام و نوع جایگزین‌اند و باید بعداً ویرایش شوند)"
