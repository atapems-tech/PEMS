            "fa": "این فیلد الزامی است."
          }
        },
        "hidden": true
      },
      {
        "name": "disciplineId",
        "label": {
          "en": "Discipline for all selected tags",
          "fa": "دیسیپلین همه‌ی تگ‌های انتخاب‌شده"
