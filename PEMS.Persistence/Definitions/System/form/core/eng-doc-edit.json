        "messages": {
          "required": {
            "en": "This field is required.",
            "fa": "این فیلد الزامی است."
          }
        },
        "hidden": true
      },
      {
        "name": "documentNo",
        "label": {
          "en": "Document no.",
          "fa": "شماره مدرک"
        },
        "kind": "text",
        "required": true,
        "messages": {
          "required": {
            "en": "This field is required.",
            "fa": "این فیلد الزامی است."
          }
        }
      },
      {
        "name": "documentType",
        "label": {
          "en": "Type",
          "fa": "نوع"
        },
        "kind": "text",
        "required": true,
        "messages": {
          "required": {
            "en": "This field is required.",
            "fa": "این فیلد الزامی است."
          }
        }
      },
      {
        "name": "title",
        "label": {
          "en": "Title",
          "fa": "عنوان"
