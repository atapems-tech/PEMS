        "kind": "text",
        "required": true,
        "messages": {
          "required": {
            "en": "This field is required.",
            "fa": "این فیلد الزامی است."
          }
        },
        "span": 2
      },
      {
        "name": "description",
        "label": {
          "en": "Description",
          "fa": "شرح"
        },
        "kind": "textArea",
        "span": 2
      },
      {
        "name": "projectId",
        "label": {
          "en": "Project",
          "fa": "پروژه"
