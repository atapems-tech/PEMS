      {
        "name": "area",
        "label": {
          "en": "Area",
          "fa": "ناحیه"
        },
        "kind": "text"
      },
      {
        "name": "issuePurpose",
        "label": {
          "en": "Issue purpose",
          "fa": "هدف صدور"
        },
        "kind": "select",
        "options": [
          {
            "value": "IFA",
            "label": {
              "en": "IFA - Issued for Approval",
              "fa": "IFA - صدور برای تأیید"
            }
          },
          {
            "value": "IFR",
            "label": {
              "en": "IFR - Issue for Review and Comments",
              "fa": "IFR - صدور برای بازبینی و نظر"
            }
          },
          {
            "value": "IFI",
            "label": {
              "en": "IFI - Issue for Information",
              "fa": "IFI - صدور برای اطلاع"
            }
          },
          {
            "value": "FI",
            "label": {
              "en": "FI - Final Issue (without comments)",
              "fa": "FI - صدور نهایی (بدون نظر)"
            }
          },
          {
            "value": "For Approval",
            "label": {
              "en": "For Approval (legacy)",
              "fa": "برای تأیید (قدیمی)"
            }
          },
          {
            "value": "For Construction",
            "label": {
              "en": "For Construction (legacy)",
              "fa": "برای ساخت (قدیمی)"
            }
          },
          {
            "value": "For Information",
            "label": {
              "en": "For Information (legacy)",
              "fa": "برای اطلاع (قدیمی)"
            }
          }
        ]
      },
      {
        "name": "preparedBy",
        "label": {
          "en": "Prepared by",
          "fa": "تهیه‌کننده"
        },
        "kind": "text"
      },
      {
        "name": "checkedBy",
        "label": {
          "en": "Checked by",
          "fa": "بررسی‌کننده"
        },
        "kind": "text"
      },
      {
        "name": "approvedBy",
        "label": {
          "en": "Approved by",
          "fa": "تأییدکننده"
        },
        "kind": "text"
      },
      {
        "name": "equipmentId",
        "label": {
          "en": "Related equipment",
          "fa": "تجهیز مرتبط"
        },
        "kind": "select",
        "searchSource": "Equipment"
      },
      {
        "name": "contractId",
        "label": {
          "en": "Related contract",
          "fa": "قرارداد مرتبط"
        },
        "kind": "select",
        "optionsFrom": "eng-doc-form-contracts-opts"
      },
      {
        "name": "relatedMRId",
        "label": {
          "en": "Related material requisition",
          "fa": "درخواست خرید مرتبط"
        },
        "kind": "select",
        "optionsFrom": "eng-doc-form-mrs-opts"
      }
    ]
  }
}