<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Configurations\" />
    <Folder Include="Migrations\" />
    <Folder Include="UnitOfWork\" />
    <Folder Include="Seed\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.973" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PEMS.AI\PEMS.AI.csproj" />
    <ProjectReference Include="..\PEMS.Application\PEMS.Application.csproj" />
    <ProjectReference Include="..\PEMS.Domain\PEMS.Domain.csproj" />
    <ProjectReference Include="..\PEMS.Shared\PEMS.Shared.csproj" />
    <ProjectReference Include="..\PEMS.WorkflowPlatform\PEMS.WorkflowPlatform.csproj" />
    <ProjectReference Include="..\PEMS.Infrastructure\PEMS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- مرجع‌های IFS ماژول Part Catalogue (Seed ایدمپوتنت): داخل Assembly تا مسیر فایل/Deploy مسئله نشود -->
    <EmbeddedResource Include="Seed\Data\PartCatalogue\*.xlsx" LogicalName="PEMS.Seed.PartCatalogue.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
