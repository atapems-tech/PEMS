@namespace PEMS.UI.Components
@attribute [PEMS.UI.Rendering.PemsComponent("alert", Category = "feedback", Icon = "bi-exclamation-circle")]
@inject IPemsLocale Locale
@{
    var tone = Options.Tone.ToString().ToLowerInvariant();
    var role = Options.Tone is AlertTone.Danger or AlertTone.Warning ? "alert" : "status";
}
<div class="pems-alert pems-alert--@tone" role="@role">
    <p class="pems-alert__title">@Locale.Text(Options.Title)</p>
    @if (Options.Message is not null)
    {
        <p class="pems-alert__text">@Locale.Text(Options.Message)</p>
    }
    @if (!string.IsNullOrWhiteSpace(Options.TraceId))
    {
        <p class="pems-alert__trace">
            @if (Options.TraceLabel is not null)
            {
                <span>@Locale.Text(Options.TraceLabel)</span>
            }
            <code dir="ltr">@Options.TraceId</code>
            @if (Options.CopyLabel is not null)
            {
                <button type="button" class="pems-alert__copy" data-pems-copy="@Options.TraceId">@Locale.Text(Options.CopyLabel)</button>
            }
        </p>
    }
    @if (Options.DismissLabel is not null)
    {
        <button type="button" class="pems-alert__dismiss" data-pems-dismiss aria-label="@Locale.Text(Options.DismissLabel)"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    }
</div>
@code {
    [Parameter, EditorRequired] public AlertOptions Options { get; set; } = default!;
}
