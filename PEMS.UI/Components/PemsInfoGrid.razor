@namespace PEMS.UI.Components
@attribute [PEMS.UI.Rendering.PemsComponent("info-grid", Category = "display", Icon = "bi-card-list")]
<dl class="@Css" @attributes="Options.Attributes">@ChildContent</dl>
@code {
    [Parameter, EditorRequired] public InfoGridOptions Options { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string Css => (Options.Layout == "rows" ? "pems-info pems-info--rows" : "pems-info") + (string.IsNullOrWhiteSpace(Options.CssClass) ? "" : " " + Options.CssClass.Trim());
}
