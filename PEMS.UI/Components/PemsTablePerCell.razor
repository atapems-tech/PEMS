@namespace PEMS.UI.Components
@* Measurement only: one component instance per cell. Not used by pages; see ADR-0007 for the cost. *@
<table class="pems-table">
    <thead>
        <tr>@foreach (var c in View.Columns) { <th scope="col">@c.Header</th> }</tr>
    </thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr>
                @foreach (var c in View.Columns)
                {
                    <PemsTableCell Text="@(row.TryGetValue(c.Key, out var v) ? v : null)" Alignment="c.Alignment" />
                }
            </tr>
        }
    </tbody>
</table>
@code {
    [Parameter, EditorRequired] public ViewDescriptor View { get; set; } = default!;
    [Parameter] public IReadOnlyList<IReadOnlyDictionary<string, string?>> Rows { get; set; } = [];
}
