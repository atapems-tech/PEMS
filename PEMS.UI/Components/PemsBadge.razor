@namespace PEMS.UI.Components
@attribute [PEMS.UI.Rendering.PemsComponent("badge", Category = "display", Icon = "bi-tag")]
@inject IPemsLocale Locale
<span class="pems-badge pems-badge--@Options.Tone.ToString().ToLowerInvariant()">@Locale.Text(Options.Label)</span>
@code {
    [Parameter, EditorRequired] public BadgeOptions Options { get; set; } = default!;
}
