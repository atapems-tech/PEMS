@namespace PEMS.UI.Components
@attribute [PEMS.UI.Rendering.PemsComponent("org-chart", Category = "content", Icon = "bi-diagram-3")]
@inject IPemsLocale Locale
@* SCRUM-841: the organization chart. The markup is the shell of the old Team/OrganizationChart view; pems-org-chart.js (read the tree, draw it, filter, zoom) and pems-org-chart.css belong to the component. *@
@{ var t = Options.Texts; string X(PEMS.UI.Abstractions.TranslatableText x) => Locale.Text(x); }
<div @attributes="Options.Attributes" class="@Join("pems-orgchart-page", Options.PageClass)" id="pemsOrgChartRoot"
     data-tree-url="@Options.TreeUrl" data-disciplines-url="@Options.DisciplinesUrl" data-details-url-template="@Options.DetailsUrl"
     data-empty-text="@X(t.Empty)" data-error-text="@X(t.Error)" data-vacant-text="@X(t.Vacant)" data-positions-text="@X(t.Positions)" data-members-text="@X(t.Members)"
     data-view-details-text="@X(t.ViewDetails)" data-filter-empty-text="@X(t.FilterEmpty)" data-no-discipline-text="@X(t.NoDiscipline)" data-all-disciplines-text="@X(t.AllDisciplines)">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a class="btn btn-sm btn-outline-secondary" href="@Options.BackUrl"><i class="bi bi-arrow-return-@(Locale.IsRightToLeft ? "right" : "left")" aria-hidden="true"></i> @X(t.Back)</a>
            <input class="form-control form-control-sm pems-w-170" type="search" id="orgChartDisciplineSearch" placeholder="@X(t.SearchDiscipline)" aria-label="@X(t.SearchDiscipline)" autocomplete="off" />
            <select class="form-select form-select-sm pems-minw-200" id="orgChartDisciplineFilter" aria-label="@X(t.Discipline)" data-pems-select="off">
                <option value="">@X(t.AllDisciplines)</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-1" role="toolbar" aria-label="@X(t.Toolbar)">
            <button class="btn btn-sm btn-outline-secondary" type="button" id="orgChartExpandAll" title="@X(t.ExpandAll)" aria-label="@X(t.ExpandAll)"><i class="bi bi-arrows-expand" aria-hidden="true"></i></button>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="orgChartCollapseAll" title="@X(t.CollapseAll)" aria-label="@X(t.CollapseAll)"><i class="bi bi-arrows-collapse" aria-hidden="true"></i></button>
            <div class="vr mx-1"></div>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="orgChartZoomOut" title="@X(t.ZoomOut)" aria-label="@X(t.ZoomOut)"><i class="bi bi-zoom-out" aria-hidden="true"></i></button>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="orgChartZoomIn" title="@X(t.ZoomIn)" aria-label="@X(t.ZoomIn)"><i class="bi bi-zoom-in" aria-hidden="true"></i></button>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="orgChartFit" title="@X(t.Fit)" aria-label="@X(t.Fit)"><i class="bi bi-aspect-ratio" aria-hidden="true"></i></button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-9">
            <div class="card pems-org-summary mb-3" id="orgChartSummary" hidden><div class="card-body">
                <div class="pems-org-summary-head">
                    <strong>@X(t.SummaryTitle)</strong>
                    <div class="btn-group btn-group-sm" role="group" aria-label="@X(t.ShowPositions)" id="orgChartVacancyFilter">
                        <button class="btn btn-outline-secondary active" type="button" data-filter="all" aria-pressed="true">@X(t.All)</button>
                        <button class="btn btn-outline-secondary" type="button" data-filter="filled" aria-pressed="false">@X(t.Filled) (<span id="orgChartFilterFilled">0</span>)</button>
                        <button class="btn btn-outline-secondary" type="button" data-filter="vacant" aria-pressed="false">@X(t.VacantShort) (<span id="orgChartFilterVacant">0</span>)</button>
                    </div>
                </div>
                <div class="pems-org-stats">
                    <div class="pems-org-stat"><span class="pems-org-stat-value" id="orgChartStatTotal">0</span><span class="pems-org-stat-label">@X(t.TotalPositions)</span></div>
                    <div class="pems-org-stat pems-org-stat-filled"><span class="pems-org-stat-value" id="orgChartStatFilled">0</span><span class="pems-org-stat-label"><i class="bi bi-person-check" aria-hidden="true"></i> @X(t.Filled)</span></div>
                    <div class="pems-org-stat pems-org-stat-vacant"><span class="pems-org-stat-value" id="orgChartStatVacant">0</span><span class="pems-org-stat-label"><i class="bi bi-person-dash" aria-hidden="true"></i> @X(t.VacantShort)</span></div>
                    <div class="pems-org-stat"><span class="pems-org-stat-value" id="orgChartStatOccupancy">0%</span><span class="pems-org-stat-label">@X(t.Occupancy)</span></div>
                </div>
                <div class="pems-org-progress" role="img" id="orgChartProgress" aria-label="@X(t.Occupancy)">
                    <span class="pems-org-progress-filled" id="orgChartProgressFilled"></span>
                    <span class="pems-org-progress-vacant" id="orgChartProgressVacant"></span>
                </div>
                <div class="small text-muted mt-1">@X(t.InactiveNote)</div>
            </div></div>

            <div class="card pems-orgchart-card"><div class="card-body">
                <div id="orgChartLoading" role="status" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @X(t.Loading)</div>
                <div id="orgChartError" class="pems-orgchart-state text-danger" hidden>
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span id="orgChartErrorText"></span>
                    <button class="btn btn-sm btn-outline-danger ms-2" type="button" id="orgChartRetry">@X(t.Retry)</button>
                </div>
                <div id="orgChartEmpty" class="pems-orgchart-state" hidden>
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <span id="orgChartEmptyText"></span>
                </div>
                <div id="orgChartViewport" class="pems-orgchart-viewport" hidden tabindex="0" role="tree" aria-label="@X(t.ChartLabel)">
                    <div id="orgChartCanvas" class="pems-orgchart-canvas"></div>
                </div>
            </div></div>

            <div class="pems-org-legend" aria-label="@X(t.LegendTitle)">
                <span class="pems-org-legend-title">@X(t.LegendTitle)</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Group"></span>@X(t.Group)</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Team"></span>@X(t.Team)</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Shift"></span>@X(t.Shift)</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Position-Occupied"></span>@X(t.Occupied)</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Position-Vacant"></span>@X(t.VacantPosition)</span>
            </div>
        </div>

        <div class="col-12 col-xl-3">
            <div class="card pems-orgchart-detail" id="orgChartDetailPanel"><div class="card-body">
                <div class="pems-orgchart-state" id="orgChartNoSelection">
                    <i class="bi bi-cursor" aria-hidden="true"></i>
                    <span>@X(t.NoSelection)</span>
                </div>
                <div id="orgChartDetailContent" hidden></div>
            </div></div>
        </div>
    </div>
    <PemsScriptTemplates Options="@(new ScriptTemplatesOptions { Set = ScriptTemplateSet.OrgChart })" />
</div>
@code {
    [Parameter, EditorRequired] public OrgChartOptions Options { get; set; } = default!;

    private static string Join(params string?[] parts) => string.Join(" ", parts.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));
}
