@namespace PEMS.UI.Components
<form method="post" action="@Definition.Action" enctype="multipart/form-data" id="@Definition.Id" class="pems-form">
    @if (RequestToken is not null)
    {
        <input type="hidden" name="@RequestTokenName" value="@RequestToken" />
    }
    <h2 class="pems-form__title">@Definition.Title</h2>
    @foreach (var f in Definition.Fields)
    {
        <PemsField Descriptor="f" Value="@State.ValueOf(f.Name)" Error="@State.ErrorOf(f.Name)" />
    }
    <PemsButton Options="@(new ButtonOptions(Definition.SubmitLabel, Type: "submit"))" />
</form>
@code {
    [Parameter, EditorRequired] public FormDefinition Definition { get; set; } = default!;
    [Parameter] public FormState State { get; set; } = FormState.Empty;
    /// <summary>The antiforgery request token, supplied by the caller (see ADR-0007 for why it is a parameter).</summary>
    [Parameter] public string? RequestToken { get; set; }
    [Parameter] public string RequestTokenName { get; set; } = "__RequestVerificationToken";
}
