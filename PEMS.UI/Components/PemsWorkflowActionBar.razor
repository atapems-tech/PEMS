@namespace PEMS.UI.Components
@attribute [PEMS.UI.Rendering.PemsComponent("workflow-action-bar", Category = "actions", Icon = "bi-signpost-split")]
@inject IPemsLocale Locale
@if (Options.Actions.Count == 0)
{
    <div @attributes="Options.Attributes" class="@Join("pems-wfa pems-wfa--none text-muted", Options.Css, Options.PageClass)">@Locale.Text(Options.None)</div>
}
else
{
    <form @attributes="Options.Attributes" action="@Options.Action" method="post" class="@Join("pems-wfa", Options.Css, Options.PageClass)">
        @if (Options.Antiforgery is not null) { <input type="hidden" name="@Options.Antiforgery.Name" value="@Options.Antiforgery.Token" /> }
        @foreach (var f in Options.Fields) { <input type="hidden" name="@f.Key" value="@f.Value" /> }
        <label class="pems-wfa__label">@Locale.Text(Options.CommentLabel)<textarea name="comment" class="form-control" rows="2" maxlength="2000"></textarea></label>
        <div class="pems-wfa__buttons" role="group">
            @foreach (var a in Options.Actions)
            {
                <button type="submit" name="actionType" value="@a.ActionType" class="@("btn btn-" + (a.Tone == "secondary" ? "outline-secondary" : a.Tone))" disabled="@(!a.Allowed)" title="@(a.Allowed ? null : a.DeniedReason)" data-confirm="@(a.Confirm)" onclick="@(a.Confirm is null ? null : "return confirm(this.dataset.confirm)")">@a.Label</button>
            }
        </div>
    </form>
}
@code {
    [Parameter, EditorRequired] public WorkflowActionBarOptions Options { get; set; } = default!;
    private static string Join(params string?[] parts) => string.Join(" ", parts.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));
}
