@namespace PEMS.UI.Components
@{ var state = ButtonState.From(Options); }
@if (state.AsLink)
{
    <a class="@state.Css" href="@Options.Href">@Options.Label</a>
}
else
{
    <button type="@Options.Type" class="@state.Css" disabled="@Options.Disabled">@Options.Label</button>
}
@code {
    [Parameter, EditorRequired] public ButtonOptions Options { get; set; } = default!;
}
