<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- PEMS component library (ADR-0002). Spike state (SCRUM-23): standalone, not referenced by PEMS.Web yet. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>PEMS.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\PEMS.UI.Abstractions\PEMS.UI.Abstractions.csproj" />
  </ItemGroup>

</Project>
