# PEMS secrets - uat  (TEMPLATE)
# Copy to env/uat.secrets.env and fill in. The real file is git-ignored and must never be committed or packaged.
# Same format as the settings file. Real environment variables override this file.

# SQL Server connection string of this environment's database
ConnectionStrings__PEMSConnection=Server=<server>;Database=<uat database>;User Id=<user>;Password=<password>;Encrypt=True

# optional Redis cache; leave empty to use the in-memory cache
ConnectionStrings__Redis=

# FTP storage account (leave empty when unused)
Ftp__Username=

# FTP storage password (leave empty when unused)
Ftp__Password=

# account on the organisation's mail server for tender invitations (leave empty for a relay that needs no login)
Email__UserName=

# password of that mail account
Email__Password=

# password of the first administrator, used only on an empty database; change it at first sign-in
Seed__Admin__Password=<choose a password>
