# PEMS settings - uat
# Azure Container Apps UAT (ASPNETCORE_ENVIRONMENT=UAT, .github/workflows/deploy-uat.yml). No local Ollama is reachable from the public UAT.
# Loaded when PEMS_ENV=uat. Secrets are NOT here: they live in env/uat.secrets.env (git-ignored).
# Format: KEY=VALUE, '__' is the section separator (Ollama__Url = Ollama:Url). Real environment variables override this file.

# --- Hosting
AllowedHosts=*

# --- Logging (Serilog)
Serilog__MinimumLevel=Information
Serilog__File__Path=logs/pems-.log
Serilog__File__RetainedFiles=30

# --- Database bootstrap (connection string is a secret: see the .secrets.env file)
Database__CreateIfMissing=true
Database__MigrateOnStartup=true

# --- Local AI (Ollama) and OCR
Ollama__Url=http://ollama-not-available-in-uat.invalid:11434
Ollama__Model=qwen2.5:3b
Ollama__EmbeddingModel=nomic-embed-text
Ollama__TimeoutMinutes=1
OCR__TessDataPath=tessdata
OCR__Languages=fas+eng

# --- FTP storage defaults (user name and password are secrets)
Ftp__Host=
Ftp__Port=21
Ftp__BaseRemotePath=/
Ftp__UseFtps=false

# --- WebAuthn / passkeys (needs the real HTTPS domain)
Fido2__ServerDomain=REPLACE-WITH-ACTUAL-UAT-DOMAIN
Fido2__ServerName=PEMS UAT
Fido2__Origins__0=https://REPLACE-WITH-ACTUAL-UAT-DOMAIN
Fido2__TimestampDriftToleranceMs=300000

# --- Authentication
Authentication__Lockout__MaxFailedAccessAttempts=5
Authentication__Lockout__DefaultLockoutMinutes=10
Authentication__Password__RequiredLength=8
Authentication__Password__RequireDigit=true
Authentication__Password__RequireUppercase=false
Authentication__Password__RequireNonAlphanumeric=false
Authentication__Cookie__Name=PEMS.Auth
Authentication__Cookie__ExpireHours=8
Authentication__SecurityStampValidationMinutes=1

# --- Admin account recovery (SCRUM-355/356)
# Rate limit for the sign-in-free recovery pages, per client IP, POST only
Security__Recovery__RateLimit__PermitLimit=5
Security__Recovery__RateLimit__WindowMinutes=15
# Break-glass: placing pems-recovery.request in this folder (relative to the app folder, or absolute) opens /break-glass for WindowMinutes
Security__BreakGlass__RequestFolder=break-glass
Security__BreakGlass__WindowMinutes=15
# Comma-separated CIDR list allowed besides localhost (empty = localhost only), e.g. 10.20.0.0/16
Security__BreakGlass__ManagementNetworks=
# Vendor-signed recovery (off by default; the customer enables it explicitly). Public key = ECDSA P-256 SubjectPublicKeyInfo, Base64
Security__BreakGlass__VendorRecovery__Enabled=false
Security__BreakGlass__VendorRecovery__PublicKey=
Security__BreakGlass__VendorRecovery__MachineFingerprint=

# --- Language and culture
Localization__DefaultCulture=en
Localization__SupportedCultures__0=en
Localization__SupportedCultures__1=fa

# --- First administrator (the password is a secret)
Seed__Admin__UserName=admin
Seed__Admin__Email=admin@pems.local

# --- Features and policies
Features__DynamicSidebar__Enabled=false
Cmms__WorkRequest__EnforceSegregationOfDuties=true

# --- Letters
LetterReminders__Enabled=false
LetterReminders__RunAtLocalTime=07:30
LetterReminders__AutoArchiveAfterYears=0
Letterhead__CompanyName=PEMS
Letterhead__Address=
Letterhead__Phone=
Letterhead__Website=
