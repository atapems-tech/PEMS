# PEMS settings - local
# Developer machine (dotnet run, ASPNETCORE_ENVIRONMENT=Development).
# Loaded when PEMS_ENV=local. Secrets are NOT here: they live in env/local.secrets.env (git-ignored).
# Format: KEY=VALUE, '__' is the section separator (Ollama__Url = Ollama:Url). Real environment variables override this file.

# --- Hosting
AllowedHosts=*

# --- Logging (Serilog)
Serilog__MinimumLevel=Information
Serilog__File__Path=logs/pems-.log
Serilog__File__RetainedFiles=30

# --- Database bootstrap (connection string is a secret: see the .secrets.env file)
Database__CreateIfMissing=true
Database__MigrateOnStartup=true

# --- Local AI (Ollama) and OCR
Ollama__Url=http://localhost:11434
Ollama__Model=qwen2.5:3b
Ollama__EmbeddingModel=nomic-embed-text
Ollama__TimeoutMinutes=15
OCR__TessDataPath=tessdata
OCR__Languages=fas+eng

# --- FTP storage defaults (user name and password are secrets)
Ftp__Host=
Ftp__Port=21
Ftp__BaseRemotePath=/
Ftp__UseFtps=false

# --- WebAuthn / passkeys (needs the real HTTPS domain)
Fido2__ServerDomain=localhost
Fido2__ServerName=PEMS
Fido2__Origins__0=http://localhost:5089
Fido2__TimestampDriftToleranceMs=300000

# --- Authentication
Authentication__Lockout__MaxFailedAccessAttempts=5
Authentication__Lockout__DefaultLockoutMinutes=10
Authentication__Password__RequiredLength=8
Authentication__Password__RequireDigit=true
Authentication__Password__RequireUppercase=false
Authentication__Password__RequireNonAlphanumeric=false
Authentication__Cookie__Name=PEMS.Auth
Authentication__Cookie__ExpireHours=8
Authentication__SecurityStampValidationMinutes=1

# --- Language and culture
Localization__DefaultCulture=en
Localization__SupportedCultures__0=en
Localization__SupportedCultures__1=fa

# --- First administrator (the password is a secret)
Seed__Admin__UserName=admin
Seed__Admin__Email=admin@pems.local

# --- Features and policies
Features__DynamicSidebar__Enabled=true
Cmms__WorkRequest__EnforceSegregationOfDuties=true

# --- Letters
LetterReminders__Enabled=false
LetterReminders__RunAtLocalTime=07:30
LetterReminders__AutoArchiveAfterYears=0
Letterhead__CompanyName=PEMS
Letterhead__Address=
Letterhead__Phone=
Letterhead__Website=

# --- Licensing (docs/design/LICENSING_TECHNICAL_DESIGN.md). Enforce stays false until the licence rollout tasks; false means nothing is checked or blocked.
# SealDirectory 'auto' = %ProgramData%\PEMS\seal on Windows, /var/lib/pems/seal on Linux; Docker sets an explicit volume path.
Licensing__Enforce=false
Licensing__SealDirectory=auto
Licensing__PeriodicCheckHours=6
Licensing__HeartbeatHours=24
Licensing__ClockToleranceMinutes=5
Licensing__WarningDays=30
Licensing__RestoreGraceHours=72
Licensing__HostMachineIdPath=/host/etc/machine-id
