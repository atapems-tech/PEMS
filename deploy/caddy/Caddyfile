# PEMS reverse proxy (Caddy). Canonical URL: https://pems.home.arpa
# - pems.home.arpa      : TLS from Caddy's internal CA (clients must trust the root CA), proxied to the pems-web container on the Docker network.
#                         Caddy also adds the automatic HTTP -> HTTPS redirect for this host.
# - any other Host :80  : (e.g. http://192.168.1.136/) permanently redirected to the canonical HTTPS URL. HTTPS by IP is NOT supported:
#                         the certificate carries only the DNS name pems.home.arpa.
pems.home.arpa {
    tls internal

    reverse_proxy pems-web:8080
}

http://:80 {
    redir https://pems.home.arpa{uri} permanent
}
